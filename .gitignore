site/

# Generated WASM/GPU artifacts emitted by the compiler/tests (e.g. tests/cases, sample/interop,
# and root scratch files). Hand-written runtime assets under src/ are NOT generated and are
# re-included below.
*.wat
*.wasm
!/runtime/dream-csv.wasm
!/runtime/dream-compression.wasm
*.cwasm
*.abi.json
*.runtime.js


tests/**/*.C
!/tests/runtime_ownership.c
!/tests/runtime_publish.c
!/tests/runtime_weak.c
!/tests/runtime_region.c
!/tests/runtime_sync.c
!/tests/runtime_worker.c
!/tests/runtime_panic.c
!/tests/runtime_machine_size.c
!/tests/runtime_callback.c
!/tests/runtime_platform.c
!/tests/runtime_stdio.c
!/tests/runtime_ready.c
!/tests/runtime_blocking.c
!/tests/runtime_file_operation.c
!/tests/runtime_cancellation.c
tests/**/*.bin
tests/**/*.o
# Native C emit (`dream --native-c`) next to the entry file.
sample/**/*.c
!sample/**/native/**/*.c
sample/**/*.bin
sample/**/*.o


*.br
*.gz
*.db
*.tmp
*.dSYM/

*.wgsl

# Keep the hand-written runtime WAT assets that the codegen embeds via include_str!.
# (Previously under /src/; now owned by dream-mir.)
!/crates/dream-mir/src/runtime/**/*.wat
!/src/**/*.wat

# Clang/wasm-ld scratch for linked regex; `regex.wat` is the emit artifact.
/crates/dream-mir/src/runtime/c/generated/

node_modules/
.DS_Store

# VS Code Extension generated files
*.vsix
*.dbg.json
tooling/vscode/out/
tooling/vscode/bin/

*.pyc
sample/sqlite/*.db

