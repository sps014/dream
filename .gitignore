/target

.idea/
.cursor/
site/

# Generated WASM/GPU artifacts emitted by the compiler/tests (e.g. tests/cases, sample/interop,
# and root scratch files). Hand-written runtime assets under src/ are NOT generated and are
# re-included below.
*.wat
*.wasm
*.cwasm
*.abi.json
*.runtime.js

tests/*/*.C
tests/*/*.bin
*.tmp
*.dSYM/

*.wgsl

# Keep the hand-written runtime WAT assets that the codegen embeds via include_str!.
# (Previously under /src/; now owned by dream-mir.)
!/crates/dream-mir/src/runtime/**/*.wat
!/src/**/*.wat

node_modules/
.DS_Store

# VS Code Extension generated files
*.vsix
*.dbg.json
tooling/vscode/out/
tooling/vscode/bin/

*.pyc
sample/sqlite/*.db
sample/sqlite/target/pack/*

# C# microbench side-by-side harness
tests/bench/csharp/bin/
tests/bench/csharp/obj/
tests/bench/out/
