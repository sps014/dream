module main;

import system;

public class Widget {
    public id: int;
    public constructor(id: int) { this.id = id; }
}

// P2: pop WITHOUT zeroing the vacated slot. If loads retain, this is safe-but-retentive:
// no crash, element alive via caller, slot's ref released when overwritten.
fun pop_no_zero(arr: Widget[], count: int): Widget {
    let top = arr[count - 1];
    return top;
}

fun main(): void {
    let w = Widget(42);
    let arr = Buffer.alloc<Widget>(4);
    arr[0] = w;
    let out = pop_no_zero(arr, 1);
    System.println(out.id.to_string() + " rc=" + Debug.ref_count(w).to_string());
    // Overwrite the stale slot: releases its reference without touching the live object.
    arr[0] = Widget(99);
    System.println("after overwrite rc=" + Debug.ref_count(w).to_string());
}
