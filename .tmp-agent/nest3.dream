module main;

import system;
import system.collections;

// 3. Leak via delegation: wipe() calls helper() which rewinds — cross-method.
public class Outer3 {
    items: string[];
    count: int;

    public constructor() {
        this.items = Buffer.alloc<string>(8);
        this.count = 0;
    }

    fun helper(): void {
        this.count = 0;
    }

    public fun wipe(): void {
        this.helper();
    }
}

fun main(): void {
    System.println("n3");
}
