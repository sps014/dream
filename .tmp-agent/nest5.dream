module main;

import system;
import system.collections;

public class Boxed {
    name: string;
    public constructor(name: string) { this.name = name; }
}

// Value struct whose fields hold references — managed by content.
public struct Cell {
    label: string;
    owner: Boxed;

    public constructor(label: string, owner: Boxed) {
        this.label = label;
        this.owner = owner;
    }
}

public class Outer5 {
    cells: Cell[];
    count: int;

    public constructor() {
        this.cells = Buffer.alloc<Cell>(8);
        this.count = 0;
    }

    public fun wipe(): void {
        this.count = 0;
    }
}

fun main(): void {
    System.println("n5");
}
