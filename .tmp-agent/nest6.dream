module main;

import system;
import system.collections;

// Reference-free value struct elements — rewinding is safe, must NOT flag.
public struct Point {
    x: int;
    y: int;
    public constructor(x: int, y: int) { this.x = x; this.y = y; }
}

public class Outer6 {
    points: Point[];
    count: int;

    public constructor() {
        this.points = Buffer.alloc<Point>(8);
        this.count = 0;
    }

    public fun wipe(): void {
        this.count = 0;
    }
}

fun main(): void {
    System.println("n6");
}
