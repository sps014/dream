Subject: [PATCH] metal: adopt a UIKit host's CAMetalLayer on iOS

The Metal surface creates its layer from an NSWindow through AppKit, which iOS does not
have. On UIKit the host already owns a Metal view, so the window handle carries that view's
CAMetalLayer and the surface retains it instead of creating one.

---
--- a/src/cocoa-util.mm
+++ b/src/cocoa-util.mm
@@ -1,17 +1,27 @@
 #include "cocoa-util.h"
 
+#include <TargetConditionals.h>
+#if TARGET_OS_IPHONE
+#import <UIKit/UIKit.h>
+#else
 #import <Cocoa/Cocoa.h>
+#endif
 #import <QuartzCore/CAMetalLayer.h>
 
 namespace rhi {
 
 void* CocoaUtil::createMetalLayer(void* nswindow)
 {
+#if TARGET_OS_IPHONE
+    // UIKit hosts own the Metal view and pass its CAMetalLayer in place of an NSWindow.
+    return [(CAMetalLayer*)nswindow retain];
+#else
     CAMetalLayer* layer = [CAMetalLayer layer];
     NSWindow* window = (NSWindow*)nswindow;
     window.contentView.layer = layer;
     window.contentView.wantsLayer = YES;
     return layer;
+#endif
 }
 
 void* CocoaUtil::nextDrawable(void* metalLayer)
