module system.app;

/// A request to stop the program, passed to `App.on_shutdown_requested` hooks.
///
/// Every hook sees the same request. When any hook calls `veto` on a request that allows
/// it, the program keeps running and `App.stopping` stays uncancelled.
public class ShutdownRequest {
    request_reason: ShutdownReason;
    vetoable: bool;
    vetoed: bool;

    internal constructor(reason: ShutdownReason, vetoable: bool) {
        this.request_reason = reason;
        this.vetoable = vetoable;
        this.vetoed = false;
    }

    /// Why the program is being asked to stop.
    public get reason(): ShutdownReason {
        return this.request_reason;
    }

    /// True when `veto` can keep the program running. Signals, `App.quit`, and
    /// the final notice that the session is ending cannot be vetoed.
    public get can_veto(): bool {
        return this.vetoable;
    }

    /// Asks to keep the program running, for example while a document has unsaved
    /// changes. Does nothing when `can_veto` is false.
    public fun veto(): void {
        if this.vetoable {
            this.vetoed = true;
        }
    }

    internal get is_vetoed(): bool {
        return this.vetoed;
    }
}
