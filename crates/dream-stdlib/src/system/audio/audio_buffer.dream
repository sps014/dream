module system.audio;

/// Immutable decoded interleaved PCM, independent of any output device.
public class AudioBuffer {
    internal samples: float[];

    /// Samples per second per channel.
    rate: int;

    /// One for mono or two for stereo.
    channel_count: int;

    internal constructor(samples: float[], sample_rate: int, channels: int) {
        this.samples = samples;
        this.rate = sample_rate;
        this.channel_count = channels;
    }

    @intrinsic(Intrinsic.DreamAudioDecode)
    static extern fun decode_host(borrow bytes: byte[], max_bytes: int): float[];

    /// Detects and decodes encoded bytes, limiting decoded PCM to max_bytes.
    public static fun decode(
        bytes: byte[],
        max_bytes: int = 268435456
    ): Result<AudioBuffer, AudioError> {
        if max_bytes < 4 || max_bytes > 1073741824 {
            return Result.Err(
                AudioError("EINVAL", "decoded buffer limit must be between 4 bytes and 1 GiB")
            );
        }
        let decoded = AudioBuffer.decode_host(bytes, max_bytes);
        if decoded.length == 1 {
            return Result.Err(
                AudioError("ELIMIT", "audio exceeds the decoded buffer limit or channel limit")
            );
        }
        if decoded.length < 2 {
            return Result.Err(AudioError("EFORMAT", "invalid or unsupported encoded audio"));
        }
        let samples = Array.alloc<float>(decoded.length - 2);
        for (let i = 0; i < samples.length; i = i + 1) {
            samples[i] = decoded[i + 2];
        }
        return AudioBuffer.from_pcm(samples, (int)decoded[0], (int)decoded[1]);
    }

    /// Copies finite interleaved mono/stereo PCM with complete frames and a positive sample rate.
    public static fun from_pcm(
        samples: float[],
        sample_rate: int,
        channels: int
    ): Result<AudioBuffer, AudioError> {
        if sample_rate <= 0 || (channels != 1 && channels != 2) {
            return Result.Err(
                AudioError("EINVAL", "positive sample rate and mono or stereo PCM are required")
            );
        }
        if samples.length % channels != 0 {
            return Result.Err(AudioError("EINVAL", "PCM contains an incomplete frame"));
        }
        let copied = Array.alloc<float>(samples.length);
        for (let i = 0; i < samples.length; i = i + 1) {
            let value = (double)samples[i];
            if value != value || Math.abs(value) > 3.4028234663852886e38d {
                return Result.Err(AudioError("EINVAL", "PCM samples must be finite"));
            }
            copied[i] = samples[i];
        }
        return Result.Ok(AudioBuffer(copied, sample_rate, channels));
    }

    /// Samples per second per channel.
    public get sample_rate(): int {
        return this.rate;
    }

    /// One for mono or two for stereo.
    public get channels(): int {
        return this.channel_count;
    }

    /// Number of complete frames in this buffer.
    public get frame_count(): int {
        return this.samples.length / this.channels;
    }

    /// Total duration in seconds.
    public get duration(): double {
        return (double)this.frame_count / (double)this.sample_rate;
    }

    /// Copies a frame range; invalid or overflowing ranges return EINVAL.
    public fun read_pcm(start_frame: int, frame_count: int): Result<float[], AudioError> {
        if start_frame < 0
            || frame_count < 0
            || start_frame > this.frame_count || frame_count > this.frame_count - start_frame {
            return Result.Err(AudioError("EINVAL", "PCM frame range is out of bounds"));
        }
        let result = Array.alloc<float>(frame_count * this.channels);
        for (let i = 0; i < result.length; i = i + 1) {
            result[i] = this.samples[start_frame * this.channels + i];
        }
        return Result.Ok(result);
    }
}
