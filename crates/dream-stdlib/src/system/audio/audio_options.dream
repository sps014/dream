module system.audio;

/// Resource limits for a player. Values are snapshotted by its constructor.
public class AudioOptions {
    /// Maximum decoded PCM bytes for byte sources, which decode completely; defaults to 256 MiB.
    public max_decoded_bytes: int;

    /// Maximum encoded bytes a streamed file or URL queues ahead of its decoder; defaults
    /// to 8 MiB. An encoded element that cannot fit, such as an oversized WebM frame,
    /// fails with ELIMIT. Track length is not limited.
    public max_compressed_bytes: int;

    /// Decoded audio a streamed source keeps queued for output, in seconds; defaults to
    /// one. Values are clamped between 1,024 frames and 30 seconds.
    public buffer_seconds: double;

    /// Creates the default resource limits.
    public constructor() {
        this.max_decoded_bytes = 268435456;
        this.max_compressed_bytes = 8388608;
        this.buffer_seconds = 1.0d;
    }
}
