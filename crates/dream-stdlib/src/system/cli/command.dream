module system.cli;

/// Declarative CLI definition. Parsing consumes arguments without an executable name and never exits.
// `subcommand` stores copies, so a command tree never refers back to an ancestor.
public class Command {
    internal name: string;
    internal about: string;
    internal version_text: string;
    internal subcommand_required: bool;
    internal arguments: List<CliArgument>;
    internal children: List<Command>;
    error: string;

    /// Creates a command; invalid names or conflicting definitions return errors from parse.
    public constructor(name: string) {
        this.name = name;
        this.about = "";
        this.version_text = "";
        this.subcommand_required = false;
        this.arguments = List<CliArgument>();
        this.children = List<Command>();
        this.error = "";
    }

    /// Sets version output and enables --version/-V for this command and its descendants.
    public fun version(value: string): Command {
        this.version_text = value;
        return this;
    }

    /// Sets text included in automatically generated help.
    public fun description(value: string): Command {
        this.about = value;
        return this;
    }

    /// Requires one of the declared subcommands; --help and --version still return normal outcomes.
    public fun require_subcommand(required: bool = true): Command {
        this.subcommand_required = required;
        return this;
    }

    /// Adds an ordered string positional; only the last positional can collect multiple arguments.
    public fun positional(
        name: string,
        required: bool = false,
        multiple: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, CliArgumentKind.Positional, "", required, description);
        argument.multiple = multiple;
        return this;
    }

    /// Adds a string option. Optional values default to empty; repeated occurrences are collected, with the last returned by get_string.
    public fun string_option(
        name: string,
        short: string = "",
        default_value: string = "",
        required: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, CliArgumentKind.String, short, required, description);
        if !required {
            argument.default_value = Option.Some(default_value);
        }
        return this;
    }

    /// Adds a decimal 32-bit integer option. Optional values default to zero; required options ignore defaults.
    public fun int_option(
        name: string,
        short: string = "",
        default_value: int = 0,
        required: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, CliArgumentKind.Int, short, required, description);
        if !required {
            argument.default_value = Option.Some(default_value.to_string());
        }
        return this;
    }

    /// Adds a boolean option defaulting to false; repeated occurrences remain true.
    public fun flag(name: string, short: string = "", description: string = ""): Command {
        this.argument(name, CliArgumentKind.Flag, short, false, description);
        return this;
    }

    /// Restricts a previously declared string, positional, or integer argument to these exact values.
    public fun choices(name: string, values: string[]): Command {
        for let argument in this.arguments {
            if argument.name == name {
                argument.choices = values.slice(0, values.length);
                return this;
            }
        }
        this.error = "choices refer to an unknown argument: " + name;
        return this;
    }

    /// Snapshots a child definition. Later edits to the child do not mutate its attached copy.
    public fun subcommand(command: Command): Command {
        if command.error != "" {
            this.error = command.error;
            return this;
        }
        this.children.push(command.copy());
        return this;
    }

    /// Parses explicit arguments; pass System.args to parse the process arguments.
    /// Returns errors for invalid definitions, arguments, or conversions. Does not exit the process.
    public fun parse(arguments: string[]): Result<ParsedArguments, CliError> {
        if this.error != "" {
            return Result.Err(CliError("EINVAL", this.error));
        }
        let problem = CliValidation.check(this, 0, false);
        if problem.length > 0 {
            return Result.Err(CliError("EINVAL", problem));
        }
        return CliParser(this, arguments, this.name, this.name, this.version_text).parse(0);
    }

    fun copy(): Command {
        let copy = Command(this.name);
        copy.about = this.about;
        copy.version_text = this.version_text;
        copy.subcommand_required = this.subcommand_required;
        for let argument in this.arguments {
            copy.arguments.push(argument.copy());
        }
        for let child in this.children {
            copy.children.push(child.copy());
        }
        return copy;
    }

    fun argument(
        name: string,
        kind: CliArgumentKind,
        short: string,
        required: bool,
        description: string
    ): CliArgument {
        let argument = CliArgument(name, kind, short, required, description);
        this.arguments.push(argument);
        return argument;
    }
}
