module system.cli;

/// Declarative CLI definition. Parsing consumes arguments without an executable name and never exits.
public class Command {
    definition: JsonValue;
    error: string;

    /// Creates a command; invalid names or conflicting definitions return errors from parse.
    public constructor(name: string) {
        this.error = "";
        this.definition = JsonValue.dict();
        this.definition["name"] = JsonValue.from_string(name);
        this.definition["args"] = JsonValue.array();
        this.definition["subcommands"] = JsonValue.array();
    }

    /// Sets version output and enables --version/-V for this command and its descendants.
    public fun version(value: string): Command {
        this.definition["version"] = JsonValue.from_string(value);
        return this;
    }

    /// Sets text included in automatically generated help.
    public fun description(value: string): Command {
        this.definition["description"] = JsonValue.from_string(value);
        return this;
    }

    /// Requires one of the declared subcommands; --help and --version still return normal outcomes.
    public fun require_subcommand(required: bool = true): Command {
        this.definition["require_subcommand"] = JsonValue.from_bool(required);
        return this;
    }

    /// Adds an ordered string positional; only the last positional can collect multiple arguments.
    public fun positional(
        name: string,
        required: bool = false,
        multiple: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, "positional", "", required, description);
        argument["multiple"] = JsonValue.from_bool(multiple);
        return this;
    }

    /// Adds a string option. Optional values default to empty; repeated occurrences are collected, with the last returned by get_string.
    public fun string_option(
        name: string,
        short: string = "",
        default_value: string = "",
        required: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, "string", short, required, description);
        if !required {
            argument["default_value"] = JsonValue.from_string(default_value);
        }
        return this;
    }

    /// Adds a decimal 32-bit integer option. Optional values default to zero; required options ignore defaults.
    public fun int_option(
        name: string,
        short: string = "",
        default_value: int = 0,
        required: bool = false,
        description: string = ""
    ): Command {
        let argument = this.argument(name, "int", short, required, description);
        if !required {
            argument["default_value"] = JsonValue.from_string(default_value.to_string());
        }
        return this;
    }

    /// Adds a boolean option defaulting to false; repeated occurrences remain true.
    public fun flag(name: string, short: string = "", description: string = ""): Command {
        this.argument(name, "flag", short, false, description);
        return this;
    }

    /// Restricts a previously declared string, positional, or integer argument to these exact values.
    public fun choices(name: string, values: string[]): Command {
        let arguments = this.definition["args"];
        for (let i = 0; i < arguments.length; i = i + 1) {
            let argument = arguments.at(i).unwrap();
            if argument["name"].as_string().unwrap_or("") == name {
                argument["choices"] = Command.strings(values);
                return this;
            }
        }
        this.error = "choices refer to an unknown argument: " + name;
        return this;
    }

    /// Snapshots a child definition. Later edits to the child do not mutate its attached copy.
    public fun subcommand(command: Command): Command {
        if command.error != "" {
            this.error = command.error;
            return this;
        }
        let snapshot = Json.deserialize<JsonValue>(Json.serialize(command.definition));
        if snapshot.is_err() {
            this.error = "invalid subcommand definition";
            return this;
        }
        this.definition["subcommands"].push(snapshot.unwrap());
        return this;
    }

    /// Parses explicit arguments on native targets; pass System.args to parse the process arguments.
    /// Returns errors for invalid definitions, arguments, or conversions. Does not exit the process.
    @native
    public fun parse(arguments: string[]): Result<ParsedArguments, CliError> {
        if this.error != "" {
            return Result.Err(CliError("EINVAL", this.error));
        }
        let request = JsonValue.dict();
        request["command"] = this.definition;
        request["args"] = Command.strings(arguments);
        let decoded = Json.deserialize<JsonValue>(Command.parse_host(Json.serialize(request)));
        if decoded.is_err() {
            return Result.Err(CliError("EIO", "invalid CLI host response"));
        }
        let wire = decoded.unwrap();
        if wire.get("kind").unwrap_or(JsonValue.null()).as_string().unwrap_or("") == "error" {
            return Result.Err(
                CliError(
                    wire.get("code").unwrap_or(JsonValue.null()).as_string().unwrap_or("EIO"),
                    wire.get("message")
                        .unwrap_or(JsonValue.null())
                        .as_string()
                        .unwrap_or("CLI parsing failed")
                )
            );
        }
        let kind = wire.get("kind").unwrap_or(JsonValue.null()).as_string().unwrap_or("");
        if kind != "values" && kind != "help" && kind != "version" {
            return Result.Err(CliError("EIO", "invalid CLI host outcome"));
        }
        return Result.Ok(ParsedArguments(wire));
    }

    @native
    @runtime("cliParse")
    static extern fun parse_host(request: string): string;

    fun argument(
        name: string,
        kind: string,
        short: string,
        required: bool,
        description: string
    ): JsonValue {
        let argument = JsonValue.dict();
        argument["name"] = JsonValue.from_string(name);
        argument["kind"] = JsonValue.from_string(kind);
        argument["short"] = JsonValue.from_string(short);
        argument["required"] = JsonValue.from_bool(required);
        argument["description"] = JsonValue.from_string(description);
        this.definition["args"].push(argument);
        return argument;
    }

    static fun strings(values: string[]): JsonValue {
        let array = JsonValue.array();
        for (let i = 0; i < values.length; i = i + 1) {
            array.push(JsonValue.from_string(values[i]));
        }
        return array;
    }
}
