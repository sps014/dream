module system.cli;

/// Immutable parsing outcome for one command scope, including explicit-value provenance and child matches.
// Results are built bottom-up from fresh child scopes and never refer back to a parent.
@allow_cycle
public class ParsedArguments {
    help: bool;
    version: bool;
    text: string;
    name: string;
    entries: CliValue[];
    child: Option<ParsedArguments>;

    internal constructor(
        help: bool,
        version: bool,
        text: string,
        name: string,
        entries: CliValue[],
        child: Option<ParsedArguments>
    ) {
        this.help = help;
        this.version = version;
        this.text = text;
        this.name = name;
        this.entries = entries;
        this.child = child;
    }

    /// A successful parse of `name`'s scope.
    internal static fun values(
        name: string,
        entries: CliValue[],
        child: Option<ParsedArguments>
    ): ParsedArguments {
        return ParsedArguments(false, false, "", name, entries, child);
    }

    /// A help outcome when `help` is set, otherwise a version outcome.
    internal static fun text(help: bool, text: string): ParsedArguments {
        return ParsedArguments(help, !help, text, "", [], Option.None);
    }

    /// True when --help or -h was requested, including for a subcommand.
    public get is_help(): bool {
        return this.help;
    }

    /// True when --version or -V was requested.
    public get is_version(): bool {
        return this.version;
    }

    /// Deterministic generated help when is_help is true; otherwise empty.
    public get help_text(): string {
        return this.help ? this.text : "";
    }

    /// Generated version text when is_version is true; otherwise empty.
    public get version_text(): string {
        return this.version ? this.text : "";
    }

    /// Command name for successful value outcomes; empty for help/version outcomes.
    public get command_name(): string {
        return this.name;
    }

    /// Selected child scope, or None when no subcommand was invoked.
    public get subcommand(): Option<ParsedArguments> {
        return this.child;
    }

    /// True only for arguments explicitly supplied on the command line, excluding defaults.
    public fun is_present(name: string): bool {
        let entry = this.entry(name);
        return entry.is_some() && entry.unwrap().provided;
    }

    /// Returns a string positional or the last occurrence of a string option; missing values and wrong getter types return errors.
    public fun get_string(name: string): Result<string, CliError> {
        let values = this.get_strings(name)?;
        if values.length == 0 {
            return Result.Err(CliError("ENOENT", "argument has no value: " + name));
        }
        return Result.Ok(values[values.length - 1]);
    }

    /// Copies all string values in order, including an optional default when no value was supplied.
    public fun get_strings(name: string): Result<string[], CliError> {
        let entry = this.typed(name, CliArgumentKind.String)?;
        return Result.Ok(entry.values.clone().take_array());
    }

    /// Returns the last parsed integer; every occurrence has already passed decimal 32-bit validation.
    public fun get_int(name: string): Result<int, CliError> {
        let values = this.get_ints(name)?;
        if values.length == 0 {
            return Result.Err(CliError("ENOENT", "argument has no value: " + name));
        }
        return Result.Ok(values[values.length - 1]);
    }

    /// Copies every parsed integer occurrence in order.
    public fun get_ints(name: string): Result<int[], CliError> {
        let entry = this.typed(name, CliArgumentKind.Int)?;
        let result = Buffer.alloc<int>(entry.values.length);
        for (let i = 0; i < entry.values.length; i = i + 1) {
            result[i] = CliValidation.parse_int(entry.values[i]).unwrap();
        }
        return Result.Ok(result);
    }

    /// Returns the declared boolean flag, false when omitted; wrong getter types return errors.
    public fun get_bool(name: string): Result<bool, CliError> {
        let entry = this.typed(name, CliArgumentKind.Flag)?;
        return Result.Ok(entry.values.length > 0 && entry.values[entry.values.length - 1] == "true");
    }

    /// Copies declared names in declaration order for typed configuration merging; is_present distinguishes explicit values.
    public fun config_keys(): string[] {
        let keys = Buffer.alloc<string>(this.entries.length);
        for (let i = 0; i < this.entries.length; i = i + 1) {
            keys[i] = this.entries[i].argument.name;
        }
        return keys;
    }

    /// Returns the final scalar value for configuration merging, including typed options.
    public fun config_value(name: string): Result<string, CliError> {
        let entry = this.entry(name);
        if entry.is_none() {
            return Result.Err(CliError("ENOENT", "unknown argument: " + name));
        }
        let values = entry.unwrap().values;
        if values.length == 0 {
            return Result.Err(CliError("ENOENT", "argument has no value: " + name));
        }
        return Result.Ok(values[values.length - 1]);
    }

    fun entry(borrow name: string): Option<CliValue> {
        for let entry in this.entries {
            if entry.argument.name == name {
                return Option.Some(entry);
            }
        }
        return Option.None;
    }

    // String getters also read positionals, which always hold strings.
    fun typed(borrow name: string, expected: CliArgumentKind): Result<CliValue, CliError> {
        let entry = this.entry(name);
        if entry.is_none() {
            return Result.Err(CliError("ENOENT", "unknown argument: " + name));
        }
        let kind = entry.unwrap().argument.kind;
        if kind != expected
            && !(expected == CliArgumentKind.String && kind == CliArgumentKind.Positional) {
            return Result.Err(CliError("ETYPE", "incorrect getter for argument: " + name));
        }
        return Result.Ok(entry.unwrap());
    }
}
