module system.codegen;

import system;
import system.collections;
import system.json;

/// Builds generated source text and records its source locations.
public class ArtifactBuilder {
    buf: StringBuilder;
    current_line: int;
    current_column: int;

    /// Locations mapping generated text back to source declarations.
    public source_map: GenSourceMap;

    // Creates an empty builder.
    public constructor() {
        this.buf = StringBuilder();
        this.current_line = 1;
        this.current_column = 1;
        this.source_map = GenSourceMap();
    }

    // Appends text and advances the source-map position.
    public fun append(text: string): void {
        this.buf.append(text);
        for (let c in text) {
            if c == '\n' {
                this.current_line = this.current_line + 1;
                this.current_column = 1;
            } else if c.to_int() < 56320 || c.to_int() > 57343 {
                // A low surrogate continues the scalar already counted at its high surrogate.
                this.current_column = this.current_column + 1;
            }
        }
    }

    // Appends text mapped to the given snapshot node identity.
    public fun mapped(text: string, target: string): void {
        if text.is_empty() {
            return;
        }
        let line = this.current_line;
        let column = this.current_column;
        this.append(text);
        this.source_map.add(line, column, this.current_line, this.current_column, target);
    }

    // Appends a complete line of artifact text.
    public fun line(text: string): void {
        this.append(text + "\n");
    }

    // Returns the accumulated artifact text.
    public override fun to_string(): string {
        return this.buf.to_string();
    }
}
