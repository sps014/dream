module system.codegen;

import system;
import system.collections;
import system.json;

/// One attribute argument as written: `kind` is `string`, `int`, `float`, `double`, `bool` or
/// `enum`; `value` is the unquoted string, literal text, or dotted enum path.
public class GenAttrArg {
    /// Literal category of the argument as written (`string`, `int`, `enum`, ...).
    public kind: GenValueKind;

    /// Unquoted string, literal text, or dotted enum path, depending on `kind`.
    public value: string;

    /// Resolved identifier of a declaration argument, or an empty string when unresolved.
    public symbol: string;

    /// Creates a `GenAttrArg` from its parts. Generators normally receive these from `GenContext`
    /// rather than constructing them.
    public constructor(kind: GenValueKind, value: string, symbol: string) {
        this.kind = kind;
        this.value = value;
        this.symbol = symbol;
    }
}
