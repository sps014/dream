module system.codegen;

import system;
import system.collections;
import system.json;

// One attribute argument as written: `kind` is `string`, `int`, `float`, `double`, `bool` or
// `enum`; `value` is the unquoted string, literal text, or dotted enum path.
public class GenAttrArg {
    /// Category of this entry.
    public kind: string;

    /// Value carried by this entry.
    public value: string;

    /// Resolved identifier of a declaration argument, or an empty string when unresolved.
    public symbol: string;

    // Creates the snapshot model from the supplied values.
    public constructor(kind: string, value: string, symbol: string) {
        this.kind = kind;
        this.value = value;
        this.symbol = symbol;
    }
}
