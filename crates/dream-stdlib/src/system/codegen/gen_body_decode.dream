module system.codegen;

import system;
import system.collections;
import system.json;

/// Expression categories exposed to source generators.
public enum ExprKind {
    /// Identifies pattern expressions.
    Pattern,
    /// Identifies unknown expressions.
    Unknown,
    /// Identifies literal expressions.
    Literal,
    /// Identifies identifier expressions.
    Identifier,
    /// Identifies array expressions.
    Array,
    /// Identifies array repeat expressions.
    ArrayRepeat,
    /// Identifies tuple expressions.
    Tuple,
    /// Identifies set expressions.
    Set,
    /// Identifies map expressions.
    Map,
    /// Identifies binary expressions.
    Binary,
    /// Identifies unary expressions.
    Unary,
    /// Identifies inc dec expressions.
    IncDec,
    /// Identifies parenthesized expressions.
    Parenthesized,
    /// Identifies function call expressions.
    FunctionCall,
    /// Identifies call expressions.
    Call,
    /// Identifies index expressions.
    Index,
    /// Identifies cast expressions.
    Cast,
    /// Identifies size of expressions.
    SizeOf,
    /// Identifies align of expressions.
    AlignOf,
    /// Identifies name of expressions.
    NameOf,
    /// Identifies decl of expressions.
    DeclOf,
    /// Identifies type of expressions.
    TypeOf,
    /// Identifies member expressions.
    Member,
    /// Identifies is expressions.
    Is,
    /// Identifies method call expressions.
    MethodCall,
    /// Identifies ternary expressions.
    Ternary,
    /// Identifies await expressions.
    Await,
    /// Identifies switch expressions.
    Switch,
    /// Identifies try expressions.
    Try,
    /// Identifies lambda expressions.
    Lambda,
    /// Identifies named arg expressions.
    NamedArg,
    /// Identifies ref expressions.
    Ref,
    /// Identifies syntax block expressions.
    SyntaxBlock
}

/// Statement categories exposed to source generators.
public enum StmtKind {
    /// Identifies block statements.
    Block,
    /// Identifies unknown statements.
    Unknown,
    /// Identifies assignment statements.
    Assignment,
    /// Identifies index assignment statements.
    IndexAssignment,
    /// Identifies member assignment statements.
    MemberAssignment,
    /// Identifies declaration statements.
    Declaration,
    /// Identifies tuple declaration statements.
    TupleDeclaration,
    /// Identifies function invocation statements.
    FunctionInvocation,
    /// Identifies method invocation statements.
    MethodInvocation,
    /// Identifies return statements.
    Return,
    /// Identifies yield statements.
    Yield,
    /// Identifies await for each statements.
    AwaitForEach,
    /// Identifies if statements.
    If,
    /// Identifies while statements.
    While,
    /// Identifies do while statements.
    DoWhile,
    /// Identifies for statements.
    For,
    /// Identifies for each statements.
    ForEach,
    /// Identifies labeled statements.
    Labeled,
    /// Identifies break statements.
    Break,
    /// Identifies continue statements.
    Continue,
    /// Identifies expression statements.
    Expression,
    /// Identifies await statements.
    Await,
    /// Identifies switch statements.
    Switch,
    /// Identifies lock statements.
    Lock,
    /// Identifies defer statements.
    Defer,
    /// Identifies overflow statements.
    Overflow
}

// Nodes retain their source ordering, including nested statements in lambdas and switch arms.
internal fun gen_body(borrow v: JsonValue): Option<GenBody> {
    switch (v.get("body")) {
        Some(body) => {
            if !body.is_null() {
                return Option.Some(GenBody(body));
            }
        }
        None => {}
    }
    return Option.None;
}

internal fun gen_expr_kind(borrow kind: string): ExprKind {
    if kind == "Pattern" {
        return ExprKind.Pattern;
    }
    if kind == "Literal" {
        return ExprKind.Literal;
    }
    if kind == "Identifier" {
        return ExprKind.Identifier;
    }
    if kind == "Array" {
        return ExprKind.Array;
    }
    if kind == "ArrayRepeat" {
        return ExprKind.ArrayRepeat;
    }
    if kind == "Tuple" {
        return ExprKind.Tuple;
    }
    if kind == "Set" {
        return ExprKind.Set;
    }
    if kind == "Map" {
        return ExprKind.Map;
    }
    if kind == "Binary" {
        return ExprKind.Binary;
    }
    if kind == "Unary" {
        return ExprKind.Unary;
    }
    if kind == "IncDec" {
        return ExprKind.IncDec;
    }
    if kind == "Parenthesized" {
        return ExprKind.Parenthesized;
    }
    if kind == "FunctionCall" {
        return ExprKind.FunctionCall;
    }
    if kind == "Call" {
        return ExprKind.Call;
    }
    if kind == "Index" {
        return ExprKind.Index;
    }
    if kind == "Cast" {
        return ExprKind.Cast;
    }
    if kind == "SizeOf" {
        return ExprKind.SizeOf;
    }
    if kind == "AlignOf" {
        return ExprKind.AlignOf;
    }
    if kind == "NameOf" {
        return ExprKind.NameOf;
    }
    if kind == "DeclOf" {
        return ExprKind.DeclOf;
    }
    if kind == "TypeOf" {
        return ExprKind.TypeOf;
    }
    if kind == "Member" {
        return ExprKind.Member;
    }
    if kind == "Is" {
        return ExprKind.Is;
    }
    if kind == "MethodCall" {
        return ExprKind.MethodCall;
    }
    if kind == "Ternary" {
        return ExprKind.Ternary;
    }
    if kind == "Await" {
        return ExprKind.Await;
    }
    if kind == "Switch" {
        return ExprKind.Switch;
    }
    if kind == "Try" {
        return ExprKind.Try;
    }
    if kind == "Lambda" {
        return ExprKind.Lambda;
    }
    if kind == "NamedArg" {
        return ExprKind.NamedArg;
    }
    if kind == "Ref" {
        return ExprKind.Ref;
    }
    if kind == "SyntaxBlock" {
        return ExprKind.SyntaxBlock;
    }
    return ExprKind.Unknown;
}

internal fun gen_stmt_kind(borrow kind: string): StmtKind {
    if kind == "Block" {
        return StmtKind.Block;
    }
    if kind == "Assignment" {
        return StmtKind.Assignment;
    }
    if kind == "IndexAssignment" {
        return StmtKind.IndexAssignment;
    }
    if kind == "MemberAssignment" {
        return StmtKind.MemberAssignment;
    }
    if kind == "Declaration" {
        return StmtKind.Declaration;
    }
    if kind == "TupleDeclaration" {
        return StmtKind.TupleDeclaration;
    }
    if kind == "FunctionInvocation" {
        return StmtKind.FunctionInvocation;
    }
    if kind == "MethodInvocation" {
        return StmtKind.MethodInvocation;
    }
    if kind == "Return" {
        return StmtKind.Return;
    }
    if kind == "Yield" {
        return StmtKind.Yield;
    }
    if kind == "AwaitForEach" {
        return StmtKind.AwaitForEach;
    }
    if kind == "If" {
        return StmtKind.If;
    }
    if kind == "While" {
        return StmtKind.While;
    }
    if kind == "DoWhile" {
        return StmtKind.DoWhile;
    }
    if kind == "For" {
        return StmtKind.For;
    }
    if kind == "ForEach" {
        return StmtKind.ForEach;
    }
    if kind == "Labeled" {
        return StmtKind.Labeled;
    }
    if kind == "Break" {
        return StmtKind.Break;
    }
    if kind == "Continue" {
        return StmtKind.Continue;
    }
    if kind == "Expression" {
        return StmtKind.Expression;
    }
    if kind == "Await" {
        return StmtKind.Await;
    }
    if kind == "Switch" {
        return StmtKind.Switch;
    }
    if kind == "Lock" {
        return StmtKind.Lock;
    }
    if kind == "Defer" {
        return StmtKind.Defer;
    }
    if kind == "Overflow" {
        return StmtKind.Overflow;
    }
    return StmtKind.Unknown;
}
