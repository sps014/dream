module system.codegen;

import system;
import system.io;
import system.collections;
import system.json;

// One field on a snapshotted declaration type.
public class GenFieldInfo {
    public name: string;
    public type_name: string;

    public constructor(name: string, type_name: string) {
        this.name = name;
        this.type_name = type_name;
    }
}

// One declaration type snapshotted for an executed `@generator` body.
public class GenTypeInfo {
    public name: string;
    public attributes: List<string>;
    public fields: List<GenFieldInfo>;

    public constructor(name: string, attributes: List<string>, fields: List<GenFieldInfo>) {
        this.name = name;
        this.attributes = attributes;
        this.fields = fields;
    }

    public fun has_attribute(attr: string): bool {
        for (let a in this.attributes) {
            if (a == attr) {
                return true;
            }
        }
        return false;
    }
}

// One `introducer { ... }` syntax-DSL call site, snapshotted for an executed `@generator` body.
public class GenSyntaxBlock {
    // Opaque site id; pass back into `GenContext.replace`/`GenContext.error` unchanged.
    public id: int;
    // The introducer name (`quote`, `html`, ...).
    public name: string;
    // Raw reconstructed body text (splices appear as `{expr}` placeholders).
    public body: string;
    // Dream source of each `{ ... }` splice expression, in source order.
    public splices: List<string>;

    public constructor(id: int, name: string, body: string, splices: List<string>) {
        this.id = id;
        this.name = name;
        this.body = body;
        this.splices = splices;
    }
}

// Compile-time context handed to an executed `@generator` function body. Loaded from a host
// snapshot (see `from_snapshot`) and flushed back to the host via `finish()`, which prints the
// same `GenHost` stdout protocol a sibling `harness.dream` would print by hand.
public class GenContext {
    blocks: List<GenSyntaxBlock>;
    types: List<GenTypeInfo>;
    replacements: List<string>;
    extend_types: List<string>;
    extend_bodies: List<string>;
    file_paths: List<string>;
    file_sources: List<string>;
    error_line: string;
    has_error: bool;

    constructor(blocks: List<GenSyntaxBlock>, types: List<GenTypeInfo>) {
        this.blocks = blocks;
        this.types = types;
        this.replacements = List<string>();
        this.extend_types = List<string>();
        this.extend_bodies = List<string>();
        this.file_paths = List<string>();
        this.file_sources = List<string>();
        this.error_line = string.empty;
        this.has_error = false;
    }

    // Loads a `GenContext` from the JSON snapshot file the compiler wrote. The path is
    // passed to the generator harness as its first program argument.
    public static async fun from_snapshot(path: string): Result<GenContext, string> {
        if (path.is_empty()) {
            return Result.Err("snapshot path is empty");
        }
        let text_res = await File.read(path);
        switch (text_res) {
            Ok(text) => {
                let parsed = Json.parse(text);
                switch (parsed) {
                    Ok(root) => {
                        let arr = root.get("blocks").unwrap_or(JsonValue.array());
                        let blocks = List<GenSyntaxBlock>();
                        let i = 0;
                        while (i < arr.length) {
                            let b = arr.at(i).unwrap_or(JsonValue.none());
                            let id = b.get("id").unwrap_or(JsonValue.none()).as_int().unwrap_or(0);
                            let name = b.get("name").unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                            let body = b.get("body").unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                            let splices_json = b.get("splices").unwrap_or(JsonValue.array());
                            let splices = List<string>();
                            let j = 0;
                            while (j < splices_json.length) {
                                let s = splices_json.at(j).unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                                splices.push(s);
                                j = j + 1;
                            }
                            blocks.push(GenSyntaxBlock(id, name, body, splices));
                            i = i + 1;
                        }
                        let types_arr = root.get("types").unwrap_or(JsonValue.array());
                        let types = List<GenTypeInfo>();
                        let ti = 0;
                        while (ti < types_arr.length) {
                            let t = types_arr.at(ti).unwrap_or(JsonValue.none());
                            let tname = t.get("name").unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                            let attrs_json = t.get("attributes").unwrap_or(JsonValue.array());
                            let attributes = List<string>();
                            let ai = 0;
                            while (ai < attrs_json.length) {
                                let a = attrs_json.at(ai).unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                                attributes.push(a);
                                ai = ai + 1;
                            }
                            let fields_json = t.get("fields").unwrap_or(JsonValue.array());
                            let fields = List<GenFieldInfo>();
                            let fi = 0;
                            while (fi < fields_json.length) {
                                let f = fields_json.at(fi).unwrap_or(JsonValue.none());
                                let fname = f.get("name").unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                                let ftype = f.get("type_name").unwrap_or(JsonValue.none()).as_string().unwrap_or(string.empty);
                                fields.push(GenFieldInfo(fname, ftype));
                                fi = fi + 1;
                            }
                            types.push(GenTypeInfo(tname, attributes, fields));
                            ti = ti + 1;
                        }
                        return Result.Ok(GenContext(blocks, types));
                    }
                    Err(e) => {
                        return Result.Err("failed to parse snapshot JSON: " + e.message());
                    }
                }
            }
            Err(e) => {
                return Result.Err("failed to read snapshot: " + e.message());
            }
        }
    }

    // Every snapshotted `name { ... }` call site (e.g. `ctx.syntax_blocks("quote")`).
    public fun syntax_blocks(name: string): List<GenSyntaxBlock> {
        let out = List<GenSyntaxBlock>();
        for (let b in this.blocks) {
            if (b.name == name) {
                out.push(b);
            }
        }
        return out;
    }

    // Every snapshotted call site, regardless of introducer.
    public fun all_blocks(): List<GenSyntaxBlock> {
        return this.blocks;
    }

    // Every snapshotted declaration type carrying attribute `attr`.
    public fun types_with(attr: string): List<GenTypeInfo> {
        let out = List<GenTypeInfo>();
        for (let t in this.types) {
            if (t.has_attribute(attr)) {
                out.push(t);
            }
        }
        return out;
    }

    // Rewrites `block`'s call site to the Dream expression `dream_expr` before type-checking.
    public fun replace(block: GenSyntaxBlock, dream_expr: string): void {
        this.replacements.push(block.id.to_string() + "\t" + dream_expr);
    }

    // Queues synthesized `extend Type { ... }` source for the host to merge before type-checking.
    public fun emit_extend(type_name: string, body: string): void {
        this.extend_types.push(type_name);
        this.extend_bodies.push(body);
    }

    // Queues a synthetic Dream source file for the host to parse and merge.
    public fun emit_file(path: string, source: string): void {
        this.file_paths.push(path);
        this.file_sources.push(source);
    }

    // Queues a generate-time diagnostic for `block` (surfaces as `CompileError::Generator`).
    // Only the first reported error is kept, mirroring the harness `ERR` protocol's one-message
    // contract.
    public fun error(block: GenSyntaxBlock, message: string): void {
        if (this.has_error == false) {
            this.has_error = true;
            this.error_line = block.id.to_string() + "\t" + message;
        }
    }

    // Queues a generate-time diagnostic with no associated call site.
    public fun error_general(message: string): void {
        if (this.has_error == false) {
            this.has_error = true;
            this.error_line = message;
        }
    }

    // Flushes accumulated replace/error/emit calls to stdout using the `GenHost` protocol.
    public fun finish(): void {
        if (this.has_error) {
            System.println(GenHost.err_marker());
            System.println(this.error_line);
            return;
        }
        System.println(GenHost.ok_marker());
        for (let line in this.replacements) {
            System.println(line);
        }
        let ei = 0;
        while (ei < this.extend_types.length) {
            System.println(GenHost.emit_extend_marker());
            System.println(this.extend_types.get(ei));
            System.println(escape_gen_payload(this.extend_bodies.get(ei)));
            ei = ei + 1;
        }
        let fi = 0;
        while (fi < this.file_paths.length) {
            System.println(GenHost.emit_file_marker());
            System.println(this.file_paths.get(fi));
            System.println(escape_gen_payload(this.file_sources.get(fi)));
            fi = fi + 1;
        }
    }
}

fun escape_gen_payload(s: string): string {
    return s.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r");
}
