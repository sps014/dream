module system.codegen;

import system;
import system.io;
import system.collections;
import system.json;

// Snapshot format this package reads; the compiler writes the same number.
fun gen_snapshot_version(): int {
    return 2;
}

// What a `@generator fun name(ctx: GenContext)` sees and produces. The compiler runs the
// generator's cached executable with `--generator <name> --snapshot <in> --result <out>`; the
// harness loads the context from the snapshot, calls the generator, and `finish()` writes the
// result the compiler validates and merges.
/// Input and output of a source generator. Inspect selected declarations, request tools, report
/// diagnostics, and add or replace generated source through this context.
public class GenContext {
    // The running generator's name and `module::name` identity.
    public generator_name: string;
    /// Stable identifier of the generator being executed.
    public generator_id: string;
    // Target triple of the compile (`aarch64-apple-darwin`, `wasm32-unknown-wasi`, ...).
    public target: string;
    snapshot: GenSnapshot;
    result_path: string;
    outputs: JsonValue;
    diagnostics: JsonValue;
    logs: JsonValue;
    extends: Map<string, StringBuilder>;
    error_count: int;

    constructor(snapshot: GenSnapshot, result_path: string) {
        this.generator_name = snapshot.generator;
        this.generator_id = snapshot.generator_id;
        this.target = snapshot.target;
        this.snapshot = snapshot;
        this.result_path = result_path;
        this.outputs = JsonValue.array();
        this.diagnostics = JsonValue.array();
        this.logs = JsonValue.array();
        this.extends = Map<string, StringBuilder>();
        this.error_count = 0;
    }

    // Reads `--snapshot` / `--result` from the program arguments.
    public static async fun load(args: string[]): Result<GenContext, string> {
        let snapshot_path = "";
        let result_path = "";
        let i = 0;
        while i + 1 < args.length {
            if args[i] == "--snapshot" {
                snapshot_path = args[i + 1];
            } else if args[i] == "--result" {
                result_path = args[i + 1];
            }
            i = i + 1;
        }
        if snapshot_path.is_empty() || result_path.is_empty() {
            return Result.Err("usage: --generator <name> --snapshot <path> --result <path>");
        }
        let text = File.read(snapshot_path).await;
        switch (text) {
            Ok(source) => {
                switch (Json._parse(source)) {
                    Ok(root) => {
                        let snapshot = GenSnapshot(root);
                        if snapshot.version != gen_snapshot_version() {
                            return Result.Err(
                                "snapshot version "
                                    + snapshot.version.to_string()
                                    + " does not match system.codegen ("
                                    + gen_snapshot_version()
                                    .to_string() + "); rebuild the generator"
                            );
                        }
                        return Result.Ok(GenContext(snapshot, result_path));
                    }
                    Err(e) => {
                        return Result.Err(
                            "malformed snapshot " + snapshot_path + ": " + e.message()
                        );
                    }
                }
            }
            Err(e) => {
                return Result.Err("cannot read snapshot " + snapshot_path + ": " + e.message());
            }
        }
    }

    // Declarations carrying `@A` (on the declaration or on one of its members).
    public fun types_with<A>(): List<GenDecl> {
        let id = GenAttributes.id<A>();
        let out = List<GenDecl>();
        for (let d in this.snapshot.decls) {
            if gen_decl_carries(d, id) {
                out.push(d);
            }
        }
        return out;
    }

    // Top-level functions carrying `@A` (on the function or a parameter).
    public fun functions_with<A>(): List<GenFunction> {
        let id = GenAttributes.id<A>();
        let out = List<GenFunction>();
        for (let f in this.snapshot.functions) {
            if gen_function_carries(f, id) {
                out.push(f);
            }
        }
        return out;
    }

    // Every declaration selected by this generator's `@on_attribute` triggers.
    public fun decls(): List<GenDecl> {
        return this.snapshot.decls;
    }

    // The compiler-tool feedback round, starting at zero.
    /// Current generation round, starting at zero and increasing after tool requests.
    public fun phase(): int {
        return this.snapshot.phase;
    }

    // Transitive dependencies of the declarations selected by this generator.
    public fun referenced_decls(): List<GenDecl> {
        return this.snapshot.referenced;
    }

    // Top-level functions referenced by selected declarations or their dependencies.
    public fun referenced_functions(): List<GenFunction> {
        return this.snapshot.referenced_functions;
    }

    // Looks up a selected or referenced declaration by its compiler identity.
    /// Looks up a selected or referenced declaration by its stable identifier.
    public fun find_decl(borrow id: string): Option<GenDecl> {
        for (let d in this.snapshot.decls) {
            if d.id == id {
                return Option.Some(d);
            }
        }
        for (let d in this.snapshot.referenced) {
            if d.id == id {
                return Option.Some(d);
            }
        }
        return Option.None;
    }

    // Looks up a selected or referenced function, including methods.
    public fun find_function(borrow id: string): Option<GenFunction> {
        for (let f in this.snapshot.functions) {
            if f.id == id || f.overload == id {
                return Option.Some(f);
            }
        }
        for (let f in this.snapshot.referenced_functions) {
            if f.id == id || f.overload == id {
                return Option.Some(f);
            }
        }
        for (let d in this.snapshot.decls) {
            for (let f in d.methods) {
                if f.id == id || f.overload == id {
                    return Option.Some(f);
                }
            }
        }
        for (let d in this.snapshot.referenced) {
            for (let f in d.methods) {
                if f.id == id || f.overload == id {
                    return Option.Some(f);
                }
            }
        }
        return Option.None;
    }

    // The inferred type, or an explicit Unknown when pre-analysis could not resolve it.
    public fun type_of(borrow expr: GenExpr): GenTypeRef {
        return expr.ty;
    }

    // The inferred type attached to a statement, or Unknown when it has no value type.
    public fun type_of(borrow stmt: GenStmt): GenTypeRef {
        return stmt.ty;
    }

    // The resolved symbol identity, or an empty string for an unresolved expression.
    public fun symbol_of(borrow expr: GenExpr): string {
        return expr.symbol;
    }

    // Looks up a signature view anywhere in the pre-generation compilation.
    public fun find_symbol(borrow id: string): Option<GenSymbol> {
        for (let s in this.snapshot.symbols) {
            if s.id == id {
                return Option.Some(s);
            }
            switch (s.function) {
                Some(f) => {
                    if f.id == id || f.overload == id {
                        return Option.Some(s);
                    }
                }
                None => {}
            }
        }
        return Option.None;
    }

    // Errors found before generation within declarations selected by this generator's triggers.
    public fun compilation_errors(): List<GenCompilationError> {
        return this.snapshot.compilation_errors;
    }

    // Classes and structs implementing an interface, including inherited interface relations.
    public fun implementations_of(borrow id: string): List<GenSymbol> {
        let out = List<GenSymbol>();
        for (let s in this.subtypes_of(id)) {
            if s.kind == "class" || s.kind == "struct" {
                out.push(s);
            }
        }
        return out;
    }

    // Signature views whose declared interface ancestry includes the given identity.
    public fun subtypes_of(borrow id: string): List<GenSymbol> {
        let out = List<GenSymbol>();
        let known = List<string>();
        known.push(id);
        let i = 0;
        while i < known.length {
            let base = known.get(i);
            for (let s in this.snapshot.symbols) {
                if !known.contains(s.id) {
                    switch (s.declaration) {
                        Some(d) => {
                            for (let parent in d.interfaces) {
                                if parent.decl == base {
                                    known.push(s.id);
                                    out.push(s);
                                    break;
                                }
                            }
                        }
                        None => {}
                    }
                }
            }
            i = i + 1;
        }
        return out;
    }

    // Every type in the program, by name and kind.
    public fun type_index(): List<GenIndexEntry> {
        return this.snapshot.index;
    }

    // The index entry named `name`, if the program declares such a type.
    public fun find_type(borrow name: string): Option<GenIndexEntry> {
        for (let e in this.snapshot.index) {
            if e.name == name {
                return Option.Some(e);
            }
        }
        return Option.None;
    }

    // `name { ... }` sites introduced by this generator's name (`@syntax_block` generators).
    public fun syntax_blocks(): List<GenSyntaxBlock> {
        return this.snapshot.blocks;
    }

    // Calls of the functions named in this generator's `@on_call(...)`.
    public fun call_sites(): List<GenCallSite> {
        return this.snapshot.calls;
    }

    // `dream.toml` `[[generators]].options`, decoded into the `@json` type `T`.
    public fun options<T>(): Result<T, ParseError> {
        return Json.deserialize<T>(Json._stringify(this.snapshot.options));
    }

    // One option as text (`fallback` when unset).
    public fun option_or(borrow key: string, fallback: string): string {
        switch (this.snapshot.options.get(key)) {
            Some(v) => {
                switch (v.as_string()) {
                    Some(s) => {
                        return s;
                    }
                    None => {
                        return Json._stringify(v);
                    }
                }
            }
            None => {
                return fallback;
            }
        }
    }

    // `dream.toml` `[[generators]].additional_files`, read by the compiler.
    /// Returns the files listed in `[[generators]].additional_files` in `dream.toml`.
    public fun additional_files(): List<GenFile> {
        return this.snapshot.files;
    }

    // Rewrites `block`'s site to the Dream expression `source`.
    public fun replace(borrow block: GenSyntaxBlock, source: string): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("replace"));
        out.set("site", JsonValue.from_string(block.id));
        out.set("source", JsonValue.from_string(source));
        this.outputs.push(out);
    }

    // Adds a complete Dream source file at the generator-relative path `path` (`models.json.dream`).
    // It is written under `.dream/generated/<entry>/<generator>/` and compiled with the program.
    public fun emit_file(path: string, source: string): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("file"));
        out.set("path", JsonValue.from_string(path));
        out.set("source", JsonValue.from_string(source));
        this.outputs.push(out);
    }

    // Declared tools with the versions and fingerprints used in this compilation.
    public fun tools(): List<GenToolInfo> {
        return this.snapshot.tools;
    }

    // Compiler-collected feedback from the previous phase.
    /// Returns tool results from the previous generation round.
    public fun tool_results(): List<GenToolResult> {
        return this.snapshot.tool_results;
    }

    // Requests a declared tool; the compiler reruns this generator with its results.
    /// Requests a declared tool. The generator runs again with the result in the next phase.
    public fun run_tool(
        id: string,
        tool: string,
        args: List<string>,
        inputs: List<string>,
        outputs: List<string>
    ): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("tool_run"));
        out.set("id", JsonValue.from_string(id));
        out.set("tool", JsonValue.from_string(tool));
        out.set("args", gen_json_strings(args));
        out.set("inputs", gen_json_strings(inputs));
        out.set("outputs", gen_json_strings(outputs));
        this.outputs.push(out);
    }

    // Embeds an artifact or tool output into every compilation target.
    public fun emit_asset(name: string, source: string): void {
        this.emit_asset(name, source, List<string>());
    }

    // Embeds an artifact or tool output for the selected target triples or families.
    public fun emit_asset(name: string, source: string, targets: List<string>): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("asset"));
        out.set("name", JsonValue.from_string(name));
        out.set("source", JsonValue.from_string(source));
        out.set("targets", gen_json_strings(targets));
        this.outputs.push(out);
    }

    // Removes a selected or referenced user function from the compiled program.
    public fun consume(borrow f: GenFunction): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("consume"));
        out.set("target", JsonValue.from_string(f.id));
        this.outputs.push(out);
    }

    // Emits a non-Dream file with source mappings under this generator's directory.
    public fun emit_artifact(
        path: string,
        contents: string,
        borrow map: GenSourceMap,
        publish: bool = false
    ): void {
        let out = JsonValue.dict();
        out.set("kind", JsonValue.from_string("artifact"));
        out.set("path", JsonValue.from_string(path));
        out.set("contents", JsonValue.from_string(contents));
        out.set("mappings", map.mappings);
        out.set("publish", JsonValue.boolean(publish));
        this.outputs.push(out);
    }

    // Reports an artifact location through its source map to the originating Dream node.
    public fun error_in_artifact(path: string, line: int, column: int, message: string): void {
        let d = JsonValue.dict();
        d.set("severity", JsonValue.from_string("error"));
        d.set("message", JsonValue.from_string(message));
        d.set("artifact", JsonValue.from_string(path));
        d.set("line", JsonValue.from_int(line));
        d.set("column", JsonValue.from_int(column));
        this.diagnostics.push(d);
        this.error_count = this.error_count + 1;
    }

    // Extensions keep their declaring module, including its internal visibility and name scope.
    public fun emit_extend(borrow decl: GenDecl, body: string): void {
        if !this.extends.contains(decl.module_name) {
            this.extends.set(decl.module_name, StringBuilder());
        }
        let source = this.extends.get(decl.module_name).unwrap();
        source.append("extend " + decl.self_type() + " {\n");
        source.append(body);
        if !body.ends_with("\n") {
            source.append("\n");
        }
        source.append("}\n\n");
    }

    fun report(severity: string, borrow target: string, message: string): void {
        let d = JsonValue.dict();
        d.set("severity", JsonValue.from_string(severity));
        d.set("message", JsonValue.from_string(message));
        d.set("target", JsonValue.from_string(target));
        this.diagnostics.push(d);
        if severity == "error" {
            this.error_count = this.error_count + 1;
        }
    }

    // An error at the node with identity `target` (any model node's `id`), or at the generator
    // itself for an empty `target`.
    public fun error_at(borrow target: string, message: string): void {
        this.report("error", target, message);
    }

    // Reports a warning at this model node.
    public fun warning_at(borrow target: string, message: string): void {
        this.report("warning", target, message);
    }

    // Reports an error at this model node or at the generator when no node is supplied.
    public fun error(message: string): void {
        this.report("error", "", message);
    }

    // Reports an error at this model node or at the generator when no node is supplied.
    public fun error(borrow block: GenSyntaxBlock, message: string): void {
        this.report("error", block.id, message);
    }

    // Reports an error at this model node or at the generator when no node is supplied.
    public fun error(borrow decl: GenDecl, message: string): void {
        this.report("error", decl.id, message);
    }

    // Reports an error at this model node or at the generator when no node is supplied.
    public fun error(borrow field: GenField, message: string): void {
        this.report("error", field.id, message);
    }

    // Reports an error at this model node or at the generator when no node is supplied.
    public fun error(borrow call: GenCallSite, message: string): void {
        this.report("error", call.id, message);
    }

    // Reports a warning at this model node.
    public fun warning(borrow decl: GenDecl, message: string): void {
        this.report("warning", decl.id, message);
    }

    // Returns the requested model information.
    public fun has_errors(): bool {
        return this.error_count > 0;
    }

    // A line shown with `dream -v` / `dream generate --explain`.
    public fun log(message: string): void {
        this.logs.push(JsonValue.from_string(message));
    }

    // Writes the result for the compiler; the harness returns this as the exit code.
    /// Writes the generator result and returns its exit status.
    public async fun finish(): int {
        let extensions = this.extends.entries();
        extensions.sort_by(
            (a, b) => {
                return a.key.compare(b.key);
            }
        );
        for (let entry in extensions) {
            let path = "extends.dream";
            let header = "";
            if !entry.key.is_empty() {
                path = "extends/" + entry.key.replace(".", "/") + ".dream";
                header = "module " + entry.key + ";\n\n";
            }
            this.emit_file(path, header + entry.value.to_string());
        }
        let root = JsonValue.dict();
        root.set("version", JsonValue.from_int(gen_snapshot_version()));
        root.set("generator", JsonValue.from_string(this.generator_name));
        root.set("outputs", this.outputs);
        root.set("diagnostics", this.diagnostics);
        root.set("logs", this.logs);
        let written = File.write(this.result_path, Json._stringify(root)).await;
        switch (written) {
            Ok(_) => {
                return 0;
            }
            Err(e) => {
                System.println(
                    "cannot write generator result " + this.result_path + ": " + e.message()
                );
                return 3;
            }
        }
    }
}

fun gen_function_carries(borrow f: GenFunction, borrow id: string): bool {
    if GenAttributes.has(f.attributes, id) {
        return true;
    }
    for (let p in f.params) {
        if GenAttributes.has(p.attributes, id) {
            return true;
        }
    }
    return false;
}

fun gen_decl_carries(borrow d: GenDecl, borrow id: string): bool {
    if GenAttributes.has(d.attributes, id) {
        return true;
    }
    for (let f in d.fields) {
        if GenAttributes.has(f.attributes, id) {
            return true;
        }
    }
    for (let v in d.variants) {
        for (let f in v.fields) {
            if GenAttributes.has(f.attributes, id) {
                return true;
            }
        }
    }
    for (let m in d.methods) {
        if gen_function_carries(m, id) {
            return true;
        }
    }
    return false;
}

fun gen_json_strings(borrow strings: List<string>): JsonValue {
    let out = JsonValue.array();
    for (let s in strings) {
        out.push(JsonValue.from_string(s));
    }
    return out;
}
