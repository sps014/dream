module system.codegen;

import system;
import system.collections;

// The program model a `@generator` reads through `GenContext`: declarations with resolved type
// references and typed attribute access, syntax-block sites and call sites. Every node has a
// stable `id` (`module::Name`, `module::Name.member`, `site:file:line:col`, `call:...`) that
// diagnostics are anchored to.

// Built-in scalar types.
public enum Primitive {
    /// Identifies not primitive types.
    NotPrimitive,
    /// Identifies int types.
    Int,
    /// Identifies long types.
    Long,
    /// Identifies uint types.
    UInt,
    /// Identifies ulong types.
    ULong,
    /// Identifies isize types.
    ISize,
    /// Identifies usize types.
    USize,
    /// Identifies byte types.
    Byte,
    /// Identifies float types.
    Float,
    /// Identifies double types.
    Double,
    /// Identifies bool types.
    Bool,
    /// Identifies char types.
    Char,
    /// Identifies string types.
    String,
    /// Identifies object types.
    Object
}

// Standard collection shapes a generator usually special-cases.
public enum CollectionKind {
    /// Identifies not collection types.
    NotCollection,
    /// Identifies list types.
    List,
    /// Identifies set types.
    Set,
    /// Identifies map types.
    Map,
    /// Identifies sorted map types.
    SortedMap,
    /// Identifies array types.
    Array
}

// What a `GenTypeRef` refers to.
public enum TypeRefKind {
    /// Identifies primitive types.
    Primitive,
    /// Identifies named types.
    Named,
    /// Identifies param types.
    Param,
    /// Identifies array types.
    Array,
    /// Identifies tuple types.
    Tuple,
    /// Identifies function types.
    Function,
    /// Identifies void types.
    Void,
    /// Identifies unknown types.
    Unknown
}

// What a `GenDecl` declares.
public enum DeclKind {
    /// Identifies class declarations.
    Class,
    /// Identifies struct declarations.
    Struct,
    /// Identifies union declarations.
    Union,
    /// Identifies enum declarations.
    Enum,
    /// Identifies interface declarations.
    Interface
}

// `Primitive` for a Dream scalar type name (`int`, `string`, ...).
public fun primitive_named(name: string): Primitive {
    if name == "int" {
        return Primitive.Int;
    }
    if name == "long" {
        return Primitive.Long;
    }
    if name == "uint" {
        return Primitive.UInt;
    }
    if name == "ulong" {
        return Primitive.ULong;
    }
    if name == "isize" {
        return Primitive.ISize;
    }
    if name == "usize" {
        return Primitive.USize;
    }
    if name == "byte" {
        return Primitive.Byte;
    }
    if name == "float" {
        return Primitive.Float;
    }
    if name == "double" {
        return Primitive.Double;
    }
    if name == "bool" {
        return Primitive.Bool;
    }
    if name == "char" {
        return Primitive.Char;
    }
    if name == "string" {
        return Primitive.String;
    }
    if name == "object" {
        return Primitive.Object;
    }
    return Primitive.NotPrimitive;
}
