module system.codegen;

import system;
import system.collections;
import system.json;

/// A function parameter and its type and attributes.
public class GenParam {
    /// Parameter name as declared.
    public name: string;

    /// Declared type of the parameter.
    public ty: GenTypeRef;

    /// Whether this is a `ref` parameter, so assignments to it in the body are visible to the
    /// caller.
    public is_ref: bool;

    /// Attributes attached to this declaration.
    public attributes: List<GenAttribute>;

    /// Creates a `GenParam` from its parts. Generators normally receive these from `GenContext`
    /// rather than constructing them.
    public constructor(name: string, ty: GenTypeRef, is_ref: bool, attributes: List<GenAttribute>) {
        this.name = name;
        this.ty = ty;
        this.is_ref = is_ref;
        this.attributes = attributes;
    }

    /// The first `@A` attached to this parameter, decoded into `A`, or `None` when absent.
    public fun attribute<A>(): Option<A> {
        return GenAttributes.decode<A>(this.attributes);
    }

    /// Whether this parameter carries at least one `@A` attribute.
    public fun has<A>(): bool {
        return GenAttributes.has(this.attributes, GenAttributes.id<A>());
    }
}
