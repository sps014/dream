module system.codegen;

import system;
import system.collections;
import system.json;

/// A source range described by its starting location and length.
public class GenSpan {
    /// Source file path.
    public file: string;

    /// One-based line number in the source file.
    public line: int;

    /// One-based column number in the source file.
    public column: int;

    /// Number of elements in this range.
    public length: int;

    /// Decodes a `GenSpan` from its object in the generation snapshot.
    public constructor(borrow v: JsonValue) {
        this.file = gen_str(v, "file");
        this.line = gen_int(v, "line");
        this.column = gen_int(v, "column");
        this.length = gen_int(v, "length");
    }
}
