module system.codegen;

import system;
import system.collections;
import system.json;

/// A file produced by a tool requested during generation.
public class GenToolFile {
    /// Request or resource path.
    public path: string;

    /// File contents: text, or base64 when `binary` is true. Empty for an opaque output.
    public contents: string;

    /// Whether the file is not valid UTF-8 text, so `contents` holds base64.
    public binary: bool;

    /// BLAKE3 hash of the file bytes, as lowercase hex.
    public hash: string;

    /// Size of the file in bytes.
    public size: int;

    /// Whether the file was requested as an opaque output. Its bytes are not in the snapshot;
    /// embed or publish it by referring to it as `tool:<request id>/<path>`.
    public opaque: bool;

    // Decodes compiler-collected tool metadata from a snapshot.
    /// Reads a tool-output file description from its JSON representation.
    public constructor(borrow v: JsonValue) {
        this.path = gen_str(v, "path");
        this.contents = gen_str(v, "contents");
        this.binary = gen_bool(v, "binary");
        this.hash = gen_str(v, "hash");
        this.size = gen_int(v, "size");
        this.opaque = gen_bool(v, "opaque");
    }
}
