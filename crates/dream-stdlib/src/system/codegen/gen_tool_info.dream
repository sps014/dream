module system.codegen;

import system;
import system.collections;
import system.json;

/// Identity and configuration of an available generation tool.
public class GenToolInfo {
    /// Name identifying this entry.
    public name: string;

    /// Version identifying this API or snapshot format.
    public version: string;

    /// Content fingerprint identifying this version of the tool.
    public fingerprint: string;

    /// Whether the tool was found on this machine. Requesting an unavailable tool with
    /// `GenContext.run_tool` fails with the reason it could not be found, so a generator can
    /// skip a step that only an optional tool performs.
    public available: bool;

    // Decodes compiler-collected tool metadata from a snapshot.
    /// Reads an available tool description from its JSON representation.
    public constructor(borrow v: JsonValue) {
        this.name = gen_str(v, "name");
        this.version = gen_str(v, "version");
        this.fingerprint = gen_str(v, "fingerprint");
        this.available = gen_bool(v, "available");
    }
}
