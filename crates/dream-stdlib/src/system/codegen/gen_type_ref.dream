module system.codegen;

import system;
import system.collections;
import system.json;

// A resolved type with structured arguments and declaration identity.
@allow_cycle
public class GenTypeRef {
    public kind: TypeRefKind;
    // `int`, `List`, `T`, or empty for arrays/tuples/functions.
    public name: string;
    // Display spelling, including canonical module qualification for resolved names.
    public display: string;
    // Compiler-mangled spelling (`List_int`), unique per instantiation; handy for helper names.
    public mangled: string;
    // Identity of the named declaration (`::User`, `system.collections::List`), or empty.
    public decl: string;
    // Type arguments; the element of an array; tuple members; function params then return.
    public args: List<GenTypeRef>;

    // Creates the snapshot model from the supplied values.
    public constructor(kind: TypeRefKind, name: string, display: string, mangled: string, decl: string, args: List<GenTypeRef>) {
        this.kind = kind;
        this.name = name;
        this.display = display;
        this.mangled = mangled;
        this.decl = decl;
        this.args = args;
    }

    // Returns the requested model information.
    public static fun unknown(): GenTypeRef {
        return GenTypeRef(TypeRefKind.Unknown, "", "", "", "", List<GenTypeRef>());
    }

    // The scalar this type is, or `Primitive.NotPrimitive`.
    public fun primitive(): Primitive {
        if this.kind != TypeRefKind.Primitive {
            return Primitive.NotPrimitive;
        }
        return primitive_named(this.name);
    }

    // Returns the requested model information.
    public fun is_primitive(p: Primitive): bool {
        return this.primitive() == p;
    }

    // The standard collection this type is, or `CollectionKind.NotCollection`.
    public fun collection(): CollectionKind {
        if this.kind == TypeRefKind.Array {
            return CollectionKind.Array;
        }
        if this.kind != TypeRefKind.Named {
            return CollectionKind.NotCollection;
        }
        if this.name == nameof(List) && this.args.length == 1 {
            return CollectionKind.List;
        }
        if this.name == nameof(Set) && this.args.length == 1 {
            return CollectionKind.Set;
        }
        if this.name == nameof(Map) && this.args.length == 2 {
            return CollectionKind.Map;
        }
        if this.name == nameof(SortedMap) && this.args.length == 2 {
            return CollectionKind.SortedMap;
        }
        return CollectionKind.NotCollection;
    }

    // Returns the requested model information.
    public fun is_option(): bool {
        return this.kind == TypeRefKind.Named && this.name == nameof(Option) && this.args.length == 1;
    }

    // Returns the requested model information.
    public fun is_param(): bool {
        return this.kind == TypeRefKind.Param;
    }

    // True when this names the declaration `decl_id` (see `declof`).
    public fun is_decl(decl_id: string): bool {
        return this.decl.length > 0 && this.decl == decl_id;
    }

    // Type argument `i`, or an unknown type when there is none.
    public fun arg(i: int): GenTypeRef {
        if i < 0 || i >= this.args.length {
            return GenTypeRef.unknown();
        }
        return this.args.get(i);
    }

    /// Renders a type using local declaration names in a scope that imports those declarations.
    public fun source_name(): string {
        if this.kind == TypeRefKind.Array { return this.arg(0).source_name() + "[]"; }
        if this.kind == TypeRefKind.Tuple || this.kind == TypeRefKind.Function {
            let result = "("; if this.kind == TypeRefKind.Function { result = "fun("; }
            let end = this.args.length; if this.kind == TypeRefKind.Function { end--; }
            let i = 0; while i < end { if i > 0 { result = result + ", "; } result = result + this.arg(i).source_name(); i++; }
            result = result + ")"; if this.kind == TypeRefKind.Function { result = result + ": " + this.arg(end).source_name(); } return result;
        }
        let name = this.name; let parts = name.split(':'); if parts.length > 1 { name = parts[parts.length - 1]; }
        if !this.args.is_empty() { name = name + "<"; let i = 0; for (let arg in this.args) { if i > 0 { name = name + ", "; } name = name + arg.source_name(); i++; } name = name + ">"; }
        return name;
    }

    // Returns the requested model information.
    public override fun to_string(): string {
        return this.display;
    }
}
