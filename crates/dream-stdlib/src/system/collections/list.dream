module system.collections;

// Dream standard `List<T>` (`import system.collections;`).

// Natural-order (ascending) comparator over any `Comparable` type. Kept as a free generic function
// so `List<T : Comparable<T>>.sort()` can hand it to the single merge-sort implementation in
// `sort_by` as a first-class value — the sort algorithm lives in exactly one place.
fun compare_ascending<T : Comparable<T>>(borrow a: T, borrow b: T): int {
    return a.compare(b);
}

// Growable random-access sequence backed by a resizable buffer.
public class List<T> : IndexedCollection<T> {
    items: T[];
    count: int;

    // Allocates an empty list with an initial backing buffer capacity (defaults to 8).
    public constructor(capacity: int = 8) {
        let c = capacity;
        if c < sequence_min_capacity() {
            c = sequence_min_capacity();
        }
        this.items = Buffer.alloc<T>(c);
        this.count = 0;
    }

    // Allocates an empty list with backing capacity `capacity`.
    public static fun with_capacity(capacity: int): List<T> {
        return List<T>(capacity);
    }

    // Number of elements currently stored.
    @inline
    public get length(): int {
        return this.count;
    }

    // True when the list has no elements.
    @inline
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Current capacity of the backing buffer.
    @inline
    public get capacity(): int {
        return this.items.length;
    }

    // Doubles the backing buffer, resizing in place via `Buffer.realloc` when possible.
    @inline
    fun grow(): void {
        let old_cap = this.items.length;
        let new_cap = old_cap * 2;
        if new_cap < sequence_min_capacity() {
            new_cap = sequence_min_capacity();
        }
        this.items = Buffer.realloc<T>(this.items, new_cap);
    }

    // Appends a value to the end, growing if necessary.
    @inline
    public fun push(value: T): void {
        if this.count == this.items.length {
            this.grow();
        }
        this.items[this.count] = value;
        this.count = this.count + 1;
    }

    // Appends every element of `items`, ensuring capacity once then copying via `Span`.
    public fun push_all(borrow items: T[]): void {
        let src = Span<T>.of(items);
        let n = src.length;
        let need = this.count + n;
        while need > this.items.length {
            this.grow();
        }
        let dst = Span<T>(this.items, this.count, n);
        dst.copy_from(src);
        this.count = this.count + n;
    }

    // Builds a list containing exactly the elements of `items`, in order. The `[e1, e2, ...]`
    // list-literal syntax (e.g. `let xs: List<int> = [1, 2, 3];`) desugars to this.
    public static fun from_array(borrow items: T[]): List<T> {
        let result = List<T>(items.length);
        result.push_all(items);
        return result;
    }

    // Yields a `T[]` of exactly `length` and leaves this list empty. Shrinks via `realloc` when
    // capacity is larger than `count` so the result's `.length` is the live element count.
    public fun take_array(): T[] {
        let n = this.count;
        let out = Buffer.alloc<T>(n);
        let i = 0;
        while i < n {
            out[i] = this.items[i];
            i = i + 1;
        }
        this.items = Buffer.alloc<T>(0);
        this.count = 0;
        return out;
    }

    // Element at `index`. Panics if `index` is out of range.
    public fun this[index: int]: T {
        if (index < 0) || (index >= this.count) {
            System.panic("List index out of range");
        }
        return this.items[index];
    }

    // Overwrites the element at `index`. Panics if `index` is out of range.
    public fun this[index: int] = value: T {
        if (index < 0) || (index >= this.count) {
            System.panic("List index out of range");
        }
        this.items[index] = value;
    }

    public fun set(index: int, value: T): void {
        this[index] = value;
    }

    // Removes and returns the last element, or `None` if the list is empty.
    public fun pop(): Option<T> {
        if this.count == 0 {
            return Option.None;
        }
        let i = this.count - 1;
        let last = this.items[i];
        // Zero the slot after copying out. Needed for value structs with reference fields: a bare
        // `count--` would leave a second owner in dead capacity and double-release on the next
        // overwrite or when the backing array is dropped.
        this.items[i] = Buffer.alloc<T>(1)[0];
        this.count = i;
        return Option.Some(last);
    }

    // True if `value` is present (uses value equality, including string contents).
    public fun contains(borrow value: T): bool {
        let i = 0;
        while i < this.count {
            if this.items[i] == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    // Index of the first matching element (by value equality), or `None` if absent.
    public fun index_of(borrow value: T): Option<int> {
        let i = 0;
        while i < this.count {
            if this.items[i] == value {
                return Option.Some(i);
            }
            i = i + 1;
        }
        return Option.None;
    }

    // Index of the last matching element (by value equality), or `None` if absent.
    public fun last_index_of(borrow value: T): Option<int> {
        let i = this.count - 1;
        while i >= 0 {
            if this.items[i] == value {
                return Option.Some(i);
            }
            i = i - 1;
        }
        return Option.None;
    }

    // Grows the backing buffer until `capacity()` is at least `n`.
    public fun reserve(n: int): void {
        while this.items.length < n {
            this.grow();
        }
    }

    // Reverses the live prefix in place.
    public fun reverse(): void {
        let lo = 0;
        let hi = this.count - 1;
        while lo < hi {
            let a = this.items[lo];
            this.items[lo] = this.items[hi];
            this.items[hi] = a;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    // A new list of `this[start .. end)` (clamped; empty when the span is inverted).
    public fun slice(start: int, end: int): List<T> {
        let lo = start;
        let hi = end;
        if lo < 0 {
            lo = 0;
        }
        if hi > this.count {
            hi = this.count;
        }
        if lo > hi {
            lo = hi;
        }
        let result = List<T>(hi - lo);
        let i = lo;
        while i < hi {
            result.push(this.items[i]);
            i = i + 1;
        }
        return result;
    }

    // A new list with this list's elements followed by `other`.
    public fun concat(borrow other: List<T>): List<T> {
        let result = List<T>(this.count + other.length);
        let i = 0;
        while i < this.count {
            result.push(this.items[i]);
            i = i + 1;
        }
        i = 0;
        while i < other.length {
            result.push(other.get(i));
            i = i + 1;
        }
        return result;
    }

    // A shallow copy of the live elements.
    public fun clone(): List<T> {
        return this.slice(0, this.count);
    }

    // Joins stringifiable elements with `sep` (same conversion as `to_string` uses). Single pass
    // into a StringBuilder — O(total output), never the quadratic accumulate-and-recopy shape.
    public fun join(sep: string): string {
        let sb = StringBuilder();
        let i = 0;
        while i < this.count {
            if i > 0 {
                sb.append(sep);
            }
            sb.append(this.items[i].to_string());
            i = i + 1;
        }
        return sb.build();
    }

    // Empties the list while keeping the backing buffer. Live slots are overwritten with a zero
    // value so reference fields inside value-struct elements (and class elements) release
    // immediately; capacity is unchanged (no capacity-sized `Buffer.alloc`).
    @inline
    public fun clear(): void {
        if this.count > 0 {
            let z = Buffer.alloc<T>(1);
            let i = 0;
            while i < this.count {
                this.items[i] = z[0];
                i = i + 1;
            }
        }
        this.count = 0;
    }

    // Unmanaged: no RC to release — rewind the count only.
    @inline
    public fun clear(): void where T : unmanaged {
        this.count = 0;
    }

    // Inserts `value` at `index`, shifting later elements right. Returns false if `index` is out
    // of range (index may equal `size()` to append).
    public fun insert(index: int, value: T): bool {
        if (index < 0) || (index > this.count) {
            return false;
        }
        if this.count == this.items.length {
            this.grow();
        }
        let n = this.count - index;
        if n > 0 {
            Span<T>(this.items, index + 1, n).copy_from(Span<T>(this.items, index, n));
        }
        this.items[index] = value;
        this.count = this.count + 1;
        return true;
    }

    // Unmanaged: one `memory.copy` shift (no Span wrappers).
    public fun insert(index: int, value: T): bool where T : unmanaged {
        if (index < 0) || (index > this.count) {
            return false;
        }
        if this.count == this.items.length {
            this.grow();
        }
        let items = this.items;
        let n = this.count - index;
        if n > 0 {
            Buffer.elems_copy<T>(items, index + 1, items, index, n);
        }
        items[index] = value;
        this.count = this.count + 1;
        return true;
    }

    // Removes the element at `index`, shifting later elements left. Returns true on success, or
    // false if `index` is out of range (the list is left unchanged in that case).
    public fun remove_at(index: int): bool {
        if (index < 0) || (index >= this.count) {
            return false;
        }
        let n = this.count - index - 1;
        if n > 0 {
            Span<T>(this.items, index, n).copy_from(Span<T>(this.items, index + 1, n));
        }
        this.count = this.count - 1;
        // Zero the vacated tail slot: it still holds a second reference to the last shifted
        // element and would retain it past the next overwrite.
        this.items[this.count] = Buffer.alloc<T>(1)[0];
        return true;
    }

    // Removes the first occurrence of `value` (by equality). Returns true when something was removed.
    public fun remove(borrow value: T): bool {
        return switch (this.index_of(value)) {
            Some(i) => this.remove_at(i),
            None => false,
        };
    }

    // Enumerator for `for (let x in list)`. Returns a fresh cursor over the current elements.
    public fun iterator(): ListIterator<T> {
        return ListIterator<T>(this);
    }

    // Unchecked element access for `ListIterator` (same-module; index already validated).
    internal fun at_unchecked(index: int): T {
        return this.items[index];
    }

    // Sorts the list in place with the supplied comparator.
    public fun sort_by(borrow cmp: fun(T, T): int): void {
        let n = this.count;
        if n < 2 {
            return;
        }
        let buf = Buffer.alloc<T>(n);
        let width = 1;
        while width < n {
            let i = 0;
            while i < n {
                let mid = i + width;
                if mid > n {
                    mid = n;
                }
                let right = mid + width;
                if right > n {
                    right = n;
                }
                let a = i;
                let b = mid;
                let k = i;
                while (a < mid) && (b < right) {
                    if cmp(this.items[a], this.items[b]) <= 0 {
                        buf[k] = this.items[a];
                        a = a + 1;
                    } else {
                        buf[k] = this.items[b];
                        b = b + 1;
                    }
                    k = k + 1;
                }
                while a < mid {
                    buf[k] = this.items[a];
                    a = a + 1;
                    k = k + 1;
                }
                while b < right {
                    buf[k] = this.items[b];
                    b = b + 1;
                    k = k + 1;
                }
                i = right;
            }
            let j = 0;
            while j < n {
                this.items[j] = buf[j];
                j = j + 1;
            }
            width = width + width;
        }
    }

    // Sorts the list in place into ascending order using each element's `compare` method.
    // Only attached when `T : Comparable<T>` (via `where`).
    public fun sort(): void where T : Comparable<T> {
        let cmp: fun(T, T): int = compare_ascending;
        this.sort_by(cmp);
    }

    // Binary search over a list that is already sorted ascending (by `compare`). Returns the index
    // of a matching element as `Some(index)`, or `None` if `value` is not present. O(log n).
    // Only attached when `T : Comparable<T>` (via `where`).
    public fun binary_search(borrow value: T): Option<int> where T : Comparable<T> {
        let lo = 0;
        let hi = this.count - 1;
        while lo <= hi {
            let mid = lo + (hi - lo) / 2;
            let c = this.items[mid].compare(value);
            if c == 0 {
                return Option.Some(mid);
            }
            if c < 0 {
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }
        return Option.None;
    }

    override public fun to_string(): string {
        let sb = StringBuilder();
        sb.append("[");
        let i = 0;
        while i < this.count {
            if i > 0 {
                sb.append(", ");
            }
            sb.append(this.items[i].to_string());
            i = i + 1;
        }
        sb.append("]");
        return sb.build();
    }
}
