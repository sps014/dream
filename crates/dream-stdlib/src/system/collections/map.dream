module system.collections;

// A generic open-addressing hash map.
public class Map<K, V> : Collection<KeyValuePair<K, V>> {
    keys: K[];
    values: V[];
    states: int[];
    defaults: V[];
    // Reused zero key for `clear` (same role as `defaults` for values).
    empty_keys: K[];
    count: int;
    used: int;
    cap: int;

    // Allocates an empty map with an initial capacity (defaults to 8, rounded up to power of 2).
    public constructor(capacity: int = 8) {
        let c = hash_min_capacity();
        while (c < capacity) {
            c = c * 2;
        }
        this.cap = c;
        this.keys = Buffer.alloc<K>(c);
        this.values = Buffer.alloc<V>(c);
        this.states = Buffer.alloc<int>(c);
        this.defaults = Buffer.alloc<V>(1);
        this.empty_keys = Buffer.alloc<K>(1);
        this.count = 0;
        this.used = 0;
    }

    // Number of key/value pairs currently stored.
    public get length(): int {
        return this.count;
    }

    // Current capacity of the backing buffer.
    public fun capacity(): int {
        return this.cap;
    }

    // Initial probe index for a key.
    fun home(borrow key: K): int {
        let h = key.hash_code();
        return h & (this.cap - 1);
    }

    // Index of an occupied slot holding a key, or -1.
    // Flag-controlled loop (no `break`/`return` inside) so relooper keeps a single-header `loop`.
    fun find(borrow key: K): int {
        let keys = this.keys;
        let states = this.states;
        let cap = this.cap;
        let idx = key.hash_code() & (cap - 1);
        let result = -1;
        let done = false;
        while (done == false) {
            let s = states[idx];
            if (s == hash_slot_empty()) {
                done = true;
            } else {
                if (s == hash_slot_occupied()) {
                    if (keys[idx] == key) {
                        result = idx;
                        done = true;
                    }
                }
                if (done == false) {
                    idx = idx + 1;
                    if (idx == cap) {
                        idx = 0;
                    }
                }
            }
        }
        return result;
    }

    // Probe and insert/update without checking load factor. Used by `set` and `rehash` so those two
    // are not mutually recursive (a cycle would block the whole-module inliner).
    fun insert_no_grow(key: K, value: V): void {
        let keys = this.keys;
        let values = this.values;
        let states = this.states;
        let cap = this.cap;
        let idx = key.hash_code() & (cap - 1);
        let first_tomb = -1;
        let done = false;
        while (done == false) {
            let s = states[idx];
            if (s == hash_slot_empty()) {
                let target = idx;
                if (first_tomb >= 0) {
                    target = first_tomb;
                }
                keys[target] = key;
                values[target] = value;
                states[target] = hash_slot_occupied();
                this.count = this.count + 1;
                if (first_tomb < 0) {
                    this.used = this.used + 1;
                }
                done = true;
            } else {
                if ((s == hash_slot_occupied()) && (keys[idx] == key)) {
                    values[idx] = value;
                    done = true;
                } else {
                    if ((s != hash_slot_occupied()) && (first_tomb < 0)) {
                        first_tomb = idx;
                    }
                    idx = idx + 1;
                    if (idx == cap) {
                        idx = 0;
                    }
                }
            }
        }
    }

    // Grows and rehashes the map when it gets too full.
    fun rehash(): void {
        let old_keys = this.keys;
        let old_values = this.values;
        let old_states = this.states;
        let old_cap = this.cap;
        let new_cap = old_cap * 2;
        if (new_cap < hash_min_capacity()) {
            new_cap = hash_min_capacity();
        }
        this.keys = Buffer.alloc<K>(new_cap);
        this.values = Buffer.alloc<V>(new_cap);
        this.states = Buffer.alloc<int>(new_cap);
        this.cap = new_cap;
        this.count = 0;
        this.used = 0;
        let i = 0;
        while (i < old_cap) {
            if (old_states[i] == hash_slot_occupied()) {
                this.insert_no_grow(old_keys[i], old_values[i]);
            }
            i = i + 1;
        }
    }

    // Inserts or updates the value for a key.
    @set_indexer
    public fun set(key: K, value: V): void {
        if ((this.used + 1) * hash_load_factor_denom() >= this.cap * hash_load_factor_num()) {
            this.rehash();
        }
        this.insert_no_grow(key, value);
    }

    // True if the map contains the key.
    public fun contains(borrow key: K): bool {
        return this.find(key) >= 0;
    }

    // Inserts or updates a value for every `keys[i] -> values[i]` pair. If the two arrays differ in
    // length, the extra tail of the longer one is ignored. Also what the `{k1: v1, ...}`
    // map-literal syntax lowers to via `from_arrays`, so a literal with N entries costs one call to
    // build each backing array plus one call here, not N `set` calls.
    public fun set_all(borrow keys: K[], borrow values: V[]): void {
        let n = keys.length;
        if (values.length < n) {
            n = values.length;
        }
        let i = 0;
        while (i < n) {
            this.set(keys[i], values[i]);
            i = i + 1;
        }
    }

    // Builds a map from parallel `keys`/`values` arrays. The `{k1: v1, k2: v2, ...}` map-literal
    // syntax (e.g. `let m: Map<string, int> = {"a": 1, "b": 2};`) desugars to this.
    public static fun from_arrays(borrow keys: K[], borrow values: V[]): Map<K, V> {
        let result = Map<K, V>(keys.length);
        result.set_all(keys, values);
        return result;
    }

    // Gets the value for a key, or None.
    @get_indexer
    public fun get(borrow key: K): Option<V> {
        let i = this.find(key);
        if (i >= 0) {
            return Option.Some(this.values[i]);
        }
        return Option.None;
    }

    // Gets the value for a key, or a fallback.
    public fun get_or(borrow key: K, fallback: V): V {
        let i = this.find(key);
        if (i >= 0) {
            return this.values[i];
        }
        return fallback;
    }

    // Removes a key and returns true if it was removed.
    public fun remove(borrow key: K): bool {
        let i = this.find(key);
        if (i >= 0) {
            this.states[i] = hash_slot_tombstone();
            this.values[i] = this.defaults[0];
            this.count = this.count - 1;
            return true;
        }
        return false;
    }

    // True if the map is empty.
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Removes all entries, keeping the current capacity. Occupied key/value slots are zeroed so
    // managed entries release; probe `states` are reset in place (no triple `Buffer.alloc`).
    public fun clear(): void {
        let c = this.cap;
        let zk = this.empty_keys[0];
        let zv = this.defaults[0];
        let i = 0;
        while (i < c) {
            if (this.states[i] == hash_slot_occupied()) {
                this.keys[i] = zk;
                this.values[i] = zv;
            }
            this.states[i] = hash_slot_empty();
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
    }

    // Unmanaged keys/values: only reset probe states (no per-slot key/value zero).
    public fun clear(): void where K : unmanaged, V : unmanaged {
        let c = this.cap;
        Buffer.elems_fill<int>(this.states, 0, c);
        this.count = 0;
        this.used = 0;
    }

    // Gets all keys.
    public fun keys(): K[] {
        let result = Buffer.alloc<K>(this.count);
        let i = 0;
        let j = 0;
        while (i < this.cap) {
            if (this.states[i] == hash_slot_occupied()) {
                result[j] = this.keys[i];
                j = j + 1;
            }
            i = i + 1;
        }
        return result;
    }

    // Gets all values.
    public fun values(): V[] {
        let result = Buffer.alloc<V>(this.count);
        let i = 0;
        let j = 0;
        while (i < this.cap) {
            if (this.states[i] == hash_slot_occupied()) {
                result[j] = this.values[i];
                j = j + 1;
            }
            i = i + 1;
        }
        return result;
    }

    // Gets an iterator for the map.
    @iterator
    public fun iterator(): MapIterator<K, V> {
        return MapIterator<K, V>(this);
    }

    // Slot helpers for `MapIterator` (same-module).
    internal fun slot_occupied(i: int): bool {
        return this.states[i] == hash_slot_occupied();
    }

    internal fun slot_key(i: int): K {
        return this.keys[i];
    }

    internal fun slot_value(i: int): V {
        return this.values[i];
    }
}
