module system.collections;

// A generic open-addressing hash map. Slots are packed `{key, value, state}` records.
public class Map<K, V> : Collection<KeyValuePair<K, V>> {
    slots: MapSlot<K, V>[];
    defaults: V[];
    empty_keys: K[];
    count: int;
    used: int;
    cap: int;
    epoch: int;

    public constructor(capacity: int = 8) {
        let c = hash_min_capacity();
        while c < capacity {
            c = c * 2;
        }
        this.cap = c;
        this.slots = Buffer.alloc<MapSlot<K, V>>(c);
        this.defaults = Buffer.alloc<V>(1);
        this.empty_keys = Buffer.alloc<K>(1);
        this.count = 0;
        this.used = 0;
        this.epoch = hash_epoch_initial();
    }

    fun bump_epoch(): void {
        let e = this.epoch + 1;
        if e <= 0 {
            let i = 0;
            while i < this.cap {
                this.slots[i].state = 0;
                i = i + 1;
            }
            e = hash_epoch_initial();
        }
        this.epoch = e;
    }

    public get length(): int {
        return this.count;
    }

    @inline
    public fun capacity(): int {
        return this.cap;
    }

    fun find(borrow key: K): int {
        let slots = this.slots;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = key.hash_code() & (cap - 1);
        let result = -1;
        let done = false;
        while done == false {
            let s = slots[idx].state;
            if (s != epoch) && (s != tomb) {
                done = true;
            } else {
                if s == epoch {
                    if slots[idx].key == key {
                        result = idx;
                        done = true;
                    }
                }
                if done == false {
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
        return result;
    }

    fun insert_no_grow(key: K, value: V): void {
        let slots = this.slots;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = key.hash_code() & (cap - 1);
        let first_tomb = -1;
        let done = false;
        while done == false {
            let s = slots[idx].state;
            if (s != epoch) && (s != tomb) {
                let target = idx;
                if first_tomb >= 0 {
                    target = first_tomb;
                }
                slots[target].key = key;
                slots[target].value = value;
                slots[target].state = epoch;
                this.count = this.count + 1;
                if first_tomb < 0 {
                    this.used = this.used + 1;
                }
                done = true;
            } else {
                if (s == epoch) && (slots[idx].key == key) {
                    slots[idx].value = value;
                    done = true;
                } else {
                    if (s == tomb) && (first_tomb < 0) {
                        first_tomb = idx;
                    }
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
    }

    fun rehash(): void {
        let old = this.slots;
        let old_cap = this.cap;
        let new_cap = old_cap * 2;
        if new_cap < hash_min_capacity() {
            new_cap = hash_min_capacity();
        }
        this.slots = Buffer.alloc<MapSlot<K, V>>(new_cap);
        this.cap = new_cap;
        this.count = 0;
        this.used = 0;
        let i = 0;
        while i < old_cap {
            if old[i].state == this.epoch {
                this.insert_no_grow(old[i].key, old[i].value);
            }
            i = i + 1;
        }
    }

    public fun this[key: K] = value: V {
        if (this.used + 1) * hash_load_factor_denom() >= this.cap * hash_load_factor_num() {
            this.rehash();
        }
        this.insert_no_grow(key, value);
    }

    public fun set(key: K, value: V): void {
        this[key] = value;
    }

    public fun contains(borrow key: K): bool {
        return this.find(key) >= 0;
    }

    public fun set_all(borrow keys: K[], borrow values: V[]): void {
        let n = keys.length;
        if values.length < n {
            n = values.length;
        }
        let i = 0;
        while i < n {
            this.set(keys[i], values[i]);
            i = i + 1;
        }
    }

    public static fun from_arrays(borrow keys: K[], borrow values: V[]): Map<K, V> {
        let result = Map<K, V>(keys.length);
        result.set_all(keys, values);
        return result;
    }

    // Value for `key`, or `None` when absent.
    @inline
    public fun get(borrow key: K): Option<V> {
        let i = this.find(key);
        if i >= 0 {
            return Option.Some(this.slots[i].value);
        }
        return Option.None;
    }

    // Value for `key`. Panics when the key is absent — this is what `m[k]` compiles to; use
    // `get(k)` for absence-tolerant reads.
    public fun this[borrow key: K]: V {
        let i = this.find(key);
        if i < 0 {
            System.panic("Map key not found");
        }
        return this.slots[i].value;
    }

    @inline
    public fun get_or(borrow key: K, fallback: V): V {
        let i = this.find(key);
        if i >= 0 {
            return this.slots[i].value;
        }
        return fallback;
    }

    public fun get_or_insert(key: K, borrow factory: fun(): V): V {
        let i = this.find(key);
        if i >= 0 {
            return this.slots[i].value;
        }
        let value = factory();
        this.set(key, value);
        return value;
    }

    public fun merge(borrow other: Map<K, V>): void {
        for (let pair in other) {
            this.set(pair.key, pair.value);
        }
    }

    public fun entries(): List<KeyValuePair<K, V>> {
        let result = List<KeyValuePair<K, V>>(this.count);
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result.push(KeyValuePair<K, V>(this.slots[i].key, this.slots[i].value));
            }
            i = i + 1;
        }
        return result;
    }

    public fun remove(borrow key: K): bool {
        let i = this.find(key);
        if i >= 0 {
            this.slots[i].state = 0 - this.epoch;
            // Zero both halves of the tombstoned slot so managed keys release immediately,
            // not just on slot reuse.
            this.slots[i].key = this.empty_keys[0];
            this.slots[i].value = this.defaults[0];
            this.count = this.count - 1;
            return true;
        }
        return false;
    }

    @inline
    public fun is_empty(): bool {
        return this.count == 0;
    }

    @inline
    public fun clear(): void {
        let c = this.cap;
        let e = this.epoch;
        let zk = this.empty_keys[0];
        let zv = this.defaults[0];
        let i = 0;
        while i < c {
            if this.slots[i].state == e {
                this.slots[i].key = zk;
                this.slots[i].value = zv;
            }
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    @inline
    public fun clear(): void where K : unmanaged, V : unmanaged {
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    public fun keys(): K[] {
        let result = Buffer.alloc<K>(this.count);
        let i = 0;
        let j = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result[j] = this.slots[i].key;
                j = j + 1;
            }
            i = i + 1;
        }
        return result;
    }

    public fun values(): V[] {
        let result = Buffer.alloc<V>(this.count);
        let i = 0;
        let j = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result[j] = this.slots[i].value;
                j = j + 1;
            }
            i = i + 1;
        }
        return result;
    }

    public fun iterator(): MapIterator<K, V> {
        return MapIterator<K, V>(this);
    }

    internal fun slot_occupied(i: int): bool {
        return this.slots[i].state == this.epoch;
    }

    internal fun slot_key(i: int): K {
        return this.slots[i].key;
    }

    internal fun slot_value(i: int): V {
        return this.slots[i].value;
    }

    override public fun to_string(): string {
        let sb = StringBuilder();
        sb.append("{");
        let n = 0;
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                if n > 0 {
                    sb.append(", ");
                }
                sb.append(this.slots[i].key.to_string());
                sb.append(": ");
                sb.append(this.slots[i].value.to_string());
                n = n + 1;
            }
            i = i + 1;
        }
        sb.append("}");
        return sb.build();
    }
}
