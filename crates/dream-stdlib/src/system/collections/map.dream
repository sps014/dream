module system.collections;

/// A generic open-addressing hash map. Slots are packed `{key, value, state}` records.
@slot_walk("capacity", "slot_entry", "slot_occupied")
public class Map<K, V>: Collection<KeyValuePair<K, V>> {
    slots: MapSlot<K, V>[];
    count: int;
    used: int;
    cap: int;
    epoch: int;

    /// Creates an empty map, reserving space based on `capacity` (8 by default).
    public constructor(capacity: int = 8) {
        let c = hash_capacity_for(capacity);
        this.cap = c;
        this.slots = Buffer.alloc<MapSlot<K, V>>(c);
        this.count = 0;
        this.used = 0;
        this.epoch = hash_epoch_initial();
    }

    /// Reserves additional live entries, accounting for load factor and reclaiming tombstones.
    public fun reserve(additional: int): Result<Unit, CapacityError> {
        let need = (long)this.count + (long)additional;
        let required = (
            (need + 1L) * (long)hash_load_factor_denom() + (long)hash_load_factor_num() - 1L
        ) / (long)hash_load_factor_num();
        if additional < 0 || required > 268435456L {
            return Result.Err(CapacityError());
        }
        let capacity = hash_capacity_for((int)required);
        if capacity < this.cap {
            capacity = this.cap;
        }
        if capacity > this.cap
            || ((long)this.used + (long)additional)
            * (long)hash_load_factor_denom() >= (long)this.cap * (long)hash_load_factor_num() {
            this.rehash(capacity);
        }
        return Result.Ok(Unit());
    }

    fun bump_epoch(): void {
        let e = this.epoch + 1;
        if e <= 0 {
            let i = 0;
            while i < this.cap {
                this.slots[i].state = 0;
                i = i + 1;
            }
            e = hash_epoch_initial();
        }
        this.epoch = e;
    }

    /// Number of elements currently stored.
    public get length(): int {
        return this.count;
    }

    /// Number of elements that fit before storage must grow.
    @inline
    public get capacity(): int {
        return this.cap;
    }

    fun slot_of(borrow key: K): int {
        return this.find_hashed(key, key.hash_code());
    }

    fun find_hashed(borrow key: K, hash: int): int {
        let slots = this.slots;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = hash & (cap - 1);
        let result = -1;
        let done = false;
        while done == false {
            let s = slots[idx].state;
            if (s != epoch) && (s != tomb) {
                done = true;
            } else {
                if s == epoch {
                    if slots[idx].key == key {
                        result = idx;
                        done = true;
                    }
                }
                if done == false {
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
        return result;
    }

    @inline
    fun find_span(borrow key: ReadOnlySpan<char>): int where K: StringKey {
        let slots = this.slots;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = key.hash_code() & (cap - 1);
        while true {
            let s = slots[idx].state;
            if (s != epoch) && (s != tomb) {
                return -1;
            }
            if (s == epoch) && slots[idx].key.matches_span(key) {
                return idx;
            }
            idx = idx + 1;
            if idx == cap {
                idx = 0;
            }
        }
    }

    fun insert_no_grow(key: K, value: V, hash: int): void {
        let slots = this.slots;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = hash & (cap - 1);
        let first_tomb = -1;
        let done = false;
        while done == false {
            let s = slots[idx].state;
            if (s != epoch) && (s != tomb) {
                let target = idx;
                if first_tomb >= 0 {
                    target = first_tomb;
                }
                slots[target].key = key;
                slots[target].value = value;
                slots[target].state = epoch;
                this.count = this.count + 1;
                if first_tomb < 0 {
                    this.used = this.used + 1;
                }
                done = true;
            } else {
                if (s == epoch) && (slots[idx].key == key) {
                    slots[idx].value = value;
                    done = true;
                } else {
                    if (s == tomb) && (first_tomb < 0) {
                        first_tomb = idx;
                    }
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
    }

    // When `old` is uniquely owned, `hash_code` cannot observe it through `this` (already
    // replaced), so slots move with `take` instead of key/value retains.
    fun rehash(new_cap: int): void {
        let old = this.slots;
        let old_cap = this.cap;
        this.slots = Buffer.alloc<MapSlot<K, V>>(new_cap);
        this.cap = new_cap;
        this.count = 0;
        this.used = 0;
        let can_transfer = CollectionStorage.owners(old) == 1;
        let i = 0;
        while i < old_cap {
            if old[i].state == this.epoch {
                let hash = old[i].key.hash_code();
                if can_transfer {
                    let target = hash & (new_cap - 1);
                    while this.slots[target].state == this.epoch {
                        target = (target + 1) & (new_cap - 1);
                    }
                    this.slots[target] = CollectionStorage.take<MapSlot<K, V>>(old, i);
                    this.count = this.count + 1;
                    this.used = this.used + 1;
                } else {
                    this.insert_no_grow(old[i].key, old[i].value, hash);
                }
            }
            i = i + 1;
        }
    }

    /// The first probe hits an empty or matching slot on the usual insert. That case stays in the
    /// caller; collisions fall through to the full probe.
    @inline
    public fun this[key: K] = value: V {
        let hash = key.hash_code();
        if (this.used + 1) * hash_load_factor_denom() >= this.cap * hash_load_factor_num() {
            if this.find_hashed(key, hash) < 0 {
                this.rehash(hash_capacity_for(this.cap + 1));
            }
        }
        let idx = hash & (this.cap - 1);
        let slot_state = this.slots[idx].state;
        let epoch = this.epoch;
        if slot_state == epoch && this.slots[idx].key == key {
            this.slots[idx].value = value;
        } else if slot_state != epoch && slot_state != (0 - epoch) {
            this.slots[idx].key = key;
            this.slots[idx].value = value;
            this.slots[idx].state = epoch;
            this.count = this.count + 1;
            this.used = this.used + 1;
        } else {
            this.insert_no_grow(key, value, hash);
        }
    }

    /// Returns whether `key` is present.
    public fun contains(borrow key: K): bool {
        return this.slot_of(key) >= 0;
    }

    /// Inserts corresponding entries from `keys` and `values`; the arrays must have equal
    /// lengths.
    public fun set_all(borrow keys: K[], borrow values: V[]): void {
        let n = keys.length;
        if values.length < n {
            n = values.length;
        }
        let i = 0;
        while i < n {
            this[keys[i]] = values[i];
            i = i + 1;
        }
    }

    /// Creates a map by pairing keys and values up to the shorter array length; later duplicate keys replace earlier values.
    public constructor(borrow keys: K[], borrow values: V[]) {
        let c = hash_capacity_for(keys.length);
        this.cap = c;
        this.slots = Buffer.alloc<MapSlot<K, V>>(c);
        this.count = 0;
        this.used = 0;
        this.epoch = hash_epoch_initial();
        this.set_all(keys, values);
    }

    /// Value for `key`, or `None` when absent.
    @inline
    @borrowed_result
    public fun get(borrow key: K): Option<V> {
        let i = this.slot_of(key);
        if i >= 0 {
            return Option.Some(this.slots[i].value);
        }
        return Option.None;
    }

    /// Value for the `string` key equal to `key`, without building a `string`.
    @borrowed_result
    public fun get(borrow key: ReadOnlySpan<char>): Option<V> where K: StringKey {
        let i = this.find_span(key);
        if i >= 0 {
            return Option.Some(this.slots[i].value);
        }
        return Option.None;
    }

    /// Returns whether `key` is present.
    public fun contains(borrow key: ReadOnlySpan<char>): bool where K: StringKey {
        return this.find_span(key) >= 0;
    }

    /// Value for `key`. Panics when the key is absent — this is what `m[k]` compiles to; use
    /// `get(k)` for absence-tolerant reads.
    public fun this[borrow key: K]: V {
        let i = this.slot_of(key);
        if i < 0 {
            System.panic("Map key not found");
        }
        return this.slots[i].value;
    }

    /// Returns the existing value, or inserts and returns the result of `factory` when absent.
    /// The key is borrowed for the lookup and copied only on a miss.
    public fun get_or_insert(borrow key: K, borrow factory: fun(): V): V {
        let i = this.slot_of(key);
        if i >= 0 {
            return this.slots[i].value;
        }
        let value = factory();
        this[key] = value;
        return value;
    }

    /// Copies entries from `other`, replacing values with matching keys.
    public fun merge(borrow other: Map<K, V>): void {
        for (let pair in other) {
            this[pair.key] = pair.value;
        }
    }

    /// Returns a new list of key/value pairs.
    public fun entries(): List<KeyValuePair<K, V>> {
        let result = List<KeyValuePair<K, V>>(this.count);
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result.push(KeyValuePair<K, V>(this.slots[i].key, this.slots[i].value));
            }
            i = i + 1;
        }
        return result;
    }

    /// Removes `key` and its value; returns whether the key was present.
    public fun remove(borrow key: K): bool {
        let i = this.slot_of(key);
        if i >= 0 {
            this.slots[i].state = 0 - this.epoch;
            // Zero both halves of the tombstoned slot so managed keys release immediately,
            // not just on slot reuse.
            this.slots[i].key = CollectionStorage.zero<K>();
            this.slots[i].value = CollectionStorage.zero<V>();
            this.count = this.count - 1;
            return true;
        }
        return false;
    }

    /// Returns whether there are no elements.
    @inline
    public fun is_empty(): bool {
        return this.count == 0;
    }

    /// Removes all entries while keeping storage for reuse.
    @inline
    public fun clear(): void {
        let c = this.cap;
        let e = this.epoch;
        let zk = CollectionStorage.zero<K>();
        let zv = CollectionStorage.zero<V>();
        let i = 0;
        while i < c {
            if this.slots[i].state == e {
                this.slots[i].key = zk;
                this.slots[i].value = zv;
            }
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    /// Removes all entries while keeping storage for reuse.
    @inline
    public fun clear(): void where K: unmanaged, V: unmanaged {
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    /// Returns a new list of the keys, in the map's iteration order.
    public fun keys(): List<K> {
        let result = List<K>(this.count);
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result.push(this.slots[i].key);
            }
            i = i + 1;
        }
        return result;
    }

    /// Returns a new list of the values, in the map's iteration order.
    public fun values(): List<V> {
        let result = List<V>(this.count);
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                result.push(this.slots[i].value);
            }
            i = i + 1;
        }
        return result;
    }

    /// Creates a cursor over the sequence. Close it when iteration ends early.
    public fun iterator(): MapIterator<K, V> {
        return MapIterator<K, V>(this);
    }

    /// Returns the key and value at an occupied slot; the caller checks occupancy first.
    @inline
    internal fun slot_entry(i: int): KeyValuePair<K, V> {
        return KeyValuePair<K, V>(this.slot_key(i), this.slot_value(i));
    }

    internal fun slot_occupied(i: int): bool {
        return this.slots[i].state == this.epoch;
    }

    @borrowed_result
    internal fun slot_key(i: int): K {
        return this.slots[i].key;
    }

    @borrowed_result
    internal fun slot_value(i: int): V {
        return this.slots[i].value;
    }

    /// Returns a text representation of this value.
    public override fun to_string(): string {
        let sb = StringBuilder();
        sb.append("{");
        let n = 0;
        let i = 0;
        while i < this.cap {
            if this.slots[i].state == this.epoch {
                if n > 0 {
                    sb.append(", ");
                }
                sb.append(this.slots[i].key.to_string());
                sb.append(": ");
                sb.append(this.slots[i].value.to_string());
                n = n + 1;
            }
            i = i + 1;
        }
        sb.append("}");
        return sb.build();
    }
}
