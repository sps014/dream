module system.collections;

/// Four-child min-heap: `pop`/`peek` always return the smallest element by the active comparator
/// (natural ascending order via `Comparable<T>` by default, or a custom `fun(T, T): int`).
@allow_cycle
public class PriorityQueue<T>: Collection<T> {
    items: T[];
    count: int;
    cmp_fn: fun(T, T): int;
    natural: bool;
    comparing: bool;

    /// Empty queue ordered by `T`'s natural `Comparable` order.
    public constructor()where T: Comparable<T> {
        this.items = Buffer.alloc<T>(sequence_min_capacity());
        this.count = 0;
        this.comparing = false;
        let natural: fun(T, T): int = (a, b) => a.compare(b);
        this.cmp_fn = natural;
        this.natural = true;
    }

    /// Empty queue ordered by a custom comparator (same contract as `List.sort_by`: negative when
    /// `a` should come out first, positive when `b` should).
    public constructor(cmp: fun(T, T): int) {
        this.items = Buffer.alloc<T>(sequence_min_capacity());
        this.count = 0;
        this.cmp_fn = cmp;
        this.natural = false;
        this.comparing = false;
    }

    /// Number of elements currently stored.
    public get length(): int {
        return this.count;
    }

    /// True when the queue has no elements.
    public fun is_empty(): bool {
        return this.count == 0;
    }

    /// Removes every element. Live slots are overwritten with a zero value so managed elements
    /// release immediately instead of staying retained until later pushes overwrite them.
    public fun clear(): void {
        this.check_mutation();
        let z = CollectionStorage.zero<T>();
        let i = 0;
        while i < this.count {
            this.items[i] = z;
            i = i + 1;
        }
        this.count = 0;
    }

    /// Unmanaged: no RC to release — rewind only.
    public fun clear(): void where T: unmanaged {
        this.check_mutation();
        this.count = 0;
    }

    fun grow(): void {
        let old_cap = this.items.length;
        this.items = Buffer.realloc<T>(this.items, grow_capacity(old_cap, old_cap + 1));
    }

    fun check_mutation(): void {
        if this.comparing {
            System.panic("PriorityQueue cannot be mutated by its comparator");
        }
    }

    fun less(i: int, j: int): bool {
        let cmp = this.cmp_fn;
        this.comparing = true;
        // Heap traversal supplies live indices; comparator mutation is rejected until it returns.
        let result = cmp(
            Buffer.get_unchecked<T>(this.items, i),
            Buffer.get_unchecked<T>(this.items, j)
        );
        this.comparing = false;
        return result < 0;
    }

    fun less(i: int, j: int): bool where T: Comparable<T> {
        this.comparing = true;
        let result = 0;
        if this.natural {
            result = Buffer.get_unchecked<T>(this.items, i)
                .compare(Buffer.get_unchecked<T>(this.items, j));
        } else {
            let cmp = this.cmp_fn;
            result = cmp(
                Buffer.get_unchecked<T>(this.items, i),
                Buffer.get_unchecked<T>(this.items, j)
            );
        }
        this.comparing = false;
        return result < 0;
    }

    /// Adds a value to the priority queue.
    public fun push(value: T): void {
        this.check_mutation();
        if this.count == this.items.length {
            this.grow();
        }
        let tail = this.count;
        this.items[tail] = value;
        this.count = tail + 1;
        let target = tail;
        let done = false;
        while target > 0 && done == false {
            let parent = (target - 1) / 4;
            if this.less(tail, parent) {
                target = parent;
            } else {
                done = true;
            }
        }
        // All callbacks finish before opening a hole; the live prefix is always initialized.
        // Swapping the vacated hole with its parent moves the parent down without releasing the
        // empty slot or republishing an element that already lives in this buffer.
        if target != tail {
            let saved = CollectionStorage.take<T>(this.items, tail);
            let hole = tail;
            while hole > target {
                let parent = (hole - 1) / 4;
                CollectionStorage.exchange<T>(this.items, hole, this.items, parent);
                hole = parent;
            }
            this.items[target] = saved;
        }
    }

    /// Removes the highest-priority value, or returns `None` when empty.
    public fun pop(): Option<T> {
        this.check_mutation();
        if this.count == 0 {
            return Option.None;
        }
        let tail = this.count - 1;
        if tail == 0 {
            this.count = 0;
            return Option.Some(CollectionStorage.take<T>(this.items, 0));
        }
        let target = 0;
        let path = 0;
        let depth = 0;
        let done = false;
        // The parent guard keeps `target * 4 + 1` in range, even at int-sized capacities.
        while tail > 1 && target <= (tail - 2) / 4 && done == false {
            let first = target * 4 + 1;
            let best = first;
            let offset = 1;
            while offset < 4 && offset < tail - first {
                let child = first + offset;
                if this.less(child, best) {
                    best = child;
                }
                offset = offset + 1;
            }
            if this.less(best, tail) {
                path = (path << 2) | (best - first);
                depth = depth + 1;
                target = best;
            } else {
                done = true;
            }
        }
        let top = CollectionStorage.take<T>(this.items, 0);
        let saved = CollectionStorage.take<T>(this.items, tail);
        this.count = tail;
        let hole = 0;
        while depth > 0 {
            depth = depth - 1;
            let child = hole * 4 + 1 + ((path >>(depth * 2)) & 3);
            CollectionStorage.exchange<T>(this.items, hole, this.items, child);
            hole = child;
        }
        this.items[hole] = saved;
        return Option.Some(top);
    }

    /// Returns the smallest element without removing it, or `None` when empty. O(1).
    public fun peek(): Option<T> {
        if this.count == 0 {
            return Option.None;
        }
        return Option.Some(this.items[0]);
    }

    /// Iterates elements in ascending order under the active comparator, over a snapshot taken
    /// now, so later pushes/pops do not affect the cursor.
    public fun iterator(): PriorityQueueIterator<T> {
        let sorted = List<T>(this.count);
        let i = 0;
        while i < this.count {
            sorted.push(this.items[i]);
            i = i + 1;
        }
        let cmp = this.cmp_fn;
        sorted.sort_by(cmp);
        return PriorityQueueIterator<T>(sorted.take_array());
    }
}
