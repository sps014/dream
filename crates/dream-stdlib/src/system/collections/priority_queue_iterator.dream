module system.collections;

// Cursor produced by `PriorityQueue.iterator()`. Yields elements in ascending order under the
// active comparator). Iteration is destructive-free: it drains into a snapshot first, so the
// queue can be mutated while the cursor is alive.
public class PriorityQueueIterator<T> : Iterator<T> {
    items: T[];
    offset: int;

    public constructor(snapshot: T[]) {
        this.items = snapshot;
        this.offset = 0;
    }

    // Returns the next element, or `None` if exhausted.
    @next
    public fun next(): Option<T> {
        if (this.offset >= this.items.length) {
            return Option.None;
        }
        let value = this.items[this.offset];
        this.offset = this.offset + 1;
        return Option.Some(value);
    }
}
