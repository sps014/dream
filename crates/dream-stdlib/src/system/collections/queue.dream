module system.collections;

/// FIFO queue backed by a ring buffer (`T[]` + head/count).
///
/// Invariant: `items.length > 0`, `0 <= head < items.length`, `0 <= count <= items.length`, so any
/// `(head + k) % items.length` with `k >= 0` is a valid slot for `Buffer.get_unchecked`.
@allow_cycle
@slot_walk("length", "at_offset", "")
public class Queue<T>: Collection<T> {
    items: T[];
    head: int;
    count: int;

    /// Creates an empty queue.
    public constructor() {
        this.items = Buffer.alloc<T>(sequence_min_capacity());
        this.head = 0;
        this.count = 0;
    }

    /// Number of elements currently stored.
    public get length(): int {
        return this.count;
    }

    /// Current element capacity of the ring buffer.
    public get capacity(): int {
        return this.items.length;
    }

    /// Reserves room for additional elements while preserving FIFO order and length.
    public fun reserve(additional: int): Result<Unit, CapacityError> {
        let need = (long)this.count + (long)additional;
        if additional < 0 || need > 2147483647L {
            return Result.Err(CapacityError());
        }
        if need >(long)this.items.length {
            this.reallocate((int)need);
        }
        return Result.Ok(Unit());
    }

    fun grow(): void {
        this.reallocate(grow_capacity(this.items.length, this.items.length + 1));
    }

    fun reallocate(new_cap: int): void {
        let old_cap = this.items.length;
        let next = Buffer.alloc<T>(new_cap);
        // Linearize the ring into `[0, count)` with at most two contiguous Span copies (handles
        // wrap-around without an element loop).
        let first = this.count;
        let avail = old_cap - this.head;
        if first > avail {
            first = avail;
        }
        Span<T>(next, 0, first).copy_from(Span<T>(this.items, this.head, first));
        let rest = this.count - first;
        if rest > 0 {
            Span<T>(next, first, rest).copy_from(Span<T>(this.items, 0, rest));
        }
        this.items = next;
        this.head = 0;
    }

    /// Appends `value` at the back of the queue.
    public fun enqueue(value: T): void {
        if this.count == this.items.length {
            this.grow();
        }
        let tail = (this.head + this.count) % this.items.length;
        Buffer.set_unchecked<T>(this.items, tail, value);
        this.count = this.count + 1;
    }

    /// Removes and returns the front element, or `None` when empty. The vacated slot is zeroed
    /// so managed elements release immediately instead of staying retained until overwritten.
    public fun dequeue(): Option<T> {
        if this.count == 0 {
            return Option.None;
        }
        let v = CollectionStorage.take<T>(this.items, this.head);
        this.head = (this.head + 1) % this.items.length;
        this.count = this.count - 1;
        return Option.Some(v);
    }

    /// Returns the front element without removing it, or `None` when empty.
    public fun peek(): Option<T> {
        if this.count == 0 {
            return Option.None;
        }
        return Option.Some(Buffer.get_unchecked<T>(this.items, this.head));
    }

    /// Removes every element. Live ring slots are overwritten with a zero value so managed
    /// elements release immediately instead of staying retained until later enqueues overwrite
    /// them; the ring is reset to front-aligned empty.
    public fun clear(): void {
        let cap = this.items.length;
        let z = CollectionStorage.zero<T>();
        let i = 0;
        while i < this.count {
            this.items[(this.head + i) % cap] = z;
            i = i + 1;
        }
        this.head = 0;
        this.count = 0;
    }

    /// Unmanaged: no RC to release — rewind only.
    public fun clear(): void where T: unmanaged {
        this.head = 0;
        this.count = 0;
    }

    /// Iterates elements from front to back.
    public fun iterator(): QueueIterator<T> {
        return QueueIterator<T>(this);
    }

    // Slot access for `QueueIterator` (same-module; `offset >= 0`).
    @borrowed_result
    internal fun at_offset(offset: int): T {
        return Buffer.get_unchecked<T>(this.items, (this.head + offset) % this.items.length);
    }
}
