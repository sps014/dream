module system.collections;

// Lazy query view over a list. Stages (`filter`/`take`/`skip`) build a chain without copying or
// scanning; evaluation happens once, at the terminal step (`to_list`/`count`/`map`/...).
// `to_list()` always copies — a `Seq` never aliases the list it was built from. Type-changing
// steps (`map`, `flat_map`) must allocate a new element stream, so they materialize immediately
// and are documented as terminal.
//
// Stages are a parent-linked chain of the same element type `T` (Dream cannot yet put function
// types in generic containers, so predicates hang off nodes instead of a list).

public class Seq<T> {
    // Source storage; meaningful on the base node only.
    items: List<T>;
    start: int;
    end: int;
    // Previous stage; `None` on the base node.
    parent: Option<Seq<T>>;
    // Exactly one stage kind is active per node.
    has_pred: bool;
    pred: fun(T): bool;
    is_take: bool;
    take_n: int;
    is_skip: bool;
    skip_n: int;

    // Wraps a list (base node). Does not copy — the view reads `items` live until a terminal
    // step materializes.
    public constructor(items: List<T>) {
        this.items = items;
        this.start = 0;
        // `items` is a sink param — read length from the field after the move.
        this.end = this.items.length;
        this.parent = Option.None;
        this.has_pred = false;
        let accept_all: fun(T): bool = (v) => true;
        this.pred = accept_all;
        this.is_take = false;
        this.take_n = 0;
        this.is_skip = false;
        this.skip_n = 0;
    }

    fun from_stage(parent_seq: Seq<T>): Seq<T> {
        let s = Seq<T>(parent_seq.items);
        s.parent = Option.Some(parent_seq);
        return s;
    }

    // Keeps elements for which `pred` is true (deferred — runs once per element at
    // materialization).
    public fun filter(borrow p: fun(T): bool): Seq<T> {
        let s = this.from_stage(this);
        s.has_pred = true;
        s.pred = p;
        return s;
    }

    // Keeps the first `n` surviving elements of the chain (deferred).
    public fun take(n: int): Seq<T> {
        let s = this.from_stage(this);
        s.is_take = true;
        s.take_n = n;
        return s;
    }

    // Drops the first `n` surviving elements of the chain (deferred).
    public fun skip(n: int): Seq<T> {
        let s = this.from_stage(this);
        s.is_skip = true;
        s.skip_n = n;
        return s;
    }

    // Appends every element surviving this stage (and everything below it) into `out`.
    fun drain(out: List<T>): void {
        if (this.parent.is_none()) {
            let i = this.start;
            while (i < this.end) {
                out.push(this.items.get(i));
                i = i + 1;
            }
            return;
        }
        let upstream = List<T>();
        switch (this.parent) {
            Some(p) => p.drain(upstream),
            None => {},
        }
        if (this.has_pred) {
            let keep = this.pred;
            let i = 0;
            while (i < upstream.length) {
                let v = upstream.get(i);
                if (keep(v)) {
                    out.push(v);
                }
                i = i + 1;
            }
            return;
        }
        if (this.is_take) {
            let n = this.take_n;
            if (n > upstream.length) {
                n = upstream.length;
            }
            let i = 0;
            while (i < n) {
                out.push(upstream.get(i));
                i = i + 1;
            }
            return;
        }
        if (this.is_skip) {
            let n = this.skip_n;
            if (n < 0) {
                n = 0;
            }
            if (n > upstream.length) {
                n = upstream.length;
            }
            let i = n;
            while (i < upstream.length) {
                out.push(upstream.get(i));
                i = i + 1;
            }
        }
    }

    // Terminal step: dense copy of the surviving elements, in order.
    public fun to_list(): List<T> {
        let out = List<T>();
        this.drain(out);
        return out;
    }

    // Terminal step: number of elements that survive the chain.
    public fun count(): int {
        let out = List<T>();
        this.drain(out);
        return out.length;
    }

    // Removes duplicates while preserving first-seen order.
    public fun distinct(): Seq<T> {
        return Seq<T>(this.to_list().distinct());
    }

    // Returns a new sequence sorted by `cmp`.
    public fun order_by(borrow cmp: fun(T, T): int): Seq<T> {
        return Seq<T>(this.to_list().order_by(cmp));
    }

    // Maps each element to a list and concatenates the results.
    public fun flat_map<U>(borrow f: fun(T): List<U>): Seq<U> {
        return Seq<U>(this.to_list().flat_map(f));
    }

    // Terminal step: maps the surviving elements through `f` into a new `Seq`.
    public fun map<U>(borrow f: fun(T): U): Seq<U> {
        let src = this.to_list();
        let result = List<U>();
        let i = 0;
        while (i < src.length) {
            result.push(f(src.get(i)));
            i = i + 1;
        }
        return Seq<U>(result);
    }
}
