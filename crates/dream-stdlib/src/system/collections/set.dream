module system.collections;

// A generic open-addressing hash set.
@allow_cycle
public class Set<T>: Collection<T> {
    keys: T[];
    states: int[];
    count: int;
    used: int;
    cap: int;
    epoch: int;

    // Allocates an empty set with an initial capacity (defaults to 8, rounded up to power of 2).
    public constructor(capacity: int = 8) {
        let c = hash_capacity_for(capacity);
        this.cap = c;
        this.keys = Buffer.alloc<T>(c);
        this.states = Buffer.alloc<int>(c);
        this.count = 0;
        this.used = 0;
        this.epoch = hash_epoch_initial();
    }

    // Reserves additional live entries, accounting for load factor and reclaiming tombstones.
    public fun reserve(additional: int): Result<bool, CapacityError> {
        let need = (long)this.count + (long)additional;
        let required = (
            (need + 1L) * (long)hash_load_factor_denom() + (long)hash_load_factor_num() - 1L
        ) / (long)hash_load_factor_num();
        if additional < 0 || required > 268435456L {
            return Result.Err(CapacityError());
        }
        let capacity = hash_capacity_for((int)required);
        if capacity < this.cap {
            capacity = this.cap;
        }
        if capacity > this.cap
            || ((long)this.used + (long)additional)
            * (long)hash_load_factor_denom() >= (long)this.cap * (long)hash_load_factor_num() {
            this.rehash(capacity);
        }
        return Result.Ok(true);
    }

    fun bump_epoch(): void {
        let e = this.epoch + 1;
        if e <= 0 {
            Buffer.elems_fill<int>(this.states, 0, this.cap);
            e = hash_epoch_initial();
        }
        this.epoch = e;
    }

    // Number of elements currently stored.
    public get length(): int {
        return this.count;
    }

    // Current capacity of the backing buffer.
    public get capacity(): int {
        return this.cap;
    }

    // Index of an occupied slot holding a value, or -1.
    fun find(borrow value: T): int {
        return this.find_hashed(value, value.hash_code());
    }

    fun find_hashed(borrow value: T, hash: int): int {
        let keys = this.keys;
        let states = this.states;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = hash & (cap - 1);
        let result = -1;
        let done = false;
        while done == false {
            let s = states[idx];
            if (s != epoch) && (s != tomb) {
                done = true;
            } else {
                if s == epoch {
                    if keys[idx] == value {
                        result = idx;
                        done = true;
                    }
                }
                if done == false {
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
        return result;
    }

    // Probe and insert without checking load factor. Used by `add` and `rehash` so those two are
    // not mutually recursive (a cycle would block the whole-module inliner).
    fun insert_no_grow(value: T, hash: int): bool {
        let keys = this.keys;
        let states = this.states;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = hash & (cap - 1);
        let first_tomb = -1;
        let added = false;
        let done = false;
        while done == false {
            let s = states[idx];
            if (s != epoch) && (s != tomb) {
                let target = idx;
                if first_tomb >= 0 {
                    target = first_tomb;
                }
                keys[target] = value;
                states[target] = epoch;
                this.count = this.count + 1;
                if first_tomb < 0 {
                    this.used = this.used + 1;
                }
                added = true;
                done = true;
            } else {
                if s == epoch {
                    if keys[idx] == value {
                        done = true;
                    }
                } else {
                    if (s == tomb) && (first_tomb < 0) {
                        first_tomb = idx;
                    }
                }
                if done == false {
                    idx = idx + 1;
                    if idx == cap {
                        idx = 0;
                    }
                }
            }
        }
        return added;
    }

    fun rehash(new_cap: int): void {
        let old_keys = this.keys;
        let old_states = this.states;
        let old_cap = this.cap;
        this.keys = Buffer.alloc<T>(new_cap);
        this.states = Buffer.alloc<int>(new_cap);
        this.cap = new_cap;
        this.count = 0;
        this.used = 0;
        let i = 0;
        while i < old_cap {
            if old_states[i] == this.epoch {
                this.insert_no_grow(old_keys[i], old_keys[i].hash_code());
            }
            i = i + 1;
        }
    }

    fun rehash(new_cap: int): void where T: StringKey {
        let old_keys = this.keys;
        let old_states = this.states;
        let old_cap = this.cap;
        this.keys = Buffer.alloc<T>(new_cap);
        this.states = Buffer.alloc<int>(new_cap);
        this.cap = new_cap;
        this.count = 0;
        this.used = 0;
        let can_transfer = CollectionStorage.string_keys<T>()
            && CollectionStorage.owners(old_keys) == 1;
        let i = 0;
        while i < old_cap {
            if old_states[i] == this.epoch {
                let hash = old_keys[i].hash_code();
                if can_transfer {
                    let target = hash & (new_cap - 1);
                    while this.states[target] == this.epoch {
                        target = (target + 1) & (new_cap - 1);
                    }
                    CollectionStorage.exchange<T>(old_keys, i, this.keys, target);
                    this.states[target] = this.epoch;
                    this.count = this.count + 1;
                    this.used = this.used + 1;
                } else {
                    this.insert_no_grow(old_keys[i], hash);
                }
            }
            i = i + 1;
        }
    }

    // Inserts a value into the set. Returns true if it was newly added, false if already present.
    public fun add(value: T): bool {
        let hash = value.hash_code();
        if (this.used + 1) * hash_load_factor_denom() >= this.cap * hash_load_factor_num() {
            if this.find_hashed(value, hash) >= 0 {
                return false;
            }
            this.rehash(hash_capacity_for(this.cap + 1));
        }
        return this.insert_no_grow(value, hash);
    }

    // True if the set contains the value.
    public fun contains(borrow value: T): bool {
        return this.find(value) >= 0;
    }

    // True when the set holds the `string` equal to `value`, without building a `string`.
    @inline
    public fun contains(borrow value: ReadOnlySpan<char>): bool where T: StringKey {
        let keys = this.keys;
        let states = this.states;
        let cap = this.cap;
        let epoch = this.epoch;
        let tomb = 0 - epoch;
        let idx = value.hash_code() & (cap - 1);
        while true {
            let s = states[idx];
            if (s != epoch) && (s != tomb) {
                return false;
            }
            if (s == epoch) && keys[idx].matches_span(value) {
                return true;
            }
            idx = idx + 1;
            if idx == cap {
                idx = 0;
            }
        }
    }

    // Adds every element of `items` (duplicates are ignored, exactly like repeated `add` calls).
    // Also what the `{e1, e2, ...}` set-literal syntax lowers to via `from_array`, so a literal
    // with N elements costs one call, not N.
    /// Adds every element of `items`, ignoring duplicates.
    public fun add_all(borrow items: T[]): void {
        let i = 0;
        while i < items.length {
            this.add(items[i]);
            i = i + 1;
        }
    }

    // Builds a set containing exactly the (deduplicated) elements of `items`. The `{e1, e2, ...}`
    // set-literal syntax (e.g. `let s: Set<int> = {1, 2, 3};`) desugars to this.
    /// Creates a set containing the distinct elements of `items`. Set literals such as `{1, 2,
    /// 3}` create sets in the same way.
    public static fun from_array(borrow items: T[]): Set<T> {
        let result = Set<T>(items.length);
        result.add_all(items);
        return result;
    }

    // Removes a value and returns true if it was removed.
    public fun remove(borrow value: T): bool {
        let i = this.find(value);
        if i >= 0 {
            this.states[i] = 0 - this.epoch;
            // A tombstoned slot must not keep a managed key alive until it is reused.
            this.keys[i] = CollectionStorage.zero<T>();
            this.count = this.count - 1;
            return true;
        }
        return false;
    }

    /// Removes `value`; returns whether it was present.
    public fun remove(borrow value: T): bool where T: unmanaged {
        let i = this.find(value);
        if i >= 0 {
            this.states[i] = 0 - this.epoch;
            this.count = this.count - 1;
            return true;
        }
        return false;
    }

    // True if the set is empty.
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Removes all elements, keeping the current capacity. Occupied key slots are zeroed so managed
    // entries release; probe `states` are reset in place (no capacity realloc).
    public fun clear(): void {
        let c = this.cap;
        let e = this.epoch;
        let z = CollectionStorage.zero<T>();
        let i = 0;
        while i < c {
            if this.states[i] == e {
                this.keys[i] = z;
            }
            i = i + 1;
        }
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    /// Removes all entries while keeping storage for reuse.
    public fun clear(): void where T: unmanaged {
        this.count = 0;
        this.used = 0;
        this.bump_epoch();
    }

    // Gets all elements as an array.
    public fun to_array(): T[] {
        let result = Buffer.alloc<T>(this.count);
        let i = 0;
        let j = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                result[j] = this.keys[i];
                j = j + 1;
            }
            i = i + 1;
        }
        return result;
    }

    // Elements present in this set or `other`.
    public fun union(borrow other: Set<T>): Set<T> {
        let result = Set<T>(this.count + other.length);
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                result.add(this.keys[i]);
            }
            i = i + 1;
        }
        for (let x in other) {
            result.add(x);
        }
        return result;
    }

    // Elements present in both sets.
    public fun intersection(borrow other: Set<T>): Set<T> {
        let result = Set<T>();
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                if other.contains(this.keys[i]) {
                    result.add(this.keys[i]);
                }
            }
            i = i + 1;
        }
        return result;
    }

    // Elements in this set but not in `other`.
    public fun difference(borrow other: Set<T>): Set<T> {
        let result = Set<T>();
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                if other.contains(this.keys[i]) == false {
                    result.add(this.keys[i]);
                }
            }
            i = i + 1;
        }
        return result;
    }

    // True when every element of this set is in `other`.
    public fun is_subset(borrow other: Set<T>): bool {
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                if other.contains(this.keys[i]) == false {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    // True when the sets share no elements.
    public fun is_disjoint(borrow other: Set<T>): bool {
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                if other.contains(this.keys[i]) {
                    return false;
                }
            }
            i = i + 1;
        }
        return true;
    }

    // Gets an iterator for the set.
    public fun iterator(): SetIterator<T> {
        return SetIterator<T>(this);
    }

    // Slot helpers for `SetIterator` (same-module).
    internal fun slot_occupied(i: int): bool {
        return this.states[i] == this.epoch;
    }

    internal fun slot_key(i: int): T {
        return this.keys[i];
    }

    /// Returns a text representation of this value.
    public override fun to_string(): string {
        let sb = StringBuilder();
        sb.append("{");
        let n = 0;
        let i = 0;
        while i < this.cap {
            if this.states[i] == this.epoch {
                if n > 0 {
                    sb.append(", ");
                }
                sb.append(this.keys[i].to_string());
                n = n + 1;
            }
            i = i + 1;
        }
        sb.append("}");
        return sb.build();
    }
}
