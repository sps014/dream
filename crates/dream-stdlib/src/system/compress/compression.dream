module system.compress;

// Standard wrapper format for a single compressed stream.
public enum CompressionFormat {
    // Gzip framing with CRC and uncompressed-size validation.
    Gzip,
    // Zlib framing with Adler-32 validation.
    Zlib,
}

internal class CompressionStep {
    internal consumed: int;
    internal bytes: byte[];
    internal finished: bool;

    internal constructor(consumed: int, bytes: byte[], finished: bool) {
        this.consumed = consumed;
        this.bytes = bytes;
        this.finished = finished;
    }
}

internal class CompressionCodec {
    id: int;

    internal constructor(id: int) {
        this.id = id;
    }

    @runtime("dataCodec")
    static extern fun host(request: string): string;

    internal static fun request(value: JsonValue): Result<JsonValue, IoError> {
        let parsed = Json.deserialize<JsonValue>(CompressionCodec.host(Json.serialize(value)));
        if parsed.is_err() {
            return Result.Err(IoError("", "ECOMPRESS", "invalid codec response"));
        }
        let result = parsed.unwrap();
        if result.get("error").is_some() {
            return Result.Err(
                IoError(
                    "",
                    "ECOMPRESS",
                    result.at("error").as_string().unwrap_or("compression failed")
                )
            );
        }
        return Result.Ok(result);
    }

    internal static fun create(
        format: CompressionFormat,
        encode: bool,
        limit: long
    ): Result<CompressionCodec, IoError> {
        if limit < 0L || limit > 1073741824L {
            return Result.Err(
                IoError.invalid("", "compression output limit must be between zero and 1 GiB")
            );
        }
        let request = JsonValue.dict();
        request.set("action", JsonValue.from_string("compress_create"));
        let name = "gzip";
        if format == CompressionFormat.Zlib {
            name = "zlib";
        }
        let direction = "decode";
        if encode {
            direction = "encode";
        }
        request.set("format", JsonValue.from_string(name));
        request.set("direction", JsonValue.from_string(direction));
        request.set("limit", JsonValue.number((double)limit));
        let response = CompressionCodec.request(request)?;
        return Result.Ok(CompressionCodec(response.at("id").as_int().unwrap_or(0)));
    }

    internal fun step(
        input: byte[],
        capacity: int,
        finish: bool,
        flush: bool = false
    ): Result<CompressionStep, IoError> {
        if this.id <= 0 {
            return Result.Err(IoError.closed("compression stream"));
        }
        let request = JsonValue.dict();
        request.set("action", JsonValue.from_string("compress_step"));
        request.set("id", JsonValue.number((double)this.id));
        request.set("input", JsonValue.from_string(Encoding.hex_encode(input)));
        request.set("capacity", JsonValue.number((double)capacity));
        request.set("finish", JsonValue.boolean(finish));
        request.set("flush", JsonValue.boolean(flush));
        let response = CompressionCodec.request(request)?;
        let consumed = response.at("consumed").as_int().unwrap_or(0 - 1);
        let bytes = Encoding.hex_decode(response.at("output").as_string().unwrap_or("!"));
        if consumed < 0
            || consumed > input.length || bytes.is_err() || bytes.unwrap()
            .length > capacity {
            return Result.Err(IoError.other("", "invalid compression progress"));
        }
        return Result.Ok(
            CompressionStep(
                consumed,
                bytes.unwrap(),
                response.at("finished").as_bool().unwrap_or(false)
            )
        );
    }

    internal fun close(): void {
        if this.id <= 0 {
            return;
        }
        let request = JsonValue.dict();
        request.set("action", JsonValue.from_string("compress_close"));
        request.set("id", JsonValue.number((double)this.id));
        CompressionCodec.request(request);
        this.id = 0;
    }

    del() {
        this.close();
    }
}

// Streaming gzip/zlib factories; wrappers borrow their underlying stream.
public static class Compression {
    // Creates an encoder; max_output_bytes bounds compressed output across every write and finish.
    public static fun writer(
        destination: Writer,
        format: CompressionFormat = CompressionFormat.Gzip,
        max_output_bytes: long = 67108864L
    ): Result<CompressionWriter, IoError> {
        return Result.Ok(
            CompressionWriter(
                destination,
                CompressionCodec.create(format, true, max_output_bytes)?
            )
        );
    }

    // Creates a strict single-stream decoder; the output limit prevents unbounded expansion.
    public static fun reader(
        source: Reader,
        format: CompressionFormat = CompressionFormat.Gzip,
        max_output_bytes: long = 67108864L
    ): Result<CompressionReader, IoError> {
        return Result.Ok(
            CompressionReader(source, CompressionCodec.create(format, false, max_output_bytes)?)
        );
    }
}

// Incremental compressor over a borrowed Writer; finish explicitly to write and validate the trailer.
@allow_cycle
public class CompressionWriter: Writer {
    destination: Writer;
    codec: CompressionCodec;
    closed: bool;

    internal constructor(destination: Writer, codec: CompressionCodec) {
        this.destination = destination;
        this.codec = codec;
        this.closed = false;
    }

    // Accepts up to 64 KiB; completed compressed writes remain visible if a later operation fails.
    public fun write(bytes: byte[]): Result<int, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        if bytes.length == 0 {
            return Result.Ok(0);
        }
        let count = bytes.length;
        if count > 65536 {
            count = 65536;
        }
        let input = Span<byte>(bytes, 0, count).to_array();
        while true {
            let next = this.codec.step(input, 65536, false);
            if next.is_err() {
                this.close();
                return Result.Err(next.unwrap_err());
            }
            let progress = next.unwrap();
            let written = this.destination.write_all(progress.bytes);
            if written.is_err() {
                this.close();
                return Result.Err(written.unwrap_err());
            }
            if progress.consumed > 0 {
                return Result.Ok(progress.consumed);
            }
            if progress.bytes.length == 0 {
                this.close();
                return Result.Err(IoError.other("", "compressor made no progress"));
            }
        }
    }

    // Emits a synchronization boundary and flushes the borrowed destination without ending the stream.
    public fun flush(): Result<bool, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        while true {
            let next = this.codec.step([], 65536, false, true);
            if next.is_err() {
                this.close();
                return Result.Err(next.unwrap_err());
            }
            let written = this.destination.write_all(next.unwrap().bytes);
            if written.is_err() {
                this.close();
                return Result.Err(written.unwrap_err());
            }
            if next.unwrap().bytes.length < 65536 {
                break;
            }
        }
        return this.destination.flush();
    }

    // Finishes the trailer, releases encoder state, and flushes the borrowed destination.
    public fun finish(): Result<bool, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        while true {
            let next = this.codec.step([], 65536, true);
            if next.is_err() {
                this.close();
                return Result.Err(next.unwrap_err());
            }
            let written = this.destination.write_all(next.unwrap().bytes);
            if written.is_err() {
                this.close();
                return Result.Err(written.unwrap_err());
            }
            if next.unwrap().finished {
                break;
            }
            if next.unwrap().bytes.length == 0 {
                this.close();
                return Result.Err(IoError.other("", "compressor made no progress"));
            }
        }
        this.close();
        return this.destination.flush();
    }

    // Abandons codec state without finishing or closing the borrowed destination.
    public fun close(): void {
        this.codec.close();
        this.closed = true;
    }

    del() {
        this.close();
    }
}

// Incremental decompressor with bounded chunks, checksum validation, and strict trailing-byte rejection.
@allow_cycle
public class CompressionReader: Reader {
    source: Reader;
    codec: CompressionCodec;
    input: byte[];
    offset: int;
    eof: bool;
    finished: bool;
    closed: bool;

    internal constructor(source: Reader, codec: CompressionCodec) {
        this.source = source;
        this.codec = codec;
        this.input = [];
        this.offset = 0;
        this.eof = false;
        this.finished = false;
        this.closed = false;
    }

    // Returns partial decoded bytes; malformed, truncated, oversized, or concatenated input returns an error.
    public fun read(max_bytes: int): Result<byte[], IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        if max_bytes < 0 {
            return Result.Err(IoError.invalid("", "negative read size"));
        }
        if max_bytes == 0 || this.finished {
            return Result.Ok(Buffer.alloc<byte>(0));
        }
        let capacity = max_bytes;
        if capacity > 65536 {
            capacity = 65536;
        }
        while true {
            if this.offset == this.input.length && !this.eof {
                let next = this.source.read(8192);
                if next.is_err() {
                    this.close();
                    return Result.Err(next.unwrap_err());
                }
                this.input = next.unwrap();
                this.offset = 0;
                this.eof = this.input.length == 0;
                if this.input.length > 8192 {
                    this.close();
                    return Result.Err(IoError.other("", "reader exceeded requested size"));
                }
            }
            let next = this.codec.step(
                Span<byte>(this.input, this.offset, this.input.length - this.offset).to_array(),
                capacity,
                this.eof
            );
            if next.is_err() {
                this.close();
                return Result.Err(next.unwrap_err());
            }
            let progress = next.unwrap();
            this.offset = this.offset + progress.consumed;
            if progress.finished {
                if this.offset < this.input.length {
                    this.close();
                    return Result.Err(
                        IoError("", "ECOMPRESS", "trailing bytes after compressed stream")
                    );
                }
                let extra = this.source.read(1);
                if extra.is_err() {
                    this.close();
                    return Result.Err(extra.unwrap_err());
                }
                if extra.unwrap().length > 0 {
                    this.close();
                    return Result.Err(
                        IoError("", "ECOMPRESS", "trailing bytes after compressed stream")
                    );
                }
                this.finished = true;
                this.codec.close();
            }
            if progress.bytes.length > 0 || this.finished {
                return Result.Ok(progress.bytes);
            }
            if progress.consumed == 0 {
                this.close();
                return Result.Err(IoError("", "ECOMPRESS", "decoder made no progress"));
            }
        }
    }

    // Releases codec state without closing the borrowed source.
    public fun close(): void {
        this.codec.close();
        this.closed = true;
    }

    del() {
        this.close();
    }
}
