module system.compress;

internal class CompressionCodec {
    id: int;

    internal constructor(id: int) {
        this.id = id;
    }

    @runtime("dataCodec")
    static extern fun host(request: string): string;

    internal static fun request(value: JsonValue): Result<JsonValue, IoError> {
        let parsed = Json.deserialize<JsonValue>(CompressionCodec.host(Json.serialize(value)));
        if parsed.is_err() {
            return Result.Err(IoError("", "ECOMPRESS", "invalid codec response"));
        }
        let result = parsed.unwrap();
        if result["error"].is_some() {
            return Result.Err(
                IoError(
                    "",
                    "ECOMPRESS",
                    result.at("error").as_string().unwrap_or("compression failed")
                )
            );
        }
        return Result.Ok(result);
    }

    internal static fun create(
        format: CompressionFormat,
        encode: bool,
        limit: long
    ): Result<CompressionCodec, IoError> {
        if limit < 0L || limit > 1073741824L {
            return Result.Err(
                IoError.invalid("", "compression output limit must be between zero and 1 GiB")
            );
        }
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("compress_create");
        let name = "gzip";
        if format == CompressionFormat.Zlib {
            name = "zlib";
        }
        let direction = "decode";
        if encode {
            direction = "encode";
        }
        request["format"] = JsonValue.from_string(name);
        request["direction"] = JsonValue.from_string(direction);
        request["limit"] = JsonValue.number((double)limit);
        let response = CompressionCodec.request(request)?;
        return Result.Ok(CompressionCodec(response.at("id").as_int().unwrap_or(0)));
    }

    internal fun step(
        input: byte[],
        capacity: int,
        finish: bool,
        flush: bool = false
    ): Result<CompressionStep, IoError> {
        if this.id <= 0 {
            return Result.Err(IoError.closed("compression stream"));
        }
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("compress_step");
        request["id"] = JsonValue.number((double)this.id);
        request["input"] = JsonValue.from_string(Encoding.hex_encode(input));
        request["capacity"] = JsonValue.number((double)capacity);
        request["finish"] = JsonValue.boolean(finish);
        request["flush"] = JsonValue.boolean(flush);
        let response = CompressionCodec.request(request)?;
        let consumed = response.at("consumed").as_int().unwrap_or(0 - 1);
        let bytes = Encoding.hex_decode(response.at("output").as_string().unwrap_or("!"));
        if consumed < 0
            || consumed > input.length || bytes.is_err() || bytes.unwrap()
            .length > capacity {
            return Result.Err(IoError.other("", "invalid compression progress"));
        }
        return Result.Ok(
            CompressionStep(
                consumed,
                bytes.unwrap(),
                response.at("finished").as_bool().unwrap_or(false)
            )
        );
    }

    internal fun close(): void {
        if this.id <= 0 {
            return;
        }
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("compress_close");
        request["id"] = JsonValue.number((double)this.id);
        CompressionCodec.request(request);
        this.id = 0;
    }

    del() {
        this.close();
    }
}
