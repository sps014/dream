module system.compress;

/// Incremental compressor over a borrowed Writer; finish explicitly to write and validate the trailer.
@allow_cycle
public class CompressionWriter: Writer {
    destination: Writer;
    deflater: Deflater;
    limit: long;
    written: long;
    closed: bool;

    internal constructor(destination: Writer, deflater: Deflater, limit: long) {
        this.destination = destination;
        this.deflater = deflater;
        this.limit = limit;
        this.written = 0L;
        this.closed = false;
    }

    /// Accepts up to 64 KiB and returns how many bytes were taken. Completed compressed output is
    /// written to the destination as blocks fill; exceeding the output limit returns an
    /// `ECOMPRESS` error and closes the writer.
    public fun write(bytes: byte[]): Result<int, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        let count = bytes.length < 65536 ? bytes.length : 65536;
        if count == 0 {
            return Result.Ok(0);
        }
        this.emit(this.deflater.write(bytes, count))?;
        return Result.Ok(count);
    }

    /// Emits a synchronization boundary and flushes the borrowed destination without ending the stream.
    public fun flush(): Result<Unit, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        this.emit(this.deflater.flush())?;
        return this.destination.flush();
    }

    /// Finishes the trailer, releases encoder state, and flushes the borrowed destination.
    public fun finish(): Result<Unit, IoError> {
        if this.closed {
            return Result.Err(IoError.closed("compression stream"));
        }
        this.emit(this.deflater.finish())?;
        this.close();
        return this.destination.flush();
    }

    /// Abandons the stream without finishing or closing the borrowed destination; later writes fail.
    public fun close(): void {
        this.closed = true;
    }

    fun emit(borrow output: byte[]): Result<Unit, IoError> {
        if this.written + (long)output.length > this.limit {
            this.close();
            return Result.Err(IoError("", "ECOMPRESS", "compression output limit exceeded"));
        }
        this.written = this.written + (long)output.length;
        let result = this.destination.write_all(output);
        if result.is_err() {
            this.close();
        }
        return result;
    }
}
