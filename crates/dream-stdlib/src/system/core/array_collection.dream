module system.core;

// `Array.alloc<T>(n)` — user-facing zero-initialized `T[]` allocation. Thin wrapper over the
// lower-level `Buffer.alloc` intrinsic.
public static class Array {
    public static fun alloc<T>(len: int): T[] {
        return Buffer.alloc<T>(len);
    }

    // A `T[]` of length `len` whose every slot holds `value` (evaluated once, shared).
    public static fun repeat<T>(len: int, value: T): T[] {
        let out = Buffer.alloc<T>(len);
        let i = 0;
        while i < len {
            out[i] = value;
            i = i + 1;
        }
        return out;
    }

    // Like `repeat`, but calls `fill()` once per slot so each element can be a fresh value
    // (`[v; n]` uses this whenever `v` itself constructs an array, giving distinct rows).
    public static fun repeat_with<T>(len: int, fill: fun(): T): T[] {
        let out = Buffer.alloc<T>(len);
        let i = 0;
        while i < len {
            out[i] = fill();
            i = i + 1;
        }
        return out;
    }
}

// Every `T[]` implements `IndexedCollection<T>` (and thus `Collection<T>`). Instantiated on demand
// for each concrete element type (`int[]`, `Point[]`, …).
// `this.length` resolves to the builtin `ArrayLen` (checked before instance dispatch).

extend T[] : IndexedCollection<T> {
    // Builtin array length (resolved as `ArrayLen` before instance dispatch).
    public get length(): int {
        return this.length;
    }

    // Element at `index`. Panics if `index` is out of range.
    public fun this[index: int]: T {
        if index < 0 || index >= this.length {
            System.panic("array index out of range");
        }
        return this[index];
    }

    // Enumerator for treating an array as a `Collection`.
    public fun iterator(): Iterator<T> {
        return ArrayIterator<T>(this);
    }

    public fun contains(borrow value: T): bool {
        let i = 0;
        while i < this.length {
            if this[i] == value {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public fun index_of(borrow value: T): Option<int> {
        let i = 0;
        while i < this.length {
            if this[i] == value {
                return Option.Some(i);
            }
            i = i + 1;
        }
        return Option.None;
    }

    public fun slice(start: int, end: int): T[] {
        let lo = start;
        let hi = end;
        if lo < 0 {
            lo = 0;
        }
        if hi > this.length {
            hi = this.length;
        }
        if lo > hi {
            lo = hi;
        }
        let n = hi - lo;
        let out = Buffer.alloc<T>(n);
        let i = 0;
        while i < n {
            out[i] = this[lo + i];
            i = i + 1;
        }
        return out;
    }

    public fun reverse(): void {
        let lo = 0;
        let hi = this.length - 1;
        while lo < hi {
            let a = this[lo];
            this[lo] = this[hi];
            this[hi] = a;
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    public fun concat(borrow other: T[]): T[] {
        let n = this.length + other.length;
        let out = Buffer.alloc<T>(n);
        let i = 0;
        while i < this.length {
            out[i] = this[i];
            i = i + 1;
        }
        let j = 0;
        while j < other.length {
            out[i] = other[j];
            i = i + 1;
            j = j + 1;
        }
        return out;
    }
}
