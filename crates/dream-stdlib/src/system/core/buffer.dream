module system.core;

// `Buffer` - low-level, fixed-length array allocation backing a compiler intrinsic. This is the
// raw primitive the higher-level `List`/`Map`/`Set` collections build on; user code should
// normally prefer `List<T>` and only reach for `Buffer.alloc` for tight, manual storage control.

public static class Buffer {
    // `Buffer.alloc<T>(n)` returns a fresh, zero-initialized `T[]` of length `n`.
    @intrinsic("array_new")
    static extern fun alloc<T>(len: int): T[];

    // Resizes `arr`'s backing block via the allocator's `$realloc`, returning a `T[]` of `new_len`
    // elements: the overlapping prefix is preserved and any newly grown tail is zero-initialized.
    // `arr` must have exactly one owner: after this call the old value must
    // never be read again (a surviving alias would observe a stale, possibly-freed block) — the
    // same contract as C's `realloc`. `@unsafe` because the compiler cannot verify single
    // ownership; callers (e.g. `List<T>`, `Pointer<T>`) must uphold it themselves.
    @intrinsic("array_realloc")
    @unsafe
    static extern fun realloc<T>(arr: T[], new_len: int): T[];

    // Bulk-copies `count` unmanaged elements from `src[src_off..]` into `dst[dst_off..]`. The
    // emitter expands this to a single `memory.copy` of `count * sizeof(T)` bytes — correct only
    // for blittable `T` (no ARC retain on the copied slots). `@unsafe` because the compiler does
    // not check that the ranges fit inside either array's allocated length.
    @intrinsic("array_elems_copy")
    @unsafe
    static extern fun elems_copy<T : unmanaged>(
        borrow dst: T[],
        dst_off: int,
        borrow src: T[],
        src_off: int,
        count: int
    ): void;

    // Zeroes `count` unmanaged elements of `dst` starting at `dst_off` via `memory.fill`.
    // `@unsafe` because the compiler does not check that the range fits in `dst`.
    @intrinsic("array_elems_fill")
    @unsafe
    static extern fun elems_fill<T : unmanaged>(
        borrow dst: T[],
        dst_off: int,
        count: int
    ): void;

    // Releases the element in every slot of `arr` by overwriting it with a zero value, so a
    // container can rewind its length without stranding retained elements in dead slots. This
    // is the sanctioned way to shrink a managed buffer: each store goes through normal ARC
    // assignment semantics (release old occupant), unlike bitwise fills which must never touch
    // reference-typed slots. O(length); unmanaged elements compile to plain stores.
    public static fun clear<T>(borrow arr: T[]): void {
        let z = Buffer.alloc<T>(1);
        let i = 0;
        let n = arr.length;
        while i < n {
            arr[i] = z[0];
            i = i + 1;
        }
    }

    // Like `clear`, but releases only slots `[n, arr.length)` — the tail dropped by a shrink to
    // `n`. Slots below `n` are left untouched.
    public static fun truncate<T>(borrow arr: T[], n: int): void {
        if n < 0 {
            n = 0;
        }
        if n >= arr.length {
            return;
        }
        let z = Buffer.alloc<T>(1);
        let i = n;
        while i < arr.length {
            arr[i] = z[0];
            i = i + 1;
        }
    }

    // Writes a UTF-16 code unit as little-endian `i32.store16` at byte offset `off`.
    @intrinsic("array_store16")
    static extern fun store16(borrow arr: byte[], off: int, unit: int): void;

    // Immediately returns `arr`'s backing block to the allocator via `$free`, bypassing reference
    // counting entirely. Any other live reference to the same block (including `arr` itself, if
    // read again) is left dangling. `@unsafe` for the same reason as `realloc`: the compiler cannot
    // verify `arr` has no other owners.
    @intrinsic("force_free")
    @unsafe
    static extern fun free<T>(arr: T[]): void;
}
