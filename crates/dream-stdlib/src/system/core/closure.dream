module system.core;

// Compiler-internal support for arrow-lambda closures. Not a user-facing API — every call site is
// emitted directly by the analyzer's closure-lowering code, never reached through ordinary name
// resolution.
//
// A `fun(...)`-typed value is a reference-counted 2-word heap box `[funcidx][env]` (`env` is 0 for
// a non-capturing function/lambda). `funcbox_new` allocates the box and retains a non-null env;
// `$release_funcbox` (wired by the backend for `TyKind::Func`) releases that env when the last
// fun reference drops. `funcbox_funcidx`/`funcbox_env` read the box apart at an indirect-call site.
internal class Closure {
    @intrinsic("funcbox_new")
    static extern fun funcbox_new(funcidx: int, env: int): int;

    @intrinsic("funcbox_funcidx")
    static extern fun funcbox_funcidx(box: int): int;

    @intrinsic("funcbox_env")
    static extern fun funcbox_env(box: int): int;
}
