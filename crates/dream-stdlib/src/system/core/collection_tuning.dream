module system.core;

// Named tuning constants shared by the stdlib collections, so the near-identical growable-sequence
// (`List<T>`) and open-addressing hash-table (`Set<T>`/`Map<K, V>`) implementations
// cannot silently disagree on what a magic number means.
//
// These are plain zero-argument functions rather than top-level `const` globals because the
// prelude merge (`crate::driver::prelude::merge_prelude`) intentionally discards globals declared
// in prelude files (see its comment: "Preludes declare no globals"), while free functions merge
// normally and are callable from every other prelude file exactly like `Buffer.alloc<T>` already
// is. Each is a single `return <literal>;`, so the whole-module inlining pass folds every call
// back down to the literal in optimized builds - this costs nothing at runtime while still giving
// every call site a name instead of a bare magic number.

// Smallest backing-buffer capacity `Array`/`List` will grow to (also their capacity floor when
// constructed with a smaller explicit capacity).
public fun sequence_min_capacity(): int { return 4; }

// Smallest hash-table backing-array capacity (already a power of 2). `Map`/`Set.clear` keep the
// current capacity and reuse buffers rather than shrinking back to this floor.
public fun hash_min_capacity(): int { return 8; }
// First occupancy stamp stored in `Map`/`Set` probe slots (`0` remains empty).
public fun hash_epoch_initial(): int { return 1; }
// `Set`/`Map` grow when `(used + 1) * hash_load_factor_denom() >= capacity * hash_load_factor_num()`,
// i.e. before the table would exceed 3/4 full, keeping the average probe length short.
public fun hash_load_factor_num(): int { return 3; }
public fun hash_load_factor_denom(): int { return 4; }

// Next capacity for a growable buffer of `old` slots that must hold at least `need`: doubles
// (floored at `sequence_min_capacity()`), saturates instead of wrapping, and panics when `need`
// itself is not representable.
public fun grow_capacity(old: int, need: int): int {
    if need < 0 {
        System.panic("panic: capacity exceeds the supported limit");
    }
    let c = old;
    if c < sequence_min_capacity() {
        c = sequence_min_capacity();
    } else if c <= 1073741823 {
        c = c * 2;
    } else {
        c = 2147483647;
    }
    if c < need {
        c = need;
    }
    return c;
}

// Smallest power-of-two hash-table capacity (at least `hash_min_capacity()`) that is `>= need`.
// The largest representable power of two is 2^30; asking for more panics instead of wrapping.
public fun hash_capacity_for(need: int): int {
    if need > 1073741824 {
        System.panic("panic: capacity exceeds the supported limit");
    }
    let c = hash_min_capacity();
    while c < need {
        c = c * 2;
    }
    return c;
}

// `a * b` for non-negative sizes, panicking instead of wrapping.
public fun checked_size(a: int, b: int): int {
    if (a < 0) || (b < 0) || ((a != 0) && (b > 2147483647 / a)) {
        System.panic("panic: size exceeds the supported limit");
    }
    return a * b;
}
