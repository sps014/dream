    /// Identifies the from bytes operation for an `@intrinsic` declaration.
    FromBytes,
    /// Identifies the array realloc operation for an `@intrinsic` declaration.
    ArrayRealloc,
    /// Identifies the array elems copy operation for an `@intrinsic` declaration.
