module system.core;

// Reentrant mutual-exclusion lock for `@shared` critical sections.
shared public class Lock {
    @intrinsic("shared_lock_acquire")
    static extern fun host_acquire(target: Lock): void;

    @intrinsic("shared_lock_release")
    static extern fun host_release(target: Lock): void;

    @intrinsic("shared_lock_try_acquire")
    static extern fun host_try_acquire(target: Lock): bool;

    @intrinsic("shared_lock_try_acquire_for")
    static extern fun host_try_acquire_for(target: Lock, timeout_ms: int): bool;

    // Acquires the lock, blocking (busy-waiting) until available. Reentrant: the same thread may
    // call `acquire` again before releasing (matching `lock (obj) { ... }`'s own semantics), and
    // must call `release` the same number of times to fully release it.
    public fun acquire(): void {
        Lock.host_acquire(this);
    }

    // One-shot acquire: returns `true` on success (including a reentrant bump), `false` if another
    // thread currently holds the lock.
    public fun try_acquire(): bool {
        return Lock.host_try_acquire(this);
    }

    // Waits up to `timeout_ms` milliseconds to acquire. `timeout_ms <= 0` is a single try.
    // Best-effort under contention: spurious wakes do not shrink the remaining wait budget.
    public fun try_acquire_for(timeout_ms: int): bool {
        return Lock.host_try_acquire_for(this, timeout_ms);
    }

    // Releases one level of a lock acquired via `acquire()`. Undefined if called by a thread that
    // does not currently hold the lock.
    public fun release(): void {
        Lock.host_release(this);
    }
}
