module system.core;

// Mathematical functions. Trig and most transcendentals are host-native (`env.*`);
// thin public wrappers expose them (Dream forbids `public` + `extern` on one symbol).
/// Common mathematical operations on double-precision numbers. Trigonometric arguments and
/// results use radians.
public static class Math {
    @js("env", "abs")
    static extern fun abs_host(x: double): double;
    /// Returns the absolute value of `x`.
    public static fun abs(x: double): double {
        return Math.abs_host(x);
    }

    @js("env", "floor")
    static extern fun floor_host(x: double): double;
    /// Rounds `x` down to the nearest integer value.
    public static fun floor(x: double): double {
        return Math.floor_host(x);
    }

    @js("env", "ceil")
    static extern fun ceil_host(x: double): double;
    /// Rounds `x` up to the nearest integer value.
    public static fun ceil(x: double): double {
        return Math.ceil_host(x);
    }

    @js("env", "round")
    static extern fun round_host(x: double): double;
    /// Rounds `x` to the nearest integer value.
    public static fun round(x: double): double {
        return Math.round_host(x);
    }

    @js("env", "sqrt")
    static extern fun sqrt_host(x: double): double;

    // Square root. A negative input is NaN, same as `log` / `asin` and as libm.
    public static fun sqrt(x: double): double {
        return Math.sqrt_host(x);
    }

    @js("env", "pow")
    static extern fun pow_host(base: double, exponent: double): double;
    /// Returns `base` raised to `exponent`.
    public static fun pow(base: double, exponent: double): double {
        return Math.pow_host(base, exponent);
    }

    @js("env", "sin")
    static extern fun sin_host(x: double): double;
    /// Returns the sine of `x`, measured in radians.
    public static fun sin(x: double): double {
        return Math.sin_host(x);
    }

    @js("env", "cos")
    static extern fun cos_host(x: double): double;
    /// Returns the cosine of `x`, measured in radians.
    public static fun cos(x: double): double {
        return Math.cos_host(x);
    }

    @js("env", "tan")
    static extern fun tan_host(x: double): double;
    /// Returns the tangent of `x`, measured in radians.
    public static fun tan(x: double): double {
        return Math.tan_host(x);
    }

    @js("env", "asin")
    static extern fun asin_host(x: double): double;
    /// Returns the inverse sine in radians; inputs outside [-1, 1] produce NaN.
    public static fun asin(x: double): double {
        return Math.asin_host(x);
    }

    @js("env", "acos")
    static extern fun acos_host(x: double): double;
    /// Returns the inverse cosine in radians; inputs outside [-1, 1] produce NaN.
    public static fun acos(x: double): double {
        return Math.acos_host(x);
    }

    @js("env", "atan")
    static extern fun atan_host(x: double): double;
    /// Returns the inverse tangent in radians.
    public static fun atan(x: double): double {
        return Math.atan_host(x);
    }

    @js("env", "atan2")
    static extern fun atan2_host(y: double, x: double): double;
    /// Returns the angle of the point `(x, y)` in radians, using both signs to choose the
    /// quadrant.
    public static fun atan2(y: double, x: double): double {
        return Math.atan2_host(y, x);
    }

    @js("env", "log")
    static extern fun log_host(x: double): double;
    /// Returns the natural logarithm of `x`.
    public static fun log(x: double): double {
        return Math.log_host(x);
    }

    @js("env", "log10")
    static extern fun log10_host(x: double): double;
    /// Returns the base-ten logarithm of `x`.
    public static fun log10(x: double): double {
        return Math.log10_host(x);
    }

    @js("env", "exp")
    static extern fun exp_host(x: double): double;
    /// Returns e raised to `x`.
    public static fun exp(x: double): double {
        return Math.exp_host(x);
    }

    @js("env", "hypot")
    static extern fun hypot_host(x: double, y: double): double;
    /// Returns the length of the vector `(x, y)`.
    public static fun hypot(x: double, y: double): double {
        return Math.hypot_host(x, y);
    }

    /// Ratio of a circle's circumference to its diameter.
    public static get PI(): double {
        return 3.141592653589793d;
    }

    /// Base of the natural logarithm.
    public static get E(): double {
        return 2.718281828459045d;
    }

    /// Returns the smaller of `a` and `b`.
    public static fun min(a: double, b: double): double {
        if a < b {
            return a;
        }
        return b;
    }

    /// Returns the larger of `a` and `b`.
    public static fun max(a: double, b: double): double {
        if a > b {
            return a;
        }
        return b;
    }

    /// Returns `x` limited to the inclusive range `lo` through `hi`.
    public static fun clamp(x: double, lo: double, hi: double): double {
        if x < lo {
            return lo;
        }
        if x > hi {
            return hi;
        }
        return x;
    }
}
