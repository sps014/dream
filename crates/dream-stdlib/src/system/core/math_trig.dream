module system.core;

// Ports of fdlibm's __sin, __cos, __tan and __rem_pio2 as used by musl. Arguments are reduced to
// [-pi/4, pi/4] by a multiple of pi/2, and the remainder is carried in two doubles.
/// Sine, cosine, and tangent of double-precision arguments in radians.
internal static class MathTrig {
    /// The sine of `x + y` for `|x + y| <= pi/4`. `y` is used only when `has_tail` is set.
    static fun sin_kernel(x: double, y: double, has_tail: bool): double {
        let s1 = -1.66666666666666324348e-01d;
        let s2 = 8.33333333332248946124e-03d;
        let s3 = -1.98412698298579493134e-04d;
        let s4 = 2.75573137070700676789e-06d;
        let s5 = -2.50507602534068634195e-08d;
        let s6 = 1.58969099521155010221e-10d;

        let z = x * x;
        let w = z * z;
        let r = s2 + z * (s3 + z * s4) + z * w * (s5 + z * s6);
        let v = z * x;
        if !has_tail {
            return x + v * (s1 + z * r);
        }
        return x - ((z * (0.5d * y - v * r) - y) - v * s1);
    }

    /// The cosine of `x + y` for `|x + y| <= pi/4`.
    static fun cos_kernel(x: double, y: double): double {
        let c1 = 4.16666666666666019037e-02d;
        let c2 = -1.38888888888741095749e-03d;
        let c3 = 2.48015872894767294178e-05d;
        let c4 = -2.75573143513906633035e-07d;
        let c5 = 2.08757232129817482790e-09d;
        let c6 = -1.13596475577881948265e-11d;

        let z = x * x;
        let w = z * z;
        let r = z * (c1 + z * (c2 + z * c3)) + w * w * (c4 + z * (c5 + z * c6));
        let hz = 0.5d * z;
        w = 1.0d - hz;
        return w + (((1.0d - w) - hz) + (z * r - x * y));
    }

    /// The tangent of `x + y` for `|x + y| <= pi/4`, or its negative reciprocal when `odd`.
    static fun tan_kernel(x: double, y: double, odd: bool): double {
        let t0 = 3.33333333333334091986e-01d;
        let t1 = 1.33333333333201242699e-01d;
        let t2 = 5.39682539762260521377e-02d;
        let t3 = 2.18694882948595424599e-02d;
        let t4 = 8.86323982359930005737e-03d;
        let t5 = 3.59207910759131235356e-03d;
        let t6 = 1.45620945432529025516e-03d;
        let t7 = 5.88041240820264096874e-04d;
        let t8 = 2.46463134818469906812e-04d;
        let t9 = 7.81794442939557092300e-05d;
        let t10 = 7.14072491382608190305e-05d;
        let t11 = -1.85586374855275456654e-05d;
        let t12 = 2.59073051863633712884e-05d;
        let pio4 = 7.85398163397448278999e-01d;
        let pio4lo = 3.06161699786838301793e-17d;

        let a = x;
        let b = y;
        let hx = Math.high_word(x);
        // Near pi/4 the series converges slowly, so evaluate tan(pi/4 - |x|) instead.
        let big = (hx & 0x7FFFFFFF) >= 0x3FE59428;
        let negative = hx < 0;
        if big {
            if negative {
                a = -a;
                b = -b;
            }
            a = (pio4 - a) + (pio4lo - b);
            b = 0.0d;
        }
        let z = a * a;
        let w = z * z;
        let r = t1 + w * (t3 + w * (t5 + w * (t7 + w * (t9 + w * t11))));
        let v = z * (t2 + w * (t4 + w * (t6 + w * (t8 + w * (t10 + w * t12)))));
        let s = z * a;
        r = b + z * (s * (r + v) + b) + s * t0;
        w = a + r;
        if big {
            let sign = odd ? -1.0d : 1.0d;
            v = sign - 2.0d * (a + (r - w * w / (w + sign)));
            return negative ? -v : v;
        }
        if !odd {
            return w;
        }
        // -1 / (a + r) loses accuracy when computed directly, so split both terms.
        let w0 = Math.clear_low_word(w);
        v = r - (w0 - a);
        let q = -1.0d / w;
        let q0 = Math.clear_low_word(q);
        return q0 + q * (1.0d + q0 * w0 + q0 * v);
    }

    /// Writes `x` as `n * pi/2 + hi + lo` with `|hi + lo| <= pi/4`. Requires a finite `x`.
    static fun reduce(x: double): ReducedArgument {
        let ix = Math.high_word(x) & 0x7FFFFFFF;
        if ix >= 0x413921FB {
            return MathPiReduction.reduce_large(x);
        }
        let to_int = 6755399441055744.0d;
        let inv_pio2 = 6.36619772367581382433e-01d;
        let pio2_1 = 1.57079632673412561417e+00d;
        let pio2_1t = 6.07710050650619224932e-11d;
        let pio2_2 = 6.07710050630396597660e-11d;
        let pio2_2t = 2.02226624879595063154e-21d;
        let pio2_3 = 2.02226624871116645580e-21d;
        let pio2_3t = 8.47842766036889956997e-32d;

        // Adding and subtracting 1.5 * 2^52 rounds `x * 2/pi` to the nearest integer.
        let k = x * inv_pio2 + to_int - to_int;
        let n = (int)k;
        let r = x - k * pio2_1;
        let w = k * pio2_1t;
        let hi = r - w;
        let ex = ix >> 20;
        let ey = (Math.high_word(hi) >> 20) & 0x7FF;
        if ex - ey > 16 {
            let t = r;
            w = k * pio2_2;
            r = t - w;
            w = k * pio2_2t - ((t - r) - w);
            hi = r - w;
            ey = (Math.high_word(hi) >> 20) & 0x7FF;
            if ex - ey > 49 {
                t = r;
                w = k * pio2_3;
                r = t - w;
                w = k * pio2_3t - ((t - r) - w);
                hi = r - w;
            }
        }
        return ReducedArgument(n, hi, (r - hi) - w);
    }

    /// The sine of `x`.
    internal static fun sin(x: double): double {
        let ix = Math.high_word(x) & 0x7FFFFFFF;
        if ix <= 0x3FE921FB {
            if ix < 0x3E500000 {
                return x;
            }
            return MathTrig.sin_kernel(x, 0.0d, false);
        }
        if ix >= 0x7FF00000 {
            return x - x;
        }
        let r = MathTrig.reduce(x);
        let quadrant = r.n & 3;
        if quadrant == 0 {
            return MathTrig.sin_kernel(r.hi, r.lo, true);
        }
        if quadrant == 1 {
            return MathTrig.cos_kernel(r.hi, r.lo);
        }
        if quadrant == 2 {
            return -MathTrig.sin_kernel(r.hi, r.lo, true);
        }
        return -MathTrig.cos_kernel(r.hi, r.lo);
    }

    /// The cosine of `x`.
    internal static fun cos(x: double): double {
        let ix = Math.high_word(x) & 0x7FFFFFFF;
        if ix <= 0x3FE921FB {
            if ix < 0x3E46A09E {
                return 1.0d;
            }
            return MathTrig.cos_kernel(x, 0.0d);
        }
        if ix >= 0x7FF00000 {
            return x - x;
        }
        let r = MathTrig.reduce(x);
        let quadrant = r.n & 3;
        if quadrant == 0 {
            return MathTrig.cos_kernel(r.hi, r.lo);
        }
        if quadrant == 1 {
            return -MathTrig.sin_kernel(r.hi, r.lo, true);
        }
        if quadrant == 2 {
            return -MathTrig.cos_kernel(r.hi, r.lo);
        }
        return MathTrig.sin_kernel(r.hi, r.lo, true);
    }

    /// The tangent of `x`.
    internal static fun tan(x: double): double {
        let ix = Math.high_word(x) & 0x7FFFFFFF;
        if ix <= 0x3FE921FB {
            if ix < 0x3E400000 {
                return x;
            }
            return MathTrig.tan_kernel(x, 0.0d, false);
        }
        if ix >= 0x7FF00000 {
            return x - x;
        }
        let r = MathTrig.reduce(x);
        return MathTrig.tan_kernel(r.hi, r.lo, (r.n & 1) == 1);
    }
}
