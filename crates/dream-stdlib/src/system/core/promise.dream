module system.core;

/// Promise utilities for async tasks.
public static class Promise {
    /// Waits for every future and returns their results in input order.
    @intrinsic(Intrinsic.PromiseAll)
    internal static extern async fun all_host<T>(borrow promises: T[]): T[];

    /// Returns the result of the first future to complete.
    @intrinsic(Intrinsic.PromiseRace)
    internal static extern async fun race_host<T>(borrow promises: T[]): T;

    /// Waits for all promises in the array to resolve.
    public static async fun all<T>(
        borrow promises: Future<T>[],
        token: Option<CancellationToken> = Option.None
    ): T[] {
        CancellationToken.throw_if_opt(token);
        return Promise.all_host(promises).await;
    }

    /// Waits until the first future in `promises` completes and returns its result. The other
    /// futures are not cancelled; use `Promise.cancel` when their work should stop.
    /// Throws when `token` is already cancelled before waiting starts.
    public static async fun race<T>(
        borrow promises: Future<T>[],
        token: Option<CancellationToken> = Option.None
    ): T {
        CancellationToken.throw_if_opt(token);
        return Promise.race_host(promises).await;
    }

    // Cancels a future (marks it cancelled and unlinks pending timers). The future it is
    // awaiting is cancelled too when nothing else holds it. Best-effort for in-flight native
    // host HTTP; cooperative `CancellationToken` is preferred for app logic.
    // Takes the future as `object` (futures are heap refs) so this can be a plain intrinsic.
    /// Requests cancellation of a future and of its awaited work when no other owner needs it.
    /// Cancellation of an in-flight network request is best effort; use `CancellationToken` for
    /// cooperative application cancellation.
    @intrinsic(Intrinsic.DreamCancel)
    public static extern fun cancel(borrow future: object): void;

    /// Explicitly launches a lazy future without awaiting it (fire-and-forget). Futures only run
    /// when awaited, passed to `all`/`any`/`race`, or started here; a never-started future never
    /// executes. Takes the future as `object` (futures are heap refs) like `cancel`.
    @intrinsic(Intrinsic.DreamStart)
    public static extern fun start(borrow future: object): void;
}
