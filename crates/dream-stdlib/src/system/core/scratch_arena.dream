module system.core;

// Bump-pointer scratch slab for short-lived unmanaged batches (parse/match/fill loops).
// `reset()` rewinds the cursor without returning memory to the OS — like a gen0 nursery for
// blittable scratch, not a replacement for long-lived ARC graphs.
//
// Parameterized on `T : unmanaged` so the same arena shape works for `int`, `byte`, `char`,
// unmanaged structs, etc. Use one arena per element type (or several arenas) in a hot loop.
// Overflow traps; grow by constructing a larger arena.
public class ScratchArena<T : unmanaged> {
    items: T[];
    used: int;

    // Allocates a zeroed slab of `capacity` elements (at least one).
    public constructor(capacity: int) {
        let n = capacity;
        if (n < 1) {
            n = 1;
        }
        this.items = Buffer.alloc<T>(n);
        this.used = 0;
    }

    // Number of elements still available before the next `reset`.
    public fun remaining(): int {
        return this.items.length - this.used;
    }

    // Total element capacity of the slab.
    @inline
    public fun capacity(): int {
        return this.items.length;
    }

    // Bump-allocates `n` elements and returns a `Span` over them. Does not zero the span (callers
    // that need zeros should write them); prior contents after `reset` may be stale.
    // Prefer `bump`/`set_at`/`at` in hot loops: a `Span` holds a strong ref to the slab, so each
    // `alloc` pays retain/release on `items`.
    public fun alloc(n: int): Span<T> {
        let start = this.bump(n);
        return Span<T>(this.items, start, n);
    }

    // Bump-allocates `n` elements and returns the start index into the slab (no `Span`, no extra RC).
    @inline
    public fun bump(n: int): int {
        if (n < 0) {
            System.panic("ScratchArena.bump: negative count");
        }
        if (this.used + n > this.items.length) {
            System.panic("ScratchArena overflow");
        }
        let start = this.used;
        this.used = this.used + n;
        return start;
    }

    // Absolute-index write into the slab (same addressing as `bump`'s return value).
    @inline
    public fun set_at(index: int, value: T): void {
        this.items[index] = value;
    }

    // Absolute-index read from the slab.
    @inline
    public fun at(index: int): T {
        return this.items[index];
    }

    // Rewinds the bump cursor; the slab stays allocated.
    @inline
    public fun reset(): void {
        this.used = 0;
    }
}
