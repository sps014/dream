module system.core;

// Low-level string construction used by core/primitives (and `extend string` in system.text).
// `alloc`/`set` use UTF-16 code-unit indices; the backing store is UTF-16 LE.
extend string {
    // Span construction and its logical-range check already prove the backing unit exists.
    @intrinsic(Intrinsic.StringCharAtUnchecked)
    @unsafe
    internal static extern fun char_at_unchecked(borrow s: string, index: int): char;

    // Allocates an uninitialized string with capacity for `n` UTF-16 code units.
    @intrinsic(Intrinsic.StringAlloc)
    internal static extern fun alloc(n: int): string;

    // Writes code unit `c` at unit index `i` of string `s`.
    @intrinsic(Intrinsic.StringSet)
    internal static extern fun set(borrow s: string, i: int, c: char): void;

    // Builds a string from a full `byte[]` UTF-8 payload (transcodes to UTF-16).
    @intrinsic(Intrinsic.StringFromUtf8)
    internal static extern fun from_utf8(borrow bytes: byte[]): string;

    // Builds a string from the first `len` bytes of `bytes` (clamped to the array length).
    @intrinsic(Intrinsic.StringFromUtf8Prefix)
    internal static extern fun from_utf8_prefix(borrow bytes: byte[], len: int): string;

    // Copies `len` UTF-16 LE payload bytes from `bytes`; `scalars` is the unit count.
    @intrinsic(Intrinsic.StringFromUtf8PrefixN)
    internal static extern fun from_utf8_prefix_n(
        borrow bytes: byte[],
        len: int,
        scalars: int
    ): string;

    // StringBuilder finish: unique buffers (`rc == 1`) are adopted; otherwise copied.
    @intrinsic(Intrinsic.StringFromBuilder)
    internal static extern fun from_builder(borrow bytes: byte[], len: int, scalars: int): string;

    // Unit-indexed substring: O(1) slice (header + payload pointer + retain parent).
    @intrinsic(Intrinsic.StringSubstringRaw)
    internal static extern fun substring_raw(borrow s: string, start: int, end: int): string;

    // Bulk-copies `count` payload bytes from `src` into `dst` at `dst_off`.
    @intrinsic(Intrinsic.StringCopyUtf8)
    internal static extern fun copy_utf8(
        borrow dst: byte[],
        dst_off: int,
        borrow src: string,
        src_off: int,
        count: int
    ): void;

    // Unchecked UTF-16 unit load at a payload byte offset (even offsets).
    @intrinsic(Intrinsic.Utf8DecodeAt)
    internal static extern fun utf8_decode_at(borrow s: string, byte_off: int): char;

    // Payload stride in bytes of the unit at `byte_off` (always 2).
    @intrinsic(Intrinsic.Utf8WidthAt)
    internal static extern fun utf8_width_at(borrow s: string, byte_off: int): int;
}
