module system.core;

// Low-level string construction used by core/primitives (and `extend string` in system.text).
// `alloc`/`set` use Unicode scalar indices; the backing store is always UTF-8.
extend string {
    // Allocates an uninitialized string with capacity for `n` Unicode scalars.
    @intrinsic("string_alloc")
    static extern fun alloc(n: int): string;

    // Writes scalar `c` at scalar index `i` of string `s`.
    @intrinsic("string_set")
    static extern fun set(borrow s: string, i: int, c: char): void;

    // Builds a string from a full `byte[]` UTF-8 payload (copies bytes; counts scalars once).
    @intrinsic("string_from_utf8")
    static extern fun from_utf8(borrow bytes: byte[]): string;

    // Builds a string from the first `len` bytes of `bytes` (clamped to the array length).
    @intrinsic("string_from_utf8_prefix")
    static extern fun from_utf8_prefix(borrow bytes: byte[], len: int): string;

    // Scalar-indexed substring via one UTF-8 byte-range copy (`$string_substring_raw`).
    @intrinsic("string_substring_raw")
    static extern fun substring_raw(borrow s: string, start: int, end: int): string;

    // Fresh heap copy of `s` (isolation boundary for `@shared` string fields / worker captures).
    @intrinsic("string_clone")
    static extern fun clone(borrow s: string): string;

    // Bulk-copies `count` UTF-8 bytes from `src` into `dst` at `dst_off`.
    @intrinsic("string_copy_utf8")
    static extern fun copy_utf8(borrow dst: byte[], dst_off: int, borrow src: string, src_off: int, count: int): void;

    // UTF-8 lexicographic compare (same order as Unicode scalars): negative / zero / positive.
    @intrinsic("string_compare")
    static extern fun compare_raw(borrow a: string, borrow b: string): int;

    // Unchecked UTF-8 decode at a byte offset (callers must pass a scalar start).
    @intrinsic("utf8_decode_at")
    static extern fun utf8_decode_at(borrow s: string, byte_off: int): char;

    // UTF-8 width in bytes of the scalar starting at `byte_off`.
    @intrinsic("utf8_width_at")
    static extern fun utf8_width_at(borrow s: string, byte_off: int): int;

    // The interned empty string. Prefer this over `""` so empty results share one immortal pointer
    // instead of a fresh heap block (substring/from_utf8/concat of empties also return this).
    public static get empty(): string {
        return "";
    }
}
