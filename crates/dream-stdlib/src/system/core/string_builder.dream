module system.core;

// `StringBuilder` — growable UTF-16 string construction. Lives in the bootstrap core so every
// package (collections included) can build strings in O(n); always available without imports.
public class StringBuilder {
    bytes: byte[];

    // Payload bytes used in `bytes` (always even; two bytes per UTF-16 unit).
    count: int;

    // Backing-buffer capacity in bytes (mirrors `this.bytes.length`; the native fast path
    // reads this field instead of chasing the array header on every append).
    cap: int;

    // Set once `as_span` has shared `bytes`; `clear` then swaps in a fresh buffer so viewed units
    // are never overwritten.
    viewed: bool;

    // Allocates an empty builder with an initial backing buffer capacity in payload bytes (defaults to 16).
    @inline
    public constructor(capacity: int = 16) {
        let c = capacity;
        if c < sequence_min_capacity() {
            c = sequence_min_capacity();
        }
        this.bytes = StringBuilder.new_buffer(c + 4);
        this.count = 0;
        this.cap = c + 4;
    }

    // Number of UTF-16 code units appended so far (`count` is always even).
    public get length(): int {
        return this.count / 2;
    }

    // True when nothing has been appended yet.
    @inline
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Grows the backing buffer to at least `min_capacity` bytes via in-place realloc when possible.
    @inline
    fun grow(min_capacity: int): void {
        let new_cap = grow_capacity(this.cap, min_capacity);
        this.bytes = Buffer.realloc<byte>(this.bytes, new_cap);
        this.cap = new_cap;
    }

    @inline
    fun ensure(extra: int): void {
        let need = this.count + extra + 4;
        if need > this.cap {
            this.grow(need);
        }
    }

    @inline
    fun write_unit(u: int): void {
        this.ensure(2);
        Buffer.store16(this.bytes, this.count + 4, u);
        this.count = this.count + 2;
    }

    // Appends a Unicode scalar as one or two UTF-16 units.
    public fun append_char(c: char): void {
        let cp = c.to_int();
        if (cp < 0) || (cp > 1114111) {
            cp = 65533;
        }
        if cp < 65536 {
            this.write_unit(cp);
            return;
        }
        let x = cp - 65536;
        this.write_unit(55296 + (x / 1024));
        this.write_unit(56320 + (x % 1024));
    }

    /// Appends `text` to the builder.
    @intrinsic(Intrinsic.StringBuilderPush)
    public static extern fun push_raw(borrow sb: StringBuilder, borrow text: string): void;

    @intrinsic(Intrinsic.StringBuilderBuffer)
    // Only initialized bytes below `count` can become a built string.
    public static extern fun new_buffer(capacity: int): byte[];

    /// Appends the decimal representation of `n`.
    @intrinsic(Intrinsic.StringBuilderPushInt)
    public static extern fun push_int(borrow sb: StringBuilder, n: int): void;

    /// Appends the decimal representation of `n`.
    @intrinsic(Intrinsic.StringBuilderPushLong)
    public static extern fun push_long(borrow sb: StringBuilder, n: long): void;

    // Appends every UTF-16 unit of `text`, growing at most once.
    @inline
    public fun append(borrow text: string): void {
        StringBuilder.push_raw(this, text);
    }

    // Appends the units a `ReadOnlySpan<char>` views, with no intermediate string.
    public fun append(span: ReadOnlySpan<char>): void {
        if span._text {
            this.append_utf8_slice(span.src, span.offset * 2, span._length * 2);
            return;
        }
        let i = 0;
        while i < span.length {
            this.append_char(span.get(i));
            i = i + 1;
        }
    }

    // Appends `byte_len` payload bytes starting at byte index `start` of `text`.
    public fun append_utf8_slice(borrow text: string, start: int, byte_len: int): void {
        if byte_len <= 0 {
            return;
        }
        let size = text.byte_size();
        if start < 0 || start > size || byte_len > size - start {
            System.panic("StringBuilder slice out of bounds");
        }
        this.ensure(byte_len);
        string.copy_utf8(this.bytes, this.count + 4, text, start, byte_len);
        this.count = this.count + byte_len;
    }

    // Appends a decimal integer without allocating an intermediate string.
    public fun append_int(n: int): void {
        StringBuilder.push_int(this, n);
    }

    // Appends `"true"` or `"false"` without allocating an intermediate string.
    public fun append_bool(v: bool): void {
        if v {
            this.append("true");
        } else {
            this.append("false");
        }
    }

    // Appends a decimal long without allocating an intermediate string.
    public fun append_long(n: long): void {
        StringBuilder.push_long(this, n);
    }

    @intrinsic(Intrinsic.StringBuilderPushDouble)
    static extern fun push_double(borrow sb: StringBuilder, n: double): void;

    /// Appends the decimal representation of `n`.
    public fun append_double(n: double): void {
        StringBuilder.push_double(this, n);
    }

    // Appends `text` followed by a newline character.
    public fun append_line(borrow text: string): void {
        this.append(text);
        this.append_char('\n');
    }

    // Removes every appended character, keeping the backing buffer for reuse.
    @inline
    public fun clear(): void {
        this.count = 0;
        if this.viewed {
            this.bytes = StringBuilder.new_buffer(this.cap);
            this.viewed = false;
        }
    }

    /// Creates a string from the first `len` bytes in the builder buffer. The range must be
    /// valid.
    @intrinsic(Intrinsic.StringBuilderView)
    public static extern fun view_raw(borrow bytes: byte[], len: int): string;

    // A view of everything appended so far, without copying the units. Later appends and
    // `clear` leave the view unchanged: it is a snapshot.
    public fun as_span(): ReadOnlySpan<char> {
        if this.count <= 0 {
            return string.empty.span();
        }
        this.viewed = true;
        let s = StringBuilder.view_raw(this.bytes, this.count);
        return ReadOnlySpan<char>.from_text(s, 0, this.count / 2);
    }

    // Snapshot into a new string. `from_builder` copies once; do not stage through a
    // second `byte[]` (that doubled the finish memcpy).
    public fun build(): string {
        let n = this.count;
        if n <= 0 {
            return string.empty;
        }
        // `scalars < 0` tells the runtime to derive the unit count from `len`.
        return string.from_builder(this.bytes, n, -1);
    }

    /// Returns a text representation of this value.
    public override fun to_string(): string {
        return this.build();
    }
}
