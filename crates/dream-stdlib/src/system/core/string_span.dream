module system.core;

// `StringSpan` - a read-only view of `length` UTF-16 units of a `string`, starting at `offset`.
// It is a `ref struct`: stored inline with no heap allocation of its own, and rejected anywhere
// it could outlive the frame that made it. It keeps its source string strongly referenced, so
// the units it views stay alive; `to_string()` is the one place it allocates.
public ref struct StringSpan {
    internal src: string;
    internal offset: int;
    internal _length: int;

    internal constructor(borrow src: string, offset: int, length: int) {
        this.src = src;
        this.offset = offset;
        this._length = length;
    }

    // A span over the whole of `s`.
    public static fun of(borrow s: string): StringSpan {
        return StringSpan(s, 0, s.length);
    }

    // Number of UTF-16 units in the view.
    public get length(): int {
        return this._length;
    }

    @inline
    public fun is_empty(): bool {
        return this._length == 0;
    }

    // Payload bytes of the view (two per unit).
    @inline
    public fun byte_size(): int {
        return this._length * 2;
    }

    // The unit at `index` (relative to the view). Traps if out of range.
    @inline
    public fun char_at(index: int): char {
        if (index < 0) || (index >= this._length) {
            System.panic("StringSpan index out of range");
        }
        return this.src.char_at(this.offset + index);
    }

    public fun this[index: int]: char {
        return this.char_at(index);
    }

    // Payload byte `index` (UTF-16 LE, relative to the view). Traps if out of range.
    public fun byte_at(index: int): int {
        if (index < 0) || (index >= this._length * 2) {
            System.panic("StringSpan byte index out of range");
        }
        return this.src.byte_at(this.offset * 2 + index);
    }

    // The sub-view `[start, end)` of this view, clamped exactly like `string.substring`.
    public fun slice(start: int, end: int): StringSpan {
        let n = this._length;
        let s = start;
        let e = end;
        if s < 0 {
            s = 0;
        } else if s > n {
            s = n;
        }
        if e < 0 {
            e = 0;
        } else if e > n {
            e = n;
        }
        if e < s {
            e = s;
        }
        return StringSpan(this.src, this.offset + s, e - s);
    }

    // The view from `start` to the end.
    public fun slice(start: int): StringSpan {
        return this.slice(start, this._length);
    }

    // Copies the viewed units into a `string` (an O(1) slice of the source).
    public override fun to_string(): string {
        return string.substring_raw(this.src, this.offset, this.offset + this._length);
    }

    // Same value as `this.to_string().hash_code()`, without allocating.
    public override fun hash_code(): int {
        return string.view_hash(this.src, this.offset, this._length);
    }

    fun operator ==(other: StringSpan): bool {
        return string.view_eq(this.src, this.offset, this._length, other.src, other.offset, other._length) != 0;
    }

    fun operator ==(borrow other: string): bool {
        return this.equals(other);
    }

    // True when the view holds exactly the units of `other`.
    public fun equals(borrow other: string): bool {
        return string.view_eq(this.src, this.offset, this._length, other, 0, other.length) != 0;
    }

    // Code-unit order against `other`: negative / zero / positive.
    public fun compare(other: StringSpan): int {
        return string.view_compare(this.src, this.offset, this._length, other.src, other.offset, other._length);
    }

    public fun compare(borrow other: string): int {
        return string.view_compare(this.src, this.offset, this._length, other, 0, other.length);
    }

    public fun starts_with(borrow prefix: string): bool {
        let n = prefix.length;
        if n > this._length {
            return false;
        }
        return string.view_eq(this.src, this.offset, n, prefix, 0, n) != 0;
    }

    public fun ends_with(borrow suffix: string): bool {
        let n = suffix.length;
        if n > this._length {
            return false;
        }
        return string.view_eq(this.src, this.offset + this._length - n, n, suffix, 0, n) != 0;
    }

    public fun contains(borrow sub: string): bool {
        return string.view_find(this.src, this.offset, this._length, sub, 0, sub.length, 0) >= 0;
    }

    public fun contains(c: char): bool {
        return string.view_find_char(this.src, this.offset, this._length, 0, (int)c) >= 0;
    }

    // Index (relative to the view) of the first `c`, or `None`.
    public fun index_of(c: char): Option<int> {
        return span_found(string.view_find_char(this.src, this.offset, this._length, 0, (int)c));
    }

    public fun index_of(c: char, from: int): Option<int> {
        return span_found(string.view_find_char(this.src, this.offset, this._length, from, (int)c));
    }

    // Index (relative to the view) of the first occurrence of `sub`, or `None`.
    public fun index_of(borrow sub: string): Option<int> {
        return span_found(string.view_find(this.src, this.offset, this._length, sub, 0, sub.length, 0));
    }

    public fun index_of(borrow sub: string, from: int): Option<int> {
        return span_found(string.view_find(this.src, this.offset, this._length, sub, 0, sub.length, from));
    }

    public fun last_index_of(c: char): Option<int> {
        return span_found(string.view_rfind_char(this.src, this.offset, this._length, (int)c));
    }

    // Empty `sub` is `Some(length)`, like `string.last_index_of`.
    public fun last_index_of(borrow sub: string): Option<int> {
        return span_found(string.view_rfind(this.src, this.offset, this._length, sub, 0, sub.length));
    }

    // The view without leading and trailing whitespace.
    public fun trim(): StringSpan {
        return this.trim_start().trim_end();
    }

    public fun trim_start(): StringSpan {
        let s = 0;
        while (s < this._length) && this.src.char_at(this.offset + s).is_whitespace() {
            s = s + 1;
        }
        return StringSpan(this.src, this.offset + s, this._length - s);
    }

    public fun trim_end(): StringSpan {
        let e = this._length;
        while (e > 0) && this.src.char_at(this.offset + e - 1).is_whitespace() {
            e = e - 1;
        }
        return StringSpan(this.src, this.offset, e);
    }

    // A (possibly signed) decimal `int`, with the same errors as `int.parse`.
    public fun parse_int(): Result<int, ParseError> {
        let n = this._length;
        if n == 0 {
            return Result.Err(ParseError.invalid("cannot parse int from empty string"));
        }
        let i = 0;
        let neg = false;
        if this.src.char_at(this.offset) == '-' {
            neg = true;
            i = 1;
        }
        if i >= n {
            return Result.Err(ParseError.invalid("cannot parse int: no digits"));
        }
        let limit = 2147483647L;
        if neg {
            limit = 2147483648L;
        }
        let result = 0L;
        while i < n {
            let c = this.src.char_at(this.offset + i);
            if (c < '0') || (c > '9') {
                return Result.Err(ParseError.invalid("cannot parse int: invalid digit"));
            }
            result = result * 10L + (long)((int)c - 48);
            if result > limit {
                return Result.Err(ParseError.invalid("cannot parse int: value out of range"));
            }
            i = i + 1;
        }
        if neg {
            return Result.Ok((int)(0L - result));
        }
        return Result.Ok((int)result);
    }

    public fun parse_double(): Result<double, ParseError> {
        return double.parse(this.to_string());
    }

    // Pieces between occurrences of `sep`; `while it.move_next() { it.current }`.
    public fun split_iter(sep: char): StringSplit {
        return StringSplit(this, string.empty, (int)sep);
    }

    public fun split_iter(borrow sep: string): StringSplit {
        return StringSplit(this, sep, -1);
    }

    // Lines split on `\n` with a trailing `\r` dropped; a final `\n` does not start a new line.
    public fun lines(): StringLines {
        return StringLines(this);
    }
}

fun span_found(i: int): Option<int> {
    if i < 0 {
        return Option.None;
    }
    return Option.Some(i);
}

// Cursor over the pieces of a `StringSpan` between separators. Every piece is a view of the
// same source; nothing is allocated.
public ref struct StringSplit {
    rest: StringSpan;
    sep: string;
    sep_char: int;
    done: bool;
    _current: StringSpan;

    internal constructor(rest: StringSpan, borrow sep: string, sep_char: int) {
        this.rest = rest;
        this.sep = sep;
        this.sep_char = sep_char;
        this.done = (sep_char < 0) && sep.length == 0;
        this._current = rest.slice(0, 0);
        if this.done {
            this._current = rest;
        }
    }

    // Advances to the next piece; `false` once every piece has been produced.
    public fun move_next(): bool {
        if this.done {
            return false;
        }
        let r = this.rest;
        let at = 0;
        let width = 1;
        if this.sep_char >= 0 {
            at = string.view_find_char(r.src, r.offset, r._length, 0, this.sep_char);
        } else {
            at = string.view_find(r.src, r.offset, r._length, this.sep, 0, this.sep.length, 0);
            width = this.sep.length;
        }
        if at < 0 {
            this._current = r;
            this.done = true;
            this.rest = r.slice(r._length);
            return true;
        }
        this._current = r.slice(0, at);
        this.rest = r.slice(at + width);
        return true;
    }

    // The piece produced by the last `move_next()`.
    public get current(): StringSpan {
        return this._current;
    }
}

// Cursor over the lines of a `StringSpan`.
public ref struct StringLines {
    rest: StringSpan;
    _current: StringSpan;

    internal constructor(rest: StringSpan) {
        this.rest = rest;
        this._current = rest.slice(0, 0);
    }

    public fun move_next(): bool {
        let r = this.rest;
        if r._length == 0 {
            return false;
        }
        let at = string.view_find_char(r.src, r.offset, r._length, 0, 10);
        let line = r;
        if at < 0 {
            this.rest = r.slice(r._length);
        } else {
            line = r.slice(0, at);
            this.rest = r.slice(at + 1);
        }
        if line.ends_with("\r") {
            line = line.slice(0, line._length - 1);
        }
        this._current = line;
        return true;
    }

    public get current(): StringSpan {
        return this._current;
    }
}

// A `Map`/`Set` key that can be found by a `StringSpan` without building a `string`.
public interface StringKey {
    fun matches_span(other: StringSpan): bool;
}

extend string : StringKey {
    // A view of the whole string.
    public fun span(): StringSpan {
        return StringSpan(this, 0, this.length);
    }

    // A view of `[start, end)`, clamped exactly like `substring`.
    public fun span(start: int, end: int): StringSpan {
        return StringSpan(this, 0, this.length).slice(start, end);
    }

    fun operator ==(other: StringSpan): bool {
        return this.matches_span(other);
    }

    public fun matches_span(other: StringSpan): bool {
        return string.view_eq(this, 0, this.length, other.src, other.offset, other._length) != 0;
    }

    @intrinsic("string_view_eq")
    static extern fun view_eq(borrow a: string, ao: int, an: int, borrow b: string, bo: int, bn: int): int;

    @intrinsic("string_view_compare")
    static extern fun view_compare(borrow a: string, ao: int, an: int, borrow b: string, bo: int, bn: int): int;

    @intrinsic("string_view_hash")
    static extern fun view_hash(borrow s: string, off: int, n: int): int;

    @intrinsic("string_view_find")
    static extern fun view_find(borrow h: string, ho: int, hn: int, borrow nd: string, no: int, nn: int, from: int): int;

    @intrinsic("string_view_rfind")
    static extern fun view_rfind(borrow h: string, ho: int, hn: int, borrow nd: string, no: int, nn: int): int;

    @intrinsic("string_view_find_char")
    static extern fun view_find_char(borrow s: string, off: int, n: int, from: int, c: int): int;

    @intrinsic("string_view_rfind_char")
    static extern fun view_rfind_char(borrow s: string, off: int, n: int, c: int): int;
}
