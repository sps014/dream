module system.core;

/// Cursor over the pieces of a `ReadOnlySpan<char>` between separators. Every piece is a view of the
/// same source; nothing is allocated.
public ref struct StringSplit {
    rest: ReadOnlySpan<char>;
    sep: string;
    sep_char: int;
    done: bool;
    _current: ReadOnlySpan<char>;

    internal constructor(rest: ReadOnlySpan<char>, borrow sep: string, sep_char: int) {
        this.rest = rest;
        this.sep = sep;
        this.sep_char = sep_char;
        this.done = (sep_char < 0) && sep.length == 0;
        this._current = rest.slice(0, 0);
        if this.done {
            this._current = rest;
        }
    }

    /// Advances to the next piece; `false` once every piece has been produced.
    public fun move_next(): bool {
        if this.done {
            return false;
        }
        let r = this.rest;
        let at = 0;
        let width = 1;
        if this.sep_char >= 0 {
            at = r.index_of((char)this.sep_char).unwrap_or(-1);
        } else {
            at = r.index_of(this.sep).unwrap_or(-1);
            width = this.sep.length;
        }
        if at < 0 {
            this._current = r;
            this.done = true;
            this.rest = r.slice(r._length);
            return true;
        }
        this._current = r.slice(0, at);
        this.rest = r.slice(at + width);
        return true;
    }

    /// The piece produced by the last `move_next()`.
    public get current(): ReadOnlySpan<char> {
        return this._current;
    }
}
