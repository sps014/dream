module system.core;

// Storage for weak locals. Captures share the handle without retaining its target.
internal class Weak<T: class> {
    /// Registered slot-box pointer (raw; owned by the weak registry).
    slot: usize;

    /// Creates a `Weak` with `target_obj`.
    public constructor(target_obj: Option<T>) {
        this.slot = 0;
        switch (target_obj) {
            Some(target) => {
                this.slot = Weak.bind(target);
            },
            None => {},
        }
    }

    /// True once the tracked object has been freed.
    public fun is_dead(): bool {
        return Weak<T>.dead(this.slot);
    }

    /// Atomically obtains an owning reference, or None if destruction won the race.
    public fun get(): Option<T> {
        return Weak<T>.load(this.slot);
    }

    /// Removes the registration early (optional — happens automatically when either side dies).
    public fun release(): void {
        let slot = this.slot;
        this.slot = 0;
        Weak<T>.release_raw(slot);
    }

    del() {
        this.release();
    }

    @runtime("weakBind")
    static extern fun bind(borrow target_obj: T): usize;

    @runtime("weakDead")
    static extern fun dead(slot: usize): bool;

    @runtime("weakLoad")
    static extern fun load(slot: usize): Option<T>;

    @runtime("weakReleaseRaw")
    static extern fun release_raw(slot: usize): void;
}
