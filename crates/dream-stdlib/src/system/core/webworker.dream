module system.core;

// Real OS-parallel workers with a shared heap.
//
// `await WebWorker.spawn(() => n * n)` starts a body on its own OS thread (native c)
// or Web Worker (browser/Node). There is no spawn message and no `join()`: `spawn` is `async`
// and *is* the wait. Overlap work by saving the Future and awaiting later.
//
// Captures must be `shared` (blittable, `string`, a struct of those, or `@shared class`).
// Ordinary classes / arrays / `List` are a compile error.
//
//   async fun main(): void {
//       let square = await WebWorker.spawn(() => 6 * 6);
//       System.println(square.to_string());
//   }
public class WebWorker {
    @js("Dream", "workerSpawn")
    static extern fun spawn_host(funcidx: int, env: long): int;

    @intrinsic("funcbox_funcidx")
    static extern fun funcidx(body: fun(string): string): int;

    @intrinsic("funcbox_funcidx")
    static extern fun funcidx_async(body: fun(string): Future<string>): int;

    @intrinsic("funcbox_env")
    static extern fun env(body: fun(string): string): long;

    @intrinsic("funcbox_env")
    static extern fun env_async(body: fun(string): Future<string>): long;

    @js("Dream", "workerPost")
    static extern fun post_host(id: int, borrow msg: string): void;

    @js("Dream", "workerRecv")
    static extern async fun recv_host(id: int): string;

    @js("Dream", "workerTerminate")
    static extern fun terminate_host(id: int): void;

    public static async fun spawn<TOut : shared>(body: fun(): TOut): TOut {
        let wrapped: fun(string): string = (_raw: string) => Bytes.toWire<TOut>(body());
        let id = WebWorker.spawn_host(WebWorker.funcidx(wrapped), WebWorker.env(wrapped));
        let session = WorkerSession(id, wrapped);
        WebWorker.post_host(id, "");
        let result = Bytes.fromWire<TOut>(await WebWorker.recv_host(id));
        let _ = session;
        return result;
    }

    public static async fun spawn_async<TOut : shared>(body: fun(): Future<TOut>): TOut {
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            return Bytes.toWire<TOut>(await body());
        };
        let id = WebWorker.spawn_host(WebWorker.funcidx_async(wrapped), WebWorker.env_async(wrapped));
        let session = WorkerSession(id, wrapped);
        WebWorker.post_host(id, "");
        let result = Bytes.fromWire<TOut>(await WebWorker.recv_host(id));
        let _ = session;
        return result;
    }

    static async fun spawn_mapped<T : shared, TOut : shared>(
        input: T,
        body: fun(T): TOut
    ): TOut {
        let wrapped: fun(string): string = (raw: string) => Bytes.toWire<TOut>(body(Bytes.fromWire<T>(raw)));
        let id = WebWorker.spawn_host(WebWorker.funcidx(wrapped), WebWorker.env(wrapped));
        let session = WorkerSession(id, wrapped);
        WebWorker.post_host(id, Bytes.toWire<T>(input));
        let result = Bytes.fromWire<TOut>(await WebWorker.recv_host(id));
        let _ = session;
        return result;
    }

    static async fun spawn_mapped_async<T : shared, TOut : shared>(
        input: T,
        body: fun(T): Future<TOut>
    ): TOut {
        let wrapped: fun(string): Future<string> = async (raw: string) => {
            return Bytes.toWire<TOut>(await body(Bytes.fromWire<T>(raw)));
        };
        let id = WebWorker.spawn_host(WebWorker.funcidx_async(wrapped), WebWorker.env_async(wrapped));
        let session = WorkerSession(id, wrapped);
        WebWorker.post_host(id, Bytes.toWire<T>(input));
        let result = Bytes.fromWire<TOut>(await WebWorker.recv_host(id));
        let _ = session;
        return result;
    }

    public static async fun map<T : shared, TOut : shared>(borrow items: T[], body: fun(T): TOut): TOut[] {
        let n = items.length;
        let futures = Buffer.alloc<Future<TOut>>(n);
        for (let i = 0; i < n; i = i + 1) {
            futures[i] = WebWorker.spawn_mapped(items[i], body);
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            results[i] = await futures[i];
        }
        return results;
    }

    public static async fun map_async<T : shared, TOut : shared>(borrow items: T[], body: fun(T): Future<TOut>): TOut[] {
        let n = items.length;
        let futures = Buffer.alloc<Future<TOut>>(n);
        for (let i = 0; i < n; i = i + 1) {
            futures[i] = WebWorker.spawn_mapped_async(items[i], body);
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            results[i] = await futures[i];
        }
        return results;
    }
}

// Owns the spawn-time funcbox and terminates the worker when dropped (await done or Future cancel).
class WorkerSession {
    id: int;
    sync_body: fun(string): string;
    async_body: fun(string): Future<string>;

    public constructor(id: int, sync_body: fun(string): string) {
        this.id = id;
        this.sync_body = sync_body;
    }

    public constructor(id: int, async_body: fun(string): Future<string>) {
        this.id = id;
        this.async_body = async_body;
    }

    del() {
        WebWorker.terminate_host(this.id);
    }
}
