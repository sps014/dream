module system.core;

// Real OS-parallel workers with a shared heap — thread-like spawn / join.
//
// `WebWorker<TIn, TOut>.spawn(input, body)` starts a body on its own OS thread (native wasmtime)
// or Web Worker (browser/Node); `await join()` waits for the single result. Each worker
// instantiates its OWN copy of the module (private globals/shadow stack), but every instance of
// the same program shares the same linear memory — `@shared class` objects, `Lock`/`Semaphore`,
// and `CancellationSource`/`CancellationToken` are visible across workers.
//
// Capturing lambdas may only close over `@shared class` instances or unmanaged/value locals —
// ordinary managed refs are a compile error (not in worker-shared memory). `TIn`/`TOut` must be
// `string`, unmanaged, or a `T[]` of one (`Bytes.toWire`/`fromWire`).
//
//   async fun main(): void {
//       let w = WebWorker<int, int>.spawn(6, (n) => n * n);
//       System.println((await w.join()).to_string()); // 36
//   }
public class WebWorker<TIn, TOut> {
    // Opaque host handle identifying this worker's thread/instance.
    id: int;

    @js("Dream", "workerSpawn")
    static extern fun spawn_host(funcidx: int, env: int): int;

    @intrinsic("funcbox_funcidx")
    static extern fun funcidx(body: fun(string): string): int;

    @intrinsic("funcbox_funcidx")
    static extern fun funcidx_async(body: fun(string): Future<string>): int;

    @intrinsic("funcbox_env")
    static extern fun env(body: fun(string): string): int;

    @intrinsic("funcbox_env")
    static extern fun env_async(body: fun(string): Future<string>): int;

    @js("Dream", "workerPost")
    static extern fun post_host(id: int, msg: string): void;

    @js("Dream", "workerRecv")
    static extern async fun recv_host(id: int): string;

    @js("Dream", "workerTerminate")
    static extern fun terminate_host(id: int): void;

    // Internal: host id only. Prefer `spawn`.
    constructor(id: int) {
        this.id = id;
    }

    // Start `body(input)` on a new thread immediately; `input` is wire-copied.
    public static fun spawn(input: TIn, body: fun(TIn): TOut): WebWorker<TIn, TOut> {
        let wrapped: fun(string): string = (raw: string) => Bytes.toWire<TOut>(body(Bytes.fromWire<TIn>(raw)));
        let id = WebWorker<TIn, TOut>.spawn_host(WebWorker<TIn, TOut>.funcidx(wrapped), WebWorker<TIn, TOut>.env(wrapped));
        WebWorker<TIn, TOut>.post_host(id, Bytes.toWire<TIn>(input));
        return WebWorker<TIn, TOut>(id);
    }

    public static fun spawn(input: TIn, body: fun(TIn): Future<TOut>): WebWorker<TIn, TOut> {
        let wrapped: fun(string): Future<string> = async (raw: string) => {
            return Bytes.toWire<TOut>(await body(Bytes.fromWire<TIn>(raw)));
        };
        let id = WebWorker<TIn, TOut>.spawn_host(WebWorker<TIn, TOut>.funcidx_async(wrapped), WebWorker<TIn, TOut>.env_async(wrapped));
        WebWorker<TIn, TOut>.post_host(id, Bytes.toWire<TIn>(input));
        return WebWorker<TIn, TOut>(id);
    }

    // Capture-only entry: no wire argument. `TIn` is unused at the call site (pass any dummy type
    // args, e.g. `WebWorker<string, int>.spawn(() => …)`).
    public static fun spawn(body: fun(): TOut): WebWorker<TIn, TOut> {
        let wrapped: fun(string): string = (_raw: string) => Bytes.toWire<TOut>(body());
        let id = WebWorker<TIn, TOut>.spawn_host(WebWorker<TIn, TOut>.funcidx(wrapped), WebWorker<TIn, TOut>.env(wrapped));
        WebWorker<TIn, TOut>.post_host(id, "");
        return WebWorker<TIn, TOut>(id);
    }

    public static fun spawn(body: fun(): Future<TOut>): WebWorker<TIn, TOut> {
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            return Bytes.toWire<TOut>(await body());
        };
        let id = WebWorker<TIn, TOut>.spawn_host(WebWorker<TIn, TOut>.funcidx_async(wrapped), WebWorker<TIn, TOut>.env_async(wrapped));
        WebWorker<TIn, TOut>.post_host(id, "");
        return WebWorker<TIn, TOut>(id);
    }

    // Await the body's single result. After hard `terminate()`, the pending join settles.
    public async fun join(): TOut {
        return Bytes.fromWire<TOut>(await WebWorker<TIn, TOut>.recv_host(this.id));
    }

    // Hard-abort the worker thread. Idempotent. Does not run Dream finally / orderly ARC unwind.
    public fun terminate(): void {
        WebWorker<TIn, TOut>.terminate_host(this.id);
    }

    del() {
        WebWorker<TIn, TOut>.terminate_host(this.id);
    }

    // Fan `body` over `items` (one worker per element, spawn-then-join); results in input order.
    public static async fun map(items: TIn[], body: fun(TIn): TOut): TOut[] {
        let n = items.length;
        let workers = Buffer.alloc<WebWorker<TIn, TOut>>(n);
        for (let i = 0; i < n; i = i + 1) {
            workers[i] = WebWorker<TIn, TOut>.spawn(items[i], body);
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            results[i] = await workers[i].join();
            workers[i].terminate();
        }
        return results;
    }

    public static async fun map(items: TIn[], body: fun(TIn): Future<TOut>): TOut[] {
        let n = items.length;
        let workers = Buffer.alloc<WebWorker<TIn, TOut>>(n);
        for (let i = 0; i < n; i = i + 1) {
            workers[i] = WebWorker<TIn, TOut>.spawn(items[i], body);
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            results[i] = await workers[i].join();
            workers[i].terminate();
        }
        return results;
    }
}
