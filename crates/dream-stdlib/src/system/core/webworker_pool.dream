module system.core;

// Fixed-size pool of `WebWorker` threads with round-robin `dispatch`.
public class WebWorkerPool {
    ids: int[];
    next: int;

    public constructor(size: int) {
        this.ids = Buffer.alloc<int>(size);
        for (let i = 0; i < size; i = i + 1) {
            this.ids[i] = WebWorkerPool.spawn_host();
        }
        this.next = 0;
    }

    // Run `body` on the next pool member. Capture rules match `WebWorker.spawn`.
    public async fun dispatch<TOut : shared>(body: fun(): TOut): TOut {
        let wrapped: fun(string): string = (_raw: string) => Bytes.toWire<TOut>(body());
        let id = this.ids[this.next];
        this.next = (this.next + 1) % this.ids.length;
        let funcidx = WebWorker.funcidx(wrapped);
        let env = WebWorker.env(wrapped);
        let wire = await WebWorkerPool.dispatch_host(id, funcidx, env, "");
        return Bytes.fromWire<TOut>(wire);
    }

    public async fun dispatch_async<TOut : shared>(body: fun(): Future<TOut>): TOut {
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            return Bytes.toWire<TOut>(await body());
        };
        let id = this.ids[this.next];
        this.next = (this.next + 1) % this.ids.length;
        let funcidx = WebWorker.funcidx_async(wrapped);
        let env = WebWorker.env_async(wrapped);
        let wire = await WebWorkerPool.dispatch_host(id, funcidx, env, "");
        return Bytes.fromWire<TOut>(wire);
    }

    public fun shutdown(): void {
        for (let i = 0; i < this.ids.length; i = i + 1) {
            WebWorker.terminate_host(this.ids[i]);
        }
    }

    del() {
        this.shutdown();
    }

    @runtime("workerPoolSpawn")
    static extern fun spawn_host(): int;

    @runtime("workerPoolDispatch")
    static extern async fun dispatch_host(id: int, funcidx: int, env: long, borrow msg: string): string;
}
