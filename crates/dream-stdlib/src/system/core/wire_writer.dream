module system.core;

/// Builds a little-endian record for a native host: fixed-width integers and strings as a
/// 32-bit UTF-8 byte length followed by the bytes.
internal class WireWriter {
    bytes: byte[];
    count: int;

    /// Creates an empty record with room for `capacity` bytes before it grows.
    internal constructor(capacity: int) {
        this.bytes = Buffer.alloc<byte>(capacity < 16 ? 16 : capacity);
        this.count = 0;
    }

    fun ensure(extra: int): void {
        let needed = this.count + extra;
        if needed <= this.bytes.length {
            return;
        }
        let capacity = this.bytes.length * 2;
        if capacity < needed {
            capacity = needed;
        }
        let grown = Buffer.alloc<byte>(capacity);
        Buffer.elems_copy<byte>(grown, 0, this.bytes, 0, this.count);
        this.bytes = grown;
    }

    fun put(at: int, value: int): void {
        this.bytes[at] = (byte)(value & 255);
    }

    /// Appends the low 8 bits of `value`.
    internal fun u8(value: int): void {
        this.ensure(1);
        this.put(this.count, value);
        this.count = this.count + 1;
    }

    /// Appends `value` as four bytes.
    internal fun i32(value: int): void {
        this.ensure(4);
        this.put(this.count, value);
        this.put(this.count + 1, value >> 8);
        this.put(this.count + 2, value >> 16);
        this.put(this.count + 3, value >> 24);
        this.count = this.count + 4;
    }

    /// Appends `value` as eight bytes.
    internal fun i64(value: long): void {
        this.i32((int)(value & 4294967295L));
        this.i32((int)(value >> 32));
    }

    /// Appends `value` as a 32-bit byte length and its UTF-8 bytes. Unpaired surrogates
    /// become U+FFFD.
    internal fun text(borrow value: string): void {
        let start = this.count;
        this.i32(0);
        this.ensure(value.length * 3);
        let w = this.count;
        let n = value.length;
        let i = 0;
        while i < n {
            let cp = (int)value.char_at(i);
            i = i + 1;
            if cp >= 55296 && cp <= 57343 {
                let paired = cp <= 56319
                    && i < n && (int)value.char_at(i) >= 56320 && (int)value.char_at(i) <= 57343;
                if paired {
                    cp = 65536 + ((cp - 55296) << 10) + ((int)value.char_at(i) - 56320);
                    i = i + 1;
                } else {
                    cp = 65533;
                }
            }
            if cp < 128 {
                this.put(w, cp);
                w = w + 1;
            } else if cp < 2048 {
                this.put(w, 192 | (cp >> 6));
                this.put(w + 1, 128 | (cp & 63));
                w = w + 2;
            } else if cp < 65536 {
                this.put(w, 224 | (cp >> 12));
                this.put(w + 1, 128 | ((cp >> 6) & 63));
                this.put(w + 2, 128 | (cp & 63));
                w = w + 3;
            } else {
                this.put(w, 240 | (cp >> 18));
                this.put(w + 1, 128 | ((cp >> 12) & 63));
                this.put(w + 2, 128 | ((cp >> 6) & 63));
                this.put(w + 3, 128 | (cp & 63));
                w = w + 4;
            }
        }
        let length = w - this.count;
        this.count = w;
        this.put(start, length);
        this.put(start + 1, length >> 8);
        this.put(start + 2, length >> 16);
        this.put(start + 3, length >> 24);
    }

    /// The finished record.
    internal fun finish(): byte[] {
        return this.bytes.slice(0, this.count);
    }
}
