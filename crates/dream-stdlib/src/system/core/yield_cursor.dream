module system.core;

/// A synchronous cursor over values from a yielding producer.
@allow_cycle
public class YieldCursor<T>: Iterator<T> {
    channel: YieldChannel<T>;
    producer: Option<Future<void>>;
    started: bool;

    /// Creates a `YieldCursor` with `channel`, `producer`.
    public constructor(channel: YieldChannel<T>, producer: Future<void>) {
        this.channel = channel;
        this.producer = Option.Some(producer);
        this.started = false;
    }

    /// Returns the next value, or `None` when the sequence has ended.
    public fun next(): Option<T> {
        if this.channel.ended {
            return Option.None;
        }
        if this.started {
            this.channel.advance();
        }
        this.started = true;
        YieldSignals.run(this.producer.unwrap(), this.channel.ready);
        return this.channel.value;
    }

    /// Ends iteration and releases resources held by the cursor.
    public fun close(): void {
        this.channel.finish();
        if this.producer.is_some() {
            Promise.cancel(this.producer.unwrap());
        }
        YieldSignals.complete(this.channel.resume);
        this.producer = Option.None;
        this.channel.value = Option.None;
    }

    fun del() {
        this.close();
    }
}
