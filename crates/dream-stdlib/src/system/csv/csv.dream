module system.csv;

// CSV syntax, encoding, size-limit, or underlying I/O failure with byte-oriented provenance.
public class CsvError : Error {
    // One-based logical record number associated with the error.
    public record: long;
    // Zero-based absolute byte offset reached before the failure.
    public offset: long;
    detail: string;
    // Creates a CSV diagnostic; offsets count bytes rather than UTF-16 code units.
    public constructor(record: long, offset: long, message: string) { this.record = record; this.offset = offset; this.detail = message; }
    // Stable CSV failure code.
    public fun code(): string { return "ECSV"; }
    // Human-readable syntax, limit, adapter, or I/O failure.
    public fun message(): string { return this.detail; }
}

internal static class CsvCodec {
    @runtime("dataCodec")
    internal static extern fun request_host(request: string): string;
    internal static fun request(value: JsonValue): Result<JsonValue, CsvError> {
        let parsed = Json.deserialize<JsonValue>(CsvCodec.request_host(Json.serialize(value)));
        if parsed.is_err() { return Result.Err(CsvError(0L, 0L, "invalid codec response")); }
        let result = parsed.unwrap();
        if result.get("error").is_some() { return Result.Err(CsvError(0L, 0L, result.at("error").as_string().unwrap_or("CSV codec failed"))); }
        return Result.Ok(result);
    }
    internal static fun valid(delimiter: char): bool { return delimiter > (char)0 && delimiter < (char)128 && delimiter != '"' && delimiter != '\r' && delimiter != '\n'; }
}

// Bounded-memory CSV reader over a borrowed byte stream, with strict quoting and UTF-8 validation.
@allow_cycle
public class CsvReader {
    source: Reader;
    delimiter: char;
    limit: int;
    buffer: byte[];
    position: int;
    offset: long;
    record: long;
    skip_lf: bool;
    failed: bool;
    // Borrows source; record limits count encoded bytes including embedded newlines.
    public constructor(source: Reader, delimiter: char = ',', max_record_bytes: int = 1048576) {
        this.source = source; this.delimiter = delimiter; this.limit = max_record_bytes;
        this.buffer = []; this.position = 0; this.offset = 0L; this.record = 1L; this.skip_lf = false; this.failed = false;
    }
    fun next_byte(): Result<Option<byte>, CsvError> {
        if this.position == this.buffer.length {
            let next = this.source.read(8192);
            if next.is_err() { return Result.Err(CsvError(this.record, this.offset, next.unwrap_err().message())); }
            this.buffer = next.unwrap(); this.position = 0;
            if this.buffer.length > 8192 { return Result.Err(CsvError(this.record, this.offset, "reader exceeded requested byte count")); }
            if this.buffer.length == 0 { let none: Option<byte> = Option.None; return Result.Ok(none); }
        }
        let value = this.buffer[this.position]; this.position = this.position + 1; this.offset = this.offset + 1L;
        return Result.Ok(Option.Some(value));
    }
    fun invalid(message: string): CsvError { this.failed = true; return CsvError(this.record, this.offset, message); }
    // Returns a record or None at EOF; malformed input permanently fails this reader.
    public fun read_record(): Result<Option<string[]>, CsvError> {
        if this.failed { return Result.Err(CsvError(this.record, this.offset, "CSV reader is failed")); }
        if !CsvCodec.valid(this.delimiter) || this.limit <= 0 || this.limit > 4194304 { return Result.Err(this.invalid("invalid delimiter or record limit (maximum 4 MiB)")); }
        let bytes = List<byte>();
        let state = 0;
        let ended = false;
        while !ended {
            let next = this.next_byte();
            if next.is_err() { this.failed = true; return Result.Err(next.unwrap_err()); }
            if next.unwrap().is_none() {
                if state == 2 { return Result.Err(this.invalid("unterminated quoted field")); }
                if bytes.length == 0 { let none: Option<string[]> = Option.None; return Result.Ok(none); }
                break;
            }
            let value = next.unwrap().unwrap();
            if this.skip_lf { this.skip_lf = false; if value == (byte)10 { continue; } }
            if state != 2 && (value == (byte)10 || value == (byte)13) {
                this.skip_lf = value == (byte)13; ended = true; break;
            }
            if bytes.length >= this.limit { return Result.Err(this.invalid("record exceeds configured byte limit")); }
            bytes.push(value);
            if state == 0 {
                if value == (byte)34 { state = 2; }
                else if value != (byte)this.delimiter { state = 1; }
            } else if state == 1 {
                if value == (byte)34 { return Result.Err(this.invalid("quote in an unquoted field")); }
                if value == (byte)this.delimiter { state = 0; }
            } else if state == 2 {
                if value == (byte)34 { state = 3; }
            } else {
                if value == (byte)34 { state = 2; }
                else if value == (byte)this.delimiter { state = 0; }
                else { return Result.Err(this.invalid("unexpected byte after a closing quote")); }
            }
        }
        let decoder = Utf8Decoder(InvalidEncoding.Strict);
        let decoded = decoder.decode_chunk(bytes.take_array());
        if decoded.is_err() { return Result.Err(this.invalid("invalid UTF-8")); }
        let trailing = decoder.finish();
        if trailing.is_err() { return Result.Err(this.invalid("truncated UTF-8")); }
        let text = decoded.unwrap() + trailing.unwrap();
        if text.length == 0 { this.record = this.record + 1L; let fields: string[] = [""]; return Result.Ok(Option.Some(fields)); }
        let request = JsonValue.dict(); request.set("action", JsonValue.from_string("csv_read"));
        request.set("delimiter", JsonValue.number((double)(int)this.delimiter)); request.set("input", JsonValue.from_string(text));
        let parsed = CsvCodec.request(request);
        if parsed.is_err() { return Result.Err(this.invalid(parsed.unwrap_err().message())); }
        let values = parsed.unwrap().at("fields");
        let fields = Buffer.alloc<string>(values.length);
        for (let i = 0; i < values.length; i = i + 1) { fields[i] = values.at(i).unwrap().as_string().unwrap(); }
        this.record = this.record + 1L;
        return Result.Ok(Option.Some(fields));
    }
}

// CSV writer over a borrowed byte stream; records use CRLF and standard doubled-quote escaping.
@allow_cycle
public class CsvWriter {
    destination: Writer;
    delimiter: char;
    limit: int;
    // Borrows destination; callers retain responsibility for closure and explicit flushing.
    public constructor(destination: Writer, delimiter: char = ',', max_record_bytes: int = 1048576) { this.destination = destination; this.delimiter = delimiter; this.limit = max_record_bytes; }
    // Writes exactly one record, retrying partial writes and reporting quoting/size/I/O failures.
    public fun write_record(fields: string[]): Result<bool, CsvError> {
        if !CsvCodec.valid(this.delimiter) || this.limit <= 0 || this.limit > 4194304 { return Result.Err(CsvError(0L, 0L, "invalid delimiter or record limit")); }
        let request = JsonValue.dict(); request.set("action", JsonValue.from_string("csv_write")); request.set("delimiter", JsonValue.number((double)(int)this.delimiter));
        let values = JsonValue.array();
        let size = 0;
        for (let field in fields) {
            let bytes = Encoding.utf8_encode(field);
            if bytes.length > this.limit - size { return Result.Err(CsvError(0L, 0L, "record exceeds configured byte limit")); }
            size = size + bytes.length; values.push(JsonValue.from_string(field));
        }
        request.set("fields", values);
        let encoded = CsvCodec.request(request)?;
        let bytes = Encoding.utf8_encode(encoded.at("text").as_string().unwrap());
        if bytes.length > this.limit { return Result.Err(CsvError(0L, 0L, "encoded record exceeds configured byte limit")); }
        let written = this.destination.write_all(bytes);
        if written.is_err() { return Result.Err(CsvError(0L, 0L, written.unwrap_err().message())); }
        return Result.Ok(true);
    }
    // Flushes the borrowed destination and reports underlying failures.
    public fun flush(): Result<bool, CsvError> {
        let result = this.destination.flush();
        if result.is_err() { return Result.Err(CsvError(0L, 0L, result.unwrap_err().message())); }
        return Result.Ok(true);
    }
}
