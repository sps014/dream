module system.csv;

internal static class CsvCodec {
    @runtime("dataCodec")
    internal static extern fun request_host(request: string): string;

    internal static fun request(value: JsonValue): Result<JsonValue, CsvError> {
        let parsed = Json.deserialize<JsonValue>(CsvCodec.request_host(Json.serialize(value)));
        if parsed.is_err() {
            return Result.Err(CsvError(0L, 0L, "invalid codec response"));
        }
        let result = parsed.unwrap();
        if result["error"].is_some() {
            return Result.Err(
                CsvError(0L, 0L, result.at("error").as_string().unwrap_or("CSV codec failed"))
            );
        }
        return Result.Ok(result);
    }

    internal static fun valid(delimiter: char): bool {
        return delimiter >(char)0
            && delimiter < (char)128 && delimiter != '"' && delimiter != '\r' && delimiter != '\n';
    }
}
