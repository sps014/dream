module system.csv;

// Bounded-memory CSV reader over a borrowed byte stream, with strict quoting and UTF-8 validation.
@allow_cycle
public class CsvReader {
    source: Reader;
    delimiter: char;
    limit: int;
    buffer: byte[];
    position: int;
    offset: long;
    record: long;
    skip_lf: bool;
    failed: bool;

    // Borrows source; record limits count encoded bytes including embedded newlines.
    public constructor(source: Reader, delimiter: char = ',', max_record_bytes: int = 1048576) {
        this.source = source;
        this.delimiter = delimiter;
        this.limit = max_record_bytes;
        this.buffer = [];
        this.position = 0;
        this.offset = 0L;
        this.record = 1L;
        this.skip_lf = false;
        this.failed = false;
    }

    fun next_byte(): Result<Option<byte>, CsvError> {
        if this.position == this.buffer.length {
            let next = this.source.read(8192);
            if next.is_err() {
                return Result.Err(CsvError(this.record, this.offset, next.unwrap_err().message()));
            }
            this.buffer = next.unwrap();
            this.position = 0;
            if this.buffer.length > 8192 {
                return Result.Err(
                    CsvError(this.record, this.offset, "reader exceeded requested byte count")
                );
            }
            if this.buffer.length == 0 {
                let none: Option<byte> = Option.None;
                return Result.Ok(none);
            }
        }
        let value = this.buffer[this.position];
        this.position = this.position + 1;
        this.offset = this.offset + 1L;
        return Result.Ok(Option.Some(value));
    }

    fun invalid(message: string): CsvError {
        this.failed = true;
        return CsvError(this.record, this.offset, message);
    }

    // Returns a record or None at EOF; malformed input permanently fails this reader.
    public fun read_record(): Result<Option<string[]>, CsvError> {
        if this.failed {
            return Result.Err(CsvError(this.record, this.offset, "CSV reader is failed"));
        }
        if !CsvCodec.valid(this.delimiter) || this.limit <= 0 || this.limit > 4194304 {
            return Result.Err(this.invalid("invalid delimiter or record limit (maximum 4 MiB)"));
        }
        let bytes = List<byte>();
        let state = 0;
        let ended = false;
        while !ended {
            let next = this.next_byte();
            if next.is_err() {
                this.failed = true;
                return Result.Err(next.unwrap_err());
            }
            if next.unwrap().is_none() {
                if state == 2 {
                    return Result.Err(this.invalid("unterminated quoted field"));
                }
                if bytes.length == 0 {
                    let none: Option<string[]> = Option.None;
                    return Result.Ok(none);
                }
                break;
            }
            let value = next.unwrap().unwrap();
            if this.skip_lf {
                this.skip_lf = false;
                if value == (byte)10 {
                    continue;
                }
            }
            if state != 2 && (value == (byte)10 || value == (byte)13) {
                this.skip_lf = value == (byte)13;
                ended = true;
                break;
            }
            if bytes.length >= this.limit {
                return Result.Err(this.invalid("record exceeds configured byte limit"));
            }
            bytes.push(value);
            if state == 0 {
                if value == (byte)34 {
                    state = 2;
                } else if value != (byte)this.delimiter {
                    state = 1;
                }
            } else if state == 1 {
                if value == (byte)34 {
                    return Result.Err(this.invalid("quote in an unquoted field"));
                }
                if value == (byte)this.delimiter {
                    state = 0;
                }
            } else if state == 2 {
                if value == (byte)34 {
                    state = 3;
                }
            } else {
                if value == (byte)34 {
                    state = 2;
                } else if value == (byte)this.delimiter {
                    state = 0;
                } else {
                    return Result.Err(this.invalid("unexpected byte after a closing quote"));
                }
            }
        }
        let decoder = Utf8Decoder(InvalidEncoding.Strict);
        let decoded = decoder.decode_chunk(bytes.take_array());
        if decoded.is_err() {
            return Result.Err(this.invalid("invalid UTF-8"));
        }
        let trailing = decoder.finish();
        if trailing.is_err() {
            return Result.Err(this.invalid("truncated UTF-8"));
        }
        let text = decoded.unwrap() + trailing.unwrap();
        if text.length == 0 {
            this.record = this.record + 1L;
            let fields: string[] = [""];
            return Result.Ok(Option.Some(fields));
        }
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("csv_read");
        request["delimiter"] = JsonValue.number((double)(int)this.delimiter);
        request["input"] = JsonValue.from_string(text);
        let parsed = CsvCodec.request(request);
        if parsed.is_err() {
            return Result.Err(this.invalid(parsed.unwrap_err().message()));
        }
        let values = parsed.unwrap().at("fields");
        let fields = Buffer.alloc<string>(values.length);
        for (let i = 0; i < values.length; i = i + 1) {
            fields[i] = values.at(i).unwrap().as_string().unwrap();
        }
        this.record = this.record + 1L;
        return Result.Ok(Option.Some(fields));
    }
}
