module system;

/// Allocator introspection for tests and diagnostics.
public static class Debug {
    /// Returns the allocator's free-list address for debugging.
    @intrinsic(Intrinsic.DebugGetFreeListHead)
    internal static extern fun host_free_list_head(): int;

    /// Returns the current heap address for debugging.
    @intrinsic(Intrinsic.DebugGetHeapPtr)
    internal static extern fun host_heap_ptr(): int;

    /// Returns the number of currently live managed allocations.
    @intrinsic(Intrinsic.DebugGetLiveObjects)
    internal static extern fun host_live_objects(): long;

    /// Returns the total number of managed allocations made so far.
    @intrinsic(Intrinsic.DebugGetTotalAllocations)
    internal static extern fun host_total_allocations(): long;

    /// Returns the current strong reference count of `o` for debugging.
    @intrinsic(Intrinsic.DebugGetRefCount)
    public static extern fun ref_count(borrow o: object): int;

    /// Opt-in attribution (DREAM_RUNTIME_COUNTERS=1); ids follow `dream_ownership.h`.
    /// Ordinary builds and unknown ids read as 0. Ids 11, 12 and 13 instead read the native
    /// heap's committed, live and free-listed bytes in every build by walking the heap, so
    /// each read costs time proportional to the heap size; WebAssembly builds read 0.
    @intrinsic(Intrinsic.DebugGetRuntimeCounter)
    public static extern fun runtime_counter(id: int): long;

    /// Memory-reuse probe that changes when the allocator frees storage. Release builds do not
    /// track frees and always read 0.
    public static get free_list_head(): int {
        return Debug.host_free_list_head();
    }

    /// Current heap address exposed for debugging.
    public static get heap_ptr(): int {
        return Debug.host_heap_ptr();
    }

    /// Number of currently live managed allocations. Only debug builds count allocations;
    /// release builds always read 0.
    public static get live_objects(): long {
        return Debug.host_live_objects();
    }

    /// Total number of managed allocations made so far. Only debug builds count allocations;
    /// release builds always read 0.
    public static get total_allocations(): long {
        return Debug.host_total_allocations();
    }
}
