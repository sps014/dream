module system;

// Allocator introspection for tests and diagnostics.
public class Debug {
    // Head pointer of the allocator's free list.
    @intrinsic("debug_get_free_list_head")
    static extern fun free_list_head(): int;

    // Current bump pointer of the heap.
    @intrinsic("debug_get_heap_ptr")
    static extern fun heap_ptr(): int;

    // Number of heap blocks currently alive.
    @intrinsic("debug_get_live_objects")
    static extern fun live_objects(): int;

    // Total number of allocations ever made.
    @intrinsic("debug_get_total_allocations")
    static extern fun total_allocations(): int;

    // Diagnostic no-op (kept so existing tests link). Heap is reclaimed by drop / `$free`.
    @intrinsic("gc_collect_full")
    static extern fun gc_collect(): void;
}
