module system;

// Allocator introspection for tests and diagnostics.
public static class Debug {
    @intrinsic("debug_get_free_list_head")
    static extern fun host_free_list_head(): int;

    @intrinsic("debug_get_heap_ptr")
    static extern fun host_heap_ptr(): int;

    @intrinsic("debug_get_live_objects")
    static extern fun host_live_objects(): int;

    @intrinsic("debug_get_total_allocations")
    static extern fun host_total_allocations(): int;

    @intrinsic("debug_get_ref_count")
    static extern fun ref_count(borrow o: object): int;

    public static get free_list_head(): int {
        return Debug.host_free_list_head();
    }

    public static get heap_ptr(): int {
        return Debug.host_heap_ptr();
    }

    public static get live_objects(): int {
        return Debug.host_live_objects();
    }

    public static get total_allocations(): int {
        return Debug.host_total_allocations();
    }
}
