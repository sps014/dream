module system.desktop;

// System clipboard. Reads return empty when the format is missing or unreadable; failed writes
// are logged to stderr.
public class Clipboard {
    @native
    @runtime("clipboardGet")
    static extern fun host_get(kind: int, borrow format: string): char[];

    @native
    @runtime("clipboardSet")
    static extern fun host_set(kind: int, borrow format: string, borrow data: byte[]): int;

    @native
    @runtime("clipboardHas")
    static extern fun host_has(borrow format: string): bool;

    @native
    @runtime("clipboardClear")
    static extern fun host_clear(): void;

    // `Some(bytes)` when the host returned the format (leading ASCII `1`), `None` otherwise.
    static fun read(kind: int, format: string): Option<byte[]> {
        let raw = DesktopWire.bytes(Clipboard.host_get(kind, format));
        if (raw.length == 0) || (raw[0] != (byte)49) {
            return Option.None;
        }
        let out = Buffer.alloc<byte>(raw.length - 1);
        let i = 1;
        while i < raw.length {
            out[i - 1] = raw[i];
            i = i + 1;
        }
        return Option.Some(out);
    }

    static fun read_text(kind: int): string {
        return switch (Clipboard.read(kind, "")) {
            Some(bytes) => Encoding.utf8_decode(bytes),
            None => "",
        };
    }

    @native
    public static get text(): string {
        return Clipboard.read_text(0);
    }

    @native
    public static set text(value: string) {
        Clipboard.host_set(0, "", Encoding.utf8_encode(value));
    }

    // Setting HTML also writes a plain-text copy for apps that can't paste HTML.
    @native
    public static get html(): string {
        return Clipboard.read_text(1);
    }

    @native
    public static set html(value: string) {
        Clipboard.host_set(1, "", Encoding.utf8_encode(value));
    }

    // PNG bytes in and out.
    @native
    public static get image(): byte[] {
        return Clipboard.read(2, "").unwrap_or(Buffer.alloc<byte>(0));
    }

    @native
    public static set image(png: byte[]) {
        Clipboard.host_set(2, "", png);
    }

    // Paths of files copied in Finder / Explorer / the file manager.
    @native
    public static get files(): List<string> {
        return DesktopWire.lines(Clipboard.read_text(3));
    }

    @native
    public static set files(paths: List<string>) {
        Clipboard.host_set(3, "", Encoding.utf8_encode(paths.join("\n")));
    }

    // Formats on the clipboard right now (MIME names or platform type identifiers).
    @native
    public static get formats(): List<string> {
        return DesktopWire.lines(Clipboard.read_text(5));
    }

    // Raw bytes under a custom format name, e.g. `application/x-myapp-track`.
    @native
    public static fun set_data(format: string, data: byte[]): void {
        Clipboard.host_set(4, format, data);
    }

    @native
    public static fun data(format: string): Option<byte[]> {
        return Clipboard.read(4, format);
    }

    @native
    public static fun has(format: string): bool {
        return Clipboard.host_has(format);
    }

    @native
    public static fun clear(): void {
        Clipboard.host_clear();
    }
}
