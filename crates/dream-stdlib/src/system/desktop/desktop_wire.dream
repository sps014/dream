module system.desktop;

// Decoding for `char[]` payloads returned by the native desktop host.
internal class DesktopWire {
    internal static fun bytes(raw: char[]): byte[] {
        let out = Buffer.alloc<byte>(raw.length);
        let i = 0;
        while i < raw.length {
            out[i] = (byte)raw[i];
            i = i + 1;
        }
        return out;
    }

    internal static fun text(raw: char[]): string {
        return Encoding.utf8_decode(DesktopWire.bytes(raw));
    }

    // Newline-separated entries; an empty payload is an empty list.
    internal static fun lines(text: string): List<string> {
        let out = List<string>();
        if text.is_empty() {
            return out;
        }
        let parts = text.split('\n');
        let i = 0;
        while i < parts.length {
            if !parts[i].is_empty() {
                out.push(parts[i]);
            }
            i = i + 1;
        }
        return out;
    }
}

// Starts a native dialog and polls it from the task scheduler, so timers, IPC and other tasks
// keep running while the dialog is open.
internal class DesktopDialogHost {
    @native
    @runtime("desktopDialogStart")
    static extern fun host_start(
        kind: int,
        borrow title: string,
        borrow text: string,
        borrow directory: string,
        borrow file_name: string,
        borrow filters: string,
        level: int,
        buttons: int,
        parent: int
    ): int;

    @native
    @runtime("desktopDialogPoll")
    static extern fun host_poll(handle: int): char[];

    // `Some(payload)` when the user confirmed, `None` when cancelled.
    @native
    internal static async fun run(
        kind: int,
        title: string,
        text: string,
        directory: string,
        file_name: string,
        filters: string,
        level: int,
        buttons: int,
        parent: int
    ): Option<string> {
        let handle = DesktopDialogHost.host_start(kind, title, text, directory, file_name, filters, level, buttons, parent);
        let raw = DesktopWire.text(DesktopDialogHost.host_poll(handle));
        while raw == "P" {
            Time.delay(8).await;
            raw = DesktopWire.text(DesktopDialogHost.host_poll(handle));
        }
        if raw.starts_with("O\n") {
            return Option.Some(raw.substring(2, raw.length));
        }
        return Option.None;
    }
}
