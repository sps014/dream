module system.desktop;

// One entry in a file dialog's type list, e.g. `Audio` -> `mp3`, `flac`.
public class FileFilter {
    public name: string;
    public extensions: List<string>;

    public constructor(name: string, extensions: List<string>) {
        this.name = name;
        this.extensions = extensions;
    }
}

// Native open / save / folder picker. Set properties, then await one of the `pick_*` /
// `save_file` calls; cancelling yields `None` or an empty list.
public class FileDialog {
    _title: string;
    _directory: string;
    _file_name: string;
    _parent: int;
    _filters: List<FileFilter>;

    public constructor() {
        this._title = "";
        this._directory = "";
        this._file_name = "";
        this._parent = 0 - 1;
        this._filters = List<FileFilter>();
    }

    public get title(): string {
        return this._title;
    }

    public set title(value: string) {
        this._title = value;
    }

    // Folder the dialog starts in.
    public get directory(): string {
        return this._directory;
    }

    public set directory(value: string) {
        this._directory = value;
    }

    // Suggested name for `save_file`.
    public get file_name(): string {
        return this._file_name;
    }

    public set file_name(value: string) {
        this._file_name = value;
    }

    // `WebView.window_id` of the window that owns the dialog (a sheet on macOS); `-1` for none.
    public get parent(): int {
        return this._parent;
    }

    public set parent(value: int) {
        this._parent = value;
    }

    public get filters(): List<FileFilter> {
        return this._filters;
    }

    // Extensions without the dot: `add_filter("Audio", ["mp3", "flac"])`.
    public fun add_filter(name: string, extensions: List<string>): void {
        this._filters.push(FileFilter(name, extensions));
    }

    fun encoded_filters(): string {
        let out = "";
        let i = 0;
        while i < this._filters.length {
            let f = this._filters.get(i);
            out = out + f.name + "\t" + f.extensions.join(",") + "\n";
            i = i + 1;
        }
        return out;
    }

    async fun show(kind: int): Option<string> {
        return DesktopDialogHost.run(
            kind,
            this._title,
            "",
            this._directory,
            this._file_name,
            this.encoded_filters(),
            0,
            0,
            this._parent
        ).await;
    }

    @native
    public async fun pick_file(): Option<string> {
        return this.show(0).await;
    }

    @native
    public async fun pick_files(): List<string> {
        return DesktopWire.lines(this.show(1).await.unwrap_or(""));
    }

    @native
    public async fun pick_folder(): Option<string> {
        return this.show(2).await;
    }

    @native
    public async fun pick_folders(): List<string> {
        return DesktopWire.lines(this.show(3).await.unwrap_or(""));
    }

    @native
    public async fun save_file(): Option<string> {
        return this.show(4).await;
    }
}
