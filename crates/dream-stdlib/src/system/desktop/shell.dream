module system.desktop;

public class Shell {
    @native
    @runtime("shellOpen")
    static extern fun host_open(borrow target: string): char[];

    // Opens a URL in the default browser, or a file / folder with its default app.
    @native
    public static fun open(target: string): Result<bool, DesktopError> {
        let message = DesktopWire.text(Shell.host_open(target));
        if !message.is_empty() {
            return Result.Err(DesktopError.failed(message));
        }
        return Result.Ok(true);
    }
}
