module system.drawing;

internal static class DrawingHost {
    @async_host
    @runtime("drawingCreate", "drawing")
    internal static extern async fun create(width: int, height: int, backend: int): int;

    @runtime("drawingLastError", "drawing")
    internal static extern fun error(): string;

    @runtime("drawingRender", "drawing")
    internal static extern fun render(
        handle: int,
        borrow commands: float[],
        borrow assets: int[],
        borrow text: string
    ): int;

    @async_host
    @runtime("drawingPixels", "drawing")
    internal static extern async fun pixels(handle: int): byte[];

    @runtime("drawingCopyGpu", "drawing")
    internal static extern fun copy_gpu(handle: int, texture: int, width: int, height: int): int;

    @runtime("drawingBackend", "drawing")
    internal static extern fun backend(handle: int): int;

    @runtime("drawingRelease", "drawing")
    internal static extern fun release(handle: int): void;

    @async_host
    @runtime("drawingImageDecode", "drawing")
    internal static extern async fun image_decode(borrow bytes: byte[]): int;

    @async_host
    @runtime("drawingImageRgba", "drawing")
    internal static extern async fun image_rgba(width: int, height: int, borrow bytes: byte[]): int;

    @async_host
    @runtime("drawingTextCreate", "drawing")
    internal static extern async fun text_create(
        borrow text: string,
        borrow family: string,
        size: float,
        weight: float,
        width: float,
        alignment: int
    ): int;

    @async_host
    @runtime("drawingFontRegister", "drawing")
    internal static extern async fun font_register(borrow bytes: byte[]): string;

    @runtime("drawingAssetMetrics", "drawing")
    internal static extern fun asset_metrics(handle: int): float[];

    @runtime("drawingTextMeasure", "drawing")
    internal static extern fun text_measure(
        borrow text: string,
        borrow family: string,
        size: float,
        weight: float,
        width: float,
        alignment: int
    ): float[];

    @runtime("drawingTextIndexAt", "drawing")
    internal static extern fun text_index_at(handle: int, x: float, y: float): int;

    @runtime("drawingTextCaret", "drawing")
    internal static extern fun text_caret(handle: int, index: int): float[];

    @runtime("drawingTextSelection", "drawing")
    internal static extern fun text_selection(handle: int, start: int, end: int): float[];

    @runtime("drawingAssetRelease", "drawing")
    internal static extern fun asset_release(handle: int): void;
}
