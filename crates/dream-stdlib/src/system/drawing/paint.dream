module system.drawing;

/// A reusable solid color or multi-stop gradient, captured when a draw is recorded.
public class Paint {
    internal values: List<float>;

    constructor() {
        this.values = List<float>();
    }

    /// Creates a solid paint.
    public static fun solid(color: Color): Paint {
        let paint = Paint();
        paint.values.push(0.0f);
        color.encode(paint.values);
        return paint;
    }

    /// Creates a linear gradient between the endpoints. Requires 2..256 sorted stops in 0..1; colors outside the stop range extend to the edges.
    public static fun linear(
        x0: float,
        y0: float,
        x1: float,
        y1: float,
        stops: GradientStop[]
    ): Paint {
        let paint = Paint();
        paint.values.push(1.0f);
        paint.values.push(x0);
        paint.values.push(y0);
        paint.values.push(x1);
        paint.values.push(y1);
        paint.stops(stops);
        return paint;
    }

    /// Creates a circular gradient from the center to a positive radius. Requires 2..256 sorted stops in 0..1.
    public static fun radial(x: float, y: float, radius: float, stops: GradientStop[]): Paint {
        let paint = Paint();
        paint.values.push(2);
        paint.values.push(x);
        paint.values.push(y);
        paint.values.push(radius);
        paint.stops(stops);
        return paint;
    }

    /// Creates a clockwise angular gradient about the center, from start_angle to a greater end_angle in radians. Requires 2..256 sorted stops in 0..1.
    public static fun sweep(
        x: float,
        y: float,
        start_angle: float,
        end_angle: float,
        stops: GradientStop[]
    ): Paint {
        let paint = Paint();
        paint.values.push(3);
        paint.values.push(x);
        paint.values.push(y);
        paint.values.push(start_angle);
        paint.values.push(end_angle);
        paint.stops(stops);
        return paint;
    }

    fun stops(stops: GradientStop[]): void {
        this.values.push((float)stops.length);
        for (let stop in stops) {
            this.values.push(stop.offset);
            stop.color.encode(this.values);
        }
    }

    internal fun encode(borrow output: List<float>): void {
        for (let value in this.values) {
            output.push(value);
        }
    }
}
