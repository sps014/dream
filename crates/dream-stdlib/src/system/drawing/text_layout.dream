module system.drawing;

/// Immutable shaped text for repeated labels and editable text. Layout metrics and glyph positions are shared between CPU and GPU rendering.
///
/// Text positions are UTF-16 code unit offsets, the same units as `string.length` and `char_at`. Offset 0 is before the first character and `text.length` is after the last.
public class TextLayout: DrawingResource {
    handle: int;
    metrics: TextMetrics;

    constructor(handle: int) {
        this.handle = handle;
        this.metrics = TextMetrics(DrawingHost.asset_metrics(handle));
    }

    /// Shapes and lays out text with the supplied style, capturing its font and paragraph settings. Color is supplied separately when drawing.
    public static async fun create(
        text: string,
        style: TextStyle
    ): Result<TextLayout, DrawingError> {
        let alignment: int = style.alignment;
        let handle = DrawingHost.text_create(
            text,
            style.family,
            style.size,
            style.weight,
            style.max_width,
            alignment
        ).await;
        if handle <= 0 {
            return Result.Err(DrawingError(DrawingHost.error()));
        }
        return Result.Ok(TextLayout(handle));
    }

    /// Measures text with the supplied style without keeping a layout. Results are cached with the same layouts that canvas text uses, so measuring and then drawing the same text shapes it once.
    ///
    /// Fails with `EINVAL` for invalid style values or text longer than 262144 bytes. In browsers and Node, the drawing engine loads in the background when the program starts; a call made before it is ready fails with `EUNAVAILABLE`, and awaiting any async drawing call, such as `TextLayout.create` or `DrawingSurface.create`, guarantees it is ready.
    public static fun measure(text: string, style: TextStyle): Result<TextMetrics, DrawingError> {
        let alignment: int = style.alignment;
        let values = DrawingHost.text_measure(
            text,
            style.family,
            style.size,
            style.weight,
            style.max_width,
            alignment
        );
        if values.length < 4 {
            return Result.Err(DrawingError(DrawingHost.error()));
        }
        return Result.Ok(TextMetrics(values));
    }

    /// Laid-out text width in canvas units.
    public get width(): float {
        return this.metrics.width;
    }

    /// Laid-out text height in canvas units.
    public get height(): float {
        return this.metrics.height;
    }

    /// Number of lines after wrapping and explicit newlines.
    public get line_count(): int {
        return this.metrics.line_count;
    }

    /// Distance from the top of the layout to the first line's baseline, in canvas units.
    public get baseline(): float {
        return this.metrics.baseline;
    }

    /// Returns the text position nearest to a point in layout coordinates, relative to the layout's top-left origin. Points above, below or beside the text resolve to the nearest line and line edge, so a click anywhere can place a caret.
    public fun index_at(x: float, y: float): int {
        return DrawingHost.text_index_at(this.handle, x, y);
    }

    /// Returns the caret rectangle before a text position: one canvas unit wide and as tall as its line. Positions past the end clamp to the end, and a position inside a surrogate pair moves to the start of that character.
    public fun caret(index: int): Rect {
        let values = DrawingHost.text_caret(this.handle, index);
        return Rect(values[0], values[1], values[2], values[3]);
    }

    /// Returns highlight rectangles covering the text between two positions, one per line fragment, in visual order. The positions may be given in either order; an empty range returns no rectangles.
    public fun selection(start: int, end: int): List<Rect> {
        let values = DrawingHost.text_selection(this.handle, start, end);
        let rects = List<Rect>();
        for (let i = 0; i + 3 < values.length; i = i + 4) {
            rects.push(Rect(values[i], values[i + 1], values[i + 2], values[i + 3]));
        }
        return rects;
    }

    internal get resource_handle(): int {
        return this.handle;
    }

    del() {
        DrawingHost.asset_release(this.handle);
    }
}
