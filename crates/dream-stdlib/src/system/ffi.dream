module system;

// An opaque C pointer (`void*`, `T*`). `@c` passes it by value; `ref p: CPtr` is a `T**` out-param
// and `Option<CPtr>` a nullable pointer.
public struct CPtr {
    raw: usize;

    public constructor(raw: usize) {
        this.raw = raw;
    }

    // The `NULL` pointer.
    public static fun null(): CPtr {
        return CPtr((usize)0);
    }

    // True when this is `NULL`.
    public fun is_null(): bool {
        return this.raw == (usize)0;
    }

    // The pointer as an integer address.
    public fun address(): usize {
        return this.raw;
    }

    // The pointer `bytes` bytes past this one.
    public fun offset(bytes: isize): CPtr {
        return CPtr(this.raw + (usize)bytes);
    }

    fun operator ==(other: CPtr): bool {
        return this.raw == other.raw;
    }
}

// A C pointer returned by an `@owned("free_fn")` `@c` extern: Dream owns it, and the destructor
// calls `free_fn(ptr)` unless `take()` handed ownership back first.
public class OwnedCPtr {
    ptr: CPtr;
    free: usize;

    @intrinsic("dream_ffi_free_with")
    static extern fun free_with(free: usize, ptr: usize): void;

    // The pointer, still owned (and later freed) by this object.
    public fun get(): CPtr {
        return this.ptr;
    }

    // Gives up ownership: the caller now frees the returned pointer, and this object holds `NULL`.
    public fun take(): CPtr {
        let p = this.ptr;
        this.ptr = CPtr.null();
        return p;
    }

    del() {
        OwnedCPtr.free_with(this.free, this.ptr.address());
    }
}

// A Dream `fun` (capturing or not) handed to a `@c` extern as a `(fn, void* user_data)` pair. C may
// call it for as long as this object is alive: keep it in a field while C holds the pointer.
// Calls from threads Dream did not start trap.
public class NativeCallback<F> {
    f: F;

    @intrinsic("dream_callback_register")
    static extern fun register(borrow callback: object): void;

    @intrinsic("dream_callback_unregister")
    static extern fun unregister(borrow callback: object): void;

    public constructor(f: F) {
        this.f = f;
        NativeCallback<F>.register(this);
    }

    del() {
        NativeCallback<F>.unregister(this);
    }
}

// Reads through C pointers from `@c` callbacks (`char**`, `char*`).
public static class Ffi {
    @intrinsic("dream_ffi_read_ptr")
    static extern fun host_read_ptr(base: usize, index: int): usize;

    @intrinsic("dream_ffi_read_cstring")
    static extern fun host_read_cstring(ptr: usize): string;

    @intrinsic("dream_ffi_read_i32")
    static extern fun host_read_i32(base: usize, index: int): int;

    @intrinsic("dream_ffi_read_i64")
    static extern fun host_read_i64(base: usize, index: int): long;

    @intrinsic("dream_ffi_read_f64")
    static extern fun host_read_f64(base: usize, index: int): double;

    // `((int32_t*)base)[index]`.
    public static fun read_int(base: CPtr, index: int): int {
        return Ffi.host_read_i32(base.address(), index);
    }

    // `((int64_t*)base)[index]`.
    public static fun read_long(base: CPtr, index: int): long {
        return Ffi.host_read_i64(base.address(), index);
    }

    // `((double*)base)[index]`.
    public static fun read_double(base: CPtr, index: int): double {
        return Ffi.host_read_f64(base.address(), index);
    }

    // `((void**)base)[index]`. A `NULL` base reads `NULL`.
    public static fun read_ptr(base: CPtr, index: int): CPtr {
        return CPtr(Ffi.host_read_ptr(base.address(), index));
    }

    // Copies the NUL-terminated UTF-8 C string at `ptr` into a Dream `string`; `None` for `NULL`.
    public static fun read_cstring(ptr: CPtr): Option<string> {
        if ptr.is_null() {
            return Option.None;
        }
        return Option.Some(Ffi.host_read_cstring(ptr.address()));
    }
}
