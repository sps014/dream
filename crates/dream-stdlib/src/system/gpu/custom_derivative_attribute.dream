module system.gpu;

/// Supplies a hand-written backward derivative for a `@differentiable` helper, replacing
/// the automatic one. Use it when the automatic derivative is slow or numerically unstable.
///
/// `function` names a inferred shader helper whose parameters are the original parameters as `ref`
/// `GpuDiffPair` values, followed by the derivative of the result. It writes each
/// parameter's derivative into its pair.
@attribute(AttributeTarget.Function)
public struct CustomDerivativeAttribute {
    /// The helper that computes the backward derivative.
    public function: DeclarationPath;
}
