module system.gpu;

/// Makes a inferred shader helper differentiable, so `GpuDiff.forward` and `GpuDiff.backward` can
/// compute its derivatives automatically.
///
/// Every function it calls must itself be differentiable: another `@differentiable` helper
/// or a differentiable built-in such as `GpuMath.sin`, `GpuMath.exp` or `GpuMath.max`.
/// Other calls are build errors at the call. Works on every target, including `WebGpu`.
@attribute(AttributeTarget.Function)
public struct DifferentiableAttribute {}
