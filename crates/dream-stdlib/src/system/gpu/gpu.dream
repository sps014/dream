    @runtime("gpuDispatchIndirect")
    static extern async fun dispatch_indirect(
        borrow kernel: string,
        borrow buffer_ids: int[],
        borrow texture_ids: int[],
        borrow sampler_ids: int[],
        indirect_id: int,
        indirect_offset: int
