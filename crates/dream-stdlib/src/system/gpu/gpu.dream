module system.gpu;

// Device lifecycle, host bridges, kernel barriers / atomics / texture builtins.
public static class Gpu {
    @runtime("gpuIsAvailable")
    static extern fun is_available_host(): bool;

    @runtime("gpuTryInit")
    static extern async fun try_init_host(): int;

    @runtime("gpuReady")
    static extern fun ready_host(): bool;

    @web @native
    @runtime("gpuCheck")
    static extern fun check_host(): int;

    @web @native
    @runtime("gpuCapabilities")
    static extern fun capabilities_host(): byte[];

    @runtime("gpuFrame")
    static extern async fun frame_host(): void;

    @runtime("gpuTimestamp")
    static extern async fun timestamp_host(): long;

    // True when a WebGPU/native GPU backend is present.
    public static get is_available(): bool {
        return Gpu.is_available_host();
    }

    // True after a successful `try_init`.
    public static get ready(): bool {
        return Gpu.ready_host();
    }

    // 0 when the device is alive. A non-zero code is a pending uncaptured error or a device-lost
    // event — pass it to `GpuError.from_code`. Call this after a submit if you need to know
    // before the next fallible API, and after a backgrounding pause on mobile.
    public static fun check(): Result<bool, GpuError> {
        let code = Gpu.check_host();
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "Gpu.check failed"));
    }

    // Optional features and limits the device was created with. Everything reads as unavailable
    // (`false` / `0`) until `try_init` succeeds, since capabilities are a property of the device
    // Dream negotiated, not of the raw adapter.
    public static fun capabilities(): GpuCapabilities {
        return GpuCapabilities.decode(Gpu.capabilities_host());
    }

    // Initializes the GPU device; returns `Err` with a host error code on failure.
    public static async fun try_init(token: Option<CancellationToken> = Option.None): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let code = await Gpu.try_init_host();
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "Gpu.try_init failed"));
    }

    // Yields until the next presentation/frame tick.
    public static async fun frame(token: Option<CancellationToken> = Option.None): void {
        CancellationToken.throw_if_opt(token);
        await Gpu.frame_host();
    }

    // High-resolution GPU timestamp in nanoseconds (host-defined epoch).
    public static async fun timestamp(token: Option<CancellationToken> = Option.None): long {
        CancellationToken.throw_if_opt(token);
        return await Gpu.timestamp_host();
    }

    @runtime("gpuBufferAllocBytes")
    static extern fun buffer_alloc_bytes(n: int): int;

    @runtime("gpuBufferWriteBytes")
    static extern fun buffer_write_bytes(id: int, borrow data: byte[]): void;

    @runtime("gpuBufferWriteBytesAt")
    static extern fun buffer_write_bytes_at(id: int, byte_offset: int, borrow data: byte[]): void;

    @runtime("gpuBufferReadBytes")
    static extern async fun buffer_read_bytes(id: int, n: int): byte[];

    @runtime("gpuBufferReadBytesAt")
    static extern async fun buffer_read_bytes_at(id: int, byte_offset: int, n: int): byte[];

    @runtime("gpuBufferCopy")
    static extern fun buffer_copy(
        src_id: int,
        dst_id: int,
        src_offset: int,
        dst_offset: int,
        size: int
    ): void;

    @runtime("gpuDispatch")
    static extern async fun dispatch(
        borrow kernel: string,
        borrow buffer_ids: int[],
        borrow texture_ids: int[],
        borrow sampler_ids: int[],
        ex: int,
        ey: int,
        ez: int,
        borrow uniforms: byte[]
