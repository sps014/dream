    @runtime("gpuShaderFromWgsl")
    static extern fun shader_from_wgsl(borrow source: string, borrow entry: string): int;

    @runtime("gpuDispatchShader")
    static extern async fun dispatch_shader(
        shader_id: int,
        borrow buffer_ids: int[],
        wx: int,
        wy: int,
        wz: int
    ): int;

    // Full sampler state. `compare` is a `GpuCompareFunction` for a comparison (shadow) sampler or
    // `-1` for an ordinary one; `anisotropy` is the max sample count (1 disables it).
    @runtime("gpuSamplerCreate")
    static extern fun sampler_create(
        mag_filter: int,
        min_filter: int,
        mip_filter: int,
        address_u: int,
        address_v: int,
        address_w: int,
        lod_min: float,
        lod_max: float,
        compare: int,
        anisotropy: int
    ): int;

    // Allocates a texture from a full descriptor. Returns the id, or a negated `GpuError` code
    // when the format needs a device feature the adapter lacks or the shape is invalid.
    @runtime("gpuTextureCreate")
    static extern fun texture_create(
        format: int,
        dimension: int,
        width: int,
        height: int,
        depth_or_layers: int,
        mip_levels: int,
        sample_count: int,
        storage_access: int,
        view_dimension: int
    ): int;

    // Decodes PNG or JPEG bytes into a new RGBA8 texture. Empty result means failure; the
    // host last-error holds the reason. Success is `[id, width, height]`.
    @web @native
    @runtime("gpuTextureFromImageBytes")
    static extern async fun texture_from_image_bytes(borrow data: byte[]): int[];

    @runtime("gpuTextureWriteRgba")
    static extern async fun texture_write_rgba(
        id: int,
        borrow pixels: byte[],
        x: int,
        y: int,
        w: int,
        h: int
    ): int;

    @runtime("gpuTextureReadRgba")
    static extern async fun texture_read_rgba(id: int): byte[];

    @runtime("gpuTextureCopyFromBuffer")
    static extern fun texture_copy_from_buffer(
        tex_id: int,
        buf_id: int,
        byte_offset: int,
        x: int,
        y: int,
        w: int,
        h: int
    ): void;

    @runtime("gpuTextureCopyToBuffer")
    static extern fun texture_copy_to_buffer(
        tex_id: int,
        buf_id: int,
        byte_offset: int,
        x: int,
        y: int,
        w: int,
        h: int
    ): void;

    @web @native
    @runtime("gpuSurfaceFromCanvas")
    static extern fun surface_from_canvas(borrow canvas_id: string): int;

    @web @native
    @runtime("gpuSurfaceCreate")
    static extern fun surface_create(borrow title: string, width: int, height: int): int;

    @web @native
