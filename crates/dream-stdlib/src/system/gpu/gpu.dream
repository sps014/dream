    @runtime("gpuRenderPipelineDestroy")
    static extern fun render_pipeline_destroy(id: int): void;

    @web @native
    @runtime("gpuSurfaceDestroy")
    static extern fun surface_destroy(id: int): void;

    @runtime("gpuTextureCopy")
    static extern fun texture_copy(
        src_id: int,
        dst_id: int,
        src_x: int,
        src_y: int,
        dst_x: int,
        dst_y: int,
        width: int,
