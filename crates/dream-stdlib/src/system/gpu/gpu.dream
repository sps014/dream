    @runtime("gpuTextureGenerateMipmaps")
    static extern fun texture_generate_mipmaps(id: int): int;

    @runtime("gpuBufferAllocVertexBytes")
    static extern fun buffer_alloc_vertex_bytes(n: int): int;

    @runtime("gpuPassBegin")
    static extern fun pass_begin(): int;

    @runtime("gpuPassDispatch")
