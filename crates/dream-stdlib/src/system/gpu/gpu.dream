    // Replays a recorded command stream (see `gpu_cmd.dream`) as one command buffer + submit.
    @web @native
    @runtime("gpuEncoderSubmit")
    static extern async fun encoder_submit(borrow stream: byte[]): int;

    // Builds a reusable bind group for `pipeline`'s `@group(group)`. `buffer_ids` /
    // `texture_ids` / `sampler_ids` fill that group's slots in ABI declaration order, exactly as
    // `Compute.run_resources` does for kernels. Returns the id, or a negated `GpuError` code.
    @web @native
    @runtime("gpuBindGroupCreate")
    static extern async fun bind_group_create(
        pipeline_id: int,
        group: int,
        borrow buffer_ids: int[],
        borrow texture_ids: int[],
        borrow sampler_ids: int[]
    ): int;

    @web @native
    @runtime("gpuBindGroupDestroy")
    static extern fun bind_group_destroy(id: int): void;

    @runtime("gpuBufferDestroy")
    static extern fun buffer_destroy(id: int): void;

    @runtime("gpuTextureDestroy")
