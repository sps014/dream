    static extern async fun render_blit(surface_id: int, texture_id: int): int;

    @runtime("gpuRenderPipelineCreate")
    static extern async fun render_pipeline_create(borrow vertex: string, borrow fragment: string): int;

    @runtime("gpuRenderPipelineCreateEx")
    static extern async fun render_pipeline_create_ex(
        borrow vertex: string,
