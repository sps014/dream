module system.gpu;

// The arguments of one shader invocation in parameter order, built by generated typed
// `dispatch` wrappers. Resources become pinned handles; scalar and struct values become bytes the
// host places at the parameter's reflected offset.
internal class GpuArgs {
    internal items: List<int>;
    internal devices: List<int>;
    internal names: List<string>;
    internal data: List<byte>;

    // The first argument whose shape differs from the shader's, found while adding it.
    internal mismatch: Option<GpuError>;

    internal constructor() {
        this.items = List<int>();
        this.devices = List<int>();
        this.names = List<string>();
        this.data = List<byte>();
        this.mismatch = Option.None;
    }

    // The handle is pinned while the arguments exist, since the resource itself may be dropped
    // before the dispatch that uses it is recorded.
    fun resource(kind: GpuArgKind, handle: int, device_id: int, name: string): GpuArgs {
        GpuHost.pin(handle);
        return this.add(kind, handle, 0, device_id, name);
    }

    fun add(kind: GpuArgKind, a: int, b: int, device_id: int, name: string): GpuArgs {
        let k: int = kind;
        this.items.push(k);
        this.items.push(a);
        this.items.push(b);
        this.devices.push(device_id);
        this.names.push(name);
        return this;
    }

    internal fun buffer<T: unmanaged>(buffer: GpuBuffer<T>): GpuArgs {
        return this.resource(GpuArgKind.Buffer, buffer.handle, buffer.device_id, "buffer");
    }

    internal fun texture(texture: GpuTexture): GpuArgs {
        return this.resource(GpuArgKind.Texture, texture.handle, texture.device_id, "texture");
    }

    internal fun storage_texture<T: unmanaged>(texture: GpuStorageTexture<T>): GpuArgs {
        return this.resource(
            GpuArgKind.StorageTexture,
            texture.handle,
            texture.device_id,
            "storage texture"
        );
    }

    internal fun sampler(sampler: GpuSampler): GpuArgs {
        return this.resource(GpuArgKind.Sampler, sampler.handle, sampler.device_id, "sampler");
    }

    internal fun acceleration_structure(scene: GpuAccelerationStructure): GpuArgs {
        return this.resource(
            GpuArgKind.AccelerationStructure,
            scene.handle,
            scene.device_id,
            "acceleration structure"
        );
    }

    // `inputs` and `outputs` are the parameter's `@coop_shape`, fixed when the shader was built.
    internal fun mlp_weights<T: unmanaged>(
        weights: GpuMlpWeights<T>,
        inputs: int,
        outputs: int
    ): GpuArgs {
        if this.mismatch.is_none() && (weights.inputs != inputs || weights.outputs != outputs) {
            this.mismatch = Option.Some(
                GpuError.InvalidResource(
                    "argument "
                        + this.devices.length.to_string()
                        + " is an MLP layer from "
                        + weights.inputs.to_string()
                        + " to "
                        + weights.outputs.to_string()
                        + " values; the shader was built for "
                        + inputs.to_string() + " to " + outputs.to_string()
                )
            );
        }
        return this.resource(
            GpuArgKind.MlpWeights,
            weights.handle,
            weights.device_id,
            "MLP weights"
        );
    }

    internal fun value<T: unmanaged>(value: T): GpuArgs {
        let bytes = Bytes.of(value);
        let offset = this.data.length;
        this.data.push_all(bytes);
        return this.add(GpuArgKind.Value, offset, bytes.length, 0, "value");
    }

    // The first argument that cannot be used with `device_id`, if any.
    internal fun check(device_id: int): Option<GpuError> {
        if this.mismatch.is_some() {
            return this.mismatch;
        }
        for (let i = 0; i < this.devices.length; i = i + 1) {
            let kind = this.items[i * 3];
            if kind != GpuArgKind.Value && this.items[i * 3 + 1] == 0 {
                return Option.Some(
                    GpuError.InvalidResource(
                        "argument " + i.to_string() + " is a destroyed " + this.names[i]
                    )
                );
            }
            let owner = this.devices[i];
            if owner != 0 && owner != device_id {
                return Option.Some(
                    GpuError.WrongDevice("argument " + i.to_string() + " is a " + this.names[i])
                );
            }
        }
        return Option.None;
    }

    del() {
        let count = this.devices.length;
        for (let i = 0; i < count; i = i + 1) {
            if this.items[i * 3] != GpuArgKind.Value {
                GpuHost.unpin(this.items[i * 3 + 1]);
            }
        }
    }
}
