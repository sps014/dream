module system.gpu;

// The arguments of one shader invocation in parameter order, built by generated typed
// `dispatch` wrappers. Resources become handles; scalar and struct values become bytes the
// host places at the parameter's reflected offset.
internal class GpuArgs {
    internal items: List<int>;
    internal devices: List<int>;
    internal names: List<string>;
    internal data: List<byte>;

    // The argument resources, kept alive until the commands that use them are submitted.
    internal keep: List<GpuOwnedHandle>;

    internal constructor() {
        this.items = List<int>();
        this.devices = List<int>();
        this.names = List<string>();
        this.data = List<byte>();
        this.keep = List<GpuOwnedHandle>();
    }

    fun resource(kind: GpuArgKind, owner: GpuOwnedHandle, device_id: int, name: string): GpuArgs {
        this.keep.push(owner);
        return this.add(kind, owner.handle, 0, device_id, name);
    }

    fun add(kind: GpuArgKind, a: int, b: int, device_id: int, name: string): GpuArgs {
        let k: int = kind;
        this.items.push(k);
        this.items.push(a);
        this.items.push(b);
        this.devices.push(device_id);
        this.names.push(name);
        return this;
    }

    internal fun buffer<T: unmanaged>(buffer: GpuBuffer<T>): GpuArgs {
        return this.resource(GpuArgKind.Buffer, buffer.owner, buffer.device_id, "buffer");
    }

    internal fun texture(texture: GpuTexture): GpuArgs {
        return this.resource(GpuArgKind.Texture, texture.owner, texture.device_id, "texture");
    }

    internal fun storage_texture<T: unmanaged>(texture: GpuStorageTexture<T>): GpuArgs {
        return this.resource(
            GpuArgKind.StorageTexture,
            texture.owner,
            texture.device_id,
            "storage texture"
        );
    }

    internal fun sampler(sampler: GpuSampler): GpuArgs {
        return this.resource(GpuArgKind.Sampler, sampler.owner, sampler.device_id, "sampler");
    }

    internal fun acceleration_structure(scene: GpuAccelerationStructure): GpuArgs {
        return this.resource(
            GpuArgKind.AccelerationStructure,
            scene.owner,
            scene.device_id,
            "acceleration structure"
        );
    }

    internal fun mlp_weights<T: unmanaged>(weights: GpuMlpWeights<T>): GpuArgs {
        return this.resource(
            GpuArgKind.MlpWeights,
            weights.owner,
            weights.device_id,
            "MLP weights"
        );
    }

    internal fun value<T: unmanaged>(value: T): GpuArgs {
        let bytes = Bytes.of(value);
        let offset = this.data.length;
        this.data.push_all(bytes);
        return this.add(GpuArgKind.Value, offset, bytes.length, 0, "value");
    }

    // The first argument that cannot be used with `device_id`, if any.
    internal fun check(device_id: int): Option<GpuError> {
        for (let i = 0; i < this.devices.length; i = i + 1) {
            let kind = this.items[i * 3];
            if kind != GpuArgKind.Value && this.items[i * 3 + 1] == 0 {
                return Option.Some(
                    GpuError.InvalidResource(
                        "argument " + i.to_string() + " is a destroyed " + this.names[i]
                    )
                );
            }
            let owner = this.devices[i];
            if owner != 0 && owner != device_id {
                return Option.Some(
                    GpuError.WrongDevice("argument " + i.to_string() + " is a " + this.names[i])
                );
            }
        }
        return Option.None;
    }
}
