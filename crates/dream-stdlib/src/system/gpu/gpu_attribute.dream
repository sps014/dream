module system.gpu;

/// Marks a helper function that shaders may call.
///
/// A helper follows the same rules as a shader body and may use every shader built-in, but
/// it is not an entry point and has no `GpuShaders` descriptor. Like shaders, helpers are
/// compiled for the GPU only and cannot be called from CPU code.
@attribute(AttributeTarget.Function)
public struct GpuAttribute {}
