module system.gpu;

/// Records GPU work, such as render passes, compute passes and copies, to submit together.
///
/// Get one from `GpuDevice.command_encoder` or a window frame's `GpuFrame.encoder`. Work
/// runs in the order it was recorded. Each pass is recorded by a function that receives the
/// pass and ends when that function returns. Mistakes such as a resource from another device
/// do not fail immediately: the first one is returned by `GpuDevice.submit`.
///
/// Resources only need to exist while their commands are recorded: the encoder keeps every
/// resource its commands name alive until the GPU finished with it.
public class GpuCommandEncoder {
    internal recording: GpuRecording;
    in_pass: bool;

    internal constructor(device_id: int) {
        this.recording = GpuRecording(device_id, 0);
        this.in_pass = false;
    }

    /// Records a render pass into the targets of `desc`: `body` receives the pass, and the
    /// pass ends when `body` returns.
    public fun render_pass(desc: GpuRenderPassDesc, body: fun(GpuRenderPass): void): void {
        if !this.start_pass("render_pass") {
            return;
        }
        let pass = GpuRenderPass(this.pass_recording());
        pass.begin(desc);
        body(pass);
        pass.finish(this.recording);
        this.in_pass = false;
    }

    /// Records a compute pass: `body` receives the pass, and the pass ends when `body`
    /// returns. Record dispatches into it with the generated `GpuShaders.<name>.encode`.
    public fun compute_pass(body: fun(GpuComputePass): void): void {
        if !this.start_pass("compute_pass") {
            return;
        }
        let pass = GpuComputePass(this.pass_recording());
        body(pass);
        pass.finish(this.recording);
        this.in_pass = false;
    }

    /// Copies `count` elements from `source`, starting at element `source_offset`, into
    /// `destination` starting at `destination_offset`. Both ranges must lie inside their
    /// buffers. Copies cannot be recorded while a pass is being recorded.
    public fun copy_buffer<T: unmanaged>(
        source: GpuBuffer<T>,
        source_offset: int,
        destination: GpuBuffer<T>,
        destination_offset: int,
        count: int
    ): void {
        if this.in_pass {
            this.recording.fail(GpuError.Validation("copy_buffer was recorded inside a pass"));
            return;
        }
        if !this.recording.check(source.handle, source.device_id, "copy source")
            || !this.recording.check(destination.handle, destination.device_id, "copy destination") {
            return;
        }
        if count < 0
            || source_offset < 0
            || destination_offset < 0
            || source_offset
            + count > source.length || destination_offset + count > destination.length {
            this.recording.fail(GpuError.InvalidResource("copy range lies outside a buffer"));
            return;
        }
        let stride = GpuBuffer<T>.stride();
        this.recording.op(GpuOp.CopyBuffer);
        this.recording.words.push_all(
            [
                source.handle,
                source_offset * stride,
                destination.handle,
                destination_offset * stride,
                count * stride
            ]
        );
    }

    /// Ends recording. Pass the result to `GpuDevice.submit`.
    public fun finish(): GpuCommandBuffer {
        let recording = GpuRecording(this.recording.device_id, 0);
        recording.absorb(this.recording);
        return GpuCommandBuffer(recording);
    }

    fun start_pass(what: string): bool {
        if this.in_pass {
            this.recording.fail(
                GpuError.Validation(what + " was recorded inside another pass")
            );
            return false;
        }
        this.in_pass = true;
        return true;
    }

    // A pass records on its own and is appended when it ends, so its values sit after the
    // encoder's bytes so far; nothing else is recorded while the pass is open.
    fun pass_recording(): GpuRecording {
        return GpuRecording(this.recording.device_id, this.recording.data.length);
    }
}
