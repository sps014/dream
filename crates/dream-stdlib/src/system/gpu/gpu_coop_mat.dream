module system.gpu;

import system.codegen;

/// A matrix tile that a subgroup of threads holds and multiplies together on tensor
/// hardware, for compute shaders that tile their own matrix multiplications.
///
/// Its size is fixed when the shader is built from the constant sizes passed to `zeros` or
/// `load`. Needs `GpuFeature.CooperativeMatrices`, which `GpuTarget.Vulkan`, `Dx12` and
/// `Cuda` can provide; using it with only other targets is a build error.
@generator_only(ComputeAttribute, GpuAttribute)
public struct GpuCoopMat<T> {
    /// A `rows` by `columns` tile of zeros; both sizes must be constants.
    public static extern fun zeros(rows: int, columns: int): GpuCoopMat<T>;

    /// Loads a `rows` by `columns` tile whose first element is `buffer[offset]` and whose
    /// rows are `row_stride` elements apart. The sizes must be constants.
    public static extern fun load(
        buffer: GpuBuffer<T>,
        offset: int,
        row_stride: int,
        rows: int,
        columns: int
    ): GpuCoopMat<T>;

    /// `a * b + c`, where `a` is M by K, `b` K by N, and `c` and the result M by N.
    public static extern fun multiply_add(
        a: GpuCoopMat<T>,
        b: GpuCoopMat<T>,
        c: GpuCoopMat<T>
    ): GpuCoopMat<T>;

    /// Stores the tile into `buffer` starting at `buffer[offset]`, rows `row_stride`
    /// elements apart.
    public extern fun store(buffer: GpuBuffer<T>, offset: int, row_stride: int): void;
}
