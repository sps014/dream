module system.gpu;

// WebGPU compute + present. Auto-loaded when any `@compute` kernel is present.

// Failure from GPU init / dispatch / present.
public class GpuError : Error {
    _code: string;
    _message: string;

    // Builds an error with a stable `code` string and human-readable `message`.
    public constructor(code: string, message: string) {
        this._code = code;
        this._message = message;
    }

    // Human-readable description.
    public fun message(): string {
        return this._message;
    }

    // Stable machine-readable code (`UNAVAILABLE`, `TIMEOUT`, …).
    public fun code(): string {
        return this._code;
    }

    // GPU backend missing or not initialized.
    public static fun unavailable(message: string): GpuError {
        return GpuError("UNAVAILABLE", message);
    }

    // Operation exceeded the host timeout.
    public static fun timeout(message: string): GpuError {
        return GpuError("TIMEOUT", message);
    }

    // Invalid arguments or pipeline state.
    public static fun validation(message: string): GpuError {
        return GpuError("VALIDATION", message);
    }

    // Unclassified I/O or host failure.
    public static fun other(message: string): GpuError {
        return GpuError("EIO", message);
    }

    // The request was well-formed but the adapter lacks the feature or limit it needs — a
    // block-compressed texture format on a device without that family, for instance. Recover by
    // picking a different resource, not by correcting the call.
    public static fun unsupported(message: string): GpuError {
        return GpuError("UNSUPPORTED", message);
    }

    // The GPU device is gone (driver reset, tab discarded, thermal kill). Recover by calling
    // `Gpu.try_init` again; previously created GPU resources are invalid.
    public static fun device_lost(message: string): GpuError {
        return GpuError("DEVICE_LOST", message);
    }

    // Cooperative cancellation (`CancellationToken`).
    public static fun cancelled(): GpuError {
        return GpuError("ECANCELLED", "operation cancelled");
    }

    // Maps a numeric host status code to a typed `GpuError`. When the host recorded a detail string
    // (pipeline compile failure, missing bind, wgpu validation, …), it is appended after `detail`.
    public static fun from_code(code: int, detail: string): GpuError {
        let last = GpuError.last_error_host();
        let msg = detail;
        if last.length > 0 {
            msg = detail + ": " + last;
        }
        if code == 1 { return GpuError.unavailable(msg); }
        if code == 2 { return GpuError.timeout(msg); }
        if code == 3 { return GpuError.validation(msg); }
        if code == 5 { return GpuError.unsupported(msg); }
        if code == 6 { return GpuError.device_lost(msg); }
        return GpuError.other(msg);
    }

    @runtime("gpuLastError")
    static extern fun last_error_host(): string;
}
