module system.gpu;

/// One frame of a window surface, from `GpuSurface.begin_frame` until `present`.
///
/// Draw with `draw` for simple cases, or record into `pass` for vertex buffers, textures
/// and other settings. For extra passes, such as post-processing, use `encoder`; all work
/// runs in the order recorded, and the first frame pass clears `target` to the color given
/// to `begin_frame`. Nothing appears on screen until `present`. Keep the device and surface
/// until the frame was presented.
public class GpuFrame {
    device_id: int;
    surface: int;
    frame_target: GpuTexture;
    frame_encoder: GpuCommandEncoder;
    clear: GpuVec4;
    cleared: bool;

    internal constructor(device_id: int, surface: int, target: GpuTexture, clear: GpuVec4) {
        this.device_id = device_id;
        this.surface = surface;
        this.frame_target = target;
        this.frame_encoder = GpuCommandEncoder(device_id);
        this.clear = clear;
        this.cleared = false;
    }

    /// The texture shown when the frame is presented. Valid until `present`.
    public get target(): borrow GpuTexture {
        return this.frame_target;
    }

    /// The encoder that records this frame's work, for passes of your own. They run in order
    /// with the frame's own passes.
    public get encoder(): borrow GpuCommandEncoder {
        return this.frame_encoder;
    }

    /// Records a render pass that draws into `target`: `body` receives the pass, and the pass
    /// ends when `body` returns. The frame's first pass starts by clearing `target`; later
    /// ones keep what earlier passes drew.
    public fun pass(body: fun(GpuRenderPass): void): void {
        let load: GpuLoad<GpuVec4> = GpuLoad.Keep;
        if !this.cleared {
            load = GpuLoad.Clear(this.clear);
            this.cleared = true;
        }
        this.frame_encoder.render_pass(GpuRenderPassDesc.color(this.frame_target, load), body);
    }

    /// Draws `vertex_count` vertices with `pipeline` into `target`, for shaders that need no
    /// vertex buffers or bound resources.
    public fun draw(pipeline: GpuRenderPipeline, vertex_count: int): Result<Unit, GpuError> {
        if pipeline.device_id != this.device_id {
            return Result.Err(GpuError.WrongDevice("pipeline"));
        }
        this.pass((pass: GpuRenderPass) => {
            pass.set_pipeline(pipeline);
            pass.draw(vertex_count);
        });
        return Result.Ok(Unit());
    }

    /// Submits everything recorded for the frame and shows `target` in the window.
    public async fun present(): Result<Unit, GpuError> {
        if !this.cleared {
            this.pass((pass: GpuRenderPass) => {});
        }
        GpuDevice.send(this.device_id, this.frame_encoder.finish()).await?;
        if GpuHost.surface_present(this.surface).await != 0 {
            return Result.Err(GpuHost.error());
        }
        return Result.Ok(Unit());
    }
}
