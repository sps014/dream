module system.gpu;

/// One placed copy of a bottom-level acceleration structure inside a top-level one.
///
/// Start from `GpuInstance.of` and chain the settings you want to change.
public class GpuInstance {
    internal bottom_level: GpuAccelerationStructure;
    transform: GpuMat4;
    id: int;
    mask: int;
    hit_group: int;

    constructor(bottom_level: GpuAccelerationStructure, transform: GpuMat4) {
        this.bottom_level = bottom_level;
        this.transform = transform;
        this.id = 0;
        this.mask = 255;
        this.hit_group = 0;
    }

    /// Places `bottom_level` with the object-to-world `transform`. Only the affine part of
    /// the transform is used.
    public static fun of(bottom_level: GpuAccelerationStructure, transform: GpuMat4): GpuInstance {
        return GpuInstance(bottom_level, transform);
    }

    /// Sets the value hit shaders read with `hit_instance_id()`, and returns this instance.
    public fun with_id(id: int): GpuInstance {
        this.id = id;
        return this;
    }

    /// Sets the 8-bit visibility mask, and returns this instance. A ray only sees instances
    /// whose mask shares a bit with the ray's mask. Defaults to `255`.
    public fun with_mask(mask: int): GpuInstance {
        this.mask = mask & 255;
        return this;
    }

    /// Sets which hit group of the ray tracing pipeline handles hits on this instance, and
    /// returns this instance. Defaults to `0`.
    public fun with_hit_group(index: int): GpuInstance {
        this.hit_group = index;
        return this;
    }

    // Appends [blas, instance_id, mask, hit_group_offset, flags] and the 3x4 row-major
    // transform.
    internal fun encode(records: List<int>, transforms: List<float>): void {
        records.push_all([this.bottom_level.handle, this.id, this.mask, this.hit_group, 0]);
        for (let r = 0; r < 3; r = r + 1) {
            let row = this.transform.row(r);
            transforms.push_all([row.x, row.y, row.z, row.w]);
        }
    }
}
