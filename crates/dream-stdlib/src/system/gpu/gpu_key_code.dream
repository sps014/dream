    if (code == KeyCode.Digit9) { return "Digit9"; }
    if (code == KeyCode.F1) { return "F1"; }
    if (code == KeyCode.F2) { return "F2"; }
    if (code == KeyCode.F3) { return "F3"; }
    if (code == KeyCode.F4) { return "F4"; }
    if (code == KeyCode.F5) { return "F5"; }
    if (code == KeyCode.F6) { return "F6"; }
