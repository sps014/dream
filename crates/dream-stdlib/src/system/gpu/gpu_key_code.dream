    if (name == "NumpadSubtract") { return KeyCode.NumpadSubtract; }
    if (name == "NumpadMultiply") { return KeyCode.NumpadMultiply; }
    if (name == "NumpadDivide") { return KeyCode.NumpadDivide; }
    if (name == "NumpadDecimal") { return KeyCode.NumpadDecimal; }
