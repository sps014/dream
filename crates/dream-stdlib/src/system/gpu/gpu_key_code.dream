    if (code == KeyCode.Period) { return "Period"; }
    if (code == KeyCode.Slash) { return "Slash"; }
    if (code == KeyCode.Numpad0) { return "Numpad0"; }
    if (code == KeyCode.Numpad1) { return "Numpad1"; }
    if (code == KeyCode.Numpad2) { return "Numpad2"; }
    if (code == KeyCode.Numpad3) { return "Numpad3"; }
    if (code == KeyCode.Numpad4) { return "Numpad4"; }
    if (code == KeyCode.Numpad5) { return "Numpad5"; }
    if (code == KeyCode.Numpad6) { return "Numpad6"; }
    if (code == KeyCode.Numpad7) { return "Numpad7"; }
    if (code == KeyCode.Numpad8) { return "Numpad8"; }
    if (code == KeyCode.Numpad9) { return "Numpad9"; }
    if (code == KeyCode.NumpadAdd) { return "NumpadAdd"; }
    if (code == KeyCode.NumpadSubtract) { return "NumpadSubtract"; }
    if (code == KeyCode.NumpadMultiply) { return "NumpadMultiply"; }
    if (code == KeyCode.NumpadDivide) { return "NumpadDivide"; }
    if (code == KeyCode.NumpadDecimal) { return "NumpadDecimal"; }
    if (code == KeyCode.NumpadEnter) { return "NumpadEnter"; }
    return "Unidentified";
}

/// Map a host physical code string to `KeyCode` (`Unknown` if unrecognized).
public fun key_code_from_name(name: string): KeyCode {
    if (name == "Escape") { return KeyCode.Escape; }
    if (name == "Space") { return KeyCode.Space; }
    if (name == "Enter") { return KeyCode.Enter; }
    if (name == "Tab") { return KeyCode.Tab; }
    if (name == "Backspace") { return KeyCode.Backspace; }
    if (name == "Delete") { return KeyCode.Delete; }
