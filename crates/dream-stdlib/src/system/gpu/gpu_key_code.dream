    if (code == KeyCode.KeyH) { return "KeyH"; }
    if (code == KeyCode.KeyI) { return "KeyI"; }
    if (code == KeyCode.KeyJ) { return "KeyJ"; }
    if (code == KeyCode.KeyK) { return "KeyK"; }
    if (code == KeyCode.KeyL) { return "KeyL"; }
    if (code == KeyCode.KeyM) { return "KeyM"; }
    if (code == KeyCode.KeyN) { return "KeyN"; }
    if (code == KeyCode.KeyO) { return "KeyO"; }
    if (code == KeyCode.KeyP) { return "KeyP"; }
    if (code == KeyCode.KeyQ) { return "KeyQ"; }
    if (code == KeyCode.KeyR) { return "KeyR"; }
    if (code == KeyCode.KeyS) { return "KeyS"; }
    if (code == KeyCode.KeyT) { return "KeyT"; }
    if (code == KeyCode.KeyU) { return "KeyU"; }
    if (code == KeyCode.KeyV) { return "KeyV"; }
    if (code == KeyCode.KeyW) { return "KeyW"; }
    if (code == KeyCode.KeyX) { return "KeyX"; }
    if (code == KeyCode.KeyY) { return "KeyY"; }
    if (code == KeyCode.KeyZ) { return "KeyZ"; }
    if (code == KeyCode.Digit0) { return "Digit0"; }
    if (code == KeyCode.Digit1) { return "Digit1"; }
    if (code == KeyCode.Digit2) { return "Digit2"; }
    if (code == KeyCode.Digit3) { return "Digit3"; }
    if (code == KeyCode.Digit4) { return "Digit4"; }
    if (code == KeyCode.Digit5) { return "Digit5"; }
