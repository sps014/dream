module system.gpu;

/// Physical keyboard codes (UI Events `KeyboardEvent.code` / winit `KeyCode` Debug names).
public enum KeyCode {
    Unknown,
    Escape,
    Space,
    Enter,
    Tab,
    Backspace,
    Delete,
    Insert,
    Home,
    End,
    PageUp,
    PageDown,
    ArrowUp,
    ArrowDown,
    ArrowLeft,
    ArrowRight,
    ShiftLeft,
    ShiftRight,
    ControlLeft,
    ControlRight,
    AltLeft,
    AltRight,
    MetaLeft,
    MetaRight,
    CapsLock,
    ContextMenu,
    KeyA,
    KeyB,
    KeyC,
    KeyD,
    KeyE,
    KeyF,
    KeyG,
    KeyH,
    KeyI,
    KeyJ,
    KeyK,
    KeyL,
    KeyM,
    KeyN,
    KeyO,
    KeyP,
    KeyQ,
    KeyR,
    KeyS,
    KeyT,
    KeyU,
    KeyV,
    KeyW,
    KeyX,
    KeyY,
    KeyZ,
    Digit0,
    Digit1,
    Digit2,
    Digit3,
    Digit4,
    Digit5,
    Digit6,
    Digit7,
    Digit8,
    Digit9,
    F1,
    F2,
    F3,
    F4,
    F5,
    F6,
    F7,
    F8,
    F9,
    F10,
    F11,
    F12,
    Minus,
    Equal,
    BracketLeft,
    BracketRight,
    Backslash,
    Semicolon,
    Quote,
    Backquote,
    Comma,
    Period,
    Slash,
    Numpad0,
    Numpad1,
    Numpad2,
    Numpad3,
    Numpad4,
    Numpad5,
    Numpad6,
    Numpad7,
    Numpad8,
    Numpad9,
    NumpadAdd,
    NumpadSubtract,
    NumpadMultiply,
    NumpadDivide,
    NumpadDecimal,
    NumpadEnter,
}

/// UI Events / host physical code string for a `KeyCode`.
public fun key_code_name(code: KeyCode): string {
    if (code == KeyCode.Escape) { return "Escape"; }
    if (code == KeyCode.Space) { return "Space"; }
    if (code == KeyCode.Enter) { return "Enter"; }
    if (code == KeyCode.Tab) { return "Tab"; }
    if (code == KeyCode.Backspace) { return "Backspace"; }
    if (code == KeyCode.Delete) { return "Delete"; }
    if (code == KeyCode.Insert) { return "Insert"; }
    if (code == KeyCode.Home) { return "Home"; }
    if (code == KeyCode.End) { return "End"; }
    if (code == KeyCode.PageUp) { return "PageUp"; }
