module system.gpu;

// Math helpers for GPU shaders (`@compute` / `@vertex` / `@fragment`).
// Inside shaders the WGSL emitter maps these method names to WGSL builtins
// (`sin`, `normalize`, `cross`, …). On the CPU they use host `Math` (stubs for some vec/mat ops).
public static class GpuMath {
    // Smaller of two floats (WGSL `min`).
    public static fun min(a: float, b: float): float {
        if a < b { return a; }
        return b;
    }
    // Larger of two floats (WGSL `max`).
    public static fun max(a: float, b: float): float {
        if a > b { return a; }
        return b;
    }
    // Absolute value (WGSL `abs`).
    public static fun abs(a: float): float {
        if a < 0.0 { return -a; }
        return a;
    }
    // Clamps `x` into `[lo, hi]` (WGSL `clamp`).
    public static fun clamp(x: float, lo: float, hi: float): float {
        return GpuMath.max(lo, GpuMath.min(x, hi));
    }
    // Greatest integer ≤ `x` as float (WGSL `floor`).
    public static fun floor(x: float): float {
        return (float)Math.floor((double)x);
    }
    // Fractional part `x - floor(x)` (WGSL `fract`).
    public static fun fract(x: float): float {
        return x - GpuMath.floor(x);
    }
    // Smallest integer ≥ `x` as float (WGSL `ceil`).
    public static fun ceil(x: float): float {
        return (float)Math.ceil((double)x);
    }
    // Square root; non-finite inputs become `0` on CPU (WGSL `sqrt`).
    public static fun sqrt(x: float): float {
        return (float)(Math.sqrt((double)x).unwrap_or(0.0d));
    }
    // Reciprocal square root; returns `0` when `sqrt(x)` is zero (WGSL `inverseSqrt`).
    public static fun inversesqrt(x: float): float {
        let s = GpuMath.sqrt(x);
        if s == 0.0 { return 0.0; }
        return 1.0 / s;
    }
    // Sine in radians (WGSL `sin`).
    public static fun sin(x: float): float {
        return (float)Math.sin((double)x);
    }
    // Cosine in radians (WGSL `cos`).
    public static fun cos(x: float): float {
        return (float)Math.cos((double)x);
    }
    // Tangent in radians (WGSL `tan`).
    public static fun tan(x: float): float {
        return (float)Math.tan((double)x);
    }
    // Arcsine in radians (WGSL `asin`).
    public static fun asin(x: float): float {
        return (float)Math.asin((double)x);
    }
    // Arccosine in radians (WGSL `acos`).
    public static fun acos(x: float): float {
        return (float)Math.acos((double)x);
    }
    // Arctangent in radians (WGSL `atan`).
    public static fun atan(x: float): float {
        return (float)Math.atan((double)x);
    }
    // Two-argument arctangent of `y`/`x` in radians (WGSL `atan2`).
    public static fun atan2(y: float, x: float): float {
        return (float)Math.atan2((double)y, (double)x);
    }
    // Natural log (WGSL `log`). CPU body is a stub — use only inside shaders.
    public static fun log(x: float): float {
        // CPU stub — shaders map to WGSL `log`. Host Math has no ln.
        if x <= 0.0 { return 0.0; }
        return GpuMath.pow(x, 0.0) - 1.0; // 0 for positive x; shader path uses real log
    }
    // Sign of `x`: −1, 0, or 1 (WGSL `sign`).
    public static fun sign(x: float): float {
        if x > 0.0 { return 1.0; }
        if x < 0.0 { return -1.0; }
        return 0.0;
    }
    // Clamps `x` into `[0, 1]` (WGSL `saturate` / `clamp(x, 0, 1)`).
    public static fun saturate(x: float): float {
        return GpuMath.clamp(x, 0.0, 1.0);
    }
    // Heaviside step: `0` if `x < edge`, else `1` (WGSL `step`).
    public static fun step(edge: float, x: float): float {
        if x < edge { return 0.0; }
        return 1.0;
    }
    // Hermite smoothstep between `edge0` and `edge1` (WGSL `smoothstep`).
    public static fun smoothstep(edge0: float, edge1: float, x: float): float {
        let t = GpuMath.saturate((x - edge0) / (edge1 - edge0));
        return t * t * (3.0 - 2.0 * t);
    }
    // Fused multiply-add `a * b + c` (WGSL `fma`).
    public static fun fma(a: float, b: float, c: float): float {
        return a * b + c;
    }

    // Euclidean length of a `GpuVec3` (WGSL `length`). Overloaded for `GpuVec2` / `GpuVec4`.
    public static fun length(v: GpuVec3): float {
        return GpuMath.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
    }

    // Unit `GpuVec3`; near-zero input yields `(0, 1, 0)` on CPU (WGSL `normalize`).
    // Overloaded for `GpuVec2` / `GpuVec4`.
    public static fun normalize(v: GpuVec3): GpuVec3 {
        let len = GpuMath.length(v);
        if len < 0.000001 { return GpuVec3.of(0.0, 1.0, 0.0); }
        return v / len;
    }

    // Dot product of two `GpuVec3`s (WGSL `dot`). Overloaded for `GpuVec2` / `GpuVec4`.
    public static fun dot(a: GpuVec3, b: GpuVec3): float {
        return a.x * b.x + a.y * b.y + a.z * b.z;
    }

    // Cross product of two `GpuVec3`s (WGSL `cross`).
    public static fun cross(a: GpuVec3, b: GpuVec3): GpuVec3 {
        return GpuVec3.of(
            a.y * b.z - a.z * b.y,
            a.z * b.x - a.x * b.z,
            a.x * b.y - a.y * b.x
        );
    }

    // Reflects incident `i` about unit normal `n` (WGSL `reflect`).
    public static fun reflect(i: GpuVec3, n: GpuVec3): GpuVec3 {
        return i - n * (2.0 * GpuMath.dot(i, n));
    }

    // Linear blend `a * (1 - t) + b * t` (WGSL `mix`).
    public static fun mix(a: float, b: float, t: float): float {
        return a * (1.0 - t) + b * t;
    }

    // Power `x^e` (WGSL `pow`).
    public static fun pow(x: float, e: float): float {
        return (float)Math.pow((double)x, (double)e);
    }

    // Exponential `e^x` via `pow` on CPU (WGSL `exp`).
    public static fun exp(x: float): float {
        return GpuMath.pow(2.718281828, x);
    }

    // Matrix × vector (`mat2 * vec2` in WGSL). Overloaded for mat3/mat4 and mat×mat.
    public static fun mul(m: GpuMat2, v: GpuVec2): GpuVec2 {
        return GpuVec2.of(
            m.c0.x * v.x + m.c1.x * v.y,
            m.c0.y * v.x + m.c1.y * v.y
        );
    }

    // Matrix × vector (`mat3 * vec3` in WGSL).
    public static fun mul(m: GpuMat3, v: GpuVec3): GpuVec3 {
        return GpuVec3.of(
            m.c0.x * v.x + m.c1.x * v.y + m.c2.x * v.z,
            m.c0.y * v.x + m.c1.y * v.y + m.c2.y * v.z,
            m.c0.z * v.x + m.c1.z * v.y + m.c2.z * v.z
        );
    }

    // Matrix × vector (`mat4 * vec4` in WGSL).
    public static fun mul(m: GpuMat4, v: GpuVec4): GpuVec4 {
        return GpuVec4.of(
            m.c0.x * v.x + m.c1.x * v.y + m.c2.x * v.z + m.c3.x * v.w,
            m.c0.y * v.x + m.c1.y * v.y + m.c2.y * v.z + m.c3.y * v.w,
            m.c0.z * v.x + m.c1.z * v.y + m.c2.z * v.z + m.c3.z * v.w,
            m.c0.w * v.x + m.c1.w * v.y + m.c2.w * v.z + m.c3.w * v.w
        );
    }

    // Matrix × matrix (`mat2 * mat2` in WGSL).
    public static fun mul(a: GpuMat2, b: GpuMat2): GpuMat2 {
        return GpuMat2.of(GpuMath.mul(a, b.c0), GpuMath.mul(a, b.c1));
    }

    // Matrix × matrix (`mat3 * mat3` in WGSL).
    public static fun mul(a: GpuMat3, b: GpuMat3): GpuMat3 {
        return GpuMat3.of(GpuMath.mul(a, b.c0), GpuMath.mul(a, b.c1), GpuMath.mul(a, b.c2));
    }

    // Matrix × matrix (`mat4 * mat4` in WGSL).
    public static fun mul(a: GpuMat4, b: GpuMat4): GpuMat4 {
        return GpuMat4.of(
            GpuMath.mul(a, b.c0),
            GpuMath.mul(a, b.c1),
            GpuMath.mul(a, b.c2),
            GpuMath.mul(a, b.c3)
        );
    }

    // Transpose of a `GpuMat2` (WGSL `transpose`). Overloaded for mat3/mat4.
    public static fun transpose(m: GpuMat2): GpuMat2 {
        return GpuMat2.of(
            GpuVec2.of(m.c0.x, m.c1.x),
            GpuVec2.of(m.c0.y, m.c1.y)
        );
    }

    // Transpose of a `GpuMat3` (WGSL `transpose`).
    public static fun transpose(m: GpuMat3): GpuMat3 {
        return GpuMat3.of(
            GpuVec3.of(m.c0.x, m.c1.x, m.c2.x),
            GpuVec3.of(m.c0.y, m.c1.y, m.c2.y),
            GpuVec3.of(m.c0.z, m.c1.z, m.c2.z)
        );
    }

    // Transpose of a `GpuMat4` (WGSL `transpose`).
    public static fun transpose(m: GpuMat4): GpuMat4 {
        return GpuMat4.of(
            GpuVec4.of(m.c0.x, m.c1.x, m.c2.x, m.c3.x),
            GpuVec4.of(m.c0.y, m.c1.y, m.c2.y, m.c3.y),
            GpuVec4.of(m.c0.z, m.c1.z, m.c2.z, m.c3.z),
            GpuVec4.of(m.c0.w, m.c1.w, m.c2.w, m.c3.w)
        );
    }

    // Euclidean distance between two scalar values: `|a - b|` (WGSL `distance`).
    public static fun distance(a: float, b: float): float {
        return GpuMath.abs(a - b);
    }

    // Refraction vector for incident ray `i`, surface normal `n`, and index of refraction ratio `eta` (WGSL `refract`).
    public static fun refract(i: GpuVec3, n: GpuVec3, eta: float): GpuVec3 {
        return GpuVec3.of(0.0, 0.0, 0.0);
    }

    // Flips the surface normal `n` to face the opposite direction of incident vector `i` if `dot(nref, i) >= 0` (WGSL `faceForward`).
    public static fun faceforward(n: GpuVec3, i: GpuVec3, nref: GpuVec3): GpuVec3 {
        if GpuMath.dot(nref, i) < 0.0 { return n; }
        return -n;
    }

    // Base-2 exponential `2^x` (WGSL `exp2`).
    public static fun exp2(x: float): float {
        return GpuMath.pow(2.0, x);
    }

    // Base-2 logarithm `log2(x)` (WGSL `log2`).
    public static fun log2(x: float): float {
        return 0.0;
    }

    // Rounds to the nearest integer, rounding ties to the nearest even number (WGSL `round`).
    public static fun round(x: float): float {
        return (float)Math.round((double)x);
    }

    // Truncates fractional digits toward zero (WGSL `trunc`).
    public static fun trunc(x: float): float {
        if x < 0.0 { return GpuMath.ceil(x); }
        return GpuMath.floor(x);
    }

    // Converts an angle from degrees to radians: `deg * (pi / 180)` (WGSL `radians`).
    public static fun radians(deg: float): float {
        return deg * 0.017453292519943295;
    }

    // Converts an angle from radians to degrees: `rad * (180 / pi)` (WGSL `degrees`).
    public static fun degrees(rad: float): float {
        return rad * 57.29577951308232;
    }

    // Determinant of a 2x2 matrix (WGSL `determinant`).
    public static fun determinant(m: GpuMat2): float {
        return m.c0.x * m.c1.y - m.c0.y * m.c1.x;
    }

    // Determinant of a 3x3 matrix (WGSL `determinant`).
    public static fun determinant(m: GpuMat3): float {
        return m.c0.x * (m.c1.y * m.c2.z - m.c1.z * m.c2.y)
             - m.c1.x * (m.c0.y * m.c2.z - m.c0.z * m.c2.y)
             + m.c2.x * (m.c0.y * m.c1.z - m.c0.z * m.c1.y);
    }

    // Determinant of a 4x4 matrix (WGSL `determinant`).
    public static fun determinant(m: GpuMat4): float {
        // Expanded along the first row against the cofactors `inverse` also needs, so the two
        // agree on sign conventions by construction.
        let c = GpuMath.cofactors4(m);
        return m.c0.x * c.c0.x + m.c0.y * c.c1.x + m.c0.z * c.c2.x + m.c0.w * c.c3.x;
    }

    // Multiplicative inverse of a 2x2 matrix: `m^-1` such that `m * m^-1 = I`.
    // WGSL has no `inverse` builtin; shaders lower this to adjugate / `determinant`.
    public static fun inverse(m: GpuMat2): GpuMat2 {
        let det = GpuMath.determinant(m);
        if det == 0.0 { return GpuMat2.identity(); }
        let inv_det = 1.0 / det;
        return GpuMat2.of(
            GpuVec2.of(m.c1.y * inv_det, -m.c0.y * inv_det),
            GpuVec2.of(-m.c1.x * inv_det, m.c0.x * inv_det)
        );
    }

    // Multiplicative inverse of a 3x3 matrix (WGSL `inverse`).
    public static fun inverse(m: GpuMat3): GpuMat3 {
        let det = GpuMath.determinant(m);
        if det == 0.0 { return GpuMat3.identity(); }
        let d = 1.0 / det;
        // Adjugate, transposed into columns. `cN` is a column, so `cN.y` is row 1 of column N.
        return GpuMat3.of(
            GpuVec3.of(
                (m.c1.y * m.c2.z - m.c2.y * m.c1.z) * d,
                (m.c2.y * m.c0.z - m.c0.y * m.c2.z) * d,
                (m.c0.y * m.c1.z - m.c1.y * m.c0.z) * d
            ),
            GpuVec3.of(
                (m.c2.x * m.c1.z - m.c1.x * m.c2.z) * d,
                (m.c0.x * m.c2.z - m.c2.x * m.c0.z) * d,
                (m.c1.x * m.c0.z - m.c0.x * m.c1.z) * d
            ),
            GpuVec3.of(
                (m.c1.x * m.c2.y - m.c2.x * m.c1.y) * d,
                (m.c2.x * m.c0.y - m.c0.x * m.c2.y) * d,
                (m.c0.x * m.c1.y - m.c1.x * m.c0.y) * d
            )
        );
    }

    // Multiplicative inverse of a 4x4 matrix (WGSL `inverse`).
    public static fun inverse(m: GpuMat4): GpuMat4 {
        let c = GpuMath.cofactors4(m);
        let det = m.c0.x * c.c0.x + m.c0.y * c.c1.x + m.c0.z * c.c2.x + m.c0.w * c.c3.x;
        if det == 0.0 { return GpuMat4.identity(); }
        let d = 1.0 / det;
        return GpuMat4.of(
            GpuVec4.of(c.c0.x * d, c.c0.y * d, c.c0.z * d, c.c0.w * d),
            GpuVec4.of(c.c1.x * d, c.c1.y * d, c.c1.z * d, c.c1.w * d),
            GpuVec4.of(c.c2.x * d, c.c2.y * d, c.c2.z * d, c.c2.w * d),
            GpuVec4.of(c.c3.x * d, c.c3.y * d, c.c3.z * d, c.c3.w * d)
        );
    }

    // Transposed cofactor matrix of `m` — the adjugate, which is the inverse scaled by the
    // determinant. Shared so `determinant` and `inverse` cannot drift apart on sign conventions:
    // expanding `m`'s first row against column 0 of this gives the determinant.
    static fun cofactors4(m: GpuMat4): GpuMat4 {
        // Row-major names over Dream's column-major storage: `r<row><col>`.
        let r00 = m.c0.x; let r01 = m.c1.x; let r02 = m.c2.x; let r03 = m.c3.x;
        let r10 = m.c0.y; let r11 = m.c1.y; let r12 = m.c2.y; let r13 = m.c3.y;
        let r20 = m.c0.z; let r21 = m.c1.z; let r22 = m.c2.z; let r23 = m.c3.z;
        let r30 = m.c0.w; let r31 = m.c1.w; let r32 = m.c2.w; let r33 = m.c3.w;

        // 2x2 minors of the bottom two rows, reused across the top-row cofactors.
        let s0 = r20 * r31 - r30 * r21;
        let s1 = r20 * r32 - r30 * r22;
        let s2 = r20 * r33 - r30 * r23;
        let s3 = r21 * r32 - r31 * r22;
        let s4 = r21 * r33 - r31 * r23;
        let s5 = r22 * r33 - r32 * r23;
        // The same for the top two rows, for the bottom-row cofactors.
        let t0 = r00 * r11 - r10 * r01;
        let t1 = r00 * r12 - r10 * r02;
        let t2 = r00 * r13 - r10 * r03;
        let t3 = r01 * r12 - r11 * r02;
        let t4 = r01 * r13 - r11 * r03;
        let t5 = r02 * r13 - r12 * r03;

        return GpuMat4.of(
            GpuVec4.of(
                r11 * s5 - r12 * s4 + r13 * s3,
                -(r10 * s5) + r12 * s2 - r13 * s1,
                r10 * s4 - r11 * s2 + r13 * s0,
                -(r10 * s3) + r11 * s1 - r12 * s0
            ),
            GpuVec4.of(
                -(r01 * s5) + r02 * s4 - r03 * s3,
                r00 * s5 - r02 * s2 + r03 * s1,
                -(r00 * s4) + r01 * s2 - r03 * s0,
                r00 * s3 - r01 * s1 + r02 * s0
            ),
            GpuVec4.of(
                r31 * t5 - r32 * t4 + r33 * t3,
                -(r30 * t5) + r32 * t2 - r33 * t1,
                r30 * t4 - r31 * t2 + r33 * t0,
                -(r30 * t3) + r31 * t1 - r32 * t0
            ),
            GpuVec4.of(
                -(r21 * t5) + r22 * t4 - r23 * t3,
                r20 * t5 - r22 * t2 + r23 * t1,
                -(r20 * t4) + r21 * t2 - r23 * t0,
                r20 * t3 - r21 * t1 + r22 * t0
            )
        );
    }

    // Number of 1 bits in the 32-bit integer binary representation (WGSL `countOneBits` / popcount).
    //
    // The bit functions all go through `uint` so a negative `int` shifts in zeros rather than
    // sign bits, matching how WGSL counts over a `u32`.
    public static fun count_one_bits(x: int): int {
        let bits = (uint)x;
        let n = 0;
        for (let i = 0; i < 32; i = i + 1) {
            n = n + (int)((bits >> (uint)i) & 1u);
        }
        return n;
    }

    // Reverses the order of the bits in a 32-bit integer (WGSL `reverseBits`).
    public static fun reverse_bits(x: int): int {
        let bits = (uint)x;
        let out = 0u;
        for (let i = 0; i < 32; i = i + 1) {
            out = (out << 1u) | ((bits >> (uint)i) & 1u);
        }
        return (int)out;
    }

    // Number of consecutive zero bits starting from the most significant bit (WGSL `countLeadingZeros` / clz).
    public static fun count_leading_zeros(x: int): int {
        let bits = (uint)x;
        for (let i = 0; i < 32; i = i + 1) {
            if ((bits >> (uint)(31 - i)) & 1u) == 1u { return i; }
        }
        return 32;
    }

    // Number of consecutive zero bits starting from the least significant bit (WGSL `countTrailingZeros` / ctz).
    public static fun count_trailing_zeros(x: int): int {
        let bits = (uint)x;
        for (let i = 0; i < 32; i = i + 1) {
            if ((bits >> (uint)i) & 1u) == 1u { return i; }
        }
        return 32;
    }
}
