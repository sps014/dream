module system.gpu;

// The host handle of one GPU resource, released when its resource is gone. Recorded
// commands pin the handles they name, so the host keeps a released resource until no
// recording uses it and the GPU finished with it.
internal class GpuOwnedHandle {
    internal handle: int;
    owned: bool;

    // `owned` is false for handles another object releases, such as a surface's frame
    // targets.
    internal constructor(handle: int, owned: bool) {
        this.handle = handle;
        this.owned = owned;
    }

    internal fun release(): void {
        if this.handle > 0 && this.owned {
            GpuHost.release(this.handle);
        }
        this.handle = 0;
    }

    del() {
        this.release();
    }
}
