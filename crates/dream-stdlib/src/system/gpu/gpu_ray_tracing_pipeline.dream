module system.gpu;

/// Ray generation, miss, hit group and callable shaders linked into one ray tracing
/// pipeline. Create one with `GpuDevice.ray_tracing_pipeline`; the ray generation shader's
/// generated `GpuShaders` descriptor traces with it.
public class GpuRayTracingPipeline {
    internal device_id: int;
    internal owner: GpuOwnedHandle;

    internal constructor(device_id: int, handle: int) {
        this.device_id = device_id;
        this.owner = GpuOwnedHandle(handle, true);
    }

    internal get handle(): int {
        return this.owner.handle;
    }

    // Runs the ray generation shader once per element of a `width` by `height` by `depth`
    // grid with `args` as its parameters, and waits until the GPU finished.
    internal async fun trace(
        device: GpuDevice,
        width: int,
        height: int,
        depth: int,
        args: GpuArgs
    ): Result<Unit, GpuError> {
        if this.device_id != device.id {
            return Result.Err(GpuError.WrongDevice("ray tracing pipeline"));
        }
        let recording = GpuRecording(device.id, 0);
        recording.op(GpuOp.BeginComputePass);
        recording.check(this.handle, this.device_id, "ray tracing pipeline");
        recording.op(GpuOp.SetPipeline);
        recording.words.push(this.handle);
        recording.bind_args(GpuStage.RayGeneration, args);
        recording.op(GpuOp.TraceRays);
        recording.words.push_all([width, height, depth]);
        recording.op(GpuOp.EndPass);
        return device.submit(GpuCommandBuffer(recording)).await;
    }
}
