module system.gpu;

// Fixed-function blit plus programmable draw helpers for `@vertex` / `@fragment` pipelines.
public class GpuRenderPass {
    // Blits `source` onto `surface` (fullscreen textured triangle).
    @web @native
    public static async fun blit(surface: GpuSurface, source: GpuTexture, token: Option<CancellationToken> = Option.None): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let code = await Gpu.render_blit(surface.id, source.id);
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "blit failed"));
    }

    // Clears the surface (black) and draws `vertex_count` vertices with `pipeline`.
    @web @native
    public static async fun draw<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        vertex_count: int,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        return await GpuRenderPass.draw_ex(
            surface,
            pipeline,
            vertices,
            vertex_count,
            Buffer.alloc<byte>(0),
            GpuVec4.of(0.0, 0.0, 0.0, 1.0),
            token
        );
    }

    // Like `draw`, with shader uniforms (`Uniforms.pack` / `pack_f32`) and a clear color.
    @web @native
    public static async fun draw_ex<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        vertex_count: int,
        uniforms: byte[],
        clear: GpuVec4,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        let no_depth: Option<GpuTexture> = Option.None;
        return await GpuRenderPass.draw_instanced(
            surface,
            pipeline,
            vertices,
            vertex_count,
            1,
            uniforms,
            clear,
            no_depth,
            GpuLoadOp.Clear,
            token
        );
    }

    // Draw with instancing, optional depth attachment, and load-op control.
    @web @native
    public static async fun draw_instanced<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        vertex_count: int,
        instance_count: int,
        uniforms: byte[],
        clear: GpuVec4,
        depth: Option<GpuTexture>,
        load_op: GpuLoadOp,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let depth_id = switch (depth) {
            Some(t) => t.id,
            None => -1,
        };
        let load: int = load_op;
        let code = await Gpu.render_draw_ex(
            surface.id,
            pipeline.id,
            vertices.id,
            vertex_count,
            instance_count,
            uniforms,
            clear.x,
            clear.y,
            clear.z,
            clear.w,
            depth_id,
            load
        );
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "draw failed"));
    }

    // Clears the surface and draws indexed geometry (indices are `int` → WebGPU `uint32`).
    @web @native
    public static async fun draw_indexed<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        indices: GpuBuffer<int>,
        index_count: int,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        return await GpuRenderPass.draw_indexed_ex(
            surface,
            pipeline,
            vertices,
            indices,
            index_count,
            Buffer.alloc<byte>(0),
            GpuVec4.of(0.0, 0.0, 0.0, 1.0),
            token
        );
    }

    // Like `draw_indexed`, with uniforms and clear color.
    @web @native
    public static async fun draw_indexed_ex<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        indices: GpuBuffer<int>,
        index_count: int,
        uniforms: byte[],
        clear: GpuVec4,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        let no_depth: Option<GpuTexture> = Option.None;
        return await GpuRenderPass.draw_indexed_instanced(
            surface,
            pipeline,
            vertices,
            indices,
            index_count,
            1,
            uniforms,
            clear,
            no_depth,
            GpuLoadOp.Clear,
            token
        );
    }

    // Indexed draw with instancing, optional depth, and load-op control.
    @web @native
    public static async fun draw_indexed_instanced<T : unmanaged>(
        surface: GpuSurface,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        indices: GpuBuffer<int>,
        index_count: int,
        instance_count: int,
        uniforms: byte[],
        clear: GpuVec4,
        depth: Option<GpuTexture>,
        load_op: GpuLoadOp,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let depth_id = switch (depth) {
            Some(t) => t.id,
            None => -1,
        };
        let load: int = load_op;
        let code = await Gpu.render_draw_indexed_ex(
            surface.id,
            pipeline.id,
            vertices.id,
            indices.id,
            index_count,
            instance_count,
            uniforms,
            clear.x,
            clear.y,
            clear.z,
            clear.w,
            depth_id,
            load
        );
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "draw_indexed failed"));
    }

    // Draws into an offscreen color texture (optional depth), not the swapchain.
    @web @native
    public static async fun draw_to<T : unmanaged>(
        color: GpuTexture,
        depth: Option<GpuTexture>,
        pipeline: GpuRenderPipeline,
        vertices: GpuBuffer<T>,
        vertex_count: int,
        instance_count: int,
        uniforms: byte[],
        clear: GpuVec4,
        load_op: GpuLoadOp,
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let depth_id = switch (depth) {
            Some(t) => t.id,
            None => -1,
        };
        let load: int = load_op;
        let code = await Gpu.render_draw_to(
            color.id,
            pipeline.id,
            vertices.id,
            vertex_count,
            instance_count,
            uniforms,
            clear.x,
            clear.y,
            clear.z,
            clear.w,
            depth_id,
            load
        );
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "draw_to failed"));
    }
}
