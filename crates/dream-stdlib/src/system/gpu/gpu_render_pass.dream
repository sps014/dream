module system.gpu;

/// A render pass being recorded by `GpuCommandEncoder.render_pass` or `GpuFrame.pass`.
/// The pass is handed to the function that records it and ends when that function returns.
///
/// Set a pipeline, bind resources and buffers, then draw. Settings stay in effect for later
/// draws in the same pass. Recording mistakes are reported by `GpuDevice.submit`, or by
/// `GpuFrame.present` for frame passes.
public class GpuRenderPass {
    recording: GpuRecording;

    internal constructor(recording: GpuRecording) {
        this.recording = recording;
    }

    internal fun begin(desc: GpuRenderPassDesc): void {
        this.recording.check(desc.color_target, desc.color_device, "color target");
        this.recording.op(GpuOp.BeginRenderPass);
        this.recording.words.push(desc.color_target);
        switch (desc.color_load) {
            Clear(color) => {
                this.recording.words.push(1);
                this.recording.words.push(GpuRecording.bits(color.x));
                this.recording.words.push(GpuRecording.bits(color.y));
                this.recording.words.push(GpuRecording.bits(color.z));
                this.recording.words.push(GpuRecording.bits(color.w));
            }
            Keep => {
                this.recording.words.push_all([0, 0, 0, 0, 0]);
            }
        }
        if desc.depth_target != 0 {
            this.recording.check(desc.depth_target, desc.depth_device, "depth target");
        }
        this.recording.words.push(desc.depth_target);
        switch (desc.depth_load) {
            Clear(value) => {
                this.recording.words.push(1);
                this.recording.words.push(GpuRecording.bits(value));
            }
            Keep => {
                this.recording.words.push_all([0, 0]);
            }
        }
    }

    // Ends the pass and appends what it recorded to `into`.
    internal fun finish(into: GpuRecording): void {
        this.recording.op(GpuOp.EndPass);
        into.absorb(this.recording);
    }

    fun bind_one(
        slot: GpuBindingSlot,
        kind: GpuArgKind,
        handle: int,
        device_id: int,
        what: string
    ): void {
        if this.recording.check(handle, device_id, what) {
            let stage: int = slot.stage;
            let k: int = kind;
            this.recording.op(GpuOp.Bind);
            this.recording.words.push_all([stage, slot.index, k, handle, 0]);
        }
    }

    /// Uses `pipeline` for the following draws.
    public fun set_pipeline(pipeline: GpuRenderPipeline): void {
        if this.recording.check(pipeline.handle, pipeline.device_id, "pipeline") {
            this.recording.op(GpuOp.SetPipeline);
            this.recording.words.push(pipeline.handle);
        }
    }

    /// Reads vertices for vertex buffer layout `slot` of the pipeline from `buffer`.
    public fun set_vertex_buffer<T: unmanaged>(slot: int, buffer: GpuBuffer<T>): void {
        if this.recording.check(buffer.handle, buffer.device_id, "vertex buffer") {
            this.recording.op(GpuOp.SetVertexBuffer);
            this.recording.words.push_all([slot, buffer.handle, 0]);
        }
    }

    /// Reads 32-bit indexes for `draw_indexed` from `buffer`.
    public fun set_index_buffer(buffer: GpuBuffer<uint>): void {
        this.index_buffer(buffer.handle, buffer.device_id, GpuIndexFormat.Uint32);
    }

    /// Reads 16-bit indexes for `draw_indexed` from `buffer`.
    public fun set_index_buffer(buffer: GpuBuffer<ushort>): void {
        this.index_buffer(buffer.handle, buffer.device_id, GpuIndexFormat.Uint16);
    }

    fun index_buffer(handle: int, device_id: int, format: GpuIndexFormat): void {
        if this.recording.check(handle, device_id, "index buffer") {
            let f: int = format;
            this.recording.op(GpuOp.SetIndexBuffer);
            this.recording.words.push_all([handle, f, 0]);
        }
    }

    /// Maps clip space onto the rectangle at `x`, `y` of `width` by `height` pixels, with
    /// `(0, 0)` at the top-left of the target. Defaults to the whole target.
    public fun set_viewport(x: float, y: float, width: float, height: float): void {
        this.recording.op(GpuOp.SetViewport);
        this.recording.words.push_all(
            [
                GpuRecording.bits(x),
                GpuRecording.bits(y),
                GpuRecording.bits(width),
                GpuRecording.bits(height),
                GpuRecording.bits(0.0f),
                GpuRecording.bits(1.0f)
            ]
        );
    }

    /// Discards pixels outside the rectangle at `x`, `y` of `width` by `height` pixels.
    /// Defaults to the whole target.
    public fun set_scissor(x: int, y: int, width: int, height: int): void {
        this.recording.op(GpuOp.SetScissor);
        this.recording.words.push_all([x, y, width, height]);
    }

    /// Binds `texture` to the shader parameter `slot`.
    public fun bind(slot: GpuBindingSlot, texture: GpuTexture): void {
        this.bind_one(slot, GpuArgKind.Texture, texture.handle, texture.device_id, "texture");
    }

    /// Binds `sampler` to the shader parameter `slot`.
    public fun bind(slot: GpuBindingSlot, sampler: GpuSampler): void {
        this.bind_one(slot, GpuArgKind.Sampler, sampler.handle, sampler.device_id, "sampler");
    }

    /// Binds `scene` for inline ray queries in a native render shader. The device must
    /// support `GpuFeature.RayQuery`; WebGPU does not support acceleration structures.
    public fun bind(slot: GpuBindingSlot, scene: GpuAccelerationStructure): void {
        this.bind_one(
            slot,
            GpuArgKind.AccelerationStructure,
            scene.handle,
            scene.device_id,
            "acceleration structure"
        );
    }

    /// Binds `buffer` to the `GpuBuffer` shader parameter `slot`.
    public fun bind_buffer<T: unmanaged>(slot: GpuBindingSlot, buffer: GpuBuffer<T>): void {
        this.bind_one(slot, GpuArgKind.Buffer, buffer.handle, buffer.device_id, "buffer");
    }

    /// Sets the scalar, vector, matrix or struct shader parameter `slot` to `value`.
    public fun bind_value<T: unmanaged>(slot: GpuBindingSlot, value: T): void {
        let bytes = Bytes.of(value);
        let offset = this.recording.value(bytes);
        let stage: int = slot.stage;
        let kind: int = GpuArgKind.Value;
        this.recording.op(GpuOp.Bind);
        this.recording.words.push_all([stage, slot.index, kind, offset, bytes.length]);
    }

    /// Draws `vertex_count` vertices, `instance_count` times. The vertex shader sees
    /// `vertex_id()` from `0` and `instance_id()` from `0`.
    public fun draw(vertex_count: int, instance_count: int = 1): void {
        this.recording.op(GpuOp.Draw);
        this.recording.words.push_all([vertex_count, instance_count, 0, 0]);
    }

    /// Draws `index_count` vertices chosen by the index buffer, `instance_count` times.
    public fun draw_indexed(index_count: int, instance_count: int = 1): void {
        this.recording.op(GpuOp.DrawIndexed);
        this.recording.words.push_all([index_count, instance_count, 0, 0, 0]);
    }
}
