module system.gpu;

/// A render pass being recorded: draws into the targets given to
/// `GpuCommandEncoder.begin_render_pass`, or into a window frame through `GpuFrame.pass`.
///
/// Set a pipeline, bind resources and buffers, then draw. Settings stay in effect for later
/// draws in the same pass. Recording mistakes are reported by `GpuDevice.submit`, or by
/// `GpuFrame.present` for frame passes.
public class GpuRenderPass {
    encoder: GpuCommandEncoder;
    ended: bool;

    internal constructor(encoder: GpuCommandEncoder) {
        this.encoder = encoder;
        this.ended = false;
    }

    fun record(code: GpuOp): bool {
        if this.ended {
            this.encoder.fail(GpuError.Validation("a command was recorded after the pass ended"));
            return false;
        }
        this.encoder.op(code);
        return true;
    }

    fun bind_one(
        slot: GpuBindingSlot,
        kind: GpuArgKind,
        owner: GpuOwnedHandle,
        device_id: int,
        what: string
    ): void {
        if !this.encoder.check(owner, device_id, what) {
            return;
        }
        if this.record(GpuOp.Bind) {
            let stage: int = slot.stage;
            let k: int = kind;
            this.encoder.words.push_all([stage, slot.index, k, owner.handle, 0]);
        }
    }

    /// Uses `pipeline` for the following draws.
    public fun set_pipeline(pipeline: GpuRenderPipeline): void {
        if !this.encoder.check(pipeline.owner, pipeline.device_id, "pipeline") {
            return;
        }
        if this.record(GpuOp.SetPipeline) {
            this.encoder.words.push(pipeline.handle);
        }
    }

    /// Reads vertices for vertex buffer layout `slot` of the pipeline from `buffer`.
    public fun set_vertex_buffer<T: unmanaged>(slot: int, buffer: GpuBuffer<T>): void {
        if !this.encoder.check(buffer.owner, buffer.device_id, "vertex buffer") {
            return;
        }
        if this.record(GpuOp.SetVertexBuffer) {
            this.encoder.words.push_all([slot, buffer.handle, 0]);
        }
    }

    /// Reads 32-bit indexes for `draw_indexed` from `buffer`.
    public fun set_index_buffer(buffer: GpuBuffer<uint>): void {
        this.index_buffer(buffer.owner, buffer.device_id, GpuIndexFormat.Uint32);
    }

    /// Reads 16-bit indexes for `draw_indexed` from `buffer`.
    public fun set_index_buffer(buffer: GpuBuffer<ushort>): void {
        this.index_buffer(buffer.owner, buffer.device_id, GpuIndexFormat.Uint16);
    }

    fun index_buffer(owner: GpuOwnedHandle, device_id: int, format: GpuIndexFormat): void {
        if !this.encoder.check(owner, device_id, "index buffer") {
            return;
        }
        if this.record(GpuOp.SetIndexBuffer) {
            let f: int = format;
            this.encoder.words.push_all([owner.handle, f, 0]);
        }
    }

    /// Maps clip space onto the rectangle at `x`, `y` of `width` by `height` pixels, with
    /// `(0, 0)` at the top-left of the target. Defaults to the whole target.
    public fun set_viewport(x: float, y: float, width: float, height: float): void {
        if this.record(GpuOp.SetViewport) {
            this.encoder.words.push_all(
                [
                    GpuCommandEncoder.bits(x),
                    GpuCommandEncoder.bits(y),
                    GpuCommandEncoder.bits(width),
                    GpuCommandEncoder.bits(height),
                    GpuCommandEncoder.bits(0.0f),
                    GpuCommandEncoder.bits(1.0f)
                ]
            );
        }
    }

    /// Discards pixels outside the rectangle at `x`, `y` of `width` by `height` pixels.
    /// Defaults to the whole target.
    public fun set_scissor(x: int, y: int, width: int, height: int): void {
        if this.record(GpuOp.SetScissor) {
            this.encoder.words.push_all([x, y, width, height]);
        }
    }

    /// Binds `texture` to the shader parameter `slot`.
    public fun bind(slot: GpuBindingSlot, texture: GpuTexture): void {
        this.bind_one(slot, GpuArgKind.Texture, texture.owner, texture.device_id, "texture");
    }

    /// Binds `sampler` to the shader parameter `slot`.
    public fun bind(slot: GpuBindingSlot, sampler: GpuSampler): void {
        this.bind_one(slot, GpuArgKind.Sampler, sampler.owner, sampler.device_id, "sampler");
    }

    /// Binds `scene` for inline ray queries in a native render shader. The device must
    /// support `GpuFeature.RayQuery`; WebGPU does not support acceleration structures.
    public fun bind(slot: GpuBindingSlot, scene: GpuAccelerationStructure): void {
        this.bind_one(
            slot,
            GpuArgKind.AccelerationStructure,
            scene.owner,
            scene.device_id,
            "acceleration structure"
        );
    }

    /// Binds `buffer` to the `GpuBuffer` shader parameter `slot`.
    public fun bind_buffer<T: unmanaged>(slot: GpuBindingSlot, buffer: GpuBuffer<T>): void {
        this.bind_one(slot, GpuArgKind.Buffer, buffer.owner, buffer.device_id, "buffer");
    }

    /// Sets the scalar, vector, matrix or struct shader parameter `slot` to `value`.
    public fun bind_value<T: unmanaged>(slot: GpuBindingSlot, value: T): void {
        if !this.record(GpuOp.Bind) {
            return;
        }
        let bytes = Bytes.of(value);
        let offset = this.encoder.data.length;
        this.encoder.data.push_all(bytes);
        let stage: int = slot.stage;
        let kind: int = GpuArgKind.Value;
        this.encoder.words.push_all([stage, slot.index, kind, offset, bytes.length]);
    }

    /// Draws `vertex_count` vertices, `instance_count` times. The vertex shader sees
    /// `vertex_id()` from `0` and `instance_id()` from `0`.
    public fun draw(vertex_count: int, instance_count: int = 1): void {
        if this.record(GpuOp.Draw) {
            this.encoder.words.push_all([vertex_count, instance_count, 0, 0]);
        }
    }

    /// Draws `index_count` vertices chosen by the index buffer, `instance_count` times.
    public fun draw_indexed(index_count: int, instance_count: int = 1): void {
        if this.record(GpuOp.DrawIndexed) {
            this.encoder.words.push_all([index_count, instance_count, 0, 0, 0]);
        }
    }

    /// Ends the pass. Ending it twice does nothing.
    public fun end(): void {
        if !this.ended {
            this.ended = true;
            this.encoder.op(GpuOp.EndPass);
            this.encoder.in_pass = false;
        }
    }
}
