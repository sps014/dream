module system.gpu;

// Render pipeline linking a `@vertex` + `@fragment` pair.
public class GpuRenderPipeline {
    _id: int;

    internal constructor() {}

    public get id(): int {
        return this._id;
    }

    // Compiles and caches a render pipeline for the named Dream shaders.
    // Available on web and native (`dream run` / wgpu); string-literal pairing is checked at compile time.
    public static async fun create(vertex: string, fragment: string, token: Option<CancellationToken> = Option.None): Result<GpuRenderPipeline, GpuError> {
        return await GpuRenderPipeline.create_ex(vertex, fragment, GpuRenderPipelineDesc.defaults(), token);
    }

    // Like `create`, with fixed-function state (topology, cull, depth, blend, MSAA).
    public static async fun create_ex(
        vertex: string,
        fragment: string,
        desc: GpuRenderPipelineDesc,
        token: Option<CancellationToken> = Option.None
    ): Result<GpuRenderPipeline, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let depth_en = 0;
        if desc.depth_enabled { depth_en = 1; }
        let depth_wr = 0;
        if desc.depth_write { depth_wr = 1; }
        let blend_en = 0;
        if desc.blend_enabled { blend_en = 1; }
        let id = await Gpu.render_pipeline_create_ex(
            vertex,
            fragment,
            desc.topology,
            desc.cull_mode,
            desc.front_face,
            depth_en,
            depth_wr,
            desc.depth_compare,
            blend_en,
            desc.sample_count
        );
        if id < 0 {
            return Result.Err(GpuError.from_code(-id, "GpuRenderPipeline.create failed"));
        }
        let p = GpuRenderPipeline();
        p._id = id;
        return Result.Ok(p);
    }

    // Releases the host pipeline resource.
    public fun destroy(): void {
        Gpu.render_pipeline_destroy(this.id);
        this._id = -1;
    }
}
