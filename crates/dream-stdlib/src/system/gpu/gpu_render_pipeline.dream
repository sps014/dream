module system.gpu;

// Render pipeline linking a `@vertex` + `@fragment` pair.

public class GpuRenderPipeline {
    public id: int;

    // Compiles and caches a render pipeline for the named Dream shaders.
    // Not `@web`-only so string-literal pairing can be checked at compile time on every target;
    // native hosts still return an error code (no WebGPU device).
    public static async fun create(vertex: string, fragment: string): Result<GpuRenderPipeline, GpuError> {
        return await GpuRenderPipeline.create_ex(vertex, fragment, GpuRenderPipelineDesc.defaults());
    }

    /// Like `create`, with fixed-function state (topology, cull, depth, blend, MSAA).
    public static async fun create_ex(
        vertex: string,
        fragment: string,
        desc: GpuRenderPipelineDesc
    ): Result<GpuRenderPipeline, GpuError> {
        let depth_en = 0;
        if (desc.depth_enabled) { depth_en = 1; }
        let depth_wr = 0;
        if (desc.depth_write) { depth_wr = 1; }
        let blend_en = 0;
        if (desc.blend_enabled) { blend_en = 1; }
        let id = await Gpu.render_pipeline_create_ex(
            vertex,
            fragment,
            desc.topology,
            desc.cull_mode,
            desc.front_face,
            depth_en,
            depth_wr,
            desc.depth_compare,
            blend_en,
            desc.sample_count
        );
        if (id < 0) {
            return Result.Err(GpuError.from_code(-id, "GpuRenderPipeline.create failed"));
        }
        let p = GpuRenderPipeline();
        p.id = id;
        return Result.Ok(p);
    }
}
