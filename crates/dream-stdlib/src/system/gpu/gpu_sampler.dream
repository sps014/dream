module system.gpu;

// Sampling state for texture reads (`textureSample` / `textureSampleLevel`).
public class GpuSampler {
    // Host sampler handle id.
    public id: int;

    // Linear filtering sampler (clamp-to-edge).
    public static fun linear(): GpuSampler {
        let s = GpuSampler();
        s.id = Gpu.sampler_create(1);
        return s;
    }

    // Nearest-neighbor filtering sampler (clamp-to-edge).
    public static fun nearest(): GpuSampler {
        let s = GpuSampler();
        s.id = Gpu.sampler_create(0);
        return s;
    }

    // Custom filter / address / mip mode (named enums; host ints match discriminants).
    public static fun create(
        filter: GpuFilterMode,
        address: GpuAddressMode,
        mip_filter: GpuFilterMode
    ): GpuSampler {
        let f: int = filter;
        let a: int = address;
        let m: int = mip_filter;
        let s = GpuSampler();
        s.id = Gpu.sampler_create_ex(f, a, m);
        return s;
    }

    // Releases the host sampler resource.
    public fun destroy(): void {
        Gpu.sampler_destroy(this.id);
        this.id = -1;
    }
}
