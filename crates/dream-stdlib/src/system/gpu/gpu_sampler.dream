module system.gpu;

// Sampling state for texture reads (`textureSample` / `textureSampleLevel`).
public class GpuSampler {
    _id: int;

    internal constructor() {}

    public get id(): int {
        return this._id;
    }

    // Trilinear, clamp-to-edge.
    public static fun linear(): GpuSampler {
        return GpuSampler.create(GpuSamplerDesc.linear());
    }

    // Nearest-neighbor, clamp-to-edge.
    public static fun nearest(): GpuSampler {
        return GpuSampler.create(GpuSamplerDesc.nearest());
    }

    // Builds a sampler from full state: filters, per-axis addressing, LOD clamp, anisotropy, and
    // an optional depth comparison.
    public static fun create(desc: GpuSamplerDesc): GpuSampler {
        let mag: int = desc.mag_filter;
        let min: int = desc.min_filter;
        let mip: int = desc.mip_filter;
        let au: int = desc.address_u;
        let av: int = desc.address_v;
        let aw: int = desc.address_w;
        let compare: int = -1;
        if desc.compare.is_some() {
            let c: int = desc.compare.unwrap();
            compare = c;
        }
        let s = GpuSampler();
        s._id = Gpu.sampler_create(
            mag,
            min,
            mip,
            au,
            av,
            aw,
            desc.lod_min,
            desc.lod_max,
            compare,
            desc.max_anisotropy
        );
        return s;
    }

    // Releases the host sampler resource.
    public fun destroy(): void {
        Gpu.sampler_destroy(this.id);
        this._id = -1;
    }
}
