module system.gpu;

// Every shader bundle the generator embedded, registered by generated module globals before
// `main` runs so `GpuDevice.create` knows which backends this build can drive.
let gpu_shader_libraries: List<GpuShaderLibrary> = List<GpuShaderLibrary>();

// One generated shader bundle: the compiled code of one module's shaders for every backend
// in `backends`. Devices load it lazily, once each. The registry owns every library; shaders
// name theirs by registry index.
internal class GpuShaderLibrary {
    internal name: string;
    internal bundle: byte[];
    internal backends: List<GpuBackend>;
    embedded: bool;

    constructor(name: string, bundle: byte[], backends: GpuBackend[], embedded: bool) {
        this.embedded = embedded;
        this.name = name;
        this.bundle = bundle;
        this.backends = List<GpuBackend>(backends);
    }

    internal static fun register(
        name: string,
        bundle: byte[],
        backends: GpuBackend[],
        embedded: bool
    ): int {
        gpu_shader_libraries.push(GpuShaderLibrary(name, bundle, backends, embedded));
        return gpu_shader_libraries.length - 1;
    }

    // The name of the library `register` returned `index` for.
    internal static fun name_of(index: int): string {
        return gpu_shader_libraries[index].name;
    }

    internal static fun backends_of(index: int): List<GpuBackend> {
        return gpu_shader_libraries[index].backends.copy();
    }

    internal static fun has_backend(index: int, backend: GpuBackend): bool {
        return gpu_shader_libraries[index].backends.contains(backend);
    }

    // Loads the library's code for `device`, returning the host's library handle.
    internal static fun load(index: int, device: int): int {
        return GpuHost.library_load(device, gpu_shader_libraries[index].bundle);
    }

    // Library implementation shaders must not broaden Auto beyond application shader targets.
    internal static fun compiled_mask(): int {
        let application = 0;
        let embedded = 0;
        for (let library in gpu_shader_libraries) {
            for (let backend in library.backends) {
                let bit: int = backend;
                if library.embedded {
                    embedded = embedded | (1 << bit);
                } else {
                    application = application | (1 << bit);
                }
            }
        }
        if application != 0 {
            return application;
        }
        return embedded;
    }
}
