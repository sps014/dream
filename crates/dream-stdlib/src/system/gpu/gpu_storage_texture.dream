module system.gpu;

import system.codegen;

/// A 2D texture that shaders write texel by texel, such as the image a ray tracer renders.
///
/// Create one with `GpuDevice.storage_texture`. Inside a shader, `texture[coordinate]`
/// reads and writes the texel at an integer pixel coordinate. On the CPU, `read` downloads
/// every texel after the GPU finished.
public class GpuStorageTexture<T: unmanaged> {
    internal device_id: int;
    internal owner: GpuOwnedHandle;
    texture_width: int;
    texture_height: int;
    texture_format: GpuTextureFormat;

    internal constructor(
        device_id: int,
        handle: int,
        width: int,
        height: int,
        format: GpuTextureFormat
    ) {
        this.device_id = device_id;
        this.owner = GpuOwnedHandle(handle, true);
        this.texture_width = width;
        this.texture_height = height;
        this.texture_format = format;
    }

    internal get handle(): int {
        return this.owner.handle;
    }

    internal static fun format_of(): Result<GpuTextureFormat, GpuError> {
        let name = typeof(Buffer.zero<T>());
        if name == "GpuVec4" {
            return Result.Ok(GpuTextureFormat.Rgba32Float);
        }
        if name == "GpuVec2" {
            return Result.Ok(GpuTextureFormat.Rg32Float);
        }
        if name == "float" {
            return Result.Ok(GpuTextureFormat.R32Float);
        }
        if name == "uint" {
            return Result.Ok(GpuTextureFormat.R32Uint);
        }
        return Result.Err(
            GpuError.InvalidResource(
                "storage textures hold GpuVec4, GpuVec2, float or uint, not " + name
            )
        );
    }

    /// Width in texels.
    public get width(): int {
        return this.texture_width;
    }

    /// Height in texels.
    public get height(): int {
        return this.texture_height;
    }

    /// The storage format chosen from `T`.
    public get format(): GpuTextureFormat {
        return this.texture_format;
    }

    /// Downloads every texel, row by row from the top. It waits for submitted GPU work that
    /// writes the texture.
    public async fun read(): Result<T[], GpuError> {
        if this.handle == 0 {
            return Result.Err(GpuError.InvalidResource("the texture was destroyed"));
        }
        let count = this.texture_width * this.texture_height;
        let bytes = GpuHost.texture_read(this.handle, 0, 0).await;
        if bytes.length != count * GpuBuffer<T>.stride() {
            return Result.Err(GpuHost.error());
        }
        return Result.Ok(GpuBuffer<T>.decode(bytes, count));
    }

    /// Releases the GPU memory once submitted work that uses it has finished.
    public fun destroy(): void {
        this.owner.release();
    }

    /// Reads the texel at `coordinate` inside a shader.
    @generator_only(
        ComputeAttribute,
        FragmentAttribute,
        RayGenerationAttribute,
        ClosestHitAttribute,
        AnyHitAttribute,
        MissAttribute,
        IntersectionAttribute,
        CallableAttribute
    )
    public extern fun this[coordinate: GpuIVec2]: T;

    /// Writes the texel at `coordinate` inside a shader. Writes outside the texture are dropped.
    @generator_only(
        ComputeAttribute,
        FragmentAttribute,
        RayGenerationAttribute,
        ClosestHitAttribute,
        AnyHitAttribute,
        MissAttribute,
        IntersectionAttribute,
        CallableAttribute
    )
    public extern fun this[coordinate: GpuIVec2] = value: T;
}
