module system.gpu;

// RGBA / depth / cube textures for compute paint and render passes.

public class GpuTexture {
    public id: int;
    public width: int;
    public height: int;
    /// `"rgba8unorm"`, `"rgba16float"`, `"depth24plus"`, or `"cube-rgba8unorm"`.
    public format: string;

    // Allocates an empty RGBA8 texture of `width`×`height`.
    public static fun rgba8(width: int, height: int): GpuTexture {
        let t = GpuTexture();
        t.id = Gpu.texture_create_rgba8(width, height);
        t.width = width;
        t.height = height;
        t.format = "rgba8unorm";
        return t;
    }

    /// Depth attachment texture (`depth24plus`) for mesh pipelines.
    public static fun depth24(width: int, height: int): GpuTexture {
        let t = GpuTexture();
        t.id = Gpu.texture_create_depth(width, height);
        t.width = width;
        t.height = height;
        t.format = "depth24plus";
        return t;
    }

    /// HDR color texture (`rgba16float`) for post / bloom targets.
    public static fun rgba16float(width: int, height: int): GpuTexture {
        let t = GpuTexture();
        t.id = Gpu.texture_create_rgba16float(width, height);
        t.width = width;
        t.height = height;
        t.format = "rgba16float";
        return t;
    }

    /// Cube map with six `size`×`size` RGBA8 faces.
    public static fun cube_rgba8(size: int): GpuTexture {
        let t = GpuTexture();
        t.id = Gpu.texture_create_cube_rgba8(size);
        t.width = size;
        t.height = size;
        t.format = "cube-rgba8unorm";
        return t;
    }

    // Uploads a full-texture RGBA8 pixel buffer.
    public async fun write_rgba(pixels: byte[]): Result<bool, GpuError> {
        let code = await Gpu.texture_write_rgba(this.id, pixels, 0, 0, this.width, this.height);
        if (code == 0) { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "texture write failed"));
    }

    // Uploads an RGBA8 sub-rectangle at (`x`, `y`) of size `w`×`h`.
    public async fun write_rgba_at(
        x: int,
        y: int,
        w: int,
        h: int,
        pixels: byte[]
    ): Result<bool, GpuError> {
        let code = await Gpu.texture_write_rgba(this.id, pixels, x, y, w, h);
        if (code == 0) { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "texture write_at failed"));
    }

    // Downloads the full texture as RGBA8 bytes.
    public async fun read_rgba(): byte[] {
        return await Gpu.texture_read_rgba(this.id);
    }

    // GPU-side copy from a tightly packed RGBA8 buffer (bytes = width×height×4 for a full copy).
    public fun copy_from_buffer(src: GpuBuffer<byte>, byte_offset: int): void {
        Gpu.texture_copy_from_buffer(this.id, src.id, byte_offset, 0, 0, this.width, this.height);
    }

    // GPU-side copy of the full texture into a byte buffer (must hold width×height×4 bytes).
    public fun copy_to_buffer(dst: GpuBuffer<byte>, byte_offset: int): void {
        Gpu.texture_copy_to_buffer(this.id, dst.id, byte_offset, 0, 0, this.width, this.height);
    }
}
