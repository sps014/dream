module system.gpu;

// A GPU texture of any format and shape the adapter supports.
//
// `create` takes a `GpuTextureDesc`; the named constructors below are the common shapes spelled
// out. Allocation can fail — a block-compressed format on an adapter without that feature, or an
// impossible shape like a multisampled mip chain — so `create` returns a `Result`.
public class GpuTexture {
    _id: int;
    public width: int;
    public height: int;
    // Slices for `D3`, array layers otherwise. `6` for a cubemap.
    public depth_or_layers: int;
    public mip_levels: int;
    public sample_count: int;
    public format: GpuTextureFormat;
    public view_dimension: GpuTextureViewDimension;

    internal constructor() {}

    public get id(): int {
        return this._id;
    }

    // Asks the host for a texture matching `desc`. Negative results are `GpuError` codes.
    static fun allocate(desc: GpuTextureDesc): int {
        let access: int = -1;
        if desc.storage_access.is_some() {
            let a: int = desc.storage_access.unwrap();
            access = a;
        }
        let format: int = desc.format;
        let dimension: int = desc.dimension;
        let view: int = desc.view_dimension;
        return Gpu.texture_create(
            format,
            dimension,
            desc.width,
            desc.height,
            desc.depth_or_layers,
            desc.mip_levels,
            desc.sample_count,
            access,
            view
        );
    }

    static fun wrap(id: int, desc: GpuTextureDesc): GpuTexture {
        let t = GpuTexture();
        t._id = id;
        t.width = desc.width;
        t.height = desc.height;
        t.depth_or_layers = desc.depth_or_layers;
        t.mip_levels = desc.mip_levels;
        t.sample_count = desc.sample_count;
        t.format = desc.format;
        t.view_dimension = desc.view_dimension;
        return t;
    }

    // Allocates a texture matching `desc`.
    public static fun create(desc: GpuTextureDesc): Result<GpuTexture, GpuError> {
        let id = GpuTexture.allocate(desc);
        if id < 0 {
            return Result.Err(GpuError.from_code(-id, "GpuTexture.create failed"));
        }
        return Result.Ok(GpuTexture.wrap(id, desc));
    }

    // The shapes below use always-available formats and shapes the host clamps rather than
    // rejects, so they allocate directly instead of going through the fallible `create`.

    // An empty RGBA8 texture of `width`×`height`.
    public static fun rgba8(width: int, height: int): GpuTexture {
        let d = GpuTextureDesc.d2(width, height, GpuTextureFormat.Rgba8Unorm);
        return GpuTexture.wrap(GpuTexture.allocate(d), d);
    }

    // Decodes PNG or JPEG bytes into a new RGBA8 2D texture. The alpha channel is kept
    // straight (not premultiplied). Fails with `GpuError.unsupported` for an unknown codec or an
    // image larger than 8192 on an edge, and `GpuError.validation` for empty input.
    public static async fun from_image_bytes(
        data: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<GpuTexture, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let packed = Gpu.texture_from_image_bytes(data).await;
        if packed.length >= 3 {
            let d = GpuTextureDesc.d2(packed[1], packed[2], GpuTextureFormat.Rgba8Unorm);
            return Result.Ok(GpuTexture.wrap(packed[0], d));
        }
        let code = 4;
        if packed.length == 1 && packed[0] < 0 {
            code = 0 - packed[0];
        }
        return Result.Err(GpuError.from_code(code, "GpuTexture.from_image_bytes failed"));
    }

    // Depth attachment texture (`depth24plus`) for mesh pipelines.
    public static fun depth24(width: int, height: int): GpuTexture {
        let d = GpuTextureDesc.d2(width, height, GpuTextureFormat.Depth24Plus);
        return GpuTexture.wrap(GpuTexture.allocate(d), d);
    }

    // HDR color texture (`rgba16float`) for post / bloom targets.
    public static fun rgba16float(width: int, height: int): GpuTexture {
        let d = GpuTextureDesc.d2(width, height, GpuTextureFormat.Rgba16Float);
        return GpuTexture.wrap(GpuTexture.allocate(d), d);
    }

    // Cube map with six `size`×`size` RGBA8 faces.
    public static fun cube_rgba8(size: int): GpuTexture {
        let d = GpuTextureDesc.cube(size, GpuTextureFormat.Rgba8Unorm);
        return GpuTexture.wrap(GpuTexture.allocate(d), d);
    }

    // Uploads a full-texture RGBA8 pixel buffer.
    public async fun write_rgba(pixels: byte[], token: Option<CancellationToken> = Option.None): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let code = Gpu.texture_write_rgba(this.id, pixels, 0, 0, this.width, this.height).await;
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "texture write failed"));
    }

    // Uploads an RGBA8 sub-rectangle at (`x`, `y`) of size `w`×`h`.
    public async fun write_rgba_at(
        x: int,
        y: int,
        w: int,
        h: int,
        pixels: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<bool, GpuError> {
        CancellationToken.rejected(token, GpuError.cancelled())?;
        let code = Gpu.texture_write_rgba(this.id, pixels, x, y, w, h).await;
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "texture write_at failed"));
    }

    // Downloads the full texture as RGBA8 bytes.
    public async fun read_rgba(token: Option<CancellationToken> = Option.None): byte[] {
        CancellationToken.throw_if_opt(token);
        return Gpu.texture_read_rgba(this.id).await;
    }

    // GPU-side copy from a tightly packed RGBA8 buffer (bytes = width×height×4 for a full copy).
    public fun copy_from_buffer(src: GpuBuffer<byte>, byte_offset: int): void {
        Gpu.texture_copy_from_buffer(this.id, src.id, byte_offset, 0, 0, this.width, this.height);
    }

    // GPU-side copy of the full texture into a byte buffer (must hold width×height×4 bytes).
    public fun copy_to_buffer(dst: GpuBuffer<byte>, byte_offset: int): void {
        Gpu.texture_copy_to_buffer(this.id, dst.id, byte_offset, 0, 0, this.width, this.height);
    }

    // GPU-side copy from `src` into this texture at `(dst_x, dst_y)`.
    public fun copy_from(src: GpuTexture, src_x: int, src_y: int, dst_x: int, dst_y: int, w: int, h: int): void {
        Gpu.texture_copy(src.id, this.id, src_x, src_y, dst_x, dst_y, w, h);
    }

    // Generates mip levels for this texture (rgba8); returns `Err` when unsupported.
    public fun generate_mipmaps(): Result<bool, GpuError> {
        let code = Gpu.texture_generate_mipmaps(this.id);
        if code == 0 { return Result.Ok(true); }
        return Result.Err(GpuError.from_code(code, "generate_mipmaps failed"));
    }

    // Releases the host texture resource.
    public fun destroy(): void {
        Gpu.texture_destroy(this.id);
        this._id = -1;
    }
}
