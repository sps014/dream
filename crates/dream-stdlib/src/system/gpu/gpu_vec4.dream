module system.gpu;

/// A vector of four `float`s, laid out like a GPU `float4`, for RGBA colors, clip-space
/// positions and homogeneous coordinates.
///
/// Use it on the CPU and in shaders alike. Arithmetic works component by component, and a
/// `float` operand applies to every component.
public struct GpuVec4 {
    /// The first component, or red.
    public x: float;

    /// The second component, or green.
    public y: float;

    /// The third component, or blue.
    public z: float;

    /// The fourth component, or alpha.
    public w: float;

    /// Creates the vector `(x, y, z, w)`.
    public constructor(x: float, y: float, z: float, w: float) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.w = w;
    }

    /// Creates a vector with every component equal to `value`.
    public constructor(value: float) {
        this.x = value;
        this.y = value;
        this.z = value;
        this.w = value;
    }

    /// The first two components.
    public get xy(): GpuVec2 {
        return GpuVec2(this.x, this.y);
    }

    /// The first three components.
    public get xyz(): GpuVec3 {
        return GpuVec3(this.x, this.y, this.z);
    }

    /// Adds component by component.
    fun operator +(other: GpuVec4): GpuVec4 {
        return GpuVec4(this.x + other.x, this.y + other.y, this.z + other.z, this.w + other.w);
    }

    /// Subtracts component by component.
    fun operator -(other: GpuVec4): GpuVec4 {
        return GpuVec4(this.x - other.x, this.y - other.y, this.z - other.z, this.w - other.w);
    }

    /// Multiplies component by component.
    fun operator *(other: GpuVec4): GpuVec4 {
        return GpuVec4(this.x * other.x, this.y * other.y, this.z * other.z, this.w * other.w);
    }

    /// Multiplies every component by `scale`.
    fun operator *(scale: float): GpuVec4 {
        return GpuVec4(this.x * scale, this.y * scale, this.z * scale, this.w * scale);
    }

    /// Divides component by component.
    fun operator /(other: GpuVec4): GpuVec4 {
        return GpuVec4(this.x / other.x, this.y / other.y, this.z / other.z, this.w / other.w);
    }

    /// Divides every component by `divisor`.
    fun operator /(divisor: float): GpuVec4 {
        return GpuVec4(this.x / divisor, this.y / divisor, this.z / divisor, this.w / divisor);
    }

    /// Negates every component.
    fun operator -(): GpuVec4 {
        return GpuVec4(-this.x, -this.y, -this.z, -this.w);
    }

    /// True when all components are equal.
    fun operator ==(other: GpuVec4): bool {
        return this.x == other.x && this.y == other.y && this.z == other.z && this.w == other.w;
    }

    /// The dot product.
    public fun dot(other: GpuVec4): float {
        return this.x * other.x + this.y * other.y + this.z * other.z + this.w * other.w;
    }

    /// The vector's Euclidean length.
    public fun length(): float {
        return (float)Math.sqrt((double)this.dot(this));
    }

    /// The vector scaled to length `1`. A zero vector gives non-finite components.
    public fun normalize(): GpuVec4 {
        return this / this.length();
    }
}
