module system.gpu;

import system.codegen;

/// This thread's position in the whole compute dispatch: `workgroup_id() * workgroup size +
/// local_id()`. With `GpuDispatch.threads_1d(n)`, `global_id().x` runs from `0` to at
/// least `n - 1`.
@generator_only(ComputeAttribute)
public extern fun global_id(): GpuIVec3;

/// This thread's position within its workgroup, from `0` to the `@compute` size minus one.
@generator_only(ComputeAttribute)
public extern fun local_id(): GpuIVec3;

/// `local_id()` flattened to one number: `x + y * size.x + z * size.x * size.y`.
@generator_only(ComputeAttribute)
public extern fun local_index(): int;

/// This thread's workgroup's position in the dispatch.
@generator_only(ComputeAttribute)
public extern fun workgroup_id(): GpuIVec3;

/// The number of workgroups in the dispatch.
@generator_only(ComputeAttribute)
public extern fun workgroup_count(): GpuIVec3;

/// Waits until every thread of the workgroup reaches this call, and makes their earlier
/// writes to workgroup memory visible. Every thread must reach the same call.
@generator_only(ComputeAttribute)
public extern fun workgroup_barrier(): void;

/// Like `workgroup_barrier`, and also makes the workgroup's earlier buffer writes visible
/// to each other.
@generator_only(ComputeAttribute)
public extern fun storage_barrier(): void;

/// Declares `length` elements of workgroup memory, shared by every thread of the workgroup
/// and uninitialized at the start. `length` must be a constant. Call it once per array at
/// the top of the shader.
@generator_only(ComputeAttribute)
public extern fun workgroup_array<T>(length: int): GpuWorkgroupArray<T>;

/// The index of the vertex being processed: `0` to the draw's vertex count minus one, or
/// the index buffer's value for indexed draws.
@generator_only(VertexAttribute)
public extern fun vertex_id(): int;

/// The index of the instance being drawn, from `0`.
@generator_only(VertexAttribute)
public extern fun instance_id(): int;

/// Discards the current pixel: nothing is written for it. The shader stops at this call.
@generator_only(FragmentAttribute)
public extern fun discard_fragment(): void;
