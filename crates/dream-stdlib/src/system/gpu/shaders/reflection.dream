module system.gpu.shaders;

import system;
import system.collections;
import system.json;

// Where one bindable parameter lives in one target's code, read from `slangc -reflection-json`:
// the descriptor set/space and binding (Metal: the buffer, texture or sampler index), and for
// value parameters the byte range inside the entry's uniform block.
internal class Reflection {
    internal space: int;
    internal binding: int;
    internal offset: int;
    internal size: int;
    internal found: bool;
    internal webgpu_layout: WebGpuBindingLayout;

    internal constructor() {
        this.space = 0;
        this.binding = 0;
        this.offset = 0;
        this.size = 0;
        this.found = false;
        this.webgpu_layout = WebGpuBindingLayout.None;
    }

    // One `Reflection` per bindable parameter of `entry`, in parameter order. Parameters the
    // reflection does not mention keep `found == false`.
    internal static fun parse(
        borrow text: string,
        borrow entry: ShaderEntry,
        webgpu: bool
    ): List<Reflection> {
        let out = List<Reflection>();
        let globals = JsonValue.array();
        switch (Json.parse(text)) {
            Ok(root) => {
                globals = root.get("parameters").unwrap_or(JsonValue.array());
            }
            Err(_) => {}
        }
        let items = globals.as_array().unwrap_or(List<JsonValue>());
        for (let p in entry.bindable()) {
            let r = Reflection();
            let global = p.global;
            if p.is_value() {
                global = entry.uniform_block();
            }
            for (let g in items) {
                if g.get("name").and_then((item: JsonValue) => item.as_string()).unwrap_or("") != global {
                    continue;
                }
                let binding = Reflection.binding_of(g);
                let kind = binding.get("kind").and_then((item: JsonValue) => item.as_string()).unwrap_or("");
                if kind == "registerSpace" || kind == "subElementRegisterSpace" {
                    r.space = binding.get("index").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                } else {
                    r.binding = binding.get("index").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                    r.space = binding.get("space").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                    // CUDA resources and constant buffers are pointers in the uniform block.
                    if kind == "uniform" {
                        r.binding = binding.get("offset").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                    }
                }
                r.found = true;
                if webgpu {
                    r.webgpu_layout = WebGpuLayout.of(g.get("type").unwrap_or(JsonValue.dict()), p);
                }
                if p.is_value() {
                    r.found = false;
                    let fields = g.get("type").unwrap_or(JsonValue.dict())
                        .get("elementType").unwrap_or(JsonValue.dict())
                        .get("fields").unwrap_or(JsonValue.array())
                        .as_array()
                        .unwrap_or(List<JsonValue>());
                    for (let f in fields) {
                        if f.get("name").and_then((item: JsonValue) => item.as_string()).unwrap_or("") == p.global {
                            let layout = f.get("binding").unwrap_or(JsonValue.dict());
                            r.offset = layout.get("offset").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                            r.size = layout.get("size").and_then((item: JsonValue) => item.as_int()).unwrap_or(0);
                            r.found = true;
                        }
                    }
                }
            }
            out.push(r);
        }
        return out;
    }

    static fun binding_of(borrow g: JsonValue): JsonValue {
        let single = g.get("binding").unwrap_or(JsonValue.null());
        if single.is_object() {
            return single;
        }
        let many = g.get("bindings").unwrap_or(JsonValue.array()).as_array().unwrap_or(List<JsonValue>());
        for (let b in many) {
            if b.get("kind").and_then((item: JsonValue) => item.as_string()).unwrap_or("") != "uniform" {
                return b;
            }
        }
        if !many.is_empty() {
            return many[0];
        }
        return JsonValue.dict();
    }
}
