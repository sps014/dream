module system.gpu.shaders;

import system;
import system.collections;
import system.codegen;
import system.gpu;

// Translates one module's shaders into a readable Slang file. Every expression and statement is
// mapped back to its Dream node, so a Slang diagnostic lands on the Dream code that produced it.
//
// Shader parameters become module-scope globals named `<entry>_<parameter>` (value parameters
// share one `ConstantBuffer` per entry). Slang lays out module globals the same way whichever
// entry point is compiled, so per-entry code and the module's recorded layout agree.
internal class SlangEmit {
    ctx: GenContext;
    program: ShaderProgram;
    shader_module: ShaderModule;
    w: SlangWriter;
    body: SlangBody;

    internal constructor(ctx: GenContext, program: ShaderProgram, shader_module: ShaderModule) {
        this.ctx = ctx;
        this.program = program;
        this.shader_module = shader_module;
        this.w = SlangWriter();
        this.body = SlangBody(this.ctx, this.program, this.shader_module, this.w);
    }

    internal fun emit(): ArtifactBuilder {
        let w = this.w;
        w.line_of(
            "// Generated by system.gpu.shaders from the Dream module '"
                + this.shader_module.name + "'."
        );
        w.line_of("// Do not edit: it is rewritten on every build.");
        let keys = List<string>();
        let differentiable = List<string>();
        for (let f in this.module_functions()) {
            if f.has<DifferentiableAttribute>() {
                SlangEmit.collect_types(f.ret, differentiable);
                for (let p in f.params) {
                    SlangEmit.collect_types(p.ty, differentiable);
                }
                for (let n in this.program.nodes(f.id)) {
                    SlangEmit.collect_types(n.ty, differentiable);
                }
            }
            for (let n in this.program.nodes(f.id)) {
                let key = Builtins.key_of(n);
                if !key.is_empty() && !keys.contains(key) {
                    keys.push(key);
                }
            }
        }
        for (let key in keys) {
            if key.starts_with("GpuCoopMat.") {
                w.blank();
                w.line_of("using namespace linalg;");
                break;
            }
        }
        for (let d in this.shader_module.types) {
            w.blank();
            this.type_decl(d, differentiable.contains(d.id));
        }
        this.prelude(keys);
        let inputs = List<string>();
        for (let e in this.shader_module.entries) {
            for (let b in e.builtins) {
                if !inputs.contains(b) {
                    inputs.push(b);
                }
            }
        }
        if !inputs.is_empty() {
            w.blank();
            for (let b in SlangEmit.input_order()) {
                if inputs.contains(b) {
                    w.line_of("static " + SlangEmit.input_type(b) + " dream_" + b + ";");
                }
            }
        }
        for (let h in this.shader_module.helpers) {
            w.blank();
            this.helper(h);
        }
        for (let e in this.shader_module.entries) {
            w.blank();
            this.entry(e);
        }
        return w.artifact;
    }

    static fun collect_types(borrow ty: GenTypeRef, out: List<string>): void {
        if SlangTypes.is_user(ty) && !out.contains(ty.decl) {
            out.push(ty.decl);
        }
        for (let arg in ty.args) {
            SlangEmit.collect_types(arg, out);
        }
    }

    fun module_functions(): List<GenFunction> {
        let out = List<GenFunction>();
        for (let e in this.shader_module.entries) {
            out.push(e.function);
        }
        for (let h in this.shader_module.helpers) {
            out.push(h);
        }
        return out;
    }

    internal static fun input_order(): List<string> {
        return List<string>(
            "global_id local_id workgroup_id local_index vertex_id instance_id".split(' ')
        );
    }

    internal static fun input_type(borrow builtin: string): string {
        if builtin == "local_index" || builtin == "vertex_id" || builtin == "instance_id" {
            return "uint";
        }
        return "uint3";
    }

    internal static fun input_semantic(borrow builtin: string): string {
        if builtin == "global_id" {
            return "SV_DispatchThreadID";
        }
        if builtin == "local_id" {
            return "SV_GroupThreadID";
        }
        if builtin == "workgroup_id" {
            return "SV_GroupID";
        }
        if builtin == "local_index" {
            return "SV_GroupIndex";
        }
        if builtin == "vertex_id" {
            return "SV_VertexID";
        }
        return "SV_InstanceID";
    }

    // The Slang semantic of a `@builtin("name")` field or parameter, or "" when unknown.
    internal static fun builtin_semantic(borrow name: string): string {
        if name == "position" {
            return "SV_Position";
        }
        if name == "front_facing" {
            return "SV_IsFrontFace";
        }
        if name == "frag_depth" {
            return "SV_Depth";
        }
        if name == "sample_index" {
            return "SV_SampleIndex";
        }
        if name == "sample_mask" {
            return "SV_Coverage";
        }
        if name == "vertex_index" {
            return "SV_VertexID";
        }
        if name == "instance_index" {
            return "SV_InstanceID";
        }
        return "";
    }

    fun type_decl(borrow d: GenDecl, differentiable: bool): void {
        let w = this.w;
        if d.kind == DeclKind.Enum {
            w.open();
            w.text("enum " + Names.ident(d.name));
            w.close(d.id);
            w.newline();
            w.line_of("{");
            w.indent();
            for (let v in d.variants) {
                w.mapped(Names.ident(v.name), v.id);
                w.text(",");
                w.newline();
            }
            w.dedent();
            w.line_of("};");
            return;
        }
        let header = "struct " + Names.ident(d.name);
        if differentiable && SlangEmit.all_floating(this.ctx, d, 0) {
            header = header + " : IDifferentiable";
        }
        w.mapped(header, d.id);
        w.newline();
        w.line_of("{");
        w.indent();
        let target = this.shader_module.fragment_outputs.contains(d.id);
        for (let f in d.fields) {
            let coop = List<int>();
            switch (f.attribute<CoopShapeAttribute>()) {
                Some(shape) => {
                    coop = shape.dimensions;
                }
                None => {}
            }
            let ty = SlangTypes.of(f.ty, coop);
            let semantic = "";
            switch (f.attribute<BuiltinAttribute>()) {
                Some(b) => {
                    semantic = SlangEmit.builtin_semantic(b.name);
                    if semantic.is_empty() {
                        this.ctx.error_at(f.id, "unknown @builtin(\"" + b.name + "\")");
                    }
                }
                None => {}
            }
            let location = "";
            switch (f.attribute<LocationAttribute>()) {
                Some(l) => {
                    if target {
                        semantic = "SV_Target" + l.index.to_string();
                    } else {
                        location = "[[vk::location(" + l.index.to_string() + ")]] ";
                        semantic = "LOCATION" + l.index.to_string();
                    }
                }
                None => {}
            }
            w.open();
            w.text(location + ty + " " + Names.ident(f.name));
            if !semantic.is_empty() {
                w.text(" : " + semantic);
            }
            w.text(";");
            w.close(f.id);
            w.newline();
        }
        this.constructors(d);
        w.dedent();
        w.line_of("};");
    }

    static fun all_floating(ctx: GenContext, borrow d: GenDecl, depth: int): bool {
        if d.fields.is_empty() || depth > 8 {
            return false;
        }
        for (let f in d.fields) {
            let ty = f.ty;
            let p = ty.primitive();
            if p == Primitive.Float || p == Primitive.Float16 || p == Primitive.Double {
                continue;
            }
            let decl = ty.decl;
            if decl
                == "system.gpu::GpuVec2"
                || decl
                == "system.gpu::GpuVec3"
                || decl == "system.gpu::GpuVec4" || decl == "system.gpu::GpuMat4" {
                continue;
            }
            let nested = false;
            if !decl.starts_with("system.") && !decl.is_empty() {
                switch (ctx.find_decl(decl)) {
                    Some(inner) => {
                        nested = inner.kind
                            == DeclKind.Struct && SlangEmit.all_floating(ctx, inner, depth + 1);
                    }
                    None => {}
                }
            }
            if !nested {
                return false;
            }
        }
        return true;
    }

    fun prelude(borrow keys: List<string>): void {
        let helpers = List<string>();
        for (let key in keys) {
            let h = Builtins.helper_of(key);
            if !h.is_empty() && !helpers.contains(h) {
                helpers.push(h);
            }
        }
        let w = this.w;
        if helpers.contains("atomic_add_float") {
            w.blank();
            w.line_of(
                "// Float atomics are not available on every target; a compare-and-swap loop on the"
            );
            w.line_of("// element's bits is.");
            w.line_of(
                "float dream_atomic_add_float(RWStructuredBuffer<Atomic<uint>> buffer, int index, float value)"
            );
            w.line_of("{");
            w.indent();
            w.line_of("uint expected = buffer[index].load();");
            w.line_of("while (true)");
            w.line_of("{");
            w.indent();
            w.line_of(
                "uint original = buffer[index].compareExchange(expected, asuint(asfloat(expected) + value));"
            );
            w.line_of("if (original == expected)");
            w.line_of("{");
            w.indent();
            w.line_of("return asfloat(original);");
            w.dedent();
            w.line_of("}");
            w.line_of("expected = original;");
            w.dedent();
            w.line_of("}");
            w.line_of("return 0.0f;");
            w.dedent();
            w.line_of("}");
        }
        if helpers.contains("ray") {
            w.blank();
            w.line_of(
                "RayDesc dream_ray(float3 origin, float3 direction, float t_min, float t_max)"
            );
            w.line_of("{");
            w.indent();
            w.line_of("RayDesc ray;");
            w.line_of("ray.Origin = origin;");
            w.line_of("ray.Direction = direction;");
            w.line_of("ray.TMin = t_min;");
            w.line_of("ray.TMax = t_max;");
            w.line_of("return ray;");
            w.dedent();
            w.line_of("}");
        }
        if helpers.contains("texture_size") {
            w.blank();
            w.line_of("int2 dream_texture_size(Texture2D<float4> texture, int level)");
            w.line_of("{");
            w.indent();
            w.line_of("uint width;");
            w.line_of("uint height;");
            w.line_of("uint levels;");
            w.line_of("texture.GetDimensions(uint(level), width, height, levels);");
            w.line_of("return int2(int(width), int(height));");
            w.dedent();
            w.line_of("}");
        }
        if helpers.contains("mlp_layout") {
            w.blank();
            w.line_of(
                "// GpuDevice.upload_mlp stores weights in the device's own layout where this code"
            );
            w.line_of(
                "// multiplies natively (Vulkan and D3D12), and row-major for Slang's emulation (CUDA)."
            );
            w.line_of("#if defined(DREAM_TARGET_SPIRV) || defined(DREAM_TARGET_DXIL)");
            w.line_of("#define DREAM_MLP_LAYOUT CoopVecMatrixLayout::InferencingOptimal");
            w.line_of("#else");
            w.line_of("#define DREAM_MLP_LAYOUT CoopVecMatrixLayout::RowMajor");
            w.line_of("#endif");
        }
        if helpers.contains("coop_relu") {
            w.blank();
            w.line_of(
                "CoopVec<T, N> dream_coop_relu<T : __BuiltinFloatingPointType, let N : int>(CoopVec<T, N> v)"
            );
            w.line_of("{");
            w.indent();
            w.line_of("return max(v, CoopVec<T, N>(T(0)));");
            w.dedent();
            w.line_of("}");
        }
    }

    fun function_attributes(borrow f: GenFunction): void {
        if f.has<DifferentiableAttribute>() {
            this.w.line_of("[Differentiable]");
        }
        switch (f.attribute<CustomDerivativeAttribute>()) {
            Some(d) => {
                let name = d.function.text;
                switch (name.last_index_of(".")) {
                    Some(i) => {
                        name = name.substring(i + 1, name.length);
                    }
                    None => {}
                }
                this.w.line_of("[BackwardDerivative(" + Names.ident(name) + ")]");
            }
            None => {}
        }
    }

    fun helper(borrow f: GenFunction): void {
        let w = this.w;
        this.body.begin(f.id);
        this.function_attributes(f);
        w.open();
        let ret = "void";
        if f.ret.kind != TypeRefKind.Void {
            ret = SlangTypes.of(f.ret, List<int>());
        }
        w.text(ret + " " + Names.ident(f.name) + "(");
        let i = 0;
        for (let p in f.params) {
            if i > 0 {
                w.text(", ");
            }
            this.body.note_param(f, p.name, p.ty);
            let prefix = "";
            if p.is_ref {
                prefix = "inout ";
            }
            if p.has<NoDiffAttribute>() {
                prefix = prefix + "no_diff ";
            }
            let coop = List<int>();
            switch (p.attribute<CoopShapeAttribute>()) {
                Some(shape) => {
                    coop = shape.dimensions;
                }
                None => {}
            }
            w.text(
                prefix
                    + this.body.param_type(f, p.name, p.ty, p.has<ReadonlyAttribute>(), coop)
                    + " " + Names.ident(p.name)
            );
            i = i + 1;
        }
        w.text(")");
        w.close(f.id);
        w.newline();
        this.body.block(this.program.body(f.id));
    }

    fun entry(entry: ShaderEntry): void {
        let w = this.w;
        // Every compile defines one pipeline group, so its code and layout bind only the
        // globals of that group's shaders.
        let condition = StringBuilder();
        condition.append("defined(" + entry.pipeline_group() + ")");
        if entry.targets.length < this.shader_module.targets().length {
            let targets = StringBuilder();
            for (let t in entry.targets) {
                if targets.length > 0 {
                    targets.append(" || ");
                }
                targets.append("defined(" + Targets.define(t) + ")");
            }
            if targets.length == 0 {
                targets.append("0");
            }
            condition.append(" && (" + targets.to_string() + ")");
        }
        w.line_of("#if " + condition.to_string());
        this.entry_body(entry);
        w.line_of("#endif");
    }

    fun entry_body(entry: ShaderEntry): void {
        let w = this.w;
        let f = entry.function;
        this.body.begin(f.id);
        for (let p in entry.params) {
            if !p.bindable() || p.is_value() {
                continue;
            }
            this.body.note_param(f, p.name, p.ty);
            this.body.names[p.name] = p.global;
            w.mapped(
                this.body.param_type(f, p.name, p.ty, p.readonly, p.coop) + " " + p.global + ";",
                f.id
            );
            w.newline();
        }
        let values = entry.values();
        let globals = !values.is_empty();
        for (let p in entry.params) {
            if p.bindable() && !p.is_value() {
                globals = true;
            }
        }
        if !values.is_empty() {
            w.line_of("struct " + entry.name() + "_Params");
            w.line_of("{");
            w.indent();
            for (let p in values) {
                w.mapped(SlangTypes.of(p.ty, p.coop) + " " + p.global + ";", f.id);
                w.newline();
            }
            w.dedent();
            w.line_of("};");
            w.line_of("ConstantBuffer<" + entry.name() + "_Params> " + entry.uniform_block() + ";");
        }
        for (let n in this.program.nodes(f.id)) {
            if n.is_statement(StmtKind.Declaration)
                && n.children.length > 0 && Builtins.key_of(n.child(0)) == "workgroup_array" {
                let init = n.child(0);
                let global = f.name + "_" + n.text;
                this.body.names[n.text] = global;
                let element = "float";
                if !init.type_args.is_empty() {
                    element = SlangTypes.of(init.type_args[0], List<int>());
                }
                w.mapped(
                    "groupshared " + element + " " + global + "[" + init.child(0).constant + "];",
                    n.id
                );
                w.newline();
                globals = true;
            }
        }
        if globals {
            w.blank();
        }
        w.line_of("[shader(\"" + entry.stage_name() + "\")]");
        if entry.is_compute() {
            w.line_of(
                "[numthreads("
                    + entry.x.to_string()
                    + ", " + entry.y.to_string() + ", " + entry.z.to_string() + ")]"
            );
        }
        w.open();
        let ret = "void";
        if f.ret.kind != TypeRefKind.Void {
            ret = SlangTypes.of(f.ret, List<int>());
        }
        w.text(ret + " " + f.name + "(");
        let first = true;
        for (let b in SlangEmit.input_order()) {
            if entry.builtins.contains(b) && SlangEmit.input_stage(b, entry) {
                if !first {
                    w.text(", ");
                }
                first = false;
                w.text(
                    SlangEmit.input_type(b) + " dream_in_" + b + " : " + SlangEmit.input_semantic(
                        b
                    )
                );
            }
        }
        for (let p in entry.params) {
            if p.bindable() {
                continue;
            }
            if !first {
                w.text(", ");
            }
            first = false;
            let prefix = "";
            if p.is_ref {
                prefix = "inout ";
            }
            if p.location >= 0 {
                prefix = prefix + "[[vk::location(" + p.location.to_string() + ")]] ";
            }
            w.text(prefix + SlangTypes.of(p.ty, p.coop) + " " + Names.ident(p.name));
            if p.location >= 0 {
                w.text(" : LOCATION" + p.location.to_string());
            } else if !p.builtin.is_empty() {
                let semantic = SlangEmit.builtin_semantic(p.builtin);
                if semantic.is_empty() {
                    this.ctx.error_at(
                        f.id,
                        "unknown @builtin(\"" + p.builtin + "\") on parameter '" + p.name + "'"
                    );
                }
                w.text(" : " + semantic);
            }
        }
        w.text(")");
        if entry.stage == GpuStage.Fragment && !SlangTypes.is_user(f.ret) {
            w.text(" : SV_Target0");
        } else if entry.stage == GpuStage.Vertex && SlangTypes.is_vector(f.ret) {
            w.text(" : SV_Position");
        }
        w.close(f.id);
        w.newline();
        w.line_of("{");
        w.indent();
        for (let b in SlangEmit.input_order()) {
            if entry.builtins.contains(b) && SlangEmit.input_stage(b, entry) {
                w.line_of("dream_" + b + " = dream_in_" + b + ";");
            }
        }
        for (let p in values) {
            w.mapped(
                "var " + p.global + " = " + entry.uniform_block() + "." + p.global + ";",
                f.id
            );
            w.newline();
        }
        for (let s in this.program.body(f.id)) {
            this.body.statement(s);
        }
        w.dedent();
        w.line_of("}");
    }

    // Whether a built-in input exists in the entry's stage.
    static fun input_stage(borrow builtin: string, borrow entry: ShaderEntry): bool {
        if builtin == "vertex_id" || builtin == "instance_id" {
            return entry.stage == GpuStage.Vertex;
        }
        return entry.is_compute();
    }
}
