module system.gpu.shaders;

import system;
import system.json;

// Access comes from Slang's declared resource type, even if this entry never writes it.
internal static class WebGpuLayout {
    internal static fun of(borrow ty: JsonValue, borrow p: ShaderParam): WebGpuBindingLayout {
        if p.is_value() {
            return WebGpuBindingLayout.Uniform;
        }
        if p.kind == ParamKinds.buffer() {
            if ty.get("access").and_then((item: JsonValue) => item.as_string()).unwrap_or("read") == "readWrite" {
                return WebGpuBindingLayout.Storage;
            }
            return WebGpuBindingLayout.ReadOnlyStorage;
        }
        if p.kind == ParamKinds.sampler() {
            return WebGpuBindingLayout.FilteringSampler;
        }
        // The current shader API exposes 2D textures only. A new shape needs an explicit ABI
        // descriptor instead of silently acquiring a default 2D layout.
        if ty.get("baseShape").and_then((item: JsonValue) => item.as_string()).unwrap_or("") != "texture2D" {
            return WebGpuBindingLayout.None;
        }
        let result = ty.get("resultType").unwrap_or(JsonValue.dict());
        let scalar = result;
        if result.get("kind").and_then((item: JsonValue) => item.as_string()).unwrap_or("") == "vector" {
            scalar = result.get("elementType").unwrap_or(JsonValue.dict());
        }
        let scalar_type = scalar.get("scalarType").and_then((item: JsonValue) => item.as_string()).unwrap_or("");
        let channels = result.get("elementCount").and_then((item: JsonValue) => item.as_int()).unwrap_or(1);
        if p.kind == ParamKinds.texture() && scalar_type == "float32" {
            return WebGpuBindingLayout.Texture2DFloat;
        }
        if p.kind != ParamKinds.storage_texture() || ty.get("access").and_then((item: JsonValue) => item.as_string()).unwrap_or("") != "readWrite" {
            return WebGpuBindingLayout.None;
        }
        if scalar_type == "float32" {
            if channels == 1 {
                return WebGpuBindingLayout.StorageR32Float;
            } else if channels == 2 {
                return WebGpuBindingLayout.StorageRg32Float;
            } else if channels == 4 {
                return WebGpuBindingLayout.StorageRgba32Float;
            }
        }
        if scalar_type == "uint32" && channels == 1 {
            return WebGpuBindingLayout.StorageR32Uint;
        }
        return WebGpuBindingLayout.None;
    }
}
