module system.interop;

/// String encoding of a `@c` extern: `@marshal(StringEncoding.Utf8)` or `@marshal(StringEncoding.Utf16)`.
/// It covers string parameters, the string result, and string parameters of callbacks.
@attribute(AttributeTarget.ExternFunction)
public struct MarshalAttribute {
    /// Encoding used for every `string` that crosses this extern.
    public encoding: StringEncoding;
}
