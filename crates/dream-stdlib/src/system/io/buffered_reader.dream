module system.io;

// Reads ahead from a borrowed reader without closing it; use this wrapper for positioning
// while buffered bytes remain, or recover them before accessing the source directly.
@allow_cycle
public class BufferedReader: Reader {
    source: Reader;
    capacity: int;
    buffer: byte[];
    offset: int;

    // Wraps `source` with an 8 KiB default buffer; nonpositive sizes fail on reads.
    public constructor(source: Reader, buffer_size: int = 8192) {
        this.source = source;
        this.capacity = buffer_size;
        this.buffer = [];
        this.offset = 0;
    }

    fun fill(): Result<bool, IoError> {
        if this.capacity <= 0 {
            return Result.Err(IoError.invalid("", "buffer size must be positive"));
        }
        if this.offset == this.buffer.length {
            this.buffer = this.source.read(this.capacity)?;
            this.offset = 0;
            if this.buffer.length > this.capacity {
                return Result.Err(IoError.other("", "reader exceeded requested size"));
            }
        }
        return Result.Ok(this.offset < this.buffer.length);
    }

    // Returns up to `max_bytes` from buffered input, refilling as needed; may return fewer.
    // Zero is a no-op, negative sizes are invalid, and empty success for positive sizes is EOF.
    public fun read(max_bytes: int): Result<byte[], IoError> {
        if this.capacity <= 0 || max_bytes < 0 {
            return Result.Err(IoError.invalid("", "invalid buffer or read size"));
        }
        if max_bytes == 0 {
            return Result.Ok(Buffer.alloc<byte>(0));
        }
        this.fill()?;
        let count = this.buffer.length - this.offset;
        if count > max_bytes {
            count = max_bytes;
        }
        let bytes = Streams.slice(this.buffer, this.offset, count);
        this.offset = this.offset + count;
        return Result.Ok(bytes);
    }

    // Returns a line without LF or CRLF, preserving standalone CR and final unterminated lines.
    // Returns `None` at EOF; `ELIMIT` consumes the prefix and exceeding byte when the pre-LF
    // byte count exceeds `max_bytes` (default 1 MiB, including any CR).
    public fun read_line(max_bytes: int = 1048576): Result<Option<string>, IoError> {
        if max_bytes < 0 {
            return Result.Err(IoError.invalid("", "negative line limit"));
        }
        let bytes = List<byte>();
        while true {
            if !this.fill()? {
                if bytes.length == 0 {
                    let none: Option<string> = Option.None;
                    return Result.Ok(none);
                }
                return Result.Ok(Option.Some(Encoding.utf8_decode(bytes.take_array())));
            }
            let next = this.buffer[this.offset];
            this.offset = this.offset + 1;
            if next == (byte)10 {
                if bytes.length > 0 && bytes[bytes.length - 1] == (byte)13 {
                    bytes.pop();
                }
                return Result.Ok(Option.Some(Encoding.utf8_decode(bytes.take_array())));
            }
            if bytes.length >= max_bytes {
                return Result.Err(IoError("", "ELIMIT", "line exceeds configured byte limit"));
            }
            bytes.push(next);
        }
    }

    // Seeks the source and discards buffered input only after success.
    // Unsupported or failed seeks preserve unread buffered bytes.
    public fun seek(position: long): Result<bool, IoError> {
        this.source.seek(position)?;
        this.buffer = [];
        this.offset = 0;
        return Result.Ok(true);
    }

    // Returns the source position minus unread buffered bytes; propagates positioning errors.
    public fun tell(): Result<long, IoError> {
        return Result.Ok(this.source.tell()? -(long)(this.buffer.length - this.offset));
    }

    // Copies and removes unread buffered bytes without repositioning the source.
    // Recover these bytes before bypassing this wrapper to access the source directly.
    public fun take_buffered(): byte[] {
        let bytes = Streams.slice(this.buffer, this.offset, this.buffer.length - this.offset);
        this.buffer = [];
        this.offset = 0;
        return bytes;
    }
}
