module system.io;

// `File` - a small cross-runtime filesystem API.

public static class File {
    // --- host bridge: `@runtime` WASM imports + matching native C symbols -------------------
    @runtime("fileRead")
    static extern fun file_read(borrow path: string): string;

    // Overwrites `path` with `content`; returns the number of bytes written (-1 on error).
    @runtime("fileWrite")
    static extern fun file_write(borrow path: string, borrow content: string): long;

    // Appends `content` to `path`; returns the number of bytes written (-1 on error).
    @runtime("fileAppend")
    static extern fun file_append(borrow path: string, borrow content: string): long;

    // Binary I/O: bytes are bulk-copied straight between the file and a Dream `byte[]`, with no
    // string round-trip (binary-safe, minimal marshalling).
    @runtime("fileReadBytes")
    static extern fun file_read_bytes(borrow path: string): byte[];

    @runtime("fileWriteBytes")
    static extern fun file_write_bytes(borrow path: string, borrow data: byte[]): long;

    @runtime("fileExists")
    static extern fun file_exists(borrow path: string): bool;

    // Deletes `path`; returns true on success.
    @runtime("fileDelete")
    static extern fun file_delete(borrow path: string): bool;

    // Size of `path` in bytes (-1 if it does not exist).
    @runtime("fileSize")
    static extern fun file_size(borrow path: string): long;

    @runtime("fileIsDir")
    static extern fun file_is_dir(borrow path: string): bool;

    // Packed `stat` payload (`size\nmtime\nctime\natime\nmode\nkind`); empty when missing.
    @runtime("fileStat")
    static extern fun file_stat(borrow path: string): string;

    @runtime("fileCopy")
    static extern fun file_copy(borrow from: string, borrow to: string): bool;

    @runtime("fileRename")
    static extern fun file_rename(borrow from: string, borrow to: string): bool;

    @runtime("dirRemove")
    static extern fun dir_remove(borrow path: string): bool;

    @runtime("dirRemoveAll")
    static extern fun dir_remove_all(borrow path: string): bool;

    // Directory entries joined by '\n' ("" when empty or not a directory); split into string[] below.
    @runtime("dirList")
    static extern fun dir_list(borrow path: string): string;

    @runtime("dirCreate")
    static extern fun dir_create(borrow path: string): bool;

    @runtime("dirCreateAll")
    static extern fun dir_create_all(borrow path: string): bool;

    // Reads the whole file at `path` as UTF-8 text.
    public static async fun read(borrow path: string): Result<string, IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        return Result.Ok(File.file_read(path));
    }

    // Overwrites `path` with `content`; resolves with `Ok(bytes_written)` or `Err` on failure.
    public static async fun write(borrow path: string, borrow content: string): Result<long, IoError> {
        let n = File.file_write(path, content);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to write file: " + path));
        }
        return Result.Ok(n);
    }

    // Appends `content` to the end of `path`; resolves with `Ok(bytes_written)` or `Err`.
    public static async fun append(borrow path: string, borrow content: string): Result<long, IoError> {
        let n = File.file_append(path, content);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to append to file: " + path));
        }
        return Result.Ok(n);
    }

    // Reads the whole file at `path` as raw bytes.
    public static async fun read_bytes(borrow path: string): Result<byte[], IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        return Result.Ok(File.file_read_bytes(path));
    }

    // Writes raw bytes to `path`, replacing any existing contents.
    public static async fun write_bytes(borrow path: string, borrow data: byte[]): Result<long, IoError> {
        let n = File.file_write_bytes(path, data);
        if (n < 0L) {
            return Result.Err(IoError.other(path, "failed to write file: " + path));
        }
        return Result.Ok(n);
    }

    // Deletes `path`; resolves `Ok(true)` on success.
    public static async fun delete(borrow path: string): Result<bool, IoError> {
        if (File.file_delete(path) == false) {
            if (File.exists(path) == false) {
                return Result.Err(IoError.not_found(path));
            }
            return Result.Err(IoError.other(path, "failed to delete: " + path));
        }
        return Result.Ok(true);
    }

    // Copies a file from `from` to `to`, overwriting `to` when it already exists.
    public static async fun copy(borrow from: string, borrow to: string): Result<bool, IoError> {
        if (File.exists(from) == false) {
            return Result.Err(IoError.not_found(from));
        }
        if (File.is_dir(from)) {
            return Result.Err(IoError.other(from, "cannot copy a directory: " + from));
        }
        if (File.file_copy(from, to) == false) {
            return Result.Err(IoError.other(to, "failed to copy to: " + to));
        }
        return Result.Ok(true);
    }

    // Renames or moves `from` to `to` (same-volume when the OS requires it).
    public static async fun rename(borrow from: string, borrow to: string): Result<bool, IoError> {
        if (File.exists(from) == false) {
            return Result.Err(IoError.not_found(from));
        }
        if (File.file_rename(from, to) == false) {
            return Result.Err(IoError.other(to, "failed to rename to: " + to));
        }
        return Result.Ok(true);
    }

    // Removes an empty directory at `path`.
    public static async fun remove_dir(borrow path: string): Result<bool, IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        if (File.is_dir(path) == false) {
            return Result.Err(IoError.other(path, "not a directory: " + path));
        }
        if (File.dir_remove(path) == false) {
            return Result.Err(IoError.other(path, "failed to remove directory: " + path));
        }
        return Result.Ok(true);
    }

    // Recursively deletes `path` (file or directory tree).
    public static async fun remove_dir_all(borrow path: string): Result<bool, IoError> {
        if (File.exists(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        if (File.dir_remove_all(path) == false) {
            return Result.Err(IoError.other(path, "failed to remove: " + path));
        }
        return Result.Ok(true);
    }

    // Creates a single directory at `path`; resolves `Ok(true)` on success.
    public static async fun create_dir(borrow path: string): Result<bool, IoError> {
        if (File.dir_create(path) == false) {
            if (File.exists(path)) {
                return Result.Err(IoError.exists(path));
            }
            return Result.Err(IoError.other(path, "failed to create directory: " + path));
        }
        return Result.Ok(true);
    }

    // Creates `path` and any missing parents; resolves `Ok(true)` on success.
    public static async fun create_dir_all(borrow path: string): Result<bool, IoError> {
        if (File.dir_create_all(path) == false) {
            return Result.Err(IoError.other(path, "failed to create directories: " + path));
        }
        return Result.Ok(true);
    }

    // Lists the entries of directory `path`, or `Err(IoError)` when the path is missing or not a
    // directory (an existing empty directory yields `Ok([])`).
    public static async fun list(borrow path: string): Result<string[], IoError> {
        if (File.is_dir(path) == false) {
            return Result.Err(IoError.not_found(path));
        }
        let joined = File.dir_list(path);
        if (joined.is_empty()) {
            return Result.Ok(Buffer.alloc<string>(0));
        }
        return Result.Ok(joined.split('\n'));
    }

    // Like `list`, but each name is joined onto `path`. Fails with the same `IoError` cases.
    public static async fun list_paths(borrow path: string): Result<string[], IoError> {
        let got = await File.list(path);
        if (got.is_err()) {
            return got;
        }
        let names = got.unwrap_or(Buffer.alloc<string>(0));
        let out = Buffer.alloc<string>(names.length);
        let i = 0;
        while (i < names.length) {
            out[i] = Path.join(path, names[i]);
            i = i + 1;
        }
        return Result.Ok(out);
    }

    // Reads the whole file and splits on `\n`, dropping a trailing empty part from a final newline.
    public static async fun read_lines(borrow path: string): Result<string[], IoError> {
        let got = await File.read(path);
        if (got.is_err()) {
            return Result.Err(got.unwrap_err());
        }
        let text = got.unwrap_or(string.empty);
        if (text.is_empty()) {
            return Result.Ok(Buffer.alloc<string>(0));
        }
        let parts = text.split('\n');
        if ((parts.length > 0) && parts[parts.length - 1].is_empty() && text.ends_with("\n")) {
            let n = parts.length - 1;
            let out = Buffer.alloc<string>(n);
            let i = 0;
            while (i < n) {
                out[i] = parts[i];
                i = i + 1;
            }
            return Result.Ok(out);
        }
        return Result.Ok(parts);
    }

    // Writes `lines` joined by newlines, including a trailing newline when `lines` is non-empty.
    public static async fun write_lines(borrow path: string, borrow lines: string[]): Result<long, IoError> {
        let sb = StringBuilder();
        let i = 0;
        while (i < lines.length) {
            sb.append(lines[i]);
            sb.append_char('\n');
            i = i + 1;
        }
        return await File.write(path, sb.build());
    }

    // Cheap synchronous predicates (no async overhead).
    public static fun exists(borrow path: string): bool {
        return File.file_exists(path);
    }
    // Size of `path` in bytes, or `None` if it does not exist.
    public static fun size(borrow path: string): Option<long> {
        let s = File.file_size(path);
        if (s < 0L) {
            return Option.None;
        }
        return Option.Some(s);
    }
    public static fun is_dir(borrow path: string): bool {
        return File.file_is_dir(path);
    }

    // True when `path` exists and is a regular file.
    public static fun is_file(borrow path: string): bool {
        return switch (File.stat(path)) {
            Ok(st) => st.is_file(),
            Err(e) => false,
        };
    }

    // One `stat` of `path`. Follows symlinks. Missing paths are `Err`.
    public static fun stat(borrow path: string): Result<FileStats, IoError> {
        let wire = File.file_stat(path);
        if (wire.is_empty()) {
            return Result.Err(IoError.not_found(path));
        }
        let parts = wire.split('\n');
        if (parts.length < 6) {
            return Result.Err(IoError.other(path, "invalid stat payload for: " + path));
        }
        let size = long.parse(parts[0]).unwrap_or(0L);
        let mtime = long.parse(parts[1]).unwrap_or(0L);
        let ctime = long.parse(parts[2]).unwrap_or(0L);
        let atime = long.parse(parts[3]).unwrap_or(0L);
        let mode = int.parse(parts[4]).unwrap_or(0);
        let kind = int.parse(parts[5]).unwrap_or(3);
        return Result.Ok(FileStats(size, mtime, ctime, atime, mode, kind));
    }

    // Opens a seekable read stream over `path` (OS-backed; no whole-file preload).
    public static fun open(borrow path: string): Result<FileStream, IoError> {
        return switch (FileHandle.open(path, "r")) {
            Ok(h) => Result.Ok(FileStream(h)),
            Err(e) => Result.Err(e),
        };
    }

    // Async wrapper around `open`.
    public static async fun open_async(borrow path: string): Result<FileStream, IoError> {
        return File.open(path);
    }
}
