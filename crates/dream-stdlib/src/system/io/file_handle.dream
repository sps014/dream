module system.io;

/// FileHandle - an OS-backed read/write/seek stream over an open file.
/// Async operations use bounded native workers or Node callbacks, keeping host buffers alive
/// through cancellation. Concurrent I/O on one handle returns `EBUSY`; closure is synchronous.
public class FileHandle: Reader, Writer, AsyncReader, AsyncWriter {
    _id: int;
    _path: string;
    _buffer: byte[];
    _offset: int;
    _pending: Option<FileOperation>;

    internal constructor(id: int, path: string) {
        this._id = id;
        this._path = path;
        this._buffer = [];
        this._offset = 0;
        this._pending = Option.None;
    }

    del() {
        if this._id >= 0 {
            FileHandle.file_handle_close(this._id);
        }
    }

    /// Whether this handle has been closed, including after an explicit close failure.
    public get is_closed(): bool {
        return this._id < 0;
    }

    fun check_open(): Result<Unit, IoError> {
        if this.is_closed {
            return Result.Err(IoError.closed(this.path));
        }
        this.check_pending()?;
        return Result.Ok(Unit());
    }

    fun check_pending(): Result<Unit, IoError> {
        if this._pending.is_some() {
            if !this._pending.unwrap().done {
                return Result.Err(IoError(this.path, "EBUSY", "file operation is still pending"));
            }
        }
        return Result.Ok(Unit());
    }

    /// Path supplied when opening the file; remains available after closure.
    public get path(): string {
        return this._path;
    }

    @runtime("fileOpen")
    static extern fun file_open(borrow path: string, borrow mode: string): int;

    @runtime("fileHandleRead")
    static extern fun file_handle_read(id: int, n: int): byte[];

    @runtime("fileHandleWrite")
    static extern fun file_handle_write(id: int, borrow data: byte[]): long;

    @runtime("fileHandleSeek")
    static extern fun file_handle_seek(id: int, pos: long): int;

    @runtime("fileHandleTell")
    static extern fun file_handle_tell(id: int): long;

    @runtime("fileHandleSeekEnd")
    static extern fun file_handle_seek_end(id: int, offset: long): int;

    @runtime("fileHandleClose")
    static extern fun file_handle_close(id: int): int;

    @runtime("fileHandleLength")
    static extern fun file_handle_length(id: int): long;

    static fun open_result(path: string, mode: string): Result<FileHandle, IoError> {
        return FileHandle.from_id(FileHandle.file_open(path, mode), path, mode);
    }

    static fun from_id(id: int, path: string, mode: string): Result<FileHandle, IoError> {
        if id < 0 {
            if id == (0 - 1) {
                return Result.Err(IoError.not_found(path));
            }
            if id == (0 - 2) {
                return Result.Err(IoError.permission_denied(path));
            }
            if id == (0 - 3) {
                return Result.Err(IoError.other(path, "invalid open mode: " + mode));
            }
            return Result.Err(IoError.other(path, "failed to open file: " + path));
        }
        return Result.Ok(FileHandle(id, path));
    }

    /// Opens a file with the selected access, creation, and truncation behavior.
    public static fun open(path: string, mode: FileMode): Result<FileHandle, IoError> {
        return FileHandle.open_result(path, mode.wire());
    }

    /// Opens using host async facilities or the bounded filesystem executor.
    /// Cancellation abandons the result safely; a late open result is closed automatically.
    public static async fun open_async(
        path: string,
        mode: FileMode,
        token: Option<CancellationToken> = Option.None
    ): Result<FileHandle, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        let operation = FileOperation.start(0, 0 - 1, path, mode.wire(), 0, [], 0L)?;
        operation.wait(effective_token).await?;
        return FileHandle.from_id((int)operation.result(), path, mode.wire());
    }

    /// Reads up to `n` bytes from the current position, advancing the cursor.
    public fun read(n: int): Result<byte[], IoError> {
        this.check_open()?;
        if n < 0 || n == 2147483647 {
            return Result.Err(IoError.invalid(this.path, "invalid read size"));
        }
        if this._offset < this._buffer.length {
            let count = this._buffer.length - this._offset;
            if count > n {
                count = n;
            }
            let bytes = Streams.slice(this._buffer, this._offset, count);
            this._offset = this._offset + count;
            return Result.Ok(bytes);
        }
        let raw = FileHandle.file_handle_read(this._id, n);
        if raw.length == 0 || raw[0] != (byte)0 {
            return Result.Err(IoError.other(this.path, "read failed"));
        }
        let bytes = Buffer.alloc<byte>(raw.length - 1);
        for (let i = 0; i < bytes.length; i = i + 1) {
            bytes[i] = raw[i + 1];
        }
        return Result.Ok(bytes);
    }

    /// Reads without blocking the scheduler, preserving partial reads and EOF.
    /// Cancellation may consume input; further I/O returns `EBUSY` until host work ends.
    public async unique fun read_async(
        n: int,
        token: Option<CancellationToken> = Option.None
    ): Result<byte[], IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        this.check_open()?;
        // A started child can outlive its awaiting parent; pin its receiver across suspension.
        let lifetime = [this];
        if n < 0 || n == 2147483647 {
            return Result.Err(IoError.invalid(lifetime[0].path, "invalid read size"));
        }
        if n == 0 || lifetime[0]._offset < lifetime[0]._buffer.length {
            return lifetime[0].read(n);
        }
        let operation = FileOperation.start(1, lifetime[0]._id, "", "", n, [], 0L)?;
        lifetime[0]._pending = Option.Some(operation);
        lifetime[0]._pending.unwrap().wait(effective_token).await?;
        let completed = lifetime[0]._pending.unwrap();
        lifetime[0]._pending = Option.None;
        let raw = completed.bytes();
        if raw.length == 0 || raw[0] != (byte)0 {
            return Result.Err(IoError.other(lifetime[0].path, "read failed"));
        }
        return Result.Ok(Streams.slice(raw, 1, raw.length - 1));
    }

    /// Writes `data` at the current position, advancing the cursor; returns bytes written.
    public fun write(data: byte[]): Result<int, IoError> {
        this.check_open()?;
        if this._offset < this._buffer.length {
            let position = this.tell()?;
            this.seek(position)?;
        }
        let n = FileHandle.file_handle_write(this._id, data);
        if n < 0L {
            return Result.Err(IoError.other(this.path, "write failed"));
        }
        return Result.Ok((int)n);
    }

    /// Writes a host-owned copy without blocking the scheduler and returns partial progress.
    /// Cancellation does not roll back writes; further I/O is busy until host work ends.
    public async unique fun write_async(
        data: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<int, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        this.check_open()?;
        // A started child can outlive its awaiting parent; pin its receiver across suspension.
        let lifetime = [this];
        if data.length == 0 {
            return Result.Ok(0);
        }
        if lifetime[0]._offset < lifetime[0]._buffer.length {
            let position = lifetime[0].tell()?;
            lifetime[0].seek_async(position, effective_token).await?;
        }
        let operation = FileOperation.start(2, lifetime[0]._id, "", "", data.length, data, 0L)?;
        lifetime[0]._pending = Option.Some(operation);
        lifetime[0]._pending.unwrap().wait(effective_token).await?;
        let completed = lifetime[0]._pending.unwrap();
        lifetime[0]._pending = Option.None;
        let count = completed.result();
        if count < 0L {
            return Result.Err(IoError.other(lifetime[0].path, "write failed"));
        }
        return Result.Ok((int)count);
    }

    /// Seeks to absolute byte offset `pos` from the start of the file.
    public fun seek(pos: long): Result<Unit, IoError> {
        this.check_open()?;
        if FileHandle.file_handle_seek(this._id, pos) < 0 {
            return Result.Err(IoError.other(this.path, "seek failed"));
        }
        this._buffer = [];
        this._offset = 0;
        return Result.Ok(Unit());
    }

    /// Seeks on the filesystem executor; successful completion discards read-ahead.
    /// Once submitted, cancellation is observed after completion so buffer state stays coherent.
    public async unique fun seek_async(
        pos: long,
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        this.check_open()?;
        // A started child can outlive its awaiting parent; pin its receiver across suspension.
        let lifetime = [this];
        let operation = FileOperation.start(3, lifetime[0]._id, "", "", 0, [], pos)?;
        lifetime[0]._pending = Option.Some(operation);
        lifetime[0]._pending.unwrap().wait(Option.None).await?;
        let completed = lifetime[0]._pending.unwrap();
        lifetime[0]._pending = Option.None;
        if completed.result() < 0L {
            return Result.Err(IoError.other(lifetime[0].path, "seek failed"));
        }
        lifetime[0]._buffer = [];
        lifetime[0]._offset = 0;
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        return Result.Ok(Unit());
    }

    /// Current cursor offset from the start of the file.
    public fun tell(): Result<long, IoError> {
        this.check_open()?;
        let pos = FileHandle.file_handle_tell(this._id);
        if pos < 0L {
            return Result.Err(IoError.other(this.path, "tell failed"));
        }
        return Result.Ok(pos - (long)(this._buffer.length - this._offset));
    }

    /// Seeks to `offset` bytes from the end (`0` is the end; negative moves backward).
    public fun seek_from_end(offset: long): Result<Unit, IoError> {
        this.check_open()?;
        if FileHandle.file_handle_seek_end(this._id, offset) < 0 {
            return Result.Err(IoError.other(this.path, "seek failed"));
        }
        this._buffer = [];
        this._offset = 0;
        return Result.Ok(Unit());
    }

    /// Reads a line using buffered read-ahead, stripping LF or CRLF and preserving standalone CR.
    /// Returns the final unterminated line or `None` at EOF; `ELIMIT` consumes the prefix
    /// and exceeding byte beyond the pre-LF byte limit (default 1 MiB, including any CR).
    public fun read_line(max_bytes: int = 1048576): Result<Option<string>, IoError> {
        this.check_open()?;
        if max_bytes < 0 {
            return Result.Err(IoError.invalid(this.path, "negative line limit"));
        }
        let bytes = List<byte>();
        while true {
            if this._offset == this._buffer.length {
                this._buffer = this.read(8192)?;
                this._offset = 0;
                if this._buffer.length == 0 {
                    if bytes.length == 0 {
                        let none: Option<string> = Option.None;
                        return Result.Ok(none);
                    }
                    return Result.Ok(Option.Some(Encoding.utf8_decode(bytes.take_array())));
                }
            }
            let next = this._buffer[this._offset];
            this._offset = this._offset + 1;
            if next == (byte)10 {
                if bytes.length > 0 && bytes[bytes.length - 1] == (byte)13 {
                    bytes.pop();
                }
                return Result.Ok(Option.Some(Encoding.utf8_decode(bytes.take_array())));
            }
            if bytes.length >= max_bytes {
                return Result.Err(
                    IoError(this.path, "ELIMIT", "line exceeds configured byte limit")
                );
            }
            bytes.push(next);
        }
    }

    /// Returns the file's current size in bytes, read from the open handle. Fails with an
    /// `IoError` when the handle is closed or the metadata query fails.
    public fun size(): Result<long, IoError> {
        this.check_open()?;
        let size = FileHandle.file_handle_length(this._id);
        if size < 0L {
            return Result.Err(IoError.other(this.path, "file length failed"));
        }
        return Result.Ok(size);
    }

    /// Validates that the handle is open; writes are unbuffered at this layer.
    /// This does not synchronize data to durable storage.
    public unique fun flush(): Result<Unit, IoError> {
        return this.check_open();
    }

    /// Checks cancellation and validates the handle; this layer has no buffered output to flush.
    public async unique fun flush_async(
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        return this.check_open();
    }

    /// Closes idempotently and reports host failures. The handle stays closed even on failure
    /// to prevent closing a reused descriptor; destruction performs nonthrowing cleanup.
    public fun close(): Result<Unit, IoError> {
        if this.is_closed {
            return Result.Ok(Unit());
        }
        this.check_pending()?;
        this._pending = Option.None;
        let id = this._id;
        this._id = 0 - 1;
        if FileHandle.file_handle_close(id) < 0 {
            return Result.Err(IoError.other(this.path, "close failed"));
        }
        return Result.Ok(Unit());
    }
}
