module system.io;

// The host owns a second reference until blocking work ends; dropping this object never frees
// buffers or descriptors still in use. No guest pointers cross into the blocking executor.
internal class FileOperation {
    id: usize;

    constructor(id: usize) {
        this.id = id;
    }

    del() {
        FileOperation.release_host(this.id);
    }

    @runtime("fileOperationStart")
    static extern fun start_host(
        kind: int,
        fd: int,
        borrow path: string,
        borrow mode: string,
        count: int,
        borrow data: byte[],
        position: long
    ): usize;

    @runtime("fileOperationDone")
    static extern fun done_host(id: usize): int;

    @runtime("fileOperationResult")
    static extern fun result_host(id: usize): long;

    @runtime("fileOperationBytes")
    static extern fun bytes_host(id: usize): byte[];

    @runtime("fileOperationRelease")
    static extern fun release_host(id: usize): void;

    internal static fun start(
        kind: int,
        fd: int,
        path: string,
        mode: string,
        count: int,
        data: byte[],
        position: long
    ): Result<FileOperation, IoError> {
        let id = FileOperation.start_host(kind, fd, path, mode, count, data, position);
        if id == (usize)0 {
            return Result.Err(IoError(path, "EBUSY", "file executor unavailable or saturated"));
        }
        return Result.Ok(FileOperation(id));
    }

    @async_host
    @runtime("fileOperationWait")
    static extern async fun wait_host(id: usize): int;

    internal get done(): bool {
        return FileOperation.done_host(this.id) != 0;
    }

    internal fun result(): long {
        return FileOperation.result_host(this.id);
    }

    internal fun bytes(): byte[] {
        return FileOperation.bytes_host(this.id);
    }

    internal async fun wait(token: Option<CancellationToken>): Result<Unit, IoError> {
        let effective_token = CancellationToken.resolve(token);
        // A started child can outlive its awaiting parent; pin its receiver across suspension.
        let lifetime = [this];
        let pending = FileOperation.wait_host(lifetime[0].id);
        if effective_token.is_some() {
            let result = effective_token.unwrap().wait(pending).await;
            if result.is_err() {
                return Result.Err(IoError.cancelled());
            }
        } else {
            pending.await;
        }
        return Result.Ok(Unit());
    }
}
