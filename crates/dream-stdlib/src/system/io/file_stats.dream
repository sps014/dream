module system.io;

// Metadata from a single `stat` of a filesystem path. Times are UTC instants.
// `mode` is Unix `st_mode` (0 on Windows and in the browser memfs). `kind` is 0 file, 1 directory,
// 2 symlink, 3 other. `File.stat` follows symlinks, so `kind == 2` is uncommon.
/// File size, timestamps, mode, and entry kind returned by `File.stat`. Timestamps are UTC
/// instants. `File.stat` follows symbolic links.
public class FileStats {
    _size: long;
    _modified: SystemTime;
    _changed: SystemTime;
    _accessed: SystemTime;
    _mode: int;
    _kind: FileKind;

    internal constructor(
        size: long,
        modified: SystemTime,
        changed: SystemTime,
        accessed: SystemTime,
        mode: int,
        kind: int
    ) {
        this._size = size;
        this._modified = modified;
        this._changed = changed;
        this._accessed = accessed;
        this._mode = mode;
        this._kind = switch (kind) {
            0 => FileKind.File,
            1 => FileKind.Directory,
            2 => FileKind.Symlink,
            _ => FileKind.Other,
        };
    }

    /// File size in bytes.
    public get size(): long {
        return this._size;
    }

    /// Last modification time, in UTC.
    public get modified(): SystemTime {
        return this._modified;
    }

    /// Last metadata-change time, in UTC. On Unix this is the inode change time, not the
    /// birth time.
    public get changed(): SystemTime {
        return this._changed;
    }

    /// Last access time, in UTC.
    public get accessed(): SystemTime {
        return this._accessed;
    }

    /// Unix file mode, or zero on platforms without Unix modes.
    public get mode(): int {
        return this._mode;
    }

    /// The kind of filesystem entry.
    public get kind(): FileKind {
        return this._kind;
    }

    /// Returns whether the entry is a regular file.
    public get is_file(): bool {
        return this._kind == FileKind.File;
    }

    /// Returns whether the path refers to a directory.
    public get is_dir(): bool {
        return this._kind == FileKind.Directory;
    }

    /// Returns whether the entry is a symbolic link.
    public get is_symlink(): bool {
        return this._kind == FileKind.Symlink;
    }
}
