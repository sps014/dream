module system.io;

// Text and byte access over a file handle, with propagated I/O errors and byte positions.
public class FileStream {
    handle: FileHandle;

    internal constructor(handle: FileHandle) {
        this.handle = handle;
    }

    // Reads up to `n` bytes, advancing the file position; empty success indicates EOF
    // for positive sizes, and negative sizes return an error.
    public fun read_bytes(n: int): Result<byte[], IoError> {
        return this.handle.read(n);
    }

    // Reads up to `n` bytes and decodes them as UTF-8; the limit and cursor are byte-based.
    // A read can split a UTF-8 sequence; use an incremental decoder for streamed text.
    public fun read(n: int): Result<string, IoError> {
        return Result.Ok(Encoding.utf8_decode(this.read_bytes(n)?));
    }

    // Collects all remaining bytes through EOF and decodes them as UTF-8; propagates read errors.
    // Memory use grows with the remaining file size.
    public fun read_all(): Result<string, IoError> {
        let bytes = List<byte>();
        while true {
            let chunk = this.read_bytes(8192)?;
            if chunk.length == 0 {
                break;
            }
            for (let i = 0; i < chunk.length; i = i + 1) {
                bytes.push(chunk[i]);
            }
        }
        return Result.Ok(Encoding.utf8_decode(bytes.take_array()));
    }

    // Reads an LF or CRLF terminated line without its terminator, or a final unterminated line.
    // Returns `None` at EOF; propagates I/O errors and the handle default line-size limit.
    public fun read_line(): Result<Option<string>, IoError> {
        return this.handle.read_line();
    }

    // Writes UTF-8 bytes at the current position and returns the byte count; may write partially.
    public fun write_text(text: string): Result<int, IoError> {
        return this.handle.write_text(text);
    }

    // Compares the current position with the current file length, propagating errors.
    // Concurrent file changes can invalidate the result before the next read.
    public fun has_more(): Result<bool, IoError> {
        return Result.Ok(this.handle.tell()? < this.handle.length()?);
    }

    // Returns the current byte offset, or an I/O or closed-resource error.
    public get position(): Result<long, IoError> {
        return this.handle.tell();
    }

    // Returns the current file length in bytes, or an I/O or closed-resource error.
    public get length(): Result<long, IoError> {
        return this.handle.length();
    }

    // Seeks to an absolute byte offset; failure preserves the previous logical position.
    public fun seek(offset: long): Result<bool, IoError> {
        return this.handle.seek(offset);
    }

    // Moves to the current end of the file; propagates positioning errors.
    public fun seek_end(): Result<bool, IoError> {
        return this.handle.seek_end();
    }

    // Returns the current byte offset, accounting for buffered read-ahead.
    public fun tell(): Result<long, IoError> {
        return this.handle.tell();
    }

    // Seeks to byte zero; propagates positioning errors without changing position on failure.
    public fun reset(): Result<bool, IoError> {
        return this.seek(0L);
    }

    // Closes the underlying handle idempotently and reports explicit closure failures.
    public fun close(): Result<bool, IoError> {
        return this.handle.close();
    }
}
