module system.io;

// Path helpers for joining and inspecting filesystem paths.
public static class Path {
    // Joins two path segments with the platform separator, avoiding a double separator.
    public static fun join(a: string, b: string): string {
        if (a.is_empty()) {
            return b;
        }
        if (b.is_empty()) {
            return a;
        }
        let sep = Path.separator();
        if (a.ends_with(sep) || a.ends_with("/") || a.ends_with("\\")) {
            return a + b;
        }
        return a + sep + b;
    }

    // Joins every segment in `parts` left-to-right via `join`.
    public static fun of(parts: string[]): string {
        if (parts.length == 0) {
            return string.empty;
        }
        let total = 0;
        let i = 0;
        while (i < parts.length) {
            total = total + parts[i].length + 1;
            i = i + 1;
        }
        let sb = StringBuilder(total);
        i = 0;
        while (i < parts.length) {
            if (sb.is_empty()) {
                sb.append(parts[i]);
            } else {
                let joined = Path.join(sb.build(), parts[i]);
                sb.clear();
                sb.append(joined);
            }
            i = i + 1;
        }
        return sb.build();
    }

    // Final path component after the last `/` or `\`, or `None` for a trailing separator.
    public static fun file_name(path: string): Option<string> {
        let n = path.length;
        if (n == 0) {
            return Option.None;
        }
        let i = n - 1;
        while (i >= 0) {
            let c = path.char_at(i);
            if ((c == '/') || (c == '\\')) {
                if (i + 1 >= n) {
                    return Option.None;
                }
                return Option.Some(path.substring(i + 1, n));
            }
            i = i - 1;
        }
        return Option.Some(path);
    }

    // Substring after the last `.` in the file name, or `None` when missing.
    public static fun extension(path: string): Option<string> {
        let name = Path.file_name(path).unwrap_or(string.empty);
        let n = name.length;
        let i = n - 1;
        while (i >= 0) {
            if (name.char_at(i) == '.') {
                if (i + 1 >= n) {
                    return Option.None;
                }
                return Option.Some(name.substring(i + 1, n));
            }
            i = i - 1;
        }
        return Option.None;
    }

    // Directory portion of `path`, or `None` when there is no separator.
    public static fun parent(path: string): Option<string> {
        let n = path.length;
        if (n == 0) {
            return Option.None;
        }
        let i = n - 1;
        while (i >= 0) {
            let c = path.char_at(i);
            if ((c == '/') || (c == '\\')) {
                if (i == 0) {
                    return Option.Some(path.substring(0, 1));
                }
                return Option.Some(path.substring(0, i));
            }
            i = i - 1;
        }
        return Option.None;
    }

    // True for POSIX absolute paths (`/`…), Windows drive paths (`C:`…), or `\`-rooted paths.
    public static fun is_absolute(path: string): bool {
        if (path.is_empty()) {
            return false;
        }
        let c = path.char_at(0);
        if ((c == '/') || (c == '\\')) {
            return true;
        }
        if ((path.length >= 3) && (path.char_at(1) == ':')) {
            return true;
        }
        return false;
    }

    // Resolves `.` and `..` segments where possible. Does not consult the filesystem.
    public static fun normalize(path: string): string {
        if (path.is_empty()) {
            return path;
        }
        let sep = Path.separator();
        let absolute = Path.is_absolute(path);
        let parts = List<string>();
        let start = 0;
        let i = 0;
        let n = path.length;
        while (i <= n) {
            if ((i == n) || (path.char_at(i) == '/') || (path.char_at(i) == '\\')) {
                if (i > start) {
                    let part = path.substring(start, i);
                    if (part == ".") {
                        // skip
                    } else if (part == "..") {
                        if (parts.length > 0) {
                            let last = parts.get(parts.length - 1);
                            if (last != "..") {
                                parts.pop();
                            } else {
                                parts.push(part);
                            }
                        } else if (!absolute) {
                            parts.push(part);
                        }
                    } else {
                        parts.push(part);
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
        let sb = StringBuilder();
        let j = 0;
        while (j < parts.length) {
            if (j > 0) {
                sb.append(sep);
            }
            sb.append(parts.get(j));
            j = j + 1;
        }
        let out = sb.build();
        if (absolute) {
            if (path.char_at(0) == '/') {
                return "/" + out;
            }
            if (path.char_at(0) == '\\') {
                return "\\" + out;
            }
        }
        if (out.is_empty()) {
            if (absolute) {
                return sep;
            }
            return ".";
        }
        return out;
    }

    // Host path separator. Always `/` in the WASM stdlib surface (native hosts accept `/`
    // even on Windows); use `OsFamily` at call sites when Windows-style paths are required.
    public static fun separator(): string {
        return "/";
    }

    @runtime("processCwd")
    static extern fun host_cwd(): string;

    // File name without the last extension (`"a.tar.gz"` → `"a.tar"`).
    public static fun stem(path: string): string {
        let name = Path.file_name(path).unwrap_or(string.empty);
        let ext = Path.extension(path);
        if (ext.is_none()) {
            return name;
        }
        let e = ext.unwrap_or(string.empty);
        let cut = name.length - e.length - 1;
        if (cut < 0) {
            return name;
        }
        return name.substring(0, cut);
    }

    // Replaces the last extension, or appends `ext` when the path has none. `ext` may include a leading `.`.
    public static fun with_extension(path: string, ext: string): string {
        let suffix = ext;
        if ((ext.is_empty() == false) && (ext.char_at(0) != '.')) {
            suffix = "." + ext;
        }
        let parent = Path.parent(path);
        let stem = Path.stem(path);
        let name = stem + suffix;
        return switch (parent) {
            Some(dir) => Path.join(dir, name),
            None => name,
        };
    }

    // Replaces the final path component with `name`.
    public static fun with_file_name(path: string, name: string): string {
        return switch (Path.parent(path)) {
            Some(dir) => Path.join(dir, name),
            None => name,
        };
    }

    // Inverse of `is_absolute`.
    public static fun is_relative(path: string): bool {
        return Path.is_absolute(path) == false;
    }

    // True when the last extension equals `ext` (with or without a leading `.`).
    public static fun has_extension(path: string, ext: string): bool {
        let want = ext;
        if ((ext.is_empty() == false) && (ext.char_at(0) == '.')) {
            want = ext.substring(1, ext.length);
        }
        return switch (Path.extension(path)) {
            Some(got) => got == want,
            None => false,
        };
    }

    // Splits `path` on `/` and `\`, skipping empty segments.
    public static fun components(path: string): string[] {
        let parts = List<string>();
        let start = 0;
        let i = 0;
        let n = path.length;
        while (i <= n) {
            if ((i == n) || (path.char_at(i) == '/') || (path.char_at(i) == '\\')) {
                if (i > start) {
                    parts.push(path.substring(start, i));
                }
                start = i + 1;
            }
            i = i + 1;
        }
        return parts.take_array();
    }

    // Joins `path` onto the process cwd when it is relative, then `normalize`s. Does not consult `realpath`.
    public static fun absolute(path: string): string {
        if (Path.is_absolute(path)) {
            return Path.normalize(path);
        }
        let cwd = Path.host_cwd();
        if (cwd.is_empty()) {
            cwd = ".";
        }
        return Path.normalize(Path.join(cwd, path));
    }

    // String-prefix relative path after normalize (not `realpath`). `None` when `path` is not under `base`.
    public static fun relative_to(path: string, base: string): Option<string> {
        let p = Path.normalize(path);
        let b = Path.normalize(base);
        if (p == b) {
            return Option.Some(".");
        }
        let prefix = b;
        if ((b.ends_with("/") == false) && (b.ends_with("\\") == false)) {
            prefix = b + Path.separator();
        }
        if (p.starts_with(prefix) == false) {
            return Option.None;
        }
        return Option.Some(p.substring(prefix.length, p.length));
    }
}
