module system.io;

// Byte input with partial reads and optional positioning; operations report I/O failures.
public interface Reader {
    // Reads at most `max_bytes` bytes; empty success means EOF for a positive size.
    // A zero size consumes nothing; negative sizes and closed resources return errors.
    unique fun read(max_bytes: int): Result<byte[], IoError>;

    // Moves to an absolute byte position; unsupported readers return `ENOTSUP`.
    // A failed seek preserves the previous logical position.
    public unique fun seek(position: long): Result<bool, IoError> {
        return Result.Err(IoError("", "ENOTSUP", "stream is not seekable"));
    }

    // Returns the logical byte position, or `ENOTSUP` when positioning is unavailable.
    public fun tell(): Result<long, IoError> {
        return Result.Err(IoError("", "ENOTSUP", "stream has no position"));
    }

    // Collects exactly `count` bytes, retrying short reads; premature EOF returns `EEOF`.
    // Errors may occur after input has already been consumed; negative counts are invalid.
    public fun read_exact(count: int): Result<byte[], IoError> {
        if count < 0 { return Result.Err(IoError.invalid("", "negative read size")); }
        if count == 0 {
            let bytes = this.read(0)?;
            if bytes.length != 0 { return Result.Err(IoError.other("", "reader exceeded requested size")); }
            return Result.Ok(bytes);
        }
        let output = Buffer.alloc<byte>(count);
        let offset = 0;
        while offset < count {
            let bytes = this.read(count - offset)?;
            if bytes.length == 0 {
                return Result.Err(IoError("", "EEOF", "unexpected end of stream"));
            }
            if bytes.length > count - offset {
                return Result.Err(IoError.other("", "reader exceeded requested size"));
            }
            for (let i = 0; i < bytes.length; i = i + 1) {
                output[offset + i] = bytes[i];
            }
            offset = offset + bytes.length;
        }
        return Result.Ok(output);
    }
}

// Byte output with partial writes and explicit flushing.
public interface Writer {
    // Accepts up to the supplied bytes and returns the number accepted.
    // Empty input makes no progress; failures do not undo bytes already written.
    unique fun write(data: byte[]): Result<int, IoError>;
    // Delivers buffered output to the underlying destination and reports failures.
    // Flushing does not imply durable storage or close the destination.
    unique fun flush(): Result<bool, IoError>;

    // Retries partial writes until all bytes are accepted; rejects zero or invalid progress.
    // A failure leaves any completed writes in effect; this does not flush.
    public fun write_all(data: byte[]): Result<bool, IoError> {
        if data.length == 0 {
            let count = this.write(data)?;
            if count != 0 { return Result.Err(IoError.other("", "writer made invalid progress")); }
            return Result.Ok(true);
        }
        let offset = 0;
        while offset < data.length {
            let remaining = Streams.slice(data, offset, data.length - offset);
            let count = this.write(remaining)?;
            if count <= 0 || count > remaining.length {
                return Result.Err(IoError.other("", "writer made invalid progress"));
            }
            offset = offset + count;
        }
        return Result.Ok(true);
    }
}

// Awaitable byte input with the same EOF and size rules as `Reader`.
public interface AsyncReader {
    // Reads up to `max_bytes` with cooperative cancellation.
    // Cancellation does not restore bytes already consumed by the underlying operation.
    async unique fun read_async(max_bytes: int, token: Option<CancellationToken> = Option.None): Result<byte[], IoError>;
}

// Awaitable byte output with explicit flushing and cooperative cancellation.
public interface AsyncWriter {
    // Returns the number of bytes accepted, which may be less than the input length.
    // Cancellation or failure does not roll back completed writes.
    async unique fun write_async(data: byte[], token: Option<CancellationToken> = Option.None): Result<int, IoError>;
    // Flushes pending output with cancellation; does not close the destination
    // or guarantee durable storage.
    async unique fun flush_async(token: Option<CancellationToken> = Option.None): Result<bool, IoError>;
}

// Copy helpers that leave ownership and closure of both streams with the caller.
public static class Streams {
    internal static fun slice(data: byte[], start: int, count: int): byte[] {
        let output = Buffer.alloc<byte>(count);
        for (let i = 0; i < count; i = i + 1) { output[i] = data[start + i]; }
        return output;
    }

    // Copies to EOF using chunks bounded by positive `buffer_size` (default 8 KiB),
    // then flushes the destination and returns the byte count; neither stream is closed.
    public static fun copy(source: Reader, destination: Writer, buffer_size: int = 8192): Result<long, IoError> {
        if buffer_size <= 0 { return Result.Err(IoError.invalid("", "buffer size must be positive")); }
        let total = 0L;
        while true {
            let bytes = source.read(buffer_size)?;
            if bytes.length == 0 { break; }
            if bytes.length > buffer_size {
                return Result.Err(IoError.other("", "reader exceeded requested size"));
            }
            destination.write_all(bytes)?;
            total = total + (long)bytes.length;
        }
        destination.flush()?;
        return Result.Ok(total);
    }

    // Copies to EOF with bounded chunks, partial-write retries, and cancellation checks,
    // then flushes and returns the byte count. Neither stream is closed; completed writes persist.
    public static async fun copy_async(source: AsyncReader, destination: AsyncWriter, buffer_size: int = 8192, token: Option<CancellationToken> = Option.None): Result<long, IoError> {
        let effective_token = CancellationToken.resolve(token);
        if buffer_size <= 0 { return Result.Err(IoError.invalid("", "buffer size must be positive")); }
        let total = 0L;
        while true {
            CancellationToken.rejected(effective_token, IoError.cancelled())?;
            let bytes = source.read_async(buffer_size, effective_token).await?;
            if bytes.length == 0 { break; }
            if bytes.length > buffer_size {
                return Result.Err(IoError.other("", "reader exceeded requested size"));
            }
            let offset = 0;
            while offset < bytes.length {
                CancellationToken.rejected(effective_token, IoError.cancelled())?;
                let remaining = Streams.slice(bytes, offset, bytes.length - offset);
                let count = destination.write_async(remaining, effective_token).await?;
                if count <= 0 || count > remaining.length {
                    return Result.Err(IoError.other("", "writer made invalid progress"));
                }
                offset = offset + count;
            }
            total = total + (long)bytes.length;
        }
        destination.flush_async(effective_token).await?;
        return Result.Ok(total);
    }
}
