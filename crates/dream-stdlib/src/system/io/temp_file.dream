module system.io;

// Owns a read/write file inside a private temporary directory and cleans both deterministically.
public class TempFile {
    // File access remains owned by this temporary resource; close or persist before releasing it.
    handle: FileHandle;

    // Borrowed access to the owned temporary file.
    public get file(): FileHandle {
        return this.handle;
    }

    directory: TempDirectory;

    internal constructor(file: FileHandle, directory: TempDirectory) {
        this.handle = file;
        this.directory = directory;
    }

    // Path of the temporary file before persistence; its containing directory is private.
    public get path(): string {
        return this.file.path;
    }

    // Creates a temporary read/write file under the OS temporary directory.
    public static fun create(): Result<TempFile, IoError> {
        return TempFile.create_in("");
    }

    // Creates a private file on the selected directory's filesystem.
    public static fun create_in(directory: string): Result<TempFile, IoError> {
        let temporary = TempDirectory.create_in(directory)?;
        let opened = FileHandle.open(temporary.path + "/contents", "w+");
        if opened.is_err() {
            temporary.close();
            return Result.Err(opened.unwrap_err());
        }
        return Result.Ok(TempFile(opened.unwrap(), temporary));
    }

    @runtime("tempReplace")
    static extern fun replace_host(source: string, destination: string): bool;

    // Flushes and closes the file, then atomically replaces a destination on the same filesystem.
    // Failed replacement leaves the destination and temporary file intact; durability is not implied.
    public fun persist_replace(destination: string): Result<bool, IoError> {
        if !this.file.is_closed {
            this.file.flush()?;
            this.file.close()?;
        }
        if !TempFile.replace_host(this.file.path, destination) {
            return Result.Err(IoError.other(destination, "atomic replacement failed"));
        }
        return this.directory.close();
    }

    // Closes the file and removes its private directory, reporting either cleanup failure.
    public fun close(): Result<bool, IoError> {
        let file = this.file.close();
        let directory = this.directory.close();
        file?;
        return directory;
    }

    del() {
        this.close();
    }
}
