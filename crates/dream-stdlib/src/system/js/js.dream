module system.js;

// `js` - the dynamic JavaScript-interop type.
//
// A `js` value is an opaque handle to a live JavaScript value held by the runtime (see
// `runtime/dream.js`). Member access, method calls, indexing, and calling a `js` value all bind
// *dynamically* at runtime - the compiler performs no member resolution, so `doc.getElementById("app")`
// or `el.title = "x"` compile as-is and are dispatched by the JS host. Every dynamic operation
// yields another `js`; convert back to a Dream value at a typed boundary (e.g. `let n: int = el.x`)
// or with the explicit `.to_int()` / `.to_str()` / ... helpers below.
//
// The compiler desugars dynamic operations into the host bridges declared here, marshaling
// arguments through a single host call. These bridges are an implementation detail; user code uses
// native syntax.
extend js {
    // --- entry points ----------------------------------------------------------------------

    // A handle to a value on the JS global scope by name (e.g. `js.global("document")`), for
    // computed names. Prefer the property form `js.global.document` / `js.global.fetch(...)`, which
    // binds `js.global` to `globalThis` (see `global_this`) and then reads members dynamically.
    @cfg(Target.Js)
    @js("Dream", "jsGlobal")
    internal static extern fun global(borrow name: string): js;

    // `globalThis` itself, backing the `js.global.<member>` property syntax.
    @cfg(Target.Js)
    @js("Dream", "jsGlobalThis")
    internal static extern fun global_this(): js;

    @cfg(Target.Js)
    @js("Dream", "jsObject")
    internal static extern fun host_object(): js;

    @cfg(Target.Js)
    @js("Dream", "jsArray")
    internal static extern fun host_array(): js;

    /// Creates an empty JavaScript object whose properties can be assigned dynamically.
    @cfg(Target.Js)
    public static fun object(): js {
        return js.host_object();
    }

    /// Creates an empty JavaScript array.
    @cfg(Target.Js)
    public static fun array(): js {
        return js.host_array();
    }

    // JS `null` / `undefined` as `js` handles (handle id 0 on the host). Prefer these over inventing
    // sentinel values when an API expects an explicit nullish argument.
    @cfg(Target.Js)
    @js("Dream", "jsNull")
    internal static extern fun host_null(): js;

    @cfg(Target.Js)
    @js("Dream", "jsUndefined")
    internal static extern fun host_undefined(): js;

    /// The JavaScript `null` value.
    @cfg(Target.Js)
    public static get null(): js {
        return js.host_null();
    }

    /// The JavaScript `undefined` value.
    @cfg(Target.Js)
    public static get undefined(): js {
        return js.host_undefined();
    }

    @cfg(Target.Js)
    @js("Dream", "jsCallback")
    internal static extern fun callback(index: int, borrow signature: string): js;

    @cfg(Target.Js)
    @js("Dream", "jsApply")
    internal static extern fun apply(
        borrow target: js,
        borrow receiver: js,
        borrow fixed: js[],
        borrow rest: js[]
    ): js;

    @cfg(Target.Js)
    @js("Dream", "jsConstruct")
    internal static extern fun construct(
        borrow target: js,
        borrow fixed: js[],
        borrow rest: js[]
    ): js;

    // --- boxing: Dream value -> js handle (used by the compiler when marshaling arguments) ---
    @cfg(Target.Js)
    @js("Dream", "jsInt")
    internal static extern fun box_int(value: int): js;

    @cfg(Target.Js)
    @js("Dream", "jsLong")
    internal static extern fun box_long(value: long): js;

    @cfg(Target.Js)
    @js("Dream", "jsDouble")
    internal static extern fun box_double(value: double): js;

    @cfg(Target.Js)
    @js("Dream", "jsBool")
    internal static extern fun box_bool(value: bool): js;

    @cfg(Target.Js)
    @js("Dream", "jsString")
    internal static extern fun box_string(borrow value: string): js;

    // --- dynamic operations (variadic call/invoke args are carried in a `js[]`) --------------
    @cfg(Target.Js)
    @js("Dream", "jsGetV")
    internal static extern fun get(borrow target: js, borrow name: string): js;

    @cfg(Target.Js)
    @js("Dream", "jsSetV")
    internal static extern fun set(borrow target: js, borrow name: string, value: js): void;

    // Property write with one shadow-stack value slot (no pre-box bridge for primitives/string).
    @cfg(Target.Js)
    @js("Dream", "jsSetSlot")
    internal static extern fun set_slot(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): void;

    // Variadic call/invoke. The compiler does not call these with a Dream argument list: it emits a
    // shadow-stack buffer of tagged 16-byte slots and passes its pointer + count, so all arguments
    // cross in a single boundary crossing with no per-argument boxing or heap array. The `args_ptr`
    // / `argc` parameters describe that buffer.
    @cfg(Target.Js)
    @js("Dream", "jsCallV")
    internal static extern fun call(borrow target: js, borrow name: string, args_ptr: int, argc: int): js;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeV")
    internal static extern fun invoke(borrow target: js, args_ptr: int, argc: int): js;

    // `target[prop][method](...args)` in one crossing (fused get + call).
    @cfg(Target.Js)
    @js("Dream", "jsGetCallV")
    internal static extern fun get_call(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): js;

    @cfg(Target.Js)
    @js("Dream", "jsIndexGetV")
    internal static extern fun index_get(borrow target: js, borrow key: js): js;

    @cfg(Target.Js)
    @js("Dream", "jsIndexSetV")
    internal static extern fun index_set(borrow target: js, borrow key: js, value: js): void;

    // Index write with key+value in two shadow-stack slots (no per-value boxing bridges).
    @cfg(Target.Js)
    @js("Dream", "jsIndexSetSlot")
    internal static extern fun index_set_slot(borrow target: js, args_ptr: int, argc: int): void;

    // Typed-boundary fusion: property get that returns a Dream primitive/string directly (no
    // intermediate `js` handle). Used when `let x: T = recv.name` would otherwise be get + as_*.
    @cfg(Target.Js)
    @js("Dream", "jsGetAsInt")
    internal static extern fun get_as_int(borrow target: js, borrow name: string): int;

    @cfg(Target.Js)
    @js("Dream", "jsGetAsLong")
    internal static extern fun get_as_long(borrow target: js, borrow name: string): long;

    @cfg(Target.Js)
    @js("Dream", "jsGetAsDouble")
    internal static extern fun get_as_double(borrow target: js, borrow name: string): double;

    @cfg(Target.Js)
    @js("Dream", "jsGetAsBool")
    internal static extern fun get_as_bool(borrow target: js, borrow name: string): bool;

    @cfg(Target.Js)
    @js("Dream", "jsGetAsString")
    internal static extern fun get_as_string(borrow target: js, borrow name: string): string;

    // Typed-boundary fusion: method call / invoke that returns a Dream primitive/string directly.
    @cfg(Target.Js)
    @js("Dream", "jsCallAsInt")
    internal static extern fun call_as_int(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): int;

    @cfg(Target.Js)
    @js("Dream", "jsCallAsLong")
    internal static extern fun call_as_long(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): long;

    @cfg(Target.Js)
    @js("Dream", "jsCallAsDouble")
    internal static extern fun call_as_double(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): double;

    @cfg(Target.Js)
    @js("Dream", "jsCallAsBool")
    internal static extern fun call_as_bool(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): bool;

    @cfg(Target.Js)
    @js("Dream", "jsCallAsString")
    internal static extern fun call_as_string(
        borrow target: js,
        borrow name: string,
        args_ptr: int,
        argc: int
    ): string;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeAsInt")
    internal static extern fun invoke_as_int(borrow target: js, args_ptr: int, argc: int): int;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeAsLong")
    internal static extern fun invoke_as_long(borrow target: js, args_ptr: int, argc: int): long;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeAsDouble")
    internal static extern fun invoke_as_double(borrow target: js, args_ptr: int, argc: int): double;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeAsBool")
    internal static extern fun invoke_as_bool(borrow target: js, args_ptr: int, argc: int): bool;

    @cfg(Target.Js)
    @js("Dream", "jsInvokeAsString")
    internal static extern fun invoke_as_string(borrow target: js, args_ptr: int, argc: int): string;

    // Fused get + call + typed unbox.
    @cfg(Target.Js)
    @js("Dream", "jsGetCallAsInt")
    internal static extern fun get_call_as_int(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): int;

    @cfg(Target.Js)
    @js("Dream", "jsGetCallAsLong")
    internal static extern fun get_call_as_long(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): long;

    @cfg(Target.Js)
    @js("Dream", "jsGetCallAsDouble")
    internal static extern fun get_call_as_double(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): double;

    @cfg(Target.Js)
    @js("Dream", "jsGetCallAsBool")
    internal static extern fun get_call_as_bool(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): bool;

    @cfg(Target.Js)
    @js("Dream", "jsGetCallAsString")
    internal static extern fun get_call_as_string(
        borrow target: js,
        borrow prop: string,
        borrow method: string,
        args_ptr: int,
        argc: int
    ): string;

    // The settlement envelope distinguishes nullish fulfillment from rejection.
    @cfg(Target.Js)
    @js("Dream", "jsAwait")
    internal static extern async fun await_raw(borrow target: js): js;

    @cfg(Target.Js)
    internal static async fun await_promise(
        borrow target: js,
        token: Option<CancellationToken> = Option.None
    ): Result<js, JsError> {
        CancellationToken.throw_if_opt(token);
        let settled = js.await_raw(target).await;
        CancellationToken.throw_if_opt(token);
        let ok: bool = settled.ok;
        if ok {
            return Result.Ok(settled.value);
        }
        return Result.Err(JsError(settled.reason));
    }

    // --- unboxing: js handle -> Dream value (used by the compiler + the helpers below) -------
    @cfg(Target.Js)
    @js("Dream", "jsAsInt")
    internal static extern fun as_int(borrow target: js): int;

    @cfg(Target.Js)
    @js("Dream", "jsAsLong")
    internal static extern fun as_long(borrow target: js): long;

    @cfg(Target.Js)
    @js("Dream", "jsAsDouble")
    internal static extern fun as_double(borrow target: js): double;

    @cfg(Target.Js)
    @js("Dream", "jsAsBool")
    internal static extern fun as_bool(borrow target: js): bool;

    @cfg(Target.Js)
    @js("Dream", "jsAsString")
    internal static extern fun as_string(borrow target: js): string;

    @cfg(Target.Js)
    @js("Dream", "jsIsNull")
    internal static extern fun host_is_null(borrow target: js): bool;

    // --- ergonomic instance API (resolved before dynamic dispatch, so these names are safe) --

    /// Converts this JavaScript value to a Dream integer.
    @cfg(Target.Js)
    public fun to_int(): int {
        return js.as_int(this);
    }

    /// Converts this JavaScript value to a Dream double.
    @cfg(Target.Js)
    public fun to_double(): double {
        return js.as_double(this);
    }

    /// Converts this JavaScript value to a Dream boolean.
    @cfg(Target.Js)
    public fun to_bool(): bool {
        return js.as_bool(this);
    }

    /// Converts this JavaScript value to a Dream string.
    @cfg(Target.Js)
    public fun to_str(): string {
        return js.as_string(this);
    }

    /// True if the referenced value is `null` or `undefined`.
    @cfg(Target.Js)
    public fun is_null(): bool {
        return js.host_is_null(this);
    }
}
