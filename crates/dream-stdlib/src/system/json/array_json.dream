module system.json;

// JSON arrays for `T[]` whose elements encode as JSON.
extend T[] {
    /// Appends the elements as a JSON array.
    @requires_member("T", "write_json")
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append_char('[');
        let i = 0;
        while i < this.length {
            if i > 0 {
                sb.append_char(',');
            }
            this[i].write_json(sb, options);
            i = i + 1;
        }
        sb.append_char(']');
    }

    /// Reads the elements of a JSON array; a value that is not an array reads as empty.
    @requires_member("T", "from_json")
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): T[] {
        let out = Buffer.alloc<T>(v.length);
        let i = 0;
        while i < v.length {
            out[i] = T.from_json(v.at(i).unwrap_or(JsonValue.null()), options);
            i = i + 1;
        }
        return out;
    }

    /// Parses JSON text holding an array of elements.
    @requires_member("T", "from_json")
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<T[], ParseError> {
        return Json.read_parsed<T[]>(text, options);
    }
}
