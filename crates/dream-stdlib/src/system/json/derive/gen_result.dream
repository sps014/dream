module system.json.derive;

// Outcome of a `@json` source-generator expand pass.
// Optional `error_type` / `error_field` name the type / field the error is reported at.
public class JsonGenOutput {
    public ok: bool;
    public source: string;
    public error: string;
    public error_type: string;
    public error_field: string;

    // Builds a raw result; prefer `success` / `failure` / `failure_at`.
    internal constructor(ok: bool, source: string, error: string, error_type: string, error_field: string) {
        this.ok = ok;
        this.source = source;
        this.error = error;
        this.error_type = error_type;
        this.error_field = error_field;
    }

    // Successful expand with emitted Dream source.
    public static fun success(source: string): JsonGenOutput {
        return JsonGenOutput(true, source, "", "", "");
    }

    // Failed expand with a diagnostic message (no span hint).
    public static fun failure(error: string): JsonGenOutput {
        return JsonGenOutput(false, "", error, "", "");
    }

    // Failed expand with type/field names for host span recovery.
    public static fun failure_at(error: string, type_name: string, field_name: string): JsonGenOutput {
        return JsonGenOutput(false, "", error, type_name, field_name);
    }
}
