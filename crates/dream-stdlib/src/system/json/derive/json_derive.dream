module system.json.derive;

import system;
import system.collections;
import system.codegen;
import system.json;

// The `@json` derive: `to_json` / `write_json` / `from_json` / `read_json` for every `@json` type.
/// Adds JSON serialization and deserialization methods for types annotated with `@json`.
@generator
@incremental
@on_attribute(JsonAttribute)
internal fun json_derive(ctx: GenContext): void {
    let jsonable = List<string>();
    for (let e in ctx.type_index()) {
        if e.kind == DeclKind.Class || e.kind == DeclKind.Struct || e.kind == DeclKind.Union {
            jsonable.push(e.name);
        }
    }
    let json_names = List<string>();
    let types = List<JsonTypeSpec>();
    let declarations = List<GenDecl>();
    for (let d in ctx.types_with<JsonAttribute>()) {
        if !d.has<JsonAttribute>() {
            continue;
        }
        json_names.push(d.name);
        declarations.push(d);
        if d.kind == DeclKind.Union {
            let variants = List<JsonVariantSpec>();
            for (let v in d.variants) {
                variants.push(JsonVariantSpec(v.name, json_fields(v.fields, d.generics)));
            }
            types.push(JsonTypeSpec.union_type(d.name, d.generics, variants));
        } else if d.kind == DeclKind.Class || d.kind == DeclKind.Struct {
            let spec = JsonTypeSpec.class_type(
                d.name,
                d.generics,
                json_fields(d.fields, d.generics)
            );
            let how = construction(d);
            if how == Construction.Impossible {
                ctx.error_at(
                    d.id,
                    "@json type '"
                        + d.name
                        + "' needs a constructor taking every field in declaration order, or a zero-argument constructor"
                );
                return;
            }
            spec.assign_fields = how == Construction.Assign;
            types.push(spec);
        }
    }
    let i = 0;
    while i < types.length {
        let result = JsonGenerator.members(types[i], json_names, jsonable);
        if !result.ok {
            ctx.error_at(error_target(ctx, result), first_line(result.error));
            return;
        }
        ctx.emit_extend(declarations[i], result.source);
        i++;
    }
}

// How `from_json` builds `d`. A constructor whose parameters are the fields in declaration order
// is called directly. A declared zero-argument constructor, or none at all (the language's
// implicit zero-argument constructor), is followed by a store per field.
fun construction(borrow d: GenDecl): Construction {
    let declared = false;
    let empty = false;
    for (let m in d.methods) {
        if m.name != "constructor" {
            continue;
        }
        declared = true;
        if m.params.is_empty() {
            empty = true;
        }
        if m.params.length == d.fields.length {
            let same = true;
            let i = 0;
            while i < m.params.length {
                if m.params[i].ty.display != d.fields[i].ty.display {
                    same = false;
                }
                i = i + 1;
            }
            if same {
                return Construction.Fieldwise;
            }
        }
    }
    if !declared || empty {
        return Construction.Assign;
    }
    return Construction.Impossible;
}

fun json_fields(borrow fields: List<GenField>, borrow generics: List<string>): List<JsonFieldSpec> {
    let out = List<JsonFieldSpec>();
    for (let f in fields) {
        let ty = f.ty;
        let property = "";
        switch (f.attribute<PropertyNameAttribute>()) {
            Some(p) => {
                property = p.name;
            }
            None => {}
        }
        let option_inner = "";
        if ty.is_option() {
            option_inner = ty.arg(0).source_name();
        }
        let map_value_inner = "";
        let map_ctor = "";
        let kind = ty.collection();
        if (kind == CollectionKind.Map || kind == CollectionKind.SortedMap)
            && ty.arg(0)
            .is_primitive(Primitive.String) {
            map_value_inner = ty.arg(1).source_name();
            map_ctor = ty.name;
        }
        let seq_elem_inner = "";
        let seq_kind = CollectionKind.NotCollection;
        if kind == CollectionKind.List || kind == CollectionKind.Set {
            seq_elem_inner = ty.arg(0).source_name();
            seq_kind = kind;
        }
        let is_type_param = false;
        for (let g in generics) {
            if g == ty.display {
                is_type_param = true;
            }
        }
        out.push(
            JsonFieldSpec(
                f.name,
                ty.source_name(),
                f.has<JsonIgnoreAttribute>(),
                property,
                option_inner,
                is_type_param,
                map_value_inner,
                map_ctor,
                seq_elem_inner,
                seq_kind
            )
        );
    }
    return out;
}

fun first_line(borrow message: string): string {
    switch (message.index_of('\n')) {
        Some(i) => {
            return message.substring(0, i);
        }
        None => {
            return message;
        }
    }
}

// The model node a `JsonGenerator` failure names: the field when given, else the type.
fun error_target(ctx: GenContext, borrow failure: JsonGenOutput): string {
    for (let d in ctx.decls()) {
        if d.name != failure.error_type {
            continue;
        }
        if failure.error_field.length > 0 {
            for (let f in d.fields) {
                if f.name == failure.error_field {
                    return f.id;
                }
            }
            for (let v in d.variants) {
                for (let f in v.fields) {
                    if f.name == failure.error_field {
                        return f.id;
                    }
                }
            }
        }
        return d.id;
    }
    return "";
}
