module system.json;

// JSON encoding of `float16` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend float16 {
    /// Appends this value as JSON as the shortest JSON number that reads back as the same value.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append(this.to_string());
    }

    /// Reads a `float16` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): float16 {
        return (float16)v.as_double().unwrap_or(0.0d);
    }

    /// Parses JSON text holding a single `float16`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<float16, ParseError> {
        return Json.read_parsed<float16>(text, options);
    }
}
