module system.json;

// JSON encoding of `int` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend int {
    /// Appends this value as JSON as a JSON number.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append(this.to_string());
    }

    /// Reads a `int` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): int {
        return v.as_int().unwrap_or(0);
    }

    /// Parses JSON text holding a single `int`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<int, ParseError> {
        return Json.read_parsed<int>(text, options);
    }
}
