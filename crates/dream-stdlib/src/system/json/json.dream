module system.json;

// The public JSON API.

public class Json {
    @intrinsic("json_serialize")
    static extern fun serialize<T>(value: T): string;

    @intrinsic("json_deserialize")
    static extern fun deserialize<T>(text: string): Result<T, ParseError>;

    // Reconstruct a `@json` value from an already-parsed `JsonValue` (no parse step).
    @intrinsic("json_from_value")
    static extern fun from_value<T>(value: JsonValue): T;

    // Compact stringify of a dynamic `JsonValue` tree.
    public static fun stringify(value: JsonValue): string {
        let sb = StringBuilder();
        Json._json_stringify_into(sb, value);
        return sb.build();
    }

    // Pretty-prints `value` with newlines and `indent` spaces per nesting level (e.g. 2 or 4).
    // Pass 0 to fall back to compact output.
    public static fun stringify_pretty(value: JsonValue, indent: int): string {
        if (indent <= 0) {
            return Json.stringify(value);
        }
        let sb = StringBuilder();
        Json._json_stringify_pretty_into(sb, value, indent, 0);
        return sb.build();
    }

    // Parses `text` into a dynamic `JsonValue` tree (no intermediate byte[] copy).
    public static fun parse(text: string): Result<JsonValue, ParseError> {
        if (text.is_empty()) {
            return Result.Err(ParseError.invalid("empty JSON input"));
        }
        let parser = JsonParser(text, 0);
        let value = parser.parse_value();
        if (parser.at_end() == false) {
            return Result.Err(ParseError.invalid("trailing characters after JSON value"));
        }
        return Result.Ok(value);
    }


    // --- serialization helpers (also used by `@json` `write_json` methods) -------------------

    public static fun write_string(sb: StringBuilder, s: string): void {
        Json._json_escape_into(sb, s);
    }

    public static fun write_bool(sb: StringBuilder, b: bool): void {
        if (b == true) {
            sb.append("true");
        } else {
            sb.append("false");
        }
    }

    public static fun write_null(sb: StringBuilder): void {
        sb.append("null");
    }

    public static fun write_int(sb: StringBuilder, n: int): void {
        sb.append(n.to_string());
    }

    public static fun write_number(sb: StringBuilder, n: double): void {
        sb.append(Json._json_number(n));
    }

    static fun _append_hex4(sb: StringBuilder, value: int): void {
        let digits = Buffer.alloc<int>(4);
        digits[0] = (value / 4096) % 16;
        digits[1] = (value / 256) % 16;
        digits[2] = (value / 16) % 16;
        digits[3] = value % 16;
        let i = 0;
        while (i < 4) {
            let nibble = digits[i];
            if (nibble < 10) {
                sb.append_char((char)(48 + nibble));
            } else {
                sb.append_char((char)(87 + nibble));
            }
            i = i + 1;
        }
    }

    // Appends a quoted, escaped JSON string to `sb`.
    // Safe ASCII / UTF-8 runs are bulk-copied; only `"`, `\`, and controls take the slow path.
    public static fun _json_escape_into(sb: StringBuilder, s: string): void {
        sb.append_char('"');
        let n = s.byte_size();
        let i = 0;
        while (i < n) {
            let run_start = i;
            let scanning = true;
            while (scanning == true) {
                if (i >= n) {
                    scanning = false;
                } else {
                    let b = s.byte_at(i);
                    // Escape `"`, `\`, and ASCII controls; pass through the rest (incl. UTF-8).
                    if ((b < 32) || (b == 34) || (b == 92)) {
                        scanning = false;
                    } else {
                        i = i + 1;
                    }
                }
            }
            if (i > run_start) {
                sb.append_utf8_slice(s, run_start, i - run_start);
            }
            if (i >= n) {
                break;
            }
            let b = s.byte_at(i);
            if (b == 34) {
                sb.append_char('\\');
                sb.append_char('"');
            } else if (b == 92) {
                sb.append_char('\\');
                sb.append_char('\\');
            } else if (b == 10) {
                sb.append_char('\\');
                sb.append_char('n');
            } else if (b == 9) {
                sb.append_char('\\');
                sb.append_char('t');
            } else if (b == 13) {
                sb.append_char('\\');
                sb.append_char('r');
            } else if (b == 8) {
                sb.append_char('\\');
                sb.append_char('b');
            } else if (b == 12) {
                sb.append_char('\\');
                sb.append_char('f');
            } else {
                sb.append("\\u");
                Json._append_hex4(sb, b);
            }
            i = i + 1;
        }
        sb.append_char('"');
    }

    // Formats a JSON number: integral values print without a decimal point, others fall back to the
    // default double formatting.
    static fun _json_number(n: double): string {
        let i = (int)n;
        if ((double)i == n) {
            return i.to_string();
        }
        return n.to_string();
    }

    // Recursively serializes a JsonValue into `sb` as compact JSON text.
    static fun _json_stringify_into(sb: StringBuilder, v: JsonValue): void {
        let k = v.kind;
        if (k == 0) {
            sb.append("null");
            return;
        }
        if (k == 1) {
            if (v.bool_val == true) {
                sb.append("true");
            } else {
                sb.append("false");
            }
            return;
        }
        if (k == 2) {
            sb.append(Json._json_number(v.num_val));
            return;
        }
        if (k == 3) {
            Json._json_escape_into(sb, v.str_val);
            return;
        }
        if (k == 4) {
            sb.append_char('[');
            let i = 0;
            let n = v.length;
            while (i < n) {
                if (i > 0) {
                    sb.append_char(',');
                }
                Json._json_stringify_into(sb, v.at(i).unwrap_or(JsonValue.none()));
                i = i + 1;
            }
            sb.append_char(']');
            return;
        }
        if (k == 5) {
            sb.append_char('{');
            let i = 0;
            let n = v.length;
            while (i < n) {
                if (i > 0) {
                    sb.append_char(',');
                }
                let key = v.key_at(i).unwrap_or("");
                Json._json_escape_into(sb, key);
                sb.append_char(':');
                Json._json_stringify_into(sb, v.value_at(i).unwrap_or(JsonValue.none()));
                i = i + 1;
            }
            sb.append_char('}');
            return;
        }
        sb.append("null");
    }

    // Appends `n` spaces to `sb`.
    static fun _json_spaces_into(sb: StringBuilder, n: int): void {
        let i = 0;
        while (i < n) {
            sb.append_char(' ');
            i = i + 1;
        }
    }

    // Recursively serializes a JsonValue with newlines and `indent` spaces of nesting per level.
    static fun _json_stringify_pretty_into(sb: StringBuilder, v: JsonValue, indent: int, depth: int): void {
        let k = v.kind;
        if (k == 4) {
            let n = v.length;
            if (n == 0) {
                sb.append("[]");
                return;
            }
            sb.append("[\n");
            let i = 0;
            while (i < n) {
                if (i > 0) {
                    sb.append(",\n");
                }
                Json._json_spaces_into(sb, indent * (depth + 1));
                Json._json_stringify_pretty_into(sb, v.at(i).unwrap_or(JsonValue.none()), indent, depth + 1);
                i = i + 1;
            }
            sb.append_char('\n');
            Json._json_spaces_into(sb, indent * depth);
            sb.append_char(']');
            return;
        }
        if (k == 5) {
            let n = v.length;
            if (n == 0) {
                sb.append("{}");
                return;
            }
            sb.append("{\n");
            let i = 0;
            while (i < n) {
                if (i > 0) {
                    sb.append(",\n");
                }
                Json._json_spaces_into(sb, indent * (depth + 1));
                let key = v.key_at(i).unwrap_or("");
                Json._json_escape_into(sb, key);
                sb.append(": ");
                Json._json_stringify_pretty_into(sb, v.value_at(i).unwrap_or(JsonValue.none()), indent, depth + 1);
                i = i + 1;
            }
            sb.append_char('\n');
            Json._json_spaces_into(sb, indent * depth);
            sb.append_char('}');
            return;
        }
        Json._json_stringify_into(sb, v);
    }
}
