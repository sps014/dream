module system.json;

/// The public JSON API: one pair of names for text <-> value.
public static class Json {
    /// Encodes `value` as compact JSON text, with field names as declared. User-defined types
    /// need `@json`.
    @intrinsic(Intrinsic.JsonSerialize)
    public static extern fun serialize<T>(borrow value: T): string;

    /// Encodes `value` as JSON text using `options` for property naming, whether `None` fields
    /// are written, and indentation. User-defined types need `@json`.
    @intrinsic(Intrinsic.JsonSerialize)
    public static extern fun serialize<T>(borrow value: T, borrow options: JsonOptions): string;

    /// Decodes JSON text as `T`, returning `ParseError` if it cannot be decoded. Property names
    /// must match field names exactly. User-defined types need `@json`.
    @intrinsic(Intrinsic.JsonDeserialize)
    public static extern fun deserialize<T>(borrow text: string): Result<T, ParseError>;

    /// Decodes JSON text as `T`, matching property names to fields as `options` describes.
    /// Returns `ParseError` if the text cannot be decoded. User-defined types need `@json`.
    @intrinsic(Intrinsic.JsonDeserialize)
    public static extern fun deserialize<T>(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<T, ParseError>;

    /// Builds a `@json` value from an already-parsed `JsonValue`. Missing or mismatched properties
    /// take the field defaults.
    @intrinsic(Intrinsic.JsonFromValue)
    public static extern fun from_value<T>(borrow value: JsonValue): T;

    /// Builds a `@json` value from an already-parsed `JsonValue`, matching property names to
    /// fields as `options` describes. Missing or mismatched properties take the field defaults.
    @intrinsic(Intrinsic.JsonFromValue)
    public static extern fun from_value<T>(borrow value: JsonValue, borrow options: JsonOptions): T;

    // Options used when a `serialize`/`deserialize`/`from_value` call omits them.
    internal static fun default_options(): JsonOptions {
        return JsonOptions();
    }

    // Compact JSON text of a dynamic `JsonValue` tree (used by `serialize` for `JsonValue`).
    internal static fun stringify(borrow value: JsonValue): string {
        let sb = StringBuilder();
        Json._json_stringify_into(sb, value);
        return sb.build();
    }

    // Parses `text` into a dynamic `JsonValue` tree (used by `deserialize<JsonValue>`).
    internal static fun parse(borrow text: string): Result<JsonValue, ParseError> {
        if text.is_empty() {
            return Result.Err(ParseError.invalid("empty JSON input"));
        }
        let parser = JsonParser(text, 0, JsonOptions());
        let value = parser.parse_value();
        if parser.at_end() == false {
            return Result.Err(ParseError.invalid("trailing characters after JSON value"));
        }
        return Result.Ok(value);
    }

    // --- serialization helpers (also used by `@json` `write_json` methods) -------------------
    internal static fun write_string(borrow sb: StringBuilder, borrow s: string): void {
        Json._json_escape_into(sb, s);
    }

    /// Appends a JSON boolean to `sb`.
    internal static fun write_bool(borrow sb: StringBuilder, b: bool): void {
        if b == true {
            sb.append("true");
        } else {
            sb.append("false");
        }
    }

    /// Appends JSON null to `sb`.
    internal static fun write_null(borrow sb: StringBuilder): void {
        sb.append("null");
    }

    // Appends an already-built dynamic value as compact JSON text. Generated `write_json` methods
    // use this for `JsonValue` fields and collection elements, which carry their own shape.
    /// Appends a dynamic JSON value to `sb` as compact JSON text.
    internal static fun write_value(borrow sb: StringBuilder, borrow v: JsonValue): void {
        Json._json_stringify_into(sb, v);
    }

    /// Appends a JSON number to `sb`.
    internal static fun write_number(borrow sb: StringBuilder, n: double): void {
        sb.append(Json._json_number(n));
    }

    static fun _append_hex4(borrow sb: StringBuilder, value: int): void {
        let digits = Buffer.alloc<int>(4);
        digits[0] = (value / 4096) % 16;
        digits[1] = (value / 256) % 16;
        digits[2] = (value / 16) % 16;
        digits[3] = value % 16;
        let i = 0;
        while i < 4 {
            let nibble = digits[i];
            if nibble < 10 {
                sb.append_char((char)(48 + nibble));
            } else {
                sb.append_char((char)(87 + nibble));
            }
            i = i + 1;
        }
    }

    // Appends a quoted, escaped JSON string to `sb`.
    // Safe ASCII / UTF-8 runs are bulk-copied; only `"`, `\`, and controls take the slow path.
    internal static fun _json_escape_into(borrow sb: StringBuilder, borrow s: string): void {
        sb.append_char('"');
        let n = s.length;
        let i = 0;
        while i < n {
            let run_start = i;
            let scanning = true;
            while scanning == true {
                if i >= n {
                    scanning = false;
                } else {
                    let b = ((int)s.char_at(i));
                    // Escape `"`, `\`, and ASCII controls; pass through the rest.
                    if (b < 32) || (b == 34) || (b == 92) {
                        scanning = false;
                    } else {
                        i = i + 1;
                    }
                }
            }
            if i > run_start {
                sb.append_utf8_slice(s, run_start * 2, (i - run_start) * 2);
            }
            if i >= n {
                break;
            }
            let b = ((int)s.char_at(i));
            if b == 34 {
                sb.append_char('\\');
                sb.append_char('"');
            } else if (b == 92) {
                sb.append_char('\\');
                sb.append_char('\\');
            } else if (b == 10) {
                sb.append_char('\\');
                sb.append_char('n');
            } else if (b == 9) {
                sb.append_char('\\');
                sb.append_char('t');
            } else if (b == 13) {
                sb.append_char('\\');
                sb.append_char('r');
            } else if (b == 8) {
                sb.append_char('\\');
                sb.append_char('b');
            } else if (b == 12) {
                sb.append_char('\\');
                sb.append_char('f');
            } else {
                sb.append("\\u");
                Json._append_hex4(sb, b);
            }
            i = i + 1;
        }
        sb.append_char('"');
    }

    // Formats a JSON number: integral values print without a decimal point, others fall back to the
    // default double formatting.
    static fun _json_number(n: double): string {
        let i = (int)n;
        if (double)i == n {
            return i.to_string();
        }
        return n.to_string();
    }

    // Recursively serializes a JsonValue into `sb` as compact JSON text.
    static fun _json_stringify_into(borrow sb: StringBuilder, borrow v: JsonValue): void {
        let k = v.kind;
        if k == 0 {
            sb.append("null");
            return;
        }
        if k == 1 {
            if v.bool_val == true {
                sb.append("true");
            } else {
                sb.append("false");
            }
            return;
        }
        if k == 2 {
            sb.append(Json._json_number(v.num_val));
            return;
        }
        if k == 3 {
            Json._json_escape_into(sb, v.str_val);
            return;
        }
        if k == 4 {
            sb.append_char('[');
            let i = 0;
            let n = v.length;
            while i < n {
                if i > 0 {
                    sb.append_char(',');
                }
                Json._json_stringify_into(sb, v.at(i).unwrap_or(JsonValue.null()));
                i = i + 1;
            }
            sb.append_char(']');
            return;
        }
        if k == 5 {
            sb.append_char('{');
            let i = 0;
            let n = v.length;
            while i < n {
                if i > 0 {
                    sb.append_char(',');
                }
                let key = v.key_at(i).unwrap_or("");
                Json._json_escape_into(sb, key);
                sb.append_char(':');
                Json._json_stringify_into(sb, v.value_at(i).unwrap_or(JsonValue.null()));
                i = i + 1;
            }
            sb.append_char('}');
            return;
        }
        sb.append("null");
    }

    // Spelling of the declared field `declared` under `options.naming`. Words split at `_`, `-`,
    // and a lowercase letter or digit followed by an uppercase letter.
    internal static fun field_name(borrow declared: string, borrow options: JsonOptions): string {
        let naming = options.naming;
        if naming == JsonNaming.Identity {
            return declared;
        }
        let out = StringBuilder();
        let words = 0;
        let in_word = false;
        let previous_lower = false;
        let i = 0;
        while i < declared.length {
            let c = ((int)declared.char_at(i));
            let upper = (c >= 65) && (c <= 90);
            if (c == 95) || (c == 45) {
                in_word = false;
                previous_lower = false;
            } else {
                if in_word && upper && previous_lower {
                    in_word = false;
                }
                let lower = c;
                if upper {
                    lower = c + 32;
                }
                if in_word == false {
                    if words > 0 {
                        if naming == JsonNaming.SnakeCase {
                            out.append_char('_');
                        } else if naming == JsonNaming.KebabCase {
                            out.append_char('-');
                        }
                    }
                    if (naming == JsonNaming.PascalCase)
                        || (naming == JsonNaming.CamelCase && words > 0) {
                        if (lower >= 97) && (lower <= 122) {
                            lower = lower - 32;
                        }
                    }
                    words = words + 1;
                    in_word = true;
                }
                out.append_char((char)lower);
                previous_lower = ((c >= 97) && (c <= 122)) || ((c >= 48) && (c <= 57));
            }
            i = i + 1;
        }
        return out.build();
    }

    // Writes `"<name>":` for the declared field `declared`, spelled under `options.naming`.
    internal static fun write_key(
        borrow sb: StringBuilder,
        borrow declared: string,
        borrow options: JsonOptions
    ): void {
        Json._json_escape_into(sb, Json.field_name(declared, options));
        sb.append_char(':');
    }

    // Property of `v` for the declared field `declared`, spelled under `options.naming`.
    internal static fun get_field(
        borrow v: JsonValue,
        borrow declared: string,
        borrow options: JsonOptions
    ): Option<JsonValue> {
        return Json.get_key(v, Json.field_name(declared, options), options);
    }

    // Property `key` of `v`; under `options.ignore_case` the first ASCII case-insensitive match.
    internal static fun get_key(
        borrow v: JsonValue,
        borrow key: string,
        borrow options: JsonOptions
    ): Option<JsonValue> {
        let exact = v.get(key);
        if (options.ignore_case == false) || exact.is_some() {
            return exact;
        }
        let i = 0;
        let n = v.length;
        while i < n {
            if Json.equals_ignore_case(v.key_at(i).unwrap_or(""), key) {
                return v.value_at(i);
            }
            i = i + 1;
        }
        return Option.None;
    }

    // Whether `a` and `b` are equal when ASCII letters are compared without case.
    internal static fun equals_ignore_case(borrow a: string, borrow b: string): bool {
        if a.length != b.length {
            return false;
        }
        let i = 0;
        while i < a.length {
            let x = ((int)a.char_at(i));
            let y = ((int)b.char_at(i));
            if (x >= 65) && (x <= 90) {
                x = x + 32;
            }
            if (y >= 65) && (y <= 90) {
                y = y + 32;
            }
            if x != y {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    // Final text of a `serialize` call: compact `sb`, or re-indented under `options.indent`.
    internal static fun finish(borrow sb: StringBuilder, borrow options: JsonOptions): string {
        let text = sb.build();
        if options.indent <= 0 {
            return text;
        }
        return Json._json_indent(text, options.indent);
    }

    static fun _json_line(borrow sb: StringBuilder, depth: int, indent: int): void {
        sb.append_char('\n');
        let i = 0;
        while i < depth * indent {
            sb.append_char(' ');
            i = i + 1;
        }
    }

    // Re-indents valid JSON text. Whitespace outside strings is dropped first, so already
    // indented nested output (type-parameter fields serialize separately) indents only once.
    static fun _json_indent(borrow text: string, indent: int): string {
        let out = StringBuilder();
        let n = text.length;
        let depth = 0;
        let in_string = false;
        let escaped = false;
        let run_start = 0;
        let i = 0;
        while i < n {
            let c = ((int)text.char_at(i));
            if in_string {
                if escaped {
                    escaped = false;
                } else if c == 92 {
                    escaped = true;
                } else if c == 34 {
                    in_string = false;
                }
                i = i + 1;
            } else if c == 34 {
                in_string = true;
                i = i + 1;
            } else if Json._json_is_layout(c) {
                if i > run_start {
                    out.append(text.span(run_start, i));
                }
                if (c == 123) || (c == 91) {
                    let j = i + 1;
                    while (j < n) && Json._json_is_space(((int)text.char_at(j))) {
                        j = j + 1;
                    }
                    out.append_char((char)c);
                    if (j < n) && (((int)text.char_at(j)) == c + 2) {
                        out.append_char((char)(c + 2));
                        i = j;
                    } else {
                        depth = depth + 1;
                        Json._json_line(out, depth, indent);
                    }
                } else if (c == 125) || (c == 93) {
                    depth = depth - 1;
                    Json._json_line(out, depth, indent);
                    out.append_char((char)c);
                } else if c == 44 {
                    out.append_char(',');
                    Json._json_line(out, depth, indent);
                } else if c == 58 {
                    out.append(": ");
                }
                i = i + 1;
                run_start = i;
            } else {
                i = i + 1;
            }
        }
        if n > run_start {
            out.append(text.span(run_start, n));
        }
        return out.build();
    }

    // Characters outside strings that `_json_indent` rewrites: brackets, `,`, `:`, and whitespace.
    static fun _json_is_layout(c: int): bool {
        if (c == 123) || (c == 91) || (c == 125) || (c == 93) || (c == 44) || (c == 58) {
            return true;
        }
        return Json._json_is_space(c);
    }

    static fun _json_is_space(c: int): bool {
        return (c == 32) || (c == 10) || (c == 9) || (c == 13);
    }
}
