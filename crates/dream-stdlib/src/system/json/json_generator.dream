module system.json;

import system.codegen;
import system.text;

// Dream `@json` source generator: builds `extend Type { to_json / write_json / from_json }` source
// from a [`GenType`] snapshot. Invoked by the compile host during the generate pass.

public class JsonGenerator {
    // Emits `extend … { to_json / write_json / from_json }` source for each snapshot in `types`.
    public static fun expand(borrow types: List<GenType>, borrow json_names: List<string>, borrow jsonable: List<string>): GenResult {
        let cb = CodeBuilder();
        let i = 0;
        while (i < types.length) {
            let t = types.get(i).unwrap_or(GenType.class_type("", List<string>(), List<GenField>()));
            let one = GenResult.failure("");
            if (t.is_union) {
                one = JsonGenerator.expand_union(t, json_names, jsonable);
            } else {
                one = JsonGenerator.expand_class(t, json_names, jsonable);
            }
            if (one.ok == false) {
                return one;
            }
            cb.append(one.source);
            cb.line("");
            i = i + 1;
        }
        return GenResult.success(cb.to_string());
    }

    static fun name_in(borrow list: List<string>, name: string): bool {
        let i = 0;
        while (i < list.length) {
            if (list.get(i).unwrap_or(string.empty) == name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    static fun missing_hint(core: string, borrow jsonable: List<string>): string {
        if (JsonGenerator.name_in(jsonable, core)) {
            return "; '" + core + "' must itself be marked @json (add the @json attribute to it)";
        }
        return string.empty;
    }

    static fun ignore_default(ftype: string, option_inner: string): string {
        if (option_inner.length > 0) {
            return "Option.None";
        }
        if (ftype.ends_with("[]")) {
            let elem = ftype.substring(0, ftype.length - 2);
            return "Buffer.alloc<" + elem + ">(0)";
        }
        if (ftype == "int" || ftype == "long" || ftype == "uint" || ftype == "ulong" || ftype == "byte") {
            return "0";
        }
        if (ftype == "float") {
            return "0.0f";
        }
        if (ftype == "double") {
            return "0.0";
        }
        if (ftype == "bool") {
            return "false";
        }
        if (ftype == "string") {
            return "\"\"";
        }
        if (ftype == "char") {
            return "'\\0'";
        }
        if (ftype.starts_with("List<") && ftype.ends_with(">")) {
            let inner = ftype.substring(5, ftype.length - 1);
            return "List<" + inner + ">()";
        }
        if (ftype.starts_with("Set<") && ftype.ends_with(">")) {
            let inner = ftype.substring(4, ftype.length - 1);
            return "Set<" + inner + ">()";
        }
        if (ftype.starts_with("Map<string, ") && ftype.ends_with(">")) {
            let inner = ftype.substring(12, ftype.length - 1);
            return "Map<string, " + inner + ">()";
        }
        if (ftype.starts_with("SortedMap<string, ") && ftype.ends_with(">")) {
            let inner = ftype.substring(18, ftype.length - 1);
            return "SortedMap<string, " + inner + ">()";
        }
        return string.empty;
    }

    static fun json_to_expr(elem_type: string, access: string, borrow json_names: List<string>): string {
        if (elem_type == "int") {
            return "JsonValue.from_int(" + access + ")";
        }
        if (elem_type == "double") {
            return "JsonValue.number(" + access + ")";
        }
        if (elem_type == "float") {
            return "JsonValue.number((double)" + access + ")";
        }
        if (elem_type == "bool") {
            return "JsonValue.boolean(" + access + ")";
        }
        if (elem_type == "string") {
            return "JsonValue.from_string(" + access + ")";
        }
        if (elem_type == "long") {
            return "JsonValue.number((double)" + access + ")";
        }
        if (JsonGenerator.name_in(json_names, elem_type)) {
            return access + ".to_json()";
        }
        return string.empty;
    }

    static fun json_from_expr(elem_type: string, jexpr: string, borrow json_names: List<string>): string {
        if (elem_type == "int") {
            return jexpr + ".as_int().unwrap_or(0)";
        }
        if (elem_type == "double") {
            return jexpr + ".as_double().unwrap_or(0.0d)";
        }
        if (elem_type == "float") {
            return "(float)" + jexpr + ".as_double().unwrap_or(0.0d)";
        }
        if (elem_type == "bool") {
            return jexpr + ".as_bool().unwrap_or(false)";
        }
        if (elem_type == "string") {
            return jexpr + ".as_string().unwrap_or(\"\")";
        }
        if (elem_type == "long") {
            return "(long)" + jexpr + ".as_double().unwrap_or(0.0d)";
        }
        if (JsonGenerator.name_in(json_names, elem_type)) {
            return elem_type + ".from_json(" + jexpr + ")";
        }
        return string.empty;
    }

    // True when `elem_type` can be written by `json_write_stmts` (scalars + nested `@json`).
    static fun can_json_write(elem_type: string, borrow json_names: List<string>): bool {
        if (elem_type == "int" || elem_type == "long" || elem_type == "uint" || elem_type == "ulong" || elem_type == "byte") {
            return true;
        }
        if (elem_type == "double" || elem_type == "float" || elem_type == "bool" || elem_type == "string") {
            return true;
        }
        return JsonGenerator.name_in(json_names, elem_type);
    }

    // Emits statements that append JSON for a scalar / nested `@json` value into `sb`.
    static fun json_write_stmts(
        borrow cb: CodeBuilder,
        elem_type: string,
        access: string,
        sb: string,
        borrow json_names: List<string>
    ): bool {
        if (elem_type == "int" || elem_type == "uint" || elem_type == "ulong" || elem_type == "byte") {
            cb.line(sb + ".append(" + access + ".to_string());");
            return true;
        }
        if (elem_type == "long") {
            cb.line("Json.write_number(" + sb + ", (double)" + access + ");");
            return true;
        }
        if (elem_type == "double") {
            cb.line("Json.write_number(" + sb + ", " + access + ");");
            return true;
        }
        if (elem_type == "float") {
            cb.line("Json.write_number(" + sb + ", (double)" + access + ");");
            return true;
        }
        if (elem_type == "bool") {
            cb.line("Json.write_bool(" + sb + ", " + access + ");");
            return true;
        }
        if (elem_type == "string") {
            cb.line("Json.write_string(" + sb + ", " + access + ");");
            return true;
        }
        if (JsonGenerator.name_in(json_names, elem_type)) {
            cb.line(access + ".write_json(" + sb + ");");
            return true;
        }
        return false;
    }

    // Emits `if (!__first) ','; __first = false; "key":` into an object-writing CodeBuilder.
    static fun write_object_key(borrow cb: CodeBuilder, json_key: string): void {
        cb.line("if (__first == false) { sb.append_char(','); }");
        cb.line("__first = false;");
        cb.line("sb.append(\"\\\"" + json_key + "\\\":\");");
    }

    static fun array_write_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        idx_var: string,
        borrow json_names: List<string>
    ): bool {
        if (JsonGenerator.can_json_write(elem, json_names) == false) {
            return false;
        }
        cb.line("sb.append_char('[');");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + access + ".length) {");
        cb.indent();
        cb.line("if (" + idx_var + " > 0) { sb.append_char(','); }");
        if (JsonGenerator.json_write_stmts(
            cb,
            elem,
            access + "[" + idx_var + "]",
            "sb",
            json_names
        ) == false) {
            return false;
        }
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        cb.line("sb.append_char(']');");
        return true;
    }

    static fun list_write_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        idx_var: string,
        elem_var: string,
        borrow json_names: List<string>
    ): bool {
        if (JsonGenerator.can_json_write(elem, json_names) == false) {
            return false;
        }
        cb.line("sb.append_char('[');");
        cb.line("let " + idx_var + " = 0;");
        cb.line("let __wfirst_" + idx_var + " = true;");
        cb.line("while (" + idx_var + " < " + access + ".length) {");
        cb.indent();
        cb.line("switch (" + access + ".get(" + idx_var + ")) {");
        cb.indent();
        cb.line("Some(" + elem_var + ") => {");
        cb.indent();
        cb.line("if (__wfirst_" + idx_var + " == false) { sb.append_char(','); }");
        cb.line("__wfirst_" + idx_var + " = false;");
        if (JsonGenerator.json_write_stmts(cb, elem, elem_var, "sb", json_names) == false) {
            return false;
        }
        cb.dedent();
        cb.line("}");
        cb.line("None => {}");
        cb.dedent();
        cb.line("}");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        cb.line("sb.append_char(']');");
        return true;
    }

    static fun set_write_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        elem_var: string,
        borrow json_names: List<string>
    ): bool {
        if (JsonGenerator.can_json_write(elem, json_names) == false) {
            return false;
        }
        cb.line("sb.append_char('[');");
        cb.line("let __wfirst_" + elem_var + " = true;");
        cb.line("for (let " + elem_var + " in " + access + ") {");
        cb.indent();
        cb.line("if (__wfirst_" + elem_var + " == false) { sb.append_char(','); }");
        cb.line("__wfirst_" + elem_var + " = false;");
        if (JsonGenerator.json_write_stmts(cb, elem, elem_var, "sb", json_names) == false) {
            return false;
        }
        cb.dedent();
        cb.line("}");
        cb.line("sb.append_char(']');");
        return true;
    }

    static fun map_write_stmts(
        borrow cb: CodeBuilder,
        value_type: string,
        access: string,
        pair_var: string,
        borrow json_names: List<string>
    ): bool {
        if (JsonGenerator.can_json_write(value_type, json_names) == false) {
            return false;
        }
        cb.line("sb.append_char('{');");
        cb.line("let __wfirst_" + pair_var + " = true;");
        cb.line("for (let " + pair_var + " in " + access + ") {");
        cb.indent();
        cb.line("if (__wfirst_" + pair_var + " == false) { sb.append_char(','); }");
        cb.line("__wfirst_" + pair_var + " = false;");
        cb.line("Json.write_string(sb, " + pair_var + ".key);");
        cb.line("sb.append_char(':');");
        if (JsonGenerator.json_write_stmts(
            cb,
            value_type,
            pair_var + ".value",
            "sb",
            json_names
        ) == false) {
            return false;
        }
        cb.dedent();
        cb.line("}");
        cb.line("sb.append_char('}');");
        return true;
    }

    static fun tuple_write_stmts(
        borrow cb: CodeBuilder,
        ftype: string,
        access: string,
        borrow json_names: List<string>
    ): bool {
        let elems = JsonGenerator.tuple_elems(ftype);
        if (elems.length < 2) {
            return false;
        }
        cb.line("sb.append_char('[');");
        let i = 0;
        while (i < elems.length) {
            if (i > 0) {
                cb.line("sb.append_char(',');");
            }
            let elem = elems.get(i).unwrap_or(string.empty);
            let acc = access + "." + i.to_string();
            if (JsonGenerator.is_tuple_type(elem)) {
                if (JsonGenerator.tuple_write_stmts(cb, elem, acc, json_names) == false) {
                    return false;
                }
            } else if (elem.ends_with("[]")) {
                let ae = elem.substring(0, elem.length - 2);
                if (JsonGenerator.array_write_stmts(
                    cb,
                    ae,
                    acc,
                    "__wi" + i.to_string(),
                    json_names
                ) == false) {
                    return false;
                }
            } else {
                if (JsonGenerator.json_write_stmts(cb, elem, acc, "sb", json_names) == false) {
                    return false;
                }
            }
            i = i + 1;
        }
        cb.line("sb.append_char(']');");
        return true;
    }

    static fun array_to_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        arr_var: string,
        idx_var: string,
        borrow json_names: List<string>
    ): bool {
        let to_e = JsonGenerator.json_to_expr(elem, access + "[" + idx_var + "]", json_names);
        if (to_e.length == 0) {
            return false;
        }
        cb.line("let " + arr_var + " = JsonValue.array();");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + access + ".length) {");
        cb.indent();
        cb.line(arr_var + ".push(" + to_e + ");");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun array_from_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        jexpr: string,
        out_var: string,
        idx_var: string,
        src_var: string,
        borrow json_names: List<string>
    ): bool {
        let from_e = JsonGenerator.json_from_expr(
            elem,
            src_var + ".at(" + idx_var + ").unwrap_or(JsonValue.none())",
            json_names
        );
        if (from_e.length == 0) {
            return false;
        }
        cb.line("let " + src_var + " = " + jexpr + ";");
        cb.line("let " + out_var + " = Buffer.alloc<" + elem + ">(" + src_var + ".length);");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + src_var + ".length) {");
        cb.indent();
        cb.line(out_var + "[" + idx_var + "] = " + from_e + ";");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun list_to_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        arr_var: string,
        idx_var: string,
        elem_var: string,
        borrow json_names: List<string>
    ): bool {
        let to_e = JsonGenerator.json_to_expr(elem, elem_var, json_names);
        if (to_e.length == 0) {
            return false;
        }
        cb.line("let " + arr_var + " = JsonValue.array();");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + access + ".length) {");
        cb.indent();
        cb.line("switch (" + access + ".get(" + idx_var + ")) {");
        cb.indent();
        cb.line("Some(" + elem_var + ") => { " + arr_var + ".push(" + to_e + "); }");
        cb.line("None => {}");
        cb.dedent();
        cb.line("}");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun list_from_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        jexpr: string,
        out_var: string,
        idx_var: string,
        src_var: string,
        borrow json_names: List<string>
    ): bool {
        let from_e = JsonGenerator.json_from_expr(
            elem,
            src_var + ".at(" + idx_var + ").unwrap_or(JsonValue.none())",
            json_names
        );
        if (from_e.length == 0) {
            return false;
        }
        cb.line("let " + src_var + " = " + jexpr + ";");
        cb.line("let " + out_var + " = List<" + elem + ">();");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + src_var + ".length) {");
        cb.indent();
        cb.line(out_var + ".push(" + from_e + ");");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun set_to_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        access: string,
        arr_var: string,
        elem_var: string,
        borrow json_names: List<string>
    ): bool {
        let to_e = JsonGenerator.json_to_expr(elem, elem_var, json_names);
        if (to_e.length == 0) {
            return false;
        }
        cb.line("let " + arr_var + " = JsonValue.array();");
        cb.line("for (let " + elem_var + " in " + access + ") {");
        cb.indent();
        cb.line(arr_var + ".push(" + to_e + ");");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun set_from_stmts(
        borrow cb: CodeBuilder,
        elem: string,
        jexpr: string,
        out_var: string,
        idx_var: string,
        src_var: string,
        borrow json_names: List<string>
    ): bool {
        let from_e = JsonGenerator.json_from_expr(
            elem,
            src_var + ".at(" + idx_var + ").unwrap_or(JsonValue.none())",
            json_names
        );
        if (from_e.length == 0) {
            return false;
        }
        cb.line("let " + src_var + " = " + jexpr + ";");
        cb.line("let " + out_var + " = Set<" + elem + ">();");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + src_var + ".length) {");
        cb.indent();
        cb.line(out_var + ".add(" + from_e + ");");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    // `Map<string, V>` -> a JSON object keyed by the map's (string) keys. `pair_var` names the
    // `for (let pair in access)` loop variable.
    static fun map_to_stmts(
        borrow cb: CodeBuilder,
        value_type: string,
        access: string,
        out_var: string,
        pair_var: string,
        borrow json_names: List<string>
    ): bool {
        let to_e = JsonGenerator.json_to_expr(value_type, pair_var + ".value", json_names);
        if (to_e.length == 0) {
            return false;
        }
        cb.line("let " + out_var + " = JsonValue.dict();");
        cb.line("for (let " + pair_var + " in " + access + ") {");
        cb.indent();
        cb.line(out_var + ".set(" + pair_var + ".key, " + to_e + ");");
        cb.dedent();
        cb.line("}");
        return true;
    }

    // Inverse of `map_to_stmts`: rebuilds a `Map<string, V>` / `SortedMap<string, V>` from a JSON object.
    static fun map_from_stmts(
        borrow cb: CodeBuilder,
        value_type: string,
        map_ctor: string,
        jexpr: string,
        out_var: string,
        src_var: string,
        keys_var: string,
        idx_var: string,
        key_var: string,
        borrow json_names: List<string>
    ): bool {
        let from_e = JsonGenerator.json_from_expr(
            value_type,
            src_var + ".get(" + key_var + ").unwrap_or(JsonValue.none())",
            json_names
        );
        if (from_e.length == 0) {
            return false;
        }
        cb.line("let " + src_var + " = " + jexpr + ";");
        cb.line("let " + out_var + " = " + map_ctor + "<string, " + value_type + ">();");
        cb.line("let " + keys_var + " = " + src_var + ".keys();");
        cb.line("let " + idx_var + " = 0;");
        cb.line("while (" + idx_var + " < " + keys_var + ".length) {");
        cb.indent();
        cb.line("let " + key_var + " = " + keys_var + ".get(" + idx_var + ").unwrap_or(\"\");");
        cb.line(out_var + ".set(" + key_var + ", " + from_e + ");");
        cb.line(idx_var + " = " + idx_var + " + 1;");
        cb.dedent();
        cb.line("}");
        return true;
    }

    static fun is_tuple_type(ftype: string): bool {
        return ftype.starts_with("(") && ftype.ends_with(")") && ftype.length > 2;
    }

    // Split a tuple type spelling `(T,U,…)` / `((T,U),V)` into element type spellings at depth 0.
    static fun tuple_elems(ftype: string): List<string> {
        let out = List<string>();
        if (JsonGenerator.is_tuple_type(ftype) == false) {
            return out;
        }
        let inner = ftype.substring(1, ftype.length - 1);
        let cur = string.empty;
        let depth = 0;
        let i = 0;
        while (i < inner.length) {
            let ch = inner.char_at(i);
            if (ch == '(') {
                depth = depth + 1;
                cur = cur + "(";
            } else if (ch == ')') {
                depth = depth - 1;
                cur = cur + ")";
            } else if (ch == ',' && depth == 0) {
                if (cur.length > 0) {
                    out.push(cur);
                }
                cur = string.empty;
            } else if (ch == ' ' && depth == 0 && cur.length == 0) {
                // skip leading spaces after commas
            } else {
                cur = cur + inner.substring(i, i + 1);
            }
            i = i + 1;
        }
        if (cur.length > 0) {
            out.push(cur);
        }
        return out;
    }

    static fun tuple_to_stmts(
        borrow cb: CodeBuilder,
        ftype: string,
        access: string,
        arr_var: string,
        borrow json_names: List<string>
    ): bool {
        let elems = JsonGenerator.tuple_elems(ftype);
        if (elems.length < 2) {
            return false;
        }
        cb.line("let " + arr_var + " = JsonValue.array();");
        let i = 0;
        while (i < elems.length) {
            let elem = elems.get(i).unwrap_or(string.empty);
            let acc = access + "." + i.to_string();
            if (JsonGenerator.is_tuple_type(elem)) {
                let nested = arr_var + "_t" + i.to_string();
                if (JsonGenerator.tuple_to_stmts(cb, elem, acc, nested, json_names) == false) {
                    return false;
                }
                cb.line(arr_var + ".push(" + nested + ");");
            } else if (elem.ends_with("[]")) {
                let ae = elem.substring(0, elem.length - 2);
                let nested = arr_var + "_a" + i.to_string();
                if (JsonGenerator.array_to_stmts(
                    cb,
                    ae,
                    acc,
                    nested,
                    arr_var + "_i" + i.to_string(),
                    json_names
                ) == false) {
                    return false;
                }
                cb.line(arr_var + ".push(" + nested + ");");
            } else {
                let to_e = JsonGenerator.json_to_expr(elem, acc, json_names);
                if (to_e.length == 0) {
                    return false;
                }
                cb.line(arr_var + ".push(" + to_e + ");");
            }
            i = i + 1;
        }
        return true;
    }

    static fun tuple_from_stmts(
        borrow cb: CodeBuilder,
        ftype: string,
        jexpr: string,
        out_var: string,
        src_var: string,
        borrow json_names: List<string>
    ): bool {
        let elems = JsonGenerator.tuple_elems(ftype);
        if (elems.length < 2) {
            return false;
        }
        cb.line("let " + src_var + " = " + jexpr + ";");
        let parts_sb = StringBuilder();
        let first_part = true;
        let i = 0;
        while (i < elems.length) {
            let elem = elems.get(i).unwrap_or(string.empty);
            let je = src_var + ".at(" + i.to_string() + ").unwrap_or(JsonValue.none())";
            if (JsonGenerator.is_tuple_type(elem)) {
                let nested = out_var + "_t" + i.to_string();
                if (JsonGenerator.tuple_from_stmts(
                    cb,
                    elem,
                    je,
                    nested,
                    src_var + "_s" + i.to_string(),
                    json_names
                ) == false) {
                    return false;
                }
                first_part = JsonGenerator.comma_append(parts_sb, first_part, nested);
            } else if (elem.ends_with("[]")) {
                let ae = elem.substring(0, elem.length - 2);
                let nested = out_var + "_a" + i.to_string();
                if (JsonGenerator.array_from_stmts(
                    cb,
                    ae,
                    je,
                    nested,
                    out_var + "_i" + i.to_string(),
                    src_var + "_as" + i.to_string(),
                    json_names
                ) == false) {
                    return false;
                }
                first_part = JsonGenerator.comma_append(parts_sb, first_part, nested);
            } else {
                let from_e = JsonGenerator.json_from_expr(elem, je, json_names);
                if (from_e.length == 0) {
                    return false;
                }
                first_part = JsonGenerator.comma_append(parts_sb, first_part, from_e);
            }
            i = i + 1;
        }
        cb.line("let " + out_var + " = (" + parts_sb.build() + ");");
        return true;
    }

    // Emit each line of a level-0 CodeBuilder block at the caller's current indent.
    static fun append_block(borrow cb: CodeBuilder, block: string): void {
        let start = 0;
        let i = 0;
        let n = block.length;
        while (i < n) {
            if (block.char_at(i) == '\n') {
                cb.line(block.substring(start, i));
                start = i + 1;
            }
            i = i + 1;
        }
        if (start < n) {
            cb.line(block.substring(start, n));
        }
    }


    static fun fail_field(type_name: string, field_name: string, message: string): GenResult {
        return GenResult.failure_at(message, type_name, field_name);
    }

    // Appends `piece` to a comma-separated arg list. Returns false so callers can write `first = comma_append(...)`.
    static fun comma_append(sb: StringBuilder, first: bool, piece: string): bool {
        if (!first) {
            sb.append(", ");
        }
        sb.append(piece);
        return false;
    }

    static fun expand_class(borrow t: GenType, borrow json_names: List<string>, borrow jsonable: List<string>): GenResult {
        let to_cb = CodeBuilder();
        let write_cb = CodeBuilder();
        let from_cb = CodeBuilder();
        to_cb.line("let __o = JsonValue.dict();");
        write_cb.line("sb.append_char('{');");
        write_cb.line("let __first = true;");
        let from_sb = StringBuilder();
        let first_field = true;
        let fi = 0;
        while (fi < t.fields.length) {
            let field = t.fields.get(fi).unwrap_or(GenField.make("", "", false, "", "", false, "", "", "", ""));
            let fname = field.name;
            let ftype = field.type_name;
            let json_key = field.json_key();

            if (field.json_ignore) {
                let def = JsonGenerator.ignore_default(ftype, field.option_inner);
                if (def.length == 0) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has @json_ignore but type '" + ftype + "' has no zero default (use `Option<" + ftype + ">` or remove @json_ignore)",
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, def);
                fi = fi + 1;
                continue;
            }

            if (field.option_inner.length > 0) {
                let base = field.option_inner;
                if (base.ends_with("[]")) {
                    let elem = base.substring(0, base.length - 2);
                    to_cb.line("switch (this." + fname + ") {");
                    to_cb.indent();
                    to_cb.line("Some(__v_" + fname + ") => {");
                    to_cb.indent();
                    if (JsonGenerator.array_to_stmts(
                        to_cb,
                        elem,
                        "__v_" + fname,
                        "__arr_" + fname,
                        "__i_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json class '" + t.name + "' field '" + fname + "' has unsupported optional array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    to_cb.line("__o.set(\"" + json_key + "\", __arr_" + fname + ");");
                    to_cb.dedent();
                    to_cb.line("}");
                    to_cb.line("None => { __o.set(\"" + json_key + "\", JsonValue.none()); }");
                    to_cb.dedent();
                    to_cb.line("}");
                    JsonGenerator.write_object_key(write_cb, json_key);
                    write_cb.line("switch (this." + fname + ") {");
                    write_cb.indent();
                    write_cb.line("Some(__v_" + fname + ") => {");
                    write_cb.indent();
                    if (JsonGenerator.array_write_stmts(
                        write_cb,
                        elem,
                        "__v_" + fname,
                        "__wi_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json class '" + t.name + "' field '" + fname + "' has unsupported optional array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    write_cb.dedent();
                    write_cb.line("}");
                    write_cb.line("None => { Json.write_null(sb); }");
                    write_cb.dedent();
                    write_cb.line("}");
                    from_cb.line("let __" + fname + ": Option<" + base + "> = Option.None;");
                    from_cb.line("let __src_" + fname + " = v.get(\"" + json_key + "\").unwrap_or(JsonValue.none());");
                    from_cb.line("if (__src_" + fname + ".is_null() == false) {");
                    from_cb.indent();
                    if (JsonGenerator.array_from_stmts(
                        from_cb,
                        elem,
                        "__src_" + fname,
                        "__inner_" + fname,
                        "__i_" + fname,
                        "__asrc_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json class '" + t.name + "' field '" + fname + "' has unsupported optional array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    from_cb.line("__" + fname + " = Option.Some(__inner_" + fname + ");");
                    from_cb.dedent();
                    from_cb.line("}");
                    first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                    fi = fi + 1;
                    continue;
                }

                let to_inner = JsonGenerator.json_to_expr(base, "__v_" + fname, json_names);
                let from_inner = JsonGenerator.json_from_expr(base, "__src_" + fname, json_names);
                if (to_inner.length == 0 || from_inner.length == 0) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported optional type '" + ftype + "' (only `Option<string>`, `Option<int/long/double/float/bool>`, `Option<@json class>`, and `Option<T[]>` of those are supported)" + JsonGenerator.missing_hint(base, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("switch (this." + fname + ") {");
                to_cb.indent();
                to_cb.line("Some(__v_" + fname + ") => { __o.set(\"" + json_key + "\", " + to_inner + "); }");
                to_cb.line("None => { __o.set(\"" + json_key + "\", JsonValue.none()); }");
                to_cb.dedent();
                to_cb.line("}");
                JsonGenerator.write_object_key(write_cb, json_key);
                write_cb.line("switch (this." + fname + ") {");
                write_cb.indent();
                write_cb.line("Some(__v_" + fname + ") => {");
                write_cb.indent();
                if (JsonGenerator.json_write_stmts(
                    write_cb,
                    base,
                    "__v_" + fname,
                    "sb",
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported optional type '" + ftype + "'" + JsonGenerator.missing_hint(base, jsonable),
                                t.name,
                                fname
                            );
                }
                write_cb.dedent();
                write_cb.line("}");
                write_cb.line("None => { Json.write_null(sb); }");
                write_cb.dedent();
                write_cb.line("}");
                from_cb.line("let __" + fname + ": Option<" + base + "> = Option.None;");
                from_cb.line("let __src_" + fname + " = v.get(\"" + json_key + "\").unwrap_or(JsonValue.none());");
                from_cb.line("if (__src_" + fname + ".is_null() == false) {");
                from_cb.indent();
                from_cb.line("__" + fname + " = Option.Some(" + from_inner + ");");
                from_cb.dedent();
                from_cb.line("}");
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (field.map_value_inner.length > 0) {
                let value_type = field.map_value_inner;
                let map_ctor = field.map_ctor;
                if (map_ctor.length == 0) {
                    map_ctor = "Map";
                }
                if (JsonGenerator.map_to_stmts(
                    to_cb,
                    value_type,
                    "this." + fname,
                    "__map_" + fname,
                    "__pair_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported map value type '" + value_type + "'" + JsonGenerator.missing_hint(value_type, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("__o.set(\"" + json_key + "\", __map_" + fname + ");");
                JsonGenerator.write_object_key(write_cb, json_key);
                if (JsonGenerator.map_write_stmts(
                    write_cb,
                    value_type,
                    "this." + fname,
                    "__wpair_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported map value type '" + value_type + "'" + JsonGenerator.missing_hint(value_type, jsonable),
                                t.name,
                                fname
                            );
                }
                if (JsonGenerator.map_from_stmts(
                    from_cb,
                    value_type,
                    map_ctor,
                    "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                    "__" + fname,
                    "__msrc_" + fname,
                    "__mkeys_" + fname,
                    "__mi_" + fname,
                    "__mk_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported map value type '" + value_type + "'" + JsonGenerator.missing_hint(value_type, jsonable),
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (field.seq_kind == "list") {
                let elem = field.seq_elem_inner;
                if (JsonGenerator.list_to_stmts(
                    to_cb,
                    elem,
                    "this." + fname,
                    "__arr_" + fname,
                    "__i_" + fname,
                    "__e_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported list element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("__o.set(\"" + json_key + "\", __arr_" + fname + ");");
                JsonGenerator.write_object_key(write_cb, json_key);
                if (JsonGenerator.list_write_stmts(
                    write_cb,
                    elem,
                    "this." + fname,
                    "__wi_" + fname,
                    "__we_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported list element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                if (JsonGenerator.list_from_stmts(
                    from_cb,
                    elem,
                    "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                    "__" + fname,
                    "__i_" + fname,
                    "__src_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported list element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (field.seq_kind == "set") {
                let elem = field.seq_elem_inner;
                if (JsonGenerator.set_to_stmts(
                    to_cb,
                    elem,
                    "this." + fname,
                    "__arr_" + fname,
                    "__e_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported set element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("__o.set(\"" + json_key + "\", __arr_" + fname + ");");
                JsonGenerator.write_object_key(write_cb, json_key);
                if (JsonGenerator.set_write_stmts(
                    write_cb,
                    elem,
                    "this." + fname,
                    "__we_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported set element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                if (JsonGenerator.set_from_stmts(
                    from_cb,
                    elem,
                    "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                    "__" + fname,
                    "__i_" + fname,
                    "__src_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported set element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (ftype.ends_with("[]")) {
                let elem = ftype.substring(0, ftype.length - 2);
                if (JsonGenerator.array_to_stmts(
                    to_cb,
                    elem,
                    "this." + fname,
                    "__arr_" + fname,
                    "__i_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("__o.set(\"" + json_key + "\", __arr_" + fname + ");");
                JsonGenerator.write_object_key(write_cb, json_key);
                if (JsonGenerator.array_write_stmts(
                    write_cb,
                    elem,
                    "this." + fname,
                    "__wi_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                if (JsonGenerator.array_from_stmts(
                    from_cb,
                    elem,
                    "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                    "__" + fname,
                    "__i_" + fname,
                    "__src_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (JsonGenerator.is_tuple_type(ftype)) {
                if (JsonGenerator.tuple_to_stmts(
                    to_cb,
                    ftype,
                    "this." + fname,
                    "__arr_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                t.name,
                                fname
                            );
                }
                to_cb.line("__o.set(\"" + json_key + "\", __arr_" + fname + ");");
                JsonGenerator.write_object_key(write_cb, json_key);
                if (JsonGenerator.tuple_write_stmts(
                    write_cb,
                    ftype,
                    "this." + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                t.name,
                                fname
                            );
                }
                if (JsonGenerator.tuple_from_stmts(
                    from_cb,
                    ftype,
                    "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                    "__" + fname,
                    "__src_" + fname,
                    json_names
                ) == false) {
                    return GenResult.failure_at(
                                "@json class '" + t.name + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                t.name,
                                fname
                            );
                }
                first_field = JsonGenerator.comma_append(from_sb, first_field, "__" + fname);
                fi = fi + 1;
                continue;
            }

            if (field.is_type_param) {
                to_cb.line("__o.set(\"" + json_key + "\", Json.parse(Json.serialize(this." + fname + ")).unwrap_or(JsonValue.none()));");
                JsonGenerator.write_object_key(write_cb, json_key);
                write_cb.line("sb.append(Json.serialize(this." + fname + "));");
                first_field = JsonGenerator.comma_append(
                    from_sb,
                    first_field,
                    "Json.from_value<" + ftype + ">(v.get(\"" + json_key + "\").unwrap_or(JsonValue.none()))"
                );
                fi = fi + 1;
                continue;
            }

            let to_e = JsonGenerator.json_to_expr(ftype, "this." + fname, json_names);
            let from_e = JsonGenerator.json_from_expr(
                ftype,
                "v.get(\"" + json_key + "\").unwrap_or(JsonValue.none())",
                json_names
            );
            if (to_e.length == 0 || from_e.length == 0) {
                return GenResult.failure_at(
                            "@json class '" + t.name + "' field '" + fname + "' has unsupported type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                            t.name,
                            fname
                        );
            }
            to_cb.line("__o.set(\"" + json_key + "\", " + to_e + ");");
            JsonGenerator.write_object_key(write_cb, json_key);
            if (JsonGenerator.json_write_stmts(
                write_cb,
                ftype,
                "this." + fname,
                "sb",
                json_names
            ) == false) {
                return GenResult.failure_at(
                            "@json class '" + t.name + "' field '" + fname + "' has unsupported type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                            t.name,
                            fname
                        );
            }
            first_field = JsonGenerator.comma_append(from_sb, first_field, from_e);
            fi = fi + 1;
        }
        to_cb.line("return __o;");
        write_cb.line("sb.append_char('}');");
        let self_ty = t.self_ty();
        from_cb.line("return " + self_ty + "(" + from_sb.build() + ");");

        let cb = CodeBuilder();
        cb.line("extend " + t.name + t.params_clause() + " {");
        cb.indent();
        cb.line("public fun to_json(): JsonValue {");
        cb.indent();
        JsonGenerator.append_block(cb, to_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public fun write_json(sb: StringBuilder): void {");
        cb.indent();
        JsonGenerator.append_block(cb, write_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public static fun from_json(v: JsonValue): " + self_ty + " {");
        cb.indent();
        JsonGenerator.append_block(cb, from_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.dedent();
        cb.line("}");
        return GenResult.success(cb.to_string());
    }

    static fun expand_union(borrow t: GenType, borrow json_names: List<string>, borrow jsonable: List<string>): GenResult {
        let to_cb = CodeBuilder();
        let write_cb = CodeBuilder();
        let from_cb = CodeBuilder();
        to_cb.line("let __o = JsonValue.dict();");
        to_cb.line("switch (this) {");
        to_cb.indent();
        write_cb.line("switch (this) {");
        write_cb.indent();
        from_cb.line("let __t = v.get(\"type\").unwrap_or(JsonValue.none()).as_string().unwrap_or(\"\");");

        let known_sb = StringBuilder();
        let first_known = true;

        let vi = 0;
        while (vi < t.variants.length) {
            let variant = t.variants.get(vi).unwrap_or(GenVariant.make("", List<GenField>()));
            let vname = variant.name;
            if (!first_known) {
                known_sb.append(" || ");
            }
            known_sb.append("__t == \"" + vname + "\"");
            first_known = false;
            let pattern_sb = StringBuilder();
            pattern_sb.append(vname);
            if (variant.fields.is_empty() == false) {
                pattern_sb.append("(");
                let first_pat = true;
                let bi = 0;
                while (bi < variant.fields.length) {
                    first_pat = JsonGenerator.comma_append(
                        pattern_sb,
                        first_pat,
                        variant.fields.get(bi).unwrap_or(GenField.make("", "", false, "", "", false, "", "", "", "")).name
                    );
                    bi = bi + 1;
                }
                pattern_sb.append(")");
            }
            let pattern = pattern_sb.build();
            to_cb.line(pattern + " => {");
            to_cb.indent();
            to_cb.line("__o.set(\"type\", JsonValue.from_string(\"" + vname + "\"));");
            write_cb.line(pattern + " => {");
            write_cb.indent();
            write_cb.line("sb.append_char('{');");
            write_cb.line("sb.append(\"\\\"type\\\":\\\"" + vname + "\\\"\");");

            let arm_from = CodeBuilder();
            let args_sb = StringBuilder();
            let first_arg = true;
            let fi = 0;
            while (fi < variant.fields.length) {
                let field = variant.fields.get(fi).unwrap_or(GenField.make("", "", false, "", "", false, "", "", "", ""));
                let fname = field.name;
                let ftype = field.type_name;
                if (field.json_ignore) {
                    // skip serialize
                } else if (field.is_type_param) {
                    to_cb.line("__o.set(\"" + fname + "\", Json.parse(Json.serialize(" + fname + ")).unwrap_or(JsonValue.none()));");
                    write_cb.line("sb.append_char(',');");
                    write_cb.line("sb.append(\"\\\"" + fname + "\\\":\");");
                    write_cb.line("sb.append(Json.serialize(" + fname + "));");
                } else if (ftype.ends_with("[]")) {
                    let elem = ftype.substring(0, ftype.length - 2);
                    if (JsonGenerator.array_to_stmts(
                        to_cb,
                        elem,
                        fname,
                        "__arr_" + vname + "_" + fname,
                        "__i_" + vname + "_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    to_cb.line("__o.set(\"" + fname + "\", __arr_" + vname + "_" + fname + ");");
                    write_cb.line("sb.append_char(',');");
                    write_cb.line("sb.append(\"\\\"" + fname + "\\\":\");");
                    if (JsonGenerator.array_write_stmts(
                        write_cb,
                        elem,
                        fname,
                        "__wi_" + vname + "_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                } else if (JsonGenerator.is_tuple_type(ftype)) {
                    if (JsonGenerator.tuple_to_stmts(
                        to_cb,
                        ftype,
                        fname,
                        "__arr_" + vname + "_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    to_cb.line("__o.set(\"" + fname + "\", __arr_" + vname + "_" + fname + ");");
                    write_cb.line("sb.append_char(',');");
                    write_cb.line("sb.append(\"\\\"" + fname + "\\\":\");");
                    if (JsonGenerator.tuple_write_stmts(write_cb, ftype, fname, json_names) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                } else {
                    let expr = JsonGenerator.json_to_expr(ftype, fname, json_names);
                    if (expr.length == 0) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    to_cb.line("__o.set(\"" + fname + "\", " + expr + ");");
                    write_cb.line("sb.append_char(',');");
                    write_cb.line("sb.append(\"\\\"" + fname + "\\\":\");");
                    if (JsonGenerator.json_write_stmts(write_cb, ftype, fname, "sb", json_names) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                }

                if (field.json_ignore) {
                    let def = JsonGenerator.ignore_default(ftype, field.option_inner);
                    if (def.length == 0) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has @json_ignore but type '" + ftype + "' has no zero default",
                                    t.name,
                                    fname
                                );
                    }
                    first_arg = JsonGenerator.comma_append(args_sb, first_arg, def);
                } else {
                    let jexpr = "v.get(\"" + fname + "\").unwrap_or(JsonValue.none())";
                    if (field.is_type_param) {
                        first_arg = JsonGenerator.comma_append(
                            args_sb,
                            first_arg,
                            "Json.from_value<" + ftype + ">(" + jexpr + ")"
                        );
                    } else if (ftype.ends_with("[]")) {
                        let elem = ftype.substring(0, ftype.length - 2);
                        let out_var = "__" + vname + "_" + fname;
                        if (JsonGenerator.array_from_stmts(
                            arm_from,
                            elem,
                            jexpr,
                            out_var,
                            "__i_" + vname + "_" + fname,
                            "__src_" + vname + "_" + fname,
                            json_names
                        ) == false) {
                            return GenResult.failure_at(
                                        "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                        t.name,
                                        fname
                                    );
                        }
                        first_arg = JsonGenerator.comma_append(args_sb, first_arg, out_var);
                    } else if (JsonGenerator.is_tuple_type(ftype)) {
                        let out_var = "__" + vname + "_" + fname;
                        if (JsonGenerator.tuple_from_stmts(
                            arm_from,
                            ftype,
                            jexpr,
                            out_var,
                            "__src_" + vname + "_" + fname,
                            json_names
                        ) == false) {
                            return GenResult.failure_at(
                                        "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                        t.name,
                                        fname
                                    );
                        }
                        first_arg = JsonGenerator.comma_append(args_sb, first_arg, out_var);
                    } else {
                        let expr = JsonGenerator.json_from_expr(ftype, jexpr, json_names);
                        if (expr.length == 0) {
                            return GenResult.failure_at(
                                        "@json union '" + t.name + "' variant '" + vname + "' field '" + fname + "' has unsupported type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                        t.name,
                                        fname
                                    );
                        }
                        first_arg = JsonGenerator.comma_append(args_sb, first_arg, expr);
                    }
                }
                fi = fi + 1;
            }
            to_cb.dedent();
            to_cb.line("}");
            write_cb.line("sb.append_char('}');");
            write_cb.dedent();
            write_cb.line("}");

            from_cb.line("if (__t == \"" + vname + "\") {");
            from_cb.indent();
            if (variant.fields.is_empty()) {
                from_cb.line("return " + t.name + "." + vname + ";");
            } else {
                JsonGenerator.append_block(from_cb, arm_from.to_string());
                from_cb.line("return " + t.name + "." + vname + "(" + args_sb.build() + ");");
            }
            from_cb.dedent();
            from_cb.line("}");
            vi = vi + 1;
        }
        to_cb.dedent();
        to_cb.line("}");
        to_cb.line("return __o;");
        write_cb.dedent();
        write_cb.line("}");

        if (t.variants.is_empty()) {
            return GenResult.failure("@json union '" + t.name + "' has no variants");
        }
        let first = t.variants.get(0).unwrap_or(GenVariant.make("", List<GenField>()));
        if (first.fields.is_empty()) {
            from_cb.line("return " + t.name + "." + first.name + ";");
        } else {
            let fallback_args_sb = StringBuilder();
            let first_arg = true;
            let vname = first.name;
            let fi = 0;
            while (fi < first.fields.length) {
                let field = first.fields.get(fi).unwrap_or(GenField.make("", "", false, "", "", false, "", "", "", ""));
                let fname = field.name;
                let ftype = field.type_name;
                let jexpr = "v.get(\"" + fname + "\").unwrap_or(JsonValue.none())";
                if (field.json_ignore) {
                    let def = JsonGenerator.ignore_default(ftype, field.option_inner);
                    first_arg = JsonGenerator.comma_append(fallback_args_sb, first_arg, def);
                } else if (field.is_type_param) {
                    first_arg = JsonGenerator.comma_append(
                        fallback_args_sb,
                        first_arg,
                        "Json.from_value<" + ftype + ">(" + jexpr + ")"
                    );
                } else if (ftype.ends_with("[]")) {
                    let elem = ftype.substring(0, ftype.length - 2);
                    let out_var = "__fb_" + fname;
                    if (JsonGenerator.array_from_stmts(
                        from_cb,
                        elem,
                        jexpr,
                        out_var,
                        "__fbi_" + fname,
                        "__fbs_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' fallback field '" + fname + "' has unsupported array element type '" + elem + "'" + JsonGenerator.missing_hint(elem, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    first_arg = JsonGenerator.comma_append(fallback_args_sb, first_arg, out_var);
                } else if (JsonGenerator.is_tuple_type(ftype)) {
                    let out_var = "__fb_" + fname;
                    if (JsonGenerator.tuple_from_stmts(
                        from_cb,
                        ftype,
                        jexpr,
                        out_var,
                        "__fbs_" + fname,
                        json_names
                    ) == false) {
                        return GenResult.failure_at(
                                    "@json union '" + t.name + "' fallback field '" + fname + "' has unsupported tuple type '" + ftype + "'" + JsonGenerator.missing_hint(ftype, jsonable),
                                    t.name,
                                    fname
                                );
                    }
                    first_arg = JsonGenerator.comma_append(fallback_args_sb, first_arg, out_var);
                } else {
                    first_arg = JsonGenerator.comma_append(
                        fallback_args_sb,
                        first_arg,
                        JsonGenerator.json_from_expr(ftype, jexpr, json_names)
                    );
                }
                fi = fi + 1;
            }
            from_cb.line("return " + t.name + "." + vname + "(" + fallback_args_sb.build() + ");");
        }

        let self_ty = t.self_ty();
        let cb = CodeBuilder();
        cb.line("extend " + t.name + t.params_clause() + " {");
        cb.indent();
        cb.line("public fun to_json(): JsonValue {");
        cb.indent();
        JsonGenerator.append_block(cb, to_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public fun write_json(sb: StringBuilder): void {");
        cb.indent();
        JsonGenerator.append_block(cb, write_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public static fun from_json(v: JsonValue): " + self_ty + " {");
        cb.indent();
        JsonGenerator.append_block(cb, from_cb.to_string());
        cb.dedent();
        cb.line("}");
        // Strict variant check used by `Json.deserialize<T>` (see the `JsonDeserialize` intrinsic
        // expansion): unlike `from_json` above (kept lenient — falls back to the first variant — so
        // nested/array/tuple/type-param composition never has to thread a `Result` through a
        // constructor-argument expression), this reports an unknown discriminant as a real error
        // instead of silently defaulting.
        cb.line("public static fun __json_check_variant(v: JsonValue): Result<JsonValue, ParseError> {");
        cb.indent();
        cb.line("let __t = v.get(\"type\").unwrap_or(JsonValue.none()).as_string().unwrap_or(\"\");");
        if (known_sb.is_empty() == false) {
            cb.line("if (" + known_sb.build() + ") {");
            cb.indent();
            cb.line("return Result.Ok(v);");
            cb.dedent();
            cb.line("}");
        }
        cb.line("return Result.Err(ParseError.invalid(\"unknown variant '\" + __t + \"' for union '" + t.name + "'\"));");
        cb.dedent();
        cb.line("}");
        cb.dedent();
        cb.line("}");
        return GenResult.success(cb.to_string());
    }

    // Emits free `__col_ser_*` / `__col_write_*` / `__col_de_*` helpers for top-level
    // collection `Json.serialize` / `deserialize` / `from_value` (see `intrinsics.rs`).
    public static fun expand_collections(
        borrow specs: List<GenCollection>,
        borrow json_names: List<string>,
        borrow jsonable: List<string>
    ): GenResult {
        if (specs.is_empty()) {
            return GenResult.success("");
        }
        let cb = CodeBuilder();
        cb.line("extend Json {");
        cb.indent();
        let i = 0;
        while (i < specs.length) {
            let spec = specs.get(i).unwrap_or(GenCollection.make("", "", "", "", ""));
            let one = JsonGenerator.expand_collection_methods(spec, json_names, jsonable);
            if (one.ok == false) {
                return one;
            }
            JsonGenerator.append_block(cb, one.source);
            i = i + 1;
        }
        cb.dedent();
        cb.line("}");
        return GenResult.success(cb.to_string());
    }

    static fun expand_collection_methods(
        borrow spec: GenCollection,
        borrow json_names: List<string>,
        borrow jsonable: List<string>
    ): GenResult {
        let ser_name = "__col_ser_" + spec.fn_suffix;
        let write_name = "__col_write_" + spec.fn_suffix;
        let de_name = "__col_de_" + spec.fn_suffix;
        let to_cb = CodeBuilder();
        let write_cb = CodeBuilder();
        let from_cb = CodeBuilder();
        let ok = false;
        if (spec.kind == "list") {
            ok = JsonGenerator.list_to_stmts(
                to_cb,
                spec.elem_type,
                "xs",
                "__arr",
                "__i",
                "__e",
                json_names
            );
            if (ok) {
                to_cb.line("return __arr;");
                ok = JsonGenerator.list_write_stmts(
                    write_cb,
                    spec.elem_type,
                    "xs",
                    "__i",
                    "__e",
                    json_names
                );
            }
            if (ok) {
                ok = JsonGenerator.list_from_stmts(
                    from_cb,
                    spec.elem_type,
                    "v",
                    "__out",
                    "__i",
                    "__src",
                    json_names
                );
                if (ok) {
                    from_cb.line("return __out;");
                }
            }
        } else if (spec.kind == "set") {
            ok = JsonGenerator.set_to_stmts(to_cb, spec.elem_type, "xs", "__arr", "__e", json_names);
            if (ok) {
                to_cb.line("return __arr;");
                ok = JsonGenerator.set_write_stmts(write_cb, spec.elem_type, "xs", "__e", json_names);
            }
            if (ok) {
                ok = JsonGenerator.set_from_stmts(
                    from_cb,
                    spec.elem_type,
                    "v",
                    "__out",
                    "__i",
                    "__src",
                    json_names
                );
                if (ok) {
                    from_cb.line("return __out;");
                }
            }
        } else if (spec.kind == "array") {
            ok = JsonGenerator.array_to_stmts(
                to_cb,
                spec.elem_type,
                "xs",
                "__arr",
                "__i",
                json_names
            );
            if (ok) {
                to_cb.line("return __arr;");
                ok = JsonGenerator.array_write_stmts(
                    write_cb,
                    spec.elem_type,
                    "xs",
                    "__i",
                    json_names
                );
            }
            if (ok) {
                ok = JsonGenerator.array_from_stmts(
                    from_cb,
                    spec.elem_type,
                    "v",
                    "__out",
                    "__i",
                    "__src",
                    json_names
                );
                if (ok) {
                    from_cb.line("return __out;");
                }
            }
        } else if (spec.kind == "map" || spec.kind == "sortedmap") {
            let map_ctor = "Map";
            if (spec.kind == "sortedmap") {
                map_ctor = "SortedMap";
            }
            ok = JsonGenerator.map_to_stmts(
                to_cb,
                spec.value_type,
                "xs",
                "__map",
                "__pair",
                json_names
            );
            if (ok) {
                to_cb.line("return __map;");
                ok = JsonGenerator.map_write_stmts(
                    write_cb,
                    spec.value_type,
                    "xs",
                    "__pair",
                    json_names
                );
            }
            if (ok) {
                ok = JsonGenerator.map_from_stmts(
                    from_cb,
                    spec.value_type,
                    map_ctor,
                    "v",
                    "__out",
                    "__msrc",
                    "__mkeys",
                    "__mi",
                    "__mk",
                    json_names
                );
                if (ok) {
                    from_cb.line("return __out;");
                }
            }
        }
        if (ok == false) {
            let hint = string.empty;
            if (spec.kind == "list" || spec.kind == "set" || spec.kind == "array") {
                hint = JsonGenerator.missing_hint(spec.elem_type, jsonable);
            } else {
                hint = JsonGenerator.missing_hint(spec.value_type, jsonable);
            }
            return GenResult.failure(
                "unsupported collection type '" + spec.self_ty + "' for JSON serialization" + hint
            );
        }
        let cb = CodeBuilder();
        cb.line("public static fun " + ser_name + "(xs: " + spec.self_ty + "): JsonValue {");
        cb.indent();
        JsonGenerator.append_block(cb, to_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public static fun " + write_name + "(xs: " + spec.self_ty + ", sb: StringBuilder): void {");
        cb.indent();
        JsonGenerator.append_block(cb, write_cb.to_string());
        cb.dedent();
        cb.line("}");
        cb.line("public static fun " + de_name + "(v: JsonValue): " + spec.self_ty + " {");
        cb.indent();
        JsonGenerator.append_block(cb, from_cb.to_string());
        cb.dedent();
        cb.line("}");
        return GenResult.success(cb.to_string());
    }
}
