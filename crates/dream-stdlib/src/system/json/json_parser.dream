module system.json;

// Code-unit cursor recursive-descent JSON parser over the input string
// (`char_at` / `.length`) — no intermediate `byte[]` copy.
internal class JsonParser {
    text: string;
    pos: int;
    invalid: bool;
    public options: JsonOptions;

    /// Creates a `JsonParser` reading `text` from `pos`; `options` decides how generated readers
    /// match property names to fields.
    public constructor(text: string, pos: int, options: JsonOptions) {
        this.text = text;
        this.pos = pos;
        this.invalid = false;
        this.options = options;
    }

    fun len(): int {
        return this.text.length;
    }

    fun b(): int {
        return ((int)this.text.char_at(this.pos));
    }

    fun b_at(i: int): int {
        return ((int)this.text.char_at(i));
    }

    /// Advances past JSON whitespace.
    public fun skip_ws(): void {
        let going = true;
        while going == true {
            if this.pos >= this.len() {
                going = false;
            } else {
                let c = this.b();
                if (c == 32) || (c == 10) || (c == 9) || (c == 13) {
                    this.pos = this.pos + 1;
                } else {
                    going = false;
                }
            }
        }
    }

    /// Returns whether the cursor has reached the end of the input.
    public fun at_end(): bool {
        this.skip_ws();
        return this.pos >= this.len();
    }

    /// Current zero-based character position in the input.
    public fun cursor(): int {
        return this.pos;
    }

    /// Returns whether parsing has encountered an error.
    public fun failed(): bool {
        return this.invalid;
    }

    // Generated readers call this before the first item and after each subsequent item.
    /// Consumes a closing delimiter or the comma before another item. A negative `previous`
    /// marks the start of the container.
    public fun container_end(close: int, previous: int): bool {
        if this.invalid || this.at_end() || this.pos <= previous {
            this.invalid = true;
            return true;
        }
        if this.try_consume(close) {
            return true;
        }
        if previous >= 0 {
            if !this.try_consume(44) || this.at_end() || this.b() == close {
                this.invalid = true;
                return true;
            }
        }
        return false;
    }

    fun consume_keyword(borrow word: string): bool {
        if word.length > this.len()
            - this.pos || !this.text.span(this.pos, this.pos + word.length)
            .equals(word) {
            this.invalid = true;
            return false;
        }
        this.pos = this.pos + word.length;
        return true;
    }

    fun hex_nibble(c: int): int {
        if (c >= 48) && (c <= 57) {
            return c - 48;
        }
        if (c >= 97) && (c <= 102) {
            return c - 97 + 10;
        }
        if (c >= 65) && (c <= 70) {
            return c - 65 + 10;
        }
        return 0 - 1;
    }

    fun read_hex4(): int {
        let cp = 0;
        let k = 0;
        while k < 4 {
            if this.pos >= this.len() {
                return 0 - 1;
            }
            let h = this.hex_nibble(this.b());
            if h < 0 {
                return 0 - 1;
            }
            cp = cp * 16 + h;
            this.pos = this.pos + 1;
            k = k + 1;
        }
        return cp;
    }

    /// Reads a JSON string and advances the cursor; malformed input marks parsing as failed.
    public fun parse_string(): string {
        this.skip_ws();
        if (this.pos >= this.len()) || (this.b() != 34) {
            this.invalid = true;
            return "";
        }
        this.pos = this.pos + 1;
        // Parsed strings must own their payload; retaining a slice would expose input mutations.
        let first = this.pos;
        let n = this.len();
        this.pos = JsonStorage.boundary(this.text, first);
        if this.pos == n || this.b() < 32 {
            this.invalid = true;
            return "";
        }
        if this.b() == 34 {
            let end = this.pos;
            this.pos = this.pos + 1;
            return JsonStorage.clone_range(this.text, first, end);
        }
        let sb = StringBuilder();
        sb.append_utf8_slice(this.text, first * 2, (this.pos - first) * 2);
        while this.pos < n {
            let c = this.b();
            this.pos = this.pos + 1;
            if c == 34 {
                return sb.build();
            }
            if c < 32 || this.pos == n {
                break;
            }
            let escape = this.b();
            this.pos = this.pos + 1;
            let cp = escape;
            if escape == 110 {
                cp = 10;
            } else if escape == 116 {
                cp = 9;
            } else if escape == 114 {
                cp = 13;
            } else if escape == 98 {
                cp = 8;
            } else if escape == 102 {
                cp = 12;
            } else if escape == 117 {
                cp = this.read_hex4();
                if cp < 0 {
                    break;
                }
            } else if escape != 34 && escape != 92 && escape != 47 {
                break;
            }
            // Appending consecutive escaped UTF-16 units also preserves surrogate pairs.
            sb.append_char((char)cp);
            let run_start = this.pos;
            this.pos = JsonStorage.boundary(this.text, run_start);
            sb.append_utf8_slice(this.text, run_start * 2, (this.pos - run_start) * 2);
        }
        this.invalid = true;
        return "";
    }

    /// Reads a JSON number and advances the cursor.
    public fun parse_number(): JsonValue {
        return JsonValue.from_double(this.parse_double());
    }

    /// Reads a JSON array and advances the cursor.
    public fun parse_array(): JsonValue {
        let result = JsonValue.array();
        this.pos = this.pos + 1;
        let previous = -1;
        while !this.container_end(93, previous) {
            previous = this.pos;
            result.push(this.parse_value());
        }
        return result;
    }

    /// Reads a JSON object and advances the cursor.
    public fun parse_object(): JsonValue {
        let result = JsonValue.dict();
        this.pos = this.pos + 1;
        let previous = -1;
        while !this.container_end(125, previous) {
            previous = this.pos;
            let key = this.read_key();
            if this.invalid {
                break;
            }
            result[key] = this.parse_value();
        }
        return result;
    }

    fun read_key(): string {
        if this.at_end() || this.b() != 34 {
            this.invalid = true;
            return "";
        }
        let key = this.parse_string();
        if !this.try_consume(58) {
            this.invalid = true;
        }
        return key;
    }

    /// Reads the next JSON value and advances the cursor.
    public fun parse_value(): JsonValue {
        if this.invalid || this.at_end() {
            this.invalid = true;
            return JsonValue.null();
        }
        let c = this.b();
        if c == 123 {
            return this.parse_object();
        }
        if c == 91 {
            return this.parse_array();
        }
        if c == 34 {
            return JsonValue.from_string(this.parse_string());
        }
        if c == 116 || c == 102 {
            return JsonValue.from_bool(this.parse_bool());
        }
        if c == 110 {
            this.try_null();
            return JsonValue.null();
        }
        if this.at_number() {
            return this.parse_number();
        }
        this.invalid = true;
        return JsonValue.null();
    }

    /// Consumes the next character if its code equals `code`, returning whether it matched.
    public fun try_consume(code: int): bool {
        this.skip_ws();
        if (this.pos < this.len()) && (this.b() == code) {
            this.pos = this.pos + 1;
            return true;
        }
        return false;
    }

    /// Requires the next character to have code `code`. A missing delimiter fails parsing.
    public fun expect(code: int): bool {
        if this.try_consume(code) {
            return true;
        }
        this.invalid = true;
        return false;
    }

    /// Consumes a JSON null at the cursor, returning whether it matched.
    public fun try_null(): bool {
        this.skip_ws();
        return this.pos < this.len() && this.b() == 110 && this.consume_keyword("null");
    }

    /// Reads a JSON boolean, treating null as false.
    public fun parse_bool(): bool {
        this.skip_ws();
        if this.pos < this.len() {
            if this.b() == 116 {
                return this.consume_keyword("true");
            }
            if this.b() == 102 {
                this.consume_keyword("false");
                return false;
            }
        }
        if !this.try_null() {
            this.invalid = true;
        }
        return false;
    }

    fun at_number(): bool {
        return this.at_digit() || (this.pos < this.len() && this.b() == 45);
    }

    fun at_digit(): bool {
        return this.pos < this.len() && this.b() >= 48 && this.b() <= 57;
    }

    fun scan_digits(): void {
        let first = this.pos;
        while this.at_digit() {
            this.pos = this.pos + 1;
        }
        if this.pos == first {
            this.invalid = true;
        }
    }

    // Returns the end of the integer part for the typed int reader.
    fun scan_number(): int {
        if this.pos < this.len() && this.b() == 45 {
            this.pos = this.pos + 1;
        }
        if this.pos < this.len() && this.b() == 48 {
            this.pos = this.pos + 1;
            if this.at_digit() {
                this.invalid = true;
            }
        } else {
            this.scan_digits();
        }
        let integer_end = this.pos;
        if this.pos < this.len() && this.b() == 46 {
            this.pos = this.pos + 1;
            this.scan_digits();
        }
        if this.pos < this.len() && (this.b() == 101 || this.b() == 69) {
            this.pos = this.pos + 1;
            if this.pos < this.len() && (this.b() == 45 || this.b() == 43) {
                this.pos = this.pos + 1;
            }
            this.scan_digits();
        }
        return integer_end;
    }

    /// Reads the integer part of a JSON number. Out-of-range integers mark parsing as failed.
    public fun parse_int(): int {
        this.skip_ws();
        let first = this.pos;
        let end = this.scan_number();
        if !this.invalid {
            switch (int.parse(this.text.substring(first, end))) {
                Ok(value) => {
                    return value;
                }
                Err(_) => {
                    this.invalid = true;
                }
            }
        }
        return 0;
    }

    /// Reads a JSON number as a double.
    public fun parse_double(): double {
        this.skip_ws();
        let first = this.pos;
        this.scan_number();
        if !this.invalid {
            switch (double.parse(this.text.substring(first, this.pos))) {
                Ok(value) => {
                    return value;
                }
                Err(_) => {
                    this.invalid = true;
                }
            }
        }
        return 0.0d;
    }

    // True when the next object key names the declared field `declared` under `options.naming`.
    public fun match_field(borrow declared: string): bool {
        if this.options.naming == JsonNaming.Identity {
            return this.match_key(declared);
        }
        return this.match_key(Json.field_name(declared, this.options));
    }

    // True when the next object key is `key` (no escapes), compared without ASCII case under
    // `options.ignore_case`. Consumes the key and the following colon.
    public fun match_key(borrow key: string): bool {
        this.skip_ws();
        let start = this.pos;
        let n = this.len();
        if (start >= n) || (this.b_at(start) != 34) {
            return false;
        }
        let first = start + 1;
        let kn = key.length;
        if (kn >= n - first) || (this.b_at(first + kn) != 34) {
            return false;
        }
        if JsonStorage.boundary(this.text, first) != first + kn || !this.key_equals(key, first) {
            return false;
        }
        let end = first + kn + 1;
        while end < n {
            let c = this.b_at(end);
            if (c == 32) || (c == 10) || (c == 9) || (c == 13) {
                end = end + 1;
            } else {
                break;
            }
        }
        if (end >= n) || (this.b_at(end) != 58) {
            return false;
        }
        this.pos = end + 1;
        return true;
    }

    fun key_equals(borrow key: string, start: int): bool {
        if this.options.ignore_case == false {
            return this.text.span(start, start + key.length).equals(key);
        }
        let i = 0;
        while i < key.length {
            let x = this.b_at(start + i);
            let y = ((int)key.char_at(i));
            if (x >= 65) && (x <= 90) {
                x = x + 32;
            }
            if (y >= 65) && (y <= 90) {
                y = y + 32;
            }
            if x != y {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    /// Advances past the next JSON value without retaining it.
    public fun skip_value(): void {
        this.parse_value();
    }

    /// Consumes one object property and discards its value.
    public fun skip_property(): void {
        this.read_key();
        this.skip_value();
    }
}
