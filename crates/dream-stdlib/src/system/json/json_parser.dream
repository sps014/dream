module system.json;

// Byte-cursor recursive-descent JSON parser over the input string's UTF-8 bytes
// (`byte_at` / `byte_size`) — no intermediate `byte[]` copy.
public class JsonParser {
    text: string;
    pos: int;

    public constructor(borrow text: string, pos: int) {
        this.text = text;
        this.pos = pos;
    }

    fun len(): int {
        return this.text.byte_size();
    }

    fun b(): int {
        return this.text.byte_at(this.pos);
    }

    fun b_at(i: int): int {
        return this.text.byte_at(i);
    }

    public fun skip_ws(): void {
        let going = true;
        while (going == true) {
            if (this.pos >= this.len()) {
                going = false;
            } else {
                let c = this.b();
                if ((c == 32) || (c == 10) || (c == 9) || (c == 13)) {
                    this.pos = this.pos + 1;
                } else {
                    going = false;
                }
            }
        }
    }

    public fun at_end(): bool {
        this.skip_ws();
        return this.pos >= this.len();
    }

    public fun keyword(length: int, value: JsonValue): JsonValue {
        this.pos = this.pos + length;
        return value;
    }

    fun hex_nibble(c: int): int {
        if ((c >= 48) && (c <= 57)) {
            return c - 48;
        }
        if ((c >= 97) && (c <= 102)) {
            return c - 97 + 10;
        }
        if ((c >= 65) && (c <= 70)) {
            return c - 65 + 10;
        }
        return 0 - 1;
    }

    fun read_hex4(): int {
        let cp = 0;
        let k = 0;
        while (k < 4) {
            if (this.pos >= this.len()) {
                return 0 - 1;
            }
            let h = this.hex_nibble(this.b());
            if (h < 0) {
                return 0 - 1;
            }
            cp = cp * 16 + h;
            this.pos = this.pos + 1;
            k = k + 1;
        }
        return cp;
    }

    // 10^exp for small non-negative exponents (JSON numbers).
    fun pow10(exp: int): double {
        let r = 1.0d;
        let i = 0;
        while (i < exp) {
            r = r * 10.0d;
            i = i + 1;
        }
        return r;
    }

    public fun parse_string(): string {
        this.pos = this.pos + 1; // opening quote
        let sb = StringBuilder();
        let going = true;
        while (going == true) {
            if (this.pos >= this.len()) {
                going = false;
            } else {
                let c = this.b();
                if (c == 34) {
                    this.pos = this.pos + 1;
                    going = false;
                } else if (c == 92) {
                    this.pos = this.pos + 1;
                    if (this.pos >= this.len()) {
                        going = false;
                    } else {
                        let e = this.b();
                        let cp = 0;
                        if (e == 110) {
                            cp = 10;
                            this.pos = this.pos + 1;
                        } else if (e == 116) {
                            cp = 9;
                            this.pos = this.pos + 1;
                        } else if (e == 114) {
                            cp = 13;
                            this.pos = this.pos + 1;
                        } else if (e == 34) {
                            cp = 34;
                            this.pos = this.pos + 1;
                        } else if (e == 92) {
                            cp = 92;
                            this.pos = this.pos + 1;
                        } else if (e == 47) {
                            cp = 47;
                            this.pos = this.pos + 1;
                        } else if (e == 98) {
                            cp = 8;
                            this.pos = this.pos + 1;
                        } else if (e == 102) {
                            cp = 12;
                            this.pos = this.pos + 1;
                        } else if (e == 117) {
                            this.pos = this.pos + 1;
                            cp = this.read_hex4();
                            if (cp < 0) {
                                cp = 65533;
                            } else if ((cp >= 55296) && (cp <= 56319)) {
                                if (((this.pos + 5) < this.len()) && (this.b() == 92) && (this.b_at(this.pos + 1) == 117)) {
                                    let save = this.pos;
                                    this.pos = this.pos + 2;
                                    let lo = this.read_hex4();
                                    if ((lo >= 56320) && (lo <= 57343)) {
                                        cp = 65536 + ((cp - 55296) * 1024) + (lo - 56320);
                                    } else {
                                        this.pos = save;
                                    }
                                }
                            }
                        } else {
                            cp = e;
                            this.pos = this.pos + 1;
                        }
                        sb.append_char((char)cp);
                    }
                } else {
                    // Bulk-copy unescaped UTF-8 until `"` or `\`.
                    let run_start = this.pos;
                    let scanning = true;
                    while (scanning == true) {
                        if (this.pos >= this.len()) {
                            scanning = false;
                        } else {
                            let b = this.b();
                            if ((b == 34) || (b == 92)) {
                                scanning = false;
                            } else {
                                this.pos = this.pos + 1;
                            }
                        }
                    }
                    sb.append_utf8_slice(this.text, run_start, this.pos - run_start);
                }
            }
        }
        return sb.build();
    }

    public fun parse_number(): JsonValue {
        let sign = 1.0d;
        if ((this.pos < this.len()) && (this.b() == 45)) {
            sign = 0.0d - 1.0d;
            this.pos = this.pos + 1;
        } else if ((this.pos < this.len()) && (this.b() == 43)) {
            this.pos = this.pos + 1;
        }

        let value = 0.0d;
        while (this.pos < this.len()) {
            let c = this.b();
            if ((c >= 48) && (c <= 57)) {
                value = value * 10.0d + (double)(c - 48);
                this.pos = this.pos + 1;
            } else {
                break;
            }
        }

        if ((this.pos < this.len()) && (this.b() == 46)) {
            this.pos = this.pos + 1;
            let frac = 0.0d;
            let frac_digits = 0;
            while (this.pos < this.len()) {
                let c = this.b();
                if ((c >= 48) && (c <= 57)) {
                    frac = frac * 10.0d + (double)(c - 48);
                    frac_digits = frac_digits + 1;
                    this.pos = this.pos + 1;
                } else {
                    break;
                }
            }
            if (frac_digits > 0) {
                value = value + frac / this.pow10(frac_digits);
            }
        }

        if (this.pos < this.len()) {
            let ec = this.b();
            if ((ec == 101) || (ec == 69)) {
                this.pos = this.pos + 1;
                let esign = 1;
                if (this.pos < this.len()) {
                    let s = this.b();
                    if (s == 45) {
                        esign = 0 - 1;
                        this.pos = this.pos + 1;
                    } else if (s == 43) {
                        this.pos = this.pos + 1;
                    }
                }
                let exp = 0;
                while (this.pos < this.len()) {
                    let c = this.b();
                    if ((c >= 48) && (c <= 57)) {
                        exp = exp * 10 + (c - 48);
                        this.pos = this.pos + 1;
                    } else {
                        break;
                    }
                }
                if (esign > 0) {
                    value = value * this.pow10(exp);
                } else {
                    value = value / this.pow10(exp);
                }
            }
        }

        return JsonValue.number(sign * value);
    }

    public fun parse_array(): JsonValue {
        let result = JsonValue.array();
        this.pos = this.pos + 1; // '['
        this.skip_ws();
        if (this.pos < this.len()) {
            if (this.b() == 93) {
                this.pos = this.pos + 1;
                return result;
            }
        }
        let going = true;
        while (going == true) {
            let element = this.parse_value();
            result.push(element);
            this.skip_ws();
            if (this.pos >= this.len()) {
                going = false;
            } else {
                if (this.b() == 44) {
                    this.pos = this.pos + 1;
                } else {
                    this.pos = this.pos + 1; // ']'
                    going = false;
                }
            }
        }
        return result;
    }

    public fun parse_object(): JsonValue {
        let result = JsonValue.dict();
        this.pos = this.pos + 1; // '{'
        this.skip_ws();
        if (this.pos < this.len()) {
            if (this.b() == 125) {
                this.pos = this.pos + 1;
                return result;
            }
        }
        let going = true;
        while (going == true) {
            this.skip_ws();
            let key = this.parse_string();
            this.skip_ws();
            if (this.pos < this.len()) {
                if (this.b() == 58) {
                    this.pos = this.pos + 1;
                }
            }
            let value = this.parse_value();
            result.set(key, value);
            this.skip_ws();
            if (this.pos >= this.len()) {
                going = false;
            } else {
                if (this.b() == 44) {
                    this.pos = this.pos + 1;
                } else {
                    this.pos = this.pos + 1; // '}'
                    going = false;
                }
            }
        }
        return result;
    }

    public fun parse_value(): JsonValue {
        this.skip_ws();
        if (this.pos >= this.len()) {
            return JsonValue.none();
        }
        let c = this.b();
        if (c == 123) {
            return this.parse_object();
        }
        if (c == 91) {
            return this.parse_array();
        }
        if (c == 34) {
            return JsonValue.from_string(this.parse_string());
        }
        if (c == 116) {
            return this.keyword(4, JsonValue.boolean(true));
        }
        if (c == 102) {
            return this.keyword(5, JsonValue.boolean(false));
        }
        if (c == 110) {
            return this.keyword(4, JsonValue.none());
        }
        return this.parse_number();
    }

    public fun try_consume(code: int): bool {
        this.skip_ws();
        if ((this.pos < this.len()) && (this.b() == code)) {
            this.pos = this.pos + 1;
            return true;
        }
        return false;
    }

    public fun try_null(): bool {
        this.skip_ws();
        if ((this.pos < this.len()) && (this.b() == 110)) {
            this.pos = this.pos + 4;
            return true;
        }
        return false;
    }

    public fun parse_bool(): bool {
        this.skip_ws();
        if (this.pos >= this.len()) {
            return false;
        }
        let c = this.b();
        if (c == 116) {
            this.pos = this.pos + 4;
            return true;
        }
        if (c == 102) {
            this.pos = this.pos + 5;
            return false;
        }
        if (c == 110) {
            this.pos = this.pos + 4;
            return false;
        }
        return false;
    }

    public fun parse_int(): int {
        this.skip_ws();
        return this.parse_number().as_int().unwrap_or(0);
    }

    public fun parse_double(): double {
        this.skip_ws();
        return this.parse_number().as_double().unwrap_or(0.0d);
    }

    public fun skip_value(): void {
        this.skip_ws();
        if (this.pos >= this.len()) {
            return;
        }
        let c = this.b();
        if (c == 123) {
            this.pos = this.pos + 1;
            this.skip_ws();
            if ((this.pos < this.len()) && (this.b() == 125)) {
                this.pos = this.pos + 1;
                return;
            }
            let going = true;
            while (going) {
                this.skip_ws();
                if (this.pos >= this.len()) {
                    going = false;
                } else if (this.b() == 125) {
                    this.pos = this.pos + 1;
                    going = false;
                } else {
                    this.parse_string();
                    this.skip_ws();
                    if ((this.pos < this.len()) && (this.b() == 58)) {
                        this.pos = this.pos + 1;
                    }
                    this.skip_value();
                    this.skip_ws();
                    if ((this.pos < this.len()) && (this.b() == 44)) {
                        this.pos = this.pos + 1;
                    }
                }
            }
            return;
        }
        if (c == 91) {
            this.pos = this.pos + 1;
            this.skip_ws();
            if ((this.pos < this.len()) && (this.b() == 93)) {
                this.pos = this.pos + 1;
                return;
            }
            let going = true;
            while (going) {
                this.skip_ws();
                if (this.pos >= this.len()) {
                    going = false;
                } else if (this.b() == 93) {
                    this.pos = this.pos + 1;
                    going = false;
                } else {
                    this.skip_value();
                    this.skip_ws();
                    if ((this.pos < this.len()) && (this.b() == 44)) {
                        this.pos = this.pos + 1;
                    }
                }
            }
            return;
        }
        if (c == 34) {
            this.parse_string();
            return;
        }
        if (c == 116) {
            this.pos = this.pos + 4;
            return;
        }
        if (c == 102) {
            this.pos = this.pos + 5;
            return;
        }
        if (c == 110) {
            this.pos = this.pos + 4;
            return;
        }
        this.parse_number();
    }
}
