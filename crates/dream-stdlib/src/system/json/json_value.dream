module system.json;

// Native JSON value tree. `items` / `obj_map` can hold nested `JsonValue`s; trees are
// acyclic at runtime, so `@allow_cycle` opts out of the structural self-edge check.
//
// Container fields are `Option` so scalars allocate no List/Map. Arrays own `items` only;
// objects own `obj_keys` + `obj_vals` (insertion order) + `obj_map` (O(1) lookup).
@allow_cycle
public class JsonValue {
    internal kind: int;
    internal bool_val: bool;
    internal num_val: double;
    internal str_val: string;
    internal items: Option<List<JsonValue>>;
    // Insertion-ordered keys for objects (stringify order).
    internal obj_keys: Option<List<string>>;
    // Values parallel to `obj_keys` (avoids map re-hash during stringify).
    obj_vals: Option<List<JsonValue>>;
    // O(1) object field lookup.
    obj_map: Option<Map<string, JsonValue>>;

    internal constructor(
        kind: int,
        bool_val: bool,
        num_val: double,
        str_val: string,
        items: Option<List<JsonValue>>,
        obj_keys: Option<List<string>>,
        obj_vals: Option<List<JsonValue>>,
        obj_map: Option<Map<string, JsonValue>>
    ) {
        this.kind = kind;
        this.bool_val = bool_val;
        this.num_val = num_val;
        this.str_val = str_val;
        this.items = items;
        this.obj_keys = obj_keys;
        this.obj_vals = obj_vals;
        this.obj_map = obj_map;
    }

    // Scalar / null: no List or Map allocation.
    static fun _scalar(k: int, bool_val: bool, num_val: double, str_val: string): JsonValue {
        let none_items: Option<List<JsonValue>> = Option.None;
        let none_keys: Option<List<string>> = Option.None;
        let none_vals: Option<List<JsonValue>> = Option.None;
        let none_map: Option<Map<string, JsonValue>> = Option.None;
        return JsonValue(k, bool_val, num_val, str_val, none_items, none_keys, none_vals, none_map);
    }

    // A new null JSON value.
    public static fun none(): JsonValue {
        return JsonValue._scalar(0, false, 0.0d, "");
    }

    // A new boolean JSON value.
    public static fun boolean(b: bool): JsonValue {
        return JsonValue._scalar(1, b, 0.0d, "");
    }

    // A new number JSON value.
    public static fun number(n: double): JsonValue {
        return JsonValue._scalar(2, false, n, "");
    }

    // A new number JSON value from int.
    public static fun from_int(n: int): JsonValue {
        return JsonValue.number((double)n);
    }

    // A new string JSON value.
    public static fun from_string(s: string): JsonValue {
        return JsonValue._scalar(3, false, 0.0d, s);
    }

    // A new empty JSON array (allocates only the items list).
    public static fun array(): JsonValue {
        let none_keys: Option<List<string>> = Option.None;
        let none_vals: Option<List<JsonValue>> = Option.None;
        let none_map: Option<Map<string, JsonValue>> = Option.None;
        return JsonValue(4, false, 0.0d, "", Option.Some(List<JsonValue>()), none_keys, none_vals, none_map);
    }

    // A new empty JSON object (allocates keys, parallel values, and map).
    public static fun dict(): JsonValue {
        let none_items: Option<List<JsonValue>> = Option.None;
        return JsonValue(
            5,
            false,
            0.0d,
            "",
            none_items,
            Option.Some(List<string>()),
            Option.Some(List<JsonValue>()),
            Option.Some(Map<string, JsonValue>())
        );
    }

    // The kind of JSON value.
    public fun kind_of(): int {
        return this.kind;
    }

    // True if the value is null.
    public fun is_null(): bool {
        return this.kind == 0;
    }

    // True if the value is an array.
    public fun is_array(): bool {
        return this.kind == 4;
    }

    // True if the value is an object.
    public fun is_object(): bool {
        return this.kind == 5;
    }

    // Returns the value as a bool when this is a JSON boolean.
    public fun as_bool(): Option<bool> {
        if this.kind != 1 {
            return Option.None;
        }
        return Option.Some(this.bool_val);
    }

    // Returns the value as a double when this is a JSON number.
    public fun as_double(): Option<double> {
        if this.kind != 2 {
            return Option.None;
        }
        return Option.Some(this.num_val);
    }

    // Returns the value as an integer when this is a JSON number.
    public fun as_int(): Option<int> {
        if this.kind != 2 {
            return Option.None;
        }
        return Option.Some((int)this.num_val);
    }

    // Returns the value as a string when this is a JSON string.
    public fun as_string(): Option<string> {
        if this.kind != 3 {
            return Option.None;
        }
        return Option.Some(string.clone(this.str_val));
    }

    public fun as_array(): Option<List<JsonValue>> {
        if this.kind != 4 {
            return Option.None;
        }
        return this.items;
    }

    public fun as_map(): Option<Map<string, JsonValue>> {
        if this.kind != 5 {
            return Option.None;
        }
        return this.obj_map;
    }

    public fun get_or(borrow key: string, fallback: JsonValue): JsonValue {
        return this.get(key).unwrap_or(fallback);
    }

    public fun remove(borrow key: string): bool {
        let mopt = this.obj_map;
        if mopt.is_none() {
            return false;
        }
        let m = mopt.unwrap_or(Map<string, JsonValue>());
        if m.contains(key) == false {
            return false;
        }
        m.remove(key);
        let keys_opt = this.obj_keys;
        let vals_opt = this.obj_vals;
        if keys_opt.is_some() && vals_opt.is_some() {
            let keys = keys_opt.unwrap_or(List<string>());
            let vals = vals_opt.unwrap_or(List<JsonValue>());
            let idx = keys.index_of(key);
            if idx.is_some() {
                let i = idx.unwrap_or(0);
                keys.remove_at(i);
                vals.remove_at(i);
            }
        }
        return true;
    }

    // True if the object has the given key.
    public fun has(borrow key: string): bool {
        return switch (this.obj_map) {
            Some(m) => m.contains(key),
            None => false,
        };
    }

    // The value for `key`, or `None` when this is not an object or the key is absent.
    public fun this[borrow key: string]: Option<JsonValue> {
        return switch (this.obj_map) {
            Some(m) => m.get(key),
            None => Option.None,
        };
    }

    public fun get(borrow key: string): Option<JsonValue> {
        return this[key];
    }

    // The value for `key`. Panics when this is not an object or the key is absent — use
    // `get(key)` for absence-tolerant reads.
    public fun at(borrow key: string): JsonValue {
        let at = this.get(key);
        if at.is_none() {
            System.panic("JsonValue key not found: " + key);
        }
        return at.unwrap_or(JsonValue.none());
    }

    // Sets the value for `key` (objects only).
    public fun this[key: string] = value: JsonValue {
        switch (this.obj_map) {
            Some(m) => {
                switch (this.obj_keys) {
                    Some(keys) => {
                        switch (this.obj_vals) {
                            Some(vals) => {
                                if m.contains(key) == false {
                                    keys.push(key);
                                    vals.push(value);
                                } else {
                                    switch (keys.index_of(key)) {
                                        Some(idx) => {
                                            vals.set(idx, value);
                                        },
                                        None => { },
                                    }
                                }
                                m.set(key, value);
                            },
                            None => { },
                        }
                    },
                    None => { },
                }
            },
            None => { },
        }
    }

    public fun set(key: string, value: JsonValue): void {
        this[key] = value;
    }

    // The object key at `index`, or `None`.
    public fun key_at(index: int): Option<string> {
        switch (this.obj_keys) {
            Some(keys) => {
                if index < 0 || index >= keys.length {
                    return Option.None;
                }
                return Option.Some(keys.get(index));
            },
            None => {
                return Option.None;
            },
        }
    }

    // The object value at insertion index `index`, or `None`.
    public fun value_at(index: int): Option<JsonValue> {
        switch (this.obj_vals) {
            Some(vals) => {
                if index < 0 || index >= vals.length {
                    return Option.None;
                }
                return Option.Some(vals.get(index));
            },
            None => {
                return Option.None;
            },
        }
    }

    // The keys of the object (empty list when not an object).
    public fun keys(): List<string> {
        return this.obj_keys.unwrap_or(List<string>());
    }

    // The array element at `index`, or `None`.
    public fun at(index: int): Option<JsonValue> {
        switch (this.items) {
            Some(items) => {
                if index < 0 || index >= items.length {
                    return Option.None;
                }
                return Option.Some(items.get(index));
            },
            None => {
                return Option.None;
            },
        }
    }

    // Appends a value to the array.
    public fun push(value: JsonValue): void {
        switch (this.items) {
            Some(items) => {
                items.push(value);
            },
            None => { },
        }
    }

    // Element count for arrays/objects (0 for scalars).
    public get length(): int {
        if this.kind == 5 {
            return switch (this.obj_keys) {
                Some(keys) => keys.length,
                None => 0,
            };
        }
        return switch (this.items) {
            Some(items) => items.length,
            None => 0,
        };
    }
}
