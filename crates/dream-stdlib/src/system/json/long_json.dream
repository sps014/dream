module system.json;

// JSON encoding of `long` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend long {
    /// Appends this value as JSON as a JSON number.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        Json.write_number(sb, (double)this);
    }

    /// Reads a `long` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): long {
        return (long)v.as_double().unwrap_or(0.0d);
    }

    /// Parses JSON text holding a single `long`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<long, ParseError> {
        return Json.read_parsed<long>(text, options);
    }
}
