module system.json;

// JSON encoding of `short` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend short {
    /// Appends this value as JSON as a JSON number.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append(this.to_string());
    }

    /// Reads a `short` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): short {
        return (short)v.as_int().unwrap_or(0);
    }

    /// Parses JSON text holding a single `short`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<short, ParseError> {
        return Json.read_parsed<short>(text, options);
    }
}
