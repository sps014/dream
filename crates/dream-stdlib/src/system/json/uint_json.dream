module system.json;

// JSON encoding of `uint` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend uint {
    /// Appends this value as JSON as a JSON number.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append(this.to_string());
    }

    /// Reads a `uint` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): uint {
        return (uint)v.as_double().unwrap_or(0.0d);
    }

    /// Parses JSON text holding a single `uint`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<uint, ParseError> {
        return Json.read_parsed<uint>(text, options);
    }
}
