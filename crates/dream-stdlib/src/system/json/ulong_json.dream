module system.json;

// JSON encoding of `ulong` for `Json.serialize`, `Json.deserialize`, `Json.from_value` and the
// collection encoders.
extend ulong {
    /// Appends this value as JSON as a JSON number.
    internal fun write_json(borrow sb: StringBuilder, borrow options: JsonOptions): void {
        sb.append(this.to_string());
    }

    /// Reads a `ulong` from a parsed JSON value; a value of another kind reads as zero.
    internal static fun from_json(borrow v: JsonValue, borrow options: JsonOptions): ulong {
        return (ulong)v.as_double().unwrap_or(0.0d);
    }

    /// Parses JSON text holding a single `ulong`.
    internal static fun read_json(
        borrow text: string,
        borrow options: JsonOptions
    ): Result<ulong, ParseError> {
        return Json.read_parsed<ulong>(text, options);
    }
}
