module system.net;

/// Owns reusable HTTP connection pools. Close explicitly to cancel pending sends and release pools.
/// Received responses own their bodies independently and must also be closed.
public class HttpClient {
    id: int;
    cookie_values: Option<CookieJar>;
    use_cookies: bool;

    /// Creates a client with automatic cookies on native hosts by default; pass false to disable them.
    /// `cookies` seeds or shares a jar. Without a supplied jar, Node/browser/WASI clients remain stateless.
    /// Supplying a jar on an unsupported host makes send return ENOTSUP. Allocation failures surface from send.
    public constructor(use_cookies: bool = true, cookies: Option<CookieJar> = Option.None) {
        this.use_cookies = use_cookies;
        this.cookie_values = cookies;
        if use_cookies && HttpCapabilities.cookie_jars && this.cookie_values.is_none() {
            this.cookie_values = Option.Some(CookieJar());
        }
        let jar_id = 0 - 1;
        if use_cookies && this.cookie_values.is_some() {
            jar_id = this.cookie_values.unwrap().id;
        }
        this.id = HttpClient.create_host(jar_id);
    }

    /// The client jar, or None when automatic cookies are disabled or unavailable and no jar was supplied.
    /// A supplied jar remains accessible when use_cookies is false, but is not used for requests or responses.
    public get cookies(): Option<CookieJar> {
        return this.cookie_values;
    }

    del() {
        HttpClient.close_host(this.id);
    }

    @runtime("netClientCreate")
    static extern fun create_host(cookie_jar: int): int;

    @runtime("netClientClose")
    static extern fun close_host(id: int): void;

    @runtime("netHttpStart")
    static extern fun send_host(id: int, borrow request: string, borrow bytes: byte[]): int;

    /// Sends with default options: a 30-second total deadline and the host redirect policy.
    public async fun send(
        request: HttpRequest,
        token: Option<CancellationToken> = Option.None
    ): Result<HttpResponse, HttpError> {
        let effective_token = CancellationToken.resolve(token);
        let lifetime = [this];
        return lifetime[0].send(request, HttpOptions(), effective_token).await;
    }

    /// Sends a snapshot and returns after response headers arrive. Statuses such as 404 remain `Ok`.
    /// Cancellation aborts pending transport work; response ownership transfers to the caller on success.
    public async fun send(
        request: HttpRequest,
        options: HttpOptions,
        token: Option<CancellationToken> = Option.None
    ): Result<HttpResponse, HttpError> {
        let effective_token = CancellationToken.resolve(token);
        let lifetime = [this];
        if CancellationToken.is_cancelled_opt(effective_token) {
            return Result.Err(HttpError("ECANCELLED", "HTTP operation cancelled"));
        }
        if lifetime[0].id <= 0 {
            return Result.Err(HttpError("ECLOSED", "HTTP client is closed or unavailable"));
        }
        if lifetime[0].use_cookies && lifetime[0].cookie_values.is_some() {
            if !HttpCapabilities.cookie_jars {
                return Result.Err(
                    HttpError("ENOTSUP", "managed cookie jars are unavailable on this host")
                );
            }
            if lifetime[0].cookie_values.unwrap().id <= 0 {
                return Result.Err(HttpError("ELIMIT", "cookie jar is unavailable"));
            }
        }
        if options.timeout_ms < 0
            || options.connect_timeout_ms < 0 || options.max_redirects < (0 - 1) {
            return Result.Err(HttpError("EINVAL", "invalid HTTP options"));
        }
        if !request.url.http_target() {
            return Result.Err(
                HttpError("EINVAL", "HTTP URL must use http/https without credentials")
            );
        }
        let operation = HttpOperation(
            HttpClient.send_host(lifetime[0].id, request.wire(options), request.body)
        );
        let completed = operation.wait(effective_token).await;
        if completed.is_err() {
            operation.close();
            return Result.Err(completed.unwrap_err());
        }
        let bytes = completed.unwrap();
        let json = Json.deserialize<JsonValue>(Encoding.utf8_decode(bytes));
        if json.is_err() {
            operation.close();
            return Result.Err(HttpError("EIO", "invalid HTTP response metadata"));
        }
        let metadata = json.unwrap();
        let response = HttpResponse.from_wire(metadata);
        if response.is_err() {
            operation.close();
            return response;
        }
        operation.claim();
        operation.close();
        return response;
    }

    /// Closes idempotently, cancelling pending sends. Previously received bodies remain usable.
    public fun close(): Result<Unit, HttpError> {
        if this.id > 0 {
            HttpClient.close_host(this.id);
            this.id = 0;
        }
        return Result.Ok(Unit());
    }
}
