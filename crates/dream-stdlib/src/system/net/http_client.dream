module system.net;

// A cross-runtime HTTP client returning `Result<HttpResponse, HttpError>`.
public class HttpClient {
    base_url: string;
    default_headers: HttpHeaders;
    // Request timeout in milliseconds; `0` means no timeout.
    _timeout_ms: int;
    // Native HTTP version: `1` = HTTP/1.1 (default), `2` = HTTP/2. Ignored on JS hosts.
    _http_version: int;
    cookie_jar: Option<CookieJar>;
    cancel_token: Option<CancellationToken>;

    // Deferred on native (`@async_host`): the host performs the request on a worker thread and
    // completes the future there, so awaiting it no longer stalls the whole run loop.
    @async_host
    @runtime("httpRequest")
    static extern async fun http_request(borrow url: string, borrow method: string, borrow headers: string, borrow body: string, timeout_ms: int, http_version: int): char[];

    @async_host
    @runtime("httpRequestBytes")
    static extern async fun http_request_bytes(borrow url: string, borrow method: string, borrow headers: string, borrow body: byte[], timeout_ms: int, http_version: int): char[];

    @runtime("httpRequestStream")
    static extern async fun http_request_stream(borrow url: string, borrow method: string, borrow headers: string, borrow body: string, timeout_ms: int, http_version: int): char[];

    @runtime("httpRequestStreamBytes")
    static extern async fun http_request_stream_bytes(borrow url: string, borrow method: string, borrow headers: string, borrow body: byte[], timeout_ms: int, http_version: int): char[];

    // Creates an HTTP client. `base_url` defaults to empty so absolute URLs work with `HttpClient()`.
    public constructor(base_url: string = "") {
        this.base_url = base_url;
        this.default_headers = HttpHeaders();
        this._timeout_ms = 0;
        this._http_version = 1;
        this.cookie_jar = Option.None;
        this.cancel_token = Option.None;
    }

    // Request timeout in milliseconds (`0` = none).
    public get timeout_ms(): int {
        return this._timeout_ms;
    }

    // Sets the request timeout in milliseconds (`0` = none).
    public set timeout_ms(ms: int) {
        this._timeout_ms = ms;
    }

    // Sets the request timeout in milliseconds (`0` = none).
    public fun with_timeout(ms: int): HttpClient {
        this._timeout_ms = ms;
        return this;
    }

    // Preferred HTTP version on the native host (`1` = HTTP/1.1, `2` = HTTP/2).
    public get http_version(): int {
        return this._http_version;
    }

    // Sets the preferred HTTP version on the native host (`1` = HTTP/1.1, `2` = HTTP/2).
    public set http_version(version: int) {
        this._http_version = version;
    }

    // Sets the preferred HTTP version on the native host (`1` = HTTP/1.1, `2` = HTTP/2).
    public fun with_http_version(version: int): HttpClient {
        this._http_version = version;
        return this;
    }

    // Attaches a cookie jar used for outbound `Cookie` and inbound `Set-Cookie`.
    public fun with_cookie_jar(jar: CookieJar): HttpClient {
        this.cookie_jar = Option.Some(jar);
        return this;
    }

    // Attaches a cooperative cancellation token checked before each request.
    public fun with_cancellation(token: CancellationToken): HttpClient {
        this.cancel_token = Option.Some(token);
        return this;
    }

    // Adds a default header sent with every request.
    public fun set_header(name: string, value: string): HttpClient {
        this.default_headers.set(name, value);
        return this;
    }

    fun resolve(path: string): string {
        if this.base_url.is_empty() == true {
            return path;
        }
        if path.starts_with("http") == true {
            return path;
        }
        return this.base_url + path;
    }

    fun merge_headers(borrow call: HttpHeaders): string {
        let merged = HttpHeaders();
        merged.add_all(this.default_headers);
        merged.add_all(call);
        switch (this.cookie_jar) {
            Some(jar) => {
                let cookie = jar.to_header();
                if cookie.is_empty() == false {
                    merged.set("Cookie", cookie);
                }
            },
            None => { },
        }
        return merged.to_wire();
    }

    fun wrap_stream(raw: char[], token: Option<CancellationToken>): Result<HttpStreamResponse, HttpError> {
        let head = HttpResponse(raw);
        if head.status == 0 {
            return Result.Err(HttpError.transport(head.text()));
        }
        switch (this.cookie_jar) {
            Some(jar) => { jar.store_from_response(head); },
            None => { },
        }
        let handle = int.parse(head.text()).unwrap_or(0 - 1);
        if handle < 0 {
            return Result.Err(HttpError.transport("invalid stream handle"));
        }
        return Result.Ok(HttpStreamResponse(head, handle, token));
    }

    fun effective_token(call: Option<CancellationToken>): Option<CancellationToken> {
        if call.is_some() {
            return call;
        }
        return this.cancel_token;
    }

    fun check_cancel(call: Option<CancellationToken>): Result<bool, HttpError> {
        return CancellationToken.rejected(this.effective_token(call), HttpError.cancelled());
    }

    fun wrap(raw: char[]): Result<HttpResponse, HttpError> {
        let res = HttpResponse(raw);
        if res.status == 0 {
            return Result.Err(HttpError.transport(res.text()));
        }
        switch (this.cookie_jar) {
            Some(jar) => { jar.store_from_response(res); },
            None => { },
        }
        return Result.Ok(res);
    }

    // Performs a request with a text body.
    public async fun request(method: string, path: string, body: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        this.check_cancel(token)?;
        let raw = await HttpClient.http_request(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms, this.http_version);
        return this.wrap(raw);
    }

    // Performs a GET request.
    public async fun get(path: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("GET", path, "", HttpHeaders(), token);
    }

    public async fun get_with(path: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("GET", path, "", headers, token);
    }

    public async fun get_json(path: string, token: Option<CancellationToken> = Option.None): Result<JsonValue, HttpError> {
        let res = await this.get(path, token);
        if res.is_err() {
            return Result.Err(res.unwrap_err());
        }
        let body = res.unwrap_or(HttpResponse(Buffer.alloc<char>(0))).json();
        if body.is_err() {
            return Result.Err(HttpError.transport(body.unwrap_err().message()));
        }
        return Result.Ok(body.unwrap_or(JsonValue.none()));
    }

    public async fun post_json(path: string, body: JsonValue, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        let headers = HttpHeaders();
        headers.set("Content-Type", "application/json");
        return await this.request("POST", path, Json.stringify(body), headers, token);
    }

    // Encodes a `Map` as an `application/x-www-form-urlencoded` body
    // (keys and values percent-encoded, pairs joined with `&`).
    fun encode_form(form: Map<string, string>): string {
        let sb = StringBuilder();
        let first = true;
        for (let pair in form) {
            if first == false {
                sb.append_char('&');
            }
            first = false;
            sb.append(Encoding.url_encode(pair.key));
            sb.append_char('=');
            sb.append(Encoding.url_encode(pair.value));
        }
        return sb.build();
    }

    // POSTs `form` percent-encoded with `Content-Type: application/x-www-form-urlencoded`.
    public async fun post_form(path: string, form: Map<string, string>, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        let headers = HttpHeaders();
        headers.set("Content-Type", "application/x-www-form-urlencoded");
        return await this.request("POST", path, this.encode_form(form), headers, token);
    }

    // Performs a POST request.
    public async fun post(path: string, body: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("POST", path, body, HttpHeaders(), token);
    }

    public async fun post_with(path: string, body: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("POST", path, body, headers, token);
    }

    // Performs a PUT request.
    public async fun put(path: string, body: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("PUT", path, body, HttpHeaders(), token);
    }

    public async fun put_with(path: string, body: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("PUT", path, body, headers, token);
    }

    // PUTs a JSON body with `Content-Type: application/json`.
    public async fun put_json(path: string, body: JsonValue, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        let headers = HttpHeaders();
        headers.set("Content-Type", "application/json");
        return await this.request("PUT", path, Json.stringify(body), headers, token);
    }

    // Performs a PATCH request.
    public async fun patch(path: string, body: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("PATCH", path, body, HttpHeaders(), token);
    }

    public async fun patch_with(path: string, body: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("PATCH", path, body, headers, token);
    }

    // PATCHes with a JSON body and `Content-Type: application/json`.
    public async fun patch_json(path: string, body: JsonValue, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        let headers = HttpHeaders();
        headers.set("Content-Type", "application/json");
        return await this.request("PATCH", path, Json.stringify(body), headers, token);
    }

    // Performs a DELETE request.
    public async fun delete(path: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("DELETE", path, "", HttpHeaders(), token);
    }

    public async fun delete_with(path: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("DELETE", path, "", headers, token);
    }

    // Performs a HEAD request.
    public async fun head(path: string, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request("HEAD", path, "", HttpHeaders(), token);
    }

    // Performs a request with a text body, streaming the response instead of buffering it.
    public async fun request_stream(method: string, path: string, body: string, headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpStreamResponse, HttpError> {
        this.check_cancel(token)?;
        let tok = this.effective_token(token);
        let raw = await HttpClient.http_request_stream(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms, this.http_version);
        return this.wrap_stream(raw, tok);
    }

    // Performs a GET request, streaming the response instead of buffering it.
    public async fun get_stream(path: string, token: Option<CancellationToken> = Option.None): Result<HttpStreamResponse, HttpError> {
        return await this.request_stream("GET", path, "", HttpHeaders(), token);
    }

    // Performs a request with a binary body, streaming the response instead of buffering it.
    public async fun request_stream_bytes(method: string, path: string, body: byte[], headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpStreamResponse, HttpError> {
        this.check_cancel(token)?;
        let tok = this.effective_token(token);
        let raw = await HttpClient.http_request_stream_bytes(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms, this.http_version);
        return this.wrap_stream(raw, tok);
    }

    // Performs a GET request and resolves with its body as text.
    public async fun text(path: string, token: Option<CancellationToken> = Option.None): Result<string, HttpError> {
        return switch (await this.get(path, token)) {
            Ok(res) => Result.Ok(res.text()),
            Err(e) => Result.Err(e),
        };
    }

    // Performs a GET request and resolves with its body as bytes.
    public async fun get_bytes(path: string, token: Option<CancellationToken> = Option.None): Result<byte[], HttpError> {
        return switch (await this.get(path, token)) {
            Ok(res) => Result.Ok(res.bytes()),
            Err(e) => Result.Err(e),
        };
    }

    // Performs a request with a binary body.
    public async fun request_bytes(method: string, path: string, body: byte[], headers: HttpHeaders, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        this.check_cancel(token)?;
        let raw = await HttpClient.http_request_bytes(this.resolve(path), method, this.merge_headers(headers), body, this.timeout_ms, this.http_version);
        return this.wrap(raw);
    }

    // Performs a POST request with a binary body.
    public async fun post_bytes(path: string, body: byte[], token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request_bytes("POST", path, body, HttpHeaders(), token);
    }

    // Performs a PUT request with a binary body.
    public async fun put_bytes(path: string, body: byte[], token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        return await this.request_bytes("PUT", path, body, HttpHeaders(), token);
    }

    // POSTs a multipart form via `request_bytes`.
    public async fun post_multipart(path: string, form: MultipartForm, token: Option<CancellationToken> = Option.None): Result<HttpResponse, HttpError> {
        let built = form.build();
        return await this.request_bytes("POST", path, built.body, built.headers, token);
    }
}
