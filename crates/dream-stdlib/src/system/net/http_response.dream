module system.net;

// A parsed view over HTTP response bytes.
public class HttpResponse {
    data: char[];
    boundary: int;
    scanned: bool;
    _headers: HttpHeaders;

    internal constructor(data: char[]) {
        this.data = data;
        this.boundary = 0 - 1;
        this.scanned = false;
        this._headers = HttpHeaders();
    }

    public static fun from_wire(data: char[]): HttpResponse {
        return HttpResponse(data);
    }

    fun scan(): void {
        if this.scanned == false {
            this.scanned = true;
            let n = this.data.length;
            let i = 0;
            let found = false;
            while (i + 1 < n) && (found == false) {
                if (this.data[i] == '\n') && (this.data[i + 1] == '\n') {
                    this.boundary = i;
                    found = true;
                }
                i = i + 1;
            }
            if found == false {
                this.boundary = n;
            }
            this._parse_headers();
        }
    }

    fun _is_http_space(c: char): bool {
        return (c == ' ') || (c == '\t') || (c == '\r');
    }

    // Walk `data[0..boundary]` in place. `split`/`substring` temps are hidden-borrow
    // strings; last-use destroy is skipped for those types, so a `string[]` of lines
    // outlives this method and leaks one array plus every line per response.
    fun _parse_headers(): void {
        let n = this.boundary;
        if n < 0 {
            n = 0;
        }
        let i = 0;
        while (i < n) && (this.data[i] != '\n') {
            i = i + 1;
        }
        if i < n {
            i = i + 1;
        }
        while i < n {
            let line_end = i;
            while (line_end < n) && (this.data[line_end] != '\n') {
                line_end = line_end + 1;
            }
            let colon = i;
            while (colon < line_end) && (this.data[colon] != ':') {
                colon = colon + 1;
            }
            if colon < line_end {
                let ks = i;
                let ke = colon;
                while (ks < ke) && this._is_http_space(this.data[ks]) {
                    ks = ks + 1;
                }
                while (ke > ks) && this._is_http_space(this.data[ke - 1]) {
                    ke = ke - 1;
                }
                let vs = colon + 1;
                let ve = line_end;
                while (vs < ve) && this._is_http_space(this.data[vs]) {
                    vs = vs + 1;
                }
                while (ve > vs) && this._is_http_space(this.data[ve - 1]) {
                    ve = ve - 1;
                }
                this._headers.set(this.slice_text(ks, ke), this.slice_text(vs, ve));
            }
            i = line_end + 1;
        }
    }

    fun slice_text(start: int, end: int): string {
        let len = end - start;
        if len < 0 {
            len = 0;
        }
        let result = string.alloc(len);
        let i = 0;
        while i < len {
            string.set(result, i, this.data[start + i]);
            i = i + 1;
        }
        return result;
    }

    fun head_text(): string {
        this.scan();
        return this.slice_text(0, this.boundary);
    }

    // Response head (status + headers) for cookie parsing.
    public fun head_text_for_cookies(): string {
        return this.head_text();
    }

    // The HTTP status code.
    public get status(): int {
        let n = this.data.length;
        let i = 0;
        let value = 0;
        let going = true;
        while (i < n) && (going == true) {
            let c = this.data[i];
            if c.is_digit() == true {
                value = value * 10 + (c.to_int() - 48);
                i = i + 1;
            } else {
                going = false;
            }
        }
        return value;
    }

    // True for a 2xx status.
    public get ok(): bool {
        let s = this.status;
        return (s >= 200) && (s < 300);
    }

    // The value of response header `name`.
    public fun header(name: string): string {
        this.scan();
        return this._headers.get(name).unwrap_or(string.empty);
    }

    public get headers(): HttpHeaders {
        this.scan();
        return this._headers;
    }

    // The response body as UTF-8 text.
    public fun text(): string {
        this.scan();
        return this.slice_text(this.boundary + 2, this.data.length);
    }

    // The response body as raw bytes.
    public fun bytes(): byte[] {
        this.scan();
        let n = this.data.length;
        let start = this.boundary + 2;
        if start > n {
            start = n;
        }
        let count = n - start;
        let out = Buffer.alloc<byte>(count);
        let i = 0;
        while i < count {
            out[i] = (byte)this.data[start + i];
            i = i + 1;
        }
        return out;
    }

    // The response body parsed as Json.
    public fun json(): Result<JsonValue, ParseError> {
        return Json.parse(this.text());
    }
}
