module system.net;

// A transport, validation, cancellation, deadline, or capability failure; HTTP statuses are not errors.
public class HttpError: Error {
    error_code: string;
    error_message: string;

    // Creates a failure with a stable machine code and a human-readable description.
    public constructor(code: string, message: string) {
        this.error_code = code;
        this.error_message = message;
    }

    // Stable category such as `EINVAL`, `ETIMEOUT`, `ECANCELLED`, `ECLOSED`, or `ENOTSUP`.
    public fun code(): string {
        return this.error_code;
    }

    // Human-readable failure detail; transport adapters omit request URLs from error messages.
    public fun message(): string {
        return this.error_message;
    }
}

// Request deadline and connection/redirect controls; unsupported host controls return `ENOTSUP`.
public class HttpOptions {
    // Total request deadline including response-body consumption; zero disables the deadline.
    public timeout_ms: int;

    // Native connection establishment timeout; zero uses the host default. Fetch requires zero.
    public connect_timeout_ms: int;

    // Maximum redirects; -1 uses the host default, zero exposes redirect responses on native/Node.
    // Browsers require -1 because redirect counts and responses are not reliably observable.
    public max_redirects: int;

    // Creates options; negative deadlines or redirect limits below -1 are invalid at send time.
    public constructor(
        timeout_ms: int = 30000,
        max_redirects: int = -1,
        connect_timeout_ms: int = 0
    ) {
        this.timeout_ms = timeout_ms;
        this.max_redirects = max_redirects;
        this.connect_timeout_ms = connect_timeout_ms;
    }
}

// Case-insensitive header names with ordered repeated values. Validation occurs when sending.
public class HttpHeaders {
    names: List<string>;
    values: List<string>;

    // Creates an empty header collection.
    public constructor() {
        this.names = List<string>();
        this.values = List<string>();
    }

    // Number of stored header pairs, including repeated names.
    public get length(): int {
        return this.names.length;
    }

    // Appends a value without replacing existing values for the same name.
    public fun append(name: string, value: string): void {
        this.names.push(name.to_lower());
        this.values.push(value);
    }

    // Replaces all existing values for `name` with one value at the end of the collection.
    public fun set(name: string, value: string): void {
        this.remove(name);
        this.append(name, value);
    }

    // Returns the first matching value, or `None` when absent.
    public fun get(name: string): Option<string> {
        let key = name.to_lower();
        for (let i = 0; i < this.names.length; i = i + 1) {
            if this.names.get(i) == key {
                return Option.Some(this.values.get(i));
            }
        }
        return Option.None;
    }

    // Copies every matching value in stored order; JS Fetch may already have combined repeated headers.
    public fun get_all(name: string): string[] {
        let key = name.to_lower();
        let values = List<string>();
        for (let i = 0; i < this.names.length; i = i + 1) {
            if this.names.get(i) == key {
                values.push(this.values.get(i));
            }
        }
        return values.take_array();
    }

    // Removes all values with the given case-insensitive name.
    public fun remove(name: string): void {
        let key = name.to_lower();
        let i = 0;
        while i < this.names.length {
            if this.names.get(i) == key {
                this.names.remove_at(i);
                this.values.remove_at(i);
            } else {
                i = i + 1;
            }
        }
    }

    /// Serializes header pairs in order, preserving repeated names.
    public fun to_json(): JsonValue {
        let pairs = JsonValue.array();
        for (let i = 0; i < this.names.length; i = i + 1) {
            let pair = JsonValue.array();
            pair.push(JsonValue.from_string(this.names.get(i)));
            pair.push(JsonValue.from_string(this.values.get(i)));
            pairs.push(pair);
        }
        return pairs;
    }

    internal static fun from_wire(pairs: JsonValue): HttpHeaders {
        let headers = HttpHeaders();
        for (let i = 0; i < pairs.length; i = i + 1) {
            let pair = pairs.at(i).unwrap();
            headers.append(
                pair.at(0).unwrap().as_string().unwrap_or(""),
                pair.at(1).unwrap().as_string().unwrap_or("")
            );
        }
        return headers;
    }
}

// Mutable request description; sending snapshots URL, headers, options, and body bytes.
public class HttpRequest {
    // HTTP method, restricted to GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS on all hosts.
    public method: string;

    // Absolute http/https destination; credentials in URLs are rejected.
    public url: Url;

    // Request headers; browsers reject forbidden names instead of silently ignoring them.
    public headers: HttpHeaders;

    // Byte body copied for each send; GET and HEAD require an empty body.
    public body: byte[];

    // Creates a request with empty headers and body.
    public constructor(method: string, url: Url) {
        this.method = method;
        this.url = url;
        this.headers = HttpHeaders();
        this.body = [];
    }

    // Creates a GET request.
    public static fun get(url: Url): HttpRequest {
        return HttpRequest("GET", url);
    }

    // Creates a POST request.
    public static fun post(url: Url): HttpRequest {
        return HttpRequest("POST", url);
    }

    // Creates a PUT request.
    public static fun put(url: Url): HttpRequest {
        return HttpRequest("PUT", url);
    }

    // Creates a PATCH request.
    public static fun patch(url: Url): HttpRequest {
        return HttpRequest("PATCH", url);
    }

    // Creates a DELETE request.
    public static fun delete(url: Url): HttpRequest {
        return HttpRequest("DELETE", url);
    }

    // Replaces the body with UTF-8 bytes; adds no content-type header implicitly.
    public fun set_text(text: string): void {
        this.body = Encoding.utf8_encode(text);
    }

    internal fun wire(options: HttpOptions): string {
        let json = JsonValue.dict();
        json.set("method", JsonValue.from_string(this.method));
        json.set("url", JsonValue.from_string(this.url.to_string()));
        json.set("headers", this.headers.to_json());
        json.set("timeout_ms", JsonValue.from_int(options.timeout_ms));
        json.set("connect_timeout_ms", JsonValue.from_int(options.connect_timeout_ms));
        json.set("max_redirects", JsonValue.from_int(options.max_redirects));
        return Json.serialize(json);
    }
}

// Host-enforced HTTP controls; unsupported options still return `ENOTSUP` at send time.
public static class HttpCapabilities {
    @runtime("netCapabilities")
    static extern fun flags_host(): int;

    // Whether a separate connection-establishment timeout can be configured (native hosts).
    public static get connection_timeouts(): bool {
        return (HttpCapabilities.flags_host() & 1) != 0;
    }

    // Whether explicit redirect limits and redirect responses are observable (native and Node).
    public static get redirect_limits(): bool {
        return (HttpCapabilities.flags_host() & 2) != 0;
    }

    // Whether browser forbidden-header restrictions do not apply; HTTP syntax is always validated.
    public static get unrestricted_headers(): bool {
        return (HttpCapabilities.flags_host() & 4) != 0;
    }
}
