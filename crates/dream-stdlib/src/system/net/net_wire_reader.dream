module system.net;

// Sequential reader over a `char[]` wire payload shared by the TCP/WebSocket host functions: a
// tag line, then raw bytes for the remainder (mirrors `system.process`'s `ProcessWireReader`).
// Each `char` element of the payload is one raw byte (0-255).
internal class NetWireReader {
    data: char[];
    pos: int;

    public constructor(data: char[]) {
        this.data = data;
        this.pos = 0;
    }

    fun slice_text(start: int, len: int): string {
        let result = string.alloc(len);
        let src = Span<char>(this.data, start, len);
        let i = 0;
        while (i < len) {
            string.set(result, i, src.get(i));
            i = i + 1;
        }
        return result;
    }

    // Reads and consumes everything up to the next '\n' (exclusive), then skips the '\n'.
    public fun read_line(): string {
        let n = this.data.length;
        let start = this.pos;
        let i = start;
        while ((i < n) && (this.data[i] != '\n')) {
            i = i + 1;
        }
        let line = this.slice_text(start, i - start);
        this.pos = i + 1;
        return line;
    }

    // Reads and consumes the next `count` raw bytes (clamped to what remains).
    public fun read_bytes(count: int): byte[] {
        let n = this.data.length;
        let start = this.pos;
        let take = count;
        if (start + take > n) {
            take = n - start;
        }
        if (take < 0) {
            take = 0;
        }
        let out = Buffer.alloc<byte>(take);
        let src = Span<char>(this.data, start, take);
        let i = 0;
        while (i < take) {
            out[i] = (byte)src.get(i);
            i = i + 1;
        }
        this.pos = start + take;
        return out;
    }

    // Reads and consumes every remaining byte.
    public fun read_remaining_bytes(): byte[] {
        return this.read_bytes(this.data.length - this.pos);
    }

    // Reads and consumes every remaining byte as UTF-8 text.
    public fun read_remaining_text(): string {
        return this.slice_text(this.pos, this.data.length - this.pos);
    }
}
