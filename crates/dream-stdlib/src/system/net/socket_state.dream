module system.net;

// An owned host socket and its endpoints, read once when it opens. Closing wakes every pending
// call on the socket with ECLOSED.
@cfg(Target.Native || Target.Node || Target.Wasi)
internal class SocketState {
    internal id: int;
    internal local_host: string;
    internal local_port: int;
    internal peer_host: string;
    internal peer_port: int;

    internal constructor(id: int) {
        this.id = id;
        this.local_host = SocketState.address_host(id, false);
        this.local_port = SocketState.port_host(id, false);
        this.peer_host = SocketState.address_host(id, true);
        this.peer_port = SocketState.port_host(id, true);
    }

    @runtime("netSocketAddress", "core", RuntimeTrait.Component)
    static extern fun address_host(socket: int, peer: bool): string;

    @runtime("netSocketPort", "core", RuntimeTrait.Component)
    static extern fun port_host(socket: int, peer: bool): int;

    @runtime("netSocketClose", "core", RuntimeTrait.Component)
    static extern fun close_host(socket: int): void;

    internal fun close(): void {
        if this.id > 0 {
            SocketState.close_host(this.id);
            this.id = 0;
        }
    }

    del() {
        this.close();
    }

    internal static fun endpoint(port: int, timeout_ms: int): Result<Unit, IoError> {
        if port < 0 || port > 65535 || timeout_ms < 0 {
            return Result.Err(IoError.invalid("", "invalid socket port or timeout"));
        }
        return Result.Ok(Unit());
    }

    // Checks a call can start: the socket is open, the deadline is valid, and nobody cancelled.
    internal fun ready(timeout_ms: int, token: Option<CancellationToken>): Result<Unit, IoError> {
        if this.id <= 0 {
            return Result.Err(IoError.closed("socket"));
        }
        if timeout_ms < 0 {
            return Result.Err(IoError.invalid("", "invalid socket timeout"));
        }
        return CancellationToken.rejected(token, IoError.cancelled());
    }

    // Finishes an open or accept call and takes ownership of the socket it produced.
    internal static async fun open(
        call: SocketCall,
        token: Option<CancellationToken>
    ): Result<SocketState, IoError> {
        call.finish(token).await?;
        let id = call.value();
        if id <= 0 {
            return Result.Err(IoError.other("", "invalid socket handle"));
        }
        return Result.Ok(SocketState((int)id));
    }

    // Applies a control call such as an option change or a write shutdown.
    internal fun control(call: SocketCall): Result<Unit, IoError> {
        if this.id <= 0 {
            return Result.Err(IoError.closed("socket"));
        }
        return call.settled();
    }
}
