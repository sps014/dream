module system.net;

// A raw TCP client. Native and Node hosts back this with a real socket; the browser has no raw
// socket API, so `connect`/`connect_timeout` resolve `Err(NetError.unsupported(...))` there.
public class TcpClient {
    handle: int;
    is_closed: bool;

    @native @node
    @runtime("tcpConnect")
    static extern async fun tcp_connect(host: string, port: int, timeout_ms: int): char[];

    @native @node
    @runtime("tcpSend")
    static extern async fun tcp_send(handle: int, data: byte[]): char[];

    @native @node
    @runtime("tcpSendText")
    static extern async fun tcp_send_text(handle: int, text: string): char[];

    @native @node
    @runtime("tcpReceive")
    static extern async fun tcp_receive(handle: int, max_bytes: int): char[];

    @native @node
    @runtime("tcpClose")
    static extern fun tcp_close(handle: int): bool;

    constructor(handle: int) {
        this.handle = handle;
        this.is_closed = false;
    }

    // Opens a TCP connection to `host:port` with no connect timeout.
    @native @node
    public static async fun connect(host: string, port: int): Result<TcpClient, NetError> {
        return await TcpClient.connect_timeout(host, port, 0);
    }

    // Opens a TCP connection with a connect timeout in milliseconds (`0` = none).
    @native @node
    public static async fun connect_timeout(host: string, port: int, timeout_ms: int): Result<TcpClient, NetError> {
        let wire = await TcpClient.tcp_connect(host, port, timeout_ms);
        let reader = NetWireReader(wire);
        let handle = int.parse(reader.read_line()).unwrap_or(0 - 1);
        if handle < 0 {
            let message = reader.read_remaining_text();
            if handle == (0 - 2) {
                return Result.Err(NetError.unsupported(message));
            }
            return Result.Err(NetError.connect_failed(message));
        }
        return Result.Ok(TcpClient(handle));
    }

    // Sends raw bytes; resolves with the number of bytes written.
    @native @node
    public async fun send(data: byte[]): Result<int, NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await TcpClient.tcp_send(this.handle, data);
        return this.parse_int_result(wire);
    }

    // Sends `text` encoded as UTF-8; resolves with the number of bytes written.
    @native @node
    public async fun send_text(text: string): Result<int, NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await TcpClient.tcp_send_text(this.handle, text);
        return this.parse_int_result(wire);
    }

    fun parse_int_result(wire: char[]): Result<int, NetError> {
        let reader = NetWireReader(wire);
        let n = int.parse(reader.read_line()).unwrap_or(0 - 1);
        if n < 0 {
            return Result.Err(NetError.io(reader.read_remaining_text()));
        }
        return Result.Ok(n);
    }

    // Reads up to `max_bytes`. An empty array means the peer closed the connection (EOF), not an
    // error — check `data.length == 0` to detect end-of-stream.
    @native @node
    public async fun receive(max_bytes: int): Result<byte[], NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await TcpClient.tcp_receive(this.handle, max_bytes);
        let reader = NetWireReader(wire);
        let tag = reader.read_line();
        if tag == "data" {
            return Result.Ok(reader.read_remaining_bytes());
        }
        if tag == "eof" {
            return Result.Ok(Buffer.alloc<byte>(0));
        }
        return Result.Err(NetError.io(reader.read_remaining_text()));
    }

    // Closes the connection. Safe to call more than once.
    @native @node
    public fun close(): void {
        if this.is_closed == false {
            this.is_closed = true;
            TcpClient.tcp_close(this.handle);
        }
    }
}
