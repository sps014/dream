module system.net;

/// An owned TCP listener; accepted connections retain independent ownership. Available on
/// native, Node, and WASI builds.
@cfg(Target.Native || Target.Node || Target.Wasi)
public class TcpListener {
    state: SocketState;

    internal constructor(state: SocketState) {
        this.state = state;
    }

    /// Binds a listener; port zero selects an ephemeral port reported by local_port.
    public static async fun bind(
        host: string,
        port: int,
        token: Option<CancellationToken> = Option.None
    ): Result<TcpListener, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        SocketState.endpoint(port, 0)?;
        let call = SocketCall.listen(host, port);
        return Result.Ok(TcpListener(SocketState.open(call, effective_token).await?));
    }

    /// Numeric interface address selected by the host.
    public get local_host(): string {
        return this.state.local_host;
    }

    /// Actual bound port, including an automatically selected ephemeral port.
    public get local_port(): int {
        return this.state.local_port;
    }

    /// Accepts the next connection. `timeout_ms` is a deadline in milliseconds (zero waits
    /// forever); it fails with ETIMEOUT when it passes, ECANCELLED when `token` fires, and
    /// ECLOSED when the listener closes.
    public async fun accept(
        timeout_ms: int = 0,
        token: Option<CancellationToken> = Option.None
    ): Result<TcpStream, IoError> {
        return TcpListener.accept_owned(this.state, timeout_ms, CancellationToken.resolve(token))
            .await;
    }

    static async fun accept_owned(
        state: SocketState,
        timeout_ms: int,
        token: Option<CancellationToken>
    ): Result<TcpStream, IoError> {
        state.ready(timeout_ms, token)?;
        let call = SocketCall.accept(state.id, timeout_ms);
        return Result.Ok(TcpStream(SocketState.open(call, token).await?));
    }

    /// Closes this listener and cancels pending accepts, preserving accepted streams.
    public fun close(): Result<Unit, IoError> {
        this.state.close();
        return Result.Ok(Unit());
    }
}
