module system.net;

/// An owned TCP byte stream supporting one simultaneous read and one simultaneous write.
/// Available on native, Node, and WASI builds.
@cfg(Target.Native || Target.Node || Target.Wasi)
public class TcpStream: AsyncReader, AsyncWriter {
    state: SocketState;

    internal constructor(state: SocketState) {
        this.state = state;
    }

    /// Resolves `host` and connects to `port` (0 to 65535), trying each resolved address in
    /// turn. `timeout_ms` bounds connecting; zero disables the deadline. Fails with ETIMEOUT
    /// when the deadline passes, ECANCELLED when `token` fires, and EIO when the name does not
    /// resolve or no address accepts the connection.
    public static async fun connect(
        host: string,
        port: int,
        timeout_ms: int = 0,
        token: Option<CancellationToken> = Option.None
    ): Result<TcpStream, IoError> {
        let effective_token = CancellationToken.resolve(token);
        CancellationToken.rejected(effective_token, IoError.cancelled())?;
        SocketState.endpoint(port, timeout_ms)?;
        let call = SocketCall.connect(host, port, timeout_ms);
        return Result.Ok(TcpStream(SocketState.open(call, effective_token).await?));
    }

    /// Numeric local interface address selected for this connection.
    public get local_host(): string {
        return this.state.local_host;
    }

    /// Actual bound local port.
    public get local_port(): int {
        return this.state.local_port;
    }

    /// Numeric remote address of the peer.
    public get peer_host(): string {
        return this.state.peer_host;
    }

    /// Remote TCP port of the peer.
    public get peer_port(): int {
        return this.state.peer_port;
    }

    /// Reads at least one and at most `max_bytes` bytes, returning whatever has arrived. A request
    /// above 1 MiB returns at most 1 MiB per call. A positive-size empty success denotes peer EOF.
    public async unique fun read_async(
        max_bytes: int,
        token: Option<CancellationToken> = Option.None
    ): Result<byte[], IoError> {
        return this.read_with_timeout(max_bytes, 0, token).await;
    }

    /// Reads like `read_async` with a deadline in milliseconds; zero disables it. A read that
    /// times out or is cancelled keeps the bytes it already took for the next read. A
    /// concurrent read returns EBUSY.
    public fun read_with_timeout(
        max_bytes: int,
        timeout_ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<byte[], IoError>> {
        return TcpStream.read_owned(
            this.state,
            max_bytes,
            timeout_ms,
            CancellationToken.resolve(token)
        );
    }

    static async fun read_owned(
        state: SocketState,
        max_bytes: int,
        timeout_ms: int,
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        state.ready(timeout_ms, token)?;
        let call = SocketCall.read(state.id, max_bytes, timeout_ms);
        call.finish(token).await?;
        return Result.Ok(call.bytes());
    }

    /// Writes some of `bytes` and returns how many the connection accepted, which can be fewer
    /// than requested. Cancellation keeps bytes already sent. A concurrent write returns EBUSY,
    /// a write after `shutdown_write` returns ECLOSED, and a broken connection returns EIO.
    public async unique fun write_async(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<int, IoError> {
        return TcpStream.write_owned(this.state, bytes, CancellationToken.resolve(token)).await;
    }

    static async fun write_owned(
        state: SocketState,
        bytes: byte[],
        token: Option<CancellationToken>
    ): Result<int, IoError> {
        state.ready(0, token)?;
        let call = SocketCall.write(state.id, bytes);
        call.finish(token).await?;
        return Result.Ok((int)call.value());
    }

    /// Retries partial writes until every byte has been accepted; does not roll back failures.
    public async fun write_all_async(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        let effective_token = CancellationToken.resolve(token);
        let lifetime = [this];
        let offset = 0;
        while offset < bytes.length {
            let count = bytes.length - offset;
            if count > 65536 {
                count = 65536;
            }
            let written = lifetime[0]
                .write_async(Span<byte>(bytes, offset, count).to_array(), effective_token)
                .await?;
            if written <= 0 || written > count {
                return Result.Err(IoError.other("", "socket made invalid write progress"));
            }
            offset = offset + written;
        }
        return lifetime[0].flush_async(effective_token).await;
    }

    /// TCP writes are unbuffered by this wrapper; validates openness and cancellation.
    public async unique fun flush_async(
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        return this.state.ready(0, CancellationToken.resolve(token));
    }

    /// Sends FIN after accepted writes while retaining the read side; a pending write returns
    /// EBUSY.
    public fun shutdown_write(): Result<Unit, IoError> {
        return this.state.control(SocketCall.shutdown(this.state.id));
    }

    /// Enables or disables TCP_NODELAY, which sends small writes immediately instead of
    /// coalescing them.
    public fun set_nodelay(enabled: bool): Result<Unit, IoError> {
        let value = 0;
        if enabled {
            value = 1;
        }
        return this.state.control(SocketCall.option(this.state.id, SocketCall.NODELAY, value));
    }

    /// Closes the owned socket and wakes pending operations with ECLOSED; repeated closure
    /// succeeds.
    public fun close(): Result<Unit, IoError> {
        this.state.close();
        return Result.Ok(Unit());
    }
}
