module system.net;

/// An owned TCP byte stream supporting one simultaneous read and one simultaneous write.
public class TcpStream: AsyncReader, AsyncWriter {
    state: SocketState;

    internal constructor(state: SocketState) {
        this.state = state;
    }

    /// Connects with a deadline in milliseconds; zero disables the deadline.
    public static async fun connect(
        host: string,
        port: int,
        timeout_ms: int = 0,
        token: Option<CancellationToken> = Option.None
    ): Result<TcpStream, IoError> {
        return Result.Ok(
            TcpStream(SocketState.open("connect", host, port, timeout_ms, token).await?)
        );
    }

    /// Numeric local interface address selected for this connection.
    public get local_host(): string {
        return this.state.metadata["local_host"].as_string().unwrap_or("");
    }

    /// Actual bound local port.
    public get local_port(): int {
        return this.state.metadata["local_port"].as_int().unwrap_or(0);
    }

    /// Numeric remote address of the peer.
    public get peer_host(): string {
        return this.state.metadata["peer_host"].as_string().unwrap_or("");
    }

    /// Remote TCP port of the peer.
    public get peer_port(): int {
        return this.state.metadata["peer_port"].as_int().unwrap_or(0);
    }

    /// Reads at least one and at most `max_bytes` bytes, returning whatever has arrived. A request
    /// above 1 MiB returns at most 1 MiB per call. A positive-size empty success denotes peer EOF.
    public async unique fun read_async(
        max_bytes: int,
        token: Option<CancellationToken> = Option.None
    ): Result<byte[], IoError> {
        return this.read_with_timeout(max_bytes, 0, token).await;
    }

    /// Reads with a per-operation deadline; a concurrent read returns EBUSY.
    public fun read_with_timeout(
        max_bytes: int,
        timeout_ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<byte[], IoError>> {
        let request = SocketState.request("read", this.state.id, timeout_ms);
        request["count"] = JsonValue.from_int(max_bytes);
        return this.state.submit(request, [], token);
    }

    /// Writes a partial byte count; cancellation preserves completed side effects.
    public async unique fun write_async(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<int, IoError> {
        let request = SocketState.request("write", this.state.id, 0);
        let output = this.state.submit(request, bytes, token).await?;
        let count = int.parse(Encoding.utf8_decode(output));
        if count.is_err() {
            return Result.Err(IoError.other("", "invalid socket write progress"));
        }
        return Result.Ok(count.unwrap());
    }

    /// Retries partial writes until every byte has been accepted; does not roll back failures.
    public async fun write_all_async(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        let effective_token = CancellationToken.resolve(token);
        let lifetime = [this];
        let offset = 0;
        while offset < bytes.length {
            let count = bytes.length - offset;
            if count > 65536 {
                count = 65536;
            }
            let written = lifetime[0]
                .write_async(Span<byte>(bytes, offset, count).to_array(), effective_token)
                .await?;
            if written <= 0 || written > count {
                return Result.Err(IoError.other("", "socket made invalid write progress"));
            }
            offset = offset + written;
        }
        return lifetime[0].flush_async(effective_token).await;
    }

    /// TCP writes are unbuffered by this wrapper; validates openness and cancellation.
    public async unique fun flush_async(
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, IoError> {
        CancellationToken.rejected(CancellationToken.resolve(token), IoError.cancelled())?;
        if this.state.id <= 0 {
            return Result.Err(IoError.closed("socket"));
        }
        return Result.Ok(Unit());
    }

    /// Sends FIN after accepted writes while retaining the read side; pending writes return EBUSY.
    public fun shutdown_write(): Result<Unit, IoError> {
        return this.state.control("shutdown_write", JsonValue.null());
    }

    /// Enables or disables TCP_NODELAY; pending native reads may return EBUSY.
    public fun set_nodelay(enabled: bool): Result<Unit, IoError> {
        return this.state.control("nodelay", JsonValue.from_bool(enabled));
    }

    /// Closes the owned socket and wakes pending operations; repeated closure succeeds.
    public fun close(): Result<Unit, IoError> {
        this.state.close();
        return Result.Ok(Unit());
    }
}
