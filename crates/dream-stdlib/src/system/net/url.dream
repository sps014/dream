module system.net;

// A normalized absolute URL parsed using the host URL Standard implementation.
// Query parameters preserve their original encoding until modified.
public class Url {
    parts: string[];
    parameters: UrlQuery;

    internal constructor(parts: string[]) {
        this.parts = parts;
        this.parameters = UrlQuery(this.parts);
    }

    @runtime("netUrlParse")
    static extern fun parse_host(borrow input: string, borrow base: string): string[];

    // Parses and normalizes an absolute URL; relative or malformed input returns `ParseError`.
    public static fun parse(input: string): Result<Url, ParseError> {
        return Url.from_parts(Url.parse_host(input, ""));
    }

    static fun from_parts(parts: string[]): Result<Url, ParseError> {
        if parts.length < 6 || (parts.length - 6) % 2 != 0 {
            return Result.Err(ParseError.invalid("invalid URL"));
        }
        return Result.Ok(Url(parts));
    }

    // Resolves a relative reference against this URL; an absolute reference replaces the base.
    // A trailing slash in the base determines whether its last path component is a directory.
    public fun resolve(reference: string): Result<Url, ParseError> {
        return Url.from_parts(Url.parse_host(reference, this.to_string()));
    }

    // Lowercase scheme without the colon delimiter.
    public get scheme(): string { return this.parts[1]; }

    // Canonical hostname, with IPv6 brackets when present; empty for URLs without a host.
    public get host(): string { return this.parts[2]; }

    // Encoded path component; percent escapes remain encoded.
    public get path(): string { return this.parts[3]; }

    // Ordered, mutable query parameters shared with this URL; repeated keys remain distinct.
    public get query(): UrlQuery { return this.parameters; }

    // Serializes the normalized URL, including query edits and any fragment delimiter.
    public override fun to_string(): string {
        return this.parts[0] + this.parameters.render() + this.parts[4];
    }
}

// Ordered form-decoded URL query parameters. Mutations use form encoding (`+` for space).
public class UrlQuery {
    keys: List<string>;
    values: List<string>;
    original: string;
    dirty: bool;

    internal constructor(parts: string[]) {
        this.keys = List<string>();
        this.values = List<string>();
        this.original = parts[5];
        this.dirty = false;
        for (let i = 6; i < parts.length; i = i + 2) {
            this.keys.push(parts[i]);
            this.values.push(parts[i + 1]);
        }
    }

    // Number of key/value pairs, including repeated keys and empty values.
    public get length(): int { return this.keys.length; }

    // Appends a decoded key/value pair after existing parameters.
    public fun append(key: string, value: string): void {
        this.keys.push(key);
        this.values.push(value);
        this.dirty = true;
    }

    // Returns the first decoded value for `key`, or `None` if the key is absent.
    public fun get(key: string): Option<string> {
        for (let i = 0; i < this.keys.length; i = i + 1) {
            if this.keys.get(i) == key { return Option.Some(this.values.get(i)); }
        }
        return Option.None;
    }

    // Copies all decoded values for `key` in their original order.
    public fun get_all(key: string): string[] {
        let matches = List<string>();
        for (let i = 0; i < this.keys.length; i = i + 1) {
            if this.keys.get(i) == key { matches.push(this.values.get(i)); }
        }
        return matches.take_array();
    }

    // Replaces the first occurrence in place and removes later duplicates; appends if absent.
    public fun set(key: string, value: string): void {
        let found = false;
        let i = 0;
        while i < this.keys.length {
            if this.keys.get(i) == key {
                if found {
                    this.keys.remove_at(i);
                    this.values.remove_at(i);
                    continue;
                }
                this.values.set(i, value);
                found = true;
            }
            i = i + 1;
        }
        if !found { this.append(key, value); }
        this.dirty = true;
    }

    // Removes every occurrence of `key`, preserving the order of remaining pairs.
    public fun remove(key: string): void {
        let i = 0;
        while i < this.keys.length {
            if this.keys.get(i) == key {
                this.keys.remove_at(i);
                this.values.remove_at(i);
            } else { i = i + 1; }
        }
        this.dirty = true;
    }

    // Removes all parameters and the query delimiter from the URL.
    public fun clear(): void {
        this.keys.clear();
        this.values.clear();
        this.dirty = true;
    }

    internal fun render(): string {
        if !this.dirty { return this.original; }
        if this.keys.length == 0 { return ""; }
        let output = StringBuilder();
        output.append("?");
        for (let i = 0; i < this.keys.length; i = i + 1) {
            if i > 0 { output.append("&"); }
            output.append(Encoding.form_encode_component(this.keys.get(i)));
            output.append("=");
            output.append(Encoding.form_encode_component(this.values.get(i)));
        }
        return output.to_string();
    }
}
