module system.net;

/// An owned RFC 6455 WebSocket, available on native, Node and browser hosts.
public class WebSocket {
    id: int;

    internal constructor(id: int) {
        this.id = id;
    }

    @runtime("netWsStart")
    static extern fun start_host(request: byte[], bytes: byte[]): int;

    @runtime("netWsClose")
    static extern fun close_host(id: int): void;

    del() {
        if this.id > 0 {
            WebSocket.close_host(this.id);
        }
    }

    /// Opens ws:// or wss:// with an optional deadline and inherited cancellation.
    public static async fun connect(
        url: string,
        timeout_ms: int = 0,
        token: Option<CancellationToken> = Option.None
    ): Result<WebSocket, IoError> {
        let effective = CancellationToken.resolve(token);
        CancellationToken.rejected(effective, IoError.cancelled())?;
        if timeout_ms < 0 {
            return Result.Err(IoError.invalid("", "invalid WebSocket timeout"));
        }
        let request = WebSocket.request(WebSocketAction.Connect, 0, timeout_ms);
        request.text(url);
        let operation = SocketOperation(WebSocket.start_host(request.finish(), []));
        let id = WebSocket.handle(operation.wait(effective).await?);
        if id <= 0 {
            return Result.Err(IoError.other("", "invalid WebSocket handle"));
        }
        let socket = WebSocket(id);
        operation.claim();
        operation.close();
        return Result.Ok(socket);
    }

    /// Sends one UTF-8 text message.
    public fun send_text(
        text: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return WebSocket.send_owned(
            this,
            WebSocketAction.SendText,
            Encoding.utf8_encode(text),
            1000,
            "",
            CancellationToken.resolve(token)
        );
    }

    /// Sends one binary message.
    public fun send_binary(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return WebSocket.send_owned(
            this,
            WebSocketAction.SendBinary,
            bytes,
            1000,
            "",
            CancellationToken.resolve(token)
        );
    }

    /// Sends a normal closing handshake.
    public fun close(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return this.close_with(1000, "", token);
    }

    /// Sends a validated close code and UTF-8 reason.
    public fun close_with(
        code: int,
        reason: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return WebSocket.send_owned(
            this,
            WebSocketAction.Close,
            [],
            code,
            reason,
            CancellationToken.resolve(token)
        );
    }

    static async fun send_owned(
        socket: WebSocket,
        action: WebSocketAction,
        bytes: byte[],
        code: int,
        reason: string,
        token: Option<CancellationToken>
    ): Result<Unit, IoError> {
        let request = WebSocket.request(action, socket.id, 0);
        if action == WebSocketAction.Close {
            request.i32(code);
            request.text(reason);
        }
        WebSocket.submit(socket, request, bytes, token).await?;
        return Result.Ok(Unit());
    }

    static async fun submit(
        socket: WebSocket,
        request: WireWriter,
        bytes: byte[],
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        if CancellationToken.is_cancelled_opt(token) {
            WebSocket.close_host(socket.id);
            return Result.Err(IoError.cancelled());
        }
        if socket.id <= 0 {
            return Result.Err(IoError.closed("WebSocket"));
        }
        let operation = SocketOperation(WebSocket.start_host(request.finish(), bytes));
        let result = operation.wait(token).await;
        operation.close();
        if result.is_err() && result.unwrap_err().code() == "ECANCELLED" {
            WebSocket.close_host(socket.id);
        }
        return result;
    }

    /// Receives one complete message. Only one receive may be pending at a time.
    public fun receive(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<WebSocketMessage, IoError>> {
        return WebSocket.receive_owned(this, CancellationToken.resolve(token));
    }

    static async fun receive_owned(
        socket: WebSocket,
        token: Option<CancellationToken>
    ): Result<WebSocketMessage, IoError> {
        let bytes = WebSocket.submit(
            socket,
            WebSocket.request(WebSocketAction.Receive, socket.id, 0),
            [],
            token
        ).await?;
        return WebSocket.decode(bytes);
    }

    // The operation header layout and version are shared with dream_host_abi::wire::Header.
    internal static fun request(action: WebSocketAction, id: int, timeout_ms: int): WireWriter {
        let request = WireWriter(32);
        request.u8(1);
        request.u8(action);
        request.i32(id);
        request.i32(timeout_ms);
        return request;
    }

    // A connect or upgrade completion: the new socket id, or zero when the record is malformed.
    internal static fun handle(bytes: byte[]): int {
        let reader = WireReader(bytes, 0);
        let id = reader.i32();
        return reader.at_end() ? id : 0;
    }

    // A receive completion: [kind] then text (1), bytes (2), or a close code and reason (3).
    internal static fun decode(bytes: byte[]): Result<WebSocketMessage, IoError> {
        let reader = WireReader(bytes, 0);
        let kind = reader.u8();
        let message = WebSocketMessage.Close(1006, "");
        if kind == 1 {
            message = WebSocketMessage.Text(reader.text());
        } else if kind == 2 {
            message = WebSocketMessage.Binary(reader.bytes_field());
        } else if kind == 3 {
            let code = reader.i32();
            message = WebSocketMessage.Close(code, reader.text());
        }
        if kind < 1 || kind > 3 || !reader.at_end() {
            return Result.Err(IoError.other("", "invalid WebSocket message"));
        }
        return Result.Ok(message);
    }

    /// Iterates until Close, including the final closing message. Transport errors end iteration.
    public fun messages(
        token: Option<CancellationToken> = Option.None
    ): AsyncIterable<WebSocketMessage> {
        return WebSocket.messages_owned(this, CancellationToken.resolve(token));
    }

    static async fun messages_owned(
        socket: WebSocket,
        token: Option<CancellationToken>
    ): AsyncIterable<WebSocketMessage> {
        let closing = false;
        while !closing {
            let result = socket.receive(token).await;
            if result.is_err() {
                yield break;
            }
            let message = result.unwrap();
            closing = switch (message) {
                Close(_, _) => true,
                _ => false
            };
            yield message;
        }
    }
}
