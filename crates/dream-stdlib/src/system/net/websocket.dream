module system.net;

// A WebSocket client. Native uses tungstenite (`ws://` and `wss://`). The browser/Node hosts
// use the standard `WebSocket` API.
public class WebSocket {
    handle: int;
    is_closed: bool;

    @runtime("wsConnect")
    static extern async fun ws_connect(url: string, timeout_ms: int): char[];

    @runtime("wsSendText")
    static extern async fun ws_send_text(handle: int, text: string): char[];

    @runtime("wsSendBinary")
    static extern async fun ws_send_binary(handle: int, data: byte[]): char[];

    @runtime("wsReceive")
    static extern async fun ws_receive(handle: int): char[];

    @runtime("wsClose")
    static extern fun ws_close(handle: int, code: int, reason: string): bool;

    constructor(handle: int) {
        this.handle = handle;
        this.is_closed = false;
    }

    // Opens a WebSocket connection to `url` with no connect timeout.
    public static async fun connect(url: string): Result<WebSocket, NetError> {
        return await WebSocket.connect_timeout(url, 0);
    }

    // Opens a WebSocket connection with a connect timeout in milliseconds (`0` = none).
    public static async fun connect_timeout(url: string, timeout_ms: int): Result<WebSocket, NetError> {
        let wire = await WebSocket.ws_connect(url, timeout_ms);
        let reader = NetWireReader(wire);
        let handle = int.parse(reader.read_line()).unwrap_or(0 - 1);
        if handle < 0 {
            let message = reader.read_remaining_text();
            if handle == (0 - 2) {
                return Result.Err(NetError.unsupported(message));
            }
            return Result.Err(NetError.connect_failed(message));
        }
        return Result.Ok(WebSocket(handle));
    }

    // Sends a text frame. `Ok(true)` on success.
    public async fun send_text(text: string): Result<bool, NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await WebSocket.ws_send_text(this.handle, text);
        return this.parse_send_result(wire);
    }

    // Sends a binary frame. `Ok(true)` on success.
    public async fun send_binary(data: byte[]): Result<bool, NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await WebSocket.ws_send_binary(this.handle, data);
        return this.parse_send_result(wire);
    }

    fun parse_send_result(wire: char[]): Result<bool, NetError> {
        let reader = NetWireReader(wire);
        let ok = reader.read_line();
        if ok == "1" {
            return Result.Ok(true);
        }
        return Result.Err(NetError.io(reader.read_remaining_text()));
    }

    // Waits for the next message. Resolves `NetError` on transport failure; a peer-initiated
    // close arrives as `Ok(WebSocketMessage.Close(...))`, not an error.
    public async fun receive(): Result<WebSocketMessage, NetError> {
        if this.is_closed {
            return Result.Err(NetError.closed("connection closed"));
        }
        let wire = await WebSocket.ws_receive(this.handle);
        let reader = NetWireReader(wire);
        let tag = reader.read_line();
        if tag == "text" {
            return Result.Ok(WebSocketMessage.Text(reader.read_remaining_text()));
        }
        if tag == "binary" {
            return Result.Ok(WebSocketMessage.Binary(reader.read_remaining_bytes()));
        }
        if tag == "close" {
            let code = int.parse(reader.read_line()).unwrap_or(1000);
            let reason = reader.read_remaining_text();
            this.is_closed = true;
            return Result.Ok(WebSocketMessage.Close(code, reason));
        }
        return Result.Err(NetError.protocol(reader.read_remaining_text()));
    }

    // Closes the connection with an optional close code (default `1000`) and reason. Safe to
    // call more than once.
    public fun close(): void {
        this.close_with(1000, "");
    }

    // Closes the connection with an explicit close code/reason.
    public fun close_with(code: int, reason: string): void {
        if this.is_closed == false {
            this.is_closed = true;
            WebSocket.ws_close(this.handle, code, reason);
        }
    }
}
