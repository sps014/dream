module system.primitives;

// The `double` primitive as an extensible class.
extend double: Comparable<double> {
    /// Orders this value against `other`.
    public fun compare(other: double): int {
        if this < other {
            return 0 - 1;
        }
        if this > other {
            return 1;
        }
        return 0;
    }

    /// Returns the magnitude of this value with the sign cleared, so `-0.0` becomes `0.0`
    /// and NaN stays NaN.
    public fun abs(): double {
        return Math.fabs(this);
    }

    /// Returns the smaller of this value and `other`. When either is NaN, returns `other`.
    public fun min(other: double): double {
        if this < other {
            return this;
        }
        return other;
    }

    /// Returns the larger of this value and `other`. When either is NaN, returns `other`.
    public fun max(other: double): double {
        if this > other {
            return this;
        }
        return other;
    }

    /// Returns this value limited to the inclusive range `lo` through `hi`. NaN is returned
    /// unchanged; the result is unspecified when `lo` is greater than `hi`.
    public fun clamp(lo: double, hi: double): double {
        if this < lo {
            return lo;
        }
        if this > hi {
            return hi;
        }
        return this;
    }

    /// Returns `1.0` for a positive value, `-1.0` for a negative value, and the value itself for
    /// zero (keeping the sign of `-0.0`) or NaN.
    public fun signum(): double {
        if this > 0.0d {
            return 1.0d;
        }
        if this < 0.0d {
            return -1.0d;
        }
        return this;
    }

    /// Returns the shortest decimal text that rounds back to exactly this value, so `0.1d` prints
    /// as `0.1` and `0.1d + 0.2d` as `0.30000000000000004`.
    /// Values from 1e-7 up to but not including 1e21 use plain notation (`0.1`, `3`, `1500000`);
    /// smaller and larger magnitudes use an exponent (`1e+21`, `1.5e-8`). NaN is `nan`, the
    /// infinities are `inf` and `-inf`, and both zeros are `0`.
    public override fun to_string(): string {
        let sb = StringBuilder();
        ShortestDecimal.append(sb, this, 52, 1023);
        return sb.build();
    }

    /// Parses the whole of `text` as a decimal double: an optional sign, digits with an optional
    /// fraction, and an optional exponent (`-12.5`, `.5`, `3e-4`). The spellings `nan`, `inf`,
    /// and `-inf` written by `to_string` parse back to the same values. Returns `ParseError` for
    /// empty text, text with no digits, an exponent with no digits, any other trailing
    /// character (including spaces), and a value too large to represent.
    public static fun parse(borrow text: string): Result<double, ParseError> {
        let n = text.length;
        if n == 0 {
            return Result.Err(ParseError.invalid("cannot parse double from empty string"));
        }
        let zero = 0.0d;
        if text == "nan" {
            return Result.Ok(zero / zero);
        }
        if (text == "inf") || (text == "+inf") {
            return Result.Ok(1.0d / zero);
        }
        if text == "-inf" {
            return Result.Ok(-1.0d / zero);
        }
        return double.parse_decimal(text, 0, n);
    }

    // The caller establishes that the range is nonempty and within the string.
    internal static fun parse_decimal(
        borrow text: string,
        start: int,
        end: int
    ): Result<double, ParseError> {
        let i = start;
        let neg = false;
        let c0 = text.char_at(i);
        if (c0 == '-') || (c0 == '+') {
            neg = c0 == '-';
            i = i + 1;
        }
        let digits_seen = false;
        let result = 0.0d;
        while i < end {
            let c = text.char_at(i);
            if (c < '0') || (c > '9') {
                break;
            }
            digits_seen = true;
            result = result * 10.0d + (double)((int)c - 48);
            i = i + 1;
        }
        if (i < end) && (text.char_at(i) == '.') {
            i = i + 1;
            let scale = 1.0d;
            while i < end {
                let c = text.char_at(i);
                if (c < '0') || (c > '9') {
                    break;
                }
                digits_seen = true;
                scale = scale / 10.0d;
                result = result + (double)((int)c - 48) * scale;
                i = i + 1;
            }
        }
        if digits_seen == false {
            return Result.Err(ParseError.invalid("cannot parse double: no digits"));
        }
        if (i < end) && ((text.char_at(i) == 'e') || (text.char_at(i) == 'E')) {
            i = i + 1;
            let eneg = false;
            if (i < end) && ((text.char_at(i) == '-') || (text.char_at(i) == '+')) {
                eneg = text.char_at(i) == '-';
                i = i + 1;
            }
            let exp_start = i;
            let exp = 0;
            while i < end {
                let c = text.char_at(i);
                if (c < '0') || (c > '9') {
                    break;
                }
                if exp < 100000 {
                    exp = exp * 10 + ((int)c - 48);
                }
                i = i + 1;
            }
            if i == exp_start {
                return Result.Err(
                    ParseError.invalid("cannot parse double: exponent has no digits")
                );
            }
            // Scaling in steps keeps a small mantissa with a large exponent (`0.001e310`) finite
            // and keeps `0e500` at zero instead of `0 * inf`.
            while (exp > 0) && (result != 0.0d) {
                let step = 1.0d;
                let k = 0;
                while (k < 22) && (exp > 0) {
                    step = step * 10.0d;
                    k = k + 1;
                    exp = exp - 1;
                }
                if eneg {
                    result = result / step;
                } else {
                    result = result * step;
                }
            }
        }
        if i < end {
            return Result.Err(
                ParseError.invalid(
                    $"cannot parse double: unexpected '{text.char_at(i)}' at index {i - start}"
                )
            );
        }
        if result > 1.7976931348623157e308d {
            return Result.Err(ParseError.invalid("cannot parse double: value out of range"));
        }
        if neg {
            return Result.Ok(-result);
        }
        return Result.Ok(result);
    }
}
