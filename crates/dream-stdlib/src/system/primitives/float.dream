module system.primitives;

// The `float` primitive as an extensible class.
extend float: Comparable<float> {
    /// Orders this value against `other` (negative/zero/positive).
    public fun compare(other: float): int {
        if this < other {
            return 0 - 1;
        }
        if this > other {
            return 1;
        }
        return 0;
    }

    /// Absolute value of this float.
    public fun abs(): float {
        if this < 0.0 {
            return 0.0 - this;
        }
        return this;
    }

    /// The smaller of this and `other`.
    public fun min(other: float): float {
        if this < other {
            return this;
        }
        return other;
    }

    /// The larger of this and `other`.
    public fun max(other: float): float {
        if this > other {
            return this;
        }
        return other;
    }

    /// Returns this value limited to the inclusive range `lo` through `hi`. NaN is returned
    /// unchanged; the result is unspecified when `lo` is greater than `hi`.
    public fun clamp(lo: float, hi: float): float {
        if this < lo {
            return lo;
        }
        if this > hi {
            return hi;
        }
        return this;
    }

    /// Returns `1.0` for a positive value, `-1.0` for a negative value, and the value itself for
    /// zero (keeping the sign of `-0.0`) or NaN.
    public fun signum(): float {
        if this > 0.0 {
            return 1.0;
        }
        if this < 0.0 {
            return -1.0;
        }
        return this;
    }

    /// Returns the shortest decimal text that rounds back to exactly this value, so
    /// `0.1f` prints as `0.1`. The layout, NaN, infinity, and zero spellings match
    /// `double.to_string`.
    public override fun to_string(): string {
        let sb = StringBuilder();
        ShortestDecimal.append(sb, (double)this, 23, 127);
        return sb.build();
    }

    /// Parses a decimal float from `text`.
    public static fun parse(borrow text: string): Result<float, ParseError> {
        return switch (double.parse(text)) {
            Ok(d) => Result.Ok((float)d),
            Err(e) => Result.Err(e),
        };
    }
}
