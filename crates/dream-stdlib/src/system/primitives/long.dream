module system.primitives;

// The `long` primitive.
extend long : Comparable<long> {
    // Orders this value against `other`.
    public fun compare(other: long): int {
        if this < other {
            return 0 - 1;
        }
        if this > other {
            return 1;
        }
        return 0;
    }

    // Absolute value of this long.
    public fun abs(): long {
        if this < 0L {
            return 0L - this;
        }
        return this;
    }

    // The smaller of this and `other`.
    public fun min(other: long): long {
        if this < other {
            return this;
        }
        return other;
    }

    // The larger of this and `other`.
    public fun max(other: long): long {
        if this > other {
            return this;
        }
        return other;
    }

    // This value constrained to the inclusive range [lo, hi].
    public fun clamp(lo: long, hi: long): long {
        if this < lo {
            return lo;
        }
        if this > hi {
            return hi;
        }
        return this;
    }

    // The sign of this value: -1, 0, or 1.
    public fun signum(): long {
        if this > 0L {
            return 1L;
        }
        if this < 0L {
            return 0L - 1L;
        }
        return 0L;
    }

    // Parses a decimal integer from `text`.
    public static fun parse(borrow text: string): Result<long, ParseError> {
        let n = text.length;
        if n == 0 {
            return Result.Err(ParseError.invalid("cannot parse long from empty string"));
        }
        let i = 0;
        let neg = false;
        if text.char_at(0) == '-' {
            neg = true;
            i = 1;
        }
        if i >= n {
            return Result.Err(ParseError.invalid("cannot parse long: no digits"));
        }
        let limit = 9223372036854775807uL;
        if neg {
            limit = 9223372036854775808uL;
        }
        let result = 0uL;
        while i < n {
            let c = text.char_at(i);
            if (c < '0') || (c > '9') {
                return Result.Err(ParseError.invalid("cannot parse long: invalid digit"));
            }
            let d = (ulong)((int)c - 48);
            if result > (limit - d) / 10uL {
                return Result.Err(ParseError.invalid("cannot parse long: value out of range"));
            }
            result = result * 10uL + d;
            i = i + 1;
        }
        if neg {
            // The magnitude of long.MIN is not a long, so negate in wrapping ulong arithmetic.
            unchecked {
                return Result.Ok((long)(0uL - result));
            }
        }
        return Result.Ok((long)result);
    }
}
