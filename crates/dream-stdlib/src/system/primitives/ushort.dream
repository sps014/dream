module system.primitives;

// The `ushort` primitive.
extend ushort: Comparable<ushort> {
    /// Orders this value against `other`.
    public fun compare(other: ushort): int {
        if this < other {
            return 0 - 1;
        }
        if this > other {
            return 1;
        }
        return 0;
    }

    /// The smaller of this and `other`.
    public fun min(other: ushort): ushort {
        if this < other {
            return this;
        }
        return other;
    }

    /// The larger of this and `other`.
    public fun max(other: ushort): ushort {
        if this > other {
            return this;
        }
        return other;
    }

    /// This value constrained to the inclusive range [lo, hi].
    public fun clamp(lo: ushort, hi: ushort): ushort {
        if this < lo {
            return lo;
        }
        if this > hi {
            return hi;
        }
        return this;
    }

    /// Parses an unsigned decimal `ushort` from `text`.
    public static fun parse(borrow text: string): Result<ushort, ParseError> {
        let n = text.length;
        if n == 0 {
            return Result.Err(ParseError.invalid("cannot parse ushort from empty string"));
        }
        let result = 0;
        let i = 0;
        while i < n {
            let c = text.char_at(i);
            if (c < '0') || (c > '9') {
                return Result.Err(ParseError.invalid("cannot parse ushort: invalid digit"));
            }
            result = result * 10 + ((int)c - 48);
            if result > 65535 {
                return Result.Err(ParseError.invalid("cannot parse ushort: value out of range"));
            }
            i = i + 1;
        }
        return Result.Ok((ushort)result);
    }
}
