module system.process;

// Handle to a spawned child process with piped stdin/stdout/stderr (`Process.spawn`).
public class ChildProcess {
    _handle: int;

    internal constructor(handle: int) {
        this._handle = handle;
    }

    @native @node
    @runtime("processWriteStdin")
    static extern fun host_write_stdin(handle: int, data: byte[]): bool;

    // `stream`: 0 = stdout, 1 = stderr.
    @native @node
    @runtime("processReadStream")
    static extern async fun host_read_stream(handle: int, stream: int, max_bytes: int): char[];

    @native @node
    @runtime("processReadStreamLine")
    static extern async fun host_read_stream_line(handle: int, stream: int): char[];

    @native @node
    @runtime("processWait")
    static extern async fun host_wait(handle: int): char[];

    @native @node
    @runtime("processKill")
    static extern fun host_kill(handle: int): bool;

    // Copies `data[start..]` into a fresh `byte[]` (byte-exact; each `char` is one raw byte).
    static fun slice_to_bytes(data: char[], start: int): byte[] {
        let n = data.length - start;
        let out = Buffer.alloc<byte>(n);
        let src = Span<char>(data, start, n);
        let i = 0;
        while i < n {
            out[i] = (byte)src.get(i);
            i = i + 1;
        }
        return out;
    }

    @native @node
    async fun read_line(stream: int, token: Option<CancellationToken> = Option.None): Option<string> {
        CancellationToken.throw_if_opt(token);
        let raw = await ChildProcess.host_read_stream_line(this._handle, stream);
        if raw.length == 0 {
            return Option.None;
        }
        if raw[0] == '0' {
            return Option.None;
        }
        return Option.Some(Encoding.utf8_decode(ChildProcess.slice_to_bytes(raw, 1)));
    }

    // Writes `data` to the child's stdin. Returns `false` if the pipe is closed or the write fails.
    @native @node
    public fun write_stdin(data: byte[]): bool {
        return ChildProcess.host_write_stdin(this._handle, data);
    }

    // Writes UTF-8 text to the child's stdin.
    @native @node
    public fun write_stdin_text(text: string): bool {
        return this.write_stdin(Encoding.utf8_encode(text));
    }

    // Reads up to `max_bytes` currently buffered from stdout, blocking until at least one byte
    // has arrived or the stream has reached end-of-file (in which case the result is empty).
    @native @node
    public async fun read_stdout(max_bytes: int, token: Option<CancellationToken> = Option.None): byte[] {
        CancellationToken.throw_if_opt(token);
        let raw = await ChildProcess.host_read_stream(this._handle, 0, max_bytes);
        return ChildProcess.slice_to_bytes(raw, 0);
    }

    @native @node
    public async fun read_stdout_all(token: Option<CancellationToken> = Option.None): byte[] {
        return await this.read_stream_all(0, token);
    }

    // Reads one line from stdout (without the trailing newline), or `None` at end-of-file.
    @native @node
    public async fun read_stdout_line(token: Option<CancellationToken> = Option.None): Option<string> {
        return await this.read_line(0, token);
    }

    // Reads up to `max_bytes` currently buffered from stderr.
    @native @node
    public async fun read_stderr(max_bytes: int, token: Option<CancellationToken> = Option.None): byte[] {
        CancellationToken.throw_if_opt(token);
        let raw = await ChildProcess.host_read_stream(this._handle, 1, max_bytes);
        return ChildProcess.slice_to_bytes(raw, 0);
    }

    @native @node
    public async fun read_stderr_all(token: Option<CancellationToken> = Option.None): byte[] {
        return await this.read_stream_all(1, token);
    }

    // Reads one line from stderr (without the trailing newline), or `None` at end-of-file.
    @native @node
    public async fun read_stderr_line(token: Option<CancellationToken> = Option.None): Option<string> {
        return await this.read_line(1, token);
    }

    // Waits for the process to exit, returning its exit code (or a negative sentinel: `-1` if it
    // could not be waited on, `-2` if it was terminated by a signal with no exit code).
    @native @node
    public async fun wait(token: Option<CancellationToken> = Option.None): int {
        CancellationToken.throw_if_opt(token);
        let raw = await ChildProcess.host_wait(this._handle);
        return int.parse(Encoding.utf8_decode(ChildProcess.slice_to_bytes(raw, 0))).unwrap_or(0 - 1);
    }

    // Forcibly terminates the process. Returns `false` if it had already exited or could not be
    // killed.
    @native @node
    public fun kill(): bool {
        return ChildProcess.host_kill(this._handle);
    }

    @native @node
    async fun read_stream_all(stream: int, token: Option<CancellationToken> = Option.None): byte[] {
        let acc = Buffer.alloc<byte>(0);
        let n = 0;
        while true {
            CancellationToken.throw_if_opt(token);
            let raw = await ChildProcess.host_read_stream(this._handle, stream, 65536);
            let chunk = ChildProcess.slice_to_bytes(raw, 0);
            if chunk.length == 0 {
                break;
            }
            let need = n + chunk.length;
            if need > acc.length {
                let cap = acc.length;
                if cap < 1 {
                    cap = chunk.length;
                }
                while cap < need {
                    cap = cap * 2;
                }
                acc = Buffer.realloc<byte>(acc, cap);
            }
            let i = 0;
            while i < chunk.length {
                acc[n] = chunk[i];
                n = n + 1;
                i = i + 1;
            }
        }
        let out = Buffer.alloc<byte>(n);
        let j = 0;
        while j < n {
            out[j] = acc[j];
            j = j + 1;
        }
        return out;
    }
}
