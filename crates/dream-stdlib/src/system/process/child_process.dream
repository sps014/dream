module system.process;

/// A running child process launched by `Process.spawn`, with streaming access to its stdin,
/// stdout, and stderr. Closing the child, explicitly or by dropping it, kills and reaps a child
/// that is still running.
@cfg(Target.Native || Target.Node)
public class ChildProcess {
    id: int;
    closing: bool;
    closed: Option<Result<Unit, ProcessError>>;
    completed: CancellationSource;

    internal constructor(id: int) {
        this.id = id;
        this.closing = false;
        this.closed = Option.None;
        this.completed = CancellationSource();
    }

    internal get handle(): int {
        return this.id;
    }

    /// The child's standard output. Keep one reader when using `read_line`, because it buffers
    /// bytes past the returned line.
    public get stdout(): ProcessReader {
        return ProcessReader(this, 0);
    }

    /// The child's standard error. Drain it alongside stdout so a child that fills one pipe
    /// does not stall.
    public get stderr(): ProcessReader {
        return ProcessReader(this, 1);
    }

    /// The child's standard input. Call `close_stdin` to signal end of input.
    public get stdin(): ProcessWriter {
        return ProcessWriter(this);
    }

    /// Closes the child's stdin once pending writes finish, so a child reading until end of
    /// input can complete. Returns `ECLOSED` when the child was already closed.
    public fun close_stdin(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, ProcessError>> {
        return ChildProcess.close_stdin_owned(this, CancellationToken.resolve(token));
    }

    static async fun close_stdin_owned(
        child: ChildProcess,
        token: Option<CancellationToken>
    ): Result<Unit, ProcessError> {
        CancellationToken.rejected(token, ProcessError.cancelled())?;
        if child.id <= 0 {
            return Result.Err(ProcessError("ECLOSED", "child process is closed"));
        }
        ChildProcess.close_stdin_host(child.id);
        return Result.Ok(Unit());
    }

    /// Waits for the child to exit and returns its exit status, negative when a signal ended
    /// it. Unread output stays readable, and the child stays open.
    public fun wait(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<int, ProcessError>> {
        return ChildProcess.wait_owned(this, CancellationToken.resolve(token));
    }

    static async fun wait_owned(
        child: ChildProcess,
        token: Option<CancellationToken>
    ): Result<int, ProcessError> {
        CancellationToken.rejected(token, ProcessError.cancelled())?;
        let call = ProcessCall.exit(child.id);
        call.finish(token).await?;
        return Result.Ok((int)call.value());
    }

    /// Kills the child if it is still running and waits until it is reaped. Repeated or
    /// concurrent calls share the first outcome.
    public fun close(): Future<Result<Unit, ProcessError>> {
        return ChildProcess.close_owned(this);
    }

    static async fun close_owned(child: ChildProcess): Result<Unit, ProcessError> {
        if child.closed.is_some() {
            return child.closed.unwrap();
        }
        if child.closing {
            child.completed.token.wait_cancelled().await;
            return child.closed.unwrap();
        }
        child.closing = true;
        let shield = CancellationSource();
        ChildProcess.protect_host(shield);
        child.terminate();
        let call = ProcessCall.exit(child.id);
        let reaped = call.finish(Option.Some(shield.token)).await;
        let outcome: Result<Unit, ProcessError> = Result.Ok(Unit());
        if reaped.is_err() {
            outcome = Result.Err(reaped.unwrap_err());
        }
        child.closed = Option.Some(outcome);
        ChildProcess.release_host(child.id);
        child.id = 0;
        child.completed.cancel();
        return outcome;
    }

    // Kills a running child and ends its pending reads and writes; exit waits still complete.
    internal fun terminate(): void {
        if this.id > 0 {
            ChildProcess.kill_host(this.id);
        }
    }

    del() {
        if this.id > 0 {
            ChildProcess.release_host(this.id);
        }
    }

    @runtime("processCloseStdin", "core")
    static extern fun close_stdin_host(id: int): void;

    @runtime("processKill", "core")
    static extern fun kill_host(id: int): void;

    @runtime("processRelease", "core")
    static extern fun release_host(id: int): void;

    @intrinsic(Intrinsic.DreamTaskProtect)
    static extern fun protect_host(borrow source: CancellationSource): void;
}
