module system.process;

/// Launches child processes and finds commands on `PATH`. Available in native programs and in
/// Node.js; browsers have no process API.
@cfg(Target.Native || Target.Node)
public static class Process {
    /// Runs a command to completion with default options: writes nothing to stdin, captures
    /// stdout and stderr as UTF-8 text, and returns them with the exit status. A nonzero exit
    /// status is not an error; check `ProcessOutput.success`. Fails with `ESPAWN` when the
    /// command cannot be launched.
    public static fun run(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        return Process.run(cmd, args, ProcessOptions(), token);
    }

    /// Runs a command with explicit options: working directory, environment, stdin bytes,
    /// output limit, and deadline. Fails with `ETIMEOUT` after the deadline, `ELIMIT` when an
    /// output exceeds the limit, and `ECANCELLED` when `token` is cancelled; each kills the
    /// child first.
    public static fun run(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        return Process.run_owned(cmd, args, options, CancellationToken.resolve(token));
    }

    static async fun run_owned(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken>
    ): Result<ProcessOutput, ProcessError> {
        if options.timeout_ms < 0 || options.max_output_bytes < 0 {
            return Result.Err(ProcessError("EINVAL", "invalid process options"));
        }
        let child = Process.spawn_owned(cmd, args, options, token).await?;
        return ProcessRun.execute(child, options, token).await;
    }

    /// Runs a command in `cwd` with otherwise default options.
    public static fun run_in(
        cmd: string,
        args: string[],
        cwd: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        let options = ProcessOptions();
        options.cwd = cwd;
        return Process.run(cmd, args, options, token);
    }

    /// Launches a command and returns the running child with streaming stdin, stdout, and
    /// stderr pipes. Fails with `ESPAWN` when the command cannot be launched.
    public static fun spawn(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        return Process.spawn(cmd, args, ProcessOptions(), token);
    }

    /// Launches a command with an explicit working directory and environment. The deadline,
    /// output limit, and input options apply only to `run`.
    public static fun spawn(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        return Process.spawn_owned(cmd, args, options, CancellationToken.resolve(token));
    }

    static async fun spawn_owned(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken>
    ): Result<ChildProcess, ProcessError> {
        CancellationToken.rejected(token, ProcessError.cancelled())?;
        let call = ProcessCall.spawn(cmd, args, options);
        call.finish(token).await?;
        return Result.Ok(ChildProcess((int)call.value()));
    }

    /// Launches a child in `cwd` with otherwise default options.
    public static fun spawn_in(
        cmd: string,
        args: string[],
        cwd: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        let options = ProcessOptions();
        options.cwd = cwd;
        return Process.spawn(cmd, args, options, token);
    }

    /// Runs a command like `run`, and also fails with `EEXIT` when it exits with a nonzero
    /// status.
    public static async fun run_checked(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Result<ProcessOutput, ProcessError> {
        let output = Process.run(cmd, args, token).await?;
        if !output.success {
            return Result.Err(
                ProcessError.failed("process exited with code " + output.exit_code.to_string())
            );
        }
        return Result.Ok(output);
    }

    /// Finds an existing nondirectory command path, directly or by searching `PATH`.
    /// This does not validate execute permissions or expand platform-specific extensions.
    public static fun which(cmd: string): Option<string> {
        if cmd.is_empty() {
            return Option.None;
        }
        if cmd.contains("/") || cmd.contains("\\") {
            if File.exists(cmd) && (File.is_dir(cmd) == false) {
                return Option.Some(cmd);
            }
            return Option.None;
        }
        let path_var = System.env("PATH").unwrap_or("");
        let sep = ':';
        if System.os_family == OsFamily.Windows {
            sep = ';';
        }
        let dirs = path_var.split(sep);
        let i = 0;
        while i < dirs.length {
            let dir = dirs[i];
            if dir.is_empty() == false {
                let candidate = Path.join(dir, cmd);
                if File.exists(candidate) && (File.is_dir(candidate) == false) {
                    return Option.Some(candidate);
                }
            }
            i = i + 1;
        }
        return Option.None;
    }
}
