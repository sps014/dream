module system.process;

/// Launches processes asynchronously on native and Node; browser operations return EUNSUPPORTED.
public static class Process {
    static fun encode_args(args: string[]): byte[] {
        let bytes = List<byte>();
        Process.append_length(bytes, args.length);
        for (let i = 0; i < args.length; i = i + 1) {
            let encoded = Encoding.utf8_encode(args[i]);
            Process.append_length(bytes, encoded.length);
            for (let j = 0; j < encoded.length; j = j + 1) {
                bytes.push(encoded[j]);
            }
        }
        return bytes.take_array();
    }

    static fun append_length(bytes: List<byte>, length: int): void {
        let value = (uint)length;
        for (let i = 0; i < 4; i = i + 1) {
            bytes.push((byte)(value & 255u));
            value = value >> 8u;
        }
    }

    /// Runs a command, concurrently drains both outputs, and closes stdin after sending input.
    public static fun run(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        return Process.run(cmd, args, ProcessOptions(), token);
    }

    /// Runs with explicit environment, input, output limits, and an optional deadline.
    public static fun run(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("run");
        request["command"] = JsonValue.from_string(cmd);
        request["options"] = options.wire();
        return Process.run_owned(
            request,
            Process.encode_args(args),
            CancellationToken.resolve(token)
        );
    }

    static async fun run_owned(
        request: JsonValue,
        args: byte[],
        token: Option<CancellationToken>
    ): Result<ProcessOutput, ProcessError> {
        CancellationToken.rejected(token, ProcessError.cancelled())?;
        let operation = ProcessOperation(request, args);
        let completed = operation.wait(token).await;
        operation.close();
        let raw = completed?;
        let reader = ProcessWireReader(raw);
        let exit_code = int.parse(reader.read_line()).unwrap_or(-2);
        let stdout_len = int.parse(reader.read_line()).unwrap_or(0);
        let stdout = Encoding.utf8_decode(reader.read_bytes(stdout_len));
        let stderr = Encoding.utf8_decode(reader.read_remaining_bytes());
        return Result.Ok(ProcessOutput(exit_code, stdout, stderr));
    }

    /// Runs a command in a specific working directory with otherwise default options.
    public static fun run_in(
        cmd: string,
        args: string[],
        cwd: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ProcessOutput, ProcessError>> {
        let options = ProcessOptions();
        options.cwd = cwd;
        return Process.run(cmd, args, options, token);
    }

    /// Spawns an owned child exposing streaming stdin, stdout, and stderr pipes.
    public static fun spawn(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        return Process.spawn(cmd, args, ProcessOptions(), token);
    }

    /// Spawns with explicit launch settings; child closure terminates and reaps unfinished work.
    public static fun spawn(
        cmd: string,
        args: string[],
        options: ProcessOptions,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        let request = JsonValue.dict();
        request["action"] = JsonValue.from_string("spawn");
        request["command"] = JsonValue.from_string(cmd);
        request["options"] = options.wire();
        return Process.spawn_owned(
            request,
            Process.encode_args(args),
            CancellationToken.resolve(token)
        );
    }

    static async fun spawn_owned(
        request: JsonValue,
        args: byte[],
        token: Option<CancellationToken>
    ): Result<ChildProcess, ProcessError> {
        CancellationToken.rejected(token, ProcessError.cancelled())?;
        let operation = ProcessOperation(request, args);
        let result = operation.wait(token).await;
        if result.is_err() {
            operation.close();
            return Result.Err(result.unwrap_err());
        }
        let id = int.parse(Encoding.utf8_decode(result.unwrap()));
        if id.is_err() {
            operation.close();
            return Result.Err(ProcessError.io("invalid child handle"));
        }
        let child = ChildProcess(id.unwrap());
        operation.claim();
        operation.close();
        return Result.Ok(child);
    }

    /// Spawns a child in a specific directory with otherwise default options.
    public static fun spawn_in(
        cmd: string,
        args: string[],
        cwd: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<ChildProcess, ProcessError>> {
        let options = ProcessOptions();
        options.cwd = cwd;
        return Process.spawn(cmd, args, options, token);
    }

    /// Captures output and additionally treats nonzero exit statuses as EEXIT errors.
    public static async fun run_checked(
        cmd: string,
        args: string[],
        token: Option<CancellationToken> = Option.None
    ): Result<ProcessOutput, ProcessError> {
        let output = Process.run(cmd, args, token).await?;
        if !output.success {
            return Result.Err(
                ProcessError.failed("process exited with code " + output.exit_code.to_string())
            );
        }
        return Result.Ok(output);
    }

    /// Finds an existing nondirectory command path, directly or by searching `PATH`.
    /// This does not validate execute permissions or expand platform-specific extensions.
    @native
    @node
    public static fun which(cmd: string): Option<string> {
        if cmd.is_empty() {
            return Option.None;
        }
        if cmd.contains("/") || cmd.contains("\\") {
            if File.exists(cmd) && (File.is_dir(cmd) == false) {
                return Option.Some(cmd);
            }
            return Option.None;
        }
        let path_var = System.env("PATH").unwrap_or("");
        let sep = ':';
        if System.os_family == OsFamily.Windows {
            sep = ';';
        }
        let dirs = path_var.split(sep);
        let i = 0;
        while i < dirs.length {
            let dir = dirs[i];
            if dir.is_empty() == false {
                let candidate = Path.join(dir, cmd);
                if File.exists(candidate) && (File.is_dir(candidate) == false) {
                    return Option.Some(candidate);
                }
            }
            i = i + 1;
        }
        return Option.None;
    }
}
