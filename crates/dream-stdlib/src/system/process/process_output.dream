module system.process;

// The captured result of `Process.run`: exit code plus fully buffered stdout/stderr text.
public class ProcessOutput {
    _exit_code: int;
    _stdout: string;
    _stderr: string;

    internal constructor(exit_code: int, stdout: string, stderr: string) {
        this._exit_code = exit_code;
        this._stdout = stdout;
        this._stderr = stderr;
    }

    public get exit_code(): int {
        return this._exit_code;
    }

    public get stdout(): string {
        return this._stdout;
    }

    public get stderr(): string {
        return this._stderr;
    }

    public get success(): bool {
        return this._exit_code == 0;
    }
}
