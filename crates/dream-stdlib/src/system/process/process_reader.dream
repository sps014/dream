module system.process;

// A borrowed child output pipe; cancellation preserves bytes already consumed by the host.
public class ProcessReader: AsyncReader {
    owner: ChildProcess;
    stream: int;
    pending: byte[];
    position: int;

    internal constructor(owner: ChildProcess, stream: int) {
        this.owner = owner;
        this.stream = stream;
        this.pending = Buffer.alloc<byte>(0);
        this.position = 0;
    }

    // Reads at most max_bytes; a successful empty read for a positive size means EOF.
    public async unique fun read_async(
        max_bytes: int,
        token: Option<CancellationToken> = Option.None
    ): Result<byte[], IoError> {
        let lifetime = [this];
        return ProcessReader.read_owned(lifetime[0], max_bytes, CancellationToken.resolve(token))
            .await;
    }

    static async fun read_owned(
        reader: ProcessReader,
        count: int,
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        if reader.owner.handle <= 0 {
            return Result.Err(IoError.closed(""));
        }
        if count < 0 {
            return Result.Err(IoError.invalid("", "negative process read size"));
        }
        if count == 0 {
            return Result.Ok(Buffer.alloc<byte>(0));
        }
        if CancellationToken.is_cancelled_opt(token) {
            return Result.Err(IoError.cancelled());
        }
        if reader.position < reader.pending.length {
            let size = reader.pending.length - reader.position;
            if size > count {
                size = count;
            }
            let bytes = Buffer.alloc<byte>(size);
            for (let i = 0; i < size; i = i + 1) {
                bytes[i] = reader.pending[reader.position + i];
            }
            reader.position = reader.position + size;
            return Result.Ok(bytes);
        }
        return ProcessReader.raw_read(reader, count, token).await;
    }

    static async fun raw_read(
        reader: ProcessReader,
        count: int,
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        CancellationToken.rejected(token, IoError.cancelled())?;
        let request = ProcessOperation.request("read", reader.owner.handle);
        request["stream"] = JsonValue.number((double)reader.stream);
        request["max_bytes"] = JsonValue.number((double)count);
        let operation = ProcessOperation(request, Buffer.alloc<byte>(0));
        let result = operation.wait(token).await;
        operation.close();
        if result.is_err() {
            let error = result.unwrap_err();
            return Result.Err(IoError("", error.code(), error.message()));
        }
        return Result.Ok(result.unwrap());
    }

    // Reads a buffered UTF-8 line, removing LF or CRLF and preserving a final unterminated line.
    public unique fun read_line(
        max_bytes: int = 1048576,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Option<string>, IoError>> {
        return ProcessReader.line_owned(this, max_bytes, CancellationToken.resolve(token));
    }

    static async fun line_owned(
        reader: ProcessReader,
        limit: int,
        token: Option<CancellationToken>
    ): Result<Option<string>, IoError> {
        if limit <= 0 {
            return Result.Err(IoError.invalid("", "line limit must be positive"));
        }
        let line = List<byte>();
        while true {
            if reader.position == reader.pending.length {
                reader.pending = ProcessReader.raw_read(reader, 8192, token).await?;
                reader.position = 0;
                if reader.pending.length == 0 {
                    if line.length == 0 {
                        let end: Option<string> = Option.None;
                        return Result.Ok(end);
                    }
                    return Result.Ok(Option.Some(Encoding.utf8_decode(line.take_array())));
                }
            }
            let value = reader.pending[reader.position];
            reader.position = reader.position + 1;
            if value == (byte)10 {
                if line.length > 0 && line[line.length - 1] == (byte)13 {
                    line.remove_at(line.length - 1);
                }
                return Result.Ok(Option.Some(Encoding.utf8_decode(line.take_array())));
            }
            if line.length >= limit {
                return Result.Err(IoError("", "ELIMIT", "process line exceeds configured limit"));
            }
            line.push(value);
        }
    }
}
