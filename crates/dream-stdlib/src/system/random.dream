module system;

// Seedable xorshift32 PRNG.
public class Random {
    state: uint;

    // Creates a generator from `seed` (`0` is remapped to `1` so the state is never zero).
    public constructor(seed: uint) {
        let s = seed;
        if (s == 0u) {
            s = 1u;
        }
        this.state = s;
    }

    // Advances the generator and returns the next 32-bit value.
    public fun next_u32(): uint {
        let x = this.state;
        x = x ^ (x << 13u);
        x = x ^ (x >> 17u);
        x = x ^ (x << 5u);
        this.state = x;
        return x;
    }

    // Uniform integer in `[0, bound)` when `bound > 0`, otherwise `0`.
    public fun next_int(bound: int): int {
        if (bound <= 0) {
            return 0;
        }
        return (int)(this.next_u32() % (uint)bound);
    }

    // Uniform value in `[0.0, 1.0)` at full 32-bit resolution (no quantization or modulo bias).
    public fun next_double(): double {
        let x = this.next_u32();
        return (double)x / 4294967296.0d;
    }

    // True or false with equal probability.
    public fun next_bool(): bool {
        return (this.next_u32() & 1u) == 1u;
    }

    // Uniform 64-bit value from two independent 32-bit draws, composed exactly (may be negative
    // when viewed as signed).
    public fun next_long(): long {
        let hi = (ulong)this.next_u32();
        let lo = (ulong)this.next_u32();
        return (long)(hi * 4294967296uL + lo);
    }

    public fun next_bytes(n: int): byte[] {
        let count = n;
        if (count < 0) {
            count = 0;
        }
        let out = Buffer.alloc<byte>(count);
        let i = 0;
        while (i < count) {
            out[i] = (byte)this.next_int(256);
            i = i + 1;
        }
        return out;
    }

    public fun choice<T>(list: List<T>): Option<T> {
        if (list.length == 0) {
            return Option.None;
        }
        return Option.Some(list.get(this.next_int(list.length)));
    }

    public fun shuffle<T>(list: List<T>): void {
        let i = list.length - 1;
        while (i > 0) {
            let j = this.next_int(i + 1);
            let a = list.get(i);
            let b = list.get(j);
            list.set(i, b);
            list.set(j, a);
            i = i - 1;
        }
    }
}
