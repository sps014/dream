module system;

// Standard input. Obtain via `System.stdin`.
public class Stdin {
    constructor() {}

    internal static fun instance(): Stdin {
        return Stdin();
    }

    /// Reads a line from standard input.
    public fun read_line(): string {
        return System.read_line();
    }

    /// Reads one character from standard input.
    public fun read_key(): char {
        return System.read_key();
    }
}

// Standard output. Obtain via `System.stdout`.
public class Stdout {
    constructor() {}

    internal static fun instance(): Stdout {
        return Stdout();
    }

    /// Writes text without adding a newline.
    public fun write_text(borrow text: string): void {
        System.print(text);
    }

    /// Writes text followed by a newline.
    public fun write_line(borrow text: string): void {
        System.println(text);
    }
}

// Standard error. Obtain via `System.stderr`.
public class Stderr {
    @runtime("consoleWriteStderr")
    static extern fun host_write(borrow text: string): void;

    constructor() {}

    internal static fun instance(): Stderr {
        return Stderr();
    }

    /// Writes text without adding a newline.
    public fun write_text(borrow text: string): void {
        Stderr.host_write(text);
    }

    /// Writes text followed by a newline.
    public fun write_line(borrow text: string): void {
        Stderr.host_write(text);
        Stderr.host_write("\n");
    }
}

extend System {
    /// Standard input stream.
    public static get stdin(): Stdin {
        return Stdin.instance();
    }

    /// Standard output stream.
    public static get stdout(): Stdout {
        return Stdout.instance();
    }

    /// Standard error stream.
    public static get stderr(): Stderr {
        return Stderr.instance();
    }
}
