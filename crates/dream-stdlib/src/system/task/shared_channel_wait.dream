module system.task;

internal class SharedChannelWait {
    registration: usize;

    internal constructor(endpoint: usize) {
        this.registration = SharedChannelWait.register_host(endpoint);
    }

    internal fun signal(): Future<int> {
        return SharedChannelWait.signal_host(this.registration);
    }

    internal fun close(): void {
        if this.registration != (usize)0 {
            SharedChannelWait.unregister_host(this.registration);
            this.registration = (usize)0;
        }
    }

    del() {
        this.close();
    }

    @intrinsic(Intrinsic.DreamChannelWait)
    static extern fun register_host(endpoint: usize): usize;

    @intrinsic(Intrinsic.DreamCancellationSignal)
    static extern fun signal_host(registration: usize): Future<int>;

    @intrinsic(Intrinsic.DreamCancellationUnregister)
    static extern fun unregister_host(registration: usize): void;
}
