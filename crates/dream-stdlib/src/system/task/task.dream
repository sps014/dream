module system.task;

/// Structured local async scopes and bounded maps, with explicit low-level worker spawning.
public class Task {
    /// Runs a structured async region and joins all children on success, failure, or cancellation.
    public static async fun scope<T, E>(
        body: fun(TaskScope<E>): Future<Result<T, TaskFailure<E>>>,
        timeout_ms: int = 0,
        token: Option<CancellationToken> = Option.None
    ): Result<T, TaskFailure<E>> {
        let effective_token = CancellationToken.resolve(token);
        if timeout_ms < 0 {
            let failure: TaskFailure<E> = TaskFailure.InvalidOperation;
            return Result.Err(failure);
        }
        let scope = TaskScope<E>();
        scope.protect();
        let parent: Option<Future<bool>> = Option.None;
        if effective_token.is_some() {
            if effective_token.unwrap().is_cancelled {
                let failure: TaskFailure<E> = TaskFailure.Cancelled;
                return Result.Err(failure);
            }
            let watcher = scope.follow(effective_token.unwrap());
            parent = Option.Some(watcher);
            Promise.start(watcher);
        }
        let timer: Option<Future<bool>> = Option.None;
        if timeout_ms > 0 {
            let watcher = scope.deadline(timeout_ms);
            timer = Option.Some(watcher);
            Promise.start(watcher);
        }
        let pending = body(scope);
        TaskScope<E>.attach_host(pending, scope.token);
        let result = pending.await;
        if result.is_err() {
            scope.cancel();
        }
        scope.drain().await;
        if parent.is_some() {
            Promise.cancel(parent.unwrap());
        }
        if timer.is_some() {
            Promise.cancel(timer.unwrap());
        }
        if scope.failure.is_some() {
            let error = scope.failure.unwrap();
            scope.failure = Option.None;
            return Result.Err(TaskFailure.Failed(error));
        }
        if scope.worker_failure.is_some() {
            let failure: TaskFailure<E> = TaskFailure.WorkerFailed(scope.worker_failure.unwrap());
            return Result.Err(failure);
        }
        if scope.timed_out {
            let failure: TaskFailure<E> = TaskFailure.TimedOut;
            return Result.Err(failure);
        }
        if result.is_err() {
            return result;
        }
        if scope.token.is_cancelled {
            let failure: TaskFailure<E> = TaskFailure.Cancelled;
            return Result.Err(failure);
        }
        return result;
    }

    @runtime("workerSpawn")
    internal static extern fun spawn_host(one_shot: bool): int;

    @intrinsic(Intrinsic.FuncboxFuncidx)
    internal static extern fun funcidx(borrow body: fun(string): string): int;

    @intrinsic(Intrinsic.FuncboxFuncidx)
    internal static extern fun funcidx_async(borrow body: fun(string): Future<string>): int;

    @intrinsic(Intrinsic.FuncboxEnv)
    internal static extern fun env(borrow body: fun(string): string): long;

    @intrinsic(Intrinsic.FuncboxEnv)
    internal static extern fun env_async(borrow body: fun(string): Future<string>): long;

    @async_host
    @runtime("workerDispatch")
    internal static extern async fun dispatch_host(
        id: int,
        funcidx: int,
        env: long,
        borrow msg: string
    ): string;

    @runtime("workerShutdown")
    static extern fun shutdown_host(id: int): void;

    @runtime("workerTerminate")
    static extern fun terminate_host(id: int): void;

    // Why the session's worker failed, or empty while it is healthy; cleared by terminate_host.
    @runtime("workerFailure")
    internal static extern fun failure_host(id: int): string;

    /// Runs one synchronous function on a separate worker; use scope.spawn_on for structured CPU jobs.
    /// Panics when the worker crashes before replying; `TaskPool.dispatch` and scope children
    /// report that as `TaskPoolError.WorkerCrashed` instead.
    public static async fun spawn<TOut: shared>(
        body: fun(): TOut,
        token: Option<CancellationToken> = Option.None
    ): TOut {
        CancellationToken.throw_if_opt(token);
        let session = Task.start<TOut>(body);
        let wire = session.receive().await;
        CancellationToken.throw_if_opt(token);
        session.panic_if_failed();
        let result = Bytes.from_wire<TOut>(wire);
        session.hold();
        return result;
    }

    internal static fun start<TOut: shared>(body: fun(): TOut): TaskSession {
        let wrapped: fun(string): string = (_raw: string) => Bytes.to_wire<TOut>(body());
        let id = Task.spawn_host(true);
        let session = TaskSession(id, wrapped);
        return session;
    }

    /// Runs an async function on a separate worker; local async scope children need no worker.
    /// Panics when the worker crashes before replying.
    public static async fun spawn_async<TOut: shared>(
        body: fun(): Future<TOut>,
        token: Option<CancellationToken> = Option.None
    ): TOut {
        CancellationToken.throw_if_opt(token);
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            return Bytes.to_wire<TOut>(body().await);
        };
        let id = Task.spawn_host(true);
        let session = TaskSession(id, wrapped);
        let wire = session.receive().await;
        CancellationToken.throw_if_opt(token);
        session.panic_if_failed();
        let result = Bytes.from_wire<TOut>(wire);
        session.hold();
        return result;
    }

    /// Maps with bounded local async concurrency and returns values in input order.
    public static async fun map<T, U, E>(
        items: T[],
        body: fun(T): Future<Result<U, E>>,
        concurrency: int,
        token: Option<CancellationToken> = Option.None
    ): Result<U[], TaskFailure<E>> {
        let effective_token = CancellationToken.resolve(token);
        if concurrency <= 0 {
            let error: TaskFailure<E> = TaskFailure.InvalidOperation;
            return Result.Err(error);
        }
        let state = TaskMapState<T, U, E>(items, body, true);
        return Task.scope<U[], E>(
            async (scope: TaskScope<E>) => TaskMapState<T, U, E>.scoped(scope, state, concurrency)
                .await,
            token: effective_token
        ).await;
    }

    /// Applies an async operation with bounded concurrency; successful child values are discarded.
    public static async fun for_each<T, U, E>(
        items: T[],
        body: fun(T): Future<Result<U, E>>,
        concurrency: int,
        token: Option<CancellationToken> = Option.None
    ): Result<Unit, TaskFailure<E>> {
        if concurrency <= 0 {
            let error: TaskFailure<E> = TaskFailure.InvalidOperation;
            return Result.Err(error);
        }
        let state = TaskMapState<T, U, E>(items, body, false);
        let results = Task.scope<U[], E>(
            async (scope: TaskScope<E>) => TaskMapState<T, U, E>.scoped(scope, state, concurrency)
                .await,
            token: token
        ).await;
        if results.is_err() {
            return Result.Err(results.unwrap_err());
        }
        return Result.Ok(Unit());
    }
}
