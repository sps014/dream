module system.task;

// Run a function on another thread. Await the result like any other Future.
//
//   async fun main(): void {
//       let square = Task.spawn(() => 6 * 6).await;
//       System.println(square.to_string());
//   }
//
// `spawn` is itself `async`, so awaiting it *is* the join. Hold the Future to overlap work.
// What a body may capture is covered in `docs/reference/language/tasks.md`.
public class Task {
    @runtime("workerSpawn")
    static extern fun spawn_host(funcidx: int, env: long): int;

    @intrinsic("funcbox_funcidx")
    public static extern fun funcidx(borrow body: fun(string): string): int;

    @intrinsic("funcbox_funcidx")
    public static extern fun funcidx_async(borrow body: fun(string): Future<string>): int;

    @intrinsic("funcbox_env")
    public static extern fun env(borrow body: fun(string): string): long;

    @intrinsic("funcbox_env")
    public static extern fun env_async(borrow body: fun(string): Future<string>): long;

    @runtime("workerPost")
    static extern fun post_host(id: int, borrow msg: string): void;

    @runtime("workerRecv")
    static extern async fun recv_host(id: int): string;

    @runtime("workerShutdown")
    static extern fun shutdown_host(id: int): void;

    @runtime("workerTerminate")
    static extern fun terminate_host(id: int): void;

    public static async fun spawn<TOut : shared>(body: fun(): TOut, token: Option<CancellationToken> = Option.None): TOut {
        CancellationToken.throw_if_opt(token);
        let wrapped: fun(string): string = (_raw: string) => Bytes.toWire<TOut>(body());
        let id = Task.spawn_host(Task.funcidx(wrapped), Task.env(wrapped));
        let session = TaskSession(id, wrapped);
        Task.post_host(id, "");
        let wire = Task.recv_host(id).await;
        CancellationToken.throw_if_opt(token);
        let result = Bytes.fromWire<TOut>(wire);
        session.hold();
        return result;
    }

    public static async fun spawn_async<TOut : shared>(body: fun(): Future<TOut>, token: Option<CancellationToken> = Option.None): TOut {
        CancellationToken.throw_if_opt(token);
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            return Bytes.toWire<TOut>(body().await);
        };
        let id = Task.spawn_host(Task.funcidx_async(wrapped), Task.env_async(wrapped));
        let session = TaskSession(id, wrapped);
        Task.post_host(id, "");
        let wire = Task.recv_host(id).await;
        CancellationToken.throw_if_opt(token);
        let result = Bytes.fromWire<TOut>(wire);
        session.hold();
        return result;
    }

    // Every item is posted before the first await: async bodies start lazily, so awaiting
    // per-item spawn futures in order would run the items one after another.
    public static async fun map<T : shared, TOut : shared>(borrow items: T[], body: fun(T): TOut, token: Option<CancellationToken> = Option.None): TOut[] {
        CancellationToken.throw_if_opt(token);
        let n = items.length;
        let wrapped: fun(string): string = (raw: string) => Bytes.toWire<TOut>(body(Bytes.fromWire<T>(raw)));
        let group = TaskGroup(n, wrapped);
        for (let i = 0; i < n; i = i + 1) {
            group.ids[i] = Task.spawn_host(Task.funcidx(wrapped), Task.env(wrapped));
            Task.post_host(group.ids[i], Bytes.toWire<T>(items[i]));
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            CancellationToken.throw_if_opt(token);
            results[i] = Bytes.fromWire<TOut>(Task.recv_host(group.ids[i]).await);
        }
        CancellationToken.throw_if_opt(token);
        group.hold();
        return results;
    }

    public static async fun map_async<T : shared, TOut : shared>(borrow items: T[], body: fun(T): Future<TOut>, token: Option<CancellationToken> = Option.None): TOut[] {
        CancellationToken.throw_if_opt(token);
        let n = items.length;
        let wrapped: fun(string): Future<string> = async (raw: string) => {
            return Bytes.toWire<TOut>(body(Bytes.fromWire<T>(raw)).await);
        };
        let group = TaskGroup(n, wrapped);
        for (let i = 0; i < n; i = i + 1) {
            group.ids[i] = Task.spawn_host(Task.funcidx_async(wrapped), Task.env_async(wrapped));
            Task.post_host(group.ids[i], Bytes.toWire<T>(items[i]));
        }
        let results = Buffer.alloc<TOut>(n);
        for (let i = 0; i < n; i = i + 1) {
            CancellationToken.throw_if_opt(token);
            results[i] = Bytes.fromWire<TOut>(Task.recv_host(group.ids[i]).await);
        }
        CancellationToken.throw_if_opt(token);
        group.hold();
        return results;
    }
}

// Owns the spawn-time funcbox and terminates the thread when dropped (after `.await` or Future cancel).
@allow_cycle
class TaskSession {
    id: int;
    sync_body: fun(string): string;
    async_body: fun(string): Future<string>;

    public constructor(id: int, sync_body: fun(string): string) {
        this.id = id;
        this.sync_body = sync_body;
    }

    public constructor(id: int, async_body: fun(string): Future<string>) {
        this.id = id;
        this.async_body = async_body;
    }

    del() {
        Task.terminate_host(this.id);
    }

    // After `recv_host(...).await`: last-use `del` (terminate) must not run in the pre-await poll block.
    public fun hold() {
        this.id = this.id;
    }
}

// `TaskSession` for a `Task.map` fan-out: one funcbox shared by every worker in `ids`.
@allow_cycle
class TaskGroup {
    public ids: int[];
    sync_body: fun(string): string;
    async_body: fun(string): Future<string>;

    public constructor(n: int, sync_body: fun(string): string) {
        this.ids = Buffer.alloc<int>(n);
        this.sync_body = sync_body;
    }

    public constructor(n: int, async_body: fun(string): Future<string>) {
        this.ids = Buffer.alloc<int>(n);
        this.async_body = async_body;
    }

    del() {
        for (let i = 0; i < this.ids.length; i = i + 1) {
            if this.ids[i] != 0 {
                Task.shutdown_host(this.ids[i]);
            }
        }
        for (let i = 0; i < this.ids.length; i = i + 1) {
            if this.ids[i] != 0 {
                Task.terminate_host(this.ids[i]);
            }
        }
    }

    public fun hold() {
        this.ids = this.ids;
    }
}
