module system.task;

/// Reuses a fixed number of parallel workers; local async tasks do not consume pool workers.
/// Each worker holds at most two jobs. Further dispatches wait in submission order and go to the
/// least-loaded worker once one finishes, so a long job holds up at most one job behind it.
@allow_cycle
public class TaskPool {
    ids: int[];
    // Jobs running on each worker; a worker below 1 is free.
    loads: int[];
    // Slots handed to dispatches, at most two per worker.
    occupied: int;
    // Dispatches waiting for a worker, oldest first; cancelling a source grants it the worker.
    internal waiters: List<CancellationSource>;
    active: int;
    closing: bool;
    changed: CancellationSource;

    /// Creates a fixed worker set; nonpositive sizes produce InvalidSize on operations.
    public constructor(size: int) {
        let count = size;
        if count < 0 {
            count = 0;
        }
        this.ids = Buffer.alloc<int>(count);
        this.loads = Buffer.alloc<int>(count);
        for (let i = 0; i < count; i = i + 1) {
            this.ids[i] = Task.spawn_host(false);
        }
        this.occupied = 0;
        this.waiters = List<CancellationSource>();
        this.active = 0;
        this.closing = false;
        this.changed = CancellationSource();
    }

    /// Number of reusable parallel workers in this pool.
    public get size(): int {
        return this.ids.length;
    }

    /// Dispatches a CPU job; capture and return values follow the shared/move worker rules.
    public fun dispatch<TOut: shared>(
        body: fun(): TOut,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<TOut, TaskPoolError>> {
        return TaskPool.dispatch_owned<TOut>(this, body, CancellationToken.resolve(token));
    }

    static async fun dispatch_owned<TOut: shared>(
        pool: TaskPool,
        body: fun(): TOut,
        token: Option<CancellationToken>
    ): Result<TOut, TaskPoolError> {
        if pool.ids.length == 0 {
            return Result.Err(TaskPoolError.InvalidSize);
        }
        if pool.closing {
            return Result.Err(TaskPoolError.Closed);
        }
        if CancellationToken.is_cancelled_opt(token) {
            return Result.Err(TaskPoolError.Cancelled);
        }
        let guard = CancellationSource();
        TaskPool.protect_host(guard);
        let wrapped: fun(string): string = (_raw: string) => Bytes.to_wire<TOut>(body());
        pool.begin();
        let worker = pool.try_acquire();
        if worker < 0 {
            worker = TaskPool.wait_worker(pool).await;
        }
        if guard.is_cancelled || CancellationToken.is_cancelled_opt(token) {
            pool.finish(worker);
            return Result.Err(TaskPoolError.Cancelled);
        }
        let wire = Task.dispatch_host(
            pool.ids[worker],
            Task.funcidx(wrapped),
            Task.env(wrapped),
            ""
        ).await;
        TaskPool.keep_alive(wrapped);
        pool.finish(worker);
        if guard.is_cancelled || CancellationToken.is_cancelled_opt(token) {
            return Result.Err(TaskPoolError.Cancelled);
        }
        return Result.Ok(Bytes.from_wire<TOut>(wire));
    }

    /// Dispatches an async job on a pool worker and waits for its operation to settle.
    public fun dispatch_async<TOut: shared>(
        body: fun(): Future<TOut>,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<TOut, TaskPoolError>> {
        return TaskPool.dispatch_async_owned<TOut>(this, body, CancellationToken.resolve(token));
    }

    static async fun dispatch_async_owned<TOut: shared>(
        pool: TaskPool,
        body: fun(): Future<TOut>,
        token: Option<CancellationToken>
    ): Result<TOut, TaskPoolError> {
        if pool.ids.length == 0 {
            return Result.Err(TaskPoolError.InvalidSize);
        }
        if pool.closing {
            return Result.Err(TaskPoolError.Closed);
        }
        if CancellationToken.is_cancelled_opt(token) {
            return Result.Err(TaskPoolError.Cancelled);
        }
        let guard = CancellationSource();
        TaskPool.protect_host(guard);
        let completion_token = token;
        let wrapped: fun(string): Future<string> = async (_raw: string) => {
            let pending = body();
            if token.is_some() {
                TaskPool.attach_host(pending, token.unwrap());
            }
            return Bytes.to_wire<TOut>(pending.await);
        };
        pool.begin();
        let worker = pool.try_acquire();
        if worker < 0 {
            worker = TaskPool.wait_worker(pool).await;
        }
        if guard.is_cancelled || CancellationToken.is_cancelled_opt(completion_token) {
            pool.finish(worker);
            return Result.Err(TaskPoolError.Cancelled);
        }
        let wire = Task.dispatch_host(
            pool.ids[worker],
            Task.funcidx_async(wrapped),
            Task.env_async(wrapped),
            ""
        ).await;
        TaskPool.keep_alive(wrapped);
        pool.finish(worker);
        if guard.is_cancelled || CancellationToken.is_cancelled_opt(completion_token) {
            return Result.Err(TaskPoolError.Cancelled);
        }
        return Result.Ok(Bytes.from_wire<TOut>(wire));
    }

    fun begin(): void {
        if this.active == 0 {
            this.changed = CancellationSource();
        }
        this.active = this.active + 1;
    }

    // Claims the least-loaded worker, or returns -1 when every slot is taken or others wait. Two
    // slots per worker keep its next job queued while the owner learns the last one finished.
    fun try_acquire(): int {
        if this.occupied >= this.ids.length * 2 || !this.waiters.is_empty() {
            return -1;
        }
        this.occupied = this.occupied + 1;
        return this.claim();
    }

    // Waits in submission order for a slot handed over by `release_slot`.
    static async fun wait_worker(pool: TaskPool): int {
        let ticket = TaskPoolTicket(pool);
        pool.waiters.push(ticket.ready);
        ticket.ready.token.wait_cancelled().await;
        ticket.used = true;
        return pool.claim();
    }

    fun claim(): int {
        let worker = 0;
        for (let i = 1; i < this.loads.length; i = i + 1) {
            if this.loads[i] < this.loads[worker] {
                worker = i;
            }
        }
        this.loads[worker] = this.loads[worker] + 1;
        return worker;
    }

    fun finish(worker: int): void {
        this.loads[worker] = this.loads[worker] - 1;
        this.release_slot();
        this.active = this.active - 1;
        if this.active == 0 {
            this.changed.cancel();
        }
    }

    // Hands a released worker to the oldest waiter, or returns it to the pool.
    internal fun release_slot(): void {
        if this.waiters.is_empty() {
            this.occupied = this.occupied - 1;
            return;
        }
        let next = this.waiters[0];
        this.waiters.remove_at(0);
        next.cancel();
    }

    /// Maps CPU work with at most size active dispatches and preserves input order.
    public fun map<T: shared, U: shared>(
        items: T[],
        body: fun(T): U,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<U[], TaskFailure<TaskPoolError>>> {
        return TaskPool.map_owned<T, U>(this, items, body, CancellationToken.resolve(token));
    }

    static async fun map_owned<T: shared, U: shared>(
        pool: TaskPool,
        items: T[],
        body: fun(T): U,
        token: Option<CancellationToken>
    ): Result<U[], TaskFailure<TaskPoolError>> {
        let concurrency = pool.size;
        let parent_token = token;
        return Task.map<T, U, TaskPoolError>(
            items,
            async (item: T) => pool.dispatch<U>(() => body(item), token).await,
            concurrency,
            parent_token
        ).await;
    }

    /// Maps async worker jobs with bounded dispatch rather than creating one worker per input.
    public fun map_async<T: shared, U: shared>(
        items: T[],
        body: fun(T): Future<U>,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<U[], TaskFailure<TaskPoolError>>> {
        return TaskPool.map_async_owned<T, U>(this, items, body, CancellationToken.resolve(token));
    }

    static async fun map_async_owned<T: shared, U: shared>(
        pool: TaskPool,
        items: T[],
        body: fun(T): Future<U>,
        token: Option<CancellationToken>
    ): Result<U[], TaskFailure<TaskPoolError>> {
        let concurrency = pool.size;
        let parent_token = token;
        return Task.map<T, U, TaskPoolError>(
            items,
            async (item: T) => pool.dispatch_async<U>(async () => body(item).await, token).await,
            concurrency,
            parent_token
        ).await;
    }

    /// Stops accepting work, waits for submitted jobs, then closes workers idempotently.
    public fun close(): Future<Result<Unit, TaskPoolError>> {
        return TaskPool.close_owned(this);
    }

    static async fun close_owned(pool: TaskPool): Result<Unit, TaskPoolError> {
        let shield = CancellationSource();
        TaskPool.protect_host(shield);
        pool.closing = true;
        while pool.active > 0 {
            pool.changed.token.wait_cancelled().await;
        }
        pool.terminate();
        return Result.Ok(Unit());
    }

    fun terminate(): void {
        for (let i = 0; i < this.ids.length; i = i + 1) {
            if this.ids[i] != 0 {
                Task.terminate_host(this.ids[i]);
                this.ids[i] = 0;
            }
        }
    }

    del() {
        this.terminate();
    }

    @intrinsic(Intrinsic.DreamTaskAttach)
    static extern fun attach_host(borrow pending: object, borrow token: CancellationToken): void;

    @intrinsic(Intrinsic.DreamTaskKeepAlive)
    static extern fun keep_alive(borrow callback: object): void;

    @intrinsic(Intrinsic.DreamTaskProtect)
    static extern fun protect_host(borrow source: CancellationSource): void;
}
