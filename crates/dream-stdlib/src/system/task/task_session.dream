module system.task;

// Owns the spawn-time funcbox and terminates the thread when dropped (after `.await` or Future cancel).
@allow_cycle
internal class TaskSession {
    id: int;
    funcidx: int;
    env: long;
    sync_body: fun(string): string;
    async_body: fun(string): Future<string>;

    public constructor(id: int, sync_body: fun(string): string) {
        this.id = id;
        this.sync_body = sync_body;
        this.funcidx = Task.funcidx(this.sync_body);
        this.env = Task.env(this.sync_body);
    }

    public constructor(id: int, async_body: fun(string): Future<string>) {
        this.id = id;
        this.async_body = async_body;
        this.funcidx = Task.funcidx_async(this.async_body);
        this.env = Task.env_async(this.async_body);
    }

    internal fun receive(): Future<string> {
        return Task.dispatch_host(this.id, this.funcidx, this.env, "");
    }

    // Valid after `receive` settles and before the session drops, which clears the record.
    internal fun crashed(): bool {
        return Task.failure_host(this.id).length > 0;
    }

    internal fun panic_if_failed(): void {
        let failure = Task.failure_host(this.id);
        if failure.length > 0 {
            System.panic("Task worker crashed before replying: " + failure);
        }
    }

    del() {
        Task.terminate_host(this.id);
    }

    // After the host reply: last-use `del` (terminate) must not run in the pre-await poll block.
    public fun hold() {
        this.id = this.id;
    }
}
