module system.task;

// Scope watchers own their awaited helpers, which must be cancelled when the watcher drops.
internal class TaskWaitGuard<T> {
    pending: Future<T>;

    internal constructor(pending: Future<T>) {
        this.pending = pending;
    }

    internal fun close(): void {
        Promise.cancel(this.pending);
    }

    del() {
        this.close();
    }
}
