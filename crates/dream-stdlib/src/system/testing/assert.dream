module system.testing;

// Assertion helpers for `system.testing`. On failure, prints a message and exits the process with
// a non-zero status (no exceptions/panics — assertions are meant to run in ordinary scripts).
public class Assert {
    // Fails the current test run with `message`: prints it and terminates the process with a
    // non-zero exit code. There is no exception mechanism to unwind through, so `Assert.*`
    // failures are unrecoverable by design (matching `System.panic`).
    public static fun fail(message: string): void {
        System.println("FAIL " + message);
        System.exit(1);
    }

    // Asserts that `actual == expected`.
    public static fun eq<T>(actual: T, expected: T): void {
        if (actual == expected) {
            return;
        }
        Assert.fail("assert_eq failed: " + actual + " != " + expected);
    }

    // Asserts that `actual != expected`.
    public static fun ne<T>(actual: T, expected: T): void {
        if (actual != expected) {
            return;
        }
        Assert.fail("assert_ne failed: " + actual + " == " + expected);
    }

    // Asserts that `value` is `true`.
    public static fun is_true(value: bool): void {
        if (value == true) {
            return;
        }
        Assert.fail("assert_true failed");
    }

    // Asserts that `value` is `false`.
    public static fun is_false(value: bool): void {
        if (value == false) {
            return;
        }
        Assert.fail("assert_false failed");
    }

    // Asserts that two doubles are within `epsilon` of each other.
    public static fun approx(actual: double, expected: double, epsilon: double): void {
        let diff = actual - expected;
        if (diff < 0.0d) {
            diff = 0.0d - diff;
        }
        if (diff <= epsilon) {
            return;
        }
        Assert.fail("assert_approx failed: " + actual + " !~ " + expected + " (epsilon " + epsilon + ")");
    }

    // Asserts that two strings have identical contents.
    public static fun eq_str(actual: string, expected: string): void {
        if (actual == expected) {
            return;
        }
        Assert.fail("assert_eq_str failed: expected \"" + expected + "\" but got \"" + actual + "\"");
    }
}
