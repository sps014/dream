module system.testing;

// The runner `dream test` synthesizes calls one of these per `@test` function. Each case prints
// `RUN <name>` before its body and `PASS <name>` after it. An `Assert.*` failure, a panic or a
// trap ends the process, so the last `RUN` line names the case that was running.
public static class Test {
    public static fun run(name: string, body: fun(): void): void {
        System.println("RUN " + name);
        Test.measure(name, body);
    }

    // The driver reads the limit back from the `RUN` line and stops a case that exceeds it.
    public static fun run_with_timeout(name: string, timeout_ms: int, body: fun(): void): void {
        System.println("RUN " + name + " timeout=" + timeout_ms);
        Test.measure(name, body);
    }

    // A positive live-object delta only points at a suspect: lazily initialized globals and
    // deferred cleanup move the counter too. The exit-time leak report is the pass/fail gate.
    static fun measure(name: string, body: fun(): void): void {
        let before = Debug.live_objects;
        body();
        let after = Debug.live_objects;
        if after > before {
            System.println("LEAK " + name + " live=+" + (after - before));
        }
        System.println("PASS " + name);
    }
}
