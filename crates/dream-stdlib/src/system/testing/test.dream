module system.testing;

// Minimal test runner: prints PASS/FAIL per named case, everything else is `Assert.*`.
public class Test {
    // Runs `body`, printing `PASS <name>` on success. Assertion failures inside `body` already
    // print their own message and exit the process (see `Assert.fail`), so a case reaching the
    // print below never failed.
    public static fun run(name: string, body: fun(): void): void {
        body();
        System.println("PASS " + name);
    }
}
