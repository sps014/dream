module system.text;

// `.NET`/Python-style positional string formatting: `{0}`, `{1}`, ... substitute `args[i]` (via
// `to_string`), and `{i:.N}` additionally renders a `double`/`float` argument with exactly `N`
// fixed decimal digits. `{{` / `}}` escape literal braces.
public class Fmt {
    // Substitutes every `{i}`/`{i:spec}` placeholder in `pattern` with `args[i]`.
    public static fun format(pattern: string, args: object[]): string {
        let sb = StringBuilder(pattern.length);
        let n = pattern.length;
        let i = 0;
        while (i < n) {
            let c = pattern.char_at(i);
            if (c == '{') {
                if ((i + 1 < n) && (pattern.char_at(i + 1) == '{')) {
                    sb.append_char('{');
                    i = i + 2;
                } else {
                    let close = Fmt._find_close(pattern, i);
                    if (close < 0) {
                        sb.append_char('{');
                        i = i + 1;
                    } else {
                        let inner = pattern.substring(i + 1, close);
                        sb.append(Fmt._render(inner, args));
                        i = close + 1;
                    }
                }
            } else if (c == '}') {
                if ((i + 1 < n) && (pattern.char_at(i + 1) == '}')) {
                    sb.append_char('}');
                    i = i + 2;
                } else {
                    sb.append_char('}');
                    i = i + 1;
                }
            } else {
                sb.append_char(c);
                i = i + 1;
            }
        }
        return sb.build();
    }

    // Index of the `}` closing the placeholder that opened at `open` (pointing at `{`), or -1.
    static fun _find_close(pattern: string, open: int): int {
        let n = pattern.length;
        let j = open + 1;
        while (j < n) {
            if (pattern.char_at(j) == '}') {
                return j;
            }
            j = j + 1;
        }
        return 0 - 1;
    }

    // Renders one placeholder's inner text (`"0"` or `"0:.2"`) against `args`.
    static fun _render(inner: string, args: object[]): string {
        let colon = inner.index_of(':');
        let index_text = inner;
        let spec = "";
        if (colon.is_some()) {
            let at = colon.unwrap_or(0);
            index_text = inner.substring(0, at);
            spec = inner.substring(at + 1, inner.length);
        }
        let parsed = int.parse(index_text);
        if (parsed.is_err()) {
            return "{" + inner + "}";
        }
        let idx = parsed.unwrap_or(0);
        if ((idx < 0) || (idx >= args.length)) {
            return "{" + inner + "}";
        }
        return Fmt._render_value(args[idx], spec);
    }

    // Renders a single argument, honoring a `.N` fixed-decimal spec for float/double.
    static fun _render_value(value: object, spec: string): string {
        if (spec.is_empty() == false) {
            let digits = Fmt._parse_precision(spec);
            if (digits >= 0) {
                if (value is double d) {
                    return Fmt._format_fixed(d, digits);
                }
                if (value is float f) {
                    return Fmt._format_fixed((double)f, digits);
                }
            }
        }
        return "" + value;
    }

    // Parses a `.N` precision spec, returning `N`, or `-1` when `spec` doesn't match that shape.
    static fun _parse_precision(spec: string): int {
        if (spec.is_empty() || (spec.char_at(0) != '.')) {
            return 0 - 1;
        }
        let digits_text = spec.substring(1, spec.length);
        let parsed = int.parse(digits_text);
        return parsed.unwrap_or(0 - 1);
    }

    // Renders `value` with exactly `digits` fixed decimal places.
    static fun _format_fixed(value: double, digits: int): string {
        let neg = value < 0.0d;
        let v = value;
        if (neg) {
            v = 0.0d - v;
        }
        let scale = 1.0d;
        let k = 0;
        while (k < digits) {
            scale = scale * 10.0d;
            k = k + 1;
        }
        let scaled = Math.round(v * scale);
        let whole = (int)(scaled / scale);
        let frac = (int)(scaled - (double)whole * scale);
        if (frac < 0) {
            frac = 0 - frac;
        }
        let sb = StringBuilder();
        if (neg) {
            sb.append_char('-');
        }
        sb.append("" + whole);
        if (digits > 0) {
            sb.append_char('.');
            let frac_text = "" + frac;
            let pad = digits - frac_text.length;
            while (pad > 0) {
                sb.append_char('0');
                pad = pad - 1;
            }
            sb.append(frac_text);
        }
        return sb.build();
    }
}
