module system.text;

// Compiled regular expressions. Native C uses PCRE2-16 JIT; WASM uses the in-module
// PCRE2-compatible engine. Invalid patterns compile to a dead engine that never matches.

@intrinsic("regex_compile")
static extern fun regex_compile(pattern: string, flags: RegexFlags): long;
@intrinsic("regex_free")
static extern fun regex_free(h: long): void;
@intrinsic("regex_find")
static extern fun regex_find(h: long, input: string, pos: int): int[];
@intrinsic("regex_group_count")
static extern fun regex_group_count(h: long): int;
@intrinsic("regex_name_count")
static extern fun regex_name_count(h: long): int;
@intrinsic("regex_name_at")
static extern fun regex_name_at(h: long, i: int): string;
@intrinsic("regex_name_number")
static extern fun regex_name_number(h: long, i: int): int;

public class Regex {
    engine: long;
    global: bool;
    ngroup: int;
    group_names: string[];
    group_name_numbers: int[];

    public constructor(pattern: string, flags: RegexFlags = 0) {
        this.global = flags.has(RegexFlags.Global);
        this.engine = regex_compile(pattern, flags);
        this.ngroup = regex_group_count(this.engine);
        let nc = regex_name_count(this.engine);
        this.group_names = Buffer.alloc<string>(nc);
        this.group_name_numbers = Buffer.alloc<int>(nc);
        let i = 0;
        while i < nc {
            this.group_names[i] = regex_name_at(this.engine, i);
            this.group_name_numbers[i] = regex_name_number(this.engine, i);
            i = i + 1;
        }
    }

    del() {
        regex_free(this.engine);
        this.engine = 0;
    }

    fun find_at(input: string, pos: int): Option<RegexMatch> {
        let g = regex_find(this.engine, input, pos);
        if g.length == 0 {
            return Option.None;
        }
        return Option.Some(RegexMatch(g, this.ngroup));
    }

    public fun test(input: string): bool {
        return this.find_at(input, 0).is_some();
    }

    public fun replace(input: string, replacement: string): string {
        let n = input.length;
        let sb = StringBuilder();
        let pos = 0;
        let going = true;
        while going {
            if pos > n {
                going = false;
            } else {
                let m_opt = this.find_at(input, pos);
                switch (m_opt) {
                    Some(m) => {
                        let s = m.start();
                        let e = m.end();
                        if s > pos {
                            sb.append_utf8_slice(input, pos * 2, (s - pos) * 2);
                        }
                        this.write_replacement(sb, replacement, input, m);
                        if e > s {
                            pos = e;
                        } else {
                            if s < n {
                                sb.append_char(input.char_at(s));
                                pos = s + 1;
                            } else {
                                pos = n + 1;
                            }
                        }
                        if this.global == false {
                            going = false;
                        }
                    },
                    None => {
                        going = false;
                    },
                }
            }
        }
        if pos < n {
            sb.append_utf8_slice(input, pos * 2, (n - pos) * 2);
        } else if (pos == n) {
            // keep tail empty
        }
        return sb.build();
    }

    fun write_replacement(sb: StringBuilder, replacement: string, input: string, m: RegexMatch): void {
        let i = 0;
        let rn = replacement.length;
        while i < rn {
            let c = replacement.char_at(i);
            if (c == '$') && (i + 1 < rn) {
                let next = replacement.char_at(i + 1);
                if next == '$' {
                    sb.append_char('$');
                    i = i + 2;
                } else if (next == '&') {
                    sb.append(m.group_text(input, 0));
                    i = i + 2;
                } else if (next == '{') {
                    let j = i + 2;
                    let token = StringBuilder();
                    while (j < rn) && (replacement.char_at(j) != '}') {
                        token.append_char(replacement.char_at(j));
                        j = j + 1;
                    }
                    if j < rn {
                        j = j + 1;
                    }
                    sb.append(this.resolve_braced_token(token.build(), input, m));
                    i = j;
                } else if (next.is_digit()) {
                    let zero = '0';
                    let g = next.to_int() - zero.to_int();
                    sb.append(m.group_text(input, g));
                    i = i + 2;
                } else {
                    sb.append_char(c);
                    i = i + 1;
                }
            } else {
                sb.append_char(c);
                i = i + 1;
            }
        }
    }

    fun resolve_braced_token(token: string, input: string, m: RegexMatch): string {
        if token.length == 0 {
            return "";
        }
        let all_digits = true;
        let v = 0;
        let i = 0;
        while i < token.length {
            let ch = token.char_at(i);
            if ch.is_digit() == false {
                all_digits = false;
            } else {
                v = v * 10 + (ch.to_int() - '0'.to_int());
            }
            i = i + 1;
        }
        if all_digits {
            return m.group_text(input, v);
        }
        i = 0;
        while i < this.group_names.length {
            if this.group_names[i] == token {
                return m.group_text(input, this.group_name_numbers[i]);
            }
            i = i + 1;
        }
        return "";
    }

    public fun match(input: string): string[] {
        let n = input.length;
        if this.global {
            let scratch = List<string>(8);
            let pos = 0;
            let going = true;
            while going {
                if pos > n {
                    going = false;
                } else {
                    let m_opt = this.find_at(input, pos);
                    switch (m_opt) {
                        Some(m) => {
                            scratch.push(m.group_text(input, 0));
                            let s = m.start();
                            let e = m.end();
                            if e > s {
                                pos = e;
                            } else {
                                pos = s + 1;
                            }
                        },
                        None => {
                            going = false;
                        },
                    }
                }
            }
            return this.to_array(scratch);
        }
        let m_opt = this.find_at(input, 0);
        return switch (m_opt) {
            Some(m) => this.groups_array(input, m),
            None => Buffer.alloc<string>(0),
        };
    }

    public fun match_info(input: string): Option<RegexMatchInfo> {
        let m_opt = this.find_at(input, 0);
        return switch (m_opt) {
            Some(m) => Option.Some(this.build_match_info(input, m)),
            None => Option.None,
        };
    }

    fun build_match_info(input: string, m: RegexMatch): RegexMatchInfo {
        let full = m.group_text(input, 0);
        let groups = Buffer.alloc<string>(this.ngroup);
        let i = 0;
        while i < this.ngroup {
            groups[i] = m.group_text(input, i + 1);
            i = i + 1;
        }
        return RegexMatchInfo(full, groups, this.group_names, this.group_name_numbers);
    }

    fun groups_array(input: string, m: RegexMatch): string[] {
        let count = this.ngroup + 1;
        let arr = Buffer.alloc<string>(count);
        let i = 0;
        while i < count {
            arr[i] = m.group_text(input, i);
            i = i + 1;
        }
        return arr;
    }

    fun to_array(list: List<string>): string[] {
        let arr = Buffer.alloc<string>(list.length);
        let i = 0;
        while i < list.length {
            arr[i] = list.get(i);
            i = i + 1;
        }
        return arr;
    }
}
