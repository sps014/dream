module system.text;

// Regular expressions — a self-contained engine, no host runtime involved. `Regex(pattern, flags)`
// parses and compiles the pattern once into a flat instruction program (see `regex_parser.dream`
// and `regex_compiler.dream`). Patterns without a backreference run on Dream's own Pike-VM
// (`regex_vm.dream`), which also evaluates lookaround assertions via compiled sub-programs
// (`regex_sub_table.dream`); a pattern containing a backreference (`\1`, `\k<name>`) instead runs
// the *same* compiled program on the backtracking interpreter (`regex_backtracker.dream`), since
// a backreference isn't a regular-language construct the Pike-VM's thread simulation can express.
// See docs/stdlib/regex.md for the supported syntax.
public class Regex {
    pattern: string;
    prog: RegexInst[];
    table: RegexSubTable;
    ngroup: int;
    ignore_case: bool;
    multiline: bool;
    dot_all: bool;
    global: bool;
    use_backtrack: bool;
    group_names: string[];
    group_name_numbers: int[];
    pike: RegexVM;
    back: RegexBacktrackVM;
    // True when the pattern is a simple unanchored ASCII digit run (`\d+` / `[0-9]+`).
    // Speeds that pattern only — microbench `regex_find` must not use bare `\d+`.
    ascii_digit_plus: bool;
    match_scratch: List<string>;

    public constructor(pattern: string, flags: RegexFlags = 0) {
        this.pattern = pattern;
        this.ignore_case = flags.has(RegexFlags.IgnoreCase);
        this.multiline = flags.has(RegexFlags.Multiline);
        this.dot_all = flags.has(RegexFlags.DotAll);
        this.global = flags.has(RegexFlags.Global);

        let parser = RegexParser(this.pattern);
        let ast = parser.parse();
        this.ngroup = parser.groups();
        this.use_backtrack = parser.backreferenced();
        this.group_names = this.to_string_array(parser.names());
        this.group_name_numbers = this.to_int_array(parser.name_indices());

        this.table = RegexSubTable();
        let compiler = RegexCompiler(this.ignore_case, this.dot_all, this.table);
        this.prog = compiler.compile(ast);
        this.pike = RegexVM(this.prog, this.ngroup, this.multiline, this.table);
        this.back = RegexBacktrackVM(this.prog, this.ngroup, this.multiline, this.table);
        this.ascii_digit_plus = (this.use_backtrack == false)
            && (this.ignore_case == false)
            && (this.ngroup == 0)
            && this.pike.is_ascii_digit_plus();
        this.match_scratch = List<string>(8);
    }

    // Finds the next match starting at or after `pos`, dispatching to whichever engine this
    // pattern requires. Lookaround still allocates a nested VM so it cannot clobber these queues.
    fun find_at(input: string, pos: int): Option<RegexMatch> {
        if (this.use_backtrack) {
            return this.back.find(input, pos);
        }
        return this.pike.find(input, pos);
    }

    // True if `input` contains a match for this pattern.
    public fun test(input: string): bool {
        return this.find_at(input, 0).is_some();
    }

    // Returns `input` with every match replaced by `replacement` (`g` flag: every match; without
    // it, only the first). `replacement` may reference capture groups with `$1`..`$9`, `${N}`, or
    // `${name}` for a named group, the whole match with `$&`; `$$` is a literal `$`.
    public fun replace(input: string, replacement: string): string {
        let n = input.length;
        let sb = StringBuilder();
        let pos = 0;
        let going = true;
        while (going) {
            if (pos > n) {
                going = false;
            } else {
                let m_opt = this.find_at(input, pos);
                switch (m_opt) {
                    Some(m) => {
                        let s = m.start();
                        let e = m.end();
                        sb.append(input.substring(pos, s));
                        this.append_replacement(sb, replacement, input, m);
                        if (e > s) {
                            pos = e;
                        } else {
                            if (s < n) {
                                sb.append(input.substring(s, s + 1));
                            }
                            pos = s + 1;
                        }
                        if (this.global == false) {
                            going = false;
                        }
                    },
                    None => {
                        going = false;
                    },
                }
            }
        }
        sb.append(input.substring(pos, n));
        return sb.build();
    }

    fun is_all_digits(s: string): bool {
        if (s.length == 0) {
            return false;
        }
        let i = 0;
        while (i < s.length) {
            if (s.char_at(i).is_digit() == false) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fun parse_int(s: string): int {
        let value = 0;
        let zero = '0';
        let i = 0;
        while (i < s.length) {
            value = (value * 10) + (s.char_at(i).to_int() - zero.to_int());
            i = i + 1;
        }
        return value;
    }

    // Resolves the group number for a named group, or -1 if `name` isn't one of this pattern's
    // named groups.
    fun name_to_group(name: string): int {
        let i = 0;
        while (i < this.group_names.length) {
            if (this.group_names[i] == name) {
                return this.group_name_numbers[i];
            }
            i = i + 1;
        }
        return 0 - 1;
    }

    // `${...}`: either digits (a numeric group) or a name registered via `(?<name>...)`.
    fun resolve_braced_token(token: string, input: string, m: RegexMatch): string {
        if (this.is_all_digits(token)) {
            return m.group_text(input, this.parse_int(token));
        }
        let g = this.name_to_group(token);
        if (g >= 0) {
            return m.group_text(input, g);
        }
        return string.empty; // unknown name: best-effort, no crash
    }

    fun append_replacement(sb: StringBuilder, replacement: string, input: string, m: RegexMatch): void {
        let rn = replacement.length;
        let i = 0;
        while (i < rn) {
            let c = replacement.char_at(i);
            if ((c == '$') && (i + 1 < rn)) {
                let next = replacement.char_at(i + 1);
                if (next == '$') {
                    sb.append_char('$');
                    i = i + 2;
                } else if (next == '&') {
                    sb.append(m.group_text(input, 0));
                    i = i + 2;
                } else if (next == '{') {
                    let j = i + 2;
                    let token = StringBuilder();
                    while ((j < rn) && (replacement.char_at(j) != '}')) {
                        token.append_char(replacement.char_at(j));
                        j = j + 1;
                    }
                    if (j < rn) {
                        j = j + 1; // consume '}'
                    }
                    sb.append(this.resolve_braced_token(token.build(), input, m));
                    i = j;
                } else if (next.is_digit()) {
                    let zero = '0';
                    let g = next.to_int() - zero.to_int();
                    sb.append(m.group_text(input, g));
                    i = i + 2;
                } else {
                    sb.append_char(c);
                    i = i + 1;
                }
            } else {
                sb.append_char(c);
                i = i + 1;
            }
        }
    }

    // Returns the matches in `input` as an array: every full match with the `g` flag, otherwise
    // the first match's full text followed by each capture group (a group that didn't
    // participate is "").
    public fun match(input: string): string[] {
        if (this.global && this.ascii_digit_plus) {
            return this.match_ascii_digit_runs(input);
        }
        let n = input.length;
        if (this.global) {
            this.match_scratch.clear();
            let pos = 0;
            let going = true;
            while (going) {
                if (pos > n) {
                    going = false;
                } else {
                    let m_opt = this.find_at(input, pos);
                    switch (m_opt) {
                        Some(m) => {
                            this.match_scratch.push(m.group_text(input, 0));
                            let s = m.start();
                            let e = m.end();
                            if (e > s) {
                                pos = e;
                            } else {
                                pos = s + 1;
                            }
                        },
                        None => {
                            going = false;
                        },
                    }
                }
            }
            return this.to_array(this.match_scratch);
        }
        let m_opt = this.find_at(input, 0);
        return switch (m_opt) {
            Some(m) => this.groups_array(input, m),
            None => Buffer.alloc<string>(0),
        };
    }

    // Linear ASCII digit-run finder for `\d+` / `[0-9]+` (Global). Haystacks may be general
    // UTF-8; digit runs are ASCII so byte offsets equal scalar offsets inside each run.
    fun match_ascii_digit_runs(input: string): string[] {
        let results = List<string>(8);
        let n = input.byte_size();
        let i = 0;
        while (i < n) {
            let b = input.byte_at(i);
            if ((b >= 48) && (b <= 57)) {
                let start = i;
                i = i + 1;
                while (i < n) {
                    let c = input.byte_at(i);
                    if ((c < 48) || (c > 57)) {
                        // end run
                        break;
                    }
                    i = i + 1;
                }
                // ASCII digit bytes are one scalar each — byte index == scalar index.
                results.push(input.substring(start, i));
            } else {
                // Advance one UTF-8 scalar so multi-byte chars aren't mis-scanned mid-sequence.
                let w = string.utf8_width_at(input, i);
                if (w < 1) {
                    w = 1;
                }
                i = i + w;
            }
        }
        return this.to_array(results);
    }

    // Richer match info for the first match in `input`: the full match, every capture group's
    // text (`groups[0]` is group 1), and `.named(name)` lookup for `(?<name>...)` groups. `None`
    // if the pattern doesn't match anywhere in `input`.
    public fun match_info(input: string): Option<RegexMatchInfo> {
        let m_opt = this.find_at(input, 0);
        return switch (m_opt) {
            Some(m) => Option.Some(this.build_match_info(input, m)),
            None => Option.None,
        };
    }

    fun build_match_info(input: string, m: RegexMatch): RegexMatchInfo {
        let full = m.group_text(input, 0);
        let groups = Buffer.alloc<string>(this.ngroup);
        let i = 0;
        while (i < this.ngroup) {
            groups[i] = m.group_text(input, i + 1);
            i = i + 1;
        }
        return RegexMatchInfo(full, groups, this.group_names, this.group_name_numbers);
    }

    fun groups_array(input: string, m: RegexMatch): string[] {
        let count = this.ngroup + 1;
        let arr = Buffer.alloc<string>(count);
        let i = 0;
        while (i < count) {
            arr[i] = m.group_text(input, i);
            i = i + 1;
        }
        return arr;
    }

    fun to_array(list: List<string>): string[] {
        let arr = Buffer.alloc<string>(list.length);
        let i = 0;
        while (i < list.length) {
            arr[i] = list.get(i).unwrap_or(string.empty);
            i = i + 1;
        }
        return arr;
    }

    fun to_string_array(list: List<string>): string[] {
        let arr = Buffer.alloc<string>(list.length);
        let i = 0;
        while (i < list.length) {
            arr[i] = list.get(i).unwrap_or(string.empty);
            i = i + 1;
        }
        return arr;
    }

    fun to_int_array(list: List<int>): int[] {
        let arr = Buffer.alloc<int>(list.length);
        let i = 0;
        while (i < list.length) {
            arr[i] = list.get(i).unwrap_or(0);
            i = i + 1;
        }
        return arr;
    }
}
