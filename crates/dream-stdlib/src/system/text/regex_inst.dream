module system.text;

internal class RegexInst {
    public opcode: RegexOp;
    public ranges: List<char>;
    public range_pairs: char[];
    // 0 = generic pairs, 1 = ASCII digits, 2 = ASCII word, 3 = ASCII space, 4 = any char,
    // 5 = `[a-z]`, 6 = `[a-zA-Z]`, 7 = single character.
    public class_kind: int;
    public negate: bool;
    public foldcase: bool;
    public cap: int;
    public empty_kind: RegexEmptyKind;
    public out: int;
    public out1: int;
    public sub_index: int;  // Look only: index into the owning `RegexVM`'s `RegexSubTable`
    public look_ahead: bool; // Look only: true = lookahead, false = lookbehind

    public constructor(opcode: RegexOp, ranges: List<char>, negate: bool, foldcase: bool, cap: int, empty_kind: RegexEmptyKind, out: int, out1: int, sub_index: int, look_ahead: bool) {
        this.opcode = opcode;
        this.range_pairs = RegexInst.copy_pairs(ranges);
        this.class_kind = RegexInst.kind_of(ranges, negate, foldcase);
        this.ranges = ranges;
        this.negate = negate;
        this.foldcase = foldcase;
        this.cap = cap;
        this.empty_kind = empty_kind;
        this.out = out;
        this.out1 = out1;
        this.sub_index = sub_index;
        this.look_ahead = look_ahead;
    }

    static fun copy_pairs(borrow ranges: List<char>): char[] {
        let n = ranges.length;
        let out = Buffer.alloc<char>(n);
        let i = 0;
        while (i < n) {
            out[i] = ranges.get(i).unwrap_or(' ');
            i = i + 1;
        }
        return out;
    }

    static fun kind_of(borrow ranges: List<char>, negate: bool, foldcase: bool): int {
        if ((negate) && (ranges.length == 0)) {
            return 4;
        }
        if (ranges.length == 2) {
            if ((ranges.get(0).unwrap_or(' ') == '0') && (ranges.get(1).unwrap_or(' ') == '9')) {
                return 1;
            }
            if ((foldcase == false) && (negate == false) && (ranges.get(0).unwrap_or(' ') == 'a') && (ranges.get(1).unwrap_or(' ') == 'z')) {
                return 5;
            }
            if ((foldcase == false) && (negate == false)) {
                let lo = ranges.get(0).unwrap_or(' ');
                let hi = ranges.get(1).unwrap_or(' ');
                if (lo == hi) {
                    return 7;
                }
            }
        }
        if ((foldcase == false) && (negate == false) && (ranges.length == 4)) {
            if ((ranges.get(0).unwrap_or(' ') == 'a')
                && (ranges.get(1).unwrap_or(' ') == 'z')
                && (ranges.get(2).unwrap_or(' ') == 'A')
                && (ranges.get(3).unwrap_or(' ') == 'Z')) {
                return 6;
            }
        }
        if ((foldcase == false) && (negate == false) && RegexInst.is_word_pairs(ranges)) {
            return 2;
        }
        if ((foldcase == false) && (negate == false) && RegexInst.is_space_pairs(ranges)) {
            return 3;
        }
        return 0;
    }

    static fun is_word_pairs(borrow ranges: List<char>): bool {
        if (ranges.length != 8) {
            return false;
        }
        return (ranges.get(0).unwrap_or(' ') == 'a')
            && (ranges.get(1).unwrap_or(' ') == 'z')
            && (ranges.get(2).unwrap_or(' ') == 'A')
            && (ranges.get(3).unwrap_or(' ') == 'Z')
            && (ranges.get(4).unwrap_or(' ') == '0')
            && (ranges.get(5).unwrap_or(' ') == '9')
            && (ranges.get(6).unwrap_or(' ') == '_')
            && (ranges.get(7).unwrap_or(' ') == '_');
    }

    static fun is_space_pairs(borrow ranges: List<char>): bool {
        if (ranges.length != 8) {
            return false;
        }
        return (ranges.get(0).unwrap_or(' ') == ' ')
            && (ranges.get(1).unwrap_or(' ') == ' ')
            && (ranges.get(2).unwrap_or(' ') == '\t')
            && (ranges.get(3).unwrap_or(' ') == '\t')
            && (ranges.get(4).unwrap_or(' ') == '\n')
            && (ranges.get(5).unwrap_or(' ') == '\n')
            && (ranges.get(6).unwrap_or(' ') == '\r')
            && (ranges.get(7).unwrap_or(' ') == '\r');
    }

    static fun ascii_word(c: char): bool {
        if ((c >= 'a') && (c <= 'z')) {
            return true;
        }
        if ((c >= 'A') && (c <= 'Z')) {
            return true;
        }
        if ((c >= '0') && (c <= '9')) {
            return true;
        }
        return c == '_';
    }

    // Effective character-class membership (negate already applied). Kind 4 is the synthetic
    // unanchored `.*?` any-char prefix and always matches.
    @inline
    public fun matches_char(c: char): bool {
        let k = this.class_kind;
        if (k == 4) {
            return true;
        }
        let hit = false;
        if (k == 1) {
            hit = (c >= '0') && (c <= '9');
        } else if (k == 2) {
            hit = RegexInst.ascii_word(c);
        } else if (k == 3) {
            hit = (c == ' ') || (c == '\t') || (c == '\n') || (c == '\r');
        } else if (k == 5) {
            hit = (c >= 'a') && (c <= 'z');
        } else if (k == 6) {
            hit = ((c >= 'a') && (c <= 'z')) || ((c >= 'A') && (c <= 'Z'));
        } else if (k == 7) {
            hit = (this.range_pairs.length >= 1) && (c == this.range_pairs[0]);
        } else {
            let probe = c;
            if (this.foldcase) {
                probe = c.to_lower();
            }
            let pairs = this.range_pairs;
            let i = 0;
            while (i < pairs.length) {
                if ((probe >= pairs[i]) && (probe <= pairs[i + 1])) {
                    hit = true;
                    i = pairs.length;
                } else {
                    i = i + 2;
                }
            }
        }
        if (this.negate) {
            return hit == false;
        }
        return hit;
    }

    public static fun char_class(ranges: List<char>, negate: bool, foldcase: bool): RegexInst {
        return RegexInst(RegexOp.CharClass, ranges, negate, foldcase, 0, RegexEmptyKind.BeginLine, 0 - 1, 0 - 1, 0 - 1, true);
    }

    public static fun capture(cap: int): RegexInst {
        return RegexInst(RegexOp.Capture, List<char>(), false, false, cap, RegexEmptyKind.BeginLine, 0 - 1, 0 - 1, 0 - 1, true);
    }

    public static fun empty_width(kind: RegexEmptyKind): RegexInst {
        return RegexInst(RegexOp.EmptyWidth, List<char>(), false, false, 0, kind, 0 - 1, 0 - 1, 0 - 1, true);
    }

    public static fun alt(out: int, out1: int): RegexInst {
        return RegexInst(RegexOp.Alt, List<char>(), false, false, 0, RegexEmptyKind.BeginLine, out, out1, 0 - 1, true);
    }

    public static fun nop(out: int): RegexInst {
        return RegexInst(RegexOp.Nop, List<char>(), false, false, 0, RegexEmptyKind.BeginLine, out, 0 - 1, 0 - 1, true);
    }

    public static fun match_inst(): RegexInst {
        return RegexInst(RegexOp.Match, List<char>(), false, false, 0, RegexEmptyKind.BeginLine, 0 - 1, 0 - 1, 0 - 1, true);
    }

    public static fun look(sub_index: int, look_ahead: bool, negate: bool): RegexInst {
        return RegexInst(RegexOp.Look, List<char>(), negate, false, 0, RegexEmptyKind.BeginLine, 0 - 1, 0 - 1, sub_index, look_ahead);
    }

    // `cap` holds the referenced group number (e.g. `1` for `\1`); `foldcase` mirrors the
    // pattern's `i` flag for the text comparison.
    public static fun backref(group: int, foldcase: bool): RegexInst {
        return RegexInst(RegexOp.Backref, List<char>(), false, foldcase, group, RegexEmptyKind.BeginLine, 0 - 1, 0 - 1, 0 - 1, true);
    }
}
