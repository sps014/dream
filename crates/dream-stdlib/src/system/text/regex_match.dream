module system.text;

// The result of a successful `RegexVM.find`: every capturing group's `[start, end)` offsets, flat
// pairs indexed `2*i`/`2*i + 1` (group 0 is the overall match). `-1` marks a group that never
// participated in the match (e.g. an alternative that wasn't taken).
internal class RegexMatch {
    internal groups: int[];
    internal ngroup: int;

    internal constructor(groups: int[], ngroup: int) {
        this.groups = groups;
        this.ngroup = ngroup;
    }

    internal fun start(): int {
        return this.groups[0];
    }

    internal fun end(): int {
        return this.groups[1];
    }

    internal fun group_start(i: int): int {
        let idx = 2 * i;
        if (idx < 0) || (idx + 1 >= this.groups.length) {
            return 0 - 1;
        }
        return this.groups[idx];
    }

    internal fun group_end(i: int): int {
        let idx = (2 * i) + 1;
        if (idx < 0) || (idx >= this.groups.length) {
            return 0 - 1;
        }
        return this.groups[idx];
    }

    // The text captured by group `i` (0 is the whole match), or "" if it didn't participate.
    internal fun group_text(borrow input: string, i: int): string {
        let s = this.group_start(i);
        let e = this.group_end(i);
        if (s < 0) || (e < 0) {
            return string.empty;
        }
        return input.substring(s, e);
    }
}
