module system.text;

// Regex AST nodes form a tree (children via `left`/`right`).
internal class RegexNode {
    public kind: RegexNodeKind;
    public left: List<RegexNode>;
    public right: List<RegexNode>;
    public ch: char;
    public ranges: List<char>;
    public negate: bool;
    public cap: int;
    public greedy: bool;
    public empty_kind: RegexEmptyKind;
    public look_ahead: bool;       // Look only: true = lookahead, false = lookbehind
    public sub_ngroup: int;        // Look only: capturing-group count of the inner pattern
    public uprop: RegexUnicodeProp; // UnicodeProp only: which category

    public constructor(kind: RegexNodeKind, left: List<RegexNode>, right: List<RegexNode>, ch: char, ranges: List<char>, negate: bool, cap: int, greedy: bool, empty_kind: RegexEmptyKind, look_ahead: bool, sub_ngroup: int, uprop: RegexUnicodeProp) {
        this.kind = kind;
        this.left = left;
        this.right = right;
        this.ch = ch;
        this.ranges = ranges;
        this.negate = negate;
        this.cap = cap;
        this.greedy = greedy;
        this.empty_kind = empty_kind;
        this.look_ahead = look_ahead;
        this.sub_ngroup = sub_ngroup;
        this.uprop = uprop;
    }

    fun one_child(node: RegexNode): List<RegexNode> {
        let l = List<RegexNode>();
        l.push(node);
        return l;
    }

    // The left (or only) child of a unary/binary node, or `Nothing` if absent.
    public fun left_child(): RegexNode {
        if (this.left.length == 0) {
            return RegexNode.nothing();
        }
        return this.left.get_at(0);
    }

    // The right child of a binary node, or `Nothing` if absent.
    public fun right_child(): RegexNode {
        if (this.right.length == 0) {
            return RegexNode.nothing();
        }
        return this.right.get_at(0);
    }

    public static fun nothing(): RegexNode {
        let n = RegexNode(RegexNodeKind.Nothing, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        return n;
    }

    public static fun lit(ch: char): RegexNode {
        return RegexNode(RegexNodeKind.Lit, List<RegexNode>(), List<RegexNode>(), ch, List<char>(), false, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
    }

    public static fun any_char(): RegexNode {
        return RegexNode(RegexNodeKind.AnyChar, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
    }

    // `ranges` is a flat list of (lo, hi) pairs. `negate` flips membership: a `[^...]` class.
    public static fun char_class(ranges: List<char>, negate: bool): RegexNode {
        return RegexNode(RegexNodeKind.Class, List<RegexNode>(), List<RegexNode>(), ' ', ranges, negate, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
    }

    public static fun cat(left: RegexNode, right: RegexNode): RegexNode {
        let n = RegexNode(RegexNodeKind.Cat, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(left);
        n.right = n.one_child(right);
        return n;
    }

    public static fun alt(left: RegexNode, right: RegexNode): RegexNode {
        let n = RegexNode(RegexNodeKind.Alt, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(left);
        n.right = n.one_child(right);
        return n;
    }

    // `cap` >= 0 for a capturing group (0 is reserved for the whole-match wrapper the parser
    // installs around the entire pattern); `cap` == -1 for a non-capturing `(?:...)` group.
    public static fun paren(inner: RegexNode, cap: int): RegexNode {
        let n = RegexNode(RegexNodeKind.Paren, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, cap, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun star(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Star, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun plus(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Plus, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun quest(inner: RegexNode, greedy: bool): RegexNode {
        let n = RegexNode(RegexNodeKind.Quest, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, greedy, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
        n.left = n.one_child(inner);
        return n;
    }

    public static fun assertion(kind: RegexEmptyKind): RegexNode {
        return RegexNode(RegexNodeKind.Assert, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, 0, true, kind, true, 0, RegexUnicodeProp.Letter);
    }

    // A lookaround assertion: `inner` is the sub-pattern, `ahead` picks lookahead/lookbehind,
    // `negate` picks negative/positive, `sub_ngroup` is `inner`'s own capturing-group count.
    public static fun look(inner: RegexNode, ahead: bool, negate: bool, sub_ngroup: int): RegexNode {
        let n = RegexNode(RegexNodeKind.Look, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), negate, 0, true, RegexEmptyKind.BeginLine, ahead, sub_ngroup, RegexUnicodeProp.Letter);
        n.left = n.one_child(inner);
        return n;
    }

    // A backreference (`\1`, `\k<name>`) to (outer) capturing group `group`.
    public static fun backref(group: int): RegexNode {
        return RegexNode(RegexNodeKind.Backref, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), false, group, true, RegexEmptyKind.BeginLine, true, 0, RegexUnicodeProp.Letter);
    }

    // A `\p{...}` / `\P{...}` Unicode property class.
    public static fun unicode_prop(prop: RegexUnicodeProp, negate: bool): RegexNode {
        return RegexNode(RegexNodeKind.UnicodeProp, List<RegexNode>(), List<RegexNode>(), ' ', List<char>(), negate, 0, true, RegexEmptyKind.BeginLine, true, 0, prop);
    }
}
