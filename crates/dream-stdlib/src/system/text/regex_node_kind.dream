module system.text;

// The kind of a parsed regex node.
internal enum RegexNodeKind {
    Alt,      // left | right
    Cat,      // left then right
    Lit,      // a single literal character (`ch`)
    Class,    // a character class: `ranges` (lo, hi pairs) plus `negate`
    AnyChar,  // `.` — ranges are resolved at compile time from the dotall flag
    Paren,    // a group; `cap` >= 0 is a capturing group's 1-based index (0 = the whole-match
              // wrapper the parser adds), `cap` == -1 is a non-capturing `(?:...)` group
    Star,     // left*
    Plus,     // left+
    Quest,    // left?
    Assert,   // a zero-width assertion; `empty_kind` selects which one
    Nothing,  // matches the empty string and consumes nothing (compiles to zero instructions)
    Look,     // a lookaround assertion; `left` is the inner pattern, `look_ahead` picks ahead/behind,
              // `negate` picks positive/negative, `sub_ngroup` is the inner pattern's own group count
              // (numbered independently of the outer pattern's capturing groups)
    Backref,  // \N or \k<name>; `cap` is the (outer) group number being referenced
    UnicodeProp, // \p{...} / \P{...}; `uprop` selects the category, `negate` picks \P over \p
}
