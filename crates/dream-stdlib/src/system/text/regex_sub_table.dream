module system.text;

// Sub-programs compiled for lookaround assertions (`(?=...)`, `(?!...)`, `(?<=...)`, `(?<!...)`),
// shared by the root `RegexCompiler` and every nested one so a `Look` instruction's `sub_index`
// is a global index regardless of how deeply the lookaround is nested inside another one.
internal class RegexSubTable {
    public progs: List<RegexInst[]>;
    public ngroups: List<int>;

    public constructor() {
        this.progs = List<RegexInst[]>();
        this.ngroups = List<int>();
    }

    // Registers a compiled sub-program and returns its index.
    public fun add(prog: RegexInst[], ngroup: int): int {
        this.progs.push(prog);
        this.ngroups.push(ngroup);
        return this.progs.length - 1;
    }
}
