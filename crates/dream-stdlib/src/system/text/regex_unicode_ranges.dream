module system.text;

// Range tables backing `\p{L}`/`\p{N}` (and their negations `\P{L}`/`\P{N}`). Approximate: this is
// a hand-picked set of codepoint ranges covering the common scripts for each general category,
// not a full Unicode Character Database — Dream has no UCD dependency to draw on (see AGENTS.md's
// "prefer well-settled libraries" rule: there is no existing crate reachable from pure-Dream
// stdlib code, so this trades completeness for a workable subset).
//
// Codepoints are capped at 255 (Latin-1): a `List<char>`'s backing store is byte-wide (`char`
// values round-trip through `i32.store8`/`i32.load8_u` once placed in a list/array), so any
// codepoint above 255 would silently wrap mod 256 the moment it's stored here — e.g. U+02C1 (705)
// would come back as 705 % 256 = 193, corrupting the range instead of representing it. Scripts
// outside Basic Latin + Latin-1 Supplement (Greek, Cyrillic, CJK, etc.) are therefore not covered
// by `\p{L}`/`\p{N}` in this engine. The lexer has no hex literal syntax, so codepoints below are
// decimal with a `// U+XXXX` comment.
internal class RegexUnicodeRanges {
    // General category L (Lu/Ll/Lt/Lm/Lo) restricted to Basic Latin + Latin-1 Supplement.
    public static fun letter_ranges(): List<char> {
        let r = List<char>();
        RegexUnicodeRanges.push_range(r, 65, 90);   // U+0041-005A Latin upper
        RegexUnicodeRanges.push_range(r, 97, 122);  // U+0061-007A Latin lower
        RegexUnicodeRanges.push_range(r, 170, 170); // U+00AA feminine ordinal indicator
        RegexUnicodeRanges.push_range(r, 181, 181); // U+00B5 micro sign
        RegexUnicodeRanges.push_range(r, 186, 186); // U+00BA masculine ordinal indicator
        RegexUnicodeRanges.push_range(r, 192, 214); // U+00C0-00D6
        RegexUnicodeRanges.push_range(r, 216, 246); // U+00D8-00F6
        RegexUnicodeRanges.push_range(r, 248, 255); // U+00F8-00FF
        return r;
    }

    // General category N (Nd/Nl/No) restricted to Basic Latin + Latin-1 Supplement.
    public static fun number_ranges(): List<char> {
        let r = List<char>();
        RegexUnicodeRanges.push_range(r, 48, 57);   // U+0030-0039 ASCII digits
        RegexUnicodeRanges.push_range(r, 178, 179); // U+00B2-00B3 superscript 2,3
        RegexUnicodeRanges.push_range(r, 185, 185); // U+00B9 superscript 1
        RegexUnicodeRanges.push_range(r, 188, 190); // U+00BC-00BE fractions
        return r;
    }

    static fun push_range(r: List<char>, lo: int, hi: int): void {
        r.push((char)lo);
        r.push((char)hi);
    }
}
