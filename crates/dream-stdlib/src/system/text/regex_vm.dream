module system.text;

// Growable parallel pc/capture queues for the Pike-VM. Indexed access (no `Option`) on the
// per-character hot path; capacity is reused across steps and searches via `clear`.
internal class RegexThreadq {
    public pcs: int[];
    public caps: int[][];
    public count: int;

    public constructor() {
        this.pcs = Buffer.alloc<int>(8);
        this.caps = Buffer.alloc<int[]>(8);
        this.count = 0;
    }

    public fun clear(): void {
        // Rewind only: the next `push` overwrites slots. Allocating a dummy `int[]` every Step
        // was the dominant cost on short Global searches.
        this.count = 0;
    }

    fun grow(): void {
        let n = this.pcs.length * 2;
        this.pcs = Buffer.realloc<int>(this.pcs, n);
        this.caps = Buffer.realloc<int[]>(this.caps, n);
    }

    public fun push(pc: int, borrow caps: int[]): void {
        if (this.count == this.pcs.length) {
            this.grow();
        }
        this.pcs[this.count] = pc;
        this.caps[this.count] = caps;
        this.count = this.count + 1;
    }

    public fun pop_pc(): int {
        this.count = this.count - 1;
        return this.pcs[this.count];
    }

    public fun pop_caps(): int[] {
        return this.caps[this.count];
    }
}

// Pike-VM thread-list NFA simulation, ported from RE2's `NFA::Search`/`AddToThreadq`/`Step`
// (re2/nfa.cc) — the same "run every live thread through the program in lock-step, one input
// character at a time" algorithm as `re1`'s `pike.c` before it, but with `AddToThreadq`'s
// epsilon-closure walk done iteratively over an explicit stack (matching nfa.cc, not the older
// recursive `addthread`), so it can't blow the call stack on a pathological program.
//
// Capture-array sharing: RE2's `Thread` shares a single reference-counted `capture` array across
// threads and only copies it when a `Capture` instruction needs to write a new offset
// (`nfa.cc`'s `Incref`/`Decref`/freelist). Dream classes are already ARC-managed, so this port
// gets the same "share until mutated" behavior for free by simply copying the `int[]` capture
// array on a `Capture` write and otherwise passing the same array reference along — no manual
// refcounting needed.
internal class RegexVM {
    prog: RegexInst[];
    ngroup: int;
    multiline: bool;
    table: RegexSubTable;
    stack: RegexThreadq;
    clist: RegexThreadq;
    nlist: RegexThreadq;
    on_list: int[];
    init_caps: int[];
    search_gen: int;
    // Unanchored `.*?` any-char pc and first consuming body CharClass, or -1 if skip is unsafe.
    prefix_pc: int;
    hint_pc: int;
    // Flattened bytecode (parallel SOA). `prog` stays for compile-time analysis and Look/generic classes.
    opcodes: int[];
    outs: int[];
    out1s: int[];
    kinds: int[];
    cap_ids: int[];
    negs: int[];
    cap_pool: int[][];
    pool_used: int;

    public constructor(borrow prog: RegexInst[], ngroup: int, multiline: bool, borrow table: RegexSubTable) {
        this.prog = RegexVM.share_prog(prog);
        this.ngroup = ngroup;
        this.multiline = multiline;
        this.table = RegexVM.share_table(table);
        this.stack = RegexThreadq();
        this.clist = RegexThreadq();
        this.nlist = RegexThreadq();
        this.on_list = Buffer.alloc<int>(0);
        this.init_caps = Buffer.alloc<int>(0);
        this.search_gen = 1;
        this.prefix_pc = 0 - 1;
        this.hint_pc = 0 - 1;
        this.opcodes = Buffer.alloc<int>(0);
        this.outs = Buffer.alloc<int>(0);
        this.out1s = Buffer.alloc<int>(0);
        this.kinds = Buffer.alloc<int>(0);
        this.cap_ids = Buffer.alloc<int>(0);
        this.negs = Buffer.alloc<int>(0);
        this.cap_pool = Buffer.alloc<int[]>(32);
        this.pool_used = 0;
        this.analyze_skip_hint();
        this.flatten_prog();
    }

    static fun share_prog(p: RegexInst[]): RegexInst[] {
        return p;
    }

    static fun share_table(t: RegexSubTable): RegexSubTable {
        return t;
    }

    fun flatten_prog(): void {
        let n = this.prog.length;
        this.opcodes = Buffer.alloc<int>(n);
        this.outs = Buffer.alloc<int>(n);
        this.out1s = Buffer.alloc<int>(n);
        this.kinds = Buffer.alloc<int>(n);
        this.cap_ids = Buffer.alloc<int>(n);
        this.negs = Buffer.alloc<int>(n);
        let i = 0;
        while (i < n) {
            let inst = this.prog[i];
            this.opcodes[i] = this.op_id(inst.opcode);
            this.outs[i] = inst.out;
            this.out1s[i] = inst.out1;
            this.kinds[i] = inst.class_kind;
            this.cap_ids[i] = inst.cap;
            if (inst.negate) {
                this.negs[i] = 1;
            } else {
                this.negs[i] = 0;
            }
            i = i + 1;
        }
    }

    fun op_id(op: RegexOp): int {
        if (op == RegexOp.CharClass) {
            return 0;
        }
        if (op == RegexOp.Capture) {
            return 1;
        }
        if (op == RegexOp.EmptyWidth) {
            return 2;
        }
        if (op == RegexOp.Alt) {
            return 3;
        }
        if (op == RegexOp.Match) {
            return 4;
        }
        if (op == RegexOp.Nop) {
            return 5;
        }
        if (op == RegexOp.Look) {
            return 6;
        }
        return 7;
    }

    fun class_hit(pc: int, c: char): bool {
        let k = this.kinds[pc];
        if (k == 4) {
            return true;
        }
        let hit = false;
        if (k == 1) {
            hit = (c >= '0') && (c <= '9');
        } else if (k == 5) {
            hit = (c >= 'a') && (c <= 'z');
        } else {
            return this.prog[pc].matches_char(c);
        }
        if (this.negs[pc] != 0) {
            return hit == false;
        }
        return hit;
    }

    fun take_caps(n: int): int[] {
        if (this.pool_used < this.cap_pool.length) {
            let slot = this.cap_pool[this.pool_used];
            if (slot.length == n) {
                this.pool_used = this.pool_used + 1;
                return slot;
            }
        }
        let a = Buffer.alloc<int>(n);
        if (this.pool_used == this.cap_pool.length) {
            this.cap_pool = Buffer.realloc<int[]>(this.cap_pool, this.cap_pool.length * 2 + 1);
        }
        this.cap_pool[this.pool_used] = a;
        this.pool_used = this.pool_used + 1;
        return a;
    }

    fun snapshot_caps(src: int[]): int[] {
        let n = src.length;
        let dst = Buffer.alloc<int>(n);
        Buffer.elems_copy<int>(dst, 0, src, 0, n);
        return dst;
    }

    // The compiled program is `.*?` (non-greedy star of any-char) then group 0. If the body is
    // not nullable and starts with a CharClass, unanchored search can skip runs that cannot start
    // a match. Conservative: any epsilon path from the body to Match disables the hint.
    fun analyze_skip_hint(): void {
        if (this.prog.length == 0) {
            return;
        }
        let inst0 = this.prog[0];
        if (inst0.opcode != RegexOp.Alt) {
            return;
        }
        let prefix_body = inst0.out1;
        let after_star = inst0.out;
        if ((prefix_body < 0) || (prefix_body >= this.prog.length)) {
            return;
        }
        if ((after_star < 0) || (after_star >= this.prog.length)) {
            return;
        }
        let pb = this.prog[prefix_body];
        if ((pb.opcode != RegexOp.CharClass) || (pb.class_kind != 4)) {
            return;
        }
        if (this.eps_reaches_match(after_star)) {
            return;
        }
        let pc = after_star;
        let guard = 0;
        while (guard < this.prog.length) {
            let ins = this.prog[pc];
            if ((ins.opcode == RegexOp.Capture) || (ins.opcode == RegexOp.Nop)) {
                pc = ins.out;
                if ((pc < 0) || (pc >= this.prog.length)) {
                    return;
                }
            } else {
                guard = this.prog.length;
            }
            guard = guard + 1;
        }
        if ((pc < 0) || (pc >= this.prog.length)) {
            return;
        }
        if (this.prog[pc].opcode == RegexOp.Alt) {
            let a = this.prog[pc].out;
            let b = this.prog[pc].out1;
            if ((a >= 0) && (a < this.prog.length) && (this.prog[a].opcode == RegexOp.CharClass)) {
                pc = a;
            } else if ((b >= 0) && (b < this.prog.length) && (this.prog[b].opcode == RegexOp.CharClass)) {
                pc = b;
            }
        }
        if (this.prog[pc].opcode != RegexOp.CharClass) {
            return;
        }
        this.prefix_pc = prefix_body;
        this.hint_pc = pc;
    }

    // True when unanchored search is `.*?` + greedy ASCII-digit class Plus (compiled `\d+` /
    // `[0-9]+` with no captures). Enables a linear byte-scan match path.
    public fun is_ascii_digit_plus(): bool {
        if ((this.hint_pc < 0) || (this.ngroup != 0)) {
            return false;
        }
        if ((this.hint_pc < 0) || (this.hint_pc >= this.prog.length)) {
            return false;
        }
        let hint = this.prog[this.hint_pc];
        if ((hint.opcode != RegexOp.CharClass) || (hint.class_kind != 1)) {
            return false;
        }
        if (hint.negate || hint.foldcase) {
            return false;
        }
        let nxt = hint.out;
        if ((nxt < 0) || (nxt >= this.prog.length)) {
            return false;
        }
        let alt = this.prog[nxt];
        if (alt.opcode != RegexOp.Alt) {
            return false;
        }
        // Plus: one arm loops back to the digit class (or a Capture/Nop leading into it).
        return (alt.out == this.hint_pc) || (alt.out1 == this.hint_pc);
    }

    fun eps_reaches_match(start: int): bool {
        let n = this.prog.length;
        let seen = Buffer.alloc<int>(n);
        let i = 0;
        while (i < n) {
            seen[i] = 0;
            i = i + 1;
        }
        let stack = Buffer.alloc<int>(n);
        let sp = 0;
        if ((start >= 0) && (start < n)) {
            stack[0] = start;
            sp = 1;
        }
        let found = false;
        while ((sp > 0) && (found == false)) {
            sp = sp - 1;
            let pc = stack[sp];
            if (seen[pc] != 0) {
                // skip
            } else {
                seen[pc] = 1;
                let inst = this.prog[pc];
                if (inst.opcode == RegexOp.Match) {
                    found = true;
                } else if ((inst.opcode == RegexOp.Nop) || (inst.opcode == RegexOp.Capture)) {
                    let nxt = inst.out;
                    if ((nxt >= 0) && (nxt < n) && (seen[nxt] == 0) && (sp < n)) {
                        stack[sp] = nxt;
                        sp = sp + 1;
                    }
                } else if (inst.opcode == RegexOp.Alt) {
                    let a = inst.out;
                    let b = inst.out1;
                    if ((a >= 0) && (a < n) && (seen[a] == 0) && (sp < n)) {
                        stack[sp] = a;
                        sp = sp + 1;
                    }
                    if ((b >= 0) && (b < n) && (seen[b] == 0) && (sp < n)) {
                        stack[sp] = b;
                        sp = sp + 1;
                    }
                } else if ((inst.opcode == RegexOp.EmptyWidth) || (inst.opcode == RegexOp.Look)) {
                    found = true;
                }
            }
        }
        return found;
    }

    fun look_holds(borrow inst: RegexInst, pos: int, borrow input: string, len: int): bool {
        let sub_prog = this.table.progs.get(inst.sub_index).unwrap_or(Buffer.alloc<RegexInst>(0));
        let sub_ngroup = this.table.ngroups.get(inst.sub_index).unwrap_or(0);
        let sub_vm = RegexVM(sub_prog, sub_ngroup, this.multiline, this.table);
        let holds = false;
        if (inst.look_ahead) {
            holds = sub_vm.find(input, pos).is_some();
        } else {
            let s = pos;
            let found = false;
            while ((s >= 0) && (found == false)) {
                let sub_input = input.substring(s, pos);
                let m = sub_vm.find(sub_input, 0);
                switch (m) {
                    Some(mm) => {
                        if (mm.end() == sub_input.length) {
                            found = true;
                        }
                    },
                    None => {},
                }
                s = s - 1;
            }
            holds = found;
        }
        if (inst.negate) {
            return holds == false;
        }
        return holds;
    }

    fun copy_caps(src: int[]): int[] {
        let n = src.length;
        let dst = this.take_caps(n);
        Buffer.elems_copy<int>(dst, 0, src, 0, n);
        return dst;
    }

    fun is_word_char(c: char): bool {
        if (c.is_alpha()) {
            return true;
        }
        if (c.is_digit()) {
            return true;
        }
        return c == '_';
    }

    fun empty_ok(kind: RegexEmptyKind, pos: int, borrow input: string, len: int): bool {
        if (kind == RegexEmptyKind.BeginText) {
            return pos == 0;
        }
        if (kind == RegexEmptyKind.EndText) {
            return pos == len;
        }
        if (kind == RegexEmptyKind.BeginLine) {
            if (pos == 0) {
                return true;
            }
            if (this.multiline == false) {
                return false;
            }
            return input.char_at(pos - 1) == '\n';
        }
        if (kind == RegexEmptyKind.EndLine) {
            if (pos == len) {
                return true;
            }
            if (this.multiline == false) {
                return false;
            }
            return input.char_at(pos) == '\n';
        }
        let before = (pos > 0) && this.is_word_char(input.char_at(pos - 1));
        let after = (pos < len) && this.is_word_char(input.char_at(pos));
        let boundary = before != after;
        if (kind == RegexEmptyKind.WordBoundary) {
            return boundary;
        }
        return boundary == false;
    }

    fun add_to_threadq(
        out: RegexThreadq,
        on_list: int[],
        gen: int,
        start_pc: int,
        pos: int,
        borrow input: string,
        len: int,
        start_caps: int[]
    ): void {
        let st = this.stack;
        st.clear();
        st.push(start_pc, start_caps);
        while (st.count > 0) {
            let pc = st.pop_pc();
            let caps = st.pop_caps();
            if (pc < 0) {
                // skip
            } else if (on_list[pc] == gen) {
                // Already visited this instruction during this generation.
            } else {
                on_list[pc] = gen;
                let op = this.opcodes[pc];
                if (op == 5) {
                    st.push(this.outs[pc], caps);
                } else if (op == 3) {
                    st.push(this.out1s[pc], caps);
                    st.push(this.outs[pc], caps);
                } else if (op == 1) {
                    let updated = this.copy_caps(caps);
                    let cap = this.cap_ids[pc];
                    if ((cap >= 0) && (cap < updated.length)) {
                        updated[cap] = pos;
                    }
                    st.push(this.outs[pc], updated);
                } else if (op == 2) {
                    let inst = this.prog[pc];
                    if (this.empty_ok(inst.empty_kind, pos, input, len)) {
                        st.push(this.outs[pc], caps);
                    }
                } else if (op == 6) {
                    let inst = this.prog[pc];
                    if (this.look_holds(inst, pos, input, len)) {
                        st.push(this.outs[pc], caps);
                    }
                } else {
                    out.push(pc, caps);
                }
            }
        }
    }

    fun can_skip(q: RegexThreadq): bool {
        if (this.hint_pc < 0) {
            return false;
        }
        let n = q.count;
        if ((n < 1) || (n > 2)) {
            return false;
        }
        let a = q.pcs[0];
        if (n == 1) {
            return (a == this.prefix_pc) || (a == this.hint_pc);
        }
        let b = q.pcs[1];
        let p = this.prefix_pc;
        let h = this.hint_pc;
        return ((a == p) && (b == h)) || ((a == h) && (b == p));
    }

    fun scalar_to_byte(borrow input: string, scalar: int): int {
        return scalar * 2;
    }

    public fun find(borrow input: string, start: int): Option<RegexMatch> {
        let len = input.length;
        let ncap = 2 * (this.ngroup + 1);
        if (this.on_list.length < this.prog.length) {
            this.on_list = Buffer.alloc<int>(this.prog.length);
            this.search_gen = 1;
        }
        if (this.search_gen > 2000000000) {
            let z = 0;
            while (z < this.on_list.length) {
                this.on_list[z] = 0 - 1;
                z = z + 1;
            }
            this.search_gen = 1;
        }
        let on_list = this.on_list;
        if (this.init_caps.length < ncap) {
            this.init_caps = Buffer.alloc<int>(ncap);
        }
        let init_caps = this.init_caps;
        let j0 = 0;
        while (j0 < ncap) {
            init_caps[j0] = 0 - 1;
            j0 = j0 + 1;
        }

        this.pool_used = 0;
        this.search_gen = this.search_gen + 1;
        let gen = this.search_gen;
        let clist = this.clist;
        let nlist = this.nlist;
        clist.clear();
        nlist.clear();
        this.add_to_threadq(clist, on_list, gen, 0, start, input, len, init_caps);

        let matched: Option<int[]> = Option.None;
        let pos = start;
        let going = true;
        while (going) {
            if (clist.count == 0) {
                going = false;
            } else {
                if ((pos < len) && this.can_skip(clist)) {
                    let c0 = input.char_at(pos);
                    if (this.class_hit(this.hint_pc, c0) == false) {
                        let skipping = true;
                        while ((pos < len) && skipping) {
                            let c = input.char_at(pos);
                            if (this.class_hit(this.hint_pc, c)) {
                                skipping = false;
                            } else {
                                pos = pos + 1;
                            }
                        }
                        if (pos >= len) {
                            going = false;
                        } else {
                            clist.clear();
                            gen = gen + 1;
                            this.search_gen = gen;
                            this.add_to_threadq(clist, on_list, gen, 0, pos, input, len, init_caps);
                        }
                    }
                }
                if (going) {
                    nlist.clear();
                    gen = gen + 1;
                    this.search_gen = gen;
                    let k = 0;
                    let stop = false;
                    let at_end = pos >= len;
                    let cur = ' ';
                    if (at_end == false) {
                        cur = input.char_at(pos);
                    }
                    while ((k < clist.count) && (stop == false)) {
                        let pc = clist.pcs[k];
                        let caps = clist.caps[k];
                        let op = this.opcodes[pc];
                        if (op == 0) {
                            if (at_end == false) {
                                if (this.class_hit(pc, cur)) {
                                    this.add_to_threadq(
                                        nlist,
                                        on_list,
                                        gen,
                                        this.outs[pc],
                                        pos + 1,
                                        input,
                                        len,
                                        caps
                                    );
                                }
                            }
                        } else if (op == 4) {
                            matched = Option.Some(this.snapshot_caps(caps));
                            stop = true;
                        }
                        k = k + 1;
                    }
                    let swap_q = clist;
                    clist = nlist;
                    nlist = swap_q;
                    if (pos >= len) {
                        going = false;
                    } else {
                        pos = pos + 1;
                    }
                }
            }
        }

        return switch (matched) {
            Some(caps) => Option.Some(RegexMatch(caps, this.ngroup)),
            None => Option.None,
        };
    }

    // One-pass Global: continue from each match end without a fresh Regex wrapper per hit.
    public fun collect_group0(borrow input: string, dest: List<string>): void {
        let n = input.length;
        let pos = 0;
        let going = true;
        while (going) {
            if (pos > n) {
                going = false;
            } else {
                let m_opt = this.find(input, pos);
                switch (m_opt) {
                    Some(m) => {
                        dest.push(m.group_text(input, 0));
                        let s = m.start();
                        let e = m.end();
                        if (e > s) {
                            pos = e;
                        } else {
                            pos = s + 1;
                        }
                    },
                    None => {
                        going = false;
                    },
                }
            }
        }
    }
}
