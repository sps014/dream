module system.text;

// Pike-VM thread-list NFA simulation, ported from RE2's `NFA::Search`/`AddToThreadq`/`Step`
// (re2/nfa.cc) — the same "run every live thread through the program in lock-step, one input
// character at a time" algorithm as `re1`'s `pike.c` before it, but with `AddToThreadq`'s
// epsilon-closure walk done iteratively over an explicit stack (matching nfa.cc, not the older
// recursive `addthread`), so it can't blow the call stack on a pathological program.
//
// Capture-array sharing: RE2's `Thread` shares a single reference-counted `capture` array across
// threads and only copies it when a `Capture` instruction needs to write a new offset
// (`nfa.cc`'s `Incref`/`Decref`/freelist). Dream classes are already ARC-managed, so this port
// gets the same "share until mutated" behavior for free by simply copying the `int[]` capture
// array on a `Capture` write and otherwise passing the same array reference along — no manual
// refcounting needed.

internal class RegexVM {
    prog: RegexInst[];
    ngroup: int;
    multiline: bool;
    table: RegexSubTable;
    // SOA thread queues + epsilon stack (parallel pcs / caps), reused across steps via `clear`.
    stack_pcs: List<int>;
    stack_caps: List<int[]>;
    clist_pcs: List<int>;
    clist_caps: List<int[]>;
    nlist_pcs: List<int>;
    nlist_caps: List<int[]>;
    // Reused visit-mark / init-capture buffers (grown if a larger program needs more slots).
    on_list: int[];
    init_caps: int[];

    public constructor(borrow prog: RegexInst[], ngroup: int, multiline: bool, borrow table: RegexSubTable) {
        this.prog = prog;
        this.ngroup = ngroup;
        this.multiline = multiline;
        this.table = table;
        this.stack_pcs = List<int>();
        this.stack_caps = List<int[]>();
        this.clist_pcs = List<int>();
        this.clist_caps = List<int[]>();
        this.nlist_pcs = List<int>();
        this.nlist_caps = List<int[]>();
        this.on_list = Buffer.alloc<int>(0);
        this.init_caps = Buffer.alloc<int>(0);
    }

    // Whether a lookaround assertion holds at `pos`. Lookahead runs the sub-program anchored at
    // `pos` and just checks whether it can match at all (any length). Lookbehind has no "run
    // backwards" primitive, so it instead tries every candidate start `s` in `[0, pos]` and asks
    // whether the sub-program, run anchored at `0` against the substring `input[s:pos]`, matches
    // that substring exactly end to end — equivalent to "does the sub-pattern match some span
    // ending exactly at `pos`", without needing to reverse the pattern or the input.
    fun look_holds(borrow inst: RegexInst, pos: int, borrow input: string, len: int): bool {
        let sub_prog = this.table.progs.get(inst.sub_index).unwrap_or(Buffer.alloc<RegexInst>(0));
        let sub_ngroup = this.table.ngroups.get(inst.sub_index).unwrap_or(0);
        let sub_vm = RegexVM(sub_prog, sub_ngroup, this.multiline, this.table);
        let holds = false;
        if (inst.look_ahead) {
            holds = sub_vm.find(input, pos).is_some();
        } else {
            let s = pos;
            let found = false;
            while ((s >= 0) && (found == false)) {
                let sub_input = input.substring(s, pos);
                let m = sub_vm.find(sub_input, 0);
                switch (m) {
                    Some(mm) => {
                        if (mm.end() == sub_input.length) {
                            found = true;
                        }
                    },
                    None => {},
                }
                s = s - 1;
            }
            holds = found;
        }
        if (inst.negate) {
            return holds == false;
        }
        return holds;
    }

    fun copy_caps(src: int[]): int[] {
        let n = src.length;
        let dst = Buffer.alloc<int>(n);
        Buffer.elems_copy<int>(dst, 0, src, 0, n);
        return dst;
    }

    fun is_word_char(c: char): bool {
        if (c.is_alpha()) {
            return true;
        }
        if (c.is_digit()) {
            return true;
        }
        return c == '_';
    }

    // Whether the zero-width assertion `kind` holds at `pos` in `input` (length `len`). Mirrors
    // `Prog::EmptyFlags`, with `^`/`$` (`BeginLine`/`EndLine`) folding in the multiline flag here
    // at match time rather than needing two compile-time node variants.
    fun empty_ok(kind: RegexEmptyKind, pos: int, borrow input: string, len: int): bool {
        if (kind == RegexEmptyKind.BeginText) {
            return pos == 0;
        }
        if (kind == RegexEmptyKind.EndText) {
            return pos == len;
        }
        if (kind == RegexEmptyKind.BeginLine) {
            if (pos == 0) {
                return true;
            }
            if (this.multiline == false) {
                return false;
            }
            return input.char_at(pos - 1) == '\n';
        }
        if (kind == RegexEmptyKind.EndLine) {
            if (pos == len) {
                return true;
            }
            if (this.multiline == false) {
                return false;
            }
            return input.char_at(pos) == '\n';
        }
        let before = (pos > 0) && this.is_word_char(input.char_at(pos - 1));
        let after = (pos < len) && this.is_word_char(input.char_at(pos));
        let boundary = before != after;
        if (kind == RegexEmptyKind.WordBoundary) {
            return boundary;
        }
        return boundary == false; // NonWordBoundary
    }

    fun range_hit(ranges: List<char>, c: char, foldcase: bool): bool {
        let probe = c;
        if (foldcase) {
            probe = c.to_lower();
        }
        let i = 0;
        while (i < ranges.length) {
            let lo = ranges.get(i).unwrap_or(' ');
            let hi = ranges.get(i + 1).unwrap_or(' ');
            if ((probe >= lo) && (probe <= hi)) {
                return true;
            }
            i = i + 2;
        }
        return false;
    }

    fun char_matches(borrow inst: RegexInst, c: char): bool {
        let hit = this.range_hit(inst.ranges, c, inst.foldcase);
        if (inst.negate) {
            return hit == false;
        }
        return hit;
    }

    // Follows every epsilon transition (Nop/Alt/Capture/EmptyWidth) reachable from `start_pc`
    // without consuming input, appending the real (CharClass/Match) instructions it reaches to
    // `out_pcs`/`out_caps`, in priority order (earlier alternatives first — the same order a
    // backtracker would explore them in). `on_list`/`gen` deduplicate: an instruction already
    // added during this generation is skipped, so a cyclic epsilon graph (e.g. `(a*)*`) can't
    // loop forever and a lower-priority path never overrides a higher-priority one that reached
    // the same state.
    fun add_to_threadq(
        out_pcs: List<int>,
        out_caps: List<int[]>,
        on_list: int[],
        gen: int,
        start_pc: int,
        pos: int,
        borrow input: string,
        len: int,
        start_caps: int[]
    ): void {
        let sp = this.stack_pcs;
        let sc = this.stack_caps;
        sp.clear();
        sc.clear();
        sp.push(start_pc);
        sc.push(start_caps);
        while (sp.length > 0) {
            let pc = sp.pop().unwrap_or(0 - 1);
            let caps = sc.pop().unwrap_or(start_caps);
            if (pc < 0) {
                // Never actually hit: only the pop-on-empty fallback above produces pc < 0.
            } else if (on_list[pc] == gen) {
                // Already visited this instruction during this generation.
            } else {
                on_list[pc] = gen;
                let inst = this.prog[pc];
                if (inst.opcode == RegexOp.Nop) {
                    sp.push(inst.out);
                    sc.push(caps);
                } else if (inst.opcode == RegexOp.Alt) {
                    // Push the lower-priority branch first so the higher-priority one (`out`) is
                    // popped — and its whole epsilon-closure explored — first, matching the order
                    // a recursive depth-first walk would visit them in.
                    sp.push(inst.out1);
                    sc.push(caps);
                    sp.push(inst.out);
                    sc.push(caps);
                } else if (inst.opcode == RegexOp.Capture) {
                    let updated = this.copy_caps(caps);
                    if ((inst.cap >= 0) && (inst.cap < updated.length)) {
                        updated[inst.cap] = pos;
                    }
                    sp.push(inst.out);
                    sc.push(updated);
                } else if (inst.opcode == RegexOp.EmptyWidth) {
                    if (this.empty_ok(inst.empty_kind, pos, input, len)) {
                        sp.push(inst.out);
                        sc.push(caps);
                    }
                } else if (inst.opcode == RegexOp.Look) {
                    if (this.look_holds(inst, pos, input, len)) {
                        sp.push(inst.out);
                        sc.push(caps);
                    }
                } else {
                    // CharClass or Match: a real thread, recorded in priority order.
                    out_pcs.push(pc);
                    out_caps.push(caps);
                }
            }
        }
    }

    // Searches for a match starting exactly at `start` (the caller loops over start offsets, or
    // relies on the compiled program's own leading `.*?` — see `RegexParser.parse` — for an
    // unanchored search from position 0). Returns the leftmost, Perl-style ("leftmost-first" by
    // thread priority, not POSIX leftmost-longest) match.
    public fun find(borrow input: string, start: int): Option<RegexMatch> {
        let len = input.length;
        let ncap = 2 * (this.ngroup + 1);
        if (this.on_list.length < this.prog.length) {
            this.on_list = Buffer.alloc<int>(this.prog.length);
        }
        let on_list = this.on_list;
        let i0 = 0;
        while (i0 < this.prog.length) {
            on_list[i0] = 0 - 1;
            i0 = i0 + 1;
        }
        if (this.init_caps.length < ncap) {
            this.init_caps = Buffer.alloc<int>(ncap);
        }
        let init_caps = this.init_caps;
        let j0 = 0;
        while (j0 < ncap) {
            init_caps[j0] = 0 - 1;
            j0 = j0 + 1;
        }

        let gen = 1;
        let clist_pcs = this.clist_pcs;
        let clist_caps = this.clist_caps;
        let nlist_pcs = this.nlist_pcs;
        let nlist_caps = this.nlist_caps;
        clist_pcs.clear();
        clist_caps.clear();
        nlist_pcs.clear();
        nlist_caps.clear();
        this.add_to_threadq(clist_pcs, clist_caps, on_list, gen, 0, start, input, len, init_caps);

        let matched: Option<int[]> = Option.None;
        let pos = start;
        let going = true;
        while (going) {
            if (clist_pcs.length == 0) {
                going = false;
            } else {
                nlist_pcs.clear();
                nlist_caps.clear();
                gen = gen + 1;
                let k = 0;
                let stop = false;
                while ((k < clist_pcs.length) && (stop == false)) {
                    let pc = clist_pcs.get(k).unwrap_or(0);
                    let caps = clist_caps.get(k).unwrap_or(init_caps);
                    let inst = this.prog[pc];
                    if (inst.opcode == RegexOp.CharClass) {
                        if (pos < len) {
                            let c = input.char_at(pos);
                            if (this.char_matches(inst, c)) {
                                this.add_to_threadq(
                                    nlist_pcs,
                                    nlist_caps,
                                    on_list,
                                    gen,
                                    inst.out,
                                    pos + 1,
                                    input,
                                    len,
                                    caps
                                );
                            }
                        }
                    } else if (inst.opcode == RegexOp.Match) {
                        matched = Option.Some(caps);
                        stop = true; // lower-priority threads still queued this round can't beat it
                    }
                    k = k + 1;
                }
                // Swap queues so the next generation reuses the previous clist's capacity.
                let swap_pcs = clist_pcs;
                let swap_caps = clist_caps;
                clist_pcs = nlist_pcs;
                clist_caps = nlist_caps;
                nlist_pcs = swap_pcs;
                nlist_caps = swap_caps;
                if (pos >= len) {
                    going = false;
                } else {
                    pos = pos + 1;
                }
            }
        }

        return switch (matched) {
            Some(caps) => Option.Some(RegexMatch(caps, this.ngroup)),
            None => Option.None,
        };
    }
}
