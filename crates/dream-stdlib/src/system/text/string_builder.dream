module system.text;

// `StringBuilder` — growable UTF-8 string construction (`import system.text;`).

public class StringBuilder {
    bytes: byte[];
    // Bytes used in `bytes` (not capacity).
    count: int;
    // Unicode scalar count of the bytes written so far (`.length`).
    scalars: int;

    // Allocates an empty builder with an initial backing buffer capacity in bytes (defaults to 16).
    public constructor(capacity: int = 16) {
        let c = capacity;
        if (c < sequence_min_capacity()) {
            c = sequence_min_capacity();
        }
        this.bytes = Buffer.alloc<byte>(c);
        this.count = 0;
        this.scalars = 0;
    }

    // Number of Unicode scalars appended so far.
    public get length(): int {
        return this.scalars;
    }

    // True when nothing has been appended yet.
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Grows the backing buffer to at least `min_capacity` bytes via in-place realloc when possible.
    fun grow(min_capacity: int): void {
        let new_cap = this.bytes.length * 2;
        if (new_cap < min_capacity) {
            new_cap = min_capacity;
        }
        this.bytes = Buffer.realloc<byte>(this.bytes, new_cap);
    }

    fun ensure(extra: int): void {
        let need = this.count + extra;
        if (need > this.bytes.length) {
            this.grow(need);
        }
    }

    // Appends a single Unicode scalar as UTF-8.
    public fun append_char(c: char): void {
        let cp = c.to_int();
        if ((cp < 0) || (cp > 1114111) || ((cp >= 55296) && (cp <= 57343))) {
            cp = 65533;
        }
        if (cp < 128) {
            this.ensure(1);
            this.bytes[this.count] = (byte)cp;
            this.count = this.count + 1;
        } else if (cp < 2048) {
            this.ensure(2);
            this.bytes[this.count] = (byte)(192 + (cp / 64));
            this.bytes[this.count + 1] = (byte)(128 + (cp % 64));
            this.count = this.count + 2;
        } else if (cp < 65536) {
            this.ensure(3);
            this.bytes[this.count] = (byte)(224 + (cp / 4096));
            this.bytes[this.count + 1] = (byte)(128 + ((cp / 64) % 64));
            this.bytes[this.count + 2] = (byte)(128 + (cp % 64));
            this.count = this.count + 3;
        } else {
            this.ensure(4);
            this.bytes[this.count] = (byte)(240 + (cp / 262144));
            this.bytes[this.count + 1] = (byte)(128 + ((cp / 4096) % 64));
            this.bytes[this.count + 2] = (byte)(128 + ((cp / 64) % 64));
            this.bytes[this.count + 3] = (byte)(128 + (cp % 64));
            this.count = this.count + 4;
        }
        this.scalars = this.scalars + 1;
    }

    // Appends every UTF-8 byte of `text`, growing at most once.
    // Uses the string's cached scalar length (O(1)) instead of rescanning lead bytes.
    public fun append(borrow text: string): void {
        let byte_len = text.byte_size();
        if (byte_len <= 0) {
            return;
        }
        this.ensure(byte_len);
        string.copy_utf8(this.bytes, this.count, text, 0, byte_len);
        this.count = this.count + byte_len;
        this.scalars = this.scalars + text.length;
    }

    // Appends `byte_len` UTF-8 bytes starting at byte index `start` of `text`.
    // Bytes are bulk-copied; scalar count is derived from UTF-8 lead bytes (non-continuation).
    public fun append_utf8_slice(borrow text: string, start: int, byte_len: int): void {
        if (byte_len <= 0) {
            return;
        }
        this.ensure(byte_len);
        string.copy_utf8(this.bytes, this.count, text, start, byte_len);
        this.count = this.count + byte_len;
        let i = 0;
        let sc = 0;
        while (i < byte_len) {
            let b = text.byte_at(start + i);
            // Continuation bytes are 10xxxxxx (128..191); every other byte starts a scalar.
            if ((b < 128) || (b >= 192)) {
                sc = sc + 1;
            }
            i = i + 1;
        }
        this.scalars = this.scalars + sc;
    }

    // Appends a decimal integer without allocating an intermediate string.
    public fun append_int(n: int): void {
        if (n == 0) {
            this.append_char('0');
            return;
        }
        if ((n < 0) && ((n + 2147483647) < 0)) {
            this.append("-2147483648");
            return;
        }
        let x = n;
        if (n < 0) {
            x = 0 - n;
        }
        let buf = Buffer.alloc<byte>(12);
        let i = 0;
        while (x > 0) {
            buf[i] = (byte)(48 + (x % 10));
            x = x / 10;
            i = i + 1;
        }
        let extra = i;
        if (n < 0) {
            extra = extra + 1;
        }
        this.ensure(extra);
        if (n < 0) {
            this.bytes[this.count] = (byte)45;
            this.count = this.count + 1;
            this.scalars = this.scalars + 1;
        }
        let j = i - 1;
        while (j >= 0) {
            this.bytes[this.count] = buf[j];
            this.count = this.count + 1;
            this.scalars = this.scalars + 1;
            j = j - 1;
        }
    }

    // Appends `true` or `false`.
    // Appends `"true"` or `"false"` without allocating an intermediate string.
    public fun append_bool(v: bool): void {
        if (v) {
            this.append("true");
        } else {
            this.append("false");
        }
    }

    // Appends `text` followed by a newline character.
    public fun append_line(borrow text: string): void {
        this.append(text);
        this.append_char('\n');
    }

    // Removes every appended character, keeping the backing buffer for reuse.
    public fun clear(): void {
        this.count = 0;
        this.scalars = 0;
    }

    // Materializes the accumulated UTF-8 bytes into a single new string.
    // Passes the running scalar count so the runtime skips a second UTF-8 recount.
    public fun build(): string {
        return string.from_utf8_prefix_n(this.bytes, this.count, this.scalars);
    }

    // Object-protocol override, so `print`/`println`/`+`/interpolation all use `build()`'s output
    // automatically, without an explicit `.build()` call.
    @override public fun to_string(): string {
        return this.build();
    }
}
