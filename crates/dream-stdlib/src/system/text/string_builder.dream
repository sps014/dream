module system.text;

// `StringBuilder` — growable UTF-16 string construction (`import system.text;`).

public class StringBuilder {
    bytes: byte[];
    // Payload bytes used in `bytes` (always even; two bytes per UTF-16 unit).
    count: int;
    // UTF-16 code-unit count of the bytes written so far (`.length`).
    scalars: int;

    // Allocates an empty builder with an initial backing buffer capacity in payload bytes (defaults to 16).
    public constructor(capacity: int = 16) {
        let c = capacity;
        if (c < sequence_min_capacity()) {
            c = sequence_min_capacity();
        }
        this.bytes = Buffer.alloc<byte>(c + 4);
        this.count = 0;
        this.scalars = 0;
    }

    // Number of UTF-16 code units appended so far.
    public get length(): int {
        return this.scalars;
    }

    // True when nothing has been appended yet.
    @inline
    public fun is_empty(): bool {
        return this.count == 0;
    }

    // Grows the backing buffer to at least `min_capacity` bytes via in-place realloc when possible.
    @inline
    fun grow(min_capacity: int): void {
        let new_cap = this.bytes.length * 2;
        if (new_cap < min_capacity + 4) {
            new_cap = min_capacity + 4;
        }
        this.bytes = Buffer.realloc<byte>(this.bytes, new_cap);
    }

    @inline
    fun ensure(extra: int): void {
        let need = this.count + extra + 4;
        if (need > this.bytes.length) {
            this.grow(need);
        }
    }

    @inline
    fun write_unit(u: int): void {
        this.ensure(2);
        Buffer.store16(this.bytes, this.count + 4, u);
        this.count = this.count + 2;
        this.scalars = this.scalars + 1;
    }

    // Appends a Unicode scalar as one or two UTF-16 units.
    public fun append_char(c: char): void {
        let cp = c.to_int();
        if ((cp < 0) || (cp > 1114111)) {
            cp = 65533;
        }
        if (cp < 65536) {
            this.write_unit(cp);
            return;
        }
        let x = cp - 65536;
        this.write_unit(55296 + (x / 1024));
        this.write_unit(56320 + (x % 1024));
    }

    @intrinsic("string_builder_push")
    static extern fun push_raw(borrow sb: StringBuilder, borrow text: string): void;

    // Appends every UTF-16 unit of `text`, growing at most once.
    @inline
    public fun append(borrow text: string): void {
        StringBuilder.push_raw(this, text);
    }

    // Appends `byte_len` payload bytes starting at byte index `start` of `text`.
    public fun append_utf8_slice(borrow text: string, start: int, byte_len: int): void {
        if (byte_len <= 0) {
            return;
        }
        this.ensure(byte_len);
        string.copy_utf8(this.bytes, this.count + 4, text, start, byte_len);
        this.count = this.count + byte_len;
        this.scalars = this.scalars + (byte_len / 2);
    }

    // Appends a decimal integer without allocating an intermediate string.
    public fun append_int(n: int): void {
        if (n == 0) {
            this.append_char('0');
            return;
        }
        if ((n < 0) && ((n + 2147483647) < 0)) {
            this.append("-2147483648");
            return;
        }
        let x = n;
        if (n < 0) {
            x = 0 - n;
        }
        let buf = Buffer.alloc<int>(12);
        let i = 0;
        while (x > 0) {
            buf[i] = 48 + (x % 10);
            x = x / 10;
            i = i + 1;
        }
        if (n < 0) {
            this.write_unit(45);
        }
        let j = i - 1;
        while (j >= 0) {
            this.write_unit(buf[j]);
            j = j - 1;
        }
    }

    // Appends `"true"` or `"false"` without allocating an intermediate string.
    public fun append_bool(v: bool): void {
        if (v) {
            this.append("true");
        } else {
            this.append("false");
        }
    }

    // Appends `text` followed by a newline character.
    public fun append_line(borrow text: string): void {
        this.append(text);
        this.append_char('\n');
    }

    // Removes every appended character, keeping the backing buffer for reuse.
    @inline
    public fun clear(): void {
        this.count = 0;
        this.scalars = 0;
    }

    // Snapshot into a new string. `from_builder` copies once; do not stage through a
    // second `byte[]` (that doubled the finish memcpy).
    public fun build(): string {
        let n = this.count;
        let sc = this.scalars;
        if (n <= 0) {
            return string.empty;
        }
        return string.from_builder(this.bytes, n, sc);
    }

    @override public fun to_string(): string {
        return this.build();
    }
}
