module system.text;

// Cursor produced by `string.iterator()`.
public class StringIterator : Iterator<char> {
    text: string;
    idx: int;
    byte_off: int;

    public constructor(text: string) {
        this.text = text;
        this.idx = 0;
        this.byte_off = 0;
    }

    // Yields the next character or None.
    @next
    public fun next(): Option<char> {
        if (this.idx >= this.text.length) {
            return Option.None;
        }
        let value = string.utf8_decode_at(this.text, this.byte_off);
        this.byte_off = this.byte_off + string.utf8_width_at(this.text, this.byte_off);
        this.idx = this.idx + 1;
        return Option.Some(value);
    }
}
