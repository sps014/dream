module system;

/// Timing utilities.
public static class Time {
    /// Suspends for at least `ms` milliseconds.
    @intrinsic(Intrinsic.Sleep)
    internal static extern async fun sleep_host(ms: int): void;

    @async_host
    @runtime("delayMs")
    static extern async fun delay_host(ms: int): void;

    /// Suspends the calling task for at least `ms` milliseconds on Dream's scheduler timer.
    /// In a browser or Node module the timer runs on a virtual clock that jumps forward when
    /// every task is waiting, so it never yields to the JavaScript event loop; use `delay` to
    /// let host callbacks run. Returns `Err(CancelledError)` when `token` is cancelled first.
    public static fun sleep(
        ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, CancelledError>> {
        return Time.wait_ms(ms, CancellationToken.resolve(token), true);
    }

    /// Suspends the calling task for at least `ms` milliseconds of real time. In a browser or
    /// Node module this waits on a JavaScript timer, so the host event loop (I/O callbacks,
    /// rendering) runs meanwhile; natively it behaves like `sleep`. Returns
    /// `Err(CancelledError)` when `token` is cancelled first.
    public static fun delay(
        ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, CancelledError>> {
        return Time.wait_ms(ms, CancellationToken.resolve(token), false);
    }

    static async fun wait_ms(
        ms: int,
        token: Option<CancellationToken>,
        virtual_clock: bool
    ): Result<Unit, CancelledError> {
        if CancellationToken.is_cancelled_opt(token) {
            return Result.Err(CancelledError.cancelled());
        }
        let pending = Time.delay_host(ms);
        if virtual_clock {
            pending = Time.sleep_host(ms);
        }
        let guard = TimerGuard(pending);
        if token.is_some() {
            let result = token.unwrap().wait_void(pending).await;
            guard.close();
            return result;
        }
        pending.await;
        guard.close();
        return Result.Ok(Unit());
    }

    /// Returns a monotonically increasing timestamp in nanoseconds from an unspecified
    /// origin. Subtract two readings to measure elapsed time; it is unrelated to wall-clock
    /// dates.
    @runtime("timeNowNanos")
    static extern fun nano_time(): long;
}
