module system;

// Timing utilities.
public static class Time {
    /// Suspends for at least `ms` milliseconds.
    @intrinsic(Intrinsic.Sleep)
    public static extern async fun sleep_host(ms: int): void;

    @async_host
    @runtime("delayMs")
    static extern async fun delay_host(ms: int): void;

    // Suspends on the scheduler timer and returns cancellation instead of panicking.
    public static fun sleep(
        ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<bool, CancelledError>> {
        return Time.wait_ms(ms, CancellationToken.resolve(token), true);
    }

    // Suspends until the wall-clock timer expires or inherited cancellation is requested.
    public static fun delay(
        ms: int,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<bool, CancelledError>> {
        return Time.wait_ms(ms, CancellationToken.resolve(token), false);
    }

    static async fun wait_ms(
        ms: int,
        token: Option<CancellationToken>,
        virtual_clock: bool
    ): Result<bool, CancelledError> {
        if CancellationToken.is_cancelled_opt(token) {
            return Result.Err(CancelledError.cancelled());
        }
        let pending = Time.delay_host(ms);
        if virtual_clock {
            pending = Time.sleep_host(ms);
        }
        let guard = TimerGuard(pending);
        if token.is_some() {
            let result = token.unwrap().wait_void(pending).await;
            guard.close();
            return result;
        }
        pending.await;
        guard.close();
        return Result.Ok(true);
    }

    // Returns a high-resolution, monotonically increasing timestamp in nanoseconds.
    // Useful for benchmarking and measuring elapsed time.
    @runtime("timeNowNanos")
    static extern fun nano_time(): long;
}

// Cancelling a timer frame must also release the scheduler/host timer that owns its wakeup.
// The guarded host/timer future cannot capture its owner.
@allow_cycle
class TimerGuard {
    pending: Future<void>;

    internal constructor(pending: Future<void>) {
        this.pending = pending;
    }

    internal fun close(): void {
        Promise.cancel(this.pending);
    }

    del() {
        this.close();
    }
}
