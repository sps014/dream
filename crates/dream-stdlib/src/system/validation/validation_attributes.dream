module system.validation;

/// Inclusive lower numeric bound.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct MinimumAttribute { public value: double; }

/// Inclusive upper numeric bound.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct MaximumAttribute { public value: double; }

/// Minimum string or collection length.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct MinLengthAttribute { public value: int; }

/// Maximum string or collection length.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct MaxLengthAttribute { public value: int; }

/// Regular expression required for a string.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct PatternAttribute { public value: string; }

/// JSON encoded field default, applied only when the property is absent.
@attribute(AttributeTarget.Field, AttributeTarget.Parameter)
public struct DefaultJsonAttribute { public value: string; }

/// Permits additional input properties on a model; the default is to reject them.
@attribute(AttributeTarget.Class, AttributeTarget.Struct)
public struct AllowExtraAttribute {}

/// A synchronous field validator returning an optional error message.
@attribute(AttributeTarget.Field)
public struct ValidateWithAttribute { public validator: DeclarationPath; }

/// A static model validator returning structured issues after fields pass validation.
@attribute(AttributeTarget.StaticMethod)
public struct ModelValidatorAttribute {}
