module system.validation;

/// Deterministically ordered input errors without echoing sensitive submitted values.
public class ValidationErrors: Error {
    /// Validation failures, in discovery order.
    public issues: List<ValidationIssue>;

    /// Creates a `ValidationErrors` with default settings.
    public constructor() {
        this.issues = List<ValidationIssue>();
    }

    /// Appends an issue with the supplied location, code, and message.
    public fun add(location: List<string>, code: string, message: string): void {
        this.issues.push(ValidationIssue(location, code, message));
    }

    /// Returns whether there are no elements.
    public fun is_empty(): bool {
        return this.issues.is_empty();
    }

    /// Returns `EVALIDATION`, the code shared by every input validation failure.
    public fun code(): string {
        return "EVALIDATION";
    }

    /// Returns each issue as `location: message`, joined with `; `, with location parts joined
    /// by `.`. An empty collection returns `validation failed`.
    public fun message(): string {
        if this.issues.is_empty() {
            return "validation failed";
        }
        let parts = List<string>();
        for (let issue in this.issues) {
            parts.push(issue.location.join(".") + ": " + issue.message);
        }
        return parts.join("; ");
    }

    /// Returns validation issues as JSON, including their location, code, and message.
    public fun to_json(): JsonValue {
        let details = JsonValue.array();
        for (let issue in this.issues) {
            let entry = JsonValue.dict();
            let location = JsonValue.array();
            for (let item in issue.location) {
                location.push(JsonValue.from_string(item));
            }
            entry["loc"] = location;
            entry["type"] = JsonValue.from_string(issue.code);
            entry["msg"] = JsonValue.from_string(issue.message);
            details.push(entry);
        }
        let result = JsonValue.dict();
        result["detail"] = details;
        return result;
    }
}
