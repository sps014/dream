module system.validation;

/// One input failure; locations use JSON property names and decimal collection indices.
@json
public class ValidationIssue {
    public location: List<string>;
    public code: string;
    public message: string;
    public constructor(location: List<string>, code: string, message: string) { this.location = location; this.code = code; this.message = message; }
}

/// Deterministically ordered input errors without echoing sensitive submitted values.
public class ValidationErrors {
    public issues: List<ValidationIssue>;
    public constructor() { this.issues = List<ValidationIssue>(); }
    public fun add(location: List<string>, code: string, message: string): void { this.issues.push(ValidationIssue(location, code, message)); }
    public fun is_empty(): bool { return this.issues.is_empty(); }
    public fun to_json(): JsonValue {
        let details = JsonValue.array();
        for (let issue in this.issues) {
            let entry = JsonValue.dict(); let location = JsonValue.array();
            for (let item in issue.location) { location.push(JsonValue.from_string(item)); }
            entry.set("loc", location); entry.set("type", JsonValue.from_string(issue.code)); entry.set("msg", JsonValue.from_string(issue.message)); details.push(entry);
        }
        let result = JsonValue.dict(); result.set("detail", details); return result;
    }
}
