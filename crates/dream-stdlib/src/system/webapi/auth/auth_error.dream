module system.webapi.auth;

/// Authentication failures carry stable codes without credential values.
public class AuthError: Error {
    _code: string;
    _message: string;

    /// Creates an error with a stable `code` such as `EAUTH` and a readable `message`. Neither
    /// should contain passwords, tokens, or other credentials.
    public constructor(code: string, message: string) {
        this._code = code;
        this._message = message;
    }

    /// Returns the stable machine code, such as `EAUTH` or `EINVAL`.
    public fun code(): string {
        return this._code;
    }

    /// Returns the readable explanation of the failure.
    public fun message(): string {
        return this._message;
    }
}
