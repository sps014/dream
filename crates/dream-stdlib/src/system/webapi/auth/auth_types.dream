module system.webapi.auth;

/// Authentication failures carry stable codes without credential values.
public class AuthError {
    /// Error code identifying the failure.
    public code: string;
    /// Human-readable explanation of the result or failure.
    public message: string;
    /// Creates a `AuthError` with `code`, `message`.
    public constructor(code: string, message: string) {
        this.code = code;
        this.message = message;
    }
}

/// Verified identity and application-defined space-separated permission scopes.
@json
public class AuthPrincipal {
    /// Stable identifier of the authenticated account.
    public subject: string;
    /// Space-separated permissions granted to this account or token.
    public scopes: string;
    /// Creates a `AuthPrincipal` with `subject`, `scopes`.
    public constructor(subject: string, scopes: string) {
        this.subject = subject;
        this.scopes = scopes;
    }

    /// Returns whether the space-separated scope list includes `scope`.
    public fun has_scope(scope: string): bool {
        for (let item in this.scopes.split(' ')) {
            if item == scope {
                return true;
            }
        }
        return false;
    }
}

/// Persisted account data supplied by an application repository.
public class AuthAccount {
    /// Stable identifier of the authenticated account.
    public subject: string;
    /// Encoded password hash; never a plain-text password.
    public password_hash: string;
    /// Space-separated permissions granted to this account or token.
    public scopes: string;
    /// Creates a `AuthAccount` with `subject`, `password_hash`, `scopes`.
    public constructor(subject: string, password_hash: string, scopes: string = "") {
        this.subject = subject;
        this.password_hash = password_hash;
        this.scopes = scopes;
    }
}

/// Local lookup and explicit external-identity linking are application policy.
public interface AuthAccounts {
    /// Looks up an account by login name; returns `AuthError` if authentication cannot proceed.
    async unique fun find_login(login: string): Result<AuthAccount, AuthError>;
    /// Resolves an external identity to a local account, returning an authentication error on
    /// failure.
    async unique fun link_identity(
        issuer: string,
        subject: string,
        email: string,
        email_verified: bool
    ): Result<AuthAccount, AuthError>;
}

/// A refresh-token record. Stores contain only the digest of the bearer secret.
public class AuthSession {
    /// Hash of the refresh token; the raw refresh token is not stored.
    public hash: string;
    /// Identifier shared by successive refresh tokens for the same session.
    public family: string;
    /// Stable identifier of the authenticated account.
    public subject: string;
    /// Space-separated permissions granted to this account or token.
    public scopes: string;
    /// Expiry time in Unix epoch seconds.
    public expires: long;
    /// Secret used to validate requests made with session cookies.
    public csrf: string;
    /// Whether this refresh session has already been rotated.
    public consumed: bool;
    /// Creates a `AuthSession` with `hash`, `family`, `subject`, `scopes`, `expires`, `csrf`.
    public constructor(
        hash: string,
        family: string,
        subject: string,
        scopes: string,
        expires: long,
        csrf: string
    ) {
        this.hash = hash;
        this.family = family;
        this.subject = subject;
        this.scopes = scopes;
        this.expires = expires;
        this.csrf = csrf;
        this.consumed = false;
    }
}

/// An expiring, browser-bound OIDC authorization transaction.
public class OidcTransaction {
    /// Name of the identity provider handling this login.
    public provider: string;
    /// Random value used to bind an identity response to its login request.
    public nonce: string;
    /// PKCE verifier kept until the authorization code is exchanged.
    public verifier: string;
    /// Expiry time in Unix epoch seconds.
    public expires: long;
    /// Creates a `OidcTransaction` with `provider`, `nonce`, `verifier`, `expires`.
    public constructor(provider: string, nonce: string, verifier: string, expires: long) {
        this.provider = provider;
        this.nonce = nonce;
        this.verifier = verifier;
        this.expires = expires;
    }
}

/// Persistence operations must be atomic, including refresh replay detection and transaction consumption.
public interface AuthSessionStore {
    /// Stores a new refresh session; returns an error if its token hash already exists.
    async unique fun create(session: AuthSession): Result<bool, AuthError>;
    /// Finds an unexpired session at epoch-second time `now`; rejects revoked or missing
    /// sessions.
    async unique fun find(hash: string, now: long): Result<AuthSession, AuthError>;
    /// Consumes a refresh session and stores its replacement. Replay revokes the family;
    /// invalid replacements return an error.
    async unique fun rotate(
        hash: string,
        replacement: AuthSession,
        now: long
    ): Result<AuthSession, AuthError>;
    /// Revokes all refresh sessions in `family`.
    async unique fun revoke(family: string): Result<bool, AuthError>;
    /// Returns whether `family` has an unexpired, unconsumed session at epoch-second time
    /// `now`.
    async unique fun active(family: string, now: long): bool;
    /// Stores a login transaction under `state`; duplicate state returns an error.
    async unique fun put_transaction(
        state: string,
        transaction: OidcTransaction
    ): Result<bool, AuthError>;
    /// Removes and returns the login transaction. Missing or expired state returns an error.
    async unique fun take_transaction(state: string, now: long): Result<OidcTransaction, AuthError>;
}

/// Native JWT configuration; RS256 uses PEM keys, HS256 requires an explicit 32-byte minimum secret.
public class JwtOptions {
    /// Identity of the token issuer.
    public issuer: string;
    /// Expected token audience.
    public audience: string;
    /// Private key used to sign tokens; keep it secret.
    public signing_key: string;
    /// Public key used to verify token signatures.
    public verification_key: string;
    /// Signature algorithm name, such as `RS256`.
    public algorithm: string;
    /// Creates a `JwtOptions` with `issuer`, `audience`, `signing_key`, `verification_key`,
    /// `algorithm`.
    public constructor(
        issuer: string,
        audience: string,
        signing_key: string,
        verification_key: string,
        algorithm: string = "RS256"
    ) {
        this.issuer = issuer;
        this.audience = audience;
        this.signing_key = signing_key;
        this.verification_key = verification_key;
        this.algorithm = algorithm;
    }
}

/// One external OIDC identity provider. Redirect URIs must match the registered callback exactly.
public class OidcOptions {
    /// Name identifying this entry.
    public name: string;
    /// Identity of the token issuer.
    public issuer: string;
    /// Application identifier registered with the identity provider.
    public client_id: string;
    /// Confidential client credential; keep this value secret.
    public client_secret: string;
    /// Registered callback URL receiving the authorization response.
    public redirect_uri: string;
    /// Creates a `OidcOptions` with `name`, `issuer`, `client_id`, `redirect_uri`,
    /// `client_secret`.
    public constructor(
        name: string,
        issuer: string,
        client_id: string,
        redirect_uri: string,
        client_secret: string = ""
    ) {
        this.name = name;
        this.issuer = issuer;
        this.client_id = client_id;
        this.redirect_uri = redirect_uri;
        this.client_secret = client_secret;
    }
}

/// Credentials returned after authentication or refresh. Keep refresh and CSRF tokens secret.
@json
public class AuthTokens {
    /// Signed token sent with authenticated requests.
    public access_token: string;
    /// Secret used to obtain a new access token.
    public refresh_token: string;
    /// Authorization scheme returned with the tokens, usually `Bearer`.
    public token_type: string;
    /// Access token lifetime in seconds.
    public expires_in: int;
    /// Token the browser must send to protect cookie-authenticated requests.
    public csrf_token: string;
    /// Creates a `AuthTokens` with `access_token`, `refresh_token`, `token_type`, `expires_in`,
    /// `csrf_token`.
    public constructor(
        access_token: string,
        refresh_token: string,
        token_type: string,
        expires_in: int,
        csrf_token: string
    ) {
        this.access_token = access_token;
        this.refresh_token = refresh_token;
        this.token_type = token_type;
        this.expires_in = expires_in;
        this.csrf_token = csrf_token;
    }
}
