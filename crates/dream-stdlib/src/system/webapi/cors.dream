module system.webapi;

// FastAPI / Starlette `CORSMiddleware` options. Origins, methods, and headers are comma-separated
// (`"*"` means any). `allow_credentials` cannot be combined with origin `*` (the request Origin is
// echoed instead, matching Starlette).
public class CorsOptions {
    /// Allowed request origins, or `*` for any origin.
    public allow_origins: string;

    /// Allowed HTTP methods, or `*` to allow all.
    public allow_methods: string;

    /// Allowed request headers, or `*` to allow all.
    public allow_headers: string;

    /// Response headers that browsers may expose to cross-origin callers.
    public expose_headers: string;

    /// Whether cross-origin requests may include credentials.
    public allow_credentials: bool;

    /// How long browsers may cache preflight results, in seconds.
    public max_age: int;

    /// Creates a `CorsOptions` with `allow_origins`, `allow_methods`, `allow_headers`,
    /// `expose_headers`, `allow_credentials`, `max_age`.
    public constructor(
        allow_origins: string = "*",
        allow_methods: string = "*",
        allow_headers: string = "*",
        expose_headers: string = "",
        allow_credentials: bool = false,
        max_age: int = 600
    ) {
        this.allow_origins = allow_origins;
        this.allow_methods = allow_methods;
        this.allow_headers = allow_headers;
        this.expose_headers = expose_headers;
        this.allow_credentials = allow_credentials;
        this.max_age = max_age;
    }
}

/// Middleware applying cross-origin access rules to requests and preflight responses.
public class Cors {
    opts: CorsOptions;

    /// Creates a `Cors` with `opts`.
    public constructor(opts: CorsOptions) {
        this.opts = opts;
    }

    /// Runs this middleware for `ctx`, using `next` to continue the request pipeline.
    public fun invoke(borrow ctx: RequestContext, borrow next: Next): Future<HttpOutgoing> {
        return Cors.invoke_owned(this, ctx, next);
    }

    static async fun invoke_owned(cors: Cors, ctx: RequestContext, next: Next): HttpOutgoing {
        let origin = ctx.incoming.header("Origin").unwrap_or("");
        if origin.is_empty() {
            return next.call().await;
        }
        if !Cors.origin_ok(cors.opts, origin) {
            if Cors.is_preflight(ctx) {
                return HttpOutgoing.empty(400);
            }
            return next.call().await;
        }
        if Cors.is_preflight(ctx) {
            return cors.preflight(ctx, origin);
        }
        let res = next.call().await;
        cors.apply_simple(res, origin);
        return res;
    }

    static fun is_preflight(ctx: RequestContext): bool {
        if ctx.incoming.method != "OPTIONS" {
            return false;
        }
        return ctx.incoming.header("Access-Control-Request-Method").is_some();
    }

    static fun origin_ok(opts: CorsOptions, origin: string): bool {
        let raw = opts.allow_origins.trim();
        if raw == "*" {
            return true;
        }
        let parts = raw.split(',');
        let i = 0;
        while i < parts.length {
            if parts[i].trim() == origin {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    fun allow_origin_value(origin: string): string {
        if this.opts.allow_credentials {
            return origin;
        }
        if this.opts.allow_origins.trim() == "*" {
            return "*";
        }
        return origin;
    }

    fun apply_simple(res: HttpOutgoing, origin: string): void {
        res.set_header("Access-Control-Allow-Origin", this.allow_origin_value(origin));
        if this.opts.allow_credentials {
            res.set_header("Access-Control-Allow-Credentials", "true");
        }
        let expose = this.opts.expose_headers.trim();
        if !expose.is_empty() {
            res.set_header("Access-Control-Expose-Headers", expose);
        }
        if this.opts.allow_origins.trim() != "*" || this.opts.allow_credentials {
            res.set_header("Vary", "Origin");
        }
    }

    fun preflight(ctx: RequestContext, origin: string): HttpOutgoing {
        let res = HttpOutgoing.empty(200);
        this.apply_simple(res, origin);
        let methods = this.opts.allow_methods.trim();
        if methods == "*" {
            methods = "GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS";
        }
        res.set_header("Access-Control-Allow-Methods", methods);
        let req_headers = ctx.incoming.header("Access-Control-Request-Headers").unwrap_or("");
        let allow_h = this.opts.allow_headers.trim();
        if allow_h == "*" {
            if req_headers.is_empty() {
                allow_h = "*";
            } else {
                allow_h = req_headers;
            }
        }
        if !allow_h.is_empty() {
            res.set_header("Access-Control-Allow-Headers", allow_h);
        }
        res.set_header("Access-Control-Max-Age", this.opts.max_age.to_string());
        return res;
    }
}

// `app.use(CORS(CorsOptions())).unwrap()` — same role as FastAPI `add_middleware(CORSMiddleware, ...)`.
public fun CORS(opts: CorsOptions): Middleware {
    return Middleware(
        async (borrow ctx: RequestContext, borrow next: Next) => {
            return Cors(opts).invoke(ctx, next).await;
        }
    );
}
