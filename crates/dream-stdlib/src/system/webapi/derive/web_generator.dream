module system.webapi.derive;
import system;
import system.codegen;
import system.webapi;
import system.json;

internal class WebGenerator {
    internal functions: Map<string, GenFunction>;
    internal calls: Map<string, string>;
    internal declarations: Map<string, GenDecl>;
    internal routes: List<WebRoute>;
    internal owners: Map<int, string>;
    internal schemas: JsonValue;
    internal security_schemes: JsonValue;
    internal replacements: Map<string, List<GenFunction>>;
    internal imports: CodeBuilder;
    internal type_aliases: Map<string, string>;
    internal source: CodeBuilder;
    internal sequence: int;
    internal colors: Map<string, int>;

    internal constructor() {
        this.functions = Map<string, GenFunction>();
        this.calls = Map<string, string>();
        this.declarations = Map<string, GenDecl>();
        this.routes = List<WebRoute>();
        this.owners = Map<int, string>();
        this.replacements = Map<string, List<GenFunction>>();
        this.schemas = JsonValue.dict();
        this.security_schemes = JsonValue.dict();
        this.source = CodeBuilder();
        this.imports = CodeBuilder();
        this.imports.line("module system.webapi;");
        this.type_aliases = Map<string, string>();
        this.sequence = 0;
        this.colors = Map<string, int>();
    }

    internal fun fresh(): string {
        let value = "__web_v" + this.sequence.to_string();
        this.sequence = this.sequence + 1;
        return value;
    }

    internal fun remember(f: GenFunction, owner: string): void {
        if this.functions.contains(f.id) {
            return;
        }
        let call = f.name;
        if !owner.is_empty() {
            call = owner + "." + f.name;
        } else {
            let split = f.id.index_of("::").unwrap_or(0);
            let module_name = f.id.substring(0, split);
            if !module_name.is_empty() {
                call = "__web_call" + this.calls.length.to_string();
                this.imports.line("import " + module_name + "." + f.name + " as " + call + ";");
            }
        }
        this.calls[f.id] = call;
        this.functions[f.id] = f;
    }

    internal fun owner_name(d: GenDecl): string {
        if d.module_name.is_empty()
            || d.module_name == "system" || d.module_name.starts_with("system.") {
            return d.name;
        }
        if this.type_aliases.contains(d.id) {
            return this.type_aliases.get(d.id).unwrap();
        }
        let alias = "__web_type" + this.type_aliases.length.to_string();
        this.type_aliases[d.id] = alias;
        this.imports.line("import " + d.module_name + "." + d.name + " as " + alias + ";");
        return alias;
    }

    internal fun type_code(ctx: GenContext, ty: GenTypeRef): string {
        if ty.kind == TypeRefKind.Array {
            return this.type_code(ctx, ty.arg(0)) + "[]";
        }
        if ty.kind == TypeRefKind.Tuple || ty.kind == TypeRefKind.Function {
            let result = "(";
            if ty.kind == TypeRefKind.Function {
                result = "fun(";
            }
            let end = ty.args.length;
            if ty.kind == TypeRefKind.Function {
                end--;
            }
            let i = 0;
            while i < end {
                if i > 0 {
                    result = result + ", ";
                }
                result = result + this.type_code(ctx, ty.arg(i));
                i++;
            }
            result = result + ")";
            if ty.kind == TypeRefKind.Function {
                result = result + ": " + this.type_code(ctx, ty.arg(end));
            }
            return result;
        }
        let name = ty.name;
        if !ty.decl.is_empty() {
            let declaration = this.declaration(ctx, ty);
            if declaration.is_some() {
                name = this.owner_name(declaration.unwrap());
            }
        }
        if !ty.args.is_empty() {
            name = name + "<";
            let i = 0;
            for (let arg in ty.args) {
                if i > 0 {
                    name = name + ", ";
                }
                name = name + this.type_code(ctx, arg);
                i++;
            }
            name = name + ">";
        }
        return name;
    }

    internal fun declaration(ctx: GenContext, ty: GenTypeRef): Option<GenDecl> {
        if ty.decl.is_empty() {
            return Option.None;
        }
        if this.declarations.contains(ty.decl) {
            return this.declarations.get(ty.decl);
        }
        let symbol = ctx.find_symbol(ty.decl);
        if symbol.is_none() {
            return Option.None;
        }
        let declaration = symbol.unwrap().declaration;
        if declaration.is_some() {
            this.declarations[ty.decl] = declaration.unwrap();
        }
        return declaration;
    }
}
