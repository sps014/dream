module system.webapi.derive;
import system;
import system.codegen;
import system.webapi;
import system.json;

extend WebGenerator {
    internal fun emit_routes(): void {
        this.imports.line("import system.webapi;");
        this.imports.line("import system.net;");
        this.imports.line("import system.json;");
        this.imports.line("import system.validation;");
        this.imports.line("import system.encoding;");
        this.imports.line("import system.collections;");
        for (let route in this.routes) {
            let out = this.source;
            out.line("@native");
            out.line(
                "internal async fun __web_leaf"
                    + route.index.to_string()
                    + "(ctx: RequestContext, params: Map<string, string>): HttpOutgoing {"
            );
            if route.function.has<RequiresScopesAttribute>() {
                out.line(
                    "ctx.set(\"auth.required_scopes\", "
                        + web_quote(
                            route.function.attribute<RequiresScopesAttribute>().unwrap().scopes
                        ) + ");"
                );
            }
            let args = this.arguments(route.function, out, Map<string, string>(), route);
            let call = this.calls.get(route.function.id).unwrap() + "(" + args + ")";
            let ty = web_return_type(route.function);
            let stream = ty.name == "AsyncIterable" || ty.name == "Iterable";
            if route.function.is_async && !stream {
                call = call + ".await";
            }
            if route.websocket {
                out.line(call + ";");
                out.line("return HttpOutgoing.already_sent();");
            } else if stream {
                this.emit_stream(route, call, out);
            } else if ty.kind == TypeRefKind.Void {
                let status = 204;
                if route.function.has<OperationAttribute>() {
                    status = route.function.attribute<OperationAttribute>()
                        .unwrap()
                        .status.unwrap_or(204);
                }
                out.line(call + ";");
                out.line("return HttpOutgoing.empty(" + status.to_string() + ");");
            } else {
                out.line("let result = " + call + ";");
                if ty.name == "Result" {
                    if ty.arg(1).name == nameof(HttpStatus) {
                        out.line(
                            "if result.is_err() { return HttpOutgoing.from_status(result.unwrap_err()); }"
                        );
                    } else {
                        out.line(
                            "if result.is_err() { return HttpOutgoing.detail(result.unwrap_err().to_string(), 500); }"
                        );
                    }
                    this.emit_value(ty.arg(0), "result.unwrap()", out);
                } else {
                    this.emit_value(ty, "result", out);
                }
            }
            out.line("}");
            out.line(
                "@native public async fun __web_route"
                    + route.index.to_string()
                    + "(ctx: RequestContext, params: Map<string, string>): HttpOutgoing {"
            );
            out.line("let chain = List<Middleware>();");
            for (let use in route.uses) {
                out.line(
                    "chain.push(Middleware(" + this.calls.get(use.handler.symbol).unwrap() + "));"
                );
            }
            out.line(
                "let leaf: fun(): Future<HttpOutgoing> = async () => { return __web_leaf"
                    + route.index.to_string() + "(ctx, params).await; };"
            );
            if route.function.has<OperationAttribute>()
                && route.function.attribute<OperationAttribute>()
                .unwrap()
                .status.is_some() {
                out.line(
                    "let response = WebApp.run_middleware(ctx, chain, 0, leaf).await; if response.status == 200 { response.status = "
                        + route.function.attribute<OperationAttribute>()
                        .unwrap()
                        .status.unwrap()
                        .to_string() + "; } return response; }"
                );
            } else {
                out.line("return WebApp.run_middleware(ctx, chain, 0, leaf).await; }");
            }
        }
    }

    internal fun emit_value(ty: GenTypeRef, value: string, out: CodeBuilder): void {
        if ty.name == nameof(HttpOutgoing) {
            out.line("return " + value + ";");
        } else if ty.name == nameof(HttpStatus) {
            out.line("return HttpOutgoing.from_status(" + value + ");");
        } else if ty.name == "string" {
            out.line("return HttpOutgoing.text(" + value + ");");
        } else if ty.display == "byte[]" {
            out.line("return HttpOutgoing.bytes(" + value + ");");
        } else {
            out.line("return HttpOutgoing.json_text(Json.serialize(" + value + "));");
        }
    }

    internal fun emit_stream(route: WebRoute, call: string, out: CodeBuilder): void {
        let ty = route.function.ret;
        let elem = ty.arg(0);
        let content_type = "application/octet-stream";
        if elem.name == "SseEvent" {
            content_type = "text/event-stream";
        } else if elem.name == "string" {
            content_type = "text/plain; charset=utf-8";
        } else if elem.display != "byte[]" {
            this.ctx.error_at(
                route.function.id,
                "streaming routes must yield SseEvent, string, or byte[]"
            );
            return;
        }
        if route.function.has<ProducesAttribute>() && elem.name != "SseEvent" {
            content_type = route.function.attribute<ProducesAttribute>().unwrap().content_type;
        }
        out.line(
            "let stream_response = HttpOutgoing.empty(200).set_header(\"Content-Type\", "
                + web_quote(content_type) + ");"
        );
        out.line(
            "let started = WebOperation.submit(WebApp.response_request(\"stream_begin\", ctx.incoming.req_id, stream_response), [], ctx.cancellation_token).await;"
        );
        out.line("if started.is_err() { return HttpOutgoing.already_sent(); }");
        let prefix = "for";
        if ty.name == "AsyncIterable" {
            prefix = "await for";
        }
        out.line(prefix + " (let item in " + call + ") {");
        let chunk = "item";
        if elem.name == "SseEvent" {
            chunk = "Encoding.utf8_encode(item.wire())";
        } else if elem.name == "string" {
            chunk = "Encoding.utf8_encode(item)";
        }
        out.line(
            "let written = WebOperation.submit(WebOperation.request(\"stream_write\", ctx.incoming.req_id), "
                + chunk + ", ctx.cancellation_token).await;"
        );
        out.line("if written.is_err() { break; }");
        out.line("}");
        out.line(
            "WebOperation.submit(WebOperation.request(\"stream_end\", ctx.incoming.req_id), [], ctx.cancellation_token).await;"
        );
        out.line("return HttpOutgoing.already_sent();");
    }

    internal fun emit_routers(): void {
        for (let d in this.ctx.decls()) {
            if !d.has<RouterAttribute>() {
                continue;
            }
            let out = CodeBuilder();
            out.line("public static fun router(): WebRouter {");
            out.line("let routes = List<WebEndpoint>();");
            let paths = Json.deserialize<JsonValue>(this.openapi(d.id)).unwrap();
            for (let route in this.routes) {
                if this.owners.get(route.index).unwrap_or("") != d.id {
                    continue;
                }
                out.line(
                    "routes.push(WebEndpoint("
                        + web_quote(route.method)
                        + ", "
                        + web_quote(route.path)
                        + ", __web_route"
                        + route.index.to_string()
                        + ", "
                        + web_quote(
                            Json.serialize(
                                paths.get("paths").unwrap_or(JsonValue.null())
                                    .get(route.path).unwrap_or(JsonValue.null())
                                    .get(route.method.to_lower()).unwrap_or(JsonValue.null())
                            )
                        )
                        + ", "
                        + route.websocket.to_string()
                        + ", "
                        + web_quote(Json.serialize(paths.get("components").unwrap_or(JsonValue.null())))
                        + ")); "
                );
            }
            out.line("return WebRouter(routes); }");
            this.ctx.emit_extend(d, out.to_string());
        }
    }
}
