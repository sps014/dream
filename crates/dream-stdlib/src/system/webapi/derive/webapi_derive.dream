module system.webapi.derive;
import system;
import system.codegen;
import system.webapi;
import system.json;

@generator
@incremental
@on_attribute(WebApiAttribute, GetAttribute, PostAttribute, PutAttribute, PatchAttribute, DeleteAttribute, HeadAttribute, OptionsAttribute, WebsocketAttribute, HttpGroupAttribute, MiddlewareAttribute, UseAttribute, DepAttribute)
public fun webapi_derive(ctx: GenContext): void {
    let gen = WebGenerator(ctx);
    gen.collect();
    gen.validate_dependencies();
    if ctx.has_errors() { return; }
    gen.emit_routes();
    if ctx.has_errors() { return; }
    let app = ctx.find_symbol(declof(WebApp));
    if app.is_none() || app.unwrap().declaration.is_none() { ctx.error("system.webapi WebApp declaration is missing"); return; }
    let methods = CodeBuilder();
    gen.emit_dispatch(methods);
    gen.emit_middleware(methods);
    methods.line("internal static fun generated_openapi_paths(): string { return " + web_quote(gen.openapi()) + "; }");
    gen.emit_entry_points(methods);
    ctx.emit_extend(app.unwrap().declaration.unwrap(), methods.to_string());
    ctx.emit_file("routes.dream", gen.source.to_string());
}

internal class WebRoute {
    internal function: GenFunction;
    internal method: string;
    internal path: string;
    internal uses: List<UseAttribute>;
    internal websocket: bool;
    internal index: int;
    internal constructor(function: GenFunction, method: string, path: string, uses: List<UseAttribute>, websocket: bool, index: int) {
        this.function = function; this.method = method; this.path = path; this.uses = uses; this.websocket = websocket; this.index = index;
    }
}

internal class WebGenerator {
    internal ctx: GenContext;
    internal functions: Map<string, GenFunction>;
    internal calls: Map<string, string>;
    internal declarations: Map<string, GenDecl>;
    internal routes: List<WebRoute>;
    internal middleware: List<GenFunction>;
    internal source: CodeBuilder;
    internal sequence: int;
    internal colors: Map<string, int>;
    internal constructor(ctx: GenContext) {
        this.ctx = ctx; this.functions = Map<string, GenFunction>(); this.calls = Map<string, string>();
        this.declarations = Map<string, GenDecl>(); this.routes = List<WebRoute>(); this.middleware = List<GenFunction>();
        this.source = CodeBuilder(); this.source.line("module system.webapi;"); this.sequence = 0; this.colors = Map<string, int>();
    }
    internal fun fresh(): string { let value = "__web_v" + this.sequence.to_string(); this.sequence = this.sequence + 1; return value; }
    internal fun remember(f: GenFunction, owner: string): void {
        if this.functions.contains(f.id) { return; }
        this.functions.set(f.id, f);
        let call = f.name;
        if !owner.is_empty() { call = owner + "." + f.name; }
        else {
            let split = f.id.index_of("::").unwrap_or(0);
            let module_name = f.id.substring(0, split);
            if !module_name.is_empty() {
                call = "__web_call" + this.calls.length.to_string();
                this.source.line("import " + module_name + "." + f.name + " as " + call + ";");
            }
        }
        this.calls.set(f.id, call);
    }
    internal fun declaration(ty: GenTypeRef): Option<GenDecl> {
        if ty.decl.is_empty() { return Option.None; }
        if this.declarations.contains(ty.decl) { return this.declarations.get(ty.decl); }
        let symbol = this.ctx.find_symbol(ty.decl);
        if symbol.is_none() { return Option.None; }
        let declaration = symbol.unwrap().declaration;
        if declaration.is_some() { this.declarations.set(ty.decl, declaration.unwrap()); }
        return declaration;
    }
}

internal fun web_quote(text: string): string { return Json.serialize(JsonValue.from_string(text)); }
internal fun web_return_type(f: GenFunction): GenTypeRef { return f.ret; }
internal fun web_inner(ty: GenTypeRef): GenTypeRef { if ty.is_option() { return ty.arg(0); } return ty; }
internal fun web_scalar(ty: GenTypeRef): bool {
    let name = web_inner(ty).name;
    return name == "string" || name == "int" || name == "long" || name == "bool" || name == "double" || name == "float" || name == "uint" || name == "ulong" || name == "byte";
}
internal fun web_join(prefix: string, path: string): string {
    while prefix.ends_with("/") { prefix = prefix.substring(0, prefix.length - 1); }
    if !path.starts_with("/") { path = "/" + path; }
    if path == "/" && !prefix.is_empty() { return prefix; }
    return prefix + path;
}
