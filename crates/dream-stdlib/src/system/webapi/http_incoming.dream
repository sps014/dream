module system.webapi;

/// Headers and routing fields for one owned inbound HTTP request.
public class HttpIncoming {
    /// Identifier of the active HTTP request.
    public req_id: int;

    /// HTTP request method.
    public method: string;

    /// Request or resource path.
    public path: string;

    /// Query string supplied with the request.
    public query: string;

    /// HTTP headers associated with this message.
    public headers: HttpHeaders;

    form_data: Option<FormData>;
    internal cancellation_token: Option<CancellationToken>;

    // Decodes the host's request record after its version byte: `[id][method code][method
    // text when the code is 0][path][query][headers]`, matching `http_server::request::record`.
    // The caller checks `metadata.at_end()`; the id is kept either way so `del` releases it.
    internal constructor(borrow metadata: WireReader) {
        this.req_id = metadata.i32();
        this.method = HttpIncoming.method_name(metadata);
        this.path = metadata.text();
        this.query = metadata.text();
        this.headers = HttpHeaders.read_wire(metadata);
        this.form_data = Option.None;
        this.cancellation_token = Option.None;
    }

    static fun method_name(borrow metadata: WireReader): string {
        let code = metadata.u8();
        if code == 1 {
            return "GET";
        }
        if code == 2 {
            return "HEAD";
        }
        if code == 3 {
            return "POST";
        }
        if code == 4 {
            return "PUT";
        }
        if code == 5 {
            return "DELETE";
        }
        if code == 6 {
            return "PATCH";
        }
        if code == 7 {
            return "OPTIONS";
        }
        if code == 8 {
            return "CONNECT";
        }
        if code == 9 {
            return "TRACE";
        }
        return metadata.text();
    }

    @native
    @runtime("httpServerReleaseRequest")
    static extern fun release_host(id: int): void;

    del() {
        if this.req_id > 0 {
            HttpIncoming.release_host(this.req_id);
        }
    }

    /// Returns the first decoded query value with this name.
    public fun query_param(name: string): Option<string> {
        let url = Url.parse("http://localhost/?" + this.query);
        if url.is_err() {
            return Option.None;
        }
        return url.unwrap().query.get(name);
    }

    /// Returns the first matching request header.
    public fun header(name: string): Option<string> {
        return this.headers.get(name);
    }

    /// Returns a named cookie, without decoding its value.
    public fun cookie(name: string): Option<string> {
        return WebRouting.cookie_value(this.headers.get("Cookie").unwrap_or(""), name);
    }

    internal fun resolve_token(token: Option<CancellationToken>): Option<CancellationToken> {
        let effective = CancellationToken.resolve(token);
        if effective.is_some() {
            return effective;
        }
        return this.cancellation_token;
    }

    /// Reads the whole request body as bytes and caches it; later calls return the same bytes.
    /// The server sets no size limit, so bound large bodies at a proxy or read them with
    /// `stream`. Fails with `ECLOSED` after `stream` was read.
    @native
    public fun read_body_bytes(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<byte[], IoError>> {
        return HttpIncoming.read_owned(this, this.resolve_token(token));
    }

    static async fun read_owned(
        incoming: HttpIncoming,
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        return WebOperation.submit(
            WebOperation.request(WebAction.ReadBody, incoming.req_id),
            [],
            token
        ).await;
    }

    /// Reads the whole request body as UTF-8 text, with the caching and limits of
    /// `read_body_bytes`.
    @native
    public async fun read_body_text(
        token: Option<CancellationToken> = Option.None
    ): Result<string, IoError> {
        let lifetime = [this];
        return Result.Ok(Encoding.utf8_decode(lifetime[0].read_body_bytes(token).await?));
    }

    /// Returns the body as a stream of chunks read as they arrive, for bodies too large to hold
    /// in memory. After streaming starts, `read_body_bytes`, `read_body_text` and `form` fail
    /// with `ECLOSED`; if the body was already read, the stream replays it.
    public fun stream(): HttpRequestStream {
        return HttpRequestStream(this);
    }

    /// Parses a `multipart/form-data` body. Text fields larger than `max_part_size` bytes, more
    /// than `max_fields` text fields or more than `max_files` files fail with `EINVAL`; file
    /// parts have no size limit and spool to disk past 1 MiB. Later calls return the same
    /// `FormData`, whatever limits they pass. Fails with `ECLOSED` after `stream` was read.
    @native
    public fun form(
        max_files: int = 1000,
        max_fields: int = 1000,
        max_part_size: int = 1048576,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<FormData, IoError>> {
        return HttpIncoming.form_owned(
            this,
            max_files,
            max_fields,
            max_part_size,
            this.resolve_token(token)
        );
    }

    static async fun form_owned(
        incoming: HttpIncoming,
        max_files: int,
        max_fields: int,
        max_part_size: int,
        token: Option<CancellationToken>
    ): Result<FormData, IoError> {
        let lifetime = [incoming];
        if lifetime[0].form_data.is_some() {
            return Result.Ok(lifetime[0].form_data.unwrap());
        }
        if max_files < 0 || max_fields < 0 || max_part_size < 0 {
            return Result.Err(IoError.invalid("", "form limits must not be negative"));
        }
        let request = WebOperation.request(WebAction.Form, lifetime[0].req_id);
        request.i32(max_files);
        request.i32(max_fields);
        request.i32(max_part_size);
        let bytes = WebOperation.submit(request, [], token).await?;
        let form = FormData(WebOperation.parse(bytes)?);
        lifetime[0].form_data = Option.Some(form);
        return Result.Ok(form);
    }
}
