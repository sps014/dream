module system.webapi;

/// Outbound HTTP response built by handlers and middleware.
public class HttpOutgoing {
    /// HTTP response status code.
    public status: int;

    /// HTTP headers associated with this message.
    public headers: HttpHeaders;

    /// Text response body.
    public body: string;

    /// Binary response body; use `bytes` to construct a binary response.
    public body_bytes: byte[];

    internal use_bytes: bool;
    internal skip_send: bool;

    /// Creates a `HttpOutgoing` with `status`, `body`.
    public constructor(status: int, body: string = "") {
        this.status = status;
        this.headers = HttpHeaders();
        this.body = body;
        this.body_bytes = Buffer.alloc<byte>(0);
        this.use_bytes = false;
        this.skip_send = false;
    }

    /// Sets a response header and returns this response for chaining.
    public fun set_header(name: string, value: string): HttpOutgoing {
        this.headers.set(name, value);
        return this;
    }

    /// Creates a plain-text response with status 200 unless another status is supplied.
    public static fun text(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "text/plain; charset=utf-8");
        return res;
    }

    /// Creates an HTML response with status 200 unless another status is supplied.
    public static fun html(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "text/html; charset=utf-8");
        return res;
    }

    /// Creates a JSON response from already encoded JSON text; does not serialize or validate
    /// the text.
    public static fun json_text(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "application/json; charset=utf-8");
        return res;
    }

    /// FastAPI-style `{"detail": "..."}` JSON error.
    public static fun detail(message: string, status: int = 500): HttpOutgoing {
        return HttpOutgoing.json_text("{\"detail\":" + WebApp.json_escape(message) + "}", status);
    }

    /// A 400 response for a failed body read; invalid input such as a form over its limits
    /// keeps the failure message as the detail.
    public static fun from_body_error(error: IoError): HttpOutgoing {
        if error.code() == "EINVAL" {
            return HttpOutgoing.detail(error.message(), 400);
        }
        return HttpOutgoing.detail("failed to read request body", 400);
    }

    /// A structured validation response, prefixed with the input source.
    public static fun from_validation(errors: ValidationErrors, source: string): HttpOutgoing {
        let prefixed = ValidationErrors();
        for (let issue in errors.issues) {
            let path = List<string>();
            path.push(source);
            for (let segment in issue.location) {
                path.push(segment);
            }
            prefixed.add(path, issue.code, issue.message);
        }
        return HttpOutgoing.json_text(Json.serialize(prefixed.to_json()), 422);
    }

    /// Creates a 422 validation-error response describing the invalid input and its location.
    public static fun invalid_input(
        source: string,
        name: string,
        code: string,
        message: string
    ): HttpOutgoing {
        let errors = ValidationErrors();
        errors.add(Validation.child(List<string>(), name), code, message);
        return HttpOutgoing.from_validation(errors, source);
    }

    /// Creates a marker indicating that the response has already been sent.
    public static fun already_sent(): HttpOutgoing {
        let res = HttpOutgoing(200, "");
        res.skip_send = true;
        return res;
    }

    /// Creates a binary response from `data`, with status 200 by default.
    public static fun bytes(data: byte[], status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, "");
        res.body_bytes = data;
        res.use_bytes = true;
        return res;
    }

    /// Creates a response using the supplied status code and message.
    public static fun from_status(st: HttpStatus): HttpOutgoing {
        let msg = st.message;
        if msg.is_empty() {
            msg = "Error";
        }
        return HttpOutgoing.text(msg, st.code);
    }

    /// Creates a 404 Not Found response.
    public static fun not_found(): HttpOutgoing {
        return HttpOutgoing.from_status(HttpStatus.not_found());
    }

    /// Creates a 405 Method Not Allowed response whose `Allow` header lists `allowed`, the methods
    /// that the requested path accepts, separated by `, `.
    public static fun method_not_allowed(allowed: List<string>): HttpOutgoing {
        let res = HttpOutgoing.text("Method Not Allowed", 405);
        res.headers.set("Allow", allowed.join(", "));
        return res;
    }

    /// Creates a response without a body, with status 204 by default.
    public static fun empty(status: int = 204): HttpOutgoing {
        return HttpOutgoing(status, "");
    }
}
