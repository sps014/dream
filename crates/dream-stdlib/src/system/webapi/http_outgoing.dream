module system.webapi;

// Outbound HTTP response built by handlers and middleware.
public class HttpOutgoing {
    public status: int;
    public headers: HttpHeaders;
    public body: string;
    public body_bytes: byte[];
    internal use_bytes: bool;
    internal skip_send: bool;

    public constructor(status: int, body: string = "") {
        this.status = status;
        this.headers = HttpHeaders();
        this.body = body;
        this.body_bytes = Buffer.alloc<byte>(0);
        this.use_bytes = false;
        this.skip_send = false;
    }

    public fun set_header(name: string, value: string): HttpOutgoing {
        this.headers.set(name, value);
        return this;
    }

    public static fun text(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "text/plain; charset=utf-8");
        return res;
    }

    public static fun html(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "text/html; charset=utf-8");
        return res;
    }

    public static fun json_text(body: string, status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, body);
        res.headers.set("Content-Type", "application/json; charset=utf-8");
        return res;
    }

    // FastAPI-style `{"detail": "..."}` JSON error.
    public static fun detail(message: string, status: int = 500): HttpOutgoing {
        return HttpOutgoing.json_text("{\"detail\":" + WebApp.json_escape(message) + "}", status);
    }

    /// Preserves body-limit failures as 413 while other read failures remain 400.
    public static fun from_body_error(error: IoError): HttpOutgoing {
        if error.code() == "ELIMIT" { return HttpOutgoing.detail("request body too large", 413); }
        return HttpOutgoing.detail("failed to read request body", 400);
    }

    /// A structured validation response, prefixed with the input source.
    public static fun from_validation(errors: ValidationErrors, source: string): HttpOutgoing {
        let prefixed = ValidationErrors();
        for (let issue in errors.issues) {
            let path = List<string>(); path.push(source); for (let segment in issue.location) { path.push(segment); }
            prefixed.add(path, issue.code, issue.message);
        }
        return HttpOutgoing.json_text(Json.serialize(prefixed.to_json()), 422);
    }
    public static fun invalid_input(source: string, name: string, code: string, message: string): HttpOutgoing {
        let errors = ValidationErrors(); errors.add(Validation.child(List<string>(), name), code, message); return HttpOutgoing.from_validation(errors, source);
    }

    public static fun already_sent(): HttpOutgoing {
        let res = HttpOutgoing(200, "");
        res.skip_send = true;
        return res;
    }

    public static fun bytes(data: byte[], status: int = 200): HttpOutgoing {
        let res = HttpOutgoing(status, "");
        res.body_bytes = data;
        res.use_bytes = true;
        return res;
    }

    public static fun from_status(st: HttpStatus): HttpOutgoing {
        let msg = st.message;
        if msg.is_empty() {
            msg = "Error";
        }
        return HttpOutgoing.text(msg, st.code);
    }

    public static fun not_found(): HttpOutgoing {
        return HttpOutgoing.from_status(HttpStatus.not_found());
    }

    public static fun empty(status: int = 204): HttpOutgoing {
        return HttpOutgoing(status, "");
    }
}
