module system.webapi;

/// Native OIDC exchange transport used by system.webapi.auth; completion obeys cancellation.
internal static class OidcTransport {
    /// Performs an OIDC begin or completion request. Honors `token` cancellation and returns an
    /// I/O error on failure.
    @native
    public static async fun exchange(
        request: JsonValue,
        token: Option<CancellationToken> = Option.None
    ): Result<JsonValue, IoError> {
        let action = request.get("action").and_then((item: JsonValue) => item.as_string()).unwrap_or("");
        if action != "oidc_begin" && action != "oidc_complete" {
            return Result.Err(IoError.other("", "invalid OIDC operation"));
        }
        request["id"] = JsonValue.from_int(0);
        request["timeout_ms"] = JsonValue.from_int(30000);
        return WebOperation.parse(WebOperation.submit(request, [], token).await?);
    }
}
