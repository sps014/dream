module system.webapi;

/// A WebSocket connection offered to a `@websocket` route. The handshake stays open until the
/// handler calls `accept`; closing the socket first, or returning without accepting it, answers
/// the handshake with 403 Forbidden.
public class ServerWebSocket {
    id: int;
    incoming: HttpIncoming;
    token: Option<CancellationToken>;
    rejected: bool;

    internal constructor(incoming: HttpIncoming, token: Option<CancellationToken>) {
        this.id = 0;
        this.incoming = incoming;
        this.token = token;
        this.rejected = false;
    }

    internal static fun is_handshake(incoming: HttpIncoming): bool {
        return incoming.method == "GET"
            && incoming.headers.get("Upgrade").unwrap_or("").to_lower() == "websocket";
    }

    // The HTTP response for the handshake once the handler returns: an accepted socket has
    // already answered with 101.
    internal fun finish(): HttpOutgoing {
        if this.id > 0 {
            return HttpOutgoing.already_sent();
        }
        return HttpOutgoing.from_status(HttpStatus.forbidden());
    }

    static fun not_accepted<T>(): Result<T, IoError> {
        return Result.Err(IoError("", "EINVAL", "WebSocket has not been accepted"));
    }

    fun resolve_token(token: Option<CancellationToken>): Option<CancellationToken> {
        let effective = CancellationToken.resolve(token);
        if effective.is_some() {
            return effective;
        }
        return this.token;
    }

    @native
    @runtime("netWsStart")
    static extern fun start_host(request: string, bytes: byte[]): int;

    @native
    @runtime("netWsClose")
    static extern fun close_host(id: int): void;

    del() {
        if this.id > 0 {
            ServerWebSocket.close_host(this.id);
        }
    }

    /// Completes the WebSocket handshake with 101 Switching Protocols. Call it once, after any
    /// checks on the handshake request such as its `Origin` header; messages can be sent and
    /// received only after it succeeds. Fails when the request is not a valid WebSocket upgrade,
    /// the client disconnected, or the socket was already accepted or closed.
    @native
    public fun accept(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return ServerWebSocket.accept_owned(this, this.resolve_token(token));
    }

    static async fun accept_owned(
        socket: ServerWebSocket,
        token: Option<CancellationToken>
    ): Result<Unit, IoError> {
        if socket.id > 0 || socket.rejected {
            return Result.Err(IoError("", "EINVAL", "WebSocket was already accepted or closed"));
        }
        let operation = WebOperation.start(
            WebOperation.request("upgrade", socket.incoming.req_id),
            []
        );
        let metadata = WebOperation.parse(operation.wait(token).await?)?;
        socket.id = metadata.get("id").unwrap_or(JsonValue.null()).as_int().unwrap_or(0);
        operation.claim();
        operation.close();
        return Result.Ok(Unit());
    }

    static async fun submit(
        socket: ServerWebSocket,
        request: JsonValue,
        bytes: byte[],
        token: Option<CancellationToken>
    ): Result<byte[], IoError> {
        if socket.id <= 0 {
            return ServerWebSocket.not_accepted<byte[]>();
        }
        if CancellationToken.is_cancelled_opt(token) {
            ServerWebSocket.close_host(socket.id);
            return Result.Err(IoError.cancelled());
        }
        let operation = WebOperation(ServerWebSocket.start_host(Json.serialize(request), bytes));
        let result = operation.wait(token).await;
        operation.close();
        if result.is_err() && result.unwrap_err().code() == "ECANCELLED" {
            ServerWebSocket.close_host(socket.id);
        }
        return result;
    }

    static async fun send_owned(
        socket: ServerWebSocket,
        action: string,
        bytes: byte[],
        code: int,
        reason: string,
        token: Option<CancellationToken>
    ): Result<Unit, IoError> {
        let request = WebOperation.request(action, socket.id);
        request["code"] = JsonValue.from_int(code);
        request["reason"] = JsonValue.from_string(reason);
        ServerWebSocket.submit(socket, request, bytes, token).await?;
        return Result.Ok(Unit());
    }

    /// Sends one text message.
    @native
    public fun send_text(
        text: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return ServerWebSocket.send_owned(
            this,
            "send_text",
            Encoding.utf8_encode(text),
            1000,
            "",
            this.resolve_token(token)
        );
    }

    /// Sends one binary message.
    @native
    public fun send_binary(
        bytes: byte[],
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return ServerWebSocket.send_owned(
            this,
            "send_binary",
            bytes,
            1000,
            "",
            this.resolve_token(token)
        );
    }

    /// Receives one complete message.
    @native
    public fun receive(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<WebSocketMessage, IoError>> {
        return ServerWebSocket.receive_owned(this, this.resolve_token(token));
    }

    static async fun receive_owned(
        socket: ServerWebSocket,
        token: Option<CancellationToken>
    ): Result<WebSocketMessage, IoError> {
        let bytes = ServerWebSocket.submit(
            socket,
            WebOperation.request("receive", socket.id),
            [],
            token
        ).await?;
        let message = WebOperation.parse(bytes)?;
        let kind = message.get("kind").unwrap_or(JsonValue.null()).as_string().unwrap_or("");
        if kind == "text" {
            return Result.Ok(
                WebSocketMessage.Text(
                    message.get("text").unwrap_or(JsonValue.null()).as_string().unwrap_or("")
                )
            );
        }
        if kind == "binary" {
            let items = message.get("bytes").unwrap_or(JsonValue.null())
                .as_array()
                .unwrap_or(List<JsonValue>());
            let bytes = Buffer.alloc<byte>(items.length);
            for (let i = 0; i < bytes.length; i = i + 1) {
                bytes[i] = (byte)items[i].as_int().unwrap_or(0);
            }
            return Result.Ok(WebSocketMessage.Binary(bytes));
        }
        if kind == "close" {
            return Result.Ok(
                WebSocketMessage.Close(
                    message.get("code").unwrap_or(JsonValue.null()).as_int().unwrap_or(1006),
                    message.get("reason").unwrap_or(JsonValue.null()).as_string().unwrap_or("")
                )
            );
        }
        return Result.Err(IoError.other("", "invalid WebSocket message"));
    }

    /// Iterates messages through the final Close message.
    @native
    public fun messages(
        token: Option<CancellationToken> = Option.None
    ): AsyncIterable<WebSocketMessage> {
        return ServerWebSocket.messages_owned(this, this.resolve_token(token));
    }

    static async fun messages_owned(
        socket: ServerWebSocket,
        token: Option<CancellationToken>
    ): AsyncIterable<WebSocketMessage> {
        let closing = false;
        while !closing {
            let result = socket.receive(token).await;
            if result.is_err() {
                yield break;
            }
            let message = result.unwrap();
            closing = switch (message) {
                Close(_, _) => true,
                _ => false
            };
            yield message;
        }
    }

    static async fun reject_owned(socket: ServerWebSocket): Result<Unit, IoError> {
        socket.rejected = true;
        return Result.Ok(Unit());
    }

    /// Sends a normal closing handshake; before `accept`, rejects the connection with 403
    /// Forbidden like `close_with`.
    @native
    public fun close(
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        return this.close_with(1000, "", token);
    }

    /// Sends a closing handshake with a code and reason. Before `accept`, this rejects the
    /// connection instead: the handshake is answered with 403 Forbidden when the handler returns,
    /// and `code` and `reason` are not sent. Use code 1008 (policy violation) for that case.
    @native
    public fun close_with(
        code: int,
        reason: string,
        token: Option<CancellationToken> = Option.None
    ): Future<Result<Unit, IoError>> {
        if this.id <= 0 {
            return ServerWebSocket.reject_owned(this);
        }
        return ServerWebSocket.send_owned(
            this,
            "close",
            [],
            code,
            reason,
            this.resolve_token(token)
        );
    }
}
