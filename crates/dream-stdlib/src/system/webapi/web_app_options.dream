module system.webapi;

/// API metadata, documentation endpoints and native TLS settings. Empty URLs disable endpoints.
public class WebAppOptions {
    public title: string;
    public version: string;
    public docs_url: string;
    public openapi_url: string;
    public redoc_url: string;
    public tls_cert_path: string;
    public tls_key_path: string;
    public summary: string;
    public description: string;
    public terms_of_service: string;
    public swagger: SwaggerOptions;

    public constructor(
        title: string = "Dream API",
        version: string = "0.1.0",
        docs_url: string = "/docs",
        openapi_url: string = "/openapi.json",
        redoc_url: string = "/redoc",
        tls_cert_path: string = "",
        tls_key_path: string = "",
        summary: string = "",
        description: string = "",
        terms_of_service: string = ""
    ) {
        this.title = title;
        this.version = version;
        this.docs_url = docs_url;
        this.openapi_url = openapi_url;
        this.redoc_url = redoc_url;
        this.tls_cert_path = tls_cert_path;
        this.tls_key_path = tls_key_path;
        this.summary = summary;
        this.description = description;
        this.terms_of_service = terms_of_service;
        this.swagger = SwaggerOptions();
    }
    internal fun copy(): WebAppOptions {
        let result = WebAppOptions(this.title, this.version, this.docs_url, this.openapi_url, this.redoc_url, this.tls_cert_path, this.tls_key_path, this.summary, this.description, this.terms_of_service);
        result.swagger = this.swagger.copy(); return result;
    }
}
