module system.webapi;

/// A compiled handler, path and its generated documentation.
@allow_cycle
public class WebEndpoint {
    internal method: string;
    internal path: string;
    internal handler: fun(RequestContext, Map<string, string>): Future<HttpOutgoing>;
    internal paths: string;
    internal components: string;
    internal websocket: bool;

    /// Creates a `WebEndpoint` with `method`, `path`, `handler`, `paths`, `websocket`,
    /// `components`.
    internal constructor(
        method: string,
        path: string,
        handler: fun(RequestContext, Map<string, string>): Future<HttpOutgoing>,
        paths: string,
        websocket: bool = false,
        components: string = "{}"
    ) {
        this.method = method;
        this.path = path;
        this.handler = handler;
        this.paths = paths;
        this.websocket = websocket;
        this.components = components;
    }
}
