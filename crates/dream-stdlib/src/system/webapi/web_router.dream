module system.webapi;

/// A compiled handler, path and its generated documentation.
@allow_cycle
public class WebEndpoint {
    internal method: string;
    internal path: string;
    internal handler: fun(RequestContext, Map<string, string>): Future<HttpOutgoing>;
    internal paths: string;
    internal components: string;
    internal websocket: bool;
    public constructor(method: string, path: string, handler: fun(RequestContext, Map<string, string>): Future<HttpOutgoing>, paths: string, websocket: bool = false, components: string = "{}") {
        this.method = method; this.path = path; this.handler = handler; this.paths = paths; this.websocket = websocket; this.components = components;
    }
}

/// Immutable generated route group; mount it explicitly on an application.
@allow_cycle
public class WebRouter {
    internal routes: List<WebEndpoint>;
    public constructor(routes: List<WebEndpoint>) { this.routes = List<WebEndpoint>(); for (let route in routes) { this.routes.push(route); } }
}
