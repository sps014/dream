module system.webapi;

/// Declares an HTTP GET route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct GetAttribute { public path: string; }

/// Declares an HTTP POST route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct PostAttribute { public path: string; }

/// Declares an HTTP PUT route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct PutAttribute { public path: string; }

/// Declares an HTTP PATCH route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct PatchAttribute { public path: string; }

/// Declares an HTTP DELETE route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct DeleteAttribute { public path: string; }

/// Declares an HTTP HEAD route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct HeadAttribute { public path: string; }

/// Declares an HTTP OPTIONS route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct OptionsAttribute { public path: string; }

/// Declares an HTTP WEBSOCKET route.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct WebsocketAttribute { public path: string; }

/// Declares an explicitly mounted group of static HTTP handlers.
@attribute(AttributeTarget.Class)
public struct RouterAttribute { public prefix: string; }

/// Applies a middleware function to a route or group in source order.
@repeatable
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod, AttributeTarget.Class)
public struct UseAttribute { public handler: DeclarationPath; }

/// Injects and memoizes a dependency function once per request.
@attribute(AttributeTarget.Parameter)
public struct DepAttribute { public provider: DeclarationPath; public cache: Option<bool>; }

/// Replaces a provider for applications explicitly installing the containing class's dependencies().
@attribute(AttributeTarget.StaticMethod)
public struct DependencyOverrideAttribute { public provider: DeclarationPath; }

/// Sets the content type of a yielded string or byte stream.
@attribute(AttributeTarget.Function, AttributeTarget.Method, AttributeTarget.StaticMethod)
public struct ProducesAttribute { public content_type: string; }

/// Extracts the request body as text, bytes or a JSON model.
@attribute(AttributeTarget.Parameter)
public struct BodyAttribute {}

/// Binds a path value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct PathAttribute { public name: Option<string>; }

/// Binds a query value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct QueryAttribute { public name: Option<string>; }

/// Binds a header value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct HeaderAttribute { public name: Option<string>; }

/// Binds a cookie value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct CookieAttribute { public name: Option<string>; }

/// Binds a form value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct FormAttribute { public name: Option<string>; }

/// Binds a file value, with an optional name override.
@attribute(AttributeTarget.Parameter)
public struct FileAttribute { public name: Option<string>; }


/// Declares a dependency's OpenAPI authentication scheme.
@attribute(AttributeTarget.Function, AttributeTarget.StaticMethod)
public struct SecuritySchemeAttribute {
    public id: string;
    public kind: string;
    public scheme: string;
    public name: Option<string>;
    public location: Option<string>;
}

/// Requires space-separated permission scopes from a verified CurrentUser dependency.
@attribute(AttributeTarget.StaticMethod)
public struct RequiresScopesAttribute { public scopes: string; }

/// Describes a route operation in OpenAPI.
@attribute(AttributeTarget.StaticMethod)
public struct OperationAttribute {
    public summary: Option<string>;
    public description: Option<string>;
    public tags: Option<string>;
    public status: Option<int>;
    public deprecated: Option<bool>;
}

/// Documents an additional explicit response without changing handler behavior.
@repeatable
@attribute(AttributeTarget.StaticMethod)
public struct ResponseAttribute {
    public status: int;
    public description: string;
    public model: Option<DeclarationPath>;
    public content_type: Option<string>;
}

/// Declares an OAuth2 authorization-code scheme for a security dependency.
@attribute(AttributeTarget.Function, AttributeTarget.StaticMethod)
public struct OAuth2SchemeAttribute {
    public id: string;
    public authorization_url: string;
    public token_url: string;
    public scopes: Option<string>;
}
