module system.webview;

// Native desktop WebView (wry). `@native` only — other hosts report unsupported.

internal class WebViewOnEntry {
    internal channel: string;
    internal fire: fun(string): void;

    internal constructor(channel: string, fire: fun(string): void) {
        this.channel = channel;
        this.fire = fire;
    }
}

internal class WebViewServeEntry {
    internal channel: string;
    internal fire: fun(string): string;

    internal constructor(channel: string, fire: fun(string): string) {
        this.channel = channel;
        this.fire = fire;
    }
}

internal class WebViewOnBytesEntry {
    internal channel: string;
    internal fire: fun(byte[]): void;

    internal constructor(channel: string, fire: fun(byte[]): void) {
        this.channel = channel;
        this.fire = fire;
    }
}

internal class WebViewServeBytesEntry {
    internal channel: string;
    internal fire: fun(byte[]): byte[];

    internal constructor(channel: string, fire: fun(byte[]): byte[]) {
        this.channel = channel;
        this.fire = fire;
    }
}

internal class WebViewServeBytesAsyncEntry {
    internal channel: string;
    internal fire: fun(byte[]): Future<byte[]>;

    internal constructor(channel: string, fire: fun(byte[]): Future<byte[]>) {
        this.channel = channel;
        this.fire = fire;
    }
}

internal class WebViewDropEntry {
    internal fire: fun(List<string>): void;

    internal constructor(fire: fun(List<string>): void) {
        this.fire = fire;
    }
}

internal class WebViewCloseEntry {
    internal fire: fun(): bool;

    internal constructor(fire: fun(): bool) {
        this.fire = fire;
    }
}

// Generic method bodies cannot emit nested lambdas into HIR; wrap the typed handler
// so `on`/`serve` pass a method-group `fire` instead of an inline closure.
internal class WebViewJsonOn<T> {
    internal handler: fun(T): void;

    internal constructor(handler: fun(T): void) {
        this.handler = handler;
    }

    internal fun fire(body: string): void {
        let handler = this.handler;
        switch (Json.deserialize<T>(body)) {
            Ok(value) => handler(value),
            Err(e) => System.println("WebView.on deserialize failed: " + e.message()),
        }
    }
}

internal class WebViewJsonServe<Req, Res> {
    internal handler: fun(Req): Res;

    internal constructor(handler: fun(Req): Res) {
        this.handler = handler;
    }

    internal fun fire(body: string): string {
        let handler = this.handler;
        return switch (Json.deserialize<Req>(body)) {
            Ok(req) => Json.serialize(handler(req)),
            Err(e) => "__dream_webview_parse__:" + e.message(),
        };
    }
}

public class WebView {
    internal id: int;
    _on: List<WebViewOnEntry>;
    _serve: List<WebViewServeEntry>;
    _on_bytes: List<WebViewOnBytesEntry>;
    _serve_bytes: List<WebViewServeBytesEntry>;
    _serve_bytes_async: List<WebViewServeBytesAsyncEntry>;
    _on_drop: List<WebViewDropEntry>;
    // Keyed by the host's window event name (`resized`, `focused`, ...).
    _on_window: List<WebViewOnEntry>;
    _on_close: List<WebViewCloseEntry>;

    constructor(id: int) {
        this.id = id;
        this._on = List<WebViewOnEntry>();
        this._serve = List<WebViewServeEntry>();
        this._on_bytes = List<WebViewOnBytesEntry>();
        this._serve_bytes = List<WebViewServeBytesEntry>();
        this._serve_bytes_async = List<WebViewServeBytesAsyncEntry>();
        this._on_drop = List<WebViewDropEntry>();
        this._on_window = List<WebViewOnEntry>();
        this._on_close = List<WebViewCloseEntry>();
    }

    @native
    @runtime("webviewCreate")
    static extern fun host_create(borrow title: string, width: int, height: int): int;

    @native
    @runtime("webviewLoadUrl")
    static extern fun host_load_url(id: int, borrow url: string): int;

    @native
    @runtime("webviewLoadHtml")
    static extern fun host_load_html(id: int, borrow html: string): int;

    @native
    @runtime("webviewLoadFile")
    static extern fun host_load_file(id: int, borrow path: string): int;

    @native
    @runtime("webviewClose")
    static extern fun host_close(id: int): void;

    @native
    @runtime("webviewTick")
    static extern fun host_tick(id: int): char[];

    @native
    @runtime("webviewPoll")
    static extern fun host_poll(id: int): char[];

    @native
    @runtime("webviewReply")
    static extern fun host_reply(id: int, reply_id: int, borrow body: string): void;

    @native
    @runtime("webviewReplyErr")
    static extern fun host_reply_err(id: int, reply_id: int, borrow message: string): void;

    @native
    @runtime("webviewReplyBytes")
    static extern fun host_reply_bytes(id: int, reply_id: int, borrow body: byte[]): void;

    @native
    @runtime("webviewEmit")
    static extern fun host_emit(id: int, borrow channel: string, borrow body: string): void;

    @native
    @runtime("webviewEmitBytes")
    static extern fun host_emit_bytes(id: int, borrow channel: string, borrow body: byte[]): void;

    @native
    @runtime("webviewEval")
    static extern async fun host_eval(id: int, borrow js: string): char[];

    // Window property op codes (see host `webview/window.rs`).
    @native
    @runtime("webviewGetWindow")
    static extern fun host_get_window(id: int, prop: int): int;

    @native
    @runtime("webviewWindowOp")
    static extern fun host_window_op(id: int, prop: int, a: int, b: int): int;

    @native
    @runtime("webviewGetString")
    static extern fun host_get_string(id: int, prop: int): char[];

    @native
    @runtime("webviewSetString")
    static extern fun host_set_string(id: int, prop: int, borrow value: string): int;

    fun get_prop(prop: int): int {
        return WebView.host_get_window(this.id, prop);
    }

    fun set_prop(prop: int, value: int): void {
        WebView.host_window_op(this.id, prop, value, 0);
    }

    fun get_flag(prop: int): bool {
        return WebView.host_get_window(this.id, prop) != 0;
    }

    fun set_flag(prop: int, value: bool): void {
        let v = 0;
        if value {
            v = 1;
        }
        WebView.host_window_op(this.id, prop, v, 0);
    }

    fun get_text(prop: int): string {
        let reader = WebViewWireReader(WebView.host_get_string(this.id, prop));
        return Encoding.utf8_decode(reader.read_remaining_bytes());
    }

    // Pass to `FileDialog.parent` / `MessageDialog.parent` to attach a dialog to this window.
    @native
    public get window_id(): int {
        return this.id;
    }

    @native
    public get title(): string {
        return this.get_text(0);
    }

    @native
    public set title(value: string) {
        WebView.host_set_string(this.id, 0, value);
    }

    // PNG path of the runtime icon; `""` while the compiled-in `[package].icon` is in use. An
    // unreadable file is reported on stderr and the current icon stays.
    @native
    public get icon(): string {
        return this.get_text(1);
    }

    @native
    public set icon(path: string) {
        WebView.host_set_string(this.id, 1, path);
    }

    // Inner size in logical pixels.
    @native
    public get width(): int {
        return this.get_prop(0);
    }

    @native
    public set width(value: int) {
        this.set_prop(0, value);
    }

    @native
    public get height(): int {
        return this.get_prop(1);
    }

    @native
    public set height(value: int) {
        this.set_prop(1, value);
    }

    // Size limits in logical pixels; `0` means no limit.
    @native
    public get min_width(): int {
        return this.get_prop(2);
    }

    @native
    public set min_width(value: int) {
        this.set_prop(2, value);
    }

    @native
    public get min_height(): int {
        return this.get_prop(3);
    }

    @native
    public set min_height(value: int) {
        this.set_prop(3, value);
    }

    @native
    public get max_width(): int {
        return this.get_prop(4);
    }

    @native
    public set max_width(value: int) {
        this.set_prop(4, value);
    }

    @native
    public get max_height(): int {
        return this.get_prop(5);
    }

    @native
    public set max_height(value: int) {
        this.set_prop(5, value);
    }

    // Outer position of the window on the desktop, in logical pixels.
    @native
    public get x(): int {
        return this.get_prop(6);
    }

    @native
    public set x(value: int) {
        this.set_prop(6, value);
    }

    @native
    public get y(): int {
        return this.get_prop(7);
    }

    @native
    public set y(value: int) {
        this.set_prop(7, value);
    }

    @native
    public get resizable(): bool {
        return this.get_flag(8);
    }

    @native
    public set resizable(value: bool) {
        this.set_flag(8, value);
    }

    // Borderless fullscreen on the current monitor.
    @native
    public get fullscreen(): bool {
        return this.get_flag(9);
    }

    @native
    public set fullscreen(value: bool) {
        this.set_flag(9, value);
    }

    @native
    public get maximized(): bool {
        return this.get_flag(10);
    }

    @native
    public set maximized(value: bool) {
        this.set_flag(10, value);
    }

    @native
    public get minimized(): bool {
        return this.get_flag(11);
    }

    @native
    public set minimized(value: bool) {
        this.set_flag(11, value);
    }

    @native
    public get always_on_top(): bool {
        return this.get_flag(12);
    }

    @native
    public set always_on_top(value: bool) {
        this.set_flag(12, value);
    }

    @native
    public get visible(): bool {
        return this.get_flag(13);
    }

    @native
    public set visible(value: bool) {
        this.set_flag(13, value);
    }

    // The web inspector for this page.
    @native
    public get devtools_open(): bool {
        return this.get_flag(14);
    }

    @native
    public set devtools_open(value: bool) {
        this.set_flag(14, value);
    }

    // Lets page JS open native dialogs through `Dream.dialog.*`. Off by default, so remote
    // pages loaded with `load_url` cannot open dialogs unless you opt in.
    @native
    public get page_dialogs(): bool {
        return this.get_flag(15);
    }

    @native
    public set page_dialogs(value: bool) {
        this.set_flag(15, value);
    }

    @native
    public get focused(): bool {
        return this.get_flag(16);
    }

    // Physical pixels per logical pixel (2.0 on most Retina displays).
    @native
    public get scale_factor(): float {
        return (float)this.get_prop(17) / 1000.0f;
    }

    @native
    public get dark_mode(): bool {
        return this.get_flag(18);
    }

    // Sets width and height together (one relayout).
    @native
    public fun resize(width: int, height: int): void {
        WebView.host_window_op(this.id, 19, width, height);
    }

    // Centers the window on its current monitor.
    @native
    public fun center(): void {
        WebView.host_window_op(this.id, 20, 0, 0);
    }

    @native
    public fun focus(): void {
        WebView.host_window_op(this.id, 21, 0, 0);
    }

    // Leaves fullscreen, minimized and maximized states.
    @native
    public fun restore(): void {
        WebView.host_window_op(this.id, 22, 0, 0);
    }

    @native
    public static fun create(title: string, width: int, height: int): Result<WebView, WebViewError> {
        let id = WebView.host_create(title, width, height);
        if id < 0 {
            return Result.Err(WebViewError.unavailable("WebView.create failed"));
        }
        return Result.Ok(WebView(id));
    }

    @native
    public fun load_url(url: string): Result<bool, WebViewError> {
        let code = WebView.host_load_url(this.id, url);
        if code != 0 {
            return Result.Err(WebViewError.failed("load_url failed"));
        }
        return Result.Ok(true);
    }

    @native
    public fun load_html(html: string): Result<bool, WebViewError> {
        let code = WebView.host_load_html(this.id, html);
        if code != 0 {
            return Result.Err(WebViewError.failed("load_html failed"));
        }
        return Result.Ok(true);
    }

    @native
    public fun load_file(path: string): Result<bool, WebViewError> {
        let code = WebView.host_load_file(this.id, path);
        if code != 0 {
            return Result.Err(WebViewError.failed("load_file failed"));
        }
        return Result.Ok(true);
    }

    fun upsert_on(channel: string, fire: fun(string): void): void {
        let found = 0 - 1;
        let i = 0;
        while i < this._on.length {
            let entry = this._on.get(i);
            if entry.channel == channel {
                found = i;
            }
            i = i + 1;
        }
        if found >= 0 {
            this._on.set(found, WebViewOnEntry(channel, fire));
        } else {
            this._on.push(WebViewOnEntry(channel, fire));
        }
    }

    fun upsert_serve(channel: string, fire: fun(string): string): void {
        let found = 0 - 1;
        let i = 0;
        while i < this._serve.length {
            let entry = this._serve.get(i);
            if entry.channel == channel {
                found = i;
            }
            i = i + 1;
        }
        if found >= 0 {
            this._serve.set(found, WebViewServeEntry(channel, fire));
        } else {
            this._serve.push(WebViewServeEntry(channel, fire));
        }
    }

    fun upsert_on_bytes(channel: string, fire: fun(byte[]): void): void {
        let found = 0 - 1;
        let i = 0;
        while i < this._on_bytes.length {
            let entry = this._on_bytes.get(i);
            if entry.channel == channel {
                found = i;
            }
            i = i + 1;
        }
        if found >= 0 {
            this._on_bytes.set(found, WebViewOnBytesEntry(channel, fire));
        } else {
            this._on_bytes.push(WebViewOnBytesEntry(channel, fire));
        }
    }

    fun upsert_serve_bytes(channel: string, fire: fun(byte[]): byte[]): void {
        let found = 0 - 1;
        let i = 0;
        while i < this._serve_bytes.length {
            let entry = this._serve_bytes.get(i);
            if entry.channel == channel {
                found = i;
            }
            i = i + 1;
        }
        if found >= 0 {
            this._serve_bytes.set(found, WebViewServeBytesEntry(channel, fire));
        } else {
            this._serve_bytes.push(WebViewServeBytesEntry(channel, fire));
        }
    }

    fun upsert_serve_bytes_async(channel: string, fire: fun(byte[]): Future<byte[]>): void {
        let found = 0 - 1;
        let i = 0;
        while i < this._serve_bytes_async.length {
            let entry = this._serve_bytes_async.get(i);
            if entry.channel == channel {
                found = i;
            }
            i = i + 1;
        }
        if found >= 0 {
            this._serve_bytes_async.set(found, WebViewServeBytesAsyncEntry(channel, fire));
        } else {
            this._serve_bytes_async.push(WebViewServeBytesAsyncEntry(channel, fire));
        }
    }

    @native
    public fun on<T>(channel: string, handler: fun(T): void): void {
        this.upsert_on(channel, WebViewJsonOn<T>(handler).fire);
    }

    @native
    public fun serve<Req, Res>(channel: string, handler: fun(Req): Res): void {
        this.upsert_serve(channel, WebViewJsonServe<Req, Res>(handler).fire);
    }

    @native
    public fun emit<T>(channel: string, value: T): void {
        WebView.emit_on(this.id, channel, value);
    }

    @native
    public static fun emit_on<T>(id: int, channel: string, value: T): void {
        WebView.host_emit(id, channel, Json.serialize(value));
    }

    @native
    public fun on_bytes(channel: string, handler: fun(byte[]): void): void {
        this.upsert_on_bytes(channel, handler);
    }

    @native
    public fun serve_bytes(channel: string, handler: fun(byte[]): byte[]): void {
        this.upsert_serve_bytes(channel, handler);
    }

    // Like `serve_bytes`, but the handler may await (HTTP, files, timers). It runs on the same
    // task scheduler as `run()`, so the window keeps pumping while the reply is pending.
    @native
    public fun serve_bytes_async(channel: string, handler: fun(byte[]): Future<byte[]>): void {
        this.upsert_serve_bytes_async(channel, handler);
    }

    @native
    public fun emit_bytes(channel: string, data: byte[]): void {
        WebView.emit_bytes_on(this.id, channel, data);
    }

    @native
    public static fun emit_bytes_on(id: int, channel: string, data: byte[]): void {
        WebView.host_emit_bytes(id, channel, data);
    }

    @native
    public fun on_raw<T : unmanaged>(channel: string, handler: fun(T[]): void): void {
        this.upsert_on_bytes(channel, (body: byte[]) => {
            if body.length == 0 {
                handler(Buffer.alloc<T>(0));
                return;
            }
            let scratch = Buffer.alloc<T>(1);
            let stride = Bytes.of(scratch[0]).length;
            if stride <= 0 {
                handler(Buffer.alloc<T>(0));
                return;
            }
            let count = body.length / stride;
            let out = Buffer.alloc<T>(count);
            let i = 0;
            while i < count {
                let slice = Buffer.alloc<byte>(stride);
                let j = 0;
                while j < stride {
                    slice[j] = body[i * stride + j];
                    j = j + 1;
                }
                out[i] = Bytes.to<T>(slice);
                i = i + 1;
            }
            handler(out);
        });
    }

    @native
    public fun serve_raw<TIn : unmanaged, TOut : unmanaged>(
        channel: string,
        handler: fun(TIn[]): TOut[]
    ): void {
        this.upsert_serve_bytes(channel, (body: byte[]) => {
            let input = Buffer.alloc<TIn>(0);
            if body.length > 0 {
                let scratch = Buffer.alloc<TIn>(1);
                let stride = Bytes.of(scratch[0]).length;
                if stride > 0 {
                    let count = body.length / stride;
                    input = Buffer.alloc<TIn>(count);
                    let i = 0;
                    while i < count {
                        let slice = Buffer.alloc<byte>(stride);
                        let j = 0;
                        while j < stride {
                            slice[j] = body[i * stride + j];
                            j = j + 1;
                        }
                        input[i] = Bytes.to<TIn>(slice);
                        i = i + 1;
                    }
                }
            }
            let values = handler(input);
            if values.length == 0 {
                return Buffer.alloc<byte>(0);
            }
            let stride_out = Bytes.of(values[0]).length;
            let out = Buffer.alloc<byte>(values.length * stride_out);
            let i = 0;
            while i < values.length {
                let eb = Bytes.of(values[i]);
                let j = 0;
                while j < stride_out {
                    out[i * stride_out + j] = eb[j];
                    j = j + 1;
                }
                i = i + 1;
            }
            return out;
        });
    }

    @native
    public fun emit_raw<T : unmanaged>(channel: string, values: T[]): void {
        WebView.emit_raw_on(this.id, channel, values);
    }

    @native
    public static fun emit_raw_on<T : unmanaged>(id: int, channel: string, values: T[]): void {
        if values.length == 0 {
            WebView.emit_bytes_on(id, channel, Buffer.alloc<byte>(0));
            return;
        }
        let stride = Bytes.of(values[0]).length;
        let out = Buffer.alloc<byte>(values.length * stride);
        let i = 0;
        while i < values.length {
            let eb = Bytes.of(values[i]);
            let j = 0;
            while j < stride {
                out[i * stride + j] = eb[j];
                j = j + 1;
            }
            i = i + 1;
        }
        WebView.emit_bytes_on(id, channel, out);
    }

    @native
    public async fun run(token: Option<CancellationToken> = Option.None): void {
        CancellationToken.throw_if_opt(token);
        while true {
            if CancellationToken.is_cancelled_opt(token) {
                return;
            }
            let raw = WebView.host_tick(this.id);
            let reader = WebViewWireReader(raw);
            let closed = int.parse(reader.read_line()).unwrap_or(1);
            this.dispatch_from(reader);
            if closed != 0 {
                this.drop_handlers();
                return;
            }
            Time.delay(0).await;
        }
    }

    @native
    public fun close(): void {
        WebView.host_close(this.id);
        this.drop_handlers();
    }

    // Handlers usually capture the view itself, so view -> list -> closure -> view is a cycle
    // that ARC never frees. A closed view dispatches nothing, so its handlers can go.
    fun drop_handlers(): void {
        this._on = List<WebViewOnEntry>();
        this._serve = List<WebViewServeEntry>();
        this._on_bytes = List<WebViewOnBytesEntry>();
        this._serve_bytes = List<WebViewServeBytesEntry>();
        this._serve_bytes_async = List<WebViewServeBytesAsyncEntry>();
        this._on_drop = List<WebViewDropEntry>();
        this._on_window = List<WebViewOnEntry>();
        this._on_close = List<WebViewCloseEntry>();
    }

    // Files dropped onto the window, as absolute paths.
    @native
    public fun on_file_drop(handler: fun(List<string>): void): void {
        this._on_drop.push(WebViewDropEntry(handler));
    }

    @native
    public fun on_resize(handler: fun(int, int): void): void {
        this._on_window.push(WebViewOnEntry("resized", (body: string) => {
            let parts = body.split('\n');
            handler(WebView.part_int(parts, 0), WebView.part_int(parts, 1));
        }));
    }

    @native
    public fun on_move(handler: fun(int, int): void): void {
        this._on_window.push(WebViewOnEntry("moved", (body: string) => {
            let parts = body.split('\n');
            handler(WebView.part_int(parts, 0), WebView.part_int(parts, 1));
        }));
    }

    @native
    public fun on_focus(handler: fun(bool): void): void {
        this._on_window.push(WebViewOnEntry("focused", (body: string) => handler(body == "1")));
    }

    @native
    public fun on_minimize(handler: fun(bool): void): void {
        this._on_window.push(WebViewOnEntry("minimized", (body: string) => handler(body == "1")));
    }

    @native
    public fun on_maximize(handler: fun(bool): void): void {
        this._on_window.push(WebViewOnEntry("maximized", (body: string) => handler(body == "1")));
    }

    @native
    public fun on_theme_change(handler: fun(bool): void): void {
        this._on_window.push(WebViewOnEntry("theme", (body: string) => handler(body == "1")));
    }

    @native
    public fun on_scale_change(handler: fun(float): void): void {
        this._on_window.push(WebViewOnEntry("scale", (body: string) => {
            handler(float.parse(body).unwrap_or(1.0));
        }));
    }

    // Asked when the user closes the window; any handler returning `false` keeps it open.
    // Without a handler the window closes straight away.
    @native
    public fun on_close_requested(handler: fun(): bool): void {
        this._on_close.push(WebViewCloseEntry(handler));
        WebView.host_window_op(this.id, 23, 1, 0);
    }

    internal static fun part_int(parts: string[], index: int): int {
        if index >= parts.length {
            return 0;
        }
        return int.parse(parts[index]).unwrap_or(0);
    }

    static fun run_drop(fire: fun(List<string>): void, paths: List<string>): void {
        fire(paths);
    }

    static fun run_close(fire: fun(): bool): bool {
        return fire();
    }

    fun dispatch_window(channel: string, body: string): void {
        if channel == "close_requested" {
            let close = true;
            let ci = 0;
            while ci < this._on_close.length {
                if !WebView.run_close(this._on_close.get(ci).fire) {
                    close = false;
                }
                ci = ci + 1;
            }
            if close {
                WebView.host_window_op(this.id, 24, 1, 0);
            }
            return;
        }
        let hi = 0;
        while hi < this._on_window.length {
            let entry = this._on_window.get(hi);
            if entry.channel == channel {
                WebView.run_on(entry.fire, body);
            }
            hi = hi + 1;
        }
    }

    fun dispatch_drop(body: string): void {
        let paths = List<string>();
        let parts = body.split('\n');
        let pi = 0;
        while pi < parts.length {
            if !parts[pi].is_empty() {
                paths.push(parts[pi]);
            }
            pi = pi + 1;
        }
        let hi = 0;
        while hi < this._on_drop.length {
            WebView.run_drop(this._on_drop.get(hi).fire, paths);
            hi = hi + 1;
        }
    }

    @native
    public async fun eval(js: string, token: Option<CancellationToken> = Option.None): Result<string, WebViewError> {
        CancellationToken.rejected(token, WebViewError.cancelled())?;
        let raw = WebView.host_eval(this.id, js).await;
        let reader = WebViewWireReader(raw);
        let code = int.parse(reader.read_line()).unwrap_or(1);
        let payload = Encoding.utf8_decode(reader.read_remaining_bytes());
        if code != 0 {
            return Result.Err(WebViewError.failed(payload));
        }
        return Result.Ok(payload);
    }

    static fun run_on(fire: fun(string): void, body: string): void {
        fire(body);
    }

    static fun run_serve(fire: fun(string): string, body: string): string {
        return fire(body);
    }

    static fun run_on_bytes(fire: fun(byte[]): void, body: byte[]): void {
        fire(body);
    }

    static fun run_serve_bytes(fire: fun(byte[]): byte[], body: byte[]): byte[] {
        return fire(body);
    }

    static async fun reply_bytes_when_done(id: int, reply_id: int, fire: fun(byte[]): Future<byte[]>, body: byte[]): void {
        let out = fire(body).await;
        WebView.host_reply_bytes(id, reply_id, out);
    }

    fun dispatch(): void {
        let raw = WebView.host_poll(this.id);
        let reader = WebViewWireReader(raw);
        this.dispatch_from(reader);
    }

    fun dispatch_from(reader: WebViewWireReader): void {
        let count = int.parse(reader.read_line()).unwrap_or(0);
        let i = 0;
        let prefix = "__dream_webview_parse__:";
        while i < count {
            let kind = int.parse(reader.read_line()).unwrap_or(0);
            let reply_id = int.parse(reader.read_line()).unwrap_or(0);
            let channel = reader.read_line();
            let body_len = int.parse(reader.read_line()).unwrap_or(0);
            let body_bytes = reader.read_bytes(body_len);
            if kind == 0 {
                let body = Encoding.utf8_decode(body_bytes);
                let hi = 0;
                while hi < this._on.length {
                    let entry = this._on.get(hi);
                    if entry.channel == channel {
                        WebView.run_on(entry.fire, body);
                        hi = this._on.length;
                    } else {
                        hi = hi + 1;
                    }
                }
            }
            if kind == 1 {
                let body = Encoding.utf8_decode(body_bytes);
                let found = false;
                let hi = 0;
                while hi < this._serve.length {
                    let entry = this._serve.get(hi);
                    if entry.channel == channel {
                        let out = WebView.run_serve(entry.fire, body);
                        if out.starts_with(prefix) {
                            let msg = out.substring(prefix.length, out.length);
                            WebView.host_reply_err(this.id, reply_id, msg);
                        } else {
                            WebView.host_reply(this.id, reply_id, out);
                        }
                        found = true;
                        hi = this._serve.length;
                    } else {
                        hi = hi + 1;
                    }
                }
                if found == false {
                    WebView.host_reply_err(this.id, reply_id, "no handler for channel: " + channel);
                }
            }
            if kind == 2 {
                let hi = 0;
                while hi < this._on_bytes.length {
                    let entry = this._on_bytes.get(hi);
                    if entry.channel == channel {
                        WebView.run_on_bytes(entry.fire, body_bytes);
                        hi = this._on_bytes.length;
                    } else {
                        hi = hi + 1;
                    }
                }
            }
            if kind == 3 {
                let found = false;
                let hi = 0;
                while hi < this._serve_bytes.length {
                    let entry = this._serve_bytes.get(hi);
                    if entry.channel == channel {
                        let out = WebView.run_serve_bytes(entry.fire, body_bytes);
                        WebView.host_reply_bytes(this.id, reply_id, out);
                        found = true;
                        hi = this._serve_bytes.length;
                    } else {
                        hi = hi + 1;
                    }
                }
                let ai = 0;
                while (found == false) && (ai < this._serve_bytes_async.length) {
                    let entry = this._serve_bytes_async.get(ai);
                    if entry.channel == channel {
                        // Launched, not awaited: dispatch has to return so `run()` keeps pumping.
                        Promise.start(WebView.reply_bytes_when_done(this.id, reply_id, entry.fire, body_bytes));
                        found = true;
                    }
                    ai = ai + 1;
                }
                if found == false {
                    WebView.host_reply_err(this.id, reply_id, "no handler for channel: " + channel);
                }
            }
            if kind == 4 {
                this.dispatch_drop(Encoding.utf8_decode(body_bytes));
            }
            if kind == 5 {
                this.dispatch_window(channel, Encoding.utf8_decode(body_bytes));
            }
            i = i + 1;
        }
    }
}
