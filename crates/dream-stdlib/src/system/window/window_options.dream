module system.window;

/// The settings a new window is created with.
///
/// Construct one with a title and content size, then chain the settings you want to change:
/// `WindowOptions("Game", 1280, 720).resizable(false).fullscreen(true)`.
public class WindowOptions {
    option_title: string;
    option_width: int;
    option_height: int;
    option_resizable: bool;
    option_fullscreen: bool;
    option_vsync: bool;

    /// Describes a resizable, windowed window with `title` and a content area of
    /// `width` by `height` logical pixels. `Window.open` rejects non-positive sizes.
    public constructor(title: string, width: int, height: int) {
        this.option_title = title;
        this.option_width = width;
        this.option_height = height;
        this.option_resizable = true;
        this.option_fullscreen = false;
        this.option_vsync = true;
    }

    /// Title shown in the title bar, or as the page title in a browser.
    public get title(): string {
        return this.option_title;
    }

    /// Requested content width in logical pixels.
    public get width(): int {
        return this.option_width;
    }

    /// Requested content height in logical pixels.
    public get height(): int {
        return this.option_height;
    }

    /// Whether the user can resize the window. Defaults to `true`.
    public get is_resizable(): bool {
        return this.option_resizable;
    }

    /// Whether the window starts fullscreen on the primary monitor. Defaults to `false`.
    public get is_fullscreen(): bool {
        return this.option_fullscreen;
    }

    /// Whether a GPU surface created for this window waits for the display's vertical
    /// refresh. Defaults to `true`. The window never draws by itself, so only GPU
    /// surfaces read this hint.
    public get wants_vsync(): bool {
        return this.option_vsync;
    }

    /// Sets whether the user can resize the window, and returns these options.
    public fun resizable(value: bool): WindowOptions {
        this.option_resizable = value;
        return this;
    }

    /// Sets whether the window starts fullscreen, and returns these options.
    public fun fullscreen(value: bool): WindowOptions {
        this.option_fullscreen = value;
        return this;
    }

    /// Sets the vertical-sync hint for GPU surfaces, and returns these options.
    public fun vsync(value: bool): WindowOptions {
        this.option_vsync = value;
        return this;
    }

    internal fun flags(): int {
        let flags = 0;
        if this.option_resizable {
            flags = flags | 1;
        }
        if this.option_fullscreen {
            flags = flags | 2;
        }
        if this.option_vsync {
            flags = flags | 4;
        }
        return flags;
    }
}
