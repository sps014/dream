import system;
import system.collections;

@noinline
fun compare_work(n: int): int {
    let queue = PriorityQueue<string>();
    let list = List<string>();
    let i = 0;
    while i < n {
        let value = "value" + i.to_string();
        queue.push(value);
        list.push(value);
        i = i + 1;
    }
    list.sort();
    return queue.pop().unwrap().length + list[0].length;
}

fun main(): void {
    System.println(compare_work(8));
}
