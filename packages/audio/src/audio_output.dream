module audio;

import system.interop;

// Each entry point is separate so decoding and analysis need no output capability.
internal static class AudioOutput {
    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_create(samples: float[], count: int, rate: int, channels: int): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_stream(rate: int, channels: int, frames: int): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_write(handle: int, samples: float[], count: int): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_start(handle: int): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_control(handle: int, command: int, value: double): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_query(handle: int, field: int): double;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_close(handle: int): void;

    @cfg(Target.Native)
    @owned
    @c
    internal static extern fun audio_output_devices(): string;

    @cfg(Target.Native)
    @owned
    @c
    internal static extern fun audio_output_request(): string;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_sink(handle: int, id: string): int;

    @cfg(Target.Native)
    @c
    internal static extern fun audio_output_capture(handle: int, frames: int): float[];

    @cfg(Target.Native)
    internal static fun create(borrow samples: float[], rate: int, channels: int): int {
        return AudioOutput.audio_output_create(samples, samples.length, rate, channels);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputCreate", "audio")
    internal static extern fun create(borrow samples: float[], rate: int, channels: int): int;

    @cfg(Target.Native)
    internal static fun stream(rate: int, channels: int, frames: int): int {
        return AudioOutput.audio_output_stream(rate, channels, frames);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputStream", "audio")
    internal static extern fun stream(rate: int, channels: int, frames: int): int;

    @cfg(Target.Native)
    internal static fun write(handle: int, borrow samples: float[]): int {
        return AudioOutput.audio_output_write(handle, samples, samples.length);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputWrite", "audio")
    internal static extern fun write(handle: int, borrow samples: float[]): int;

    @cfg(Target.Native)
    internal static async fun start(handle: int): int {
        return AudioOutput.audio_output_start(handle);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputStart", "audio")
    internal static extern async fun start(handle: int): int;

    @cfg(Target.Native)
    internal static fun control(handle: int, command: int, value: double): int {
        return AudioOutput.audio_output_control(handle, command, value);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputControl", "audio")
    internal static extern fun control(handle: int, command: int, value: double): int;

    @cfg(Target.Native)
    internal static fun query(handle: int, field: int): double {
        return AudioOutput.audio_output_query(handle, field);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputQuery", "audio")
    internal static extern fun query(handle: int, field: int): double;

    @cfg(Target.Native)
    internal static fun close(handle: int): void {
        AudioOutput.audio_output_close(handle);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputClose", "audio")
    internal static extern fun close(handle: int): void;

    @cfg(Target.Native)
    internal static async fun devices(): string {
        return AudioOutput.audio_output_devices();
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputDevices", "audio")
    internal static extern async fun devices(): string;

    @cfg(Target.Native)
    internal static async fun request(): string {
        return AudioOutput.audio_output_request();
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputRequest", "audio")
    internal static extern async fun request(): string;

    @cfg(Target.Native)
    internal static async fun sink(handle: int, borrow id: string): int {
        return AudioOutput.audio_output_sink(handle, id);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputSink", "audio")
    internal static extern async fun sink(handle: int, borrow id: string): int;

    @cfg(Target.Native)
    internal static fun capture(handle: int, frames: int): float[] {
        return AudioOutput.audio_output_capture(handle, frames);
    }

    @cfg(Target.Wasm)
    @runtime("audioOutputCapture", "audio")
    internal static extern fun capture(handle: int, frames: int): float[];
}
