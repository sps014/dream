import system.testing;
import system;
import system.io;
import config;

@test
fun config_layers(): void {
    let temporary = TempFile.create_in(".").unwrap();
    temporary.file.write_all(("{\"port\":9000,\"enabled\":true}").to_utf8()).unwrap();
    temporary.file.flush().unwrap();
    let built = ConfigBuilder()
        .default_value("port", "8080")
        .json_file(temporary.path)
        .require("enabled")
        .build()
        .unwrap();
    Assert.eq(built.get_int("port").unwrap(), 9000);
    Assert.is_true(built.get_bool("enabled").unwrap());
    Assert.eq(built.source("port").unwrap(), temporary.path);
    System.set_env("DREAM_TEST_CONFIG_PORT", "9100").unwrap();
    let overrides = ConfigBuilder()
        .default_value("port", "8080")
        .environment("DREAM_TEST_CONFIG_")
        .json_file(temporary.path)
        .build()
        .unwrap();
    Assert.eq(overrides.get_int("port").unwrap(), 9100);
    System.unset_env("DREAM_TEST_CONFIG_PORT").unwrap();
    Assert.is_true(
        ConfigBuilder().default_value("port", "bad").build().unwrap().get_int("port").is_err()
    );
    Assert.is_true(
        ConfigBuilder()
            .default_value("port", "bad")
            .validate("port", (value) => value == "good")
            .build()
            .is_err()
    );
    temporary.close().unwrap();
}
