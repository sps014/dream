import system.testing;
import system;
import system.collections;
import system.io;
import logging;

let captured: List<string> = List<string>();

class Capture: LogHandler {
    public fun emit(record: LogRecord): void {
        captured.push(
            "[" + level_name(record.level) + "] " + record.name + ": " + record.message
        );
    }
}

@test
fun logging_levels_and_shared_logger(): void {
    let log = Logger.get("logging-basic");
    let capture = Capture();
    log.add_handler(capture);
    log.level = LogLevel.Debug;
    log.debug("hello");
    log.info("world");
    log.trace("hidden");
    let same = Logger.get("logging-basic");
    same.warn("again");
    Assert.eq(captured.length, 3);
    Assert.eq(captured[0], "[DEBUG] logging-basic: hello");
    Assert.eq(captured[1], "[INFO] logging-basic: world");
    Assert.eq(captured[2], "[WARN] logging-basic: again");
}

@test
fun file_handler_appends_a_line(): void {
    let temporary = TempFile.create_in(".").unwrap();
    let log = Logger("logging-file");
    log.add_handler(FileHandler(temporary.path));
    log.info("saved");
    temporary.file.seek(0L).unwrap();
    let text = string.from_utf8(temporary.file.read(200).unwrap());
    Assert.eq(text, "[INFO] logging-file: saved\n");
    temporary.close().unwrap();
}
