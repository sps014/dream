module webapi.derive;
import system;
import system.codegen;
import webapi;

extend WebGenerator {
    internal fun middleware_shape(f: GenFunction): bool {
        return f.is_async
            && web_is(f.ret, declof(HttpOutgoing))
            && f.params.length
            == 2
            && web_is(f.params[0].ty, declof(RequestContext))
            && web_is(f.params[1].ty, declof(Next));
    }

    internal fun validate_use(route: GenFunction, use: UseAttribute): void {
        let name = use.handler.text;
        let target = this.functions.get(use.handler.symbol);
        if target.is_none() {
            this.ctx.error_at(route.id, "@use(" + name + ") does not resolve to a function");
        } else if !this.middleware_shape(target.unwrap()) {
            this.ctx.error_at(
                route.id,
                "@use("
                    + name
                    + ") must be `async fun "
                    + name + "(ctx: RequestContext, next: Next): HttpOutgoing`"
            );
        }
    }
}
