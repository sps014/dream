module webapi;

internal class WebRouting {
    /// The percent-decoded `{name}` segments of a `path` the route table matched to `pattern`.
    internal static fun path_params(
        borrow pattern: string,
        borrow path: string
    ): Map<string, string> {
        let params = Map<string, string>();
        let pi = WebRouting.skip_slash(pattern, 0);
        let si = WebRouting.skip_slash(path, 0);
        while pi < pattern.length && si < path.length {
            let pe = WebRouting.find_slash(pattern, pi);
            let se = WebRouting.find_slash(path, si);
            if WebRouting.is_param(pattern, pi, pe) {
                let raw = path.substring(si, se);
                params[pattern.substring(pi + 1, pe - 1)] = route_percent_decode(raw)
                    .unwrap_or(raw);
            }
            pi = WebRouting.skip_slash(pattern, pe);
            si = WebRouting.skip_slash(path, se);
        }
        return params;
    }

    internal static fun is_param(borrow pattern: string, start: int, end: int): bool {
        return (end - start) >= 3 && pattern[start] == '{'
            && pattern[end - 1] == '}';
    }

    internal static fun cookie_value(borrow header: string, borrow name: string): Option<string> {
        let n = header.length;
        let i = 0;
        while i <= n {
            let start = i;
            while i < n && header[i] != ';' {
                i = i + 1;
            }
            let end = i;
            while start < end && (header[start] == ' ' || header[start] == '\t') {
                start = start + 1;
            }
            while end > start && (
                header[end - 1] == ' ' || header[end - 1] == '\t'
            ) {
                end = end - 1;
            }
            let eq = start;
            let has_eq = false;
            while eq < end {
                if header[eq] == '=' {
                    has_eq = true;
                    break;
                }
                eq = eq + 1;
            }
            if has_eq && WebRouting.region_eq(header, start, eq, name, 0, name.length) {
                return Option.Some(header.substring(eq + 1, end));
            }
            if i >= n {
                break;
            }
            i = i + 1;
        }
        let none: Option<string> = Option.None;
        return none;
    }

    internal static fun skip_slash(borrow s: string, i: int): int {
        while i < s.length && s[i] == '/' {
            i = i + 1;
        }
        return i;
    }

    internal static fun find_slash(borrow s: string, i: int): int {
        while i < s.length && s[i] != '/' {
            i = i + 1;
        }
        return i;
    }

    static fun region_eq(
        borrow a: string,
        a0: int,
        a1: int,
        borrow b: string,
        b0: int,
        b1: int
    ): bool {
        if (a1 - a0) != (b1 - b0) {
            return false;
        }
        let k = 0;
        let n = a1 - a0;
        while k < n {
            if a[a0 + k] != b[b0 + k] {
                return false;
            }
            k = k + 1;
        }
        return true;
    }
}
