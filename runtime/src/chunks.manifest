# Dream JS host chunk table — single source of truth shared by
# src/driver/js_runtime.rs (selective *.(web|node).runtime.js assembly) and
# scripts/bundle-runtime.mjs (full runtime/dream.js bundle).
#
# Format (one entry per line, `#` comments, blank lines ignored):
#   always <file>...            modules concatenated into every runtime, in order
#   order <chunk>...            emission/registration order for optional chunks
#   chunk <id> <file[,file...]> <factory> <field>...
# Source files within a chunk are listed in dependency order.
#
# <factory> is the host-factory function defined by <file> (`-` when the chunk has
# none; `workers` and `audio_decoder` are wired inside load.js instead). Each <field> maps a WASM import
# field to this chunk by prefix; a leading `=` marks an exact-match field.
always features.js abi.js guest_contract.js platform.js binary.js wire.js urls.js core.js instance.js typed.js typed_imports.js marshal.js hosts/env.js
order async js cancellation fs net crypto console_process datetime_text window gpu audio audio_media audio_capture audio_decoder workers drawing
chunk async async.js -
chunk js hosts/js.js makeJsHost js
chunk fs hosts/file_operations.js,hosts/fs.js makeFsHost file dir temp
chunk net hosts/http.js,hosts/websocket.js,hosts/sockets.js,hosts/net.js makeNetHost net
chunk crypto hosts/crypto.js makeCryptoHost crypto
chunk console_process hosts/process_wire.js,hosts/process_service.js,hosts/console_process.js makeConsoleProcessHost console process
chunk datetime_text hosts/datetime_text.js makeDatetimeTextHost unicode date time =delayMs
chunk workers workers.js - worker

chunk cancellation hosts/cancellation.js makeCancellationHost cancellation =asyncHostCancel


chunk window hosts/window.js makeWindowHost window

chunk gpu hosts/gpu_layouts.js,hosts/gpu_bundle.js,hosts/gpu_commands.js,hosts/gpu.js makeGpuHost gpu

chunk audio hosts/audio.js makeAudioHost =audioOutputStart =audioOutputRequest =audioOutputCreate =audioOutputStream =audioOutputWrite =audioOutputControl =audioOutputQuery =audioOutputClose =audioOutputDevices =audioOutputSink
chunk drawing hosts/drawing.js makeDrawingHost drawing
chunk audio_capture hosts/audio_capture.js makeAudioCaptureHost =audioOutputCapture
chunk audio_media hosts/audio_media.js makeAudioMediaHost audioMedia
chunk audio_decoder hosts/audio_decoder.js - audioDecode
