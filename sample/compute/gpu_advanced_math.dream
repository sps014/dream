import system;
import system.gpu;

@compute(64)
fun advanced_gpu_calc(
    data: GpuBuffer<float>,
    atomics: GpuBuffer<int>,
    out: GpuBuffer<float>,
    n: int
): void {
    let i = global_id.x;
    if i < n {
        let p1 = GpuVec2.of(data[i * 2], data[i * 2 + 1]);
        let p2 = GpuVec2.of(0.0, 0.0);
        let dist = GpuMath.distance(p1, p2);

        // Exponential & log2 math
        let log_val = GpuMath.log2(dist);
        let exp_val = GpuMath.exp2(log_val);
        let rounded = GpuMath.round(exp_val);
        out[i] = rounded;

        // Matrix determinant test
        let m = GpuMat2.of(GpuVec2.of(2.0, 0.0), GpuVec2.of(0.0, 3.0));
        let det = GpuMath.determinant(m);

        // Atomic operations
        let int_val = (int)(dist * 10.0);
        let _ = Gpu.atomic_min(atomics, 0, int_val);
        let _ = Gpu.atomic_max(atomics, 1, int_val);

        // Bitwise popcount
        let bits = GpuMath.count_one_bits(int_val);
        let _ = Gpu.atomic_add(atomics, 2, bits);
        let _ = Gpu.atomic_add(atomics, 3, (int)det);
    }
}

async fun main(): void {
    let init = await Gpu.try_init();
    if init.is_err() {
        System.println("gpu unavailable");
        return;
    }

    let data = GpuBuffer<float>.from([3.0, 4.0, 6.0, 8.0]);
    let atomics = GpuBuffer<int>.from([9999, -9999, 0, 0]);
    let out = GpuBuffer<float>.alloc(2);

    let r = await Compute.run_resources(
        "advanced_gpu_calc",
        [data.id, atomics.id, out.id],
        Buffer.alloc<int>(0),
        Buffer.alloc<int>(0),
        2, 1, 1,
        Buffer.alloc<byte>(0)
    );
    if r.is_err() {
        System.println("dispatch failed");
        return;
    }

    let res = await out.read();
    let stats = await atomics.read();

    System.println((int)res[0]); // 5 (distance of (3,4) is 5.0)
    System.println((int)res[1]); // 10 (distance of (6,8) is 10.0)
    System.println(stats[0]);    // min = 50
    System.println(stats[1]);    // max = 100
    System.println(stats[2] > 0); // bits > 0
    System.println(stats[3]);    // det * 2 = 12
}
