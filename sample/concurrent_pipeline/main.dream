import system.text;
import system;
import system.task;

fun channel_message(error: ChannelError): string {
    if error == ChannelError.Cancelled {
        return "pipeline cancelled";
    }
    return "pipeline endpoint closed";
}

fun channel_failure(error: ChannelError): TaskFailure<string> {
    return TaskFailure.Failed(channel_message(error));
}

async fun produce(sender: Sender<int>): Result<Unit, string> {
    for (let value = 1; value <= 100; value = value + 1) {
        sender.send(value).await.map_err<string>(channel_message)?;
    }
    sender.close();
    return Result.Ok(Unit());
}

async fun main(): int {
    let result = Task.scope<int, string>(
        async (scope) => {
            let queue = Channel.bounded<int>(capacity: 16).unwrap();
            let sender = queue.sender;
            let receiver = queue.receiver;
            scope.spawn<Unit>(async () => produce(sender).await);
            let total = 0;
            while true {
                let value = receiver.receive().await.map_err<TaskFailure<string>>(channel_failure)?;
                if value.is_none() {
                    break;
                }
                total = total + value.unwrap();
            }
            return Result.Ok(total);
        }
    ).await;
    if result.is_err() {
        System.stderr.write_all(Encoding.utf8_encode("pipeline failed" + "\n"));
        System.stderr.flush();
        return 1;
    }
    System.println(result.unwrap());
    return 0;
}
