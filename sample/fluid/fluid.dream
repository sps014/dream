// 2D stable-fluids (Jos Stam) on the GPU: `@compute` kernels batched with ComputePass.
// Splat / advect / project / decay / paint stay on-device; the CPU only tracks mouse + frame.
//
// Build: cargo run -- sample/fluid/fluid.dream
// Browser: serve repo root, open fluid.html. Drag to paint.

import system;
import system.gpu;

// Host packs dispatch extents into the first three i32 uniform slots (ex, ey, ez).
// Float uniforms must start at byte 12 — pad with unused i32s after `n`.

@compute(8, 8)
fun splat(
    dens: GpuBuffer<float>,
    vx: GpuBuffer<float>,
    vy: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    cx: float,
    cy: float,
    dye_amt: float,
    fx: float,
    fy: float,
    rad: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x >= n || y >= n { return; }
    let dx: float = (float)x - cx;
    let dy: float = (float)y - cy;
    let d2: float = dx * dx + dy * dy;
    let r2: float = rad * rad;
    if d2 >= r2 { return; }
    let w: float = 1.0 - d2 / r2;
    let i = y * n + x;
    let d = dens[i] + dye_amt * w;
    if d > 1.0 { d = 1.0; }
    if d < 0.0 { d = 0.0; }
    dens[i] = d;
    vx[i] = vx[i] + fx * w;
    vy[i] = vy[i] + fy * w;
}

@compute(8, 8)
fun advect(
    @readonly src: GpuBuffer<float>,
    dst: GpuBuffer<float>,
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x >= n || y >= n { return; }
    let i = y * n + x;
    let dt: float = 0.9;
    let px: float = (float)x - dt * vx[i];
    let py: float = (float)y - dt * vy[i];
    if px < 0.5 { px = 0.5; }
    if py < 0.5 { py = 0.5; }
    let nm1: float = (float)(n - 2);
    if px > nm1 { px = nm1; }
    if py > nm1 { py = nm1; }
    let x0 = (int)px;
    let y0 = (int)py;
    let x1 = x0 + 1;
    let y1 = y0 + 1;
    let sx: float = px - x0;
    let sy: float = py - y0;
    let v00: float = src[y0 * n + x0];
    let v10: float = src[y0 * n + x1];
    let v01: float = src[y1 * n + x0];
    let v11: float = src[y1 * n + x1];
    dst[i] = (1.0 - sx) * ((1.0 - sy) * v00 + sy * v01) + sx * ((1.0 - sy) * v10 + sy * v11);
}

@compute(8, 8)
fun divergence(
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    div: GpuBuffer<float>,
    p: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1 { return; }
    let i = y * n + x;
    div[i] = 0.0 - 0.5 * (vx[i + 1] - vx[i - 1] + vy[i + n] - vy[i - n]);
    p[i] = 0.0;
}

@compute(8, 8)
fun pressure_jacobi(
    @readonly div: GpuBuffer<float>,
    @readonly p: GpuBuffer<float>,
    p_out: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1 { return; }
    let i = y * n + x;
    p_out[i] = (div[i] + p[i - 1] + p[i + 1] + p[i - n] + p[i + n]) * 0.25;
}

@compute(8, 8)
fun subtract_gradient(
    vx: GpuBuffer<float>,
    vy: GpuBuffer<float>,
    @readonly p: GpuBuffer<float>,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x <= 0 || y <= 0 || x >= n - 1 || y >= n - 1 { return; }
    let i = y * n + x;
    vx[i] = vx[i] - 0.5 * (p[i + 1] - p[i - 1]);
    vy[i] = vy[i] - 0.5 * (p[i + n] - p[i - n]);
}

@compute(8, 8)
fun decay_field(
    field: GpuBuffer<float>,
    n: int,
    _ey: int,
    _ez: int,
    factor: float
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x >= n || y >= n { return; }
    let i = y * n + x;
    field[i] = field[i] * factor;
}

@compute(8, 8)
fun paint(
    @readonly dens: GpuBuffer<float>,
    @readonly vx: GpuBuffer<float>,
    @readonly vy: GpuBuffer<float>,
    tex: GpuTexture,
    n: int
): void {
    let x = global_id.x;
    let y = global_id.y;
    if x >= n || y >= n { return; }
    let i = y * n + x;
    let d = dens[i];
    if d < 0.0 { d = 0.0; }
    if d > 1.0 { d = 1.0; }
    let s: float = GpuMath.sqrt(vx[i] * vx[i] + vy[i] * vy[i]);
    if s > 1.0 { s = 1.0; }
    let t: float = d * 0.75 + s * 0.25;
    let r: float = 0.0;
    let g: float = 0.0;
    let b: float = 0.0;
    if t < 0.2 {
        let u = t / 0.2;
        r = (10.0 + u * 20.0) / 255.0;
        g = (8.0 + u * 40.0) / 255.0;
        b = (40.0 + u * 120.0) / 255.0;
    } else if (t < 0.4) {
        let u = (t - 0.2) / 0.2;
        r = (30.0 + u * 10.0) / 255.0;
        g = (48.0 + u * 160.0) / 255.0;
        b = (160.0 + u * 40.0) / 255.0;
    } else if (t < 0.6) {
        let u = (t - 0.4) / 0.2;
        r = (40.0 + u * 180.0) / 255.0;
        g = (208.0 - u * 40.0) / 255.0;
        b = (200.0 - u * 160.0) / 255.0;
    } else if (t < 0.8) {
        let u = (t - 0.6) / 0.2;
        r = (220.0 + u * 35.0) / 255.0;
        g = (168.0 - u * 80.0) / 255.0;
        b = (40.0 + u * 120.0) / 255.0;
    } else {
        let u = (t - 0.8) / 0.2;
        r = 1.0;
        g = (88.0 + u * 167.0) / 255.0;
        b = (160.0 + u * 95.0) / 255.0;
    }
    Gpu.texture_store(tex, x, y, r, g, b, 1.0);
}

/// UI state for the fluid demo (mouse tracked via GpuSurface input).
class FluidApp {
    public n: int;
    public mouse_x: int;
    public mouse_y: int;
    public prev_mx: int;
    public prev_my: int;
    public mouse_down: bool;
    public frame: int;

    public constructor() {
        this.n = 512;
        this.mouse_x = 256;
        this.mouse_y = 256;
        this.prev_mx = 256;
        this.prev_my = 256;
        this.mouse_down = false;
        this.frame = 0;
    }
}

let app: FluidApp = FluidApp();

fun splat_uniforms(
    cx: float,
    cy: float,
    dye_amt: float,
    fx: float,
    fy: float,
    rad: float
): byte[] {
    return Uniforms.pack_f32([cx, cy, dye_amt, fx, fy, rad]);
}

async fun main(): void {
    let init = await Gpu.try_init();
    if init.is_err() {
        System.println("WebGPU unavailable — fluid needs Gpu.try_init");
        return;
    }

    let n = app.n;
    let cells = n * n;

    let surface_r = GpuSurface.create("fluid", n, n);
    if surface_r.is_err() {
        System.println("GpuSurface.create failed");
        return;
    }
    let surface = surface_r.unwrap();
    let tex = GpuTexture.rgba8(n, n);

    let dens = GpuBuffer<float>.alloc(cells);
    let dens_tmp = GpuBuffer<float>.alloc(cells);
    let vx = GpuBuffer<float>.alloc(cells);
    let vx_tmp = GpuBuffer<float>.alloc(cells);
    let vy = GpuBuffer<float>.alloc(cells);
    let vy_tmp = GpuBuffer<float>.alloc(cells);
    let div = GpuBuffer<float>.alloc(cells);
    let p0 = GpuBuffer<float>.alloc(cells);
    let p1 = GpuBuffer<float>.alloc(cells);

    // Seed a bright dye block on the GPU so the first frame is never empty.
    let seed = Buffer.alloc<float>(cells);
    for (let y = n / 3; y < (2 * n) / 3; y = y + 1) {
        for (let x = n / 3; x < (2 * n) / 3; x = x + 1) {
            seed[y * n + x] = 0.9;
        }
    }
    dens.write(seed);

    System.println("fluid gpu — ComputePass Stam + paint");

    let empty_u = Buffer.alloc<byte>(0);
    let dens_decay_u = Uniforms.pack_f32([0.996]);
    let vel_decay_u = Uniforms.pack_f32([0.995]);

    while !surface.close_requested {
        // One event-loop pump per frame (poll_events); then read latches.
        for (let ev in surface.poll_events()) {
            switch (ev) {
                KeyDown(code, _key, _repeat) => {
                    if code == KeyCode.Escape {
                        return;
                    }
                },
                _ => {},
            }
        }
        if surface.key_down(KeyCode.Escape) || surface.close_requested {
            return;
        }

        let ptr = surface.pointer();
        // Pointer is in surface client pixels; map onto the simulation grid.
        let sw = surface.width;
        let sh = surface.height;
        if sw < 1 { sw = n; }
        if sh < 1 { sh = n; }
        let mx = (int)(ptr.x * (float)n / (float)sw);
        let my = (int)(ptr.y * (float)n / (float)sh);
        if mx < 0 { mx = 0; }
        if my < 0 { my = 0; }
        if mx > n - 1 { mx = n - 1; }
        if my > n - 1 { my = n - 1; }
        app.prev_mx = app.mouse_x;
        app.prev_my = app.mouse_y;
        app.mouse_x = mx;
        app.mouse_y = my;
        app.mouse_down = ptr.down && ptr.inside;

        let ang: double = 0.07d * app.frame;
        let ox: float = (float)(n / 2) + (float)(Math.cos(ang) * (n / 5));
        let oy: float = (float)(n / 2) + (float)(Math.sin(ang) * (n / 5));
        let fx: float = (float)((0.0d - Math.sin(ang)) * 1.2d);
        let fy: float = (float)(Math.cos(ang) * 1.2d);

        // One ComputePass / one queue submit for the whole frame.
        let pass = ComputePass.begin();
        pass.dispatch_uniforms(
            "splat",
            [dens, vx, vy],
            n,
            n,
            1,
            splat_uniforms(ox, oy, 0.35, fx, fy, 20.0)
        );
        if app.mouse_down {
            let mfx: float = 0.8 * (float)(app.mouse_x - app.prev_mx);
            let mfy: float = 0.8 * (float)(app.mouse_y - app.prev_my);
            pass.dispatch_uniforms(
                "splat",
                [dens, vx, vy],
                n,
                n,
                1,
                splat_uniforms((float)app.mouse_x, (float)app.mouse_y, 0.95, mfx, mfy, 28.0)
            );
        }
        pass.dispatch("advect", [vx, vx_tmp, vx, vy], n, n, 1);
        pass.dispatch("advect", [vy, vy_tmp, vx, vy], n, n, 1);
        pass.dispatch("divergence", [vx_tmp, vy_tmp, div, p0], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p0, p1], n, n, 1);
        pass.dispatch("pressure_jacobi", [div, p1, p0], n, n, 1);
        pass.dispatch("subtract_gradient", [vx_tmp, vy_tmp, p0], n, n, 1);
        pass.dispatch("advect", [dens, dens_tmp, vx_tmp, vy_tmp], n, n, 1);
        pass.dispatch_uniforms("decay_field", [dens_tmp], n, n, 1, dens_decay_u);
        pass.dispatch_uniforms("decay_field", [vx_tmp], n, n, 1, vel_decay_u);
        pass.dispatch_uniforms("decay_field", [vy_tmp], n, n, 1, vel_decay_u);
        let paint = GpuBindList.begin().buffer(dens_tmp).buffer(vx_tmp).buffer(vy_tmp).texture(tex);
        pass.dispatch_bind("paint", paint, n, n, 1, empty_u);
        let sub = await pass.submit();
        if sub.is_err() {
            System.println("ComputePass.submit failed");
            return;
        }

        // Ping-pong handles for the next frame (no CPU readback).
        let swap_vx = vx;
        vx = vx_tmp;
        vx_tmp = swap_vx;
        let swap_vy = vy;
        vy = vy_tmp;
        vy_tmp = swap_vy;
        let swap_d = dens;
        dens = dens_tmp;
        dens_tmp = swap_d;

        let bl = await GpuRenderPass.blit(surface, tex);
        if bl.is_err() { return; }
        let pr = await surface.present();
        if pr.is_err() { return; }
        app.frame = app.frame + 1;
        await Gpu.frame();
    }
}
