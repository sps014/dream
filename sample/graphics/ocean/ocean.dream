// Fullscreen Seascape raymarch after Alexander Alekseev / TDM (Shadertoy Ms2SD1).
// A displaced mesh cannot match that look — this ports heightMapTracing + getSeaColor.
//
// Native: cargo run -- run sample/graphics/ocean/ocean.dream
// Browser: cargo run -- --runtime --web sample/graphics/ocean/ocean.dream
//          then serve sample/graphics/ocean → ocean.html

import system;
import system.gpu;

struct Vertex {
    public pos: GpuVec2;
}

struct VsOut {
    @builtin("position")
    public clip: GpuVec4;
    public pad: float;
}

@gpu
fun sea_noise(x: float, z: float): float {
    let ix: float = GpuMath.floor(x);
    let iz: float = GpuMath.floor(z);
    let fx: float = GpuMath.fract(x);
    let fz: float = GpuMath.fract(z);
    let ux: float = fx * fx * (3.0 - 2.0 * fx);
    let uz: float = fz * fz * (3.0 - 2.0 * fz);
    let h00: float = GpuMath.fract(GpuMath.sin(ix * 127.1 + iz * 311.7) * 43758.5453123);
    let h10: float = GpuMath.fract(GpuMath.sin((ix + 1.0) * 127.1 + iz * 311.7) * 43758.5453123);
    let h01: float = GpuMath.fract(GpuMath.sin(ix * 127.1 + (iz + 1.0) * 311.7) * 43758.5453123);
    let h11: float = GpuMath.fract(GpuMath.sin((ix + 1.0) * 127.1 + (iz + 1.0) * 311.7) * 43758.5453123);
    return -1.0 + 2.0 * GpuMath.mix(GpuMath.mix(h00, h10, ux), GpuMath.mix(h01, h11, ux), uz);
}

@gpu
fun sea_octave(ux: float, uz: float, choppy: float): float {
    let n: float = sea_noise(ux, uz);
    let ox: float = ux + n;
    let oz: float = uz + n;
    let wvx: float = 1.0 - GpuMath.abs(GpuMath.sin(ox));
    let wvz: float = 1.0 - GpuMath.abs(GpuMath.sin(oz));
    let swx: float = GpuMath.abs(GpuMath.cos(ox));
    let swz: float = GpuMath.abs(GpuMath.cos(oz));
    let mx: float = GpuMath.mix(wvx, swx, wvx);
    let mz: float = GpuMath.mix(wvz, swz, wvz);
    return GpuMath.pow(1.0 - GpuMath.pow(mx * mz, 0.65), choppy);
}

@gpu
fun sea_height(px: float, pz: float, sea_time: float, octaves: int): float {
    let SEA_HEIGHT: float = 0.6;
    let freq: float = 0.16;
    let amp: float = SEA_HEIGHT;
    let choppy: float = 4.0;
    let uvx: float = px * 0.75;
    let uvz: float = pz;
    let h: float = 0.0;
    for (let i = 0; i < octaves; i = i + 1) {
        h = h + (sea_octave((uvx + sea_time) * freq, (uvz + sea_time) * freq, choppy)
            + sea_octave((uvx - sea_time) * freq, (uvz - sea_time) * freq, choppy)) * amp;
        let nux: float = uvx * 1.6 + uvz * 1.2;
        let nuz: float = uvx * -1.2 + uvz * 1.6;
        uvx = nux;
        uvz = nuz;
        freq = freq * 1.9;
        amp = amp * 0.22;
        choppy = GpuMath.mix(choppy, 1.0, 0.2);
    }
    return h;
}

// Signed distance to sea surface: p.y - height (Ms2SD1 `map` / `map_detailed`).
@gpu
fun sea_map(px: float, py: float, pz: float, sea_time: float): float {
    return py - sea_height(px, pz, sea_time, 3);
}

@gpu
fun sea_map_detailed(px: float, py: float, pz: float, sea_time: float): float {
    return py - sea_height(px, pz, sea_time, 5);
}

@gpu
fun get_sky_color(e: GpuVec3): GpuVec3 {
    let y: float = (GpuMath.max(e.y, 0.0) * 0.8 + 0.2) * 0.8;
    return GpuVec3.of(
        GpuMath.pow(1.0 - y, 2.0) * 1.1,
        (1.0 - y) * 1.1,
        (0.6 + (1.0 - y) * 0.4) * 1.1
    );
}

@gpu
fun get_sea_color(p: GpuVec3, n: GpuVec3, l: GpuVec3, eye: GpuVec3, dist2: float): GpuVec3 {
    let SEA_HEIGHT: float = 0.6;
    let SEA_BASE = GpuVec3.of(0.0, 0.09, 0.18);
    let SEA_WATER = GpuVec3.of(0.8 * 0.6, 0.9 * 0.6, 0.6 * 0.6);

    let ndote: float = GpuMath.dot(n, -eye);
    let fres: float = GpuMath.clamp(1.0 - ndote, 0.0, 1.0);
    fres = GpuMath.min(fres * fres * fres, 0.5);

    let reflected = get_sky_color(GpuMath.reflect(eye, n));
    let diff: float = GpuMath.pow(GpuMath.max(GpuMath.dot(n, l) * 0.4 + 0.6, 0.0), 80.0);
    let refracted = SEA_BASE + SEA_WATER * (diff * 0.12);

    let col = GpuMath.mix(refracted, reflected, fres);

    let atten: float = GpuMath.max(1.0 - dist2 * 0.001, 0.0);
    let peak: float = (p.y - SEA_HEIGHT) * 0.18 * atten;
    col = col + SEA_WATER * peak;

    let spec_pow: float = 600.0 / GpuMath.sqrt(GpuMath.max(dist2, 1.0));
    let spec_dir = GpuMath.reflect(eye, n);
    let nrm: float = (spec_pow + 8.0) / (3.141592 * 8.0);
    let spec: float = GpuMath.pow(GpuMath.max(GpuMath.dot(spec_dir, l), 0.0), spec_pow) * nrm;
    return col + GpuVec3.splat(spec);
}

@gpu
fun get_normal(px: float, py: float, pz: float, eps: float, sea_time: float): GpuVec3 {
    let h0: float = sea_map_detailed(px, py, pz, sea_time);
    let hx: float = sea_map_detailed(px + eps, py, pz, sea_time);
    let hz: float = sea_map_detailed(px, py, pz + eps, sea_time);
    return GpuMath.normalize(GpuVec3.of(hx - h0, eps, hz - h0));
}

// Binary-search the height field (Ms2SD1 `heightMapTracing`).
@gpu
fun height_map_tracing(
    ox: float, oy: float, oz: float,
    dx: float, dy: float, dz: float,
    sea_time: float
): GpuVec3 {
    let tm: float = 0.0;
    let tx: float = 1000.0;
    let hx: float = sea_map(ox + dx * tx, oy + dy * tx, oz + dz * tx, sea_time);
    if (hx > 0.0) {
        return GpuVec3.of(ox + dx * tx, oy + dy * tx, oz + dz * tx);
    }
    let hm: float = sea_map(ox, oy, oz, sea_time);
    for (let i = 0; i < 32; i = i + 1) {
        let tmid: float = GpuMath.mix(tm, tx, hm / (hm - hx));
        let px: float = ox + dx * tmid;
        let py: float = oy + dy * tmid;
        let pz: float = oz + dz * tmid;
        let hmid: float = sea_map(px, py, pz, sea_time);
        if (hmid < 0.0) {
            tx = tmid;
            hx = hmid;
        } else {
            tm = tmid;
            hm = hmid;
        }
        if (GpuMath.abs(hmid) < 0.001) {
            return GpuVec3.of(px, py, pz);
        }
    }
    let tfin: float = GpuMath.mix(tm, tx, hm / (hm - hx));
    return GpuVec3.of(ox + dx * tfin, oy + dy * tfin, oz + dz * tfin);
}

// GLSL `dir * fromEuler(ang)`.
@gpu
fun apply_euler(dir: GpuVec3, ax: float, ay: float, az: float): GpuVec3 {
    let a1s = GpuMath.sin(ax);
    let a1c = GpuMath.cos(ax);
    let a2s = GpuMath.sin(ay);
    let a2c = GpuMath.cos(ay);
    let a3s = GpuMath.sin(az);
    let a3c = GpuMath.cos(az);

    let c0x: float = a1c * a3c + a1s * a2s * a3s;
    let c0y: float = a1c * a2s * a3s + a3c * a1s;
    let c0z: float = -a2c * a3s;
    let c1x: float = -a2c * a1s;
    let c1y: float = a1c * a2c;
    let c1z: float = a2s;
    let c2x: float = a3c * a1s * a2s + a1c * a3s;
    let c2y: float = a1s * a3s - a1c * a3c * a2s;
    let c2z: float = a2c * a3c;

    // v * M  (row-vector × columns of fromEuler)
    return GpuVec3.of(
        dir.x * c0x + dir.y * c1x + dir.z * c2x,
        dir.x * c0y + dir.y * c1y + dir.z * c2y,
        dir.x * c0z + dir.y * c1z + dir.z * c2z
    );
}

@vertex
fun sea_vs(v: Vertex): VsOut {
    let o = VsOut();
    o.clip = GpuVec4.of(v.pos.x, v.pos.y, 0.0, 1.0);
    o.pad = 0.0;
    return o;
}

@fragment
fun sea_fs(v: VsOut, time: float, res_x: float, res_y: float): GpuVec4 {
    let cam_t: float = time * 0.3;
    let sea_time: float = 1.0 + time * 0.8;

    // WebGPU frag_coord is top-left; Shadertoy is bottom-left.
    let fx: float = frag_coord.x;
    let fy: float = res_y - frag_coord.y;
    let uvx: float = (fx / res_x) * 2.0 - 1.0;
    let uvy: float = (fy / res_y) * 2.0 - 1.0;
    uvx = uvx * (res_x / res_y);

    let ang_x: float = GpuMath.sin(cam_t * 3.0) * 0.1;
    let ang_y: float = GpuMath.sin(cam_t) * 0.2 + 0.3;
    let ang_z: float = cam_t;

    let ori = GpuVec3.of(0.0, 3.5, cam_t * 5.0);
    let dir0 = GpuMath.normalize(GpuVec3.of(uvx, uvy, -2.0));
    let pull: float = GpuMath.sqrt(uvx * uvx + uvy * uvy) * 0.14;
    let dir1 = GpuMath.normalize(GpuVec3.of(dir0.x, dir0.y, dir0.z + pull));
    let dir = apply_euler(dir1, ang_x, ang_y, ang_z);

    let p = height_map_tracing(ori.x, ori.y, ori.z, dir.x, dir.y, dir.z, sea_time);
    let dist = p - ori;
    let dist2: float = GpuMath.dot(dist, dist);
    let eps: float = dist2 * (0.1 / res_x);
    let n = get_normal(p.x, p.y, p.z, eps, sea_time);
    let light = GpuMath.normalize(GpuVec3.of(0.0, 1.0, 0.8));

    let sea = get_sea_color(p, n, light, dir, dist2);
    let sky = get_sky_color(dir);
    // smoothstep(0.0, -0.02, dir.y) then pow(_, 0.2) — sky above horizon.
    let t: float = GpuMath.clamp((-dir.y) / 0.02, 0.0, 1.0);
    t = t * t * (3.0 - 2.0 * t);
    let mix_k: float = GpuMath.pow(t, 0.2);

    let rgb = GpuMath.mix(sky, sea, mix_k);
    rgb = GpuMath.pow(GpuMath.saturate(rgb), 0.65);
    return GpuVec4.of(rgb.x, rgb.y, rgb.z, 1.0);
}

fun make_vert(x: float, y: float): Vertex {
    let v = Vertex();
    v.pos = GpuVec2.of(x, y);
    return v;
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — ocean needs Gpu.try_init");
        return;
    }

    let surface_r = GpuSurface.create("ocean", 1280, 720);
    if (surface_r.is_err()) {
        System.println("GpuSurface.create failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());

    let w: int = surface.width();
    let h: int = surface.height();
    if (w < 1) { w = 1280; }
    if (h < 1) { h = 720; }

    let desc = GpuRenderPipelineDesc.overlay();
    let pipe_r = await GpuRenderPipeline.create_ex("sea_vs", "sea_fs", desc);
    if (pipe_r.is_err()) {
        System.println("GpuRenderPipeline.create_ex failed");
        return;
    }
    let pipe = pipe_r.unwrap_or(GpuRenderPipeline());

    // Fullscreen triangle covers clip space.
    let verts = GpuBuffer<Vertex>.vertex_from([
        make_vert(-1.0, -1.0),
        make_vert(3.0, -1.0),
        make_vert(-1.0, 3.0),
    ]);

    let sky = GpuVec4.of(0.44, 0.77, 0.99, 1.0);
    let t0: long = Time.nano_time();

    while (!surface.close_requested()) {
        w = surface.width();
        h = surface.height();
        if (w < 1) { w = 1280; }
        if (h < 1) { h = 720; }
        let rw: float = (float)w;
        let rh: float = (float)h;
        let now: long = Time.nano_time();
        let t: float = (float)(now - t0) / 1000000000.0;
        let uniforms = Uniforms.pack_f32([t, rw, rh]);
        let _ = await GpuRenderPass.draw_ex(surface, pipe, verts, 3, uniforms, sky);
        let _ = await surface.present();
        await Gpu.frame();
    }
}
