// Realistic Gerstner-wave ocean: `@vertex` displaces a grid; `@fragment` does
// fresnel water + specular sun + foam on steep crests.
//
// Build: cargo run -- --runtime --web sample/graphics/ocean/ocean.dream
// Browser: serve repo root, open sample/graphics/ocean/ocean.html

import system;
import system.gpu;

struct Vertex {
    public xz: GpuVec2;
}

struct VsOut {
    public position: GpuVec4;
    public world: GpuVec3;
    public normal: GpuVec3;
    public view_dir: GpuVec3;
    public foam: float;
}

@vertex
fun ocean_vs(v: Vertex, time: float, cam_y: float, cam_z: float, aspect: float): VsOut {
    let x0: float = v.xz.x;
    let z0: float = v.xz.y;

    let px: float = x0;
    let py: float = 0.0;
    let pz: float = z0;
    let txx: float = 1.0;
    let txy: float = 0.0;
    let txz: float = 0.0;
    let tzx: float = 0.0;
    let tzy: float = 0.0;
    let tzz: float = 1.0;

    // Wave 1
    let dx1: float = 0.92;
    let dz1: float = 0.39;
    let a1: float = 0.22;
    let q1: float = 0.55;
    let k1: float = 6.2831853 / 7.5;
    let w1: float = 1.05 * GpuMath.sqrt(9.8 * k1);
    let ph1: float = k1 * (dx1 * x0 + dz1 * z0) - w1 * time;
    let s1: float = GpuMath.sin(ph1);
    let c1: float = GpuMath.cos(ph1);
    px = px + dx1 * q1 * a1 * c1;
    py = py + a1 * s1;
    pz = pz + dz1 * q1 * a1 * c1;
    txx = txx - dx1 * dx1 * q1 * k1 * a1 * s1;
    txy = txy + dx1 * k1 * a1 * c1;
    txz = txz - dx1 * dz1 * q1 * k1 * a1 * s1;
    tzx = tzx - dx1 * dz1 * q1 * k1 * a1 * s1;
    tzy = tzy + dz1 * k1 * a1 * c1;
    tzz = tzz - dz1 * dz1 * q1 * k1 * a1 * s1;

    // Wave 2
    let dx2: float = 0.0 - 0.55;
    let dz2: float = 0.83;
    let a2: float = 0.14;
    let q2: float = 0.45;
    let k2: float = 6.2831853 / 4.2;
    let w2: float = 1.25 * GpuMath.sqrt(9.8 * k2);
    let ph2: float = k2 * (dx2 * x0 + dz2 * z0) - w2 * time;
    let s2: float = GpuMath.sin(ph2);
    let c2: float = GpuMath.cos(ph2);
    px = px + dx2 * q2 * a2 * c2;
    py = py + a2 * s2;
    pz = pz + dz2 * q2 * a2 * c2;
    txx = txx - dx2 * dx2 * q2 * k2 * a2 * s2;
    txy = txy + dx2 * k2 * a2 * c2;
    txz = txz - dx2 * dz2 * q2 * k2 * a2 * s2;
    tzx = tzx - dx2 * dz2 * q2 * k2 * a2 * s2;
    tzy = tzy + dz2 * k2 * a2 * c2;
    tzz = tzz - dz2 * dz2 * q2 * k2 * a2 * s2;

    // Wave 3
    let dx3: float = 0.25;
    let dz3: float = 0.0 - 0.97;
    let a3: float = 0.09;
    let q3: float = 0.40;
    let k3: float = 6.2831853 / 2.6;
    let w3: float = 1.55 * GpuMath.sqrt(9.8 * k3);
    let ph3: float = k3 * (dx3 * x0 + dz3 * z0) - w3 * time;
    let s3: float = GpuMath.sin(ph3);
    let c3: float = GpuMath.cos(ph3);
    px = px + dx3 * q3 * a3 * c3;
    py = py + a3 * s3;
    pz = pz + dz3 * q3 * a3 * c3;
    txx = txx - dx3 * dx3 * q3 * k3 * a3 * s3;
    txy = txy + dx3 * k3 * a3 * c3;
    txz = txz - dx3 * dz3 * q3 * k3 * a3 * s3;
    tzx = tzx - dx3 * dz3 * q3 * k3 * a3 * s3;
    tzy = tzy + dz3 * k3 * a3 * c3;
    tzz = tzz - dz3 * dz3 * q3 * k3 * a3 * s3;

    // Wave 4
    let dx4: float = 0.0 - 0.80;
    let dz4: float = 0.0 - 0.60;
    let a4: float = 0.05;
    let q4: float = 0.35;
    let k4: float = 6.2831853 / 1.4;
    let w4: float = 1.85 * GpuMath.sqrt(9.8 * k4);
    let ph4: float = k4 * (dx4 * x0 + dz4 * z0) - w4 * time;
    let s4: float = GpuMath.sin(ph4);
    let c4: float = GpuMath.cos(ph4);
    px = px + dx4 * q4 * a4 * c4;
    py = py + a4 * s4;
    pz = pz + dz4 * q4 * a4 * c4;
    txx = txx - dx4 * dx4 * q4 * k4 * a4 * s4;
    txy = txy + dx4 * k4 * a4 * c4;
    txz = txz - dx4 * dz4 * q4 * k4 * a4 * s4;
    tzx = tzx - dx4 * dz4 * q4 * k4 * a4 * s4;
    tzy = tzy + dz4 * k4 * a4 * c4;
    tzz = tzz - dz4 * dz4 * q4 * k4 * a4 * s4;

    // Wave 5 (chop)
    let dx5: float = 0.60;
    let dz5: float = 0.80;
    let a5: float = 0.03;
    let q5: float = 0.30;
    let k5: float = 6.2831853 / 0.85;
    let w5: float = 2.20 * GpuMath.sqrt(9.8 * k5);
    let ph5: float = k5 * (dx5 * x0 + dz5 * z0) - w5 * time;
    let s5: float = GpuMath.sin(ph5);
    let c5: float = GpuMath.cos(ph5);
    px = px + dx5 * q5 * a5 * c5;
    py = py + a5 * s5;
    pz = pz + dz5 * q5 * a5 * c5;
    txx = txx - dx5 * dx5 * q5 * k5 * a5 * s5;
    txy = txy + dx5 * k5 * a5 * c5;
    txz = txz - dx5 * dz5 * q5 * k5 * a5 * s5;
    tzx = tzx - dx5 * dz5 * q5 * k5 * a5 * s5;
    tzy = tzy + dz5 * k5 * a5 * c5;
    tzz = tzz - dz5 * dz5 * q5 * k5 * a5 * s5;

    let tx = GpuVec3.of(txx, txy, txz);
    let tz = GpuVec3.of(tzx, tzy, tzz);
    let n = GpuMath.normalize(GpuMath.cross(tz, tx));
    let foam: float = GpuMath.clamp((txx + tzz - 1.55) * 2.2, 0.0, 1.0);

    let pos = GpuVec3.of(px, py, pz);
    let eye = GpuVec3.of(0.0, cam_y, cam_z);
    let target = GpuVec3.of(0.0, 0.05, 0.0);
    let forward = GpuMath.normalize(GpuVec3.of(
        target.x - eye.x,
        target.y - eye.y,
        target.z - eye.z
    ));
    let right = GpuMath.normalize(GpuMath.cross(forward, GpuVec3.of(0.0, 1.0, 0.0)));
    let up = GpuMath.cross(right, forward);

    let to_eye = GpuVec3.of(pos.x - eye.x, pos.y - eye.y, pos.z - eye.z);
    let vx: float = GpuMath.dot(to_eye, right);
    let vy: float = GpuMath.dot(to_eye, up);
    let vz: float = GpuMath.dot(to_eye, forward);

    let f: float = 1.85;
    let near: float = 0.15;
    let far: float = 80.0;
    let clip = GpuVec4.of(
        vx * f / aspect,
        vy * f,
        ((far + near) / (far - near)) * vz - (2.0 * far * near) / (far - near),
        vz
    );

    let view_dir = GpuMath.normalize(GpuVec3.of(eye.x - pos.x, eye.y - pos.y, eye.z - pos.z));

    let o = VsOut();
    o.position = clip;
    o.world = pos;
    o.normal = n;
    o.view_dir = view_dir;
    o.foam = foam;
    return o;
}

@fragment
fun ocean_fs(v: VsOut): GpuVec4 {
    let n = GpuMath.normalize(v.normal);
    let view = GpuMath.normalize(v.view_dir);

    let light = GpuMath.normalize(GpuVec3.of(0.45, 0.75, 0.35));
    let ndl: float = GpuMath.max(GpuMath.dot(n, light), 0.0);

    let deep_r: float = 0.01;
    let deep_g: float = 0.08;
    let deep_b: float = 0.16;
    let sh_r: float = 0.02;
    let sh_g: float = 0.28;
    let sh_b: float = 0.38;
    let height_t: float = GpuMath.clamp(v.world.y * 1.8 + 0.35, 0.0, 1.0);
    let wr: float = GpuMath.mix(deep_r, sh_r, height_t);
    let wg: float = GpuMath.mix(deep_g, sh_g, height_t);
    let wb: float = GpuMath.mix(deep_b, sh_b, height_t);

    let fres: float = GpuMath.pow(1.0 - GpuMath.clamp(GpuMath.dot(n, view), 0.0, 1.0), 4.0);
    let sky_r: float = 0.45;
    let sky_g: float = 0.68;
    let sky_b: float = 0.92;
    let hor_r: float = 0.72;
    let hor_g: float = 0.82;
    let hor_b: float = 0.95;
    let sky_t: float = GpuMath.clamp(n.y * 0.5 + 0.5, 0.0, 1.0);
    let scr: float = GpuMath.mix(hor_r, sky_r, sky_t);
    let scg: float = GpuMath.mix(hor_g, sky_g, sky_t);
    let scb: float = GpuMath.mix(hor_b, sky_b, sky_t);

    let br: float = GpuMath.mix(wr, scr, fres * 0.85);
    let bg: float = GpuMath.mix(wg, scg, fres * 0.85);
    let bb: float = GpuMath.mix(wb, scb, fres * 0.85);

    let halfv = GpuMath.normalize(GpuVec3.of(
        light.x + view.x,
        light.y + view.y,
        light.z + view.z
    ));
    let spec: float = GpuMath.pow(GpuMath.max(GpuMath.dot(n, halfv), 0.0), 128.0);
    let lit: float = 0.28 + ndl * 0.55;

    let cr: float = br * lit + spec * 0.95;
    let cg: float = bg * lit + spec * 0.90;
    let cb: float = bb * lit + spec * 0.85;

    let foam = v.foam;
    cr = GpuMath.mix(cr, 0.92, foam);
    cg = GpuMath.mix(cg, 0.95, foam);
    cb = GpuMath.mix(cb, 0.98, foam);

    let dist: float = GpuMath.length(v.world);
    let haze: float = GpuMath.clamp((dist - 8.0) / 28.0, 0.0, 0.55);
    cr = GpuMath.mix(cr, sky_r, haze);
    cg = GpuMath.mix(cg, sky_g, haze);
    cb = GpuMath.mix(cb, sky_b, haze);

    return GpuVec4.of(cr, cg, cb, 1.0);
}

fun make_grid(n: int, half: float): GpuBuffer<Vertex> {
    let count = n * n;
    let verts = Buffer.alloc<Vertex>(count);
    let step: float = (half * 2.0) / (float)(n - 1);
    for (let j = 0; j < n; j = j + 1) {
        for (let i = 0; i < n; i = i + 1) {
            let v = Vertex();
            v.xz = GpuVec2.of(0.0 - half + (float)i * step, 0.0 - half + (float)j * step);
            verts[j * n + i] = v;
        }
    }
    return GpuBuffer<Vertex>.vertex_from(verts);
}

fun make_indices(n: int): GpuBuffer<int> {
    let quads = (n - 1) * (n - 1);
    let idx = Buffer.alloc<int>(quads * 6);
    let p = 0;
    for (let j = 0; j < n - 1; j = j + 1) {
        for (let i = 0; i < n - 1; i = i + 1) {
            let a = j * n + i;
            let b = a + 1;
            let c = a + n;
            let d = c + 1;
            idx[p] = a; p = p + 1;
            idx[p] = c; p = p + 1;
            idx[p] = b; p = p + 1;
            idx[p] = b; p = p + 1;
            idx[p] = c; p = p + 1;
            idx[p] = d; p = p + 1;
        }
    }
    return GpuBuffer<int>.from(idx);
}

async fun main(): void {
    let init = await Gpu.try_init();
    if (init.is_err()) {
        System.println("WebGPU unavailable — ocean needs Gpu.try_init");
        return;
    }

    let surface_r = GpuSurface.from_canvas("ocean");
    if (surface_r.is_err()) {
        System.println("GpuSurface.from_canvas failed");
        return;
    }
    let surface = surface_r.unwrap_or(GpuSurface());

    let w = 960;
    let h = 540;
    surface.configure(w, h);

    let pipe_r = await GpuRenderPipeline.create("ocean_vs", "ocean_fs");
    if (pipe_r.is_err()) {
        System.println("GpuRenderPipeline.create failed");
        return;
    }
    let pipe = pipe_r.unwrap_or(GpuRenderPipeline());

    let n = 128;
    let verts = make_grid(n, 14.0);
    let indices = make_indices(n);
    let index_count = (n - 1) * (n - 1) * 6;

    let sky = GpuVec4.of(0.42, 0.62, 0.88, 1.0);
    let t: float = 0.0;
    let aspect: float = (float)w / (float)h;

    while (true) {
        t = t + 0.016;
        let uniforms = Uniforms.pack_f32([t, 6.5, 16.0, aspect]);
        let _ = await GpuRenderPass.draw_indexed_ex(
            surface,
            pipe,
            verts,
            indices,
            index_count,
            uniforms,
            sky
        );
        let _ = await surface.present();
        await Gpu.frame();
    }
}
