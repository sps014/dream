import system;
import system.gpu;
import system.window;
import game.simulation;
import game.enemy;
import game.ragdoll;
import renderer;

async fun play(window: Window): Result<bool, GpuError> {
    let benchmark = false;
    let soak = false;
    let soak_toggle_rt = false;
    let capture_path = "";
    for (let i in 0..System.args.length) {
        if System.args[i] == "--capture" && i + 1 < System.args.length {
            capture_path = System.args[i + 1];
            benchmark = true;
        }
    }
    let benchmark_low = false;
    let benchmark_high = false;
    let benchmark_ultra = false;
    let benchmark_combat = false;
    let benchmark_view = 0;
    let capture_weapon = 0;
    let capture_aim = false;
    let capture_reload = false;
    let inspect_pose = -1;
    for (let arg in System.args) {
        if arg == "--soak" || arg == "--soak-toggle-rt" {
            soak_toggle_rt = arg == "--soak-toggle-rt";
            soak = true;
            benchmark = true;
            benchmark_combat = true;
        }
        if arg == "--benchmark" || arg == "--benchmark-low" || arg == "--benchmark-combat" {
            benchmark = true;
        }
        if arg == "--benchmark-low" {
            benchmark_low = true;
        }
        if arg == "--benchmark-ultra" {
            benchmark = true;
            benchmark_ultra = true;
        }
        if arg == "--benchmark-high" {
            benchmark = true;
            benchmark_high = true;
        }
        if arg == "--benchmark-combat" {
            benchmark_combat = true;
        }
        if arg == "--benchmark-extraction" {
            benchmark = true;
            benchmark_view = 1;
        }
        if arg == "--inspect-idle" || arg == "--inspect-hit" || arg == "--inspect-death" {
            benchmark = true;
            benchmark_view = 6;
            inspect_pose = 0;
            if arg == "--inspect-hit" {
                inspect_pose = 4;
            }
            if arg == "--inspect-death" {
                inspect_pose = 3;
            }
        }
        if arg == "--benchmark-barrels" {
            benchmark = true;
            benchmark_view = 5;
        }
        if arg == "--benchmark-quarry" {
            benchmark = true;
            benchmark_view = 3;
        }
        if arg == "--benchmark-orchard" {
            benchmark = true;
            benchmark_view = 4;
        }
        if arg == "--benchmark-arrival" {
            benchmark = true;
            benchmark_view = 2;
        }
        if arg == "--sniper" {
            capture_weapon = 2;
        }
        if arg == "--shotgun" {
            capture_weapon = 1;
        }
        if arg == "--aim" {
            capture_aim = true;
        }
        if arg == "--reload" {
            capture_reload = true;
        }
    }
    let showcase = false;
    for (let arg in System.args) {
        if arg == "--showcase" {
            showcase = true;
        }
    }
    let benchmark_frame = 0;
    let game = Game();
    for (let arg in System.args) {
        if arg == "--summer" {
            game.seasons.current = 1;
        }
        if arg == "--spring" {
            game.seasons.current = 0;
        }
        if arg == "--autumn" {
            game.seasons.current = 2;
        }
    }
    if showcase {
        game.enemies = [
            Enemy(2.2f, 20.0f, 0),
            Enemy(-3.0f, 25.0f, 1),
            Enemy(4.0f, 29.0f, 0),
            Enemy(-5.0f, 36.0f, 0)
        ];
        game.waves.spawn_timer = 10000.0f;
    }
    if benchmark_view == 5 {
        game.enemies = [Enemy(-5.0f, 18.0f, 0), Enemy(-1.0f, 22.0f, 1)];
        game.waves.spawn_timer = 10000.0f;
    }
    if benchmark_view == 6 {
        game.enemies = [Enemy(-1.4f, 18.0f, 0), Enemy(0.0f, 18.0f, 0), Enemy(1.4f, 18.0f, 1)];
        game.waves.spawn_timer = 10000.0f;
        for (let i in 0..3) {
            game.enemies[i].appearance = i;
            game.enemies[i].body = Ragdoll(game.enemies[i].kind, i);
        }
    }
    for (let arg in System.args) {
        if arg == "--dogs" {
            game.enemies = [Enemy(-1.4f, 18.0f, 2), Enemy(0.6f, 18.0f, 0), Enemy(2.2f, 19.0f, 2)];
            game.waves.spawn_timer = 10000.0f;
        }
        if arg == "--tracks" {
            for (let step in 0..20) {
                game.seasons.record(
                    0,
                    GpuVec3(-0.7f, 1.87f, 11.0f + (float)step * 0.55f),
                    0.0f,
                    false,
                    0.0f
                );
                game.seasons.record(
                    1,
                    GpuVec3(1.4f, 0.77f, 12.0f + (float)step * 0.55f),
                    0.0f,
                    true,
                    0.0f
                );
            }
        }
    }
    if inspect_pose == 3 {
        for (let enemy in game.enemies) {
            enemy.health = 0;
            enemy.impulse = GpuVec3((float)Math.sin(enemy.position.x) * 3.0f, 1.5f, 3.0f);
            enemy.play(3);
        }
    }
    let renderer = Renderer.create(window, game).await?;
    for (let arg in System.args) {
        if arg == "--rt" {
            renderer.toggle_ray_tracing().await?;
        }
        if arg == "--materials" {
            renderer.calibration = true;
        }
    }
    System.println("Procedural wave survival | Raster default | T optional hardware RT");
    let quality = 1;
    if !benchmark || benchmark_high {
        quality = 2;
    }
    if benchmark_ultra {
        quality = 3;
    }
    if benchmark_low {
        quality = 0;
    }
    let paused = true;
    let focused = true;
    let capture_grace = 0.0f;
    let accumulator = 0.0f;
    let measure_time = 0.0f;
    let frames = 0;
    let timings = List<float>();
    System.println(
        "Gravewake ready | WASD / mouse | RMB aim | R reload | Shift sprint | Ctrl crouch | Space jump"
    );
    while window.is_open {
        let input = window.poll();
        for (let event in input.events) {
            switch (event) {
                WindowEvent.Resized(size) => {
                    if size.width > 0 && size.height > 0 {
                        renderer.resize(size.width, size.height)?;
                    }
                }
                WindowEvent.Unfocused => {
                    focused = false;
                    paused = true;
                    accumulator = 0.0f;
                    game.controller.velocity = GpuVec3(0.0f);
                    game.controller.aiming = false;
                    window.set_cursor_mode(CursorMode.Normal);
                }
                WindowEvent.Focused => {
                    focused = true;
                }
                _ => {}
            }
        }
        if !window.is_open {
            break;
        }
        if benchmark {
            paused = false;
            focused = true;
            game.position = GpuVec3(0.0f, 1.65f, 14.0f);
            game.yaw = 0.3f;
            game.pitch = -0.12f;
            if soak {
                game.yaw = (float)benchmark_frame * 0.009f;
                quality = (benchmark_frame / 240) % 4;
                game.weapon = (benchmark_frame / 120) % 3;
                game.rounds = 1000;
                if benchmark_frame % 180 == 0 {
                    game.grenades.remaining = 3;
                    game.throw_grenade();
                }
                game.shells = 1000;
                if benchmark_frame % 120 == 0 {
                    game.charge = 100;
                    game.shockwave();
                }
                if soak_toggle_rt && benchmark_frame % 600 == 0 {
                    renderer.toggle_ray_tracing().await?;
                }
            }
            if benchmark_view == 1 {
                game.position = GpuVec3(0.0f, 1.65f, 35.0f);
                game.yaw = 0.0f;
            } else if benchmark_view == 2 {
                game.position = GpuVec3(0.0f, 1.65f, 0.0f);
                game.yaw = 0.0f;
            }
            if benchmark_view == 3 {
                game.position = GpuVec3(-28.0f, 1.65f, 42.0f);
                game.yaw = -0.3f;
            } else if benchmark_view == 4 {
                game.position = GpuVec3(29.0f, 1.65f, 49.0f);
                game.yaw = 0.2f;
            }
            if benchmark_view == 5 {
                game.position = GpuVec3(-2.0f, 1.65f, 14.0f);
                game.yaw = -0.982794f;
                game.pitch = -0.2835f;
                if benchmark_frame == 20 {
                    game.fire();
                }
            }
            if benchmark_view == 6 {
                game.position = GpuVec3(0.0f, 1.65f, 13.0f);
                game.yaw = 0.0f;
                game.pitch = -0.14f;
                for (let enemy in game.enemies) {
                    if inspect_pose == 3 {
                        continue;
                    }
                    enemy.animation = inspect_pose;
                    enemy.animation_time = 0.0f;
                    enemy.blend_age = 1.0f;
                    enemy.stagger = 1.0f;
                    if inspect_pose == 3 {
                        enemy.health = 0;
                        enemy.animation_time = 1.25f;
                    } else if inspect_pose == 4 {
                        enemy.animation_time = 0.08f;
                    }
                }
            }
            if capture_path != "" {
                game.weapon = capture_weapon;
                if capture_aim {
                    game.controller.aim = 1.0f;
                }
                if capture_reload {
                    game.controller.reload_duration = 1.7f;
                    game.controller.reload_remaining = 0.85f;
                }
            }
            game.health = 100;
            game.bullets = 1000;
        }
        let resumed = false;
        if input.keyboard.pressed(KeyCode.Escape) {
            paused = true;
            accumulator = 0.0f;
            game.controller.velocity = GpuVec3(0.0f);
            game.controller.aiming = false;
            window.set_cursor_mode(CursorMode.Normal);
        } else if paused && focused && game.state == 0 && input.mouse.pressed(MouseButton.Left) {
            paused = false;
            resumed = true;
            capture_grace = 0.08f;
            window.set_cursor_mode(CursorMode.Captured);
        }
        if input.keyboard.pressed(KeyCode.F11) {
            window.set_fullscreen(!window.is_fullscreen);
        }
        if input.keyboard.pressed(KeyCode.T) {
            switch (renderer.toggle_ray_tracing().await) {
                Ok(enabled) => {}
                Err(error) => {
                    System.println("RT disabled: " + error.message());
                    renderer.ray_tracing = false;
                    renderer.ray_tracing_available = false;
                }
            }
        }
        if input.keyboard.pressed(KeyCode.N) {
            game.seasons.cycle();
        }
        if input.keyboard.pressed(KeyCode.Q) {
            quality = (quality + 1) % 4;
        }
        if game.state != 0 && input.keyboard.pressed(KeyCode.R) {
            game = Game();
            paused = true;
            accumulator = 0.0f;
            window.set_cursor_mode(CursorMode.Normal);
        }
        let dt = (float)Math.min(input.delta_seconds, 0.1f);
        if benchmark {
            dt = 1.0f / 60.0f;
        }
        capture_grace = (float)Math.max(0.0f, capture_grace - dt);
        if !paused && game.state == 0 {
            if !resumed && capture_grace <= 0.0f {
                game.look(input.mouse.delta.x, input.mouse.delta.y);
            }
            if input.keyboard.is_down(KeyCode.ArrowLeft) {
                game.yaw = game.yaw - dt * 1.8f;
            }
            if input.keyboard.is_down(KeyCode.ArrowRight) {
                game.yaw = game.yaw + dt * 1.8f;
            }
            if input.keyboard.pressed(KeyCode.Digit1) {
                game.weapon = 0;
            }
            if input.keyboard.pressed(KeyCode.Digit2) {
                game.weapon = 1;
            }
            if input.keyboard.pressed(KeyCode.Digit3) {
                game.weapon = 2;
            }
            if input.keyboard.pressed(KeyCode.G) {
                game.throw_grenade();
            }
            game.controller.aiming = input.mouse.is_down(MouseButton.Right)
                || (benchmark && capture_aim);
            game.controller.crouching = input.keyboard.is_down(KeyCode.ControlLeft);
            if input.keyboard.pressed(KeyCode.Space) {
                game.controller.jump();
            }
            if input.keyboard.pressed(KeyCode.R) {
                let ammo = game.bullets;
                if game.weapon == 1 {
                    ammo = game.shells;
                }
                if game.weapon == 2 {
                    ammo = game.rounds;
                }
                game.audio.play(8, 0.4f);
                game.controller.start_reload(game.weapon, ammo);
            }
            game.controller.visual(dt, input.mouse.delta.x, input.mouse.delta.y);
            if input.keyboard.pressed(KeyCode.C) {
                game.dash();
            }
            if input.keyboard.pressed(KeyCode.F) {
                game.shockwave();
            }
            if input.keyboard.pressed(KeyCode.Z) {
                game.upgrade(0);
            }
            if input.keyboard.pressed(KeyCode.X) {
                game.upgrade(1);
            }
            if input.keyboard.pressed(KeyCode.E) {
                game.interact();
            }
            let forward = 0.0f;
            let strafe = 0.0f;
            if input.keyboard.is_down(KeyCode.W) {
                forward = forward + 1.0f;
            }
            if input.keyboard.is_down(KeyCode.S) {
                forward = forward - 1.0f;
            }
            if input.keyboard.is_down(KeyCode.D) {
                strafe = strafe + 1.0f;
            }
            if input.keyboard.is_down(KeyCode.A) {
                strafe = strafe - 1.0f;
            }
            accumulator = (float)Math.min(accumulator + dt, 5.0f / 60.0f);
            for (let step in 0..5) {
                if accumulator < 1.0f / 60.0f {
                    break;
                }
                game.tick(
                    1.0f / 60.0f,
                    forward,
                    strafe,
                    input.keyboard.is_down(KeyCode.ShiftLeft),
                    benchmark_combat || (!resumed && input.mouse.is_down(MouseButton.Left))
                );
                accumulator = accumulator - 1.0f / 60.0f;
            }
        }
        game.audio.music(
            game.waves.number,
            game.waves.alive(game.enemies),
            game.waves.intermission > 0.0f,
            game.state
        );
        game.audio.flush();
        if game.state != 0 {
            window.set_cursor_mode(CursorMode.Normal);
        }
        let size = window.pixel_size;
        if size.width <= 0 || size.height <= 0 {
            accumulator = 0.0f;
            Time.delay(50).await;
            continue;
        }
        let alpha = accumulator * 60.0f;
        if paused || benchmark {
            alpha = 1.0f;
        }
        renderer.render(window, game, paused, quality, alpha).await?;
        if benchmark {
            if benchmark_frame >= 30 {
                timings.push(input.delta_seconds * 1000.0f);
            }
            benchmark_frame = benchmark_frame + 1;
            if capture_path
                != "" && benchmark_frame >= 30 && (inspect_pose != 3 || benchmark_frame >= 120) {
                renderer.capture(capture_path, game, size.width, size.height).await?;
                System.println(
                    "Captured scene RGBA "
                        + size.width.to_string()
                        + "x" + size.height.to_string() + " to " + capture_path
                );
                break;
            }
            if benchmark_frame == 30 {
                measure_time = 0.0f;
                frames = 0;
            }
            if (!soak && benchmark_frame == 210) || (soak && measure_time >= 60.0f) {
                timings.sort();
                System.println(
                    "BENCHMARK quality="
                        + quality.to_string()
                        + " combat="
                        + benchmark_combat.to_string()
                        + " "
                        + renderer.width.to_string()
                        + "x"
                        + renderer.height.to_string()
                        + " view="
                        + benchmark_view.to_string()
                        + ": "
                        + (measure_time * 1000.0f / (float)frames)
                        .to_string()
                        + " ms/frame, "
                        + frames.to_string()
                        + " frames"
                        + " | p95="
                        + timings[(timings.length * 95) / 100]
                        .to_string()
                        + " p99=" + timings[(timings.length * 99) / 100]
                        .to_string() + " ms"
                );
                break;
            }
        }
        measure_time = measure_time + input.delta_seconds;
        frames = frames + 1;
        if !benchmark && measure_time >= 5.0f {
            System.println(
                "Frame timing: "
                    + (measure_time * 1000.0f / (float)frames)
                    .to_string()
                    + " ms | " + renderer.width.to_string() + "x" + renderer.height.to_string()
            );
            measure_time = 0.0f;
            frames = 0;
        }
    }
    return Result.Ok(true);
}

public async fun run_game(): void {
    let benchmark = false;
    let width = 1280;
    let height = 720;
    for (let arg in System.args) {
        if arg.starts_with("--benchmark")
            || arg == "--capture" || arg == "--soak" || arg == "--soak-toggle-rt" {
            benchmark = true;
        }
        if arg == "--benchmark-high" || arg == "--benchmark-ultra" {
            width = 1920;
            height = 1080;
        }
    }
    let opened = Window.open(
        WindowDesc.of("GRAVEWAKE | Campfire Carnage", width, height)
            .resizable(true)
            .vsync(!benchmark)
    );
    if opened.is_err() {
        System.println("Window error: " + opened.unwrap_err().message());
        return;
    }
    let window = opened.unwrap();
    switch (play(window).await) {
        Ok(_) => {}
        Err(error) => {
            System.println("GPU error: " + error.message());
        }
    }
    window.close();
}
