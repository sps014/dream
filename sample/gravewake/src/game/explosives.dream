import system;
import system.gpu;
import enemy;
import particles;
import level;
import level_geometry;

public class Explosives {
    public positions: GpuVec3[];
    public active: bool[];

    public constructor() {
        this.positions = hazard_positions();
        this.active = Array.alloc<bool>(this.positions.length);
        this.reset();
    }

    public fun reset(): void {
        for (let i in 0..this.active.length) {
            this.active[i] = true;
        }
    }

    public fun ray_target(origin: GpuVec3, direction: GpuVec3, limit: float): GpuVec2 {
        let target = -1;
        for (let i in 0..this.positions.length) {
            if !this.active[i] {
                continue;
            }
            let delta = origin - this.positions[i];
            let b = delta.dot(direction);
            let disc = b * b - delta.dot(delta) + 0.58f * 0.58f;
            if disc >= 0.0f {
                let distance = -b - (float)Math.sqrt(disc);
                if distance > 0.0f && distance < limit {
                    limit = distance;
                    target = i;
                }
            }
        }
        return GpuVec2((float)target, limit);
    }

    public fun detonate(
        index: int,
        enemies: Enemy[],
        boxes: WorldBox[],
        effects: Effects,
        player: GpuVec3
    ): GpuVec2 {
        if index < 0 || index >= this.positions.length || !this.active[index] {
            return GpuVec2(0.0f);
        }
        let pending = Array.alloc<int>(this.positions.length);
        let head = 0;
        let tail = 1;
        let kills = 0;
        let hurt = 0;
        pending[0] = index;
        this.active[index] = false;
        while head < tail {
            let center = this.positions[pending[head]];
            head = head + 1;
            effects.explode(center);
            for (let enemy in enemies) {
                let delta = enemy.position - center;
                let distance = delta.length();
                if enemy.health <= 0 || distance > 6.5f {
                    continue;
                }
                if wall_distance(boxes, center, delta / (float)Math.max(0.001f, distance)) < distance {
                    continue;
                }
                enemy.impulse = delta
                    / (float)Math.max(0.1f, distance) * 7.0f + GpuVec3(0.0f, 4.0f, 0.0f);
                enemy.health = enemy.health - 180;
                enemy.flash = 0.07f;
                enemy.attack_pending = false;
                if enemy.health > 0 {
                    enemy.play(4);
                }
                enemy.stagger = 0.4f;
                if enemy.health <= 0 {
                    kills = kills + 1;
                    enemy.play(3);
                }
            }
            let delta = player - center;
            let distance = delta.length();
            if distance < 4.0f
                && wall_distance(boxes, center, delta / (float)Math.max(0.001f, distance)) >= distance {
                hurt = hurt + 30;
            }
            for (let i in 0..this.positions.length) {
                delta = this.positions[i] - center;
                distance = delta.length();
                if this.active[i]
                    && distance < 7.0f
                    && wall_distance(boxes, center, delta / (float)Math.max(0.001f, distance)) >= distance {
                    this.active[i] = false;
                    pending[tail] = i;
                    tail = tail + 1;
                }
            }
        }
        return GpuVec2((float)kills, (float)hurt);
    }
}
