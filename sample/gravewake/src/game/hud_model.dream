import system;
import simulation;

fun write_text(cells: int[], x: int, y: int, text: string): void {
    for (let i in 0..text.length) {
        if x + i < 100 && y >= 0 && y < 56 {
            cells[y * 100 + x + i] = (int)text[i];
        }
    }
}

public fun hud_cells(
    game: Game,
    paused: bool,
    quality: int,
    rt: bool = false,
    rt_available: bool = true
): int[] {
    let cells = Array.alloc<int>(5600);
    write_text(cells, 5, 5, "WAVE " + game.waves.number.to_string());
    write_text(cells, 5, 50, game.health.to_string());
    let loaded = game.controller.rifle_loaded;
    if game.weapon == 1 {
        loaded = game.controller.shotgun_loaded;
    }
    if game.weapon == 2 {
        loaded = game.controller.sniper_loaded;
    }
    write_text(cells, 86, 50, loaded.to_string());
    write_text(cells, 86, 52, "G " + game.grenades.remaining.to_string());
    if game.controller.reload_remaining > 0.0f {
        write_text(cells, 82, 52, "RELOADING");
    }
    if game.waves.intermission > 0.0f && !game.waves.upgrade_taken {
        write_text(cells, 33, 44, "Z DAMAGE   X SPEED");
    }
    if paused && game.state == 0 {
        write_text(cells, 42, 25, "CLICK TO PLAY");
    } else if game.state != 0 {
        write_text(cells, 39, 25, "R TO TRY AGAIN");
    }
    return cells;
}
