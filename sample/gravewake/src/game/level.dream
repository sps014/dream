import system;
import system.gpu;
import level_geometry;

fun cpu_box_ray(origin: GpuVec3, direction: GpuVec3, box: WorldBox): float {
    let near = 0.001f;
    let far = 120.0f;
    for (let axis in 0..3) {
        let o = origin.x;
        let d = direction.x;
        let lo = box.lo.x;
        let hi = box.hi.x;
        if axis == 1 {
            o = origin.y;
            d = direction.y;
            lo = box.lo.y;
            hi = box.hi.y;
        } else if axis == 2 {
            o = origin.z;
            d = direction.z;
            lo = box.lo.z;
            hi = box.hi.z;
        }
        if Math.abs(d) < 0.000001f {
            if o < lo || o > hi {
                return 120.0f;
            }
        } else {
            let a = (lo - o) / d;
            let b = (hi - o) / d;
            near = (float)Math.max(near, Math.min(a, b));
            far = (float)Math.min(far, Math.max(a, b));
            if near > far {
                return 120.0f;
            }
        }
    }
    return near;
}

public fun wall_normal(boxes: WorldBox[], point: GpuVec3, fallback: GpuVec3): GpuVec3 {
    let normal = fallback;
    let closest = 0.1f;
    for (let box in boxes) {
        if point.x < box.lo.x
            - 0.01f
            || point.x > box.hi.x
            + 0.01f
            || point.y < box.lo.y
            - 0.01f
            || point.y > box.hi.y
            + 0.01f || point.z < box.lo.z - 0.01f || point.z > box.hi.z + 0.01f {
            continue;
        }
        let distances = [
            point.x - box.lo.x,
            box.hi.x - point.x,
            point.y - box.lo.y,
            box.hi.y - point.y,
            point.z - box.lo.z,
            box.hi.z - point.z
        ];
        let normals = [
            GpuVec3(-1.0f, 0.0f, 0.0f),
            GpuVec3(1.0f, 0.0f, 0.0f),
            GpuVec3(0.0f, -1.0f, 0.0f),
            GpuVec3(0.0f, 1.0f, 0.0f),
            GpuVec3(0.0f, 0.0f, -1.0f),
            GpuVec3(0.0f, 0.0f, 1.0f)
        ];
        for (let side in 0..6) {
            let distance = (float)Math.abs(distances[side]);
            if distance < closest {
                closest = distance;
                normal = normals[side];
            }
        }
    }
    return normal;
}

public fun wall_distance(boxes: WorldBox[], origin: GpuVec3, direction: GpuVec3): float {
    let distance = 120.0f;
    for (let box in boxes) {
        distance = (float)Math.min(distance, cpu_box_ray(origin, direction, box));
    }
    return distance;
}

public fun position_clear(boxes: WorldBox[], x: float, z: float, radius: float): bool {
    for (let box in boxes) {
        if box.hi.y > 0.2f && box.lo.y < 1.8f {
            if x > box.lo.x
                - radius && x < box.hi.x + radius && z > box.lo.z - radius && z < box.hi.z + radius {
                return false;
            }
        }
    }
    return true;
}
