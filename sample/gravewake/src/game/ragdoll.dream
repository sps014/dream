import system;
import system.gpu;
import rigs;
import level_geometry;

public class Ragdoll {
    public active: bool;
    public rest: GpuVec4[];
    public points: GpuVec3[];
    public previous: GpuVec3[];
    public render_previous: GpuVec3[];
    links: GpuVec4[];
    bends: GpuVec4[];
    public age: float;

    public constructor(kind: int, appearance: int) {
        this.active = false;
        this.age = 0.0f;
        this.rest = rig_nodes(kind);
        this.links = rig_links(kind);
        this.points = Array.alloc<GpuVec3>(this.rest.length);
        this.previous = Array.alloc<GpuVec3>(this.rest.length);
        this.render_previous = Array.alloc<GpuVec3>(this.rest.length);
        for (let i in 0..this.rest.length) {
            let p = this.rest[i];
            if kind != 2 && appearance == 1 {
                p.x = p.x * 1.22f;
                p.y = p.y * 1.07f;
                p.z = p.z * 1.12f;
            }
            if kind != 2 && appearance == 2 {
                p.x = p.x * 0.87f;
                p.y = p.y * 0.96f;
            }
            this.rest[i] = p;
        }
        for (let i in 0..this.links.length) {
            let edge = this.links[i];
            let a = this.rest[(int)edge.x];
            let b = this.rest[(int)edge.y];
            edge.w = GpuVec3(a.x - b.x, a.y - b.y, a.z - b.z).length();
            this.links[i] = edge;
        }
        let bends = List<GpuVec4>();
        // Parent links precede cross braces in the exported rig.
        for (let i in 1..this.rest.length) {
            let parent = (int)this.links[i - 1].y;
            if parent <= 0 {
                continue;
            }
            let ancestor = (int)this.links[parent - 1].y;
            let a = this.rest[i];
            let b = this.rest[ancestor];
            let minimum = GpuVec3(a.x - b.x, a.y - b.y, a.z - b.z).length() * 0.68f;
            bends.push(GpuVec4((float)i, (float)ancestor, minimum, 0.0f));
        }
        this.bends = bends.take_array();
    }

    public fun start(origin: GpuVec3, yaw: float, impulse: GpuVec3): void {
        this.active = true;
        this.age = 0.0f;
        let s = (float)Math.sin(yaw);
        let c = (float)Math.cos(yaw);
        for (let i in 0..this.rest.length) {
            let r = this.rest[i];
            let p = GpuVec3(r.x * c + r.z * s, r.y, r.z * c - r.x * s) + origin;
            let twist = GpuVec3(
                (float)Math.sin((float)i * 2.4f) * 0.35f,
                0.0f,
                (float)Math.cos((float)i * 2.4f) * 0.35f
            );
            this.points[i] = p;
            this.previous[i] = p - (impulse + twist) / 120.0f;
            this.render_previous[i] = p;
        }
    }

    public fun tick(dt: float, boxes: WorldBox[], snow: float): void {
        if !this.active || this.age > 6.0f {
            return;
        }
        this.age = this.age + dt;
        for (let i in 0..this.points.length) {
            this.render_previous[i] = this.points[i];
        }
        for (let step in 0..2) {
            let h = dt * 0.5f;
            for (let i in 0..this.points.length) {
                let p = this.points[i];
                let velocity = (p - this.previous[i]) * 0.985f;
                this.previous[i] = p;
                this.points[i] = p + velocity + GpuVec3(0.0f, -18.0f * h * h, 0.0f);
            }
            for (let solve in 0..6) {
                for (let edge in this.links) {
                    let a = (int)edge.x;
                    let b = (int)edge.y;
                    let delta = this.points[b] - this.points[a];
                    let length = delta.length();
                    if length > 0.0001f {
                        let correction = delta * ((length - edge.w) / length * 0.5f * edge.z);
                        this.points[a] = this.points[a] + correction;
                        this.points[b] = this.points[b] - correction;
                    }
                }
                for (let bend in this.bends) {
                    let a = (int)bend.x;
                    let b = (int)bend.y;
                    let delta = this.points[b] - this.points[a];
                    let length = delta.length();
                    if length > 0.0001f && length < bend.z {
                        let correction = delta * ((length - bend.z) / length * 0.5f);
                        this.points[a] = this.points[a] + correction;
                        this.points[b] = this.points[b] - correction;
                    }
                }
                for (let i in 0..this.points.length) {
                    let p = this.points[i];
                    let radius = 0.085f;
                    if this.rest.length > 20 {
                        if i < 3 {
                            radius = 0.23f;
                        } else if i == 4 {
                            radius = 0.28f;
                        }
                    } else {
                        if i == 0 {
                            radius = 0.26f;
                        } else if i == 1 || i == 2 {
                            radius = 0.18f;
                        }
                    }
                    let floor = snow + radius;
                    if Math.abs(p.x) < 3.0f && Math.abs(p.z - 24.0f) < 3.0f {
                        floor = floor + 0.22f;
                    }
                    if p.y < floor {
                        p.y = floor;
                        let old = this.previous[i];
                        old.x = old.x + (p.x - old.x) * 0.35f;
                        old.z = old.z + (p.z - old.z) * 0.35f;
                        this.previous[i] = old;
                    }
                    for (let box in boxes) {
                        if p.x <= box.lo.x
                            - radius
                            || p.x >= box.hi.x
                            + radius
                            || p.y <= box.lo.y
                            - radius
                            || p.y >= box.hi.y
                            + radius || p.z <= box.lo.z - radius || p.z >= box.hi.z + radius {
                            continue;
                        }
                        let best = p.y - (box.lo.y - radius);
                        let axis = 1;
                        let side = -1.0f;
                        let distances = [
                            p.x - box.lo.x + radius,
                            box.hi.x + radius - p.x,
                            box.hi.y + radius - p.y,
                            p.z - box.lo.z + radius,
                            box.hi.z + radius - p.z
                        ];
                        for (let face in 0..5) {
                            if distances[face] < best {
                                best = distances[face];
                                if face < 2 {
                                    axis = 0;
                                    side = -1.0f;
                                    if face == 1 {
                                        side = 1.0f;
                                    }
                                } else if face == 2 {
                                    axis = 1;
                                    side = 1.0f;
                                } else {
                                    axis = 2;
                                    side = -1.0f;
                                    if face == 4 {
                                        side = 1.0f;
                                    }
                                }
                            }
                        }
                        if axis == 0 {
                            p.x = p.x + side * best;
                        } else if axis == 1 {
                            p.y = p.y + side * best;
                        } else {
                            p.z = p.z + side * best;
                        }
                    }
                    this.points[i] = p;
                }
            }
        }
    }
}
