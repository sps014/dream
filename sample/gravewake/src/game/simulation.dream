import system;
import system.gpu;
import level;
import level_geometry;
import particles;
import enemy;
import pickup;
import first_person;
import waves;
import explosives;
import seasons;
import sound;
import grenades;

public class Game {
    public audio: SoundEvents;
    public grenades: Grenades;
    public rounds: int;
    last_step: int;
    snow_height: float;
    public seasons: Seasons;
    public barrels: Explosives;
    public dash_cooldown: float;
    public dash_guard: float;
    public waves: Waves;
    public score: int;
    public credits: int;
    public combo: int;
    public combo_time: float;
    public charge: int;
    public damage_bonus: int;
    public mobility: int;
    public effects: Effects;
    public controller: FirstPerson;
    public boxes: WorldBox[];
    public enemies: Enemy[];
    public pickups: Pickup[];
    public position: GpuVec3;
    public previous_position: GpuVec3;
    public yaw: float;
    public pitch: float;
    public health: int;
    public bullets: int;
    public shells: int;
    public weapon: int;
    public state: int;
    public kills: int;
    public cooldown: float;
    public muzzle: float;
    public recoil: float;
    public stride: float;
    public hurt: float;
    public hit: float;
    public time: float;

    public constructor() {
        this.audio = SoundEvents();
        this.grenades = Grenades();
        this.rounds = 30;
        this.last_step = 0;
        this.snow_height = 0.22f;
        this.seasons = Seasons();
        this.barrels = Explosives();
        this.dash_cooldown = 0.0f;
        this.dash_guard = 0.0f;
        this.waves = Waves();
        this.score = 0;
        this.credits = 0;
        this.combo = 0;
        this.combo_time = 0.0f;
        this.charge = 100;
        this.damage_bonus = 0;
        this.mobility = 0;
        this.effects = Effects();
        this.controller = FirstPerson();
        this.boxes = make_level();
        this.position = GpuVec3(0.0f, 1.87f, -1.5f);
        this.previous_position = this.position;
        this.yaw = 0.0f;
        this.pitch = 0.0f;
        this.health = 100;
        this.bullets = 180;
        this.shells = 30;
        this.weapon = 0;
        this.state = 0;
        this.kills = 0;
        this.cooldown = 0.0f;
        this.muzzle = 0.0f;
        this.recoil = 0.0f;
        this.stride = 0.0f;
        this.hurt = 0.0f;
        this.hit = 0.0f;
        this.time = 0.0f;
        this.enemies = Array.alloc<Enemy>(12);
        for (let i in 0..12) {
            this.enemies[i] = Enemy(0.0f, 50.0f, 0);
            this.enemies[i].health = 0;
            this.enemies[i].animation = 3;
            this.enemies[i].animation_time = 9.0f;
        }
        this.pickups = [
            Pickup(-10.0f, 12.0f, 0),
            Pickup(10.0f, 35.0f, 1),
            Pickup(-12.0f, 38.0f, 1),
            Pickup(-30.0f, 58.0f, 2),
            Pickup(34.0f, 66.0f, 2)
        ];
    }

    public fun throw_grenade(): void {
        if this.state == 0 && this.grenades.throw_from(this.position, this.direction()) {
            this.audio.play(8, 0.4f);
        }
    }

    public fun direction(): GpuVec3 {
        let cp = (float)Math.cos(this.pitch);
        return GpuVec3(
            (float)Math.sin(this.yaw) * cp,
            (float)Math.sin(this.pitch),
            (float)Math.cos(this.yaw) * cp
        );
    }

    public fun look(dx: float, dy: float): void {
        this.yaw = this.yaw + dx * 0.0025f;
        this.yaw = this.yaw - (float)Math.floor(this.yaw / 6.283185f) * 6.283185f;
        this.pitch = (float)Math.max(-1.35f, Math.min(1.35f, this.pitch - dy * 0.0025f));
    }

    public fun move(dx: float, dz: float): void {
        if position_clear(this.boxes, this.position.x + dx, this.position.z, 0.28f) {
            this.position.x = this.position.x + dx;
        } else {
            this.controller.velocity.x = 0.0f;
        }
        if position_clear(this.boxes, this.position.x, this.position.z + dz, 0.28f) {
            this.position.z = this.position.z + dz;
        } else {
            this.controller.velocity.z = 0.0f;
        }
    }

    public fun fire(): void {
        if this.state != 0 || this.cooldown > 0.0f || this.controller.reload_remaining > 0.0f {
            return;
        }
        if this.weapon == 0 {
            if this.bullets <= 0 {
                return;
            }
            if this.controller.rifle_loaded <= 0 {
                this.controller.start_reload(0, this.bullets);
                return;
            }
            this.controller.rifle_loaded = this.controller.rifle_loaded - 1;
            this.bullets = this.bullets - 1;
            this.cooldown = 0.14f;
        } else if this.weapon == 2 {
            if this.rounds <= 0 {
                return;
            }
            if this.controller.sniper_loaded <= 0 {
                this.controller.start_reload(2, this.rounds);
                return;
            }
            this.controller.sniper_loaded = this.controller.sniper_loaded - 1;
            this.rounds = this.rounds - 1;
            this.cooldown = 1.15f;
        } else {
            if this.shells <= 0 {
                return;
            }
            if this.controller.shotgun_loaded <= 0 {
                this.controller.start_reload(1, this.shells);
                return;
            }
            this.controller.shotgun_loaded = this.controller.shotgun_loaded - 1;
            this.shells = this.shells - 1;
            this.cooldown = 0.8f;
        }
        this.audio.play(this.weapon);
        this.muzzle = 0.075f;
        let eject_right = GpuVec3((float)Math.cos(this.yaw), 0.0f, -(float)Math.sin(this.yaw));
        this.effects.eject(
            this.position
                + eject_right * 0.3f + this.direction() * 0.65f + GpuVec3(0.0f, -0.18f, 0.0f),
            eject_right
        );
        this.recoil = 0.16f;
        if this.weapon == 1 {
            this.recoil = 0.34f;
        }
        let pellets = 1;
        if this.weapon == 1 {
            pellets = 7;
        }
        for (let pellet in 0..pellets) {
            let ray = this.direction();
            if pellets > 1 {
                let offset = (float)(pellet - 3) * 0.022f;
                let yaw = this.yaw + offset;
                let pitch = this.pitch + (float)((pellet % 3) - 1) * 0.018f;
                let cp = (float)Math.cos(pitch);
                ray = GpuVec3(
                    (float)Math.sin(yaw) * cp,
                    (float)Math.sin(pitch),
                    (float)Math.cos(yaw) * cp
                );
            }
            let wall = wall_distance(this.boxes, this.position, ray);
            let nearest = wall;
            if this.weapon == 1 {
                nearest = (float)Math.min(nearest, 13.0f);
            }
            let target = -1;
            for (let i in 0..this.enemies.length) {
                let enemy = this.enemies[i];
                if enemy.health > 0 {
                    for (let body in 0..3) {
                        let height = 0.5f + (float)body * 0.525f;
                        let center = GpuVec3(enemy.position.x, height, enemy.position.z);
                        if this.seasons.current == 3 {
                            center.y = center.y + 0.22f;
                        }
                        let radius = 0.45f;
                        if enemy.kind == 2 {
                            center.y = 0.40f + (float)body * 0.20f;
                            if this.seasons.current == 3 {
                                center.y = center.y + 0.22f;
                            }
                            let offset = ((float)body - 1.0f) * 0.45f;
                            center.x = center.x + (float)Math.sin(enemy.yaw) * offset;
                            center.z = center.z + (float)Math.cos(enemy.yaw) * offset;
                            radius = 0.32f;
                        }
                        let delta = this.position - center;
                        let b = delta.dot(ray);
                        let c = delta.dot(delta) - radius * radius;
                        let disc = b * b - c;
                        if disc >= 0.0f {
                            let distance = -b - (float)Math.sqrt(disc);
                            if distance > 0.0f && distance < nearest {
                                nearest = distance;
                                target = i;
                            }
                        }
                    }
                }
            }
            let hazard = this.barrels.ray_target(this.position, ray, nearest);
            if hazard.x >= 0.0f {
                nearest = hazard.y;
                let blast = this.barrels.detonate(
                    (int)hazard.x,
                    this.enemies,
                    this.boxes,
                    this.effects,
                    this.position
                );
                this.audio.play(3);
                for (let kill in 0..(int)blast.x) {
                    this.reward_kill();
                }
                this.health = this.health - (int)blast.y;
                if blast.y > 0.0f {
                    this.hurt = 0.35f;
                }
                this.hit = 0.25f;
            } else if target >= 0 {
                let enemy = this.enemies[target];
                let damage = 30;
                if this.weapon == 2 {
                    damage = 160;
                }
                if this.weapon == 0 && (this.position + ray * nearest).y > 1.55f {
                    damage = 60;
                }
                this.audio.play(4, 0.35f);
                enemy.impulse = ray * (3.0f + (float)this.weapon * 2.0f) + GpuVec3(
                    0.0f,
                    1.5f,
                    0.0f
                );
                enemy.health = enemy.health - damage - this.damage_bonus * 6;
                enemy.flash = 0.07f;
                if enemy.health > 0 && enemy.animation != 4 {
                    enemy.play(4);
                }
                this.effects.impact(
                    this.position + ray * (float)Math.max(0.1f, nearest - 0.16f),
                    -ray,
                    true
                );
                let push = ray * 0.12f;
                if position_clear(
                    this.boxes,
                    enemy.position.x + push.x,
                    enemy.position.z + push.z,
                    0.5f
                ) {
                    enemy.position.x = enemy.position.x + push.x;
                    enemy.position.z = enemy.position.z + push.z;
                }
                this.hit = 0.15f;
                if enemy.health <= 0 {
                    this.reward_kill();
                    enemy.play(3);
                }
            } else {
                if nearest < 119.0f && nearest >= wall - 0.01f {
                    let contact = this.position + ray * nearest;
                    let normal = wall_normal(this.boxes, contact, -ray);
                    this.effects.impact(contact + normal * 0.06f, normal, false);
                }
            }
            if this.seasons.current != 3 && ray.y < -0.001f {
                let water = (0.045f - this.position.y) / ray.y;
                let contact = this.position + ray * water;
                if water > 0.0f
                    && water < nearest
                    && Math.abs(contact.z - 24.0f) < 2.4f && Math.abs(contact.x) > 3.0f {
                    nearest = water;
                    this.effects.splash(contact);
                    this.audio.play(9, 0.4f);
                }
            }
            let right = GpuVec3((float)Math.cos(this.yaw), 0.0f, -(float)Math.sin(this.yaw));
            this.effects.trail(
                this.position
                    + right
                    * (0.28f * (1.0f - this.controller.aim))
                    + GpuVec3(0.0f, -0.25f * (1.0f - this.controller.aim), 0.0f) + ray * 1.4f,
                this.position + ray * nearest
            );
        }
    }

    public fun reward_kill(): void {
        this.kills = this.kills + 1;
        this.combo = (int)Math.min(8, this.combo + 1);
        this.combo_time = 3.5f;
        this.score = this.score + 100 * this.combo;
        this.credits = this.credits + 50;
        this.charge = (int)Math.min(100, this.charge + 15);
    }

    public fun shockwave(): void {
        if this.state != 0 || this.charge < 100 {
            return;
        }
        this.charge = 0;
        this.audio.play(3, 0.65f);
        this.effects.shock(this.position);
        for (let enemy in this.enemies) {
            let delta = enemy.position - this.position;
            let distance = delta.length();
            if enemy.health <= 0 || distance > 7.5f {
                continue;
            }
            if wall_distance(this.boxes, this.position, delta / (float)Math.max(0.001f, distance)) < distance {
                continue;
            }
            enemy.health = enemy.health - 100 - this.damage_bonus * 10;
            enemy.impulse = delta
                / (float)Math.max(0.1f, distance) * 5.0f + GpuVec3(0.0f, 2.0f, 0.0f);
            if enemy.health > 0 {
                enemy.play(4);
            }
            enemy.stagger = 0.7f;
            enemy.attack_pending = false;
            enemy.flash = 0.07f;
            this.effects.impact(enemy.position, -delta / (float)Math.max(0.001f, distance), false);
            if enemy.health <= 0 {
                enemy.play(3);
                this.reward_kill();
            }
        }
    }

    public fun dash(): void {
        if this.state != 0 || this.dash_cooldown > 0.0f {
            return;
        }
        let direction = this.controller.velocity;
        direction.y = 0.0f;
        if direction.length() < 0.1f {
            direction = GpuVec3((float)Math.sin(this.yaw), 0.0f, (float)Math.cos(this.yaw));
        }
        direction = direction.normalize();
        for (let i in 0..16) {
            this.move(direction.x * 0.24f, direction.z * 0.24f);
        }
        this.previous_position = this.position;
        this.dash_cooldown = 3.5f;
        this.dash_guard = 0.22f;
        this.effects.shock(this.position);
    }

    public fun upgrade(choice: int): void {
        if this.waves.intermission <= 0.0f || this.waves.upgrade_taken {
            return;
        }
        this.waves.upgrade_taken = true;
        if choice == 0 {
            this.damage_bonus = this.damage_bonus + 1;
        } else {
            this.mobility = (int)Math.min(5, this.mobility + 1);
        }
    }

    public fun interact(): void {
        let near = false;
        for (let supply in supply_positions()) {
            if (this.position - supply).length() < 3.0f {
                near = true;
            }
        }
        if this.state == 0 && near && this.credits >= 150 {
            this.credits = this.credits - 150;
            this.health = (int)Math.min(100, this.health + 35);
            this.bullets = this.bullets + 72;
            this.shells = this.shells + 12;
            this.rounds = this.rounds + 10;
            this.grenades.remaining = (int)Math.min(6, this.grenades.remaining + 2);
        }
    }

    public fun tick(dt: float, forward: float, strafe: float, sprint: bool, firing: bool): void {
        if this.state != 0 {
            return;
        }
        this.previous_position = this.position;
        this.time = this.time + dt;
        this.seasons.time = this.time;
        this.dash_cooldown = (float)Math.max(0.0f, this.dash_cooldown - dt);
        this.dash_guard = (float)Math.max(0.0f, this.dash_guard - dt);
        this.effects.tick(dt);
        this.combo_time = (float)Math.max(0.0f, this.combo_time - dt);
        if this.combo_time == 0.0f {
            this.combo = 0;
        }
        this.waves.tick(dt, this.enemies, this.boxes, this.position);
        if this.waves.cleared {
            this.barrels.reset();
            this.health = (int)Math.min(100, this.health + 20);
            this.bullets = this.bullets + 72;
            this.shells = this.shells + 12;
            this.rounds = this.rounds + 10;
            this.grenades.remaining = (int)Math.min(6, this.grenades.remaining + 2);
            this.charge = 100;
            for (let pickup in this.pickups) {
                pickup.taken = false;
            }
        }
        this.recoil = this.recoil * (float)Math.exp(-dt * 18.0f);
        this.cooldown = (float)Math.max(0.0f, this.cooldown - dt);
        this.muzzle = (float)Math.max(0.0f, this.muzzle - dt);
        this.hurt = (float)Math.max(0.0f, this.hurt - dt);
        this.hit = (float)Math.max(0.0f, this.hit - dt);
        let movement = this.controller.advance(
            dt,
            forward,
            strafe,
            sprint,
            this.yaw,
            this.bullets,
            this.shells,
            this.rounds
        );
        let powder = 1.0f;
        if this.seasons.current == 3 {
            powder = 0.72f
                + (0.24f - this.seasons.depth_at(this.position.x, this.position.z)) * 1.0f;
        }
        this.move(
            movement.x * powder * (1.0f + (float)this.mobility * 0.08f),
            movement.z * powder * (1.0f + (float)this.mobility * 0.08f)
        );
        this.position.y = this.controller.eye_height + this.controller.jump_height;
        if this.seasons.current == 3 {
            this.snow_height = this.snow_height
                + (this.seasons.depth_at(this.position.x, this.position.z) - this.snow_height)
                * (float)Math.min(1.0f, dt * 12.0f);
            this.position.y = this.position.y + this.snow_height;
        }
        this.stride = this.controller.step_phase;
        let step = (int)(this.stride / 3.141593f);
        if step != this.last_step && this.controller.jump_height <= 0.0f {
            this.audio.play(5, 0.35f);
            this.last_step = step;
        }
        let snow = 0.0f;
        if this.seasons.current == 3 {
            snow = 0.22f;
        }
        let blast = this.grenades.tick(
            dt,
            this.boxes,
            this.enemies,
            this.effects,
            this.position,
            snow
        );
        for (let kill in 0..(int)blast.x) {
            this.reward_kill();
        }
        this.health = this.health - (int)blast.y;
        if blast.y > 0.0f {
            this.hurt = 0.35f;
        }
        if this.grenades.detonated {
            this.audio.play(3);
        }

        if firing {
            this.fire();
        }
        for (let pickup in this.pickups) {
            let delta = this.position - pickup.position;
            delta.y = 0.0f;
            if !pickup.taken && delta.dot(delta) < 1.1f {
                if pickup.kind == 2 {
                    this.credits = this.credits + 125;
                    this.charge = (int)Math.min(100, this.charge + 35);
                    this.effects.shock(pickup.position);
                    pickup.taken = true;
                } else if pickup.kind == 1 {
                    this.bullets = this.bullets + 60;
                    this.shells = this.shells + 8;
                    pickup.taken = true;
                } else if this.health < 100 {
                    this.health = (int)Math.min(100, this.health + 40);
                    pickup.taken = true;
                }
            }
        }
        for (let enemy in this.enemies) {
            enemy.position.y = 1.0f;
            if enemy.kind == 2 {
                enemy.position.y = 0.55f;
            }
            if this.seasons.current == 3 {
                enemy.position.y = enemy.position.y
                    + this.seasons.depth_at(enemy.position.x, enemy.position.z);
            }
            enemy.previous_position = enemy.position;
            enemy.animation_time = enemy.animation_time + dt;
            enemy.blend_age = enemy.blend_age + dt;
            enemy.stagger = (float)Math.max(0.0f, enemy.stagger - dt);
            enemy.flash = (float)Math.max(0.0f, enemy.flash - dt);
            if enemy.health <= 0 && enemy.body.active {
                let snow = 0.0f;
                if this.seasons.current == 3 {
                    snow = this.seasons.depth_at(enemy.body.points[0].x, enemy.body.points[0].z);
                }
                enemy.body.tick(dt, this.boxes, snow);
            }
            if enemy.health > 0 {
                enemy.cooldown = (float)Math.max(0.0f, enemy.cooldown - dt);
                if enemy.attack_pending && enemy.animation != 2 {
                    enemy.attack_pending = false;
                }
                if enemy.attack_pending && enemy.animation_time >= 0.36f {
                    enemy.attack_pending = false;
                    let delta = this.position - enemy.position;
                    let distance = delta.length();
                    let ray = delta / (float)Math.max(distance, 0.001f);
                    let range = 2.2f;
                    if enemy.kind == 1 {
                        range = 2.2f;
                    }
                    if this.dash_guard <= 0.0f
                        && distance < range
                        && wall_distance(this.boxes, enemy.position, ray) > distance {
                        this.audio.play(7, 0.6f);
                        this.health = this.health - 9;
                        this.hurt = 0.35f;
                    }
                }
                if (enemy.animation == 4 && enemy.animation_time < 0.35f)
                    || (enemy.animation == 2 && enemy.animation_time < 0.8f) {
                    continue;
                }
                if enemy.animation == 2 || enemy.animation == 4 {
                    enemy.play(0);
                }
                if enemy.stagger > 0.0f {
                    continue;
                }
                let delta = this.position - enemy.position;
                let distance = delta.length();
                let ray = delta / (float)Math.max(distance, 0.001f);
                let facing = (float)Math.atan2(delta.x, delta.z) - enemy.yaw;
                facing = facing - (float)Math.floor((facing + 3.141593f) / 6.283185f) * 6.283185f;
                enemy.yaw = enemy.yaw + facing * (float)Math.min(1.0f, dt * 9.0f);
                let visible = wall_distance(this.boxes, enemy.position, ray) > distance;
                if distance < 85.0f {
                    let range = 1.7f;
                    if enemy.kind == 1 {
                        range = 1.7f;
                    }
                    if distance > range {
                        if enemy.animation != 1 {
                            enemy.play(1);
                        }
                        let speed = 1.65f;
                        if enemy.kind == 1 {
                            speed = 2.35f;
                        }
                        if enemy.kind == 2 {
                            speed = 3.65f;
                        }
                        speed = speed * (
                            1.0f + (float)Math.min(10, this.waves.number - 1) * 0.035f
                        );
                        let step = delta * (dt * speed / distance);
                        for (let other in this.enemies) {
                            if other.health <= 0 {
                                continue;
                            }
                            let separation = enemy.position - other.position;
                            separation.y = 0.0f;
                            let spacing = separation.length();
                            if spacing > 0.001f && spacing < 0.85f {
                                step = step + separation / spacing * (0.85f - spacing) * dt * 3.0f;
                            }
                        }
                        if !position_clear(
                            this.boxes,
                            enemy.position.x + step.x * 8.0f,
                            enemy.position.z + step.z * 8.0f,
                            0.5f
                        ) {
                            let side = 1.0f;
                            if enemy.kind == 1 {
                                side = -1.0f;
                            }
                            step = GpuVec3(-ray.z * side, 0.0f, ray.x * side) * dt * speed;
                        }
                        if position_clear(
                            this.boxes,
                            enemy.position.x + step.x,
                            enemy.position.z,
                            0.5f
                        ) {
                            enemy.position.x = enemy.position.x + step.x;
                        }
                        if position_clear(
                            this.boxes,
                            enemy.position.x,
                            enemy.position.z + step.z,
                            0.5f
                        ) {
                            enemy.position.z = enemy.position.z + step.z;
                        }
                    } else if visible && enemy.cooldown <= 0.0f {
                        enemy.play(2);
                        this.audio.play(6, 0.25f, (float)Math.sin(enemy.yaw - this.yaw) * 0.5f);
                        enemy.attack_pending = true;
                        enemy.cooldown = 1.4f;
                        if enemy.kind == 2 {
                            enemy.cooldown = 1.0f;
                        }
                    } else if enemy.animation == 1 {
                        enemy.play(0);
                    }
                } else if enemy.animation == 1 {
                    enemy.play(0);
                }
            }
        }
        if this.controller.jump_height < 0.02f {
            this.seasons.record(0, this.position, this.yaw, false, this.time);
        }
        for (let i in 0..this.enemies.length) {
            let enemy = this.enemies[i];
            if enemy.health <= 0 && enemy.body.active && enemy.body.age < 6.0f {
                this.seasons.record(i + 1, enemy.body.points[0], enemy.yaw, false, this.time, true);
            }
            if enemy.health > 0 {
                this.seasons.record(i + 1, enemy.position, enemy.yaw, enemy.kind == 2, this.time);
            }
        }
        if this.health <= 0 {
            this.health = 0;
            this.state = 1;
        }
    }
}
