import system;
import animation;
import system.gpu;
import enemy;
import level;
import level_geometry;

public class Waves {
    public number: int;
    public unspawned: int;
    public intermission: float;
    public spawn_timer: float;
    public upgrade_taken: bool;
    public cleared: bool;
    serial: int;

    public constructor() {
        this.number = 1;
        this.unspawned = 6;
        this.intermission = 0.0f;
        this.spawn_timer = 0.2f;
        this.upgrade_taken = false;
        this.cleared = false;
        this.serial = 0;
    }

    public fun alive(enemies: Enemy[]): int {
        let count = 0;
        for (let enemy in enemies) {
            if enemy.health > 0 {
                count = count + 1;
            }
        }
        return count;
    }

    public fun tick(dt: float, enemies: Enemy[], boxes: WorldBox[], player: GpuVec3): void {
        this.cleared = false;
        if this.intermission > 0.0f {
            this.intermission = (float)Math.max(0.0f, this.intermission - dt);
            if this.intermission == 0.0f {
                this.number = this.number + 1;
                this.unspawned = (int)Math.min(48, 3 + this.number * 3);
                this.upgrade_taken = false;
            }
            return;
        }
        if this.unspawned == 0 && this.alive(enemies) == 0 {
            this.intermission = 9.0f;
            this.cleared = true;
            return;
        }
        this.spawn_timer = this.spawn_timer - dt;
        if this.unspawned <= 0 || this.spawn_timer > 0.0f {
            return;
        }
        for (let slot in 0..enemies.length) {
            if enemies[slot].health > 0 || enemies[slot].animation_time < corpse_lifetime() {
                continue;
            }
            for (let attempt in 0..16) {
                let angle = (float)(this.serial + attempt) * 2.399963f;
                let radius = 14.0f + (float)(this.number % 3) * 1.5f;
                let bounds = world_bounds();
                let x = (float)Math.max(
                    bounds.x + 1.0f,
                    Math.min(bounds.y - 1.0f, player.x + (float)Math.sin(angle) * radius)
                );
                let z = (float)Math.max(
                    bounds.z + 1.0f,
                    Math.min(bounds.w - 1.0f, player.z + (float)Math.cos(angle) * radius)
                );
                let delta = GpuVec3(x, player.y, z) - player;
                if delta.length() < 11.0f || !position_clear(boxes, x, z, 0.6f) {
                    continue;
                }
                let kind = 0;
                if this.number >= 2 && this.serial % 3 == 0 {
                    kind = 1;
                }
                if this.serial % 4 == 2 {
                    kind = 2;
                }
                let enemy = Enemy(x, z, kind);
                enemy.health = enemy.health + (this.number - 1) * 12;
                enemy.cooldown = 1.2f;
                enemies[slot] = enemy;
                this.serial = this.serial + attempt + 1;
                this.unspawned = this.unspawned - 1;
                this.spawn_timer = (float)Math.max(0.18f, 0.7f - (float)this.number * 0.035f);
                return;
            }
        }
    }
}
