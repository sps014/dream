import system;
import system.io;
import system.gpu;
import catalog;

public class SceneAssets {
    public vertices: GpuBuffer<GpuVec4>;
    public acceleration: GpuBuffer<GpuVec4>;
    public hardware_scene: Option<GpuAccelerationStructure>;
    public ray_triangles: GpuBuffer<int>;

    constructor(
        vertices: GpuBuffer<GpuVec4>,
        acceleration: GpuBuffer<GpuVec4>,
        ray_triangles: GpuBuffer<int>
    ) {
        this.vertices = vertices;
        this.acceleration = acceleration;
        this.ray_triangles = ray_triangles;
        this.hardware_scene = Option.None;
    }

    public static async fun load(device: GpuDevice): Result<SceneAssets, GpuError> {
        let root = "assets/packed";
        switch (System.exe_path) {
            Some(path) => {
                root = Path.join(Path.parent(path).unwrap_or("."), root);
            }
            None => {}
        }
        let vertex_data = decode_asset<GpuVec4>(read_asset(root, "vertices.bin").await?, 16);
        let acceleration_data = decode_asset<GpuVec4>(
            read_asset(root, "acceleration.bin").await?,
            16
        );
        return Result.Ok(
            SceneAssets(
                device.buffer_from(vertex_data)?,
                device.buffer_from(acceleration_data)?,
                device.buffer_from([0])?
            )
        );
    }

    public async fun enable_ray_tracing(device: GpuDevice): Result<bool, GpuError> {
        let assets = this;
        let root = "assets/packed";
        switch (System.exe_path) {
            Some(path) => {
                root = Path.join(Path.parent(path).unwrap_or("."), root);
            }
            None => {}
        }
        let vertex_data = decode_asset<GpuVec4>(read_asset(root, "vertices.bin").await?, 16);
        let acceleration_data = decode_asset<GpuVec4>(
            read_asset(root, "acceleration.bin").await?,
            16
        );
        if device.supports(GpuFeature.RayQuery) {
            let base = (int)scene_layout().y + 3;
            let model = acceleration_data[base];
            let metadata = acceleration_data[base + 1];
            let positions = Array.alloc<GpuVec3>((int)model.y);
            for (let i in 0..positions.length) {
                let p = vertex_data[((int)model.x + i) * 2];
                positions[i] = GpuVec3(p.x, p.y, p.z);
            }
            let indices = List<uint>();
            let ray_triangles = List<int>();
            for (let i in 0..(int)metadata.y) {
                let triangle = acceleration_data[(int)metadata.x + i];
                if (int)triangle.w == 31 || (int)triangle.w >= 68 {
                    continue;
                }
                indices.push((uint)triangle.x);
                indices.push((uint)triangle.y);
                indices.push((uint)triangle.z);
                ray_triangles.push(i);
            }

            assets.ray_triangles = device.buffer_from(ray_triangles.take_array())?;
            let position_buffer = device.buffer_from(positions)?;
            let index_buffer = device.buffer_from(indices.take_array())?;
            let geometry = GpuGeometry.triangles(position_buffer).indexed(index_buffer);
            let bottom = device.build_bottom_level(geometry).await?;
            let top = device.build_top_level([GpuInstance(bottom, GpuMat4.identity())]).await?;
            assets.hardware_scene = Option.Some(top);
        }
        return Result.Ok(true);
    }
}

async fun read_asset(root: string, name: string): Result<byte[], GpuError> {
    switch (File.read_bytes(Path.join(root, name)).await) {
        Ok(bytes) => {
            return Result.Ok(bytes);
        }
        Err(error) => {
            return Result.Err(GpuError.InvalidResource("Asset " + name + ": " + error.message()));
        }
    }
}

fun decode_asset<T: unmanaged>(bytes: byte[], stride: int): T[] {
    let count = bytes.length / stride;
    let values = Array.alloc<T>(count);
    let element = Array.alloc<byte>(stride);
    for (let i in 0..count) {
        for (let j in 0..stride) {
            element[j] = bytes[i * stride + j];
        }
        values[i] = Bytes.to<T>(element);
    }
    return values;
}
