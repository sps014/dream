import system.gpu;
import screen;
import brdf;

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun material_fragment(pixel: ScreenPixel, aspect: float): GpuVec4 {
    let ray = GpuVec3(pixel.uv.x * aspect, pixel.uv.y, 2.0f).normalize();
    let origin = GpuVec3(0.0f, 0.0f, -5.5f);
    let nearest = 100.0f;
    let color = GpuVec3(0.018f, 0.025f, 0.035f);
    for (let row in 0..3) {
        for (let column in 0..5) {
            let center = GpuVec3(((float)column - 2.0f) * 1.05f, ((float)row - 1.0f) * 1.1f, 0.0f);
            let delta = origin - center;
            let b = delta.dot(ray);
            let discriminant = b * b - delta.dot(delta) + 0.45f * 0.45f;
            if discriminant > 0.0f {
                let t = -b - GpuMath.sqrt(discriminant);
                if t > 0.0f && t < nearest {
                    nearest = t;
                    let normal = (origin + ray * t - center).normalize();
                    let base = GpuVec3(0.38f, 0.12f, 0.045f);
                    let metallic = 0.0f;
                    if row == 1 {
                        base = GpuVec3(0.55f, 0.58f, 0.64f);
                        metallic = 1.0f;
                    }
                    if row == 2 {
                        base = GpuVec3(0.035f, 0.09f, 0.15f);
                        metallic = 0.0f;
                    }
                    let roughness = 0.1f + (float)column * 0.2f;
                    color = base * 0.12f;
                    color = color
                        + surface_brdf(
                            base,
                            roughness,
                            metallic,
                            normal,
                            -ray,
                            GpuVec3(-0.5f, 0.8f, -0.8f).normalize()
                        ) * GpuVec3(8.0f, 7.2f, 6.0f);
                    color = color
                        + surface_brdf(
                            base,
                            roughness,
                            metallic,
                            normal,
                            -ray,
                            GpuVec3(0.8f, -0.2f, -0.5f).normalize()
                        ) * GpuVec3(1.5f, 2.5f, 4.0f);
                }
            }
        }
    }
    return GpuVec4(color.x, color.y, color.z, 1.0f);
}
