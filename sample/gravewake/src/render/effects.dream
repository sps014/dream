module render.effects;

import system.gpu;
import brdf;

public struct EffectPixel {
    @builtin("position")
    public position: GpuVec4;

    @location(0)
    public uv: GpuVec2;

    @location(1)
    public item: float;
}

fun effect_project(point: GpuVec3, camera: GpuVec4, look: GpuVec4, aspect: float): GpuVec3 {
    let forward = GpuVec3(
        GpuMath.sin(look.x) * GpuMath.cos(look.y),
        GpuMath.sin(look.y),
        GpuMath.cos(look.x) * GpuMath.cos(look.y)
    );
    let right = GpuVec3(GpuMath.cos(look.x), 0.0f, -GpuMath.sin(look.x));
    let up = -right.cross(forward);
    let delta = point - GpuVec3(camera.x, camera.y, camera.z);
    let z = delta.dot(forward);
    return GpuVec3(
        delta.dot(right) * look.z / (GpuMath.max(0.1f, z) * aspect),
        delta.dot(up) * look.z / GpuMath.max(0.1f, z),
        z
    );
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@vertex
public fun effect_vertex(
    @readonly particles: GpuBuffer<GpuVec4>,
    camera: GpuVec4,
    look: GpuVec4,
    aspect: float
): EffectPixel {
    let i = instance_id();
    let pixel = EffectPixel();
    pixel.position = GpuVec4(2.0f, 2.0f, 0.0f, 1.0f);
    pixel.uv = GpuVec2(2.0f);
    pixel.item = (float)i;
    if i >= (int)particles[330].x {
        return pixel;
    }
    let item = particles[i * 3];
    let info = particles[i * 3 + 1];
    let motion = particles[i * 3 + 2];
    let center = effect_project(GpuVec3(item.x, item.y, item.z), camera, look, aspect);
    let end = center;
    if motion.w == 8.0f || motion.w == 10.0f || motion.w == 12.0f {
        let corner = GpuVec2(-1.0f, -1.0f);
        let vertex = vertex_id();
        if vertex == 1 || vertex == 4 || vertex == 5 {
            corner.x = 1.0f;
        }
        if vertex == 2 || vertex == 3 || vertex == 5 {
            corner.y = 1.0f;
        }
        pixel.position = GpuVec4(corner.x, corner.y, 0.0f, 1.0f);
        pixel.uv = corner;
        return pixel;
    }
    if motion.w == 3.0f {
        end = effect_project(GpuVec3(motion.x, motion.y, motion.z), camera, look, aspect);
    }
    if center.z < 0.1f || end.z < 0.1f {
        return pixel;
    }
    let radius = info.w * 1.6f / GpuMath.max(0.1f, GpuMath.min(center.z, end.z) - info.w);
    let lo = GpuVec2(
        GpuMath.min(center.x, end.x) - radius / aspect,
        GpuMath.min(center.y, end.y) - radius
    );
    let hi = GpuVec2(
        GpuMath.max(center.x, end.x) + radius / aspect,
        GpuMath.max(center.y, end.y) + radius
    );
    let corner = GpuVec2(lo.x, lo.y);
    let v = vertex_id();
    if v == 1 || v == 4 || v == 5 {
        corner.x = hi.x;
    }
    if v == 2 || v == 3 || v == 5 {
        corner.y = hi.y;
    }
    pixel.position = GpuVec4(corner.x, corner.y, 0.0f, 1.0f);
    pixel.uv = corner;
    return pixel;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
public fun effect_fragment(
    pixel: EffectPixel,
    @readonly particles: GpuBuffer<GpuVec4>,
    scene: GpuTexture,
    filtering: GpuSampler,
    camera: GpuVec4,
    look: GpuVec4,
    aspect: float,
    target_srgb: int
): GpuVec4 {
    let uv = GpuVec2(pixel.uv.x * 0.5f + 0.5f, 0.5f - pixel.uv.y * 0.5f);
    let depth = GpuMath.exp2(scene.sample_level(filtering, uv, 0.0f).w * 7.0f) - 1.0f;
    let forward = GpuVec3(
        GpuMath.sin(look.x) * GpuMath.cos(look.y),
        GpuMath.sin(look.y),
        GpuMath.cos(look.x) * GpuMath.cos(look.y)
    );
    let right = GpuVec3(GpuMath.cos(look.x), 0.0f, -GpuMath.sin(look.x));
    let up = -right.cross(forward);
    let ray = (forward * look.z + right * pixel.uv.x * aspect + up * pixel.uv.y).normalize();
    let origin = GpuVec3(camera.x, camera.y, camera.z);
    let i = (int)pixel.item;
    let item = particles[i * 3];
    let info = particles[i * 3 + 1];
    let motion = particles[i * 3 + 2];
    let delta = GpuVec3(item.x, item.y, item.z) - origin;
    let t = delta.dot(ray);
    let radius = info.w;
    if motion.w == 9.0f {
        radius = radius * (1.0f - item.w / 0.45f * 0.7f);
    }
    let closest = (delta - ray * t).length();
    let opacity = GpuMath.min(1.0f, item.w * 8.0f);
    if motion.w == 8.0f || motion.w == 10.0f || motion.w == 12.0f {
        if GpuMath.abs(ray.y) < 0.001f {
            return GpuVec4(0.0f);
        }
        t = delta.y / ray.y;
        let ring = (0.6f - item.w) * 12.5f;
        closest = GpuMath.abs((ray * t - delta).length() - ring);
        radius = 0.15f;
        if motion.w == 12.0f {
            ring = (1.3f - item.w) * 1.8f;
            closest = GpuMath.abs((ray * t - delta).length() - ring);
            radius = 0.045f;
            opacity = opacity * GpuMath.clamp(item.w, 0.0f, 1.0f);
        }
    } else if motion.w == 3.0f {
        let segment = GpuVec3(motion.x, motion.y, motion.z) - GpuVec3(item.x, item.y, item.z);
        let length2 = segment.dot(segment);
        let along = ray.dot(segment);
        let denominator = GpuMath.max(0.00001f, length2 - along * along);
        let fraction = GpuMath.clamp(
            (along * ray.dot(delta) - segment.dot(delta)) / denominator,
            0.0f,
            1.0f
        );
        let point = delta + segment * fraction;
        t = point.dot(ray);
        closest = (point - ray * t).length();
        opacity = GpuMath.min(1.0f, item.w * 25.0f);
    } else if motion.w == 4.0f {
        let normal = GpuVec3(motion.x, motion.y, motion.z);
        let denominator = ray.dot(normal);
        if GpuMath.abs(denominator) < 0.001f {
            return GpuVec4(0.0f);
        }
        t = delta.dot(normal) / denominator;
        closest = (ray * t - delta).length();
    }
    if t > 0.0f && t < depth + GpuMath.max(0.06f, depth * 0.015f) && closest < radius {
        if motion.w > 10.5f && motion.w < 11.5f {
            let surface = GpuMath.sqrt(GpuMath.max(0.0f, radius * radius - closest * closest));
            let normal = (ray * (t - surface) - delta).normalize();
            let color = GpuVec3(info.x, info.y, info.z)
                * (
                    0.35f + GpuMath.max(
                        0.0f,
                        normal.dot(GpuVec3(-0.45f, 0.85f, -0.3f).normalize())
                    )
                );
            if GpuMath.abs(normal.y) < 0.13f {
                color = color * 0.3f;
            }
            color = filmic_map(color);
            if target_srgb == 0 {
                color = encode_display(color);
            }
            return GpuVec4(color.x, color.y, color.z, 1.0f);
        }
        let coverage = GpuMath.max(0.0f, 1.0f - closest / radius) * opacity;
        let tint = GpuVec3(info.x, info.y, info.z);
        let rgb = filmic_map(tint);
        if target_srgb == 0 {
            rgb = encode_display(rgb);
        }
        return GpuVec4(rgb.x, rgb.y, rgb.z, coverage);
    }
    return GpuVec4(0.0f);
}
