import system.gpu;
import mesh;

public fun static_occluded(
    scene: GpuAccelerationStructure,
    origin: GpuVec3,
    ray: GpuVec3,
    limit: float
): bool {
    let query = GpuRayQuery(GpuRayFlags.AcceptFirstHitAndEndSearch);
    query.trace(scene, 255u, GpuRay(origin, ray, 0.001f, limit));
    while query.proceed() {
        query.commit_triangle();
    }
    return query.has_hit();
}

public fun static_hit(
    scene: GpuAccelerationStructure,
    origin: GpuVec3,
    ray: GpuVec3,
    limit: float,
    @readonly vertices: GpuBuffer<GpuVec4>,
    @readonly acceleration: GpuBuffer<GpuVec4>,
    @readonly ray_triangles: GpuBuffer<int>,
    layout: GpuVec4
): MeshHit {
    let hit = MeshHit();
    hit.distance = limit;
    let query = GpuRayQuery(GpuRayFlags.ForceOpaque);
    query.trace(scene, 255u, GpuRay(origin, ray, 0.001f, limit));
    while query.proceed() {
        query.commit_triangle();
    }
    if query.has_hit() {
        let metadata = acceleration[(int)layout.y + 4];
        let model = scene_model(acceleration, layout, 1);
        let tri = scene_triangle(
            acceleration,
            (int)metadata.x + ray_triangles[query.hit_primitive_index()]
        );
        let a = vertices[((int)model.x + tri.x) * 2];
        let b = vertices[((int)model.x + tri.y) * 2];
        let c = vertices[((int)model.x + tri.z) * 2];
        let an = vertices[((int)model.x + tri.x) * 2 + 1];
        let bn = vertices[((int)model.x + tri.y) * 2 + 1];
        let cn = vertices[((int)model.x + tri.z) * 2 + 1];
        let bary = query.hit_barycentrics();
        let uv = a * (1.0f - bary.x - bary.y) + b * bary.x + c * bary.y;
        let normal = an * (1.0f - bary.x - bary.y) + bn * bary.x + cn * bary.y;
        hit.distance = query.hit_distance();
        hit.normal = GpuVec3(normal.x, normal.y, normal.z).normalize();
        if hit.normal.dot(ray) > 0.0f {
            hit.normal = -hit.normal;
        }
        hit.tangent = GpuVec3(b.x - a.x, b.y - a.y, b.z - a.z).normalize();
        hit.handedness = 1.0f;
        hit.uv = GpuVec2(uv.w, normal.w);
        hit.material = tri.w;
    }
    return hit;
}
