import system;
import system.gpu;
import screen;
import post;
import brdf;

fun glyph_bits(code: int): int {
    if code == 65 {
        return 10090902;
    }
    if code == 66 {
        return 15310494;
    }
    if code == 67 {
        return 7899271;
    }
    if code == 68 {
        return 15309214;
    }
    if code == 69 {
        return 16289423;
    }
    if code == 70 {
        return 8949391;
    }
    if code == 71 {
        return 7969671;
    }
    if code == 72 {
        return 10067865;
    }
    if code == 73 {
        return 14959694;
    }
    if code == 74 {
        return 6885651;
    }
    if code == 75 {
        return 10144937;
    }
    if code == 76 {
        return 16287880;
    }
    if code == 77 {
        return 10067961;
    }
    if code == 78 {
        return 10206681;
    }
    if code == 79 {
        return 6920598;
    }
    if code == 80 {
        return 8972702;
    }
    if code == 81 {
        return 8100246;
    }
    if code == 82 {
        return 10152350;
    }
    if code == 83 {
        return 14751367;
    }
    if code == 84 {
        return 6710895;
    }
    if code == 85 {
        return 6920601;
    }
    if code == 86 {
        return 6723993;
    }
    if code == 87 {
        return 10484121;
    }
    if code == 88 {
        return 10053273;
    }
    if code == 89 {
        return 6710937;
    }
    if code == 90 {
        return 16269855;
    }
    if code == 48 {
        return 6937494;
    }
    if code == 49 {
        return 14959812;
    }
    if code == 50 {
        return 16269854;
    }
    if code == 51 {
        return 14751262;
    }
    if code == 52 {
        return 1122201;
    }
    if code == 53 {
        return 14753423;
    }
    if code == 54 {
        return 6921863;
    }
    if code == 55 {
        return 4465183;
    }
    if code == 56 {
        return 6919830;
    }
    if code == 57 {
        return 14776726;
    }
    if code == 47 {
        return 8929809;
    }
    if code == 45 {
        return 3840;
    }
    if code == 43 {
        return 20032;
    }
    if code == 58 {
        return 262208;
    }
    return 0;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun present_fragment(
    pixel: ScreenPixel,
    scene: GpuTexture,
    weather: GpuTexture,
    filtering: GpuSampler,
    @readonly text: GpuBuffer<int>,
    display: GpuVec2,
    status: GpuVec4,
    effects: GpuVec4,
    target_srgb: int
): GpuVec4 {
    let uv = GpuVec2(pixel.uv.x * 0.5f + 0.5f, 0.5f - pixel.uv.y * 0.5f);
    let rgb = scene_display(scene, filtering, uv);
    let overlay = weather.sample_level(filtering, uv, 0.0f);
    let depth = scene.sample_level(filtering, uv, 0.0f).w;
    if depth > 0.22f && overlay.w > 0.001f {
        let color = display_color(GpuVec3(overlay.x, overlay.y, overlay.z) / overlay.w);
        rgb = GpuMath.mix(rgb, color, GpuVec3(overlay.w));
    }
    let vignette = 1.0f - pixel.uv.dot(pixel.uv) * 0.13f;
    rgb = rgb * vignette;
    let p = GpuVec2(pixel.uv.x * display.x / display.y, pixel.uv.y);
    if status.x == 0.0f && status.y == 0.0f {
        let cross = GpuMath.abs(p);
        if effects.z > 0.0f
            && GpuMath.abs(cross.x - cross.y) < 0.0025f && cross.x > 0.018f && cross.x < 0.035f {
            rgb = GpuVec3(1.0f, 0.4f, 0.08f);
        }
        if (cross.x < 0.012f && cross.y < 0.0018f) || (cross.y < 0.012f && cross.x < 0.0018f) {
            rgb = GpuVec3(0.4f, 1.0f, 1.0f);
            if effects.z > 0.0f {
                rgb = GpuVec3(1.0f, 0.4f, 0.1f);
            }
        }
    }
    if status.z > 1.5f && effects.w > 0.85f && status.x == 0.0f && status.y == 0.0f {
        let radius = p.length();
        let mask = 1.0f - GpuMath.smoothstep(0.74f, 0.77f, radius);
        rgb = rgb * mask;
        if radius < 0.74f {
            if GpuMath.abs(p.x) < 0.0013f || GpuMath.abs(p.y) < 0.0013f {
                rgb = GpuVec3(0.015f);
            }
            if GpuMath.abs(p.x) < 0.04f && GpuMath.abs(GpuMath.fract(p.y * 8.0f) - 0.5f) < 0.025f {
                rgb = GpuVec3(0.02f);
            }
            if radius < 0.004f {
                rgb = GpuVec3(1.0f, 0.12f, 0.03f);
            }
        }
    }
    if status.x != 0.0f || status.y != 0.0f {
        rgb = rgb * 0.25f;
    }
    if uv.y > 0.94f && uv.x > 0.04f && uv.x < 0.24f {
        rgb = GpuVec3(0.08f, 0.12f, 0.14f);
        if uv.x < 0.04f + 0.2f * status.w / 100.0f {
            rgb = GpuVec3(0.03f, 0.85f, 0.7f);
        }
    }
    rgb = rgb + GpuVec3(effects.y * 0.65f, 0.0f, 0.0f) * (1.0f - vignette + 0.1f);
    let cell = GpuMath.floor(uv * GpuVec2(100.0f, 56.0f));
    let local = GpuMath.fract(uv * GpuVec2(100.0f, 56.0f));
    let column = (int)cell.x;
    let row = (int)cell.y;
    if column >= 0 && column < 100 && row >= 0 && row < 56 {
        let code = text[row * 100 + column];
        let gx = (int)(local.x * 5.0f);
        let gy = (int)(local.y * 7.0f);
        if gx < 4 && gy < 6 {
            let bits = glyph_bits(code);
            if ((bits >>(gy * 4 + (3 - gx))) & 1) != 0 {
                rgb = GpuVec3(0.68f, 0.92f, 0.95f);
                if row == 5 || row == 25 || row == 50 {
                    rgb = GpuVec3(1.0f, 0.55f, 0.28f);
                }
            }
        }
    }
    if target_srgb == 0 {
        rgb = encode_display(rgb);
    }
    return GpuVec4(rgb.x, rgb.y, rgb.z, 1.0f);
}
