import system.gpu;

public struct MeshTriangle {
    public x: int;
    public y: int;
    public z: int;
    public w: int;
}

public struct MeshHit {
    public distance: float;
    public normal: GpuVec3;
    public tangent: GpuVec3;
    public handedness: float;
    public uv: GpuVec2;
    public material: int;
    public flash: float;
}

public fun pose_vertex(
    @readonly vertices: GpuBuffer<GpuVec4>,
    base: int,
    count: int,
    index: int,
    pose: GpuVec3,
    normal: int
): GpuVec4 {
    let a = vertices[(base + (int)pose.x * count + index) * 2 + normal];
    let b = vertices[(base + (int)pose.y * count + index) * 2 + normal];
    return a + (b - a) * pose.z;
}

public fun scene_model(
    @readonly acceleration: GpuBuffer<GpuVec4>,
    layout: GpuVec4,
    index: int
): GpuVec4 {
    return acceleration[(int)layout.y + index * 3];
}

public fun scene_triangle(@readonly acceleration: GpuBuffer<GpuVec4>, index: int): MeshTriangle {
    let item = acceleration[index];
    let result = MeshTriangle();
    result.x = (int)item.x;
    result.y = (int)item.y;
    result.z = (int)item.z;
    result.w = (int)item.w;
    return result;
}

public fun rotate_cs(value: GpuVec3, cosine: float, sine: float): GpuVec3 {
    return GpuVec3(value.x * cosine + value.z * sine, value.y, value.z * cosine - value.x * sine);
}
