import system.gpu;
import screen;
import brdf;
import anti_alias;

public fun scene_display(scene: GpuTexture, filtering: GpuSampler, uv: GpuVec2): GpuVec3 {
    let center = scene.sample_level(filtering, uv, 0.0f);
    let size = scene.size(0);
    let step = GpuVec2(3.0f / (float)size.x, 3.0f / (float)size.y);
    let glow = GpuVec3(0.0f);
    for (let i in 0..4) {
        let offset = GpuVec2(step.x, step.y);
        if i == 1 || i == 3 {
            offset.x = -offset.x;
        }
        if i >= 2 {
            offset.y = -offset.y;
        }
        let tap = scene.sample_level(filtering, uv + offset, 0.0f);
        glow = glow + GpuMath.max(GpuVec3(tap.x, tap.y, tap.z) - GpuVec3(1.5f), GpuVec3(0.0f));
    }
    let base = GpuVec3(center.x, center.y, center.z);
    return antialiased_scene(scene, filtering, uv)
        + display_color(base + glow * 0.075f) - display_color(base);
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun capture_fragment(
    pixel: ScreenPixel,
    scene: GpuTexture,
    filtering: GpuSampler,
    target_srgb: int
): GpuVec4 {
    let uv = GpuVec2(pixel.uv.x * 0.5f + 0.5f, 0.5f - pixel.uv.y * 0.5f);
    let color = scene_display(scene, filtering, uv);
    if target_srgb == 0 {
        color = encode_display(color);
    }
    return GpuVec4(color.x, color.y, color.z, 1.0f);
}
