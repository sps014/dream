import system;
import system.testing;
import quality;

@test
fun gravewake_quality_native_and_supersampled_sizes(): void {
    let high = scene_size(1920, 1080, 2);
    let ultra = scene_size(1920, 1080, 3);
    Assert.eq((int)high.x, 1920);
    Assert.eq((int)high.y, 1080);
    Assert.eq((int)ultra.x, 3840);
    Assert.eq((int)ultra.y, 2160);
    let capped = scene_size(3840, 2160, 3);
    Assert.eq((int)capped.x, 3840);
    Assert.eq((int)capped.y, 2160);
}

@test
fun gravewake_quality_preserves_portrait_and_wide_aspect(): void {
    for (let quality in 0..4) {
        let portrait = scene_size(900, 1600, quality);
        Assert.is_true(
            Math.abs(portrait.x - portrait.y * (900.0f / 1600.0f)) < 1.0f + 900.0f / 1600.0f
        );
        let wide = scene_size(3440, 1440, quality);
        Assert.is_true(Math.abs(wide.x - wide.y * (3440.0f / 1440.0f)) < 1.0f + 3440.0f / 1440.0f);
    }
    let minimized = scene_size(0, 0, 3);
    Assert.eq((int)minimized.x, 1);
    Assert.eq((int)minimized.y, 1);
}
