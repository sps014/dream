import system.gpu;

public struct ScreenPixel {
    @builtin("position")
    public position: GpuVec4;

    @location(0)
    public uv: GpuVec2;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@vertex
fun screen_vertex(): ScreenPixel {
    let x = -1.0f;
    let y = -1.0f;
    if vertex_id() == 1 {
        x = 3.0f;
    } else if vertex_id() == 2 {
        y = 3.0f;
    }
    let pixel = ScreenPixel();
    pixel.position = GpuVec4(x, y, 0.0f, 1.0f);
    pixel.uv = GpuVec2(x, y);
    return pixel;
}
