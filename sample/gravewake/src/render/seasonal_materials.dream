import system.gpu;

public fun snow_amount(season: float): float {
    return GpuMath.smoothstep(2.5f, 3.0f, season);
}

public fun seasonal_position(point: GpuVec3, material: float, season: float): GpuVec3 {
    let result = point;
    let ground = material == 40.0f || material == 41.0f || material == 42.0f || material == 61.0f;
    if material != 59.0f && !ground && point.y < 0.25f {
        result.y = result.y + snow_amount(season) * 0.22f;
    }
    return result;
}

public fun seasonal_color(
    base: GpuVec3,
    point: GpuVec3,
    normal: GpuVec3,
    material: int,
    season: float
): GpuVec3 {
    let color = base;
    let ground = (material == 40 || material == 41 || material == 61);
    if ground && point.y < 0.6f {
        if season < 0.5f {
            color = GpuVec3(0.12f, 0.27f, 0.07f);
        } else if season > 1.5f && season < 2.5f {
            color = GpuVec3(0.30f, 0.13f, 0.035f);
        }
    }
    let snow = snow_amount(season);
    let cover = GpuMath.smoothstep(0.25f, 0.72f, normal.y) * snow;
    if material == 76 {
        cover = snow;
    }
    if material >= 40 && material < 68 {
        let grain = 0.95f + 0.05f * GpuMath.sin(point.x * 0.9f + point.z * 1.2f);
        color = GpuMath.mix(color, GpuVec3(0.79f, 0.90f, 1.0f) * grain, GpuVec3(cover));
    }
    if material == 76 {
        color = GpuVec3(0.79f, 0.90f, 1.0f);
    }
    return color;
}
