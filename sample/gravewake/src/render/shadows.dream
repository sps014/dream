import system.gpu;
import raster;
import shadow_space;

public fun raster_visibility(pixel: WorldPixel, shadow: GpuTexture, filtering: GpuSampler): float {
    if pixel.view_model > 0.0f {
        return 1.0f;
    }
    let point = shadow_position(pixel.world + pixel.normal.normalize() * 0.10f);
    let uv = GpuVec2(point.x * 0.5f + 0.5f, 0.5f - point.y * 0.5f);
    if uv.x < 0.0f || uv.x > 1.0f || uv.y < 0.0f || uv.y > 1.0f {
        return 1.0f;
    }
    let slope = 1.0f
        - GpuMath.max(
            0.0f,
            pixel.normal.normalize().dot(GpuVec3(-0.45f, 0.85f, -0.3f).normalize())
        );
    let bias = 0.0008f + slope * 0.003f;
    let visibility = 0.0f;
    for (let i in 0..4) {
        let offset = GpuVec2(-0.5f, -0.5f);
        if i % 2 == 1 {
            offset.x = 0.5f;
        }
        if i >= 2 {
            offset.y = 0.5f;
        }
        let stored = shadow.sample_level(filtering, uv + offset / 2048.0f, 0.0f).x;
        if point.z - bias <= stored {
            visibility = visibility + 0.25f;
        }
    }
    return visibility;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun shadow_fragment(pixel: WorldPixel): GpuVec4 {
    return GpuVec4(pixel.position.z, 0.0f, 0.0f, 1.0f);
}
