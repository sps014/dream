import system.gpu;
import raster;
import toon;
import hardware;
import shadows;

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal)
@fragment
fun world_fragment(
    pixel: WorldPixel,
    camera: GpuVec4,
    @readonly actors: GpuBuffer<GpuVec4>,
    actor_count: int,
    season: float,
    @readonly vertices: GpuBuffer<GpuVec4>,
    @readonly acceleration: GpuBuffer<GpuVec4>,
    @readonly ray_triangles: GpuBuffer<int>,
    layout: GpuVec4,
    shadow: GpuTexture,
    shadow_filter: GpuSampler,
    static_scene: GpuAccelerationStructure
): GpuVec4 {
    let visibility = raster_visibility(pixel, shadow, shadow_filter);
    let normal = pixel.normal.normalize();
    if pixel.view_model == 0.0f && normal.dot(GpuVec3(-0.45f, 0.85f, -0.3f)) > 0.0f {
        if static_occluded(
            static_scene,
            pixel.world + normal * 0.035f,
            GpuVec3(-0.45f, 0.85f, -0.3f).normalize(),
            90.0f
        ) {
            visibility = 0.0f;
        }
    }
    let color = scene_lighting(pixel, camera, visibility, actors, actor_count, season);
    if pixel.material > 58.5f && pixel.material < 59.5f {
        let origin = GpuVec3(camera.x, camera.y, camera.z);
        let ray = (pixel.world - origin).normalize();
        let direction = GpuMath.reflect(ray, normal);
        let bounce = static_hit(
            static_scene,
            pixel.world + normal * 0.04f,
            direction,
            90.0f,
            vertices,
            acceleration,
            ray_triangles,
            layout
        );
        let reflected = GpuVec3(0.42f, 0.73f, 0.83f);
        if bounce.material != 0 {
            reflected = toon_color(bounce.material, bounce.uv) * 0.8f;
        }
        color = GpuMath.mix(
            color,
            reflected,
            GpuVec3(0.16f + GpuMath.pow(1.0f - GpuMath.abs(ray.y), 4.0f) * 0.4f)
        );
    }
    let distance = (pixel.world - GpuVec3(camera.x, camera.y, camera.z)).length();
    return GpuVec4(color.x, color.y, color.z, GpuMath.log2(1.0f + distance) / 7.0f);
}
