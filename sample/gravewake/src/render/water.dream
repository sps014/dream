import system.gpu;
import raster;
import screen;

public fun river_surface(
    pixel: WorldPixel,
    camera: GpuVec4,
    look: GpuVec4,
    aspect: float,
    reflection: GpuTexture,
    refraction: GpuTexture,
    filtering: GpuSampler
): GpuVec3 {
    let origin = GpuVec3(camera.x, camera.y, camera.z);
    let incident = (pixel.world - origin).normalize();
    let wave = GpuVec3(
        GpuMath.sin(pixel.world.z * 4.0f - camera.w * 2.0f)
            * 0.055f + GpuMath.sin(pixel.world.x * 1.7f + camera.w) * 0.025f,
        1.0f,
        GpuMath.cos(pixel.world.x * 3.2f + camera.w * 1.7f) * 0.04f
    ).normalize();
    if look.w > 2.5f {
        wave = GpuVec3(0.0f, 1.0f, 0.0f);
    }
    let edge = GpuMath.clamp((2.4f - GpuMath.abs(pixel.world.z - 24.0f)) / 2.4f, 0.0f, 1.0f);
    let forward = GpuVec3(
        GpuMath.sin(look.x) * GpuMath.cos(look.y),
        GpuMath.sin(look.y),
        GpuMath.cos(look.x) * GpuMath.cos(look.y)
    );
    let right = GpuVec3(GpuMath.cos(look.x), 0.0f, -GpuMath.sin(look.x));
    let up = -right.cross(forward);
    let delta = pixel.world - origin;
    let z = GpuMath.max(0.05f, delta.dot(forward));
    let uv = GpuVec2(
        delta.dot(right) * look.z / (z * aspect) * 0.5f + 0.5f,
        0.5f - delta.dot(up) * look.z / z * 0.5f
    );
    let screen_uv = uv;
    uv = GpuMath.clamp(uv + GpuVec2(wave.x, wave.z) * 0.06f, GpuVec2(0.002f), GpuVec2(0.998f));
    let reflected = reflection.sample_level(filtering, uv, 0.0f);
    let refract_uv = GpuMath.clamp(
        screen_uv + GpuVec2(wave.x, wave.z) * 0.04f,
        GpuVec2(0.001f),
        GpuVec2(0.999f)
    );
    let behind = refraction.sample_level(filtering, refract_uv, 0.0f);
    let water_distance = (pixel.world - origin).length();
    let behind_distance = GpuMath.exp2(behind.w * 7.0f) - 1.0f;
    if behind_distance < water_distance {
        behind = refraction.sample_level(filtering, screen_uv, 0.0f);
    }
    let thickness = GpuMath.clamp(
        (GpuMath.exp2(behind.w * 7.0f) - 1.0f - water_distance) * 0.55f,
        0.0f,
        4.0f
    );
    let absorb = GpuMath.exp(-GpuVec3(0.48f, 0.17f, 0.10f) * thickness);
    let water = GpuVec3(behind.x, behind.y, behind.z)
        * absorb + GpuVec3(0.015f, 0.13f, 0.18f) * (GpuVec3(1.0f) - absorb);
    let fresnel = 0.04f + 0.80f * GpuMath.pow(
        1.0f - GpuMath.max(0.0f, (-incident).dot(wave)),
        5.0f
    );
    water = GpuMath.mix(water, GpuVec3(reflected.x, reflected.y, reflected.z), GpuVec3(fresnel));
    let half_vector = (GpuVec3(-0.45f, 0.85f, -0.3f).normalize() - incident).normalize();
    water = water
        + GpuVec3(2.6f, 1.8f, 0.8f) * GpuMath.pow(GpuMath.max(0.0f, wave.dot(half_vector)), 160.0f);
    let foam = (1.0f - GpuMath.smoothstep(0.0f, 0.16f, edge))
        * (0.7f + 0.3f * GpuMath.sin(pixel.world.x * 8.0f - camera.w * 2.0f));
    water = GpuMath.mix(water, GpuVec3(0.65f, 0.76f, 0.65f), GpuVec3(foam * 0.25f));
    if look.w > 2.5f {
        let cell = GpuVec2(pixel.world.x, pixel.world.z) * 0.9f;
        let base_cell = GpuMath.floor(cell);
        let nearest = 100.0f;
        let second = 100.0f;
        for (let i in 0..9) {
            let tile = base_cell + GpuVec2((float)(i % 3) - 1.0f, (float)(i / 3) - 1.0f);
            let seed = GpuMath.fract(GpuMath.sin(tile.dot(GpuVec2(127.1f, 311.7f))) * 43758.5f);
            let delta = tile + GpuVec2(seed, GpuMath.fract(seed * 17.3f)) - cell;
            let distance = delta.dot(delta);
            if distance < nearest {
                second = nearest;
                nearest = distance;
            } else {
                second = GpuMath.min(second, distance);
            }
        }
        let cracks = 1.0f - GpuMath.smoothstep(0.01f, 0.045f, second - nearest);
        water = GpuMath.mix(
            water,
            GpuVec3(0.34f, 0.58f, 0.68f) + GpuVec3(cracks * 0.18f),
            GpuVec3(0.72f)
        );
    }
    return water;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@vertex
fun water_vertex(camera: GpuVec4, look: GpuVec4, aspect: float): WorldPixel {
    let corner = vertex_id();
    let x = -52.0f;
    let z = 21.6f;
    if corner == 1 || corner == 2 || corner == 4 {
        x = 52.0f;
    }
    if corner == 2 || corner == 4 || corner == 5 {
        z = 26.4f;
    }
    let pixel = WorldPixel();
    let surface = 0.045f;
    if look.w > 2.5f {
        surface = 0.22f;
    }
    pixel.world = GpuVec3(x, surface, z);
    pixel.normal = GpuVec3(0.0f, 1.0f, 0.0f);
    pixel.material = 59.0f;
    let forward = GpuVec3(
        GpuMath.sin(look.x) * GpuMath.cos(look.y),
        GpuMath.sin(look.y),
        GpuMath.cos(look.x) * GpuMath.cos(look.y)
    );
    let right = GpuVec3(GpuMath.cos(look.x), 0.0f, -GpuMath.sin(look.x));
    let up = -right.cross(forward);
    let delta = pixel.world - GpuVec3(camera.x, camera.y, camera.z);
    let distance = delta.dot(forward);
    pixel.position = GpuVec4(
        delta.dot(right) * look.z / aspect,
        delta.dot(up) * look.z,
        distance * 1.000417f - 0.050021f,
        distance
    );
    return pixel;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun water_copy_fragment(pixel: ScreenPixel, scene: GpuTexture, filtering: GpuSampler): GpuVec4 {
    return scene.sample_level(
        filtering,
        GpuVec2(pixel.uv.x * 0.5f + 0.5f, 0.5f - pixel.uv.y * 0.5f),
        0.0f
    );
}
