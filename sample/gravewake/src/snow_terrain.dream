import system.gpu;
import game.seasons;
import render.raster;
import render.shadows;
import render.screen;
import snow_imprint;
import snow_imprint.GpuShaders as StampShaders;

fun snow_uv(point: GpuVec3): GpuVec2 {
    return GpuVec2((point.x + 52.0f) / 104.0f, (88.0f - point.z) / 112.0f);
}

fun snow_corner(id: int): GpuVec2 {
    let p = GpuVec2(-1.0f);
    if id == 1 || id == 2 || id == 4 {
        p.x = 1.0f;
    }
    if id == 2 || id == 4 || id == 5 {
        p.y = 1.0f;
    }
    return p;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@vertex
fun snow_ground_vertex(
    mask: GpuTexture,
    filtering: GpuSampler,
    camera: GpuVec4,
    look: GpuVec4,
    aspect: float
): WorldPixel {
    let corner = snow_corner(vertex_id()) * 0.5f + GpuVec2(0.5f);
    let cell = instance_id();
    let x = -52.0f + ((float)(cell % 320) + corner.x) * (104.0f / 320.0f);
    let z = -24.0f + ((float)(cell / 320) + corner.y) * (112.0f / 352.0f);
    let point = GpuVec3(x, 0.0f, z);
    let uv = snow_uv(point);
    let amount = mask.sample_level(filtering, uv, 0.0f).x;
    let y = 0.02f + amount * 0.22f;
    if GpuMath.abs(x) < 3.0f && GpuMath.abs(z - 24.0f) < 3.0f {
        y = y + 0.22f;
    }
    let a = mask.sample_level(filtering, uv + GpuVec2(1.0f / 1024.0f, 0.0f), 0.0f).x;
    let b = mask.sample_level(filtering, uv - GpuVec2(1.0f / 1024.0f, 0.0f), 0.0f).x;
    let c = mask.sample_level(filtering, uv + GpuVec2(0.0f, 1.0f / 1024.0f), 0.0f).x;
    let d = mask.sample_level(filtering, uv - GpuVec2(0.0f, 1.0f / 1024.0f), 0.0f).x;
    let pixel = WorldPixel();
    pixel.world = GpuVec3(x, y, z);
    pixel.normal = GpuVec3(-(a - b) * 1.08f, 1.0f, (c - d) * 1.0f).normalize();
    pixel.uv = GpuVec2(amount, 0.0f);
    let forward = GpuVec3(
        GpuMath.sin(look.x) * GpuMath.cos(look.y),
        GpuMath.sin(look.y),
        GpuMath.cos(look.x) * GpuMath.cos(look.y)
    );
    let right = GpuVec3(GpuMath.cos(look.x), 0.0f, -GpuMath.sin(look.x));
    let up = -right.cross(forward);
    let delta = pixel.world - GpuVec3(camera.x, camera.y, camera.z);
    let depth = delta.dot(forward);
    pixel.position = GpuVec4(
        delta.dot(right) * look.z / aspect,
        delta.dot(up) * look.z,
        depth * 1.000417f - 0.050021f,
        depth
    );
    return pixel;
}

@gpu_targets(GpuTarget.Dx12, GpuTarget.Vulkan, GpuTarget.Metal, GpuTarget.WebGpu)
@fragment
fun snow_ground_fragment(
    pixel: WorldPixel,
    camera: GpuVec4,
    shadow: GpuTexture,
    shadow_filter: GpuSampler
): GpuVec4 {
    if GpuMath.abs(pixel.world.z - 24.0f) < 2.4f && GpuMath.abs(pixel.world.x) > 3.0f {
        discard_fragment();
    }
    let amount = GpuMath.clamp(pixel.uv.x, 0.0f, 1.0f);
    let sun = GpuVec3(-0.45f, 0.85f, -0.3f).normalize();
    let visibility = raster_visibility(pixel, shadow, shadow_filter);
    let base = GpuMath.mix(
        GpuVec3(0.23f, 0.38f, 0.48f),
        GpuVec3(0.79f, 0.90f, 1.0f),
        GpuVec3(GpuMath.smoothstep(0.0f, 0.85f, amount))
    );
    let color = base
        * (
            GpuVec3(0.35f, 0.48f, 0.61f)
                + GpuVec3(1.25f, 1.10f, 0.82f)
                * GpuMath.max(0.0f, pixel.normal.dot(sun)) * visibility
        );
    let distance = (pixel.world - GpuVec3(camera.x, camera.y, camera.z)).length();
    let fog = 1.0f - GpuMath.exp(-GpuMath.max(0.0f, distance - 18.0f) * 0.009f);
    color = GpuMath.mix(color, GpuVec3(0.57f, 0.70f, 0.79f), GpuVec3(fog));
    return GpuVec4(color.x, color.y, color.z, GpuMath.log2(1.0f + distance) / 7.0f);
}

public class SnowTerrain {
    public mask: GpuTexture;
    tracks: GpuBuffer<GpuVec4>;
    imprint: GpuRenderPipeline;
    fill: GpuRenderPipeline;
    ground: GpuRenderPipeline;
    filtering: GpuSampler;
    last: int;
    ready: bool;
    time: float;

    constructor(
        mask: GpuTexture,
        tracks: GpuBuffer<GpuVec4>,
        imprint: GpuRenderPipeline,
        fill: GpuRenderPipeline,
        ground: GpuRenderPipeline,
        filtering: GpuSampler
    ) {
        this.mask = mask;
        this.tracks = tracks;
        this.imprint = imprint;
        this.fill = fill;
        this.ground = ground;
        this.filtering = filtering;
        this.last = 0;
        this.ready = false;
        this.time = 0.0f;
    }

    public static fun create(device: GpuDevice): Result<SnowTerrain, GpuError> {
        let blend = GpuRenderPipelineDesc.defaults(GpuTextureFormat.Rgba16Float)
            .with_blend_mode(GpuBlendMode.Alpha)
            .with_cull_mode(GpuCullMode.None);
        return Result.Ok(
            SnowTerrain(
                device.texture(
                    GpuTextureDesc(1024, 1024, GpuTextureFormat.Rgba16Float).render_target(true)
                )?,
                device.buffer_alloc<GpuVec4>(768)?,
                device.render_pipeline(
                    StampShaders.imprint_vertex,
                    StampShaders.imprint_fragment,
                    blend
                )?,
                device.render_pipeline(
                    StampShaders.stamp_screen_vertex,
                    StampShaders.fill_fragment,
                    blend
                )?,
                device.render_pipeline(
                    GpuShaders.snow_ground_vertex,
                    GpuShaders.snow_ground_fragment,
                    GpuRenderPipelineDesc.defaults(GpuTextureFormat.Rgba16Float)
                        .with_cull_mode(GpuCullMode.None)
                        .with_depth(GpuTextureFormat.Depth32Float, GpuCompare.LessEqual, true)
                )?,
                device.sampler(GpuSamplerDesc(GpuFilter.Linear))?
            )
        );
    }

    public fun update(
        encoder: GpuCommandEncoder,
        seasons: Seasons,
        time: float
    ): Result<bool, GpuError> {
        if seasons.current != 3 {
            this.ready = false;
            this.last = 0;
            return Result.Ok(false);
        }
        if seasons.stamps < this.last || time < this.time {
            this.ready = false;
            this.last = 0;
        }
        let load: GpuLoad<GpuVec4> = GpuLoad.Keep;
        if !this.ready {
            load = GpuLoad.Clear(GpuVec4(1.0f));
        }
        let pass = encoder.begin_render_pass(GpuRenderPassDesc.color(this.mask, load));
        pass.set_pipeline(this.fill);
        pass.bind_value(
            StampShaders.fill_fragment.amount,
            (float)Math.min(0.01f, Math.max(0.0f, time - this.time) * 0.012f)
        );
        pass.draw(3);
        let count = (int)Math.min(384, seasons.stamps - this.last);
        if count > 0 {
            this.tracks.write(seasons.tracks)?;
            pass.set_pipeline(this.imprint);
            pass.bind_buffer(StampShaders.imprint_vertex.tracks, this.tracks);
            pass.bind_value(StampShaders.imprint_vertex.first, (seasons.head - count + 384) % 384);
            pass.draw(6, count);
        }
        pass.end();
        this.last = seasons.stamps;
        this.time = time;
        this.ready = true;
        return Result.Ok(true);
    }

    public fun draw(
        encoder: GpuCommandEncoder,
        image: GpuTexture,
        depth: GpuTexture,
        camera: GpuVec4,
        look: GpuVec4,
        aspect: float,
        shadow: GpuTexture,
        shadow_filter: GpuSampler
    ): void {
        if look.w < 2.5f {
            return;
        }
        let pass = encoder.begin_render_pass(
            GpuRenderPassDesc.color(image, GpuLoad.Keep).with_depth(depth, GpuLoad.Keep)
        );
        pass.set_pipeline(this.ground);
        pass.bind(GpuShaders.snow_ground_vertex.mask, this.mask);
        pass.bind(GpuShaders.snow_ground_vertex.filtering, this.filtering);
        pass.bind_value(GpuShaders.snow_ground_vertex.camera, camera);
        pass.bind_value(GpuShaders.snow_ground_vertex.look, look);
        pass.bind_value(GpuShaders.snow_ground_vertex.aspect, aspect);
        pass.bind_value(GpuShaders.snow_ground_fragment.camera, camera);
        pass.bind(GpuShaders.snow_ground_fragment.shadow, shadow);
        pass.bind(GpuShaders.snow_ground_fragment.shadow_filter, shadow_filter);
        pass.draw(6, 320 * 352);
        pass.end();
    }
}
