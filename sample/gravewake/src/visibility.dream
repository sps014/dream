import system;
import game.animation;
import system.gpu;
import game.simulation;

public fun sphere_in_frustum(
    center: GpuVec3,
    radius: float,
    camera: GpuVec3,
    yaw: float,
    pitch: float,
    focal: float,
    aspect: float
): bool {
    let forward = GpuVec3(
        (float)Math.sin(yaw) * (float)Math.cos(pitch),
        (float)Math.sin(pitch),
        (float)Math.cos(yaw) * (float)Math.cos(pitch)
    );
    let right = GpuVec3((float)Math.cos(yaw), 0.0f, -(float)Math.sin(yaw));
    let up = -right.cross(forward);
    let delta = center - camera;
    let depth = delta.dot(forward);
    if depth + radius < 0.05f || depth - radius > 90.0f {
        return false;
    }
    let horizontal = aspect / focal;
    let vertical = 1.0f / focal;
    return Math.abs(delta.dot(right)) <= depth
        * horizontal
        + radius
        * (float)Math.sqrt(1.0f + horizontal * horizontal)
        && Math.abs(delta.dot(up)) <= depth
        * vertical + radius * (float)Math.sqrt(1.0f + vertical * vertical);
}

public fun visible_actors(game: Game, camera: GpuVec3, focal: float, aspect: float): int[] {
    let ids = List<int>();
    for (let i in 0..game.enemies.length) {
        let enemy = game.enemies[i];
        if enemy.health <= 0 && enemy.animation_time > corpse_lifetime() {
            continue;
        }
        let radius = 1.5f;
        if enemy.health <= 0 {
            radius = 2.8f;
        }
        let center = GpuVec3(enemy.position.x, 1.0f, enemy.position.z);
        if enemy.body.active {
            center = enemy.body.points[0];
        }
        if sphere_in_frustum(center, radius, camera, game.yaw, game.pitch, focal, aspect) {
            ids.push(i);
        }
    }
    let result = ids.take_array();
    for (let i in 0..result.length) {
        for (let j in i + 1..result.length) {
            let a = game.enemies[result[i]].position - camera;
            let b = game.enemies[result[j]].position - camera;
            if b.dot(b) < a.dot(a) {
                let swap = result[i];
                result[i] = result[j];
                result[j] = swap;
            }
        }
    }
    return result;
}
