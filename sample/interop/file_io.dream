// Demonstrates the File / FileHandle API. Runs natively (`cargo run -- run sample/interop/file_io.dream`)
// and under Node via runtime/dream.js, using one code path on both.
import system;
import system.io;
import system.encoding;

async fun main(): void {
    let path = "scratch_file_io.txt";

    // Write, then append more text.
    File.write(path, "Dream\n").await;
    File.append(path, "rocks\n").await;

    // Metadata (synchronous predicates). `size` is an `Option<long>` (`None` if absent).
    if File.exists(path) {
        System.print("size = ");
        System.println(File.size(path).unwrap_or(0L - 1L));
    }

    // Read the whole thing. `read` resolves with a `Result<string, IoError>`.
    let text = File.read(path).await;
    System.print(text.unwrap_or(""));

    // Buffered, seekable streaming. `open` returns a `Result<FileHandle, IoError>`.
    let stream = FileHandle.open(path, FileMode.Read).unwrap();
    System.print("first 5: ");
    System.println(Encoding.utf8_decode(stream.read(5).unwrap())); // "Dream"
    System.print("at pos: ");
    System.println(stream.tell().unwrap()); // 5
    stream.seek(0L).unwrap();
    System.print("rest: ");
    System.println(Streams.read_text(stream).unwrap()); // "Dream\nrocks\n"
    stream.close().unwrap();

    // Raw byte round-trip: read 5 bytes, write them to a second file.
    let head = FileHandle.open(path, FileMode.Read).unwrap();
    let bytes = head.read(5).unwrap();
    head.close().unwrap(); // ['D','r','e','a','m']
    File.write_bytes("scratch_head.bin", bytes).await;
    let echoed = File.read("scratch_head.bin").await;
    System.print("bytes -> ");
    System.println(echoed.unwrap_or("")); // "Dream"

    // List the current directory. `list` resolves with a `Result<string[], IoError>`.
    let entries = (File.list(".").await).unwrap_or(Array.alloc<string>(0));
    System.print("entries: ");
    System.println(entries.length);

    // Clean up.
    File.delete(path).await;
    File.delete("scratch_head.bin").await;
}
