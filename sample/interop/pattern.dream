// Regex via the `Regex` class. The engine is the PCRE2 runtime, so this program behaves
// the same under native, Node, and the browser.
//
//   cargo run -- run sample/interop/pattern.dream
//   node sample/interop/regex.mjs sample/interop/pattern.wasm
import system;
import regex;

fun main(): void {
    let digits = Regex.compile("\\d+", RegexFlags.Global).unwrap();

    if digits.test("abc123") {
        System.println("has digits");
    }

    let cleaned = digits.replace("a1b2c3", "#");
    System.println(cleaned); // a#b#c#

    let parts = digits.match("a1b2c3");
    System.println(parts.length); // 3
    System.println(parts[0]); // 1
    System.println(parts[2]); // 3
}
