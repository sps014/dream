import system;
import system.io;
import system.testing;

@test
fun asset_is_copied_next_to_the_runner(): void {
    Assert.is_true(File.exists("data/words.txt"));
}

@test
fun asset_lines_are_readable(): void {
    let stream = FileHandle.open("data/words.txt", FileMode.Read).unwrap();
    let text = Streams.read_text(stream);
    stream.close();
    Assert.eq(text.split("\n").length, 4);
    Assert.is_true(text.starts_with("alpha"));
}
