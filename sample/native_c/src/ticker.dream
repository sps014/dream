// The thin Dream wrapper over native/include/ticker.h. Bare `@c` binds to this package's own
// `native/` sources and uses the Dream name as the C symbol.
module ticker;
import system.interop;
import system;
cimport "ticker.h" as native_ticker;

@c
@owned("ticker_free")
extern fun ticker_new(name: string): OwnedCPtr;

@c
extern fun ticker_name(t: CPtr): string;

@c
extern fun ticker_on_tick(t: CPtr, cb: NativeCallback<fun(int): int>): void;

@c
extern fun ticker_label(t: CPtr, tick: int): Option<string>;

@c
extern fun checksum(data: byte[], len: usize): int;

public class Ticker {
    handle: OwnedCPtr;

    // C holds the callback between calls, so the Ticker keeps it alive.
    listener: Option<NativeCallback<fun(int): int>>;

    public constructor(name: string) {
        this.handle = ticker_new(name);
        this.listener = Option.None;
    }

    public fun name(): string {
        return ticker_name(this.handle.get());
    }

    public fun on_tick(f: fun(int): int): void {
        this.clear_listener();
        let cb = NativeCallback<fun(int): int>(f);
        ticker_on_tick(this.handle.get(), cb);
        this.listener = Option.Some(cb);
    }

    public fun clear_listener(): void {
        native_ticker.ticker_clear_callback(this.handle.get());
        this.listener = Option.None;
    }

    public fun run(ticks: int): int {
        return native_ticker.ticker_run(this.handle.get(), ticks);
    }

    public fun label(tick: int): Option<string> {
        return ticker_label(this.handle.get(), tick);
    }

    del() {
        this.clear_listener();
    }
}

public fun fingerprint(data: byte[]): int {
    return checksum(data, (usize)data.length);
}
