<?xml version="1.0" encoding="UTF-8"?>
<Window Title="Afterglow" Width="1120" Height="690" MinWidth="1060" MinHeight="620"
    Theme="GlassDark" ClearColor="#100D24" Hidden="true">
    <Overlay>
        <Border Effect="mesh" EffectColor="#5E327C" EffectColor2="#176B82"
            EffectAnimate="false" EffectPointer="false"/>
        <VBox Spacing="16" Slot.Padding="24">
            <HBox Spacing="16" Slot.Fill="1">
                <Border Width="252" Material="FrostedGlass" CornerRadius="24" Padding="20" Shadow="22">
                    <VBox Spacing="14">
                        <Label Text="Afterglow" TextSize="28"/>
                        <Label Text="Library" TextSize="16" Opacity="0.65"/>
                        <Separator/>
                        <Button Text="01    Violet Hour" Style="Flat" OnClicked="track.0"/>
                        <Button Text="02    Glass Tides" Style="Flat" OnClicked="track.1"/>
                        <Button Text="03    Signal Bloom" Style="Flat" OnClicked="track.2"/>
                    </VBox>
                </Border>
                <Border Material="TintedGlass" CornerRadius="24" Padding="22" Shadow="22" Slot.Fill="1">
                    <VBox Spacing="12">
                        <Label Text="Now playing" TextSize="16" Opacity="0.7"/>
                        <Border Name="art" Effect="aurora" EffectColor="#A878FF" EffectColor2="#244C84"
                            EffectAnimate="false" EffectPointer="false" CornerRadius="18" Slot.Fill="1"/>
                        <Label Name="title" TextSize="34"/>
                        <Label Name="detail" TextSize="17" Opacity="0.7"/>
                    </VBox>
                </Border>
                <Border Width="226" Material="FrostedGlass" CornerRadius="24" Padding="20" Shadow="22">
                    <VBox Spacing="12">
                        <Label Text="Up next" TextSize="21"/>
                        <Label Name="next" TextSize="18" Wrap="true"/>
                        <Separator/>
                        <Label Text="Volume" Opacity="0.75"/>
                        <Slider Name="volume" Min="0" Max="1" Value="0.6" OnChanged="player.volume"/>
                        <Label Name="status" Wrap="true" Opacity="0.8"/>
                    </VBox>
                </Border>
            </HBox>
            <Border Material="Glass" CornerRadius="24" Padding="18,12" Shadow="26">
                <VBox Spacing="8">
                    <HBox Spacing="10">
                        <Label Name="elapsed" Font="monospace" Width="44" Slot.VAlign="Center"/>
                        <Slider Name="seek" Min="0" Max="1" Slot.Fill="1" OnChanged="player.seek"/>
                        <Label Name="duration" Font="monospace" Width="44" Slot.VAlign="Center"/>
                    </HBox>
                    <HBox Spacing="10" Slot.HAlign="Center">
                        <Button Text="Previous" Style="Flat" OnClicked="player.previous"/>
                        <Button Name="play" Text="Play" Style="Primary" MinWidth="86" OnClicked="player.toggle"/>
                        <Button Text="Next" Style="Flat" OnClicked="player.next"/>
                        <Button Name="repeat" Text="Repeat off" Style="Flat" MinWidth="100"
                            OnClicked="player.repeat"/>
                    </HBox>
                </VBox>
            </Border>
        </VBox>
    </Overlay>
</Window>
