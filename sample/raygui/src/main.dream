import system;
import system.interop;
cimport "raylib.h" from "raylib" as rl;
cimport "raygui.h" as gui;

@unsafe
fun c_text(text: string): RawPtr<byte> {
    let bytes = Encoding.utf8_encode(text);
    let buffer = RawPtr<byte>.alloc((usize)bytes.length + 1);
    for (let i = 0; i < bytes.length; i = i + 1) {
        buffer[i] = bytes[i];
    }
    buffer[bytes.length] = (byte)0;
    return buffer;
}

fun rectangle(x: float, y: float, width: float, height: float): gui.Rectangle {
    let bounds = gui.Rectangle();
    bounds.x = x;
    bounds.y = y;
    bounds.width = width;
    bounds.height = height;
    return bounds;
}

@unsafe
fun main(): int {
    let title = c_text("Color Studio");
    rl.InitWindow(640, 360, CPtr(title.address()));
    if !rl.IsWindowReady() {
        title.free();
        System.println("Could not open the raylib window");
        return 1;
    }
    rl.SetTargetFPS(60);

    let reset = c_text("Reset color");
    let preview = c_text("Preview");
    let initial = rl.GetColor(0x6478F0FFu);
    let selected = RawPtr<rl.Color>.alloc(1);
    selected.write(initial);

    let background = rl.GetColor(0xF2F4F8FFu);
    let ink = rl.GetColor(0x172033FFu);
    let picker = rectangle(28.0, 94.0, 245.0, 196.0);
    let reset_button = rectangle(28.0, 306.0, 124.0, 30.0);
    gui.GuiSetStyle(gui.DEFAULT, gui.TEXT_SIZE, 18);

    while !rl.WindowShouldClose() {
        rl.BeginDrawing();
        rl.ClearBackground(background);
        rl.DrawText(CPtr(title.address()), 28, 24, 32, ink);
        rl.DrawText(CPtr(preview.address()), 332, 65, 18, ink);
        gui.GuiColorPicker(picker, CPtr.null(), CPtr(selected.address()));
        if gui.GuiButton(reset_button, CPtr(reset.address())) != 0 {
            selected.write(initial);
        }
        rl.DrawRectangle(332, 94, 280, 196, selected.read());
        rl.EndDrawing();
    }

    rl.CloseWindow();
    selected.free();
    preview.free();
    reset.free();
    title.free();
    return 0;
}
