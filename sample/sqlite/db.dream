import sqlite;

fun main(): void {
    switch (Database.open("demo.db")) {
        Some(db) => {
            if db.exec(
                "DROP TABLE IF EXISTS items; CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT);"
            ) && db.exec("INSERT INTO items(name) VALUES ('apple'), ('pear'), ('kiwi');") {
                db.query("SELECT id, name FROM items ORDER BY id;");
            }
            db.close();
        }
        None => {}
    }
}
