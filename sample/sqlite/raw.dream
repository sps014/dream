// Raw `@c` bindings to libsqlite3. Out-params use Dream `ref`.
//
// Run:
//   dream run sample/sqlite/raw.dream
//
// Assumes libsqlite3 is on the system loader path, or place a copy under
// `sample/sqlite/native/libsqlite3.dylib` (macOS) / `.so` / `.dll`.
import system;

@c("sqlite3", "sqlite3_open")
extern fun sqlite3_open(path: string, ref db: long): int;

@c("sqlite3", "sqlite3_close")
extern fun sqlite3_close(db: long): int;

// sqlite3_exec callback: int (*)(void*, int, char**, char**)
@c("sqlite3", "sqlite3_exec")
extern fun sqlite3_exec(
    db: long,
    sql: string,
    callback: fun(long, int, long, long): int,
    arg: long,
    ref errmsg: long
): int;

fun ignore_row(_arg: long, _argc: int, _argv: long, _cols: long): int {
    return 0;
}

fun print_row(_arg: long, argc: int, argv: long, _cols: long): int {
    let line = "";
    let i = 0;
    while i < argc {
        if i > 0 {
            line = line + "|";
        }
        let p = Ffi.read_ptr(argv, i);
        if p == 0L {
            line = line + "NULL";
        } else {
            line = line + Ffi.read_cstring(p);
        }
        i = i + 1;
    }
    System.println(line);
    return 0;
}

fun main(): void {
    let db: long = 0L;
    let rc = sqlite3_open(":memory:", ref db);
    if rc != 0 {
        System.println("sqlite3_open failed: " + rc);
        return;
    }
    System.println("opened in-memory database");

    let __errmsg: long = 0L;
    let ddl = "CREATE TABLE t(x INT); INSERT INTO t VALUES (1), (2);";
    let ok = sqlite3_exec(db, ddl, ignore_row, 0L, ref __errmsg);
    if ok != 0 {
        System.println("exec failed with rc=" + ok);
    } else {
        System.println("exec ok");
    }

    let qerr: long = 0L;
    let qrc = sqlite3_exec(db, "SELECT x FROM t ORDER BY x;", print_row, 0L, ref qerr);
    System.println("SELECT rc=" + qrc);
    if qrc != 0 {
        System.println("SELECT errmsg ptr=" + qerr);
    }

    let closed = sqlite3_close(db);
    System.println("closed with rc=" + closed);
}
