import sqlite;

fun main(): void {
    switch (Database.open(":memory:")) {
        Some(db) => {
            if db.exec("CREATE TABLE t(x INT); INSERT INTO t VALUES (1), (2);") {
                db.query("SELECT x FROM t ORDER BY x;");
            }
            db.exec("SELECT * FROM missing_table;");
            db.close();
        }
        None => {}
    }
    Database.open("/");
}
