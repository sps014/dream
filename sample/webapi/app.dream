import system;
import system.app;
import system.webapi;
import system.json;

@json
class Greeting {
    public message: string;

    public constructor(message: string) {
        this.message = message;
    }
}

async fun main(): int {
    return App.run(async () => {
        let app = WebApp();
        app.include_router(Routes.router()).unwrap();
        app.use(Cors.middleware(CorsOptions())).unwrap();
        let port = app.listen("127.0.0.1", 8000).await?;
        App.on_stop(async () => {
            app.shutdown();
            app.wait().await;
        });
        System.println("Listening on http://127.0.0.1:" + port.to_string() + "/docs");
        return Result.Ok(Unit());
    }).await;
}

@router("")
class Routes {
    @get("/hello/{name}")
    public static fun hello(@path name: string): Greeting {
        return Greeting("Hello, " + name + "!");
    }

    @get("/events")
    public static async fun events(): AsyncIterable<SseEvent> {
        yield SseEvent.data("connected");
        Time.sleep(100).await;
        yield SseEvent.data("ready");
    }
}
