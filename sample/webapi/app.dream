import system;
import system.json;
import system.webapi;

@json
class Item {
    public id: int;
    public name: string;

    public constructor(id: int, name: string) {
        this.id = id;
        this.name = name;
    }
}

@get("/health")
fun health(): string {
    return "ok";
}

@http_group("/api")
class ItemsApi {
    @get("/items/{id}")
    public static fun get_item(id: int): Item {
        return Item(id, "demo");
    }

    @post("/items")
    public static fun create(@body item: Item): Item {
        return item;
    }
}

async fun main(): void {
    WebApp.use(CORS(CorsOptions()));
    System.println("listening on :8080  (docs: http://127.0.0.1:8080/docs  redoc: /redoc)");
    await WebApp.run("127.0.0.1", 8080);
}
