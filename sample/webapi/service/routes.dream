module service.routes;
import system.webapi;
import system.webapi.auth;
import models;

public fun request_label(@header("X-Request-ID") label: Option<string>): string { return label.unwrap_or("local"); }

@router("/messages")
public class Messages {
    @requires_scopes("messages:write")
    @operation("Create a message", "Returns the validated message", "messages", 201)
    @post("/")
    public static fun create(@dep(CurrentUser) user: AuthPrincipal, @dep(request_label) label: string, @body message: CreateMessage): HttpOutgoing {
        return HttpOutgoing.json_text(Json.serialize(message), 201).set_header("X-Request-ID", label).set_header("X-User", user.subject);
    }
}
