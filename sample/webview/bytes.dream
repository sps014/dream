// Raw byte IPC: `invokeBytes` / `onBytes` on the page ride the `dream-ipc` scheme, so bodies
// cross as-is (no JSON, no base64). The page runs its checks and reports back, then the window
// closes itself.
//
//   cargo run -- run sample/webview/bytes.dream
import system;
import system.json;
import system.webview;

@json
class Report {
    public text: string;

    public constructor(text: string) {
        this.text = text;
    }
}

class Progress {
    public finished: bool;

    public constructor() {
        this.finished = false;
    }
}

let page: string = "<!DOCTYPE html><html><body><pre id='log'>running</pre><script>
function report(msg) { Dream.emit('result', JSON.stringify({ text: msg })); }
function boot(n) {
  if (!window.Dream || !Dream.__dream_webview) { if (n < 40) setTimeout(function () { boot(n + 1); }, 50); return; }
  Dream.onBytes('pushed', function (b) { report('pushed ' + Array.from(b).join(',')); });
  report('ready');
  Dream.invokeBytes('reverse_later', new Uint8Array([1, 2, 3, 250])).then(function (b) {
    report('reverse_later ' + Array.from(b).join(','));
    var big = new Uint8Array(4 * 1024 * 1024);
    for (var i = 0; i < big.length; i++) big[i] = i & 255;
    var t0 = performance.now();
    return Dream.invokeBytes('echo', big).then(function (out) {
      var ok = out.length === big.length;
      for (var j = 0; ok && j < out.length; j += 4093) ok = out[j] === (j & 255);
      report('echo ' + out.length + ' ' + (ok ? 'match' : 'MISMATCH') + ' ' + Math.round(performance.now() - t0) + 'ms');
    });
  }).then(function () {
    return Dream.invokeBytes('missing', new Uint8Array(0)).then(function () { report('missing resolved'); },
      function (e) { report('missing rejected: ' + e.message); });
  }).catch(function (e) { report('error ' + e.message); });
}
boot(0);
</script></body></html>";

async fun reverse_later(body: byte[]): byte[] {
    Time.delay(50).await;
    let out = Buffer.alloc<byte>(body.length);
    let i = 0;
    while i < body.length {
        out[i] = body[body.length - 1 - i];
        i = i + 1;
    }
    return out;
}

async fun watchdog(view: WebView, progress: Progress): void {
    let waited = 0;
    while (progress.finished == false) && (waited < 10000) {
        Time.delay(100).await;
        waited = waited + 100;
    }
    if progress.finished == false {
        System.println("timed out");
        view.close();
    }
}

async fun main() {
    switch (WebView.create("Bytes", 360, 200)) {
        Ok(view) => {
            let progress = Progress();
            view.serve_bytes("echo", (body) => body);
            view.serve_bytes_async("reverse_later", reverse_later);
            view.on<Report>("result", (msg) => {
                System.println(msg.text);
                if msg.text == "ready" {
                    let pushed: byte[] = [7, 8, 9];
                    view.emit_bytes("pushed", pushed);
                }
                if msg.text.starts_with("missing") {
                    progress.finished = true;
                    view.close();
                }
            });
            switch (view.load_html(page)) {
                Ok(_) => {},
                Err(e) => {
                    System.println(e.message());
                    return;
                },
            }
            Promise.start(watchdog(view, progress));
            view.run().await;
        },
        Err(e) => System.println(e.message()),
    }
}
