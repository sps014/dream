// Real parallel WebWorkers — thread-like spawn / join over a shared heap.
//
// Run natively:   dream run sample/webworker.dream

import system;
import system.text;
import system.json;
fun greet(name: string): string {
    return "hello, " + name + "!";
}

// A CPU-bound body: burn a few million iterations (so the work is really running off the main
// thread) and then transform the message.
fun work(input: string): string {
    let i = 0;
    while (i < 5000000) {
        i = i + 1;
    }
    return input.to_upper();
}

async fun main(): void {
    // 1) One-shot spawn / join.
    let g = WebWorker<string, string>.spawn("dream", greet);
    System.println(await g.join());
    g.terminate();

    // 2) Fan work out to several workers that run concurrently.
    let w1 = WebWorker<string, string>.spawn("alpha", work);
    let w2 = WebWorker<string, string>.spawn("beta", work);
    let w3 = WebWorker<string, string>.spawn("gamma", work);
    System.println(await w1.join());
    System.println(await w2.join());
    System.println(await w3.join());
    w1.terminate();
    w2.terminate();
    w3.terminate();
}
