// Real parallel WebWorkers — capture-only spawn over a shared heap.
//
// Run natively:   dream run sample/webworker.dream

import system;
import system.text;
import system.json;
fun greet(name: string): string {
    return "hello, " + name + "!";
}

fun work(input: string): string {
    let i = 0;
    while i < 5000000 {
        i = i + 1;
    }
    return input.to_upper();
}

async fun main(): void {
    System.println(await WebWorker.spawn(() => greet("dream")));

    let w1 = WebWorker.spawn(() => work("alpha"));
    let w2 = WebWorker.spawn(() => work("beta"));
    let w3 = WebWorker.spawn(() => work("gamma"));
    System.println(await w1);
    System.println(await w2);
    System.println(await w3);
}
