import system;
import system.collections;

let sink: int = 0;
let measuring: bool = true;
let counters_on: bool = System.env_or("DREAM_BENCH_COUNTERS", "") == "1";
let last_allocations: long = 0;
let last_retains: long = 0;
let last_releases: long = 0;

fun report(name: string, nanos: long, iters: int, checksum: int): void {
    let counters = "";
    if counters_on {
        let allocations = Debug.total_allocations;
        let retains = Debug.runtime_counter(3);
        let releases = Debug.runtime_counter(4);
        counters = " counters=allocs:"
            + (allocations - last_allocations)
            .to_string()
            + ",retain:"
            + (retains - last_retains)
            .to_string() + ",release:" + (releases - last_releases)
            .to_string();
        last_allocations = allocations;
        last_retains = retains;
        last_releases = releases;
    }
    if measuring {
        System.println(
            "bench "
                + name
                + " ns_total="
                + nanos.to_string()
                + " iters="
                + iters.to_string()
                + " ns_per_op="
                + (nanos / (long)iters)
                .to_string() + " checksum=" + checksum.to_string() + counters
        );
    }
    sink = sink + checksum;
}

fun fill(borrow map: Map<int, int>, count: int): void {
    let i = 0;
    while i < count {
        map[i] = i;
        i = i + 1;
    }
}

fun run_suite(): void {
    let count = 4096;
    let rounds = 64;
    let map = Map<int, int>(count);
    fill(map, count);
    let refill_nanos = 0L;
    let checksum = 0;
    let r = 0;
    while r < rounds {
        map.clear();
        let sw = Stopwatch();
        fill(map, count);
        sw.stop();
        refill_nanos = refill_nanos + sw.elapsed_nanos;
        checksum = checksum + map.length;
        r = r + 1;
    }
    report("map_refill_reserved", refill_nanos, rounds * count, checksum);

    // Batch clears amortize timer cost; refills happen outside every measured interval.
    let batch = 256;
    let maps = List<Map<int, int>>(batch);
    let i = 0;
    while i < batch {
        maps.push(Map<int, int>(1024));
        i = i + 1;
    }
    let clear_nanos = 0L;
    r = 0;
    while r < rounds {
        i = 0;
        while i < batch {
            fill(maps[i], 1024);
            i = i + 1;
        }
        let sw = Stopwatch();
        i = 0;
        while i < batch {
            maps[i].clear();
            i = i + 1;
        }
        sw.stop();
        clear_nanos = clear_nanos + sw.elapsed_nanos;
        r = r + 1;
    }
    checksum = 0;
    i = 0;
    while i < batch {
        checksum = checksum + maps[i].length;
        i = i + 1;
    }
    report("map_clear_reserved_batch", clear_nanos, rounds * batch, checksum);
}

fun main(): void {
    measuring = false;
    run_suite();
    measuring = true;
    let passes = int.parse(System.env_or("DREAM_BENCH_PASSES", "5")).unwrap_or(5);
    for (let p = 0; p < passes; p = p + 1) {
        run_suite();
    }
    System.println("sink " + sink.to_string());
}
