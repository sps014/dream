import system;
import system.collections;
import system.json;
import system.simd;
import system.text;

// Microbench suite for ARC / string / collection / allocator hot paths.
// Run: `dream --release run tests/bench/microbenches.dream`
// Or:  `./scripts/run-microbenches.sh` (optional C# compare when `dotnet` is available)
// Output lines: `bench <name> ns_total=<n> iters=<n> ns_per_op=<n>`
//
// Notes vs C# (`tests/bench/csharp`):
// - Dream executes under Wasm/wasmtime + ARC; C# is native JIT + GC.
// - `char_scan` is a `char_at` loop over UTF-16 units; `byte_scan` walks UTF-16 LE payload bytes.
// - `substring(start, end)` is start/end indices; C# uses (start, length).

let measuring: bool = true;

fun report(name: string, nanos: long, iters: int): void {
    if (measuring == false) {
        return;
    }
    let per = nanos / (long)iters;
    System.println(
        "bench " + name
            + " ns_total=" + nanos.to_string()
            + " iters=" + iters.to_string()
            + " ns_per_op=" + per.to_string()
    );
}

fun sink_int(x: int): int {
    return x;
}

fun sink_string(s: string): int {
    return s.byte_size();
}

fun bench_arc_locals(iters: int): void {
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let a = "n" + i.to_string();
        let b = a;
        let c = b;
        acc = acc + c.byte_size();
        i = i + 1;
    }
    sw.stop();
    report("arc_locals", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_string_concat(iters: int): void {
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let s = "hello" + i.to_string() + "world";
        acc = acc + s.byte_size();
        i = i + 1;
    }
    sw.stop();
    report("string_concat", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_string_eq(iters: int): void {
    let a = "abcdefghijklmnopqrstuvwxyz0123456789";
    let b = "abcdefghijklmnopqrstuvwxyz0123456789";
    let c = "abcdefghijklmnopqrstuvwxyz0123456780";
    let sw = Stopwatch();
    let hits = 0;
    let i = 0;
    while (i < iters) {
        if (a == b) {
            hits = hits + 1;
        }
        if (a == c) {
            hits = hits - 1;
        }
        i = i + 1;
    }
    sw.stop();
    report("string_eq", sw.elapsed_nanos(), iters);
    sink_int(hits);
}

// Linear UTF-16 code-unit walk (O(1) `char_at` per unit).
fun bench_char_scan(iters: int): void {
    let s = "The quick brown fox jumps over the lazy dog. 0123456789";
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let n = s.length;
        let bo = 0;
        while (bo < n) {
            let c = s.char_at(bo);
            acc = acc + (int)c;
            bo = bo + 1;
        }
        i = i + 1;
    }
    sw.stop();
    report("char_scan", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

// Raw UTF-16 LE payload walk.
fun bench_byte_scan(iters: int): void {
    let s = "The quick brown fox jumps over the lazy dog. 0123456789";
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let n = s.byte_size();
        let j = 0;
        while (j < n) {
            acc = acc + (int)s.byte_at(j);
            j = j + 1;
        }
        i = i + 1;
    }
    sw.stop();
    report("byte_scan", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_substring(iters: int): void {
    let s = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let sub = s.substring(5, 40);
        acc = acc + sub.byte_size();
        i = i + 1;
    }
    sw.stop();
    report("substring", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_list_push(iters: int): void {
    let sw = Stopwatch();
    let list = List<int>(iters);
    let i = 0;
    while (i < iters) {
        list.push(i);
        i = i + 1;
    }
    sw.stop();
    report("list_push", sw.elapsed_nanos(), iters);
    sink_int(list.length);
}

fun bench_list_insert_mid(iters: int): void {
    let n = 256;
    let rounds = iters / n;
    if (rounds < 1) {
        rounds = 1;
    }
    let sw = Stopwatch();
    let r = 0;
    while (r < rounds) {
        let list = List<int>(n);
        let i = 0;
        while (i < n) {
            list.insert(list.length / 2, i);
            i = i + 1;
        }
        r = r + 1;
    }
    sw.stop();
    report("list_insert_mid", sw.elapsed_nanos(), rounds * n);
}

fun bench_map_get_set(iters: int): void {
    let map = Map<int, int>(iters);
    let sw = Stopwatch();
    let i = 0;
    while (i < iters) {
        map.set(i, i * 3);
        i = i + 1;
    }
    let acc = 0;
    i = 0;
    while (i < iters) {
        acc = acc + map.get_or(i, 0);
        i = i + 1;
    }
    sw.stop();
    report("map_get_set", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_map_clear_reuse(iters: int): void {
    let map = Map<int, int>(1024);
    let rounds = 64;
    let per = iters / rounds;
    if (per < 1) {
        per = 1;
    }
    let sw = Stopwatch();
    let r = 0;
    while (r < rounds) {
        let i = 0;
        while (i < per) {
            map.set(i, i);
            i = i + 1;
        }
        map.clear();
        r = r + 1;
    }
    sw.stop();
    report("map_clear_reuse", sw.elapsed_nanos(), rounds * per);
    sink_int(map.capacity());
}

fun bench_alloc_churn(iters: int): void {
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let buf = Buffer.alloc<int>(64);
        buf[0] = i;
        acc = acc + buf[0];
        i = i + 1;
    }
    sw.stop();
    report("alloc_churn", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_list_clear_reuse(iters: int): void {
    let buf = List<int>(64);
    let rounds = 64;
    let per = iters / rounds;
    if (per < 1) {
        per = 1;
    }
    let sw = Stopwatch();
    let r = 0;
    while (r < rounds) {
        let i = 0;
        while (i < per) {
            buf.push(i);
            i = i + 1;
        }
        buf.clear();
        r = r + 1;
    }
    sw.stop();
    report("list_clear_reuse", sw.elapsed_nanos(), rounds * per);
    sink_int(buf.capacity());
}

// Index bump (no Span) — avoids retain/release on the backing array each iteration.
fun bench_scratch_arena(iters: int): void {
    let arena = ScratchArena<int>(1 << 14);
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let start = arena.bump(32);
        arena.set_at(start, i);
        acc = acc + arena.at(start);
        arena.reset();
        i = i + 1;
    }
    sw.stop();
    report("scratch_arena", sw.elapsed_nanos(), iters);
    sink_int(acc);
}
// Pike-VM find-all — pattern is intentionally NOT bare `\d+` (that hits a digit-run
// fast path and would benchmax the score).
fun bench_regex_find(iters: int): void {
    let re = Regex("[a-z]+\\d+", RegexFlags.Global);
    let hay = "abc123def456ghi789xyz";
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let m = re.match(hay);

        let j = 0;
        while (j < m.length) {
            acc = acc + m[j].byte_size();
            j = j + 1;
        }
        i = i + 1;
    }
    sw.stop();
    report("regex_find", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

@json
class BenchAddress {
    public city: string;
    public zip: string;

    public constructor(city: string, zip: string) {
        this.city = city;
        this.zip = zip;
    }
}

@json
class BenchUser {
    public name: string;
    public age: int;
    public active: bool;
    public address: BenchAddress;
    public tags: string[];
    public scores: int[];

    public constructor(name: string, age: int, active: bool, address: BenchAddress, tags: string[], scores: int[]) {
        this.name = name;
        this.age = age;
        this.active = active;
        this.address = address;
        this.tags = tags;
        this.scores = scores;
    }
}

fun bench_user(): BenchUser {
    return BenchUser("Ada", 36, true, BenchAddress("London", "NW1"), ["dev", "math"], [10, 20, 30]);
}

fun bench_json_serialize(iters: int): void {
    let u = bench_user();
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let text = Json.serialize(u);
        acc = acc + text.byte_size();
        i = i + 1;
    }
    sw.stop();
    report("json_serialize", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun bench_json_deserialize(iters: int): void {
    let text = Json.serialize(bench_user());
    let fallback = bench_user();
    let sw = Stopwatch();
    let acc = 0;
    let i = 0;
    while (i < iters) {
        let back = Json.deserialize<BenchUser>(text).unwrap_or(fallback);
        acc = acc + back.age + back.scores[2];
        i = i + 1;
    }
    sw.stop();
    report("json_deserialize", sw.elapsed_nanos(), iters);
    sink_int(acc);
}

fun checksum_floats(borrow a: float[]): int {
    let acc = 0;
    let i = 0;
    while (i < a.length) {
        acc = acc + (int)a[i];
        i = i + 1;
    }
    return acc;
}

fun checksum_ints(borrow a: int[]): int {
    let acc = 0;
    let i = 0;
    while (i < a.length) {
        acc = acc + a[i];
        i = i + 1;
    }
    return acc;
}

fun bench_arr_add(iters: int): void {
    let n = 256;
    let a = Buffer.alloc<float>(n);
    let b = Buffer.alloc<float>(n);
    let c = Buffer.alloc<float>(n);
    let ai = Buffer.alloc<int>(n);
    let bi = Buffer.alloc<int>(n);
    let ci = Buffer.alloc<int>(n);
    let k = 0;
    while (k < n) {
        a[k] = (float)k;
        b[k] = (float)(k + 1);
        ai[k] = k;
        bi[k] = k + 1;
        k = k + 1;
    }
    let sw = Stopwatch();
    let r = 0;
    while (r < iters) {
        let i = 0;
        while (i < n) {
            c[i] = a[i] + b[i];
            i = i + 1;
        }
        let j = 0;
        while (j < n) {
            ci[j] = ai[j] + bi[j];
            j = j + 1;
        }
        r = r + 1;
    }
    sw.stop();
    report("arr_add", sw.elapsed_nanos(), iters);
    sink_int(checksum_floats(c) + checksum_ints(ci));
}

fun bench_vec_add(iters: int): void {
    let n = 256;
    let a = Buffer.alloc<float>(n);
    let b = Buffer.alloc<float>(n);
    let c = Buffer.alloc<float>(n);
    let k = 0;
    while (k < n) {
        a[k] = (float)k;
        b[k] = (float)(k + 1);
        k = k + 1;
    }
    let lanes = Vector<float>.count();
    let sw = Stopwatch();
    let r = 0;
    while (r < iters) {
        let i = 0;
        while (i + lanes <= n) {
            let va = Vector<float>.load(a, i);
            let vb = Vector<float>.load(b, i);
            (va + vb).store(c, i);
            i = i + lanes;
        }
        while (i < n) {
            c[i] = a[i] + b[i];
            i = i + 1;
        }
        r = r + 1;
    }
    sw.stop();
    report("vec_add", sw.elapsed_nanos(), iters);
    sink_int(checksum_floats(c));
}

fun bench_string_builder(iters: int): void {
    let chunk = "abcdefghijklmnopqrstuvwxyz";
    let sw = Stopwatch();
    let sb = StringBuilder(iters * chunk.byte_size());
    let i = 0;
    while (i < iters) {
        sb.append(chunk);
        i = i + 1;
    }
    let built = sb.build();
    sw.stop();
    report("string_builder", sw.elapsed_nanos(), iters);
    sink_string(built);
}

fun run_suite(scale: int): void {
    bench_arc_locals(scale);
    bench_string_concat(scale);
    bench_string_eq(scale * 5);
    bench_char_scan(scale / 10);
    bench_byte_scan(scale / 10);
    bench_substring(scale);
    bench_list_push(scale);
    bench_list_insert_mid(scale);
    bench_map_get_set(scale);
    bench_map_clear_reuse(scale);
    bench_list_clear_reuse(scale);
    bench_alloc_churn(scale);
    bench_scratch_arena(scale);
    bench_regex_find(scale / 10);
    bench_string_builder(scale / 5);
    bench_json_serialize(scale / 10);
    bench_json_deserialize(scale / 10);
    bench_arr_add(scale / 10);
    bench_vec_add(scale / 10);
}

fun main(): void {
    let scale = 20000;
    // Warmup (discard): mirrors C# JIT warmup so ratios are not cold-vs-hot.
    measuring = false;
    run_suite(scale);
    measuring = true;
    run_suite(scale);
}
