import system;
import system.task;

let sink: long = 0L;

class PublicationNode {
    public value: int;
    public left: Option<PublicationNode>;
    public right: Option<PublicationNode>;

    public constructor(value: int, child: Option<PublicationNode>) {
        this.value = value;
        this.left = child;
        this.right = this.left;
    }
}

fun graph(size: int, seed: int): PublicationNode {
    let root = PublicationNode(seed, Option.None);
    for (let node = 1; node < size; node = node + 1) {
        root = PublicationNode(seed + node, Option.Some(root));
    }
    return root;
}

@noinline
fun read_graph(borrow root: PublicationNode): int {
    return root.value + root.left.unwrap().value + root.right.unwrap().value;
}

async fun handoff(borrow roots: List<PublicationNode>, width: int): int {
    return Task.scope<int, string>(
        async (scope) => {
            let checksum = 0;
            let jobs = List<TaskHandle<int, string>>(width);
            for (let index = 0; index < roots.length; index = index + width) {
                for (let slot = 0; slot < width; slot = slot + 1) {
                    let root = roots[index + slot];
                    jobs.push(scope.spawn_parallel<int>(() => read_graph(root)));
                }
                for (let slot = 0; slot < width; slot = slot + 1) {
                    checksum = checksum + jobs[slot].join().await?;
                }
                jobs.clear();
            }
            return Result.Ok(checksum);
        }
    ).await.unwrap();
}

async fun report(name: string, size: int, width: int, seed: int, measuring: bool): void {
    let iters = 128;
    let roots = List<PublicationNode>(iters);
    for (let i = 0; i < iters; i = i + 1) {
        roots.push(graph(size, seed + i));
    }

    let counters_on = System.env("DREAM_BENCH_COUNTERS").unwrap_or("") == "1";
    let before = counters_on ? Debug.runtime_counter(10) : 0L;
    let sw = Stopwatch();
    let checksum = handoff(roots, width).await;
    sw.stop();
    let visits = counters_on ? Debug.runtime_counter(10) - before : 0L;
    sink = sink + (long)checksum;
    if measuring {
        let counters = counters_on ? " counters=publish_visit:" + visits.to_string() : "";
        System.println(
            "bench "
                + name
                + " ns_total="
                + sw.elapsed_nanos.to_string()
                + " iters="
                + iters.to_string()
                + " ns_per_op="
                + (sw.elapsed_nanos / (long)iters)
                .to_string() + " checksum=" + checksum.to_string() + counters
        );
    }
}

async fun main(): void {
    let passes = int.parse(System.env("DREAM_BENCH_PASSES").unwrap_or("5")).unwrap_or(5);
    let seed = int.parse(System.env("DREAM_BENCH_SEED").unwrap_or("1")).unwrap_or(1) & 255;
    for (let pass = 0; pass <= passes; pass = pass + 1) {
        let measuring = pass > 0;
        report("publish_8_width_1", 8, 1, seed, measuring).await;
        report("publish_8_width_8", 8, 8, seed, measuring).await;
        report("publish_32_width_1", 32, 1, seed, measuring).await;
        report("publish_32_width_8", 32, 8, seed, measuring).await;
        report("publish_33_width_1", 33, 1, seed, measuring).await;
        report("publish_33_width_8", 33, 8, seed, measuring).await;
        report("publish_128_width_1", 128, 1, seed, measuring).await;
        report("publish_128_width_8", 128, 8, seed, measuring).await;
        report("publish_1024_width_1", 1024, 1, seed, measuring).await;
        report("publish_1024_width_8", 1024, 8, seed, measuring).await;
    }
    System.println("sink " + sink.to_string());
}
