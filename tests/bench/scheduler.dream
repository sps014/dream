import system;
import system.collections;

let sink: int = 0;
let measuring: bool = true;
let counters_on: bool = System.env_or("DREAM_BENCH_COUNTERS", "") == "1";
let last_allocations: long = 0;
let last_retains: long = 0;
let last_releases: long = 0;
let last_ready: long = 0;

fun report(name: string, nanos: long, iters: int, checksum: int): void {
    let counters = "";
    if counters_on {
        let allocations = Debug.total_allocations;
        let retains = Debug.runtime_counter(3);
        let releases = Debug.runtime_counter(4);
        let ready = Debug.runtime_counter(6);
        counters = " counters=allocs:"
            + (allocations - last_allocations)
            .to_string()
            + ",retain:"
            + (retains - last_retains)
            .to_string()
            + ",release:"
            + (releases - last_releases)
            .to_string() + ",ready_alloc:" + (ready - last_ready)
            .to_string();
        last_allocations = allocations;
        last_retains = retains;
        last_releases = releases;
        last_ready = ready;
    }
    if measuring {
        System.println(
            "bench "
                + name
                + " ns_total="
                + nanos.to_string()
                + " iters="
                + iters.to_string()
                + " ns_per_op="
                + (nanos / (long)iters)
                .to_string() + " checksum=" + checksum.to_string() + counters
        );
    }
    sink = sink + checksum;
}

async fun value(n: int): int {
    return n;
}

@noinline
async fun burst(n: int, iters: int): int {
    let total = 0;
    for (let round = 0; round < iters; round = round + 1) {
        let pending = Array.alloc<Future<int>>(n);
        for (let i = 0; i < n; i = i + 1) {
            pending[i] = value(i);
        }
        let results = Promise.all(pending).await;
        for (let i = 0; i < n; i = i + 1) {
            total = total + results[i];
        }
    }
    return total;
}

async fun run_suite(): void {
    let sw8 = Stopwatch();
    let v8 = burst(8, 1000).await;
    sw8.stop();
    report("ready_burst_8", sw8.elapsed_nanos, 1000, v8);
    let sw64 = Stopwatch();
    let v64 = burst(64, 500).await;
    sw64.stop();
    report("ready_burst_64", sw64.elapsed_nanos, 500, v64);
    let sw65 = Stopwatch();
    let v65 = burst(65, 500).await;
    sw65.stop();
    report("ready_burst_65", sw65.elapsed_nanos, 500, v65);
    let sw513 = Stopwatch();
    let v513 = burst(513, 100).await;
    sw513.stop();
    report("ready_burst_513", sw513.elapsed_nanos, 100, v513);
    let sw4096 = Stopwatch();
    let v4096 = burst(4096, 20).await;
    sw4096.stop();
    report("ready_burst_4096", sw4096.elapsed_nanos, 20, v4096);
}

async fun main(): void {
    measuring = false;
    run_suite().await;
    measuring = true;
    let passes = int.parse(System.env_or("DREAM_BENCH_PASSES", "5")).unwrap_or(5);
    for (let p = 0; p < passes; p = p + 1) {
        run_suite().await;
    }
    System.println("sink " + sink.to_string());
}
