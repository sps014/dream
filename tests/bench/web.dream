@noinline
async fun get_loop(client: HttpClient, url: string, iters: int): int {
    let total = 0;
    let target = Url.parse(url).unwrap();
    for (let i = 0; i < iters; i++) {
        let response = client.send(HttpRequest(HttpMethod.Get, target)).await.unwrap();
        total = total + response.status + response.read_text().await.unwrap().length;
        response.close();
    }
    return total;
}

@noinline
async fun echo_loop(client: HttpClient, url: string, iters: int): int {
    let total = 0;
    let target = Url.parse(url).unwrap();
    let body = Encoding.utf8_encode(Json.serialize(BenchPayload("bench", 42)));
    for (let i = 0; i < iters; i++) {
        let request = HttpRequest(HttpMethod.Post, target);
        request.headers.set("Content-Type", "application/json");
        request.body = body;
        let response = client.send(request).await.unwrap();
        total = total + response.status + response.read_text().await.unwrap().length;
        response.close();
    }
    return total;
}

async fun timed(name: string, client: HttpClient, url: string, iters: int): void {
    let sw = Stopwatch();
    let value = get_loop(client, url, iters).await;
    sw.stop();
    report(name, sw.elapsed_nanos, iters, value);
}

async fun run_suite(client: HttpClient, basic: string, routed: List<string>): void {
    timed("web_plaintext", client, basic + "/plain", 500).await;
    let sw = Stopwatch();
    let value = echo_loop(client, basic + "/echo", 500).await;
    sw.stop();
    report("web_json_echo", sw.elapsed_nanos, 500, value);
    timed("web_middleware_3", client, basic + "/layered", 500).await;
    timed("web_routes_10", client, routed[0] + "/n10/r9/7", 500).await;
    timed("web_routes_100", client, routed[1] + "/n100/r99/7", 500).await;
    timed("web_routes_1000", client, routed[2] + "/n1000/r999/7", 500).await;
}

async fun main(): void {
    let basic_app = WebApp();
    basic_app.include_router(BenchBasic.router()).unwrap();
    let basic = "http://127.0.0.1:" + basic_app.listen("127.0.0.1", 0).await.unwrap().to_string();
    let routed = List<string>();
    let app10 = WebApp();
    app10.include_router(BenchRoutes10.router()).unwrap();
    routed.push("http://127.0.0.1:" + app10.listen("127.0.0.1", 0).await.unwrap().to_string());
    let app100 = WebApp();
    app100.include_router(BenchRoutes100.router()).unwrap();
    routed.push("http://127.0.0.1:" + app100.listen("127.0.0.1", 0).await.unwrap().to_string());
    let app1000 = WebApp();
    app1000.include_router(BenchRoutes1000.router()).unwrap();
    routed.push("http://127.0.0.1:" + app1000.listen("127.0.0.1", 0).await.unwrap().to_string());
    let client = HttpClient();
    measuring = false;
    run_suite(client, basic, routed).await;
    measuring = true;
    let passes = int.parse(System.env("DREAM_BENCH_PASSES").unwrap_or("5")).unwrap_or(5);
    for (let p = 0; p < passes; p = p + 1) {
        run_suite(client, basic, routed).await;
    }
    client.close().unwrap();
    basic_app.shutdown();
    app10.shutdown();
    app100.shutdown();
    app1000.shutdown();
    System.println("sink " + sink.to_string());
}
