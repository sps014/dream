import system;
import system.webapi;
import system.net;
import system.json;

let sink: int = 0;
let measuring: bool = true;
let counters_on: bool = System.env("DREAM_BENCH_COUNTERS").unwrap_or("") == "1";
let last_allocations: long = 0;

fun report(name: string, nanos: long, iters: int, checksum: int): void {
    let counters = "";
    if counters_on {
        let allocations = Debug.total_allocations;
        counters = " counters=allocs:" + (allocations - last_allocations).to_string();
        last_allocations = allocations;
    }
    if measuring {
        System.println(
            "bench "
                + name
                + " ns_total="
                + nanos.to_string()
                + " iters="
                + iters.to_string()
                + " ns_per_op="
                + (nanos / (long)iters).to_string()
                + " checksum="
                + checksum.to_string()
                + counters
        );
    }
    sink = sink + checksum;
}

@json
class BenchPayload {
    public name: string;
    public count: int;

    public constructor(name: string, count: int) {
        this.name = name;
        this.count = count;
    }
}

async fun bench_layer(ctx: RequestContext, next: Next): HttpOutgoing {
    ctx.set("layers", ctx.get("layers").unwrap_or("") + "x");
    return next.call().await;
}

@router("")
class BenchBasic {
    @get("/plain")
    public static fun plain(): string {
        return "hello";
    }

    @post("/echo")
    public static fun echo(@body payload: BenchPayload): BenchPayload {
        return payload;
    }

    @use(bench_layer)
    @use(bench_layer)
    @use(bench_layer)
    @get("/layered")
    public static fun layered(ctx: RequestContext): string {
        return ctx.get("layers").unwrap_or("");
    }
}

