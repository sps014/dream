import system;
import system.task;

let sink: int = 0;
let measuring: bool = true;
let counters_on: bool = System.env_or("DREAM_BENCH_COUNTERS", "") == "1";
let last_allocations: long = 0;
let last_retains: long = 0;
let last_releases: long = 0;
let last_ready: long = 0;
let last_jobs: long = 0;

fun report(name: string, nanos: long, iters: int, checksum: int): void {
    let counters = "";
    if counters_on {
        let allocations = Debug.total_allocations;
        let retains = Debug.runtime_counter(3);
        let releases = Debug.runtime_counter(4);
        let ready = Debug.runtime_counter(6);
        let jobs = Debug.runtime_counter(9);
        counters = " counters=allocs:" + (allocations - last_allocations).to_string()
            + ",retain:" + (retains - last_retains).to_string()
            + ",release:" + (releases - last_releases).to_string()
            + ",ready_alloc:" + (ready - last_ready).to_string()
            + ",worker_job_alloc:" + (jobs - last_jobs).to_string();
        last_allocations = allocations;
        last_retains = retains;
        last_releases = releases;
        last_ready = ready;
        last_jobs = jobs;
    }
    if measuring {
        System.println("bench " + name + " ns_total=" + nanos.to_string()
            + " iters=" + iters.to_string() + " ns_per_op=" + (nanos / (long)iters).to_string()
            + " checksum=" + checksum.to_string() + counters);
    }
    sink = sink + checksum;
}

@noinline
async fun pool_jobs(size: int, iters: int): int {
    let pool = TaskPool(size);
    let total = 0;
    for (let i = 0; i < iters; i = i + 1) {
        let value = i & 15;
        total = total + pool.dispatch(() => value * value).await;
    }
    pool.shutdown();
    return total;
}
@noinline
async fun sessions(iters: int): int {
    let total = 0;
    for (let i = 0; i < iters; i = i + 1) {
        let pool = TaskPool(1);
        total = total + pool.dispatch(() => 7).await;
        pool.shutdown();
    }
    return total;
}
async fun run_suite(): void {
    let sw = Stopwatch(); let v = pool_jobs(1, 1000).await; sw.stop();
    report("worker_pool_1", sw.elapsed_nanos, 1000, v);
    sw = Stopwatch(); v = pool_jobs(8, 1000).await; sw.stop();
    report("worker_pool_8", sw.elapsed_nanos, 1000, v);
    sw = Stopwatch(); v = pool_jobs(64, 1024).await; sw.stop();
    report("worker_pool_64", sw.elapsed_nanos, 1024, v);
    sw = Stopwatch(); v = sessions(100).await; sw.stop();
    report("worker_sessions", sw.elapsed_nanos, 100, v);
}
async fun main(): void {
    measuring = false;
    run_suite().await;
    measuring = true;
    let passes = int.parse(System.env_or("DREAM_BENCH_PASSES", "5")).unwrap_or(5);
    for (let p = 0; p < passes; p = p + 1) { run_suite().await; }
    System.println("sink " + sink.to_string());
}
