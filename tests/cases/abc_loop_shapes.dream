// Loop shapes whose index accesses the bounds-check eliminator proves in range: they must
// still compute exactly what the checked code does.
import system;
import system.collections;

fun sum_down(a: int[]): int {
    let total = 0;
    let i = a.length - 1;
    while i >= 0 {
        total = total + a[i];
        i = i - 1;
    }
    return total;
}

fun sum_inclusive(a: int[]): int {
    let total = 0;
    let last = a.length - 1;
    let i = 0;
    while i <= last {
        total = total + a[i];
        i = i + 1;
    }
    return total;
}

fun sum_prefix(a: int[], n: int): int {
    let total = 0;
    for (let i = 0; i < n; i++) {
        total = total + a[i];
    }
    return total;
}

fun main(): void {
    let a: int[] = [3, 1, 4, 1, 5, 9, 2, 6];
    System.println(sum_down(a));
    System.println(sum_inclusive(a));
    System.println(sum_prefix(a, 5));
    System.println(sum_prefix(a, 0));

    let empty: int[] = [];
    System.println(sum_down(empty));
    System.println(sum_inclusive(empty));

    let xs = List<int>();
    for (let i = 0; i < 10; i++) {
        xs.push(i * i);
    }
    System.println(xs.length);
    System.println(xs[3]);
    xs[3] = 100;
    System.println(xs[3]);
    System.println(xs.pop());
    System.println(xs.contains(49));
    System.println(xs.index_of(25));
    xs.reverse();
    System.println(xs.join(","));
    System.println(xs.slice(1, 4).join(","));
    System.println(xs.concat(xs.slice(0, 2)).length);
    xs.remove_at(0);
    System.println(xs.to_string());
    xs.clear();
    System.println(xs.length);
    xs.push(7);
    System.println(xs[0]);

    let q = Queue<string>();
    q.enqueue("a");
    q.enqueue("b");
    q.enqueue("c");
    System.println(q.dequeue());
    q.enqueue("d");
    System.println(q.peek());
    System.println(q.length);
}
