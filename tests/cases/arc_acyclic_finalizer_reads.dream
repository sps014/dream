import system;

class ReadSelf {
    public id: int;
    public constructor(id: int) { this.id = id; }
    del() {
        System.println(this.id);
        System.println(this.id);
    }
}

@noinline
fun destroy(): void {
    let value = ReadSelf(7);
}

fun main(): void {
    destroy();
    System.println("after");
}
