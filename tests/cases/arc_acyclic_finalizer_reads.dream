import system;

class ReadSelf {
    public id: int;
    public constructor(id: int) { this.id = id; }
    del() {
        let alias = this;
        System.println(alias.id);
        let temporary = Option.Some(this);
        switch (temporary) {
            Some(peer) => { System.println(peer.id); }
            None => {}
        }
    }
}

@noinline
fun destroy(): void {
    let value = ReadSelf(7);
}

fun main(): void {
    destroy();
    System.println("after");
}
