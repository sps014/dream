// Comprehensive ARC coverage. Uses the `Debug.*` allocator probes to assert,
// at runtime, that every allocation pattern is reference-counted correctly:
//   * ref_count()        - retain/release arithmetic on shared values
//   * live_objects()     - net live blocks (leak detection)
//   * heap_ptr()         - heap high-water mark (block reuse vs. growth)
//   * free_list_head()   - reclaimed-block freelist
//
// The destructor prints make reclamation order observable for the `del()` cases.

import system;
@allow_cycle
class Node {
    public val: int;
    public next: Option<Node>;

    public constructor(val: int, next: Option<Node>) {
        this.val = val;
        this.next = next;
    }
}

class Holder {
    public item: Option<Node>;
    public label: string;

    public constructor(item: Option<Node>, label: string) {
        this.item = item;
        this.label = label;
    }
}

class Tracked {
    public id: int;

    public constructor(id: int) {
        this.id = id;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

// --- Allocation patterns, each self-contained so everything is released at scope exit. ---

fun build_chain(): Node {
    let no_next: Option<Node> = Option.None;
    let head = Node(1, no_next);
    let n3 = Node(3, no_next);
    let n2 = Node(2, Option.Some(n3));
    head.next = Option.Some(n2);
    return head;
}

fun struct_array() {
    let no_next: Option<Node> = Option.None;
    let xs = [Node(1, no_next), Node(2, no_next), Node(3, no_next)];
    let total = 0;
    let i = 0;
    while i < 3 {
        total = total + xs[i].val;
        i = i + 1;
    }
}

fun string_array() {
    let names = ["alpha", "beta", "gamma"];
    let _joined = names[0] + "-" + names[1] + "-" + names[2];
}

fun nested_array() {
    let grid = [[1, 2], [3, 4], [5, 6]];
    let _sum = grid[0][0] + grid[2][1];
}

fun string_builder() {
    let s = "";
    let i = 0;
    while i < 5 {
        s = s + "x" + i.to_string();
        i = i + 1;
    }
}

fun field_reassign() {
    let no_next: Option<Node> = Option.None;
    let h = Holder(Option.Some(Node(1, no_next)), "first");
    h.item = Option.Some(Node(2, no_next));
    h.label = "second";
}

fun local_reassign() {
    let no_next: Option<Node> = Option.None;
    let _n = Node(0, no_next);
    let i = 1;
    while i <= 4 {
        _n = Node(i, no_next);
        i = i + 1;
    }
}

fun nullable_paths() {
    let no_next: Option<Node> = Option.None;
    let _a: Option<Node> = Option.None;
    let b: Option<Node> = Option.Some(Node(7, no_next));
    _a = b;
    b = Option.None;
}

fun pass_borrow(borrow n: Node): int {
    return n.val;
}

fun branchy(flag: bool) {
    let no_next: Option<Node> = Option.None;
    if flag {
        let _x = Node(1, no_next);
    } else {
        let _y = Holder(Option.Some(Node(2, no_next)), "branch");
    }
}

// A single tracked object per scope so its `del()` runs (and prints) in a deterministic order
// driven by the call sequence rather than by intra-scope local-release order.
fun drop_one(id: int) {
    let _t = Tracked(id);
}

// Every pattern in one unit of work; nothing escapes.
fun stress() {
    let chain = build_chain();
    let _borrowed = pass_borrow(chain);
    struct_array();
    string_array();
    nested_array();
    string_builder();
    field_reassign();
    local_reassign();
    nullable_paths();
    branchy(true);
    branchy(false);
}

// --- Targeted reference-count assertions. ---

fun check_ref_counts() {
    let no_next: Option<Node> = Option.None;
    let n = Node(1, no_next);
    System.println("rc.fresh=" + Debug.ref_count(n).to_string());

    let alias = n;
    System.println("rc.aliased=" + Debug.ref_count(n).to_string());

    let h = Holder(Option.Some(n), "held");
    // Keep `h` live across the probes; last-use destroy would otherwise release it immediately.
    System.println("rc.in_field=" + Debug.ref_count(n).to_string());

    // `alias` must appear in a storing context so it is not an RC cursor (unused forwarding
    // copies skip retain). The array still holds two refs to the same node.
    let arr = [n, alias];
    System.println("rc.in_array=" + Debug.ref_count(n).to_string());
    System.println(h.label);
    System.println(arr.length.to_string());
}

// --- Deterministic reclamation for owned values that are not direct constructor calls. ---

class Factory {
    public base: int;

    public constructor(base: int) {
        this.base = base;
    }

    public fun create(n: int): Tracked {
        return Tracked(this.base + n);
    }
}

class Named {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }

    del() {
        System.print("bye ");
        System.println(this.name);
    }
}

fun make(id: int): Tracked {
    return Tracked(id);
}

fun make_named(n: string): Named {
    return Named(n);
}

fun consume(t: Tracked) {
    System.print("consume ");
    System.println(t.id);
}

// Factory result bound to a single local: dropped at scope exit.
fun use_once(id: int) {
    let a = make(id);
    System.print("use ");
    System.println(a.id);
}

// Reassigning a local with fresh factory results drops the previous value each time.
fun loop_reassign() {
    let _t = make(0);
    let i = 1;
    while i <= 3 {
        _t = make(i);
        i = i + 1;
    }
}

fun method_factory() {
    let f = Factory(10);
    let m = f.create(5);
    System.println(m.id);
}

// Freeing a class that owns a string field must not corrupt the interned literal.
fun ref_field() {
    let x = make_named("Zaphod");
    System.println(x.name);
}

// An owned temporary passed straight into a call is reclaimed after the call returns.
fun arg_temp() {
    consume(make(5));
}

fun factories() {
    use_once(1);
    System.println(0);
    loop_reassign();
    System.println(0);
    method_factory();
    System.println(0);
    ref_field();
    System.println(0);
    arg_temp();
    System.println(0);
}

// --- Indexed loads retain: every live owner adds one to the reference count. ---
//   after store:        w(1) + slot(2)              -> 2
//   after first read:   w + slot + x                -> 3
//   after second read:  w + slot + x + y            -> 4
//   after overwrite:    slot released; w + x + y    -> 3

class Widget {
    public id: int;
    public constructor(id: int) { this.id = id; }
}

fun slot_read_retains() {
    let w = Widget(7);
    let arr = Array.alloc<Widget>(4);
    arr[0] = w;
    System.println(Debug.ref_count(w));
    let x = arr[0];
    System.println(Debug.ref_count(x));
    let y = arr[0];
    System.println(Debug.ref_count(y));
    arr[0] = Widget(99);
    System.println(Debug.ref_count(w));
}

// --- Last use of a glue struct local transfers nested counts; a live copy still retains. ---

class Leaf {
    public constructor() {}
}

struct Wrap {
    public n: Leaf;
    public constructor(n: Leaf) {
        this.n = n;
    }
}

fun take(w: Wrap): void {
    System.println(Debug.ref_count(w.n).to_string());
}

fun take_leaf(x: Leaf): void {
    System.println(Debug.ref_count(x).to_string());
}

fun struct_last_use_move() {
    let a = Wrap(Leaf());
    take(a);

    let b = Wrap(Leaf());
    let c = b;
    take(b);
    take(c);

    let d = Wrap(Leaf());
    take_leaf(d.n);
    take(d);
}

fun main() {
    factories();
    slot_read_retains();
    struct_last_use_move();
    check_ref_counts();

    // Warm up so the freelist/heap reach steady state, then capture the baseline.
    let w = 0;
    while w < 20 {
        stress();
        w = w + 1;
    }
    let base_live = Debug.live_objects;
    let base_heap = Debug.heap_ptr;
    let base_free = Debug.free_list_head;

    let i = 0;
    while i < 100 {
        stress();
        i = i + 1;
    }

    let end_live = Debug.live_objects;
    let end_heap = Debug.heap_ptr;
    let end_free = Debug.free_list_head;

    System.println("live_delta=" + (end_live - base_live).to_string());
    System.println("heap_grew=" + (end_heap - base_heap > 0).to_string());
    System.println("free_stable=" + (base_free == end_free).to_string());

    // Destructor execution + ordering, driven by the call sequence.
    drop_one(1);
    drop_one(2);
    System.println("done");
}
