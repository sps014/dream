// Module-level class `let` reassignment must retain a still-live RHS and release the old occupant.
import system;
class Tracked {
    public id: int;

    public constructor(id: int) {
        this.id = id;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

struct Holder {
    public item: Tracked;

    public constructor(item: Tracked) {
        this.item = item;
    }
}

struct Inner {
    public item: Tracked;

    public constructor(item: Tracked) {
        this.item = item;
    }
}

struct Outer {
    public inner: Inner;

    public constructor(inner: Inner) {
        this.inner = inner;
    }
}

let slot: Tracked = Tracked(0);
let value_slot: Holder = Holder(Tracked(10));

// Overwriting a value `struct` (global or field) must drop nested RC fields of the old bits.
fun value_nested_reassign() {
    value_slot = Holder(Tracked(11));
    System.println("g");
    let o = Outer(Inner(Tracked(20)));
    o.inner = Inner(Tracked(21));
    System.println("o");
}

fun wrap(t: Tracked): Tracked {
    return Tracked(t.id + 10);
}

fun same(t: Tracked): Tracked {
    return t;
}

fun main() {
    value_nested_reassign();
    slot = Tracked(1);
    System.println("a");
    let x = Tracked(2);
    slot = x;
    System.println(x.id);
    System.println(slot.id);
    slot = Tracked(3);
    System.println("b");
    let y = Tracked(4);
    slot = y;
    slot = Tracked(5);
    System.println("c");
    slot = wrap(slot);
    System.println("d");
    slot = same(slot);
    System.println("e");
}
