// `await` may appear in *any* control-flow position — inside a branch, a loop body, a loop
// condition, a `for-in` body, a `switch` arm, a ternary arm, and the right operand of `&&`/`??`.
// The coroutine transform lowers the whole body to a CFG state machine where each `await` is a
// suspend point, so each of these resumes correctly (including a loop that suspends every iteration).

import system;
async fun g(n: int): int { return n; }
async fun ready(): bool { return true; }

async fun in_branch(b: int): int {
    let acc = 0;
    if b == 2 { acc = acc + g(3).await; }     // `.await` inside a branch body
    else { acc = acc + g(7).await; }
    return acc;
}

async fun in_loop(): int {
    let sum = 0;
    let i = 0;
    while i < 4 { sum = sum + g(i).await; i = i + 1; }   // `.await` every iteration
    return sum;                                            // 0+1+2+3 = 6
}

async fun in_foreach(): int {
    let xs: int[] = [1, 2, 3];
    let total = 0;
    for (let x in xs) { total = total + g(x * 2).await; }  // `.await` inside for-in
    return total;                                          // 2+4+6 = 12
}

async fun in_switch(n: int): int {
    switch (n) {
        case 0:
            return g(100).await;
        default:
            return g(200).await;
    }
    return -1;
}

async fun in_ternary(flag: bool): int {
    let v = flag ? g(7).await : g(9).await;     // `.await` in a ternary arm
    return v;
}

async fun in_shortcircuit(flag: bool): bool {
    let ok = flag && ready().await;             // `.await` in the right operand of `&&`
    return ok;
}

async fun main(): void {
    System.println(in_branch(2).await);         // 3
    System.println(in_branch(5).await);         // 7
    System.println(in_loop().await);            // 6
    System.println(in_foreach().await);         // 12
    System.println(in_switch(0).await);         // 100
    System.println(in_switch(1).await);         // 200
    System.println(in_ternary(true).await);     // 7
    System.println(in_shortcircuit(true).await); // true
}
