import system;
async fun work(id: int): int {
    Time.sleep(50).await;
    return id * id;
}

async fun main(): void {
    let a = work(2);
    let b = work(3);
    let results = Promise.all([a, b]).await;
    System.println(results[0] + ", " + results[1]);

    let first = Promise.any([work(10), work(20)]).await;
    System.println("first = " + first);
}
