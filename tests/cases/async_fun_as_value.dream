import system;
async fun delayed_triple(n: int): int {
    Time.sleep(1).await;
    return n * 3;
}

async fun run(f: fun(int): Future<int>, v: int): int {
    return f(v).await;
}

async fun main(): void {
    let f: fun(int): Future<int> = delayed_triple;
    System.println(f(7).await);
    System.println(run(delayed_triple, 4).await);
}
