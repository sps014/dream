// Async methods on a generic class: each monomorphization (`Cell<int>`, `Cell<string>`) regenerates
// its own async state machine, so awaiting a generic method resolves with the concrete type.
import system;
class Cell<T> {
    public value: T;
    public constructor(value: T) { this.value = value; }

    public async fun get(): T {
        Time.sleep(10).await;
        return this.value;
    }
}

async fun main(): void {
    let a = Cell<int>(42);
    let ra = a.get().await;
    System.println(ra);

    let b = Cell<string>("hello");
    let rb = b.get().await;
    System.println(rb);
}
