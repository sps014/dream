import system;

// A generic async callee must still advertise sink params at the call site so a live
// class argument is retained across the suspend (otherwise the poll frame releases it).
class Handle {
    public id: int;
}

async fun id_of<T>(h: Handle, _t: T): int {
    Time.sleep(0).await;
    return h.id;
}

async fun main(): void {
    let h = Handle();
    h.id = 7;
    let a = id_of(h, 1).await;
    let b = id_of(h, 2).await;
    System.println(a);
    System.println(b);
    System.println(h.id);
}
