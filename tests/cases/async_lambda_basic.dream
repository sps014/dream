import system;
async fun apply_async(f: fun(int): Future<int>, v: int): int {
    return f(v).await;
}

async fun main(): void {
    let twice: fun(int): Future<int> = async (x) => {
        Time.sleep(1).await;
        return x * 2;
    };
    System.println(twice(21).await);
    System.println(apply_async(async (n) => n + 100, 1).await);
}
