import system;
class Worker {
    public base: int;

    public constructor(base: int) {
        this.base = base;
    }

    public async fun compute(n: int): int {
        Time.sleep(10).await;
        return this.base + n;
    }

    public async fun twice(n: int): int {
        let once = this.compute(n).await;
        return once + once;
    }
}

async fun main(): void {
    let w = Worker(100);
    let r = w.compute(5).await;
    System.println(r);

    let t = w.twice(1).await;
    System.println(t);
}
