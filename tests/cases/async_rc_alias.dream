// Regression: async bodies must keep aliases live across awaits. Under GC, a forced
// collection after `run` completes should reclaim `Tracked` without trapping.
// `live_delta=1` is the still-held `run` Future handle inside `main` (freed at main complete).

import system;
class Tracked {
    public id: int;

    public constructor(id: int) {
        this.id = id;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

async fun use_alias(t: Tracked): int {
    let a = t;
    let b = a;
    await Time.sleep(0);
    return a.id + b.id;
}

async fun run(): void {
    let t = Tracked(3);
    let n = await use_alias(t);
    System.println(n);
}

async fun main(): void {
    let base = Debug.live_objects();
    await run();
    Debug.gc_collect();
    System.println("live_delta=" + (Debug.live_objects() - base).to_string());
}
