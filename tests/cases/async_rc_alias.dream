// Regression: async bodies must retain on aliasing copies. Without poll RcInsertion,
// `let b = a` shares one count and completion bulk-released both → double-free.
// After await, the Future is released at resume (`live_delta=0`).

import system;
class Tracked {
    public id: int;

    public constructor(id: int) {
        this.id = id;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

async fun use_alias(t: Tracked): int {
    let a = t;
    let b = a;
    await Time.sleep(0);
    return a.id + b.id;
}

async fun run(): void {
    let t = Tracked(3);
    let n = await use_alias(t);
    System.println(n);
}

async fun main(): void {
    let base = Debug.live_objects;
    await run();
    System.println("live_delta=" + (Debug.live_objects - base).to_string());
}
