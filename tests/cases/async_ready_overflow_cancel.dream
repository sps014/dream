import system;

async fun value(n: int): int { return n; }

async fun main(): void {
    let pending = Buffer.alloc<Future<int>>(512);
    for (let i = 0; i < pending.length; i = i + 1) {
        pending[i] = value(i);
        Promise.start(pending[i]);
    }
    for (let i = 0; i < pending.length; i = i + 2) { Promise.cancel(pending[i]); }
    let results = Promise.all(pending).await;
    let sum = 0;
    for (let i = 0; i < results.length; i = i + 1) { sum = sum + results[i]; }
    System.println(sum);
}
