// A non-repeatable attribute may not be written twice on the same declaration.
import system;
class Foo {
    x: int;

    @inline
    @inline
    public fun n(): int {
        return this.x;
    }

    public constructor(x: int) {
        this.x = x;
    }
}

fun main() {
    let f = Foo(1);
    System.println(f.n());
}
