// A `byte[]` passes its first element's address; `Option<CPtr>` maps NULL to `None`.
import system;

@c("c", "memchr")
extern fun memchr(hay: byte[], needle: int, n: long): Option<CPtr>;

fun main(): void {
    let data: byte[] = [104, 105, 33];
    let hit = memchr(data, 33, 3L);
    System.println(hit.is_some());
    System.println(memchr(data, 120, 3L).is_none());
    let empty: byte[] = [];
    System.println(memchr(empty, 104, 0L).is_none());
}
