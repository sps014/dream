import system;
import system.io;

async fun main(): void {
    let src = CancellationSource();
    src.cancel();
    let tok = src.token;
    let opt = Option.Some(tok);

    switch (File.read("missing.txt", opt).await) {
        Ok(t) => System.println(t),
        Err(e) => System.println(e.code()),
    }

}
