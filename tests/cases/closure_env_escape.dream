// Escaping a capturing fun then dropping the last reference reclaims box + env.

import system;
fun make_adder(n: int): fun(int): int {
    return (x) => x + n;
}

fun main(): void {
    let _warm: fun(int): int = make_adder(0);
    _warm = make_adder(0);
    let base = Debug.live_objects;

    let _held: fun(int): int = make_adder(7);
    let mid = Debug.live_objects - base;
    _held = make_adder(0);
    _held = make_adder(0);
    let after = Debug.live_objects - base;

    System.println("held_delta=" + mid.to_string());
    System.println("after_reassign=" + after.to_string());
}
