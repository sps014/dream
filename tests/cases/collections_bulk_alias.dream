import system;
import system.collections;

fun main(): void {
    let xs = List<int>(8);
    for (let i = 0; i < 8; i = i + 1) { xs.push(i); }
    let view = xs.as_span();
    xs.push_all(view.to_array());
    xs.reserve(4096);
    System.println(xs.length);
    System.println(xs.capacity >= 4096);
    System.println(xs[15]);
    System.println(view[7]);
    view[0] = 99;
    System.println(xs[0]);

    let names = List<string>(8);
    names.push("one");
    names.push("two");
    let old = names.as_read_only_span();
    names.push_all(["three", "four", "five", "six", "seven", "eight", "nine"]);
    names.clear();
    System.println(old[0]);
    System.println(old[1]);
}
