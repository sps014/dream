import system;
import system.gpu;

// Histogram-style atomic increment (WGSL atomicAdd on the native/browser GPU host).
@compute(64)
fun hist(data: GpuBuffer<int>, bins: GpuBuffer<int>, n: int): void {
    let i = global_id.x;
    if i < n {
        let v = data[i];
        if v >= 0 && v < bins.length {
            let _ = Gpu.atomic_add(bins, v, 1);
        }
    }
}

async fun main(): void {
    let init = Gpu.try_init().await;
    if init.is_err() {
        System.println("gpu unavailable");
        return;
    }
    let data = GpuBuffer<int>.from([0, 1, 0, 2, 1]);
    let bins = GpuBuffer<int>.from([0, 0, 0]);
    let r = Compute.run_resources(
        "hist",
        [data.id, bins.id],
        Buffer.alloc<int>(0),
        Buffer.alloc<int>(0),
        5,
        1,
        1,
        Uniforms.pack_i32([5])
    ).await;
    if r.is_err() {
        System.println("dispatch failed");
        return;
    }
    let rb = bins.read().await;
    System.println(rb[0]);
    System.println(bins.length);
}
