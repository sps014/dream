import system;

class Box {
    public value: int;
    public constructor(value: int) { this.value = value; }
}

fun identity<T>(value: T): T { return value; }

fun main(): void {
    let result = identity<int>(0);
    for (let i = 0; i < 0; i++) {
        if (i % 2 == 0) { result += i; } else { result -= i; }
    }
    let box = Box(result);
    result = box.value;
    result = result;
    System.println(result);
}
