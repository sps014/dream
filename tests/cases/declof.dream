import system;
import system.json;

class User {
    public name: string;
    public constructor(name: string) { this.name = name; }
    public fun greet(): string { return "hi " + this.name; }
}

fun helper(): int {
    return 1;
}

fun main(): void {
    System.println(declof(User));
    System.println(declof(User.greet));
    System.println(declof(helper));
    System.println(declof(Json.serialize));
    System.println(declof(List));
}
