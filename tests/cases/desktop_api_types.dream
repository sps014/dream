import system;
import system.desktop;

// Touches the whole system.desktop surface headless: dialogs are configured but never shown,
// and the clipboard / shell calls sit behind an argument the corpus never passes.
async fun live(): void {
    Clipboard.text = "text";
    Clipboard.html = "<b>html</b>";
    let png: byte[] = [137, 80, 78, 71];
    Clipboard.image = png;
    Clipboard.files = ["/tmp/a.txt"];
    Clipboard.set_data("application/x-dream-test", png);
    let text: string = Clipboard.text;
    let html: string = Clipboard.html;
    let image: byte[] = Clipboard.image;
    let files: List<string> = Clipboard.files;
    let formats: List<string> = Clipboard.formats;
    let data: Option<byte[]> = Clipboard.data("application/x-dream-test");
    let has: bool = Clipboard.has("text/plain");
    Clipboard.clear();
    System.println($"{text}{html}{image.length}{files.length}{formats.length}{data.is_some()}{has}");

    switch (Shell.open("https://example.com")) {
        Ok(_) => {},
        Err(e) => System.println($"{e.message()} {e.code()}"),
    }

    let files_dialog = FileDialog();
    let one: Option<string> = files_dialog.pick_file().await;
    let many: List<string> = files_dialog.pick_files().await;
    let folder: Option<string> = files_dialog.pick_folder().await;
    let folders: List<string> = files_dialog.pick_folders().await;
    let target: Option<string> = files_dialog.save_file().await;
    System.println($"{one.is_some()}{many.length}{folder.is_some()}{folders.length}{target.is_some()}");

    let result: MessageResult = MessageDialog().show().await;
    Dialog.alert("hi").await;
    let yes: bool = Dialog.confirm("sure?").await;
    System.println($"{result} {yes}");
}

async fun main(): void {
    let dialog = FileDialog();
    dialog.title = "Open";
    dialog.directory = "/tmp";
    dialog.file_name = "notes.txt";
    dialog.parent = 7;
    dialog.add_filter("Images", ["png", "jpg"]);
    dialog.add_filter("Text", ["txt"]);
    System.println($"{dialog.title} {dialog.directory} {dialog.file_name} {dialog.parent}");
    for (let f in dialog.filters) {
        System.println($"{f.name}: {f.extensions.join(",")}");
    }

    let message = MessageDialog();
    System.println($"{message.level} {message.buttons}");
    message.title = "Title";
    message.text = "Body";
    message.level = MessageLevel.Error;
    message.buttons = MessageButtons.YesNoCancel;
    message.parent = 3;
    System.println($"{message.title} {message.text} {message.level} {message.buttons} {message.parent}");
    System.println($"{MessageResult.Ok} {MessageResult.Cancel} {MessageResult.Yes} {MessageResult.No}");

    if System.args.length > 99 {
        live().await;
    }
    System.println("done");
}
