// `@export` functions must have a C-compatible, uniquely named signature.
@export fun generic<T>(x: T): T { return x; }
@export async fun pending(): int { return 1; }
@export fun dream_retain(): void {}
@export fun duplicated(x: int): int { return x; }
@export fun duplicated(x: long): long { return x; }

@export
fun scale(value: float16): float16 {
    return value;
}

fun main(): void {}
