import system;

interface Speaker {
    fun speak(): string;
}

class Dog : Speaker {
    public fun speak(): string {
        return "woof";
    }
}

class Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

class Partial {
    public who: Speaker;
    public cb: fun(int): int;

    public constructor(flag: bool) {
        if flag {
            this.who = Dog();
        }
        this.cb = (n: int) => n * 2;
    }
}

class NoCtor {
    public at: Point;
}

class Good {
    public who: Speaker;
    public at: Point;

    public constructor() {
        this.who = Dog();
        this.at = Point(1, 2);
    }
}

fun main(): void {
    let p = Partial(true);
    let a = NoCtor();
    let g = Good();
    System.println(a.at.x.to_string());
    System.println(g.who.speak());
}
