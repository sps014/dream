// Exercises the File API end-to-end under the native c harness: write, append, read back,
// then delete. The host functions are linked in tests/e2e_tests.rs (src/execution/host.rs).
import system;
import system.io;
async fun main(): void {
    let path = "dream_file_io_e2e.tmp";
    File.write(path, "hello\n").await;
    File.append(path, "dream").await;
    let text = File.read(path).await;
    System.print(text.unwrap_or(""));
    File.delete(path).await;
}
