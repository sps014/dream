// Comprehensive GC coverage. Uses `Debug.*` probes to assert allocation patterns stay balanced:
//   * live_objects()  - net live blocks (leak detection)
//   * heap_ptr()      - heap high-water mark
//   * free_list_head() - reclaimed-block freelist
//   * gc_collect()    - force a full collection so finalizers / weak clears run

import system;
class Node {
    public val: int;
    public next: Option<Node>;

    public constructor(val: int, next: Option<Node>) {
        this.val = val;
        this.next = next;
    }
}

class Holder {
    public item: Option<Node>;
    public label: string;

    public constructor(item: Option<Node>, label: string) {
        this.item = item;
        this.label = label;
    }
}

class Tracked {
    public id: int;

    public constructor(id: int) {
        this.id = id;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

fun build_chain(): Node {
    let no_next: Option<Node> = Option.None;
    let head = Node(1, no_next);
    let n3 = Node(3, no_next);
    let n2 = Node(2, Option.Some(n3));
    head.next = Option.Some(n2);
    return head;
}

fun struct_array() {
    let no_next: Option<Node> = Option.None;
    let xs = [Node(1, no_next), Node(2, no_next), Node(3, no_next)];
    let total = 0;
    let i = 0;
    while (i < 3) {
        total = total + xs[i].val;
        i = i + 1;
    }
}

fun string_array() {
    let names = ["alpha", "beta", "gamma"];
    let joined = names[0] + "-" + names[1] + "-" + names[2];
}

fun nested_array() {
    let grid = [[1, 2], [3, 4], [5, 6]];
    let sum = grid[0][0] + grid[2][1];
}

fun string_builder() {
    let s = "";
    let i = 0;
    while (i < 5) {
        s = s + "x" + i.to_string();
        i = i + 1;
    }
}

fun field_reassign() {
    let no_next: Option<Node> = Option.None;
    let h = Holder(Option.Some(Node(1, no_next)), "first");
    h.item = Option.Some(Node(2, no_next));
    h.label = "second";
}

fun local_reassign() {
    let no_next: Option<Node> = Option.None;
    let n = Node(0, no_next);
    let i = 1;
    while (i <= 4) {
        n = Node(i, no_next);
        i = i + 1;
    }
}

fun nullable_paths() {
    let no_next: Option<Node> = Option.None;
    let a: Option<Node> = Option.None;
    let b: Option<Node> = Option.Some(Node(7, no_next));
    a = b;
    b = Option.None;
}

fun pass_shared(n: Node): int {
    return n.val;
}

fun branchy(flag: bool) {
    let no_next: Option<Node> = Option.None;
    if (flag) {
        let x = Node(1, no_next);
    } else {
        let y = Holder(Option.Some(Node(2, no_next)), "branch");
    }
}

fun drop_one(id: int) {
    let t = Tracked(id);
}

fun stress() {
    let chain = build_chain();
    let shared = pass_shared(chain);
    struct_array();
    string_array();
    nested_array();
    string_builder();
    field_reassign();
    local_reassign();
    nullable_paths();
    branchy(true);
    branchy(false);
}

fun main() {
    // Warm up, then capture a baseline after a forced collection.
    let w = 0;
    while (w < 20) {
        stress();
        w = w + 1;
    }
    Debug.gc_collect();
    let base_live = Debug.live_objects();
    let base_heap = Debug.heap_ptr();
    let base_free = Debug.free_list_head();

    let i = 0;
    while (i < 100) {
        stress();
        i = i + 1;
    }
    Debug.gc_collect();

    let end_live = Debug.live_objects();
    let end_heap = Debug.heap_ptr();
    let end_free = Debug.free_list_head();

    System.println("live_delta=" + (end_live - base_live).to_string());
    System.println("heap_grew=" + (end_heap - base_heap > 0).to_string());
    System.println("free_stable=" + (base_free == end_free).to_string());

    drop_one(1);
    drop_one(2);
    Debug.gc_collect();
    System.println("done");
}
