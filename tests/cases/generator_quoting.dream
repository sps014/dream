import system;
import system.json;
import system.webapi;

@get("/odd	path")
fun odd_path(): string {
    return "ok";
}

fun main(): void {
    let paths = WebApp.generated_openapi_paths();
    System.println(paths.contains("\\t"));
    let value = Json.deserialize<JsonValue>(paths).unwrap_or(JsonValue.none());
    System.println(value.get("/odd\tpath").is_some());
}
