import system;
import support.html.html;
import support.html.gen;
import support.quote.gen;

fun page(title: string): string {
    return html {
        <div class="hero">
            <h1>{title}</h1>
            <p>Welcome</p>
        </div>
    };
}

fun main() {
    System.println(page("Hello"));
    System.println(quote { Hello generators });
}
