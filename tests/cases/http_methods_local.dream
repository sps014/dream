// HttpClient convenience methods against the loopback mock server (DREAM_E2E_HTTP_PORT).
// The mock echoes `METHOD path|x-tag|content-type|body`.
import system;
import system.net;
import system.encoding;

async fun main(): void {
    let port = int.parse(System.env_or("DREAM_E2E_HTTP_PORT", "0")).unwrap_or(0);
    if port == 0 {
        System.println("no port");
        return;
    }
    let c = HttpClient("http://127.0.0.1:" + port.to_string());

    switch (c.get("/hello").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let tagged = HttpHeaders();
    tagged.set("X-Tag", "abc");
    switch (c.get_with("/hello", tagged).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.post("/echo", "hi there").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let t1 = HttpHeaders();
    t1.set("X-Tag", "t1");
    switch (c.post_with("/echo", "hi again", t1).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.put("/echo", "put body").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let t2 = HttpHeaders();
    t2.set("X-Tag", "t2");
    switch (c.put_with("/echo", "pw", t2).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.patch("/echo", "patched").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let t3 = HttpHeaders();
    t3.set("X-Tag", "t3");
    switch (c.patch_with("/echo", "patched too", t3).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.delete("/item/9").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let t4 = HttpHeaders();
    t4.set("X-Tag", "t4");
    switch (c.delete_with("/item/9", t4).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.post_json("/json", Json.parse("{\"name\":\"dream\",\"n\":42}").unwrap_or(JsonValue.none())).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.put_json("/json", Json.parse("{\"name\":\"dream\",\"n\":42}").unwrap_or(JsonValue.none())).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.patch_json("/json", Json.parse("{\"n\":43}").unwrap_or(JsonValue.none())).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    let form = Map<string, string>();
    form.set("name", "Shivendra Kumar");
    form.set("q", "a&b=c");
    switch (c.post_form("/form", form).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    // Defaults survive alongside per-call headers.
    let authed = HttpClient("http://127.0.0.1:" + port.to_string());
    authed.set_header("X-Tag", "default");
    switch (authed.post("/echo", "with default").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }

    switch (c.head("/hello").await) {
        Ok(r) => System.println(r.status),
        Err(e) => System.println(e.message()),
    }

    switch (c.get_bytes("/bytes").await) {
        Ok(b) => System.println(Encoding.utf8_decode(b)),
        Err(e) => System.println(e.message()),
    }
}
