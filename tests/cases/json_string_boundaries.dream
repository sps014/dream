import system;
import system.json;

fun main(): void {
    let valid = true;
    for (let n = 0; n < 130; n = n + 1) {
        let content = StringBuilder(n * 2 + 8);
        for (let i = 0; i < n; i = i + 1) {
            content.append(i % 7 == 0 ? "😀" : "x");
        }
        let expected = content.build();
        let wrapped = "prefix\"" + expected + "\"tail";
        let input = wrapped.substring(6, wrapped.length - 4);
        let decoded = Json.deserialize<JsonValue>(input).unwrap().as_string().unwrap();
        valid = valid && decoded == expected;
        if n > 0 {
            string.set(input, 1, 'Z');
            valid = valid && decoded == expected;
        }
        let escaped = "\"" + expected + "\\n" + expected + "\"";
        let with_escape = Json.deserialize<JsonValue>(escaped).unwrap().as_string().unwrap();
        valid = valid && with_escape == expected + "\n" + expected;
        let truncated = JsonParser("\"" + expected, 0).parse_string();
        valid = valid && truncated == expected;
    }
    System.println(valid);
}
