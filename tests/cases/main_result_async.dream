// An `async fun main(): Result<T, E>` propagates with `?` the same way. `f().await?` needs no
// parentheses: `?` binds to the awaited `Result`, never to the `Future`.
import system;

async fun doubled(n: int): Result<int, string> {
    if n < 0 {
        return Result.Err("negative: " + n.to_string());
    }
    return Result.Ok(n * 2);
}

async fun main(): Result<bool, string> {
    let a = doubled(21).await?;
    System.println("doubled is " + a.to_string());
    let b = doubled(a).await?;
    System.println("again is " + b.to_string());
}
