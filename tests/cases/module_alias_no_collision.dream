// Two different modules can declare the same name (`add`); aliased imports resolve the
// duplicate-name collision without either declaration being renamed. `internal`
// (module_utils_math's shared_helper) is reachable from another file that declares the same
// module, via module_internal_partner.combine().
import system;
import helpers.module_utils_math;
import helpers.module_vendor_math;
import helpers.module_internal_partner;

import utils.math.add as add_sum;
import vendor.math.add as add_product;
import utils.math.combine as run_combine;

fun main(): void {
    System.println(add_sum(2, 3));
    System.println(add_product(2, 3));
    System.println(run_combine());
}
