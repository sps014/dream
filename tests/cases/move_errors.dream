// Each use after a move names where the value went and what to use instead.
import system;

class Node {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }
}

class Holder {
    public node: Node;
    public slots: Node[];

    public constructor(node: Node) {
        this.node = node;
        this.slots = Array.alloc<Node>(1);
    }
}

fun adopt(holder: Holder, node: Node): void {
    holder.node = node;
    System.println(node.name);
}

fun slot(holder: Holder, node: Node): void {
    holder.slots[0] = node;
    System.println(node.name);
}

fun rebind(): void {
    let first = Node("first");
    let second = first;
    System.println(first.name + second.name);
}

fun construct(): void {
    let inner = Node("inner");
    let holder = Holder(inner);
    System.println(inner.name + holder.node.name);
}

fun branch(flag: bool, holder: Holder): void {
    let maybe = Node("maybe");
    if flag {
        holder.node = maybe;
    }
    System.println(maybe.name);
}

fun repeat(holder: Holder): void {
    let looped = Node("loop");
    for (let i = 0; i < 2; i++) {
        holder.node = looped;
    }
}

fun main(): void {}
