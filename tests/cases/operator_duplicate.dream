// Two binary `+` declarations with the same parameter type are duplicates.
import system;
class Vector2 {
    public x: int;

    public constructor(x: int) {
        this.x = x;
    }

        fun operator +(other: Vector2): Vector2 {
        return Vector2(this.x + other.x);
    }

        fun operator +(other: Vector2): Vector2 {
        return Vector2(this.x + other.x);
    }
}

fun main() {
    let a = Vector2(1);
    let b = a + Vector2(2);
    System.println(b.x);
}
