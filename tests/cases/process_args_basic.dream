import system;
import system.testing;
import system.encoding;

fun main(): void {
    System.println(System.os_family == OsFamily.Unix || System.os_family == OsFamily.Windows);
    System.println(System.exe_path.unwrap_or("").length > 0);
    let args = System.args;
    System.println(args.length);
    System.println(args[0]);
    System.println(args[1]);
    Assert.eq(args[2], "");
    Assert.eq(args[3], "first\nsecond");
    Assert.eq(args[4], "こんにちは");
    Assert.eq(Encoding.hex_encode(Encoding.utf8_encode(args[5])), "efbbbf6c656164696e67");
}
