import system;
import system.text;
fun main(): void {
    let dup = Regex("(\\w+) \\1", "");
    System.println(dup.test("hello hello"));
    System.println(dup.test("hello world"));
    System.println(dup.match("the the fox")[0]);

    let quoted = Regex("(['\"]).*?\\1", "");
    System.println(quoted.match("say 'hi' now")[0]);
    System.println(quoted.match("say \"hi\" now")[0]);

    let named = Regex("(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})", "");
    let info_opt = named.match_info("2026-08-09");
    switch (info_opt) {
        Some(info) => {
            System.println(info.full);
            System.println(info.named("year").unwrap_or("?"));
            System.println(info.named("month").unwrap_or("?"));
            System.println(info.named("day").unwrap_or("?"));
            System.println(info.named("nope").unwrap_or("none"));
        },
        None => {
            System.println("no match");
        },
    }

    let repl = Regex("(?<a>\\w+)@(?<b>\\w+)", "");
    System.println(repl.replace("user@host", "${b}:${a}"));

    let letters = Regex("\\p{L}+", "g");
    System.println(letters.match("héllo Wörld123")[0]);
    System.println(letters.match("héllo Wörld123")[1]);

    let numbers = Regex("\\p{N}+", "");
    System.println(numbers.test("abc123"));
    System.println(numbers.match("abc123")[0]);

    let not_letters = Regex("\\P{L}+", "");
    System.println(not_letters.match("abc123")[0]);

    let combo = Regex("(\\w+)-\\1(?=!)", "");
    System.println(combo.test("go-go!"));
    System.println(combo.test("go-go?"));
}
