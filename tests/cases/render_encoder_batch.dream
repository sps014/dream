// `GpuEncoder`: two draws recorded into one render pass and submitted as a single command buffer.
//
// Each draw sets its own uniform block, so the host must hand out a fresh uniform slot per
// `set_uniforms` — with one buffer per pipeline the second write would recolor the first draw too.
// The second draw is scissored to the right half, so the read-back proves both the batching and
// the per-draw uniform state. The material texture/sampler come from a pinned `GpuBindGroup`.
import system;
import system.gpu;

struct Vertex {
    public pos: GpuVec2;
}

struct VsOut {
    public position: GpuVec4;
    public uv: GpuVec2;
}

fun make_vert(x: float, y: float): Vertex {
    let v = Vertex();
    v.pos = GpuVec2.of(x, y);
    return v;
}

@vertex
fun batch_vs(v: Vertex): VsOut {
    let o = VsOut();
    o.position = GpuVec4.of(v.pos.x, v.pos.y, 0.0, 1.0);
    o.uv = GpuVec2.of(v.pos.x * 0.5 + 0.5, 0.5 - v.pos.y * 0.5);
    return o;
}

@fragment
fun batch_fs(
    v: VsOut,
    @group(0) @binding(0) tint: GpuVec4,
    @group(1) @binding(0) albedo: GpuTexture,
    @group(1) @binding(1) samp: GpuSampler
): GpuVec4 {
    let base = Gpu.texture_sample(albedo, samp, v.uv.x, v.uv.y);
    return GpuVec4.of(base.x * tint.x, base.y * tint.y, base.z * tint.z, base.w * tint.w);
}

async fun main(): void {
    let init = await Gpu.try_init();
    if init.is_err() {
        System.println("gpu unavailable");
        return;
    }

    let albedo = GpuTexture.rgba8(1, 1);
    let pixels = Buffer.alloc<byte>(4);
    pixels[0] = (byte)255;
    pixels[1] = (byte)255;
    pixels[2] = (byte)255;
    pixels[3] = (byte)255;
    let wrote = await albedo.write_rgba(pixels);
    if wrote.is_err() {
        System.println("texture write failed");
        return;
    }
    let samp = GpuSampler.create(GpuSamplerDesc.nearest());

    let verts = GpuBuffer<Vertex>.vertex_from([
        make_vert(-1.0, -1.0),
        make_vert(3.0, -1.0),
        make_vert(-1.0, 3.0),
    ]);

    let desc = GpuRenderPipelineDesc.defaults();
    let pipe_r = await GpuRenderPipeline.create_ex("batch_vs", "batch_fs", desc);
    if pipe_r.is_err() {
        System.println("pipeline create failed");
        return;
    }
    let pipe = pipe_r.unwrap();

    let material_r = await GpuBindGroup.create(
        pipe,
        1,
        GpuBindList.begin().texture(albedo).sampler(samp)
    );
    if material_r.is_err() {
        System.println("bind group create failed");
        return;
    }
    let material = material_r.unwrap();

    let target = GpuTexture.rgba8(4, 4);
    let enc = GpuEncoder.begin();
    let pass = enc.render_pass(
        GpuRenderTarget.texture(target).clear(GpuVec4.of(0.0, 0.0, 0.0, 1.0))
    );
    pass.set_pipeline(pipe);
    pass.set_bind_group(1, material);
    pass.set_vertex_buffer(0, verts);

    // Whole target red.
    pass.set_uniforms(Uniforms.pack_f32([1.0, 0.0, 0.0, 1.0]));
    pass.draw(3, 1, 0, 0);

    // Right half blue, over the top.
    pass.set_scissor(2, 0, 2, 4);
    pass.set_uniforms(Uniforms.pack_f32([0.0, 0.0, 1.0, 1.0]));
    pass.draw(3, 1, 0, 0);
    pass.end();

    let submitted = await enc.submit();
    if submitted.is_err() {
        System.println("submit failed");
        return;
    }

    let out = await target.read_rgba();
    System.println("left=" + ((int)out[0]).to_string() + "," + ((int)out[1]).to_string() + "," + ((int)out[2]).to_string());
    // Pixel (2, 0) starts 8 bytes in.
    System.println("right=" + ((int)out[8]).to_string() + "," + ((int)out[9]).to_string() + "," + ((int)out[10]).to_string());
    material.destroy();
}
