import system;

fun main(): void {
    let arena = ScratchArena<int>(256);
    let round = 0;
    while round < 3 {
        let a = arena.alloc(4);
        let i = 0;
        while i < a.length {
            a[i] = round * 10 + i;
            i = i + 1;
        }
        System.println(a[0]);
        System.println(a[3]);
        System.println(arena.remaining);
        arena.reset();
        System.println(arena.remaining);
        round = round + 1;
    }

    let bytes = ScratchArena<byte>(8);
    let b = bytes.alloc(3);
    b[0] = (byte)1;
    b[1] = (byte)2;
    b[2] = (byte)3;
    System.println((int)b[0]);
    System.println((int)b[2]);
    System.println(bytes.remaining);
}
