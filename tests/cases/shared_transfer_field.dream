// An `shared class` may hold non-shared managed heap values (`Option<Job>`, arrays,
// classes). The object's whole reachable graph is treated as shared once inside, so all
// fields are accessed under the same `lock` discipline — no per-field move rules.
//
// Non-`@shared` objects themselves move WHOLE into worker bodies by pointer hand-off:
// see `webworker_move_array.dream`.
import system;

class Job {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }
}

shared class JobQueue {
    public head: Option<Job>;
    public count: int;

    public constructor() {
        this.head = Option.None;
        this.count = 0;
    }
}

async fun main(): void {
    let q = JobQueue();

    let producer = WebWorker.spawn(() => {
        lock (q) {
            q.head = Option.Some(Job("build"));
            q.count = q.count + 1;
        }
        return 0;
    });
    await producer;

    System.println(q.count);

    let consumer = WebWorker.spawn(() => {
        lock (q) {
            if q.head.is_some() {
                System.println(q.head.unwrap().name);
                q.count = q.count - 1;
            } else {
                System.println("empty");
            }
        }
        return 0;
    });
    await consumer;
    System.println(q.count);
}
