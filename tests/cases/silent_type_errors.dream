import system;

class Counter {
    count: int;
    public total: int;

    public constructor() {
        this.count = 1;
        this.total = 2;
    }

    public fun reset(): void {
        this = Counter();
    }
}

struct Point {
    public x: int;

    public constructor() {
        this.x = 0;
    }

    public fun reset(): void {
        this = Point();
    }
}

interface Runner {
    fun run(): int;
}

class HiddenRunner: Runner {
    public constructor() {}

    fun run(): int {
        return 1;
    }
}

class Lookup {
    public constructor() {}

    public fun this[key: int]: string {
        return "";
    }

    public fun this[key: string] = value: int {}
}

class Defaults {
    public constructor() {}

    public fun toggle(flag: bool = 3): bool {
        return flag;
    }
}

fun make_counter(): Counter {
    return Counter();
}

fun bump(ref value: int): void {
    value = value + 1;
}

fun swap(ref first: int, ref second: int): void {}

fun overlapping_refs(counter: Counter, values: int[], slot: int): void {
    swap(ref counter.total, ref counter.total);
    swap(ref values[0], ref values[slot]);
    swap(ref values[0], ref values[1]);
}

fun with_default(amount: int = "text"): int {
    return amount;
}

fun main(): void {
    const fixed = 1;
    bump(ref fixed);
    let after = fixed++;

    let counter = Counter();
    bump(ref counter.count);
    bump(ref make_counter().total);

    let number = 5;
    let is_text = number is string;
    let is_point = counter is Point;

    let ratio = 1.5;
    switch (ratio) {
        1..3 => System.println("inside"),
        _ => System.println("outside"),
    }
}
