import system;

struct Point {
    public x: int;
    public y: int;
}

struct Inner {
    public text: string;
    public count: int;
}

struct Outer {
    public tag: byte;
    public inner: Inner;
    public total: double;
}

class Box {
    public value: int;
}

fun main(): void {
    System.println(sizeof(int));
    System.println(sizeof(long));
    System.println(sizeof(byte));
    System.println(sizeof(bool));
    System.println(sizeof(string));
    System.println(sizeof(int[]));
    System.println(sizeof(Point));
    System.println(sizeof(Box));
    System.println(sizeof(List<int>));
    System.println(sizeof(Outer));
    switch (sizeof(Outer)) {
        case sizeof(Outer): System.println(true);
        default: System.println(false);
    }
}
