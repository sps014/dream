import system;

fun main(): void {
    let h = string.alloc(2048);
    let n = string.alloc(256);
    for (let i = 0; i < h.length; i = i + 1) { string.set(h, i, 'a'); }
    for (let i = 0; i < n.length; i = i + 1) { string.set(n, i, 'a'); }
    string.set(n, 255, 'b');
    System.println(h.span().index_of(n).unwrap_or(-1));
    string.set(h, 2047, 'b');
    System.println(h.span().index_of(n).unwrap_or(-1));
    System.println(h.span(23, 2048).index_of(n, -10).unwrap_or(-1));
    System.println(h.span().index_of(n, 1793).unwrap_or(-1));
    System.println(h.span().index_of(n, 2147483647).unwrap_or(-1));
    System.println(h.span().index_of("", 2048).unwrap_or(-1));
    System.println(h.span().index_of("", 2049).unwrap_or(-1));
    let observed = h.span();
    string.set(h, 2047, 'a');
    System.println(observed.index_of(n).unwrap_or(-1));
    let binary = string.alloc(96);
    for (let i = 0; i < binary.length; i = i + 1) { string.set(binary, i, (char)(i & 1)); }
    let binary_needle = binary.substring(32, 96);
    System.println(binary.span().index_of(binary_needle, 1).unwrap_or(-1));
    let unicode = string.alloc(256);
    for (let i = 0; i < unicode.length; i = i + 1) {
        string.set(unicode, i, (char)(55296 + (i & 1) * 1024));
    }
    let unicode_needle = unicode.substring(128, 192);
    System.println(unicode.span(1, 255).index_of(unicode_needle).unwrap_or(-1));
    string.set(unicode, 1, (char)0);
    System.println(unicode.span().index_of(unicode_needle).unwrap_or(-1));
}
