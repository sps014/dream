import system;
import system.collections;

fun main() {
    let s = "  hello, world ,a,,b  ";
    let v = s.span();
    System.println(v.length);
    let t = v.trim();
    System.println(t.to_string() + "|");
    System.println(t.starts_with("hello"));
    System.println(t.ends_with("b"));
    System.println(t.index_of(',').unwrap_or(-1));
    System.println(t.index_of("world").unwrap_or(-1));
    System.println(t.last_index_of(',').unwrap_or(-1));
    System.println(t.slice(0, 5).equals("hello"));
    System.println(t.slice(0, 5) == "xhello".span(1, 6));
    System.println(s.span(-3, 100).length);
    let it = t.split_iter(',');
    while it.move_next() {
        System.println("[" + it.current.trim().to_string() + "]");
    }
    let it2 = "a--b--c".span().split_iter("--");
    while it2.move_next() {
        System.println(it2.current.to_string());
    }
    let ls = "one\r\ntwo\nthree\n".span().lines();
    while ls.move_next() {
        System.println("<" + ls.current.to_string() + ">");
    }
    System.println("-42".span().parse_int().unwrap_or(0));
    System.println("x12".span(1, 3).parse_int().unwrap_or(0));
    System.println("hello".span().hash_code() == "hello".hash_code());
    System.println("xhellox".span(1, 6).hash_code() == "hello".hash_code());
    System.println("abc".span().compare("abd") < 0);
}
