// A `ReadOnlySpan<char>` is a `ref struct`: it cannot be stored as a field of a class or ordinary struct.

class Holder {
    public view: ReadOnlySpan<char>;

    public constructor(view: ReadOnlySpan<char>) {
        this.view = view;
    }
}

fun main(): void {
    let h = Holder("abc".span());
}
