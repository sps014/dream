import system;
import system.testing;

@test
fun eq_passes(): void {
    Assert.eq(1 + 1, 2);
}

@test
fun ne_passes(): void {
    Assert.ne(1, 2);
}

@test
fun bool_passes(): void {
    Assert.is_true(1 < 2);
    Assert.is_false(2 < 1);
}

fun main(): void {
    Test.run("eq_passes", eq_passes);
    Test.run("ne_passes", ne_passes);
    Test.run("bool_passes", bool_passes);
}
