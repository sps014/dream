module gen;

import system.codegen;

@generator
@syntax_block("html")
public fun broken(borrow ctx: GenContext): void {
    let blocks = ctx.syntax_blocks("html");
    let i = 0;
    while i < blocks.length {
        let block = blocks[i];
        // Emits syntactically invalid Dream so the replacement re-parse fails; the
        // diagnostic must map back into the user's `html {}` block.
        ctx.replace(block, "1 + );");
        i = i + 1;
    }
}
