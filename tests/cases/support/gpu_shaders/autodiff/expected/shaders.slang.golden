// Generated by system.gpu.shaders from the Dream module 'shaders'.
// Do not edit: it is rewritten on every build.

// Float atomics are not available on every target; a compare-and-swap loop on the
// element's bits is.
float dream_atomic_add_float(RWStructuredBuffer<Atomic<uint>> buffer, int index, float value)
{
    uint expected = buffer[index].load();
    while (true)
    {
        uint original = buffer[index].compareExchange(expected, asuint(asfloat(expected) + value));
        if (original == expected)
        {
            return asfloat(original);
        }
        expected = original;
    }
    return 0.0f;
}

static uint3 dream_global_id;

[Differentiable]
float loss(float weight, float input, float target)
{
    var prediction = weight * input;
    var error = prediction - target;
    return error * error;
}

StructuredBuffer<float> train_step_inputs;
StructuredBuffer<float> train_step_targets;
RWStructuredBuffer<float> train_step_weights;
RWStructuredBuffer<Atomic<uint>> train_step_gradients;
struct train_step_Params
{
    int n;
};
ConstantBuffer<train_step_Params> train_step_params;

[shader("compute")]
[numthreads(64, 1, 1)]
void train_step(uint3 dream_in_global_id : SV_DispatchThreadID)
{
    dream_global_id = dream_in_global_id;
    var n = train_step_params.n;
    var i = int3(dream_global_id).x;
    if (i >= n)
    {
        return;
    }
    var w = diffPair(train_step_weights[0], 0.0f);
    var x = diffPair(train_step_inputs[i]);
    var t = diffPair(train_step_targets[i]);
    bwd_diff(loss)(w, x, t, 1.0f);
    dream_atomic_add_float(train_step_gradients, 0, w.d);
}
