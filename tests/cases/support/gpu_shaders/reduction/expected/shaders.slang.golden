// Generated by system.gpu.shaders from the Dream module 'shaders'.
// Do not edit: it is rewritten on every build.

// Float atomics are not available on every target; a compare-and-swap loop on the
// element's bits is.
float dream_atomic_add_float(RWStructuredBuffer<Atomic<uint>> buffer, int index, float value)
{
    uint expected = buffer[index].load();
    while (true)
    {
        uint original = buffer[index].compareExchange(expected, asuint(asfloat(expected) + value));
        if (original == expected)
        {
            return asfloat(original);
        }
        expected = original;
    }
    return 0.0f;
}

static uint3 dream_global_id;
static uint3 dream_local_id;

#if defined(DREAM_SHADER_reduce_sum)
StructuredBuffer<float> reduce_sum_input;
RWStructuredBuffer<Atomic<uint>> reduce_sum_out;
struct reduce_sum_Params
{
    int n;
};
ConstantBuffer<reduce_sum_Params> reduce_sum_params;
groupshared float reduce_sum_partial[256];

[shader("compute")]
[numthreads(256, 1, 1)]
void reduce_sum(uint3 dream_in_global_id : SV_DispatchThreadID, uint3 dream_in_local_id : SV_GroupThreadID)
{
    dream_global_id = dream_in_global_id;
    dream_local_id = dream_in_local_id;
    var n = reduce_sum_params.n;
    var i = int3(dream_global_id).x;
    var lane = int3(dream_local_id).x;
    reduce_sum_partial[lane] = (i < n) ? reduce_sum_input[i] : 0.0f;
    GroupMemoryBarrierWithGroupSync();
    var stride = 128;
    while (stride > 0)
    {
        if (lane < stride)
        {
            reduce_sum_partial[lane] = reduce_sum_partial[lane] + reduce_sum_partial[lane + stride];
        }
        GroupMemoryBarrierWithGroupSync();
        stride = stride / 2;
    }
    if (lane == 0)
    {
        dream_atomic_add_float(reduce_sum_out, 0, reduce_sum_partial[0]);
    }
}
#endif

#if defined(DREAM_SHADER_histogram)
StructuredBuffer<uint> histogram_values;
RWStructuredBuffer<Atomic<uint>> histogram_bins;
struct histogram_Params
{
    int count;
};
ConstantBuffer<histogram_Params> histogram_params;

[shader("compute")]
[numthreads(64, 1, 1)]
void histogram(uint3 dream_in_global_id : SV_DispatchThreadID)
{
    dream_global_id = dream_in_global_id;
    var count = histogram_params.count;
    var i = int3(dream_global_id).x;
    for (var k = 0; k < 4; k = k + 1)
    {
        var index = (i * 4) + k;
        if (index < count)
        {
            histogram_bins[int((histogram_values[index] % 16u))].add(1u);
        }
    }
}
#endif
