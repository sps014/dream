// Generated by system.gpu.shaders from the Dream module 'shaders'.
// Do not edit: it is rewritten on every build.

static uint3 dream_global_id;

StructuredBuffer<uint> prefix_count_flags;
RWStructuredBuffer<uint> prefix_count_offsets;
RWStructuredBuffer<Atomic<uint>> prefix_count_counts;

[shader("compute")]
[numthreads(256, 1, 1)]
void prefix_count(uint3 dream_in_global_id : SV_DispatchThreadID)
{
    dream_global_id = dream_in_global_id;
    var i = int3(dream_global_id).x;
    var active = prefix_count_flags[i] != 0u;
    var before = WavePrefixSum((active) ? 1u : 0u);
    var total = WaveActiveSum((active) ? 1u : 0u);
    prefix_count_offsets[i] = before;
    if (WaveIsFirstLane())
    {
        prefix_count_counts[0].add(total);
        prefix_count_counts[1].max(WaveActiveMax(prefix_count_flags[i]));
    }
    var lane = WaveGetLaneIndex();
    var neighbor = WaveShuffle(prefix_count_flags[i], (lane + 1u) % WaveGetLaneCount());
    if (WaveActiveAnyTrue(neighbor != prefix_count_flags[i]))
    {
        prefix_count_offsets[i] = prefix_count_offsets[i] + WaveReadLaneAt(before, 0u);
    }
}
