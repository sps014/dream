// Generated by system.gpu.shaders from the Dream module 'shaders'.
// Do not edit: it is rewritten on every build.

struct VertexOutput
{
    float4 position : SV_Position;
    [[vk::location(0)]] float4 color : LOCATION0;
    [[vk::location(1)]] float2 uv : LOCATION1;
};

static uint dream_vertex_id;

float4 tint(float4 color, float amount)
{
    return lerp(color, float4(1.0f), float4(saturate(amount)));
}

#if defined(DREAM_SHADERS_RENDER)
struct triangle_vertex_Params
{
    float4x4 transform;
};
ConstantBuffer<triangle_vertex_Params> triangle_vertex_params;

[shader("vertex")]
VertexOutput triangle_vertex(uint dream_in_vertex_id : SV_VertexID)
{
    dream_vertex_id = dream_in_vertex_id;
    var transform = triangle_vertex_params.transform;
    var x = -0.5f;
    var y = -0.5f;
    if (int(dream_vertex_id) == 1)
    {
        x = 0.5f;
    }
    else if (int(dream_vertex_id) == 2)
    {
        x = 0.0f;
        y = 0.5f;
    }
    var result = (VertexOutput)0;
    result.position = mul(float4(x, y, 0.0f, 1.0f), transform);
    result.color = float4(1.0f, 0.3f, 0.1f, 1.0f);
    result.uv = float2(x + 0.5f, y + 0.5f);
    return result;
}
#endif

#if defined(DREAM_SHADERS_RENDER)
Texture2D<float4> triangle_fragment_albedo;
SamplerState triangle_fragment_linear;
struct triangle_fragment_Params
{
    float highlight;
};
ConstantBuffer<triangle_fragment_Params> triangle_fragment_params;

[shader("fragment")]
float4 triangle_fragment(VertexOutput input) : SV_Target0
{
    var highlight = triangle_fragment_params.highlight;
    var texel = triangle_fragment_albedo.Sample(triangle_fragment_linear, input.uv);
    return tint(texel * input.color, highlight);
}
#endif
