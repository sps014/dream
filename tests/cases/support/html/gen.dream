module gen;

import system.codegen;
import parser;

@generator
@syntax_block("html")
public fun html(ctx: GenContext): void {
    for (let block in ctx.syntax_blocks("html")) {
        let result = HtmlCompiler.compile(block.body, block.splices);
        if !result.ok {
            ctx.error(block, result.error);
            return;
        }
        ctx.replace(block, result.source);
    }
}
