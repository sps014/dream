import system;
import system.io;
import system.collections;
import system.json;
import system.codegen;
import gen;

async fun main(): void {
    let path = System.env_or("DREAM_SYNTAX_GEN_SNAPSHOT", "");
    let ctx_res = await GenContext.from_snapshot(path);
    switch (ctx_res) {
        Ok(gen_ctx) => {
            quote(gen_ctx);
            gen_ctx.finish();
        }
        Err(e) => {
            System.println(GenHost.err_marker());
            System.println(e);
        }
    }
}
