// `shared class` may hold a `string` field (shared / Sendable analogue).
import system;
import system.task;

shared class Named {
    public label: string;
    public constructor(label: string) {
        this.label = label;
    }
}

async fun main(): void {
    let n = Named("hi");
    System.println(Task.spawn(() => n.label + "!").await);
}
