// Native TcpClient send/receive against a loopback echo server (DREAM_E2E_TCP_PORT).
import system;
import system.net;

async fun main(): void {
    let port = int.parse(System.env_or("DREAM_E2E_TCP_PORT", "0")).unwrap_or(0);
    switch (await TcpClient.connect("127.0.0.1", port)) {
        Ok(client) => {
            switch (await client.send_text("ping")) {
                Ok(n) => System.println(n),
                Err(e) => System.println(e.message()),
            }
            switch (await client.receive(16)) {
                Ok(data) => System.println(data.length),
                Err(e) => System.println(e.message()),
            }
            client.close();
        },
        Err(e) => System.println(e.code()),
    }
}
