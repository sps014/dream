import system;
import system.json;

@noinline
fun format(n: double): void {
    let sb = StringBuilder(128);
    sb.append_double(n);
    let first = sb.build();
    System.println(first == n.to_string());
    sb.append_double(2.5d);
    System.println(first == n.to_string());
}

fun main(): void {
    let text = string.clone("\"hello😀\"");
    let parsed = Json.deserialize<JsonValue>(text).unwrap().as_string().unwrap();
    string.set(text, 1, 'X');
    System.println(parsed);
    let empty = Json.deserialize<JsonValue>("\"\"").unwrap().as_string().unwrap();
    System.println(empty.length);
    System.println(Json.deserialize<JsonValue>("\"line\\nnext\"").unwrap().as_string().unwrap());
    format(2.5d);
    format(1.0e100d);
    let infinity = (double)1 / (double)0;
    format(infinity);
    format(-infinity);
    format(infinity - infinity);
    format(-(double)0);
    System.println(infinity.to_string());
    System.println((-infinity).to_string());
    System.println((infinity - infinity).to_string());
}
