// UI-style parent/child tree: strong `children`, `weak parent`. Replacing/dropping the root
// reclaims the whole tree (`live_objects` delta 0). Last-use destroy runs `del` before later work.
import system;
@allow_cycle
class Node {
    public id: int;
    public children: List<Node>;
    public weak parent: Option<Node>;

    public constructor(id: int) {
        this.id = id;
        this.children = List<Node>();
        this.parent = Option.None;
    }

    del() {
        System.print("drop ");
        System.println(this.id);
    }
}

fun attach(borrow p: Node, c: Node) {
    c.parent = Option.Some(p);
    p.children.push(c);
}

class Target {
    public value: int;
    public constructor(value: int) { this.value = value; }
    del() { System.println("target dropped"); }
}

// Tearing down a holder of several weak fields must unregister each of them from the target.
class WeakHolder {
    public weak typed: Option<Target>;
    public weak second: Option<Target>;
    public constructor(borrow target: Target) {
        this.typed = Option.Some(target);
        this.second = Option.Some(target);
    }
    del() { System.println("holder dropped"); }
}

fun observe(borrow target: Target): void {
    let holder = WeakHolder(target);
    switch (holder.typed) {
        Some(value) => System.println(value.value),
        None => System.println(-1),
    }
    switch (holder.second) {
        Some(value) => System.println(value.value),
        None => System.println(-1),
    }
}

fun weak_holder_teardown(): void {
    let target = Target(42);
    observe(target);
    let replacement = Target(7);
    System.println(replacement.value);
    System.println(target.value);
}

fun main() {
    weak_holder_teardown();
    let base = Debug.live_objects;
    let root = Node(1);
    let child = Node(2);
    attach(root, child);
    System.println("built");
    System.println("later");
    System.println("live_delta=" + (Debug.live_objects - base).to_string());
}
