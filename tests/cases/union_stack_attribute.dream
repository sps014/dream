// `enum struct` is a checked contract: registration errors out unless the union qualifies as a
// value union (every payload value/primitive, or any number of non-self-referential
// reference-typed payloads). When every payload is already value/primitive, `enum struct` has no
// representational effect beyond the contract. With a reference payload (as below), `enum struct`
// is what opts the union into the inline representation.

import system;
enum struct Outcome {
    Success(int),
    Failure(code: int, reason: string),
}

fun describe(o: Outcome): string {
    return switch (o) {
        Success(c)    => "ok:" + c.to_string(),
        Failure(c, r) => "fail:" + c.to_string() + ":" + r,
    };
}

fun main(): void {
    let s: Outcome = Outcome.Success(0);
    let f: Outcome = Outcome.Failure(1, "disk full");
    System.println(describe(s));   // ok:0
    System.println(describe(f));   // fail:1:disk full
}
