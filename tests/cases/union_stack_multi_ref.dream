// `enum struct` allows any number of non-self-referential reference-typed payload fields inline:
// refs across different variants (Either) and multiple refs in one variant (Pair).

import system;
enum struct Either {
    Left(string),
    Right(string),
}

enum struct Pair {
    Both(a: string, b: string),
}

fun side(e: Either): string {
    return switch (e) {
        Left(v)  => "L:" + v,
        Right(v) => "R:" + v,
    };
}

fun join(p: Pair): string {
    return switch (p) {
        Both(a, b) => a + "|" + b,
    };
}

fun main(): void {
    System.println(side(Either.Left("hi")));
    System.println(side(Either.Right("bye")));
    System.println(join(Pair.Both("x", "y")));
}
