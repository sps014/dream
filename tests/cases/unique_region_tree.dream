// Unique class graph born and dropped in one loop iteration: inferred bump region
// must rewind so live_objects returns to the pre-loop baseline.
import system;

@allow_cycle
class TreeNode {
    public left: Option<TreeNode>;
    public right: Option<TreeNode>;

    public constructor(left: Option<TreeNode>, right: Option<TreeNode>) {
        this.left = left;
        this.right = right;
    }
}

fun make_tree(depth: int): Option<TreeNode> {
    let none: Option<TreeNode> = Option.None;
    if depth <= 0 {
        return none;
    }
    return Option.Some(TreeNode(make_tree(depth - 1), make_tree(depth - 1)));
}

fun main() {
    let base = Debug.live_objects;
    let i = 0;
    while i < 4 {
        switch (make_tree(3)) {
            Some(root) => {}
            None => {}
        }
        i = i + 1;
    }
    let delta = Debug.live_objects - base;
    System.println("live_delta=" + delta.to_string());
}
