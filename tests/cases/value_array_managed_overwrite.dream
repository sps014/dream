import system;

class Note {
    public n: int;
    public constructor(n: int) { this.n = n; }
    del() { System.println(this.n); }
}

struct Entry {
    public note: Note;
    public constructor(borrow note: Note) { this.note = note; }
}

enum struct Slot { Empty, Value(Note) }

fun exercise(): void {
    let entries = Buffer.alloc<Entry>(2);
    entries[0] = Entry(Note(11));
    entries[1] = Entry(Note(12));
    entries[0] = entries[0];
    Buffer.truncate(entries, 1);
    Buffer.clear(entries);
    let slots = Buffer.alloc<Slot>(2);
    slots[0] = Slot.Value(Note(21));
    slots[1] = Slot.Value(Note(22));
    slots[0] = slots[0];
    Buffer.truncate(slots, 1);
    Buffer.clear(slots);
}

fun main(): void {
    let before = Debug.live_objects;
    exercise();
    System.println(Debug.live_objects - before);
}
