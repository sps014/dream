fun patterns(shape: Shape): int {
    let a = switch (shape) {
        Other.Nothing => 0,
        Nothing => 1,
        Circle(r) => r,
        Dot => 2,
    };
    return switch (shape) {
        Circle() => 1,
        Dot => 2,
    };
}

