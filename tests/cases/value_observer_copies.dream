import system;
import system.collections;

class Note {
    public n: int;
    public constructor(n: int) { this.n = n; }
}
struct View {
    public weak note: Option<Note>;
    public constructor(borrow note: Note) { this.note = Option.Some(note); }
}
struct Borrowed {
    public unowned note: Note;
    public constructor(borrow note: Note) { this.note = note; }
}
@noinline
fun fill(borrow entries: View[]): void {
    let note = Note(42);
    let view = View(note);
    entries[0] = view;
    entries[1] = view;
    entries[0] = entries[0];
    System.println(entries[0].note.is_some());
    System.println(note.n);
}
@noinline
fun read(borrow value: Borrowed): int { return value.note.n; }
fun exercise(): void {
    let entries = Buffer.alloc<View>(2);
    fill(entries);
    System.println(entries[0].note.is_none());
    System.println(entries[1].note.is_none());
    let list = List<View>();
    list.push_all(entries);
    let alias = list.as_read_only_span();
    list.reserve(32);
    let other = Note(7);
    list[0] = View(other);
    System.println(list[0].note.unwrap().n);
    System.println(alias[0].note.is_none());
    let value = Borrowed(other);
    let copy = value;
    System.println(read(copy));
    System.println(other.n);
    Buffer.clear(entries);
    list.clear();
}
fun main(): void {
    let before = Debug.live_objects;
    exercise();
    System.println(Debug.live_objects - before);
}
