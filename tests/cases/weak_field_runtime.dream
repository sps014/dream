// Runtime semantics of `weak`: a `weak` field does not keep its referent alive, and is reset to
// `None` once the referent becomes unreachable and GC runs — see `docs/language/memory.md`.
import system;
class Node {
    public value: int;
    public weak parent: Option<Node>;

    public constructor(value: int) {
        this.value = value;
        this.parent = Option.None;
    }
}

// `parent` is the only strong owner of the freshly-built `Node(99)`; it goes out of scope when
// this function returns. After a forced collection, `child.parent` must observe `None`.
fun attach_weak_parent(child: Node) {
    let parent = Node(99);
    child.parent = Option.Some(parent);
    switch (child.parent) {
        Some(p) => { System.println("inside: parent.value=" + p.value.to_string()); }
        None => { System.println("inside: parent is None (unexpected)"); }
    }
}

fun main() {
    let child = Node(1);
    attach_weak_parent(child);
    Debug.gc_collect();
    switch (child.parent) {
        Some(p) => { System.println("after: parent.value=" + p.value.to_string()); }
        None => { System.println("after: parent is None"); }
    }

    // Reassigning a `weak` field to a *live* referent must still work like an ordinary read.
    let other = Node(2);
    child.parent = Option.Some(other);
    switch (child.parent) {
        Some(p) => { System.println("live: parent.value=" + p.value.to_string()); }
        None => { System.println("live: parent is None (unexpected)"); }
    }
}
