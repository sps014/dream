import system;

class Session {
    public id: int;
    public constructor(id: int) {
        this.id = id;
    }
}

fun make_and_drop(): fun(): Option<Session> {
    let session = Session(1);
    let weak observer = session;
    return () => observer;
}

fun main(): void {
    let dead = make_and_drop();
    System.println(dead().is_none());
    let engine = Session(99);
    let weak alive = engine;
    System.println(alive.is_none());
    System.println(Debug.ref_count(engine).to_string());
}
