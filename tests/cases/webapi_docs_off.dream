import system;
import system.net;
import system.webapi;

@get("/health")
fun health(): string {
    return "ok";
}

async fun main(): void {
    let opts = WebAppOptions("T", "1", "", "/openapi.json");
    let port = WebApp.listen_with("127.0.0.1", 0, opts).await;
    let client = HttpClient("http://127.0.0.1:" + port.to_string());
    switch (client.get("/docs").await) {
        Ok(r) => System.println(r.status),
        Err(e) => System.println(e.message()),
    }
    switch (client.get("/openapi.json").await) {
        Ok(r) => System.println(r.status),
        Err(e) => System.println(e.message()),
    }
    WebApp.shutdown();
    WebApp.wait().await;
}
