import system;
import system.net;
import system.webapi;

@http_group("/api")
class Items {
    @get("/items")
    public static fun list(): string {
        return "ok";
    }
}

async fun main(): void {
    let port = WebApp.listen("127.0.0.1", 0).await;
    let client = HttpClient("http://127.0.0.1:" + port.to_string());
    switch (client.get("/api/items").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }
    switch (client.get("/openapi.json").await) {
        Ok(r) => System.println(r.text().contains("/api/items")),
        Err(e) => System.println(e.message()),
    }
    WebApp.shutdown();
    WebApp.wait().await;
}
