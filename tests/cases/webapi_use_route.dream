import system;
import system.net;
import system.webapi;

@use(require_auth)
@get("/secret")
fun secret(): string {
    return "s";
}

@get("/open")
fun open(): string {
    return "o";
}

async fun require_auth(borrow ctx: RequestContext, borrow next: Next): HttpOutgoing {
    if ctx.incoming.header("Authorization").is_none() {
        return HttpOutgoing.from_status(HttpStatus.unauthorized());
    }
    return next.call().await;
}

async fun main(): void {
    let port = WebApp.listen("127.0.0.1", 0).await;
    let client = HttpClient("http://127.0.0.1:" + port.to_string());
    switch (client.get("/open").await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }
    switch (client.get("/secret").await) {
        Ok(r) => System.println(r.status),
        Err(e) => System.println(e.message()),
    }
    let h = HttpHeaders();
    h.set("Authorization", "Bearer x");
    switch (client.get_with("/secret", h).await) {
        Ok(r) => System.println(r.text()),
        Err(e) => System.println(e.message()),
    }
    WebApp.shutdown();
    WebApp.wait().await;
}
