import system;
import system.net;
import system.webapi;

@websocket("/ws")
async fun echo(ws: ServerWebSocket): void {
    switch (ws.receive().await) {
        Ok(WebSocketMessage.Text(t)) => {
            let _ = ws.send_text(t).await;
        },
        Ok(_) => { },
        Err(_) => { }
    }
    ws.close();
}

async fun main(): void {
    let port = WebApp.listen("127.0.0.1", 0).await;
    let url = "ws://127.0.0.1:" + port.to_string() + "/ws";
    switch (WebSocket.connect(url).await) {
        Ok(client) => {
            let _ = client.send_text("ping").await;
            switch (client.receive().await) {
                Ok(WebSocketMessage.Text(t)) => System.println(t),
                Ok(_) => System.println("other"),
                Err(e) => System.println(e.message()),
            }
            client.close();
        },
        Err(e) => System.println(e.message()),
    }
    WebApp.shutdown();
    WebApp.wait().await;
}
