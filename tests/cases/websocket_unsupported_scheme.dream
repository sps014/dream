import system;
import system.net;

async fun main(): void {
    // Unknown schemes still resolve `Err(EUNSUPPORTED)`. `wss://` is supported on the native host
    // (TLS via tungstenite + native-tls); only non-ws schemes get `-2`.
    let result = await WebSocket.connect("ftp://example.invalid");
    switch (result) {
        Ok(ws) => {
            System.println("unexpected success");
            ws.close();
        },
        Err(e) => {
            System.println(e.code());
        },
    }
}
