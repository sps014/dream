// Per-element map replaces array wire: `T[]` itself is not shared.
import system;
import system.text;
struct Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

async fun main(): void {
    let nums = [1, 2, 3, 4, 5];
    let doubled = await WebWorker.map(nums, (n) => n * 2);
    let s1 = "";
    for (let i = 0; i < doubled.length; i = i + 1) {
        s1 = s1 + doubled[i] + " ";
    }
    System.println(s1.trim());

    let points = [Point(1, 2), Point(3, 4)];
    let shifted = await WebWorker.map(points, (p) => Point(p.x + 1, p.y + 1));
    let s2 = "";
    for (let i = 0; i < shifted.length; i = i + 1) {
        s2 = s2 + shifted[i].x + "," + shifted[i].y + " ";
    }
    System.println(s2.trim());
}
