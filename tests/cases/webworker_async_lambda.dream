// Async lambda as a `WebWorker` body via the `fun(TIn): Future<TOut>` spawn overload.
import system;
async fun main(): void {
    let w = WebWorker<string, string>.spawn("hi", async (msg) => {
        await Time.sleep(1);
        return msg + "!";
    });
    System.println(await w.join());
    w.terminate();
}
