// Async lambda body with a non-string `TOut` — the Future-body overload awaits then wire-encodes.
import system;
async fun main(): void {
    let w = WebWorker<int, int>.spawn(21, async (n) => {
        await Time.sleep(1);
        return n * 2;
    });
    System.println((await w.join()).to_string());
    w.terminate();
}
