import system;
async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch_async(async () => {
        Time.sleep(1).await;
        return "resp:x";
    });
    let b = pool.dispatch_async(async () => {
        Time.sleep(1).await;
        return "resp:y";
    });
    System.println(a.await);
    System.println(b.await);
    pool.shutdown();
}
