import system;
async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch_async(async () => {
        await Time.sleep(1);
        return "resp:x";
    });
    let b = pool.dispatch_async(async () => {
        await Time.sleep(1);
        return "resp:y";
    });
    System.println(await a);
    System.println(await b);
    pool.shutdown();
}
