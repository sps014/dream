// `WebWorker.map` also accepts an async body: each spawned worker drives its own body's awaits
// to completion independently before replying.
import system;
async fun fetchLike(url: string): string {
    await Time.sleep(1);
    return "resp:" + url;
}

async fun main(): void {
    let urls = ["a", "b", "c"];
    let results = await WebWorker<string, string>.map(urls, fetchLike);
    for (let r in results) {
        System.println(r);
    }
}
