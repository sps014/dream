// Real parallel WebWorkers. Capture-only spawn; await the Future.

import system;
fun shout(msg: string): string {
    return msg + "!";
}

fun twice(msg: string): string {
    return msg + msg;
}

async fun main(): void {
    System.println(await WebWorker.spawn(() => shout("hello")));
    System.println(await WebWorker.spawn(() => shout("world")));

    let a = WebWorker.spawn(() => shout("A"));
    let b = WebWorker.spawn(() => twice("B"));
    System.println(await a);
    System.println(await b);
}
