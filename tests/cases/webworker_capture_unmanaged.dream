// Capturing plain unmanaged/value locals into a `WebWorker` body is allowed.

import system;
async fun main(): void {
    let scale = 3;
    let offset = 3;
    let prefix = "result=";

    System.println(await WebWorker.spawn(() => {
        let result = scale + offset;
        if (result == 6) {
            return prefix + "ok";
        }
        return prefix + "bad";
    }));
}
