// Capturing an ordinary (non-`@shared`) managed object into a `WebWorker` body is a compile error.

class Counter {
    public value: int;

    public constructor() {
        this.value = 0;
    }
}

async fun main(): void {
    let counter = Counter();

    let _ = await WebWorker.spawn(() => {
        counter.value = counter.value + 1;
        return 0;
    });
}
