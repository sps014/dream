// Class/method type arguments on `WebWorker.spawn` / `.map` are inferred.
import system;

fun shout(msg: string): string {
    return msg + "!";
}

async fun main(): void {
    System.println(WebWorker.spawn(() => shout("hello")).await);

    let n = 6;
    System.println((WebWorker.spawn(() => n * n).await).to_string());

    let items = ["1", "2"];
    let results = WebWorker.map(items, shout).await;
    for (let r in results) {
        System.println(r);
    }
}
