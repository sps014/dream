// Class/method type arguments on `WebWorker.spawn` / `.map` are inferred.
import system;

fun shout(msg: string): string {
    return msg + "!";
}

async fun main(): void {
    System.println(await WebWorker.spawn(() => shout("hello")));

    let n = 6;
    System.println((await WebWorker.spawn(() => n * n)).to_string());

    let items = ["1", "2"];
    let results = await WebWorker.map(items, shout);
    for (let r in results) {
        System.println(r);
    }
}
