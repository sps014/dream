import system;
fun square(x: string): string {
    let n = int.parse(x).unwrap_or(0);
    return (n * n).to_string();
}

async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch(() => square("3"));
    let b = pool.dispatch(() => square("4"));
    let c = pool.dispatch(() => square("5"));
    let d = pool.dispatch(() => square("6"));
    System.println(await a);
    System.println(await b);
    System.println(await c);
    System.println(await d);
    pool.shutdown();
}
