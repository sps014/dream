import system;
fun square(n: int): int {
    return n * n;
}

async fun bump(n: int): int {
    Time.sleep(1).await;
    return n + 1;
}

async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch(() => square(3));
    let b = pool.dispatch(() => square(4));
    let c = pool.dispatch_async(() => bump(5));
    System.println((a.await).to_string());
    System.println((b.await).to_string());
    System.println((c.await).to_string());
    pool.shutdown();
}
