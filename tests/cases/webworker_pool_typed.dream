import system;
fun square(n: int): int {
    return n * n;
}

async fun bump(n: int): int {
    await Time.sleep(1);
    return n + 1;
}

async fun main(): void {
    let pool = WebWorkerPool(2);
    let a = pool.dispatch(() => square(3));
    let b = pool.dispatch(() => square(4));
    let c = pool.dispatch_async(() => bump(5));
    System.println((await a).to_string());
    System.println((await b).to_string());
    System.println((await c).to_string());
    pool.shutdown();
}
