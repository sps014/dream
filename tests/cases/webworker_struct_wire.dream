import system;
struct Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

fun shift(p: Point): Point {
    return Point(p.x + 1, p.y + 1);
}

async fun main(): void {
    let p = Point(1, 2);
    let r = await WebWorker.spawn(() => shift(p));
    System.println("" + r.x + "," + r.y);
}
