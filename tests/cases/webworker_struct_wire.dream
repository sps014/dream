// `WebWorker` supports an arbitrary `unmanaged` (blittable) value `struct` for wire args /
// results: it crosses as a raw byte-blit, reconstructed on the other side with the same layout.

import system;
struct Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

fun shift(p: Point): Point {
    return Point(p.x + 1, p.y + 1);
}

async fun main(): void {
    let w = WebWorker<Point, Point>.spawn(Point(1, 2), shift);
    let r = await w.join();
    System.println("" + r.x + "," + r.y);
    w.terminate();
}
