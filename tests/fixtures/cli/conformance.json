  {
    "name": "child",
    "request": {
      "command": {
        "name": "tool",
        "version": "2.0",
        "require_subcommand": true,
        "args": [
          {
            "name": "verbose",
            "kind": "flag"
          }
        ],
        "subcommands": [
          {
            "name": "check",
            "args": [
              {
                "name": "mode",
                "kind": "string",
                "default_value": "fast",
                "choices": [
                  "fast",
                  "slow"
                ]
              }
            ]
          }
        ]
      },
      "args": [
        "--verbose",
        "check",
        "--mode",
        "slow"
      ]
    },
    "expected": {
      "kind": "values",
      "values": {
        "verbose": {
          "values": [
            "true"
          ]
        }
      },
      "subcommand": {
        "name": "check",
        "values": {
          "mode": {
            "values": [
              "slow"
            ]
          }
        }
      }
    }
  },
