          {
            "name": "verbose",
            "kind": "flag",
            "short": "v"
          },
          {
            "name": "files",
            "kind": "positional",
            "multiple": true
          }
        ]
      },
      "args": [
        "-vv",
        "-n",
        "first",
        "--name=second",
        "--count",
        "-42"
      ]
    },
    "expected": {
      "kind": "values",
      "values": {
        "name": {
          "values": [
            "first",
            "second"
          ],
          "provided": true
        },
        "count": {
          "values": [
            "-42"
          ]
        },
        "verbose": {
          "values": [
            "true"
          ],
          "provided": true
        }
      }
    }
  },
