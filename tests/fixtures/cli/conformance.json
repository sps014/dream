[
  {
    "name": "defaults",
    "request": {
      "command": {
        "name": "probe",
        "description": "Read a value",
        "version": "1.2.3",
        "args": [
          {
            "name": "name",
            "kind": "string",
            "short": "n",
            "default_value": "world"
          },
          {
            "name": "count",
            "kind": "int",
            "default_value": "7"
          },
          {
            "name": "verbose",
            "kind": "flag",
            "short": "v"
          },
          {
            "name": "files",
            "kind": "positional",
            "multiple": true
          }
        ]
      },
      "args": []
    },
    "expected": {
      "kind": "values",
      "values": {
        "name": {
          "values": [
            "world"
          ],
          "provided": false
        },
        "count": {
          "values": [
            "7"
          ]
        },
        "verbose": {
          "values": [
            "false"
          ]
        },
        "files": {
          "values": []
        }
      }
    }
  },
  {
    "name": "repeat-and-negative",
    "request": {
      "command": {
        "name": "probe",
        "description": "Read a value",
        "version": "1.2.3",
        "args": [
          {
            "name": "name",
            "kind": "string",
