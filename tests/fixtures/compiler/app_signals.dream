import system;
import system.app;

async fun main(): int {
    return App.run(async () => {
        App.on_shutdown_requested((request) => {
            System.println("requested");
        });
        App.on_stop(async () => {
            System.println("cleanup start");
            Time.delay(1000).await;
            System.println("cleanup done");
        });
        System.println("ready");
        return Result.Ok(Unit());
    }).await;
}
