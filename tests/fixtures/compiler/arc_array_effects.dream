@noinline
fun writeone(borrow values: string[]): void {
    values[1] = "replacement";
}

@noinline
fun relayone(borrow values: string[]): void {
    writeone(values);
}

@noinline
fun writezero(borrow values: string[]): void {
    values[0] = "replacement";
}

@export
fun readother(borrow values: string[]): int {
    let value = values[0];
    relayone(values);
    return value.length;
}

@export
fun readsame(borrow values: string[]): int {
    let value = values[0];
    writezero(values);
    return value.length;
}
