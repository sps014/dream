import system;
import system.audio;
import system.encoding;

async fun main(): void {
    let wav = Encoding.base64_decode(
        "UklGRiwAAABXQVZFZm10IBAAAAABAAEAgLsAAAB3AQACABAAZGF0YQgAAAAAAAAgAMD/fw=="
    ).unwrap();
    let buffer = AudioBuffer.decode(wav).await.unwrap();
    if buffer.sample_rate != 48000 || buffer.channels != 1 || buffer.frame_count != 4 {
        System.panic("unexpected decoded audio metadata");
    }
    let analysis = AudioAnalyzer().analyze(buffer.read_pcm(0, 4).unwrap(), 48000, 1).unwrap();
    if analysis.peak < 0.99f || analysis.magnitudes.length != 1025 {
        System.panic("unexpected audio analysis");
    }
    System.println("audio offline: passed");
}
