// A named function and a lambda literal as C comparators: `const void*` arrives as `CPtr`, so each
// target gets its own C wrapper.
import system;

@c("c", "qsort")
extern fun qsort(base: int[], n: usize, size: usize, cmp: fun(CPtr, CPtr): int): void;

fun ascending(a: CPtr, b: CPtr): int {
    return Ffi.read_int(a, 0) - Ffi.read_int(b, 0);
}

fun show(xs: int[]): void {
    let line = "";
    for (let x in xs) {
        line = line + x + " ";
    }
    System.println(line);
}

fun main(): void {
    let xs: int[] = [5, 3, 9, 1, 7];
    qsort(xs, (usize)5, (usize)sizeof(int), ascending);
    show(xs);
    qsort(xs, (usize)5, (usize)sizeof(int), (a: CPtr, b: CPtr) => {
        return Ffi.read_int(b, 0) - Ffi.read_int(a, 0);
    });
    show(xs);
}
