import system;
import system.crypto;
import system.encoding;

fun main(): void {
    let empty = Sha256.hash(Array.alloc<byte>(0));
    System.println(Encoding.hex_encode(empty));

    let abc = ("abc").to_utf8();
    System.println(Encoding.hex_encode(Sha256.hash(abc)));

    let key = ("key").to_utf8();
    let msg = ("The quick brown fox jumps over the lazy dog").to_utf8();
    System.println(Encoding.hex_encode(HmacSha256.sign(key, msg)));

    System.println(Encoding.hex_encode(Sha512.hash(Array.alloc<byte>(0))));
    System.println(Encoding.hex_encode(Sha512.hash(abc)));

    let rnd = SecureRandom.bytes(8).unwrap();
    System.println(rnd.length);

    let buf = Array.alloc<byte>(16);
    SecureRandom.fill(buf).unwrap();
    System.println(buf.length);
}
