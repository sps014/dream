import system;
import system.drawing;
import system.drawing.gpu;
import system.gpu;
import system.window;

async fun check_drawing(backend: DrawingBackend): void {
    let canvas = Canvas(32, 32);
    canvas.clear(Color.black);
    canvas.fill_rect(16.0f, 0.0f, 16.0f, 32.0f, Color.white);
    canvas.backdrop(Rect(8.0f, 4.0f, 16.0f, 24.0f), Backdrop.blur(3.0f));
    canvas.fill_rect(14.0f, 12.0f, 4.0f, 8.0f, Color.rgb(255, 0, 0));
    let surface = DrawingSurface.create(32, 32, backend).await.unwrap();
    surface.render(canvas).unwrap();
    let pixels = surface.read_pixels().await.unwrap();
    let blurred = (int)pixels[(8 * 32 + 14) * 4];
    if pixels.length != 4096 || blurred <= 0 || blurred >= 255 {
        System.panic("drawing backdrop did not blur earlier content");
    }
    if (int)pixels[(16 * 32 + 4) * 4] != 0 {
        System.panic("drawing backdrop escaped its clip");
    }
    if (int)pixels[(16 * 32 + 16) * 4 + 1] != 0 {
        System.panic("drawing backdrop blurred later content");
    }
    surface.close();
}

async fun check_images_and_text(backend: DrawingBackend): void {
    let image = Image.from_rgba(1, 1, [(byte)255, 0, 0, 255]).await.unwrap();
    let canvas = Canvas(200, 64);
    canvas.draw_image(image, Rect(0, 32, 200, 32));
    let style = TextStyle(20, Color.white);
    let label = TextLayout.create("Hello नमस्ते", style).await.unwrap();
    canvas.fill_text(label, 2, 0, Color.white);
    canvas.fill_text("office", 120, 0, style);
    let surface = DrawingSurface.create(200, 64, backend).await.unwrap();
    surface.render(canvas).unwrap();
    let pixels = surface.read_pixels().await.unwrap();
    if (int)pixels[(48 * 200 + 20) * 4] != 255 {
        System.panic("drawing image did not render");
    }
    let ink = 0;
    for (let i = 0; i < 200 * 30; i = i + 1) {
        if (int)pixels[i * 4 + 3] > 128 {
            ink = ink + 1;
        }
    }
    if ink < 40 || label.width < 20.0f {
        System.panic("drawing text did not render");
    }
}

async fun check_existing_gpu_presentation(): void {
    let window = Window.canvas("drawing").unwrap();
    let device = GpuDevice.create(GpuBackend.WebGpu).await.unwrap();
    let surface = device.create_surface(window).unwrap();
    let canvas = Canvas(surface.width, surface.height);
    canvas.clear(Color.rgb(255, 0, 0));
    let cpu_drawing = DrawingSurface.create(surface.width, surface.height, DrawingBackend.Cpu)
        .await
        .unwrap();
    cpu_drawing.render(canvas).unwrap();
    cpu_drawing.present(surface).await.unwrap();
    cpu_drawing.close();
    let drawing = DrawingSurface.create(surface.width, surface.height, DrawingBackend.Gpu)
        .await
        .unwrap();
    drawing.render(canvas).unwrap();
    js.global.drawingDirectBegin();
    drawing.present(surface).await.unwrap();
    js.global.drawingDirectEnd();
    canvas.clear(Color.rgb(40, 100, 200));
    drawing.render(canvas).unwrap();
    js.global.drawingDirectBegin();
    drawing.present(surface).await.unwrap();
    js.global.drawingDirectEnd();
    js.global.drawingCheckpoint().await;
    let wrong_size = DrawingSurface.create(1, 1, DrawingBackend.Cpu).await.unwrap();
    if wrong_size.present(surface).await.is_ok() {
        System.panic("presentation accepted mismatched dimensions");
    }
    drawing.close();
    if drawing.present(surface).await.is_ok() {
        System.panic("presentation accepted a closed drawing surface");
    }
}

async fun check_copy_format(
    device: GpuDevice,
    drawing: DrawingSurface,
    format: GpuTextureFormat
): void {
    let texture = device.texture(GpuTextureDesc(16, 16, format)).unwrap();
    js.global.drawingDirectBegin();
    drawing.copy_to(texture).await.unwrap();
    drawing.copy_to(texture).await.unwrap();
    js.global.drawingDirectEnd();
    let pixels = texture.read(0).await.unwrap();
    let red = 0;
    let blue = 2;
    if format == GpuTextureFormat.Bgra8Unorm || format == GpuTextureFormat.Bgra8UnormSrgb {
        red = 2;
        blue = 0;
    }
    if (int)pixels[red]
        != 20 || (int)pixels[1] != 50 || (int)pixels[blue] != 100 || (int)pixels[3] != 128 {
        System.panic("direct drawing copy changed premultiplication or encoding");
    }
    texture.destroy();
}

async fun check_direct_copy(): void {
    let device = GpuDevice.create(GpuBackend.WebGpu).await.unwrap();
    let other = GpuDevice.create(GpuBackend.WebGpu).await.unwrap();
    let drawing = DrawingSurface.create(16, 16, DrawingBackend.Gpu).await.unwrap();
    let canvas = Canvas(16, 16);
    canvas.clear(Color.rgba(40, 100, 200, 0.5f));
    drawing.render(canvas).unwrap();
    check_copy_format(device, drawing, GpuTextureFormat.Rgba8Unorm).await;
    check_copy_format(device, drawing, GpuTextureFormat.Rgba8UnormSrgb).await;
    check_copy_format(device, drawing, GpuTextureFormat.Bgra8Unorm).await;
    check_copy_format(device, drawing, GpuTextureFormat.Bgra8UnormSrgb).await;
    let migrated = other.texture(GpuTextureDesc(16, 16, GpuTextureFormat.Rgba8Unorm)).unwrap();
    js.global.drawingDirectBegin();
    drawing.copy_to(migrated).await.unwrap();
    js.global.drawingDirectEnd();
    let pixels = migrated.read(0).await.unwrap();
    if (int)pixels[0] != 20 {
        System.panic("moving a drawing between devices lost its picture");
    }
    drawing.close();
    if drawing.copy_to(migrated).await.is_ok() {
        System.panic("direct copy accepted a closed drawing");
    }
    migrated.destroy();
}

async fun check_styles(backend: DrawingBackend): void {
    let canvas = Canvas(32, 32);
    let style = StrokeStyle(8);
    style.cap = StrokeCap.Round;
    let paint = Paint.linear(
        8,
        16,
        24,
        16,
        [
            GradientStop(0, Color.rgb(255, 0, 0)),
            GradientStop(0.5f, Color.rgb(255, 0, 0)),
            GradientStop(0.5f, Color.rgb(0, 0, 255)),
            GradientStop(1, Color.rgb(0, 0, 255))
        ]
    );
    canvas.stroke(DrawingPath().move_to(8, 16).line_to(24, 16), paint, style);
    let surface = DrawingSurface.create(32, 32, backend).await.unwrap();
    surface.render(canvas).unwrap();
    let pixels = surface.read_pixels().await.unwrap();
    if (int)pixels[(16 * 32 + 10) * 4]
        != 255
        || (int)pixels[(16 * 32 + 22) * 4 + 2] != 255 || (int)pixels[(16 * 32 + 5) * 4 + 3] < 200 {
        System.panic("gradient stroke or round cap failed");
    }
    canvas.clear(Color.rgb(64, 64, 64));
    canvas.save_layer(blend: BlendMode.Multiply);
    canvas.fill_rect(0, 0, 32, 32, Color.rgb(128, 128, 128));
    canvas.restore();
    surface.render(canvas).unwrap();
    let blended = surface.read_pixels().await.unwrap();
    if (int)blended[0] < 31 || (int)blended[0] > 33 {
        System.panic("group multiply failed");
    }
}

async fun check_effects(backend: DrawingBackend): void {
    let canvas = Canvas(32, 32);
    canvas.save_layer(effects: Option.Some(Effects().brightness(2).contrast(0)));
    canvas.fill_rect(8, 8, 12, 12, Color.rgba(255, 0, 0, 0.5f));
    canvas.restore();
    let surface = DrawingSurface.create(32, 32, backend).await.unwrap();
    surface.render(canvas).unwrap();
    let pixels = surface.read_pixels().await.unwrap();
    let at = (12 * 32 + 12) * 4;
    if (int)pixels[at] < 63
        || (int)pixels[at] > 65
        || (int)pixels[at + 1] < 63 || (int)pixels[at + 3] != 128 || (int)pixels[0] != 0 {
        System.panic("color effects changed order or alpha");
    }
    canvas.clear(Color.transparent);
    canvas.save_layer(
        effects: Option.Some(Effects().shadow(8, 0, 2, Color.rgba(0, 0, 255, 0.5f)).blur(1))
    );
    canvas.fill_rect(8, 8, 12, 12, Color.rgb(255, 0, 0));
    canvas.restore();
    surface.render(canvas).unwrap();
    let shadow = surface.read_pixels().await.unwrap();
    if (int)shadow[(14 * 32 + 25) * 4 + 2] < 10 {
        System.panic("spatial effects did not render");
    }
}

async fun check_materials(backend: DrawingBackend): void {
    let canvas = Canvas(128, 32);
    canvas.fill_rect(0, 0, 128, 32, Color.rgba(100, 100, 100, 0.5f));
    canvas.backdrop(Rect(0, 0, 128, 32), Backdrop.blur(0).noise(0.3f, seed: -12345));
    let surface = DrawingSurface.create(128, 32, backend).await.unwrap();
    surface.render(canvas).unwrap();
    let pixels = surface.read_pixels().await.unwrap();
    let changes = 0;
    for (let i = 0; i < 128 * 32; i = i + 1) {
        if (int)pixels[i * 4 + 3] != 128 {
            System.panic("noise changed alpha");
        }
        if i > 0 && pixels[i * 4] != pixels[(i - 1) * 4] {
            changes = changes + 1;
        }
    }
    if changes < 500 || pixels[(8 * 128 + 8) * 4] != pixels[(8 * 128 + 72) * 4] {
        System.panic("grain is missing or not tiled");
    }
    canvas.clear(Color.rgb(255, 0, 0));
    canvas.save_layer(opacity: 0.5f);
    canvas.fill_rect(0, 0, 128, 32, Color.rgba(0, 0, 255, 0.5f));
    canvas.backdrop(Rect(0, 0, 128, 32), Backdrop.blur(0));
    canvas.restore();
    surface.render(canvas).unwrap();
    let nested = surface.read_pixels().await.unwrap();
    if (int)nested[0] < 190 || (int)nested[0] > 192 || (int)nested[2] < 63 || (int)nested[2] > 65 {
        System.panic("nested backdrop sampled parent content");
    }
    canvas.clear(Color.transparent);
    canvas.save_layer(
        effects: Option.Some(Effects().shadow(4, 4, 3, Color.black).saturation(0.8f))
    );
    canvas.fill_rect(4, 4, 20, 20, Color.white);
    canvas.backdrop(Rect(8, 8, 12, 12), Backdrop.blur(2).noise(0.04f));
    canvas.restore();
    surface.render(canvas).unwrap();
    canvas.clear(Color.rgb(64, 128, 192));
    canvas.save();
    canvas.clip(DrawingPath.rect(Rect(0, 0, 96, 32)));
    canvas.backdrop(Rect(16, 4, 48, 24), Backdrop.blur(0));
    canvas.restore();
    surface.render(canvas).unwrap();
    let clipped = surface.read_pixels().await.unwrap();
    if (int)clipped[(8 * 128 + 8) * 4] != 64 || (int)clipped[(8 * 128 + 8) * 4 + 3] != 255 {
        System.panic("backdrop erased pixels outside its clip intersection");
    }
}

async fun main(): void {
    check_drawing(DrawingBackend.Cpu).await;
    check_drawing(DrawingBackend.Gpu).await;
    check_images_and_text(DrawingBackend.Cpu).await;
    check_images_and_text(DrawingBackend.Gpu).await;
    check_styles(DrawingBackend.Cpu).await;
    check_styles(DrawingBackend.Gpu).await;
    check_effects(DrawingBackend.Cpu).await;
    check_effects(DrawingBackend.Gpu).await;
    check_materials(DrawingBackend.Cpu).await;
    check_materials(DrawingBackend.Gpu).await;
    check_direct_copy().await;
    check_existing_gpu_presentation().await;
    System.println("drawing-browser-passed");
}
