import system;
import system.net;
import system.io;
import system.testing;

@test
async fun http_client(): void {
    let base = Url.parse("__BASE__/").unwrap();
    let client = HttpClient();
    let request = HttpRequest(HttpMethod.Post, base.resolve("echo").unwrap());
    request.set_text("hello 日本語");
    request.headers.append("X-Repeat", "a");
    request.headers.append("X-Repeat", "b");
    let response = client.send(request).await.unwrap();
    Assert.eq(response.status, 404);
    Assert.eq(response.headers.get("x-method").unwrap(), "POST");
    Assert.eq(response.read_text().await.unwrap(), "hello 日本語");
    response.close().unwrap();
    response.close().unwrap();
    Assert.is_true(response.body.read_async(1).await.is_err());
    let stream = client.send(HttpRequest(HttpMethod.Get, base.resolve("redirect").unwrap()))
        .await
        .unwrap();
    Assert.eq(stream.status, 200);
    Assert.is_true(stream.url.to_string().ends_with("/stream"));
    let memory = MemoryStream();
    Assert.eq(Streams.copy_async(stream.body, memory, 2).await.unwrap(), 11L);
    Assert.eq(Encoding.utf8_decode(memory.to_bytes().unwrap()), "firstsecond");
    stream.close().unwrap();
    memory.close().unwrap();
    let limited = client.send(HttpRequest(HttpMethod.Get, base.resolve("stream").unwrap()))
        .await
        .unwrap();
    let too_large = limited.read_text(max_bytes: 3).await;
    Assert.eq(too_large.unwrap_err().code(), "ELIMIT");
    limited.close().unwrap();
    let invalid = client.send(HttpRequest(HttpMethod.Get, base.resolve("invalid-utf8").unwrap()))
        .await
        .unwrap();
    Assert.eq(invalid.read_text().await.unwrap_err().code(), "EENCODING");
    invalid.close().unwrap();
    let redirect = client.send(
        HttpRequest(HttpMethod.Get, base.resolve("redirect").unwrap()),
        options: HttpOptions(max_redirects: 0)
    ).await.unwrap();
    Assert.eq(redirect.status, 302);
    redirect.close().unwrap();
    let looped = client.send(
        HttpRequest(HttpMethod.Get, base.resolve("loop").unwrap()),
        options: HttpOptions(max_redirects: 1)
    ).await;
    Assert.eq(looped.unwrap_err().code(), "EREDIRECT");
    let timeout = client.send(
        HttpRequest(HttpMethod.Get, base.resolve("slow").unwrap()),
        options: HttpOptions(timeout_ms: 20)
    ).await;
    Assert.eq(timeout.unwrap_err().code(), "ETIMEOUT");
    let cancellation = CancellationSource();
    let pending = client.send(
        HttpRequest(HttpMethod.Get, base.resolve("slow").unwrap()),
        token: Option.Some(cancellation.token)
    );
    Promise.start(pending);
    Time.delay(10).await;
    cancellation.cancel();
    Assert.eq(pending.await.unwrap_err().code(), "ECANCELLED");
    // Cancelled host frames release their final pin on the scheduler's next completion drain.
    Time.delay(1).await;
    client.close().unwrap();
    client.close().unwrap();
    Assert.eq(client.send(HttpRequest(HttpMethod.Get, base)).await.unwrap_err().code(), "ECLOSED");
}

@test
async fun http_cookies(): void {
    let base = Url.parse("__BASE__/cookies/").unwrap();
    let jar = CookieJar();
    if !HttpCapabilities.cookie_jars {
        Assert.eq(jar.store(base, "seed=1").unwrap_err().code(), "ENOTSUP");
        let unsupported = HttpClient(cookies: Option.Some(jar));
        Assert.eq(
            unsupported.send(HttpRequest(HttpMethod.Get, base)).await.unwrap_err().code(),
            "ENOTSUP"
        );
        unsupported.close().unwrap();
        return;
    }
    let defaults = HttpClient();
    Assert.is_true(defaults.cookies.is_some());
    let set = defaults.send(HttpRequest(HttpMethod.Get, base.resolve("set").unwrap()))
        .await
        .unwrap();
    set.close().unwrap();
    Assert.eq(defaults.cookies.unwrap().header(base).unwrap(), "session=stored");
    defaults.close().unwrap();

    jar.store(base, "seed=1; Path=/cookies").unwrap();
    let client = HttpClient(cookies: Option.Some(jar));
    let second_client = HttpClient(cookies: Option.Some(jar));
    let response = client.send(HttpRequest(HttpMethod.Get, base.resolve("set").unwrap()))
        .await
        .unwrap();
    response.close().unwrap();
    let echo = second_client.send(HttpRequest(HttpMethod.Get, base.resolve("echo").unwrap()))
        .await
        .unwrap();
    let text = echo.read_text().await.unwrap();
    Assert.is_true(text.contains("seed=1"));
    Assert.is_true(text.contains("session=stored"));
    echo.close().unwrap();

    let request = HttpRequest(HttpMethod.Get, base.resolve("echo").unwrap());
    request.headers.set("Cookie", "manual=1");
    let manual = client.send(request).await.unwrap();
    Assert.eq(manual.read_text().await.unwrap(), "manual=1");
    manual.close().unwrap();
    jar.clear().unwrap();
    Assert.eq(second_client.cookies.unwrap().header(base).unwrap(), "");

    let disabled = HttpClient(use_cookies: false, cookies: Option.Some(jar));
    let ignored = disabled.send(HttpRequest(HttpMethod.Get, base.resolve("set").unwrap()))
        .await
        .unwrap();
    ignored.close().unwrap();
    Assert.eq(jar.header(base).unwrap(), "");
    disabled.close().unwrap();
    client.close().unwrap();
    second_client.close().unwrap();
}
