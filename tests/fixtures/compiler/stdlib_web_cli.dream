import system;
import system.cli;

fun main(): void {
    let command = Command("browser").version("1.0")
        .int_option("count", default_value: 7)
        .string_option("name", default_value: "world")
        .flag("verbose", short: "v")
        .positional("files", multiple: true);
    let parsed = command.parse(["-vv", "--count", "-42", "--name", "日本語", "--", "", "two words"]).unwrap();
    if parsed.get_int("count").unwrap() != -42 { System.panic("CLI integer mismatch"); }
    if parsed.get_string("name").unwrap() != "日本語" { System.panic("CLI Unicode mismatch"); }
    if !parsed.get_bool("verbose").unwrap() { System.panic("CLI flag mismatch"); }
    if parsed.get_strings("files").unwrap().length != 2 { System.panic("CLI positional mismatch"); }
    if !command.parse(["--help"]).unwrap().help_text.contains("Usage: browser") { System.panic("CLI help mismatch"); }
    if command.parse(["--version"]).unwrap().version_text != "browser 1.0\n" { System.panic("CLI version mismatch"); }
    if !command.parse(["--count", "oops"]).is_err() { System.panic("CLI validation mismatch"); }
    if !Command("bad").flag("help").parse([]).is_err() { System.panic("CLI schema mismatch"); }
    System.println("browser CLI fixture passed");
}
