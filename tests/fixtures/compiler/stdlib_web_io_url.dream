import system;
import system.io;
import system.http;

async fun main(): void {
    let url = Url.parse("HTTPS://Example.COM:443/a/../v1/").unwrap().resolve("users").unwrap();
    url.query.append("role", "admin");
    url.query.append("role", "editor");
    if url.to_string() != "https://example.com/v1/users?role=admin&role=editor" {
        System.panic("URL mismatch");
    }
    let file = FileHandle.open_async("browser.txt", FileMode.WriteRead).await.unwrap();
    file.write_async(("hello browser").to_utf8()).await.unwrap();
    file.seek_async(0L).await.unwrap();
    if string.from_utf8(file.read_async(100).await.unwrap()) != "hello browser" {
        System.panic("file mismatch");
    }
    file.close().unwrap();
    File.delete("browser.txt");
    System.println("browser URL and async file fixture passed");
}
