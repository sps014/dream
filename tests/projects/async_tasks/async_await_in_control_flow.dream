import system.testing;
// `await` may appear in *any* control-flow position — inside a branch, a loop body, a loop
// condition, a `for-in` body, a `switch` arm, a ternary arm, and the right operand of `&&`/`??`.
// The coroutine transform lowers the whole body to a CFG state machine where each `await` is a
// suspend point, so each of these resumes correctly (including a loop that suspends every iteration).

import system;
async fun c2c_g(n: int): int { return n; }
async fun c2c_ready(): bool { return true; }

async fun c2c_in_branch(b: int): int {
    let acc = 0;
    if b == 2 { acc = acc + c2c_g(3).await; }     // `.await` inside a branch body
    else { acc = acc + c2c_g(7).await; }
    return acc;
}

async fun c2c_in_loop(): int {
    let sum = 0;
    let i = 0;
    while i < 4 { sum = sum + c2c_g(i).await; i = i + 1; }   // `.await` every iteration
    return sum;                                            // 0+1+2+3 = 6
}

async fun c2c_in_foreach(): int {
    let xs: int[] = [1, 2, 3];
    let total = 0;
    for (let x in xs) { total = total + c2c_g(x * 2).await; }  // `.await` inside for-in
    return total;                                          // 2+4+6 = 12
}

async fun c2c_in_switch(n: int): int {
    switch (n) {
        case 0:
            return c2c_g(100).await;
        default:
            return c2c_g(200).await;
    }
    return -1;
}

async fun c2c_in_ternary(flag: bool): int {
    let v = flag ? c2c_g(7).await : c2c_g(9).await;     // `.await` in a ternary arm
    return v;
}

async fun c2c_in_shortcircuit(flag: bool): bool {
    let ok = flag && c2c_ready().await;             // `.await` in the right operand of `&&`
    return ok;
}

async fun c2c_body(): void {
    c2c_verify_observation((c2c_in_branch(2).await).to_string());         // 3
    c2c_verify_observation((c2c_in_branch(5).await).to_string());         // 7
    c2c_verify_observation((c2c_in_loop().await).to_string());            // 6
    c2c_verify_observation((c2c_in_foreach().await).to_string());         // 12
    c2c_verify_observation((c2c_in_switch(0).await).to_string());         // 100
    c2c_verify_observation((c2c_in_switch(1).await).to_string());         // 200
    c2c_verify_observation((c2c_in_ternary(true).await).to_string());     // 7
    c2c_verify_observation((c2c_in_shortcircuit(true).await).to_string()); // true
}

let c2c_cursor: int = 0;

fun c2c_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "3\n7\n6\n12\n100\n200\n7\ntrue\n";
    let end = c2c_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c2c_cursor, end));
    c2c_cursor = end;
}

@test
@timeout(180000)

async fun async_await_in_control_flow(): void {
    c2c_cursor = 0;
    c2c_body().await;
    Assert.eq(c2c_cursor, ("3\n7\n6\n12\n100\n200\n7\ntrue\n").length);
}
