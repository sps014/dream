import system.testing;
// Control flow (branches, loops, early returns) that runs *before* an `await` must not prematurely
// complete the async task: each poll segment's natural fall-through hands control to the suspend,
// while an explicit `return` still completes. Regression for segments whose plain code has an `if`.
import system;

async fun c2f_g(n: int): int {
    return n;
}

async fun c2f_pick(early: bool): int {
    if early {
        return 99;
    } // explicit return in a branch before the suspend
    let y = c2f_g(5).await;
    return y + 1;
}

async fun c2f_run(): int {
    let sum = 0;
    let i = 0;
    while i < 4 {
        sum = sum + i;
        i = i + 1;
    } // loop before the suspend
    let a = c2f_g(1).await;
    if a == 1 {
        a = a + 10;
    } // branch between two awaits
    let b = c2f_g(2).await;
    return sum + a + b;
}

async fun c2f_body(): void {
    c2f_verify_observation((c2f_pick(true).await).to_string()); // 99
    c2f_verify_observation((c2f_pick(false).await).to_string()); // 6
    c2f_verify_observation((c2f_run().await).to_string()); // 6 + 11 + 2 = 19
}

let c2f_cursor: int = 0;

fun c2f_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "99\n6\n19\n";
    let end = c2f_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c2f_cursor, end));
    c2f_cursor = end;
}

@test
@timeout(180000)

async fun async_branch_before_await(): void {
    c2f_cursor = 0;
    c2f_body().await;
    Assert.eq(c2f_cursor, ("99\n6\n19\n").length);
}
