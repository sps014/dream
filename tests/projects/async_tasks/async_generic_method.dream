import system.testing;
// Async methods on a generic class: each monomorphization (`Cell<int>`, `Cell<string>`) regenerates
// its own async state machine, so awaiting a generic method resolves with the concrete type.
import system;

class c33_Cell<T> {
    public value: T;
    public constructor(value: T) {
        this.value = value;
    }

    public async fun get(): T {
        Time.sleep(10).await;
        return this.value;
    }
}

@test
@timeout(180000)
async fun async_generic_method(): void {
    let a = c33_Cell<int>(42);
    let ra = a.get().await;
    Assert.eq_str((ra).to_string(), "42");

    let b = c33_Cell<string>("hello");
    let rb = b.get().await;
    Assert.eq_str((rb).to_string(), "hello");
}
