import system.testing;
import system;

async fun c35_apply_async(f: fun(int): Future<int>, v: int): int {
    return f(v).await;
}

@test
@timeout(180000)
async fun async_lambda_basic(): void {
    let twice: fun(int): Future<int> = async (x) => {
        Time.sleep(1).await;
        return x * 2;
    };
    Assert.eq((twice(21).await).to_string(), "42");
    Assert.eq((c35_apply_async(async (n) => n + 100, 1).await).to_string(), "101");
}
