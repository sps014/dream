import system.testing;
import system;
class c38_Worker {
    public base: int;

    public constructor(base: int) {
        this.base = base;
    }

    public async fun compute(n: int): int {
        Time.sleep(10).await;
        return this.base + n;
    }

    public async fun twice(n: int): int {
        let once = this.compute(n).await;
        return once + once;
    }
}

@test
@timeout(180000)
async fun async_method(): void {
    let w = c38_Worker(100);
    let r = w.compute(5).await;
    Assert.eq_str((r).to_string(), "105");

    let t = w.twice(1).await;
    Assert.eq_str((t).to_string(), "202");
}
