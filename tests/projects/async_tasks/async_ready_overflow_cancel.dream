import system.testing;
import system;

async fun c3c_value(n: int): int { return n; }

async fun c3c_body(): void {
    let pending = Buffer.alloc<Future<int>>(512);
    for (let i = 0; i < pending.length; i = i + 1) {
        pending[i] = c3c_value(i);
        Promise.start(pending[i]);
    }
    for (let i = 0; i < pending.length; i = i + 2) { Promise.cancel(pending[i]); }
    let results = Promise.all(pending).await;
    let sum = 0;
    for (let i = 0; i < results.length; i = i + 1) { sum = sum + results[i]; }
    c3c_verify_observation((sum).to_string());
}

let c3c_cursor: int = 0;

fun c3c_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "65536\n";
    let end = c3c_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c3c_cursor, end));
    c3c_cursor = end;
}

@test
@timeout(180000)

async fun async_ready_overflow_cancel(): void {
    c3c_cursor = 0;
    c3c_body().await;
    Assert.eq(c3c_cursor, ("65536\n").length);
}
