import system.testing;
// Exercises reference-typed parameters and locals across suspension points.
// Prior to the fix, string params were not retained by the async frame, and
// string locals were leaked (never released) when the task completed.
// Poll bodies now run RcInsertion; sink params store the caller's +1 without a
// second ctor retain (which previously permanently over-counted).

import system;
async fun c3d_greet(name: string): string {
    Time.sleep(0).await;
    let msg = "Hello, " + name + "!";
    return msg;
}

async fun c3d_echo(value: string): string {
    let prefix = "echo: ";
    Time.sleep(0).await;
    return prefix + value;
}

@test
@timeout(180000)
async fun async_ref_params(): void {
    let g = c3d_greet("World").await;
    Assert.eq_str((g).to_string(), "Hello, World!");
    let e = c3d_echo("dream").await;
    Assert.eq_str((e).to_string(), "echo: dream");
}
