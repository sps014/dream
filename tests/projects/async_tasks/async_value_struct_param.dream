import system.testing;
// Regression test: an `async fun` parameter of a value(`struct`) type must be copied by value into
// the coroutine's own `Future` frame, not aliased to the caller's (possibly transient) storage -
// same by-value contract `emit_value_frame_prologue` gives an ordinary function's value params.
import system;

struct c3f_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

async fun c3f_shift(p: c3f_Point): c3f_Point {
    Time.sleep(1).await;
    return c3f_Point(p.x + 1, p.y + 1);
}

@test
@timeout(180000)
async fun async_value_struct_param(): void {
    let a = c3f_shift(c3f_Point(1, 2)).await;
    let b = c3f_shift(c3f_Point(3, 4)).await;
    Assert.eq_str(("" + a.x + "," + a.y).to_string(), "2,3");
    Assert.eq_str(("" + b.x + "," + b.y).to_string(), "4,5");
}
