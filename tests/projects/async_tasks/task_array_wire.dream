import system.testing;
// Per-element map replaces array wire: `T[]` itself is not shared.
import system;
import system.task;
import system.text;

struct c240_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

async fun c240_body(): void {
    let nums = [1, 2, 3, 4, 5];
    let doubled = TaskPool(4).map(nums, (n) => n * 2).await.unwrap();
    let s1 = "";
    for (let i = 0; i < doubled.length; i = i + 1) {
        s1 = s1 + doubled[i] + " ";
    }
    c240_verify_observation((s1.trim()).to_string());

    let points = [c240_Point(1, 2), c240_Point(3, 4)];
    let shifted = TaskPool(4).map(points, (p) => c240_Point(p.x + 1, p.y + 1)).await.unwrap();
    let s2 = "";
    for (let i = 0; i < shifted.length; i = i + 1) {
        s2 = s2 + shifted[i].x + "," + shifted[i].y + " ";
    }
    c240_verify_observation((s2.trim()).to_string());
}

let c240_cursor: int = 0;

fun c240_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "2 4 6 8 10\n2,3 4,5\n";
    let end = c240_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c240_cursor, end));
    c240_cursor = end;
}

@test
@timeout(180000)

async fun task_array_wire(): void {
    c240_cursor = 0;
    c240_body().await;
    Assert.eq(c240_cursor, ("2 4 6 8 10\n2,3 4,5\n").length);
}
