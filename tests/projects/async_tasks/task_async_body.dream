import system.testing;
import system;
import system.task;

async fun c241_tick(): void {
    Time.sleep(1).await;
}

async fun c241_work(): string {
    c241_tick().await;
    return "hi!";
}

@test
@timeout(180000)
async fun task_async_body(): void {
    Assert.eq((Task.spawn_async(c241_work).await).to_string(), "hi!");
}
