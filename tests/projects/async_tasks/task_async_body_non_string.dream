import system.testing;
import system;
import system.task;

async fun c242_computeInt(): int {
    Time.sleep(1).await;
    return 21 * 2;
}

@test
@timeout(180000)
async fun task_async_body_non_string(): void {
    Assert.eq_str(((Task.spawn_async(c242_computeInt).await).to_string()).to_string(), "42");
}
