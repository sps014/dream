import system.testing;
import system;
import system.task;

@test
@timeout(180000)
async fun task_async_lambda_int(): void {
    let n = 21;
    Assert.eq(
        (
            (
                Task.spawn_async(
                    async () => {
                        Time.sleep(1).await;
                        return n * 2;
                    }
                ).await
            ).to_string()
        ).to_string(),
        "42"
    );
}
