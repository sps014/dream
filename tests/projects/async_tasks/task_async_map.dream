import system.testing;
import system;
import system.task;
async fun c247_fetchLike(url: string): string {
    Time.sleep(1).await;
    return "resp:" + url;
}

async fun c247_body(): void {
    let urls = ["a", "b", "c"];
    let results = TaskPool(4).map_async(urls, c247_fetchLike).await.unwrap();
    for (let r in results) {
        c247_verify_observation((r).to_string());
    }
}

let c247_cursor: int = 0;

fun c247_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "resp:a\nresp:b\nresp:c\n";
    let end = c247_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c247_cursor, end));
    c247_cursor = end;
}

@test
@timeout(180000)

async fun task_async_map(): void {
    c247_cursor = 0;
    c247_body().await;
    Assert.eq(c247_cursor, ("resp:a\nresp:b\nresp:c\n").length);
}
