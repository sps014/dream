import system.testing;
import system;
import system.task;

// Cooperative cancel: capture an `@shared` CancellationToken into a spawn body and poll it.
@test
@timeout(180000)
async fun task_cancel_token(): void {
    let src = CancellationSource();
    let tok = src.token;
    let w = Task.spawn(
        () => {
            let n = 0;
            while !tok.is_cancelled {
                n = n + 1;
                if n > 1000000 {
                    break;
                }
            }
            return n;
        }
    );
    src.cancel();
    let n = w.await;
    Assert.is_true(n > 0 || tok.is_cancelled);
}

// Hard terminate: cancelling the spawn Future aborts a busy worker.
@test
@timeout(180000)
async fun task_terminate_busy(): void {
    let f = Task.spawn(
        () => {
            while true {}
            return 0;
        }
    );
    Promise.cancel(f);
}

// A Task body that starts a host timer and returns leaves the timer running after its reply.
// Its worker must not serve a later Task, or the timer would settle into that Task's thread.
fun c24c_leave_timer(n: int): int {
    Promise.start(Time.delay(50));
    return n;
}

@test
@timeout(180000)
async fun task_detached_host_call(): void {
    Assert.eq(Task.spawn(() => c24c_leave_timer(1)).await, 1);
    let total = 0;
    let i = 0;
    while i < 20 {
        total = total + Task.spawn(() => i * 2).await;
        i = i + 1;
    }
    Time.delay(100).await;
    Assert.eq(total, 380);
}
