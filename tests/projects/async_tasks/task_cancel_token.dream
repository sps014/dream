import system.testing;
// Cooperative cancel: capture an `@shared` CancellationToken into a spawn body and poll it.
import system;
import system.task;

async fun c24a_body(): void {
    let src = CancellationSource();
    let tok = src.token;
    let w = Task.spawn(() => {
        let n = 0;
        while !tok.is_cancelled {
            n = n + 1;
            if n > 1000000 {
                break;
            }
        }
        return n;
    });
    src.cancel();
    let n = w.await;
    c24a_verify_observation((n > 0 || tok.is_cancelled).to_string());
}

let c24a_cursor: int = 0;

fun c24a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "true\n";
    let end = c24a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c24a_cursor, end));
    c24a_cursor = end;
}

@test
@timeout(180000)

async fun task_cancel_token(): void {
    c24a_cursor = 0;
    c24a_body().await;
    Assert.eq(c24a_cursor, ("true\n").length);
}
