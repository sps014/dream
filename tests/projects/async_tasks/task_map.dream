import system.testing;
// `Task.map` fans a `body` out over `items`.
import system;
import system.task;

fun c250_square(x: string): string {
    let n = int.parse(x).unwrap_or(0);
    return (n * n).to_string();
}

async fun c250_body(): void {
    let items = ["1", "2", "3", "4", "5"];
    let results = TaskPool(4).map(items, c250_square).await.unwrap();
    for (let r in results) {
        c250_verify_observation((r).to_string());
    }
}

let c250_cursor: int = 0;

fun c250_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "1\n4\n9\n16\n25\n";
    let end = c250_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c250_cursor, end));
    c250_cursor = end;
}

@test
@timeout(180000)

async fun task_map(): void {
    c250_cursor = 0;
    c250_body().await;
    Assert.eq(c250_cursor, ("1\n4\n9\n16\n25\n").length);
}
