import system.testing;
import system;
import system.task;

fun c252_square(x: string): string {
    let n = int.parse(x).unwrap_or(0);
    return (n * n).to_string();
}

@test
@timeout(180000)
async fun task_pool(): void {
    let pool = TaskPool(2);
    let a = pool.dispatch(() => c252_square("3"));
    let b = pool.dispatch(() => c252_square("4"));
    let c = pool.dispatch(() => c252_square("5"));
    let d = pool.dispatch(() => c252_square("6"));
    Assert.eq(a.await.unwrap(), "9");
    Assert.eq(b.await.unwrap(), "16");
    Assert.eq(c.await.unwrap(), "25");
    Assert.eq(d.await.unwrap(), "36");
    pool.close().await.unwrap();
}

fun c254_square(n: int): int {
    return n * n;
}

async fun c254_bump(n: int): int {
    Time.sleep(1).await;
    return n + 1;
}

@test
@timeout(180000)
async fun task_pool_typed(): void {
    let pool = TaskPool(2);
    let a = pool.dispatch(() => c254_square(3));
    let b = pool.dispatch(() => c254_square(4));
    let c = pool.dispatch_async(async () => c254_bump(5).await);
    let d = pool.dispatch_async(
        async () => {
            Time.sleep(1).await;
            return "resp:x";
        }
    );
    Assert.eq(a.await.unwrap(), 9);
    Assert.eq(b.await.unwrap(), 16);
    Assert.eq(c.await.unwrap(), 6);
    Assert.eq(d.await.unwrap(), "resp:x");
    pool.close().await.unwrap();
}

@test
@timeout(180000)
async fun task_pool_hundred(): void {
    let pool = TaskPool(100);
    let total = 0;
    for (let i = 0; i < 100; i = i + 1) {
        total = total + pool.dispatch(() => i).await.unwrap();
    }
    pool.close().await.unwrap();
    Assert.eq(total, 4950);
}
