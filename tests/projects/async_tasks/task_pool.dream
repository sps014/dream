import system.testing;
import system;
import system.task;

fun c252_square(x: string): string {
    let n = int.parse(x).unwrap_or(0);
    return (n * n).to_string();
}

@test
@timeout(180000)
async fun task_pool(): void {
    let pool = TaskPool(2);
    let a = pool.dispatch(() => c252_square("3"));
    let b = pool.dispatch(() => c252_square("4"));
    let c = pool.dispatch(() => c252_square("5"));
    let d = pool.dispatch(() => c252_square("6"));
    Assert.eq(a.await.unwrap(), "9");
    Assert.eq(b.await.unwrap(), "16");
    Assert.eq(c.await.unwrap(), "25");
    Assert.eq(d.await.unwrap(), "36");
    pool.close().await.unwrap();
}

fun c254_square(n: int): int {
    return n * n;
}

async fun c254_bump(n: int): int {
    Time.sleep(1).await;
    return n + 1;
}

@test
@timeout(180000)
async fun task_pool_typed(): void {
    let pool = TaskPool(2);
    let a = pool.dispatch(() => c254_square(3));
    let b = pool.dispatch(() => c254_square(4));
    let c = pool.dispatch_async(async () => c254_bump(5).await);
    let d = pool.dispatch_async(
        async () => {
            Time.sleep(1).await;
            return "resp:x";
        }
    );
    Assert.eq(a.await.unwrap(), 9);
    Assert.eq(b.await.unwrap(), 16);
    Assert.eq(c.await.unwrap(), 6);
    Assert.eq(d.await.unwrap(), "resp:x");
    pool.close().await.unwrap();
}

struct TaskWirePair {
    public whole: long;
    public part: double;
}

enum TaskWireColor {
    Red,
    Green,
    Blue,
}

@test
@timeout(180000)
async fun task_wire_scalars(): void {
    Assert.eq(Task.spawn(() => 9223372036854775807L).await, 9223372036854775807L);
    Assert.eq(Task.spawn(() => -9223372036854775807L - 1L).await, -9223372036854775807L - 1L);
    let pi: double = 3.141592653589793;
    Assert.is_true(Task.spawn<double>(() => pi).await == pi);
    let zero: double = -0.0;
    let negative_zero: double = Task.spawn<double>(() => zero).await;
    let one: double = 1.0;
    Assert.is_true(one / negative_zero < zero);
    Assert.is_true(Task.spawn(() => true).await);
    Assert.eq((int)Task.spawn(() => (byte)255).await, 255);
    Assert.is_true(Task.spawn<float>(() => 1.5f).await == 1.5f);
    Assert.is_true(Task.spawn(() => TaskWireColor.Blue).await == TaskWireColor.Blue);
    let pair = Task.spawn(
        () => {
            let value = TaskWirePair();
            value.whole = -42L;
            value.part = 0.1;
            return value;
        }
    ).await;
    Assert.eq(pair.whole, -42L);
    Assert.is_true(pair.part == 0.1);
    let pool = TaskPool(2);
    let huge: double = 1e300;
    Assert.is_true(pool.dispatch<double>(() => huge).await.unwrap() == huge);
    pool.close().await.unwrap();
}

// Dispatches beyond the pool size queue for the next free worker; a cancelled queued dispatch
// must hand its turn on rather than strand the only worker.
@test
@timeout(180000)
async fun task_pool_queued_cancel(): void {
    let pool = TaskPool(1);
    let first = pool.dispatch(() => 1);
    Promise.start(first);
    let second = pool.dispatch(() => 2);
    Promise.start(second);
    Promise.cancel(second);
    let third = pool.dispatch(() => 3);
    Promise.start(third);
    Assert.eq(first.await.unwrap(), 1);
    Assert.eq(third.await.unwrap(), 3);
    pool.close().await.unwrap();
}

@test
@timeout(180000)
async fun task_pool_hundred(): void {
    let pool = TaskPool(100);
    let total = 0;
    for (let i = 0; i < 100; i = i + 1) {
        total = total + pool.dispatch(() => i).await.unwrap();
    }
    pool.close().await.unwrap();
    Assert.eq(total, 4950);
}
