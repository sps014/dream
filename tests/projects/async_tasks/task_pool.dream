import system.testing;
import system;
import system.task;
fun c252_square(x: string): string {
    let n = int.parse(x).unwrap_or(0);
    return (n * n).to_string();
}

@test
@timeout(180000)
async fun task_pool(): void {
    let pool = TaskPool(2);
    let a = pool.dispatch(() => c252_square("3"));
    let b = pool.dispatch(() => c252_square("4"));
    let c = pool.dispatch(() => c252_square("5"));
    let d = pool.dispatch(() => c252_square("6"));
    Assert.eq_str((a.await).to_string(), "9");
    Assert.eq_str((b.await).to_string(), "16");
    Assert.eq_str((c.await).to_string(), "25");
    Assert.eq_str((d.await).to_string(), "36");
    pool.shutdown();
}
