import system.testing;
import system;
import system.task;

async fun c253_body(): void {
    let pool = TaskPool(100);
    let total = 0;
    for (let i = 0; i < 100; i = i + 1) {
        total = total + pool.dispatch(() => i).await.unwrap();
    }
    pool.close().await.unwrap();
    c253_verify_observation((total.to_string()).to_string());
}

let c253_cursor: int = 0;

fun c253_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "4950\n";
    let end = c253_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c253_cursor, end));
    c253_cursor = end;
}

@test
@timeout(180000)

async fun task_pool_hundred(): void {
    c253_cursor = 0;
    c253_body().await;
    Assert.eq(c253_cursor, ("4950\n").length);
}
