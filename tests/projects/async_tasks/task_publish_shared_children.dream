import system.testing;
import system;
import system.task;

shared class c255_Named {
    public label: string;

    public constructor(label: string) {
        this.label = label;
    }
}

@test
@timeout(180000)
async fun task_publish_shared_children(): void {
    let n = c255_Named("first" + " child");
    Assert.eq((Task.spawn(() => n.label + "!").await).to_string(), "first child!");
    lock (n) {
        n.label = "second" + " child";
    }
    Assert.eq((Task.spawn(() => n.label + "!").await).to_string(), "second child!");
    let labels = ["array" + " child", "closure" + " child"];
    Assert.eq(
        (Task.spawn(() => labels[0] + ", " + labels[1]).await).to_string(),
        "array child, closure child"
    );
}
