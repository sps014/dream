import system.testing;
// `shared class` may hold a `string` field (shared / Sendable analogue).
import system;
import system.task;

shared class c257_Named {
    public label: string;

    public constructor(label: string) {
        this.label = label;
    }
}

@test
@timeout(180000)
async fun task_shared_string_field(): void {
    let n = c257_Named("hi");
    Assert.eq_str((Task.spawn(() => n.label + "!").await).to_string(), "hi!");
}
