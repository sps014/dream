import system.testing;
// Hard terminate: cancelling the spawn Future aborts a busy worker.
import system;
import system.task;

async fun c25b_body(): void {
    let f = Task.spawn(
        () => {
            while true {}
            return 0;
        }
    );
    Promise.cancel(f);
    c25b_verify_observation(("done").to_string());
}

let c25b_cursor: int = 0;

fun c25b_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "done\n";
    let end = c25b_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c25b_cursor, end));
    c25b_cursor = end;
}

@test
@timeout(180000)

async fun task_terminate_busy(): void {
    c25b_cursor = 0;
    c25b_body().await;
    Assert.eq(c25b_cursor, ("done\n").length);
}
