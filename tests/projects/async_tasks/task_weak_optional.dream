import system.testing;
import system.task;

shared class TaskWeakSession {
    public id: int;
    public constructor(id: int) {
        this.id = id;
    }
}

fun task_dead_weak_reader(): fun(): Option<TaskWeakSession> {
    let weak dead = TaskWeakSession(7);
    return () => dead;
}

@test
async fun task_weak_optional(): void {
    let session = TaskWeakSession(42);
    let weak alive = session;
    Assert.is_true(Task.spawn(() => alive.unwrap().id == 42).await);
    session.id = 43;
    let dead = task_dead_weak_reader();
    Assert.is_true(Task.spawn(() => dead().is_none()).await);
}
