import system.testing;
// `Array.alloc<T>(n)` allocates a zero-initialized `T[]` of length `n`.
import system;

@test
@timeout(180000)
fun array_alloc(): void {
    let a = Array.alloc<int>(4);
    Assert.eq((a.length).to_string(), "4");
    Assert.eq((a[0]).to_string(), "0");
    Assert.eq((a[3]).to_string(), "0");
    a[1] = 42;
    Assert.eq((a[1]).to_string(), "42");
}
