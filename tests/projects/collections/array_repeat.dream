import system.testing;
import system;

fun c29_body(): void {
    // Zero-init fast path: lowers straight to Buffer.alloc (no fill loop).
    let zeros = [0; 4];
    c29_verify_observation((zeros.length).to_string());
    c29_verify_observation((zeros[0] + zeros[3]).to_string());

    // Non-zero scalar: value evaluated once, copied into every slot.
    let sevens = [7; 3];
    let i = 0;
    while i < sevens.length {
        c29_verify_observation((sevens[i]).to_string());
        i = i + 1;
    }

    // Runtime length.
    let n = 5;
    let scaled = [2; n * 2];
    c29_verify_observation((scaled.length).to_string());
    c29_verify_observation((scaled[9]).to_string());

    // Nested repeat: every row is a distinct array — mutating one row
    // must not affect the others.
    let grid = [[0; 3]; 2];
    grid[0][1] = 42;
    c29_verify_observation((grid[0].length).to_string());
    c29_verify_observation((grid[0][1]).to_string());
    c29_verify_observation((grid[1][1]).to_string());

    // Reference-typed init: slots share one ARC-retained value.
    let names = ["dream"; 2];
    c29_verify_observation((names[0]).to_string());

    // List context composes with the collection-literal desugar.
    let xs: List<int> = [9; 2];
    c29_verify_observation((xs.length).to_string());
}

let c29_cursor: int = 0;

fun c29_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "4\n0\n7\n7\n7\n10\n2\n3\n42\n0\ndream\n2\n";
    let end = c29_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c29_cursor, end));
    c29_cursor = end;
}

@test
@timeout(180000)

fun array_repeat(): void {
    c29_cursor = 0;
    c29_body();
    Assert.eq(c29_cursor, ("4\n0\n7\n7\n7\n10\n2\n3\n42\n0\ndream\n2\n").length);
}
