module system.core;

import system.testing;
// `Buffer.realloc<T>`/`Buffer.free<T>` (`@unsafe`): manual, non-ARC control over an array's backing
// block via the allocator's `$realloc`/`$free`.
import system;

@unsafe
fun c57_grow_and_shrink(): void {
    let xs = Array.alloc<int>(3);
    xs[0] = 10;
    xs[1] = 20;
    xs[2] = 30;

    // Grow: the overlapping prefix survives, the new tail is zero-initialized.
    xs = Buffer.realloc<int>(xs, 5);
    c57_verify_observation((xs.length).to_string()); // 5
    c57_verify_observation((xs[0]).to_string()); // 10
    c57_verify_observation((xs[1]).to_string()); // 20
    c57_verify_observation((xs[2]).to_string()); // 30
    c57_verify_observation((xs[3]).to_string()); // 0
    c57_verify_observation((xs[4]).to_string()); // 0

    xs[3] = 40;
    xs[4] = 50;

    // Shrink: the surviving prefix is unchanged.
    xs = Buffer.realloc<int>(xs, 2);
    c57_verify_observation((xs.length).to_string()); // 2
    c57_verify_observation((xs[0]).to_string()); // 10
    c57_verify_observation((xs[1]).to_string()); // 20

    // Manual free: bypasses reference counting entirely.
    Buffer.free<int>(xs);
    c57_verify_observation(("done").to_string());
}

@unsafe
fun c57_body(): void {
    c57_grow_and_shrink();
}

let c57_cursor: int = 0;

fun c57_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "5\n10\n20\n30\n0\n0\n2\n10\n20\ndone\n";
    let end = c57_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c57_cursor, end));
    c57_cursor = end;
}

@test
@timeout(180000)
@unsafe
fun buffer_realloc_free(): void {
    c57_cursor = 0;
    c57_body();
    Assert.eq(c57_cursor, ("5\n10\n20\n30\n0\n0\n2\n10\n20\ndone\n").length);
}
