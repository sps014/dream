import system.testing;
import system;
import system.collections;

fun c81_body(): void {
    let xs = List<int>();
    let round = 0;
    while round < 3 {
        xs.push(round);
        xs.push(round + 10);
        c81_verify_observation((xs.length).to_string());
        c81_verify_observation((xs.get(0)).to_string());
        xs.clear();
        c81_verify_observation((xs.length).to_string());
        c81_verify_observation((xs.capacity).to_string());
        round = round + 1;
    }

    let m = Map<int, int>();
    m.set(1, 10);
    m.set(2, 20);
    c81_verify_observation((m.length).to_string());
    m.clear();
    c81_verify_observation((m.length).to_string());
    m.set(3, 30);
    c81_verify_observation((m.get(3).unwrap_or(0)).to_string());

    let s = Set<int>();
    s.add(7);
    s.add(8);
    c81_verify_observation((s.length).to_string());
    s.clear();
    c81_verify_observation((s.length).to_string());
    s.add(9);
    c81_verify_observation((s.contains(9)).to_string());

    let names = List<string>();
    names.push("a");
    names.push("b");
    c81_verify_observation((names.length).to_string());
    names.clear();
    c81_verify_observation((names.length).to_string());
    names.push("c");
    c81_verify_observation((names.get(0)).to_string());
}

let c81_cursor: int = 0;

fun c81_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "2\n0\n0\n8\n2\n1\n0\n8\n2\n2\n0\n8\n2\n0\n30\n2\n0\ntrue\n2\n0\nc\n";
    let end = c81_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c81_cursor, end));
    c81_cursor = end;
}

@test
@timeout(180000)

fun collection_clear_reuse(): void {
    c81_cursor = 0;
    c81_body();
    Assert.eq(c81_cursor, ("2\n0\n0\n8\n2\n1\n0\n8\n2\n2\n0\n8\n2\n0\n30\n2\n0\ntrue\n2\n0\nc\n").length);
}
