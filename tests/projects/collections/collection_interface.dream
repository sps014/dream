import system.testing;
import system;
import system.collections;

fun c83_describe(xs: Collection<int>): string {
    return xs.length.to_string() + ":" + xs.is_empty().to_string();
}

@test
@timeout(180000)
fun collection_interface(): void {
    let xs = List<int>();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    Assert.eq((c83_describe(xs)).to_string(), "3:false");
    Assert.eq((xs.length).to_string(), "3");
    Assert.eq((xs.is_empty()).to_string(), "false");
}
