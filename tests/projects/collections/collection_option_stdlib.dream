import system.testing;
import system;
import system.collections;

fun c89_total_size(xs: Collection<string>): int {
    return xs.length;
}

fun c89_double_it(x: int): int {
    return x * 2;
}

fun c89_body(): void {
    let list: List<string> = ["ab", "c"];
    c89_verify_observation((c89_total_size(list)).to_string());

    let set = Set<string>();
    set.add("hi");
    set.add("there");
    c89_verify_observation((c89_total_size(set)).to_string());

    let opt = Option.Some(21);
    let mapped = opt.map(c89_double_it);
    c89_verify_observation((mapped.unwrap_or(0)).to_string());

    for (let s in list) {
        c89_verify_observation((s.length).to_string());
    }
}

let c89_cursor: int = 0;

fun c89_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "2\n2\n42\n2\n1\n";
    let end = c89_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c89_cursor, end));
    c89_cursor = end;
}

@test
@timeout(180000)

fun collection_option_stdlib(): void {
    c89_cursor = 0;
    c89_body();
    Assert.eq(c89_cursor, ("2\n2\n42\n2\n1\n").length);
}
