import system.testing;
import system;
import system.collections;

fun c8a_body(): void {
    let row = List<int>();
    row.push(32);
    let c = List<List<int>>();
    c.push(row);

    c8a_verify_observation((c).to_string());
    c8a_verify_observation((c[0][0]).to_string());

    let i = 0;
    while i < c.length {
        let j = 0;
        while j < c[i].length {
            c8a_verify_observation((c[i][j]).to_string());
            j = j + 1;
        }
        i = i + 1;
    }

    c[0][0] = 31;
    c8a_verify_observation((c[0][0]).to_string());

    let grid = Array.alloc<int[]>(2);
    let r = 0;
    while r < 2 {
        grid[r] = Array.alloc<int>(3);
        let col = 0;
        while col < 3 {
            grid[r][col] = r * 10 + col;
            col = col + 1;
        }
        r = r + 1;
    }
    c8a_verify_observation((grid).to_string());
    r = 0;
    while r < grid.length {
        let col = 0;
        while col < grid[r].length {
            c8a_verify_observation((grid[r][col]).to_string());
            col = col + 1;
        }
        r = r + 1;
    }

    let empty = List<int>();
    c8a_verify_observation((empty).to_string());
    c8a_verify_observation((Array.alloc<int>(0)).to_string());
}

let c8a_cursor: int = 0;

fun c8a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "[[32]]\n32\n32\n31\n[[0, 1, 2], [10, 11, 12]]\n0\n1\n2\n10\n11\n12\n[]\n[]\n";
    let end = c8a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c8a_cursor, end));
    c8a_cursor = end;
}

@test
@timeout(180000)

fun collection_print(): void {
    c8a_cursor = 0;
    c8a_body();
    Assert.eq(
        c8a_cursor,
        ("[[32]]\n32\n32\n31\n[[0, 1, 2], [10, 11, 12]]\n0\n1\n2\n10\n11\n12\n[]\n[]\n").length
    );
}
