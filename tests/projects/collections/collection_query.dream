import system.testing;
import system;
import system.collections;

fun c8b_is_positive(n: int): bool {
    return n > 0;
}

fun c8b_is_three(n: int): bool {
    return n == 3;
}

fun c8b_gt_two(n: int): bool {
    return n > 2;
}

fun c8b_is_even(n: int): bool {
    return n % 2 == 0;
}

fun c8b_times_two(n: int): int {
    return n * 2;
}

fun c8b_add(a: int, b: int): int {
    return a + b;
}

fun c8b_gt_one(n: int): bool {
    return n > 1;
}

fun c8b_plus_ten(n: int): int {
    return n + 10;
}

fun c8b_asc(a: int, b: int): int {
    return a.compare(b);
}

fun c8b_sum_evens(xs: Collection<int>): int {
    return xs.seq().filter(c8b_is_even).reduce(0, c8b_add);
}

@test
@timeout(180000)
fun collection_query(): void {
    c8b_lazy_stages();
    let xs = List<int>();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    xs.push(4);

    Assert.eq((xs.all(c8b_is_positive)).to_string(), "true");
    Assert.eq((xs.any(c8b_is_three)).to_string(), "true");
    Assert.eq((xs.count(c8b_gt_two)).to_string(), "2");
    Assert.eq((xs.find(c8b_gt_two).unwrap_or(-1)).to_string(), "3");

    let doubled = xs.seq().map(c8b_times_two).to_list();
    Assert.eq((doubled.length).to_string(), "4");
    Assert.eq((doubled[0]).to_string(), "2");

    Assert.eq((c8b_sum_evens(xs)).to_string(), "6");

    let filtered = xs.seq().filter(c8b_gt_one).map(c8b_plus_ten).to_list();
    Assert.eq((filtered.seq().reduce(0, c8b_add)).to_string(), "39");

    let from_iface: Collection<int> = xs;
    Assert.eq((from_iface.seq().to_list().length).to_string(), "4");
    Assert.eq(from_iface.length.to_string() + ":" + from_iface.is_empty().to_string(), "4:false");

    Assert.eq((xs.seq().distinct().to_list().length).to_string(), "4");
    Assert.eq((xs.seq().sort_by(c8b_asc).to_list()[0]).to_string(), "1");
}

let c8b_visits: int = 0;

fun c8b_observe(n: int): int {
    c8b_visits++;
    return n * 2;
}

fun c8b_expand(n: int): List<int> {
    return [n, n];
}

fun c8b_lazy_stages(): void {
    c8b_visits = 0;
    let values: List<int> = [1, 2, 3, 4];
    let query = values.seq().map(c8b_observe).filter(c8b_gt_two).skip(1).take(1);
    Assert.eq(c8b_visits, 0);
    Assert.eq(query.reduce(0, c8b_add), 6);
    Assert.eq(c8b_visits, 3);
    Assert.eq(query.count(), 1);
    Assert.eq(c8b_visits, 6);
    Assert.eq(values.seq().map(c8b_observe).take(0).count(), 0);
    Assert.eq(c8b_visits, 6);
    let flattened = values.seq().flat_map(c8b_expand).distinct().take(2);
    Assert.eq(flattened.reduce(0, c8b_add), 3);
    Assert.eq(flattened.reduce(0, c8b_add), 3);
    let first = 0;
    for (let value in query) {
        first = value;
        break;
    }
    Assert.eq(first, 6);
    Assert.eq(query.to_list()[0], 6);
    Assert.eq(values.seq().skip(-2).take(-1).count(), 0);
}

fun c28_sum(xs: IndexedCollection<int>): int {
    let total = 0;
    let i = 0;
    while i < xs.length {
        total = total + xs[i];
        i = i + 1;
    }
    return total;
}

fun c28_sum_collection(xs: Collection<int>): int {
    return xs.seq().reduce(0, c8b_add);
}

@test
@timeout(180000)
fun array_collection(): void {
    let arr: int[] = [10, 20, 30];
    Assert.eq(c28_sum(arr), 60);
    Assert.is_false(arr.is_empty());
    Assert.eq(arr.first().unwrap_or(-1), 10);
    Assert.eq(arr.last().unwrap_or(-1), 30);

    let c: Collection<int> = arr;
    Assert.eq(c28_sum_collection(c), 60);
    let seen = List<string>();
    for (let x in c) {
        seen.push(x.to_string());
    }
    Assert.eq(seen.join(","), "10,20,30");

    Assert.eq(arr.seq().filter(c8b_is_even).to_list().length, 3);
    Assert.eq(arr.seq().map(c8b_times_two).reduce(0, c8b_add), 120);

    let xs = List<int>();
    xs.push(3);
    xs.push(1);
    xs.push(2);
    xs.push(1);
    Assert.eq(xs.seq().distinct().to_list().length, 3);
    Assert.eq(xs.seq().sort_by(c8b_asc).to_list()[0], 1);
}

fun c82_sum_collection(xs: Collection<int>): int {
    let total = 0;
    for (let n in xs) {
        total = total + n;
    }
    return total;
}

fun c82_sum_indexed(xs: IndexedCollection<int>): int {
    let total = 0;
    for (let n in xs) {
        total = total + n;
    }
    return total;
}

fun c82_sum_iterator(it: Iterator<int>): int {
    let total = 0;
    for (let n in it) {
        total = total + n;
    }
    return total;
}

@test
@timeout(180000)
fun collection_foreach_iface(): void {
    let xs = List<int>();
    xs.push(10);
    xs.push(20);
    xs.push(30);
    Assert.eq(c82_sum_collection(xs), 60);
    Assert.eq(c82_sum_indexed(xs), 60);
    Assert.eq(c82_sum_iterator(xs.iterator()), 60);
}

fun c89_total_size(xs: Collection<string>): int {
    return xs.length;
}

@test
@timeout(180000)
fun collection_option_stdlib(): void {
    let list: List<string> = ["ab", "c"];
    Assert.eq(c89_total_size(list), 2);

    let set = Set<string>();
    set.add("hi");
    set.add("there");
    Assert.eq(c89_total_size(set), 2);

    let opt = Option.Some(21);
    let mapped = opt.map(c8b_times_two);
    Assert.eq(mapped.unwrap_or(0), 42);

    let lengths = List<string>();
    for (let s in list) {
        lengths.push(s.length.to_string());
    }
    Assert.eq(lengths.join(","), "2,1");
}
