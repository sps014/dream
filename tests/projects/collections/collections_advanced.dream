import system.testing;
import system;
import system.collections;
import system.text;

enum c8c_Color {
    Red,
    Green,
    Blue,
}

struct c8c_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

class c8c_User {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }
}

@test
@timeout(180000)
fun collections_advanced(): void {
    let m = Map<c8c_Color, c8c_Point>();

    // Enum as key, struct as value
    m.set(c8c_Color.Red, c8c_Point(10, 20));
    m.set(c8c_Color.Green, c8c_Point(30, 40));

    Assert.eq_str(("Map size: " + m.length).to_string(), "Map size: 2");
    let p1 = m.get_or(c8c_Color.Red, c8c_Point(0, 0));
    Assert.eq_str(("Red x: " + p1.x + ", y: " + p1.y).to_string(), "Red x: 10, y: 20");

    let p2 = m.get_or(c8c_Color.Green, c8c_Point(0, 0));
    Assert.eq_str(("Green x: " + p2.x + ", y: " + p2.y).to_string(), "Green x: 30, y: 40");

    // Test Set with class references
    let s = Set<c8c_User>();
    let u1 = c8c_User("Alice");
    let u2 = c8c_User("Bob");

    Assert.eq_str(("Add Alice: " + s.add(u1)).to_string(), "Add Alice: true");
    Assert.eq_str(("Add Bob: " + s.add(u2)).to_string(), "Add Bob: true");
    Assert.eq_str(("Add Alice again: " + s.add(u1)).to_string(), "Add Alice again: false"); // Should be false based on reference equality

    // Create a NEW instance with the identical data
    let u3 = c8c_User("Alice");
    Assert.eq_str(
        ("Add new Alice instance: " + s.add(u3)).to_string(),
        "Add new Alice instance: true"
    ); // True, because it is a different heap allocation

    Assert.eq_str(("Set size: " + s.length).to_string(), "Set size: 3");
    Assert.eq_str(("Contains Alice: " + s.contains(u1)).to_string(), "Contains Alice: true");
    Assert.eq_str(
        ("Contains new Alice instance: " + s.contains(u3)).to_string(),
        "Contains new Alice instance: true"
    );

    // Test Map with Class as Key
    let class_map = Map<c8c_User, string>();
    class_map.set(u1, "Admin");
    class_map.set(u2, "Editor");

    Assert.eq_str(("u1 role: " + class_map.get_or(u1, "None")).to_string(), "u1 role: Admin");
    Assert.eq_str(("u2 role: " + class_map.get_or(u2, "None")).to_string(), "u2 role: Editor");
    // u3 has the same name "Alice" but is a different instance, so it shouldn't match u1's key
    Assert.eq_str(("u3 role: " + class_map.get_or(u3, "None")).to_string(), "u3 role: None");

    // Struct as key in set
    let pointSet = Set<c8c_Point>();
    let pt = c8c_Point(5, 5);
    Assert.eq_str(("Add pt: " + pointSet.add(pt)).to_string(), "Add pt: true");
    Assert.eq_str(("Contains pt: " + pointSet.contains(pt)).to_string(), "Contains pt: false");
}
