import system.testing;
import system;
import system.collections;

fun c90_body(): void {
    let m = Map<int, string>(8);
    let s = Set<int>(8);
    for (let i = 0; i < 5; i = i + 1) {
        m[i * 8] = i.to_string();
        s.add(i * 8);
    }
    m[32] = "updated";
    c90_verify_observation((m.capacity).to_string());
    c90_verify_observation((s.add(32)).to_string());
    c90_verify_observation((s.capacity).to_string());
    for (let i = 0; i < 4; i = i + 1) {
        m.remove(i * 8);
        s.remove(i * 8);
    }
    m[40] = "new";
    s.add(40);
    c90_verify_observation((m.capacity).to_string());
    c90_verify_observation((s.capacity).to_string());
    c90_verify_observation((m[32]).to_string());
    c90_verify_observation((m[40]).to_string());
    c90_verify_observation((s.contains(32) && s.contains(40)).to_string());
    for (let i = 0; i < 100; i = i + 1) {
        m[i + 100] = "value";
        s.add(i + 100);
        m.remove(i + 100);
        s.remove(i + 100);
    }
    c90_verify_observation((m.capacity).to_string());
    c90_verify_observation((s.capacity).to_string());
    c90_verify_observation((m.length).to_string());
    c90_verify_observation((s.length).to_string());
}

let c90_cursor: int = 0;

fun c90_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "8\nfalse\n8\n16\n16\nupdated\nnew\ntrue\n128\n128\n2\n2\n";
    let end = c90_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c90_cursor, end));
    c90_cursor = end;
}

@test
@timeout(180000)

fun collections_hash_churn(): void {
    c90_cursor = 0;
    c90_body();
    Assert.eq(c90_cursor, ("8\nfalse\n8\n16\n16\nupdated\nnew\ntrue\n128\n128\n2\n2\n").length);
}
