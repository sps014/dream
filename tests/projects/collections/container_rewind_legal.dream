import system.testing;
// Rewinding a counter without clearing slots is safe — dead slots hold valid references
// until the array is dropped, at which point every slot releases. No compile error.

import system;
import system.collections;

class ca1_Cache {
    entries: string[];
    count: int;
    public constructor() {
        this.entries = Buffer.alloc<string>(16);
        this.count = 0;
    }
    public fun add(v: string): void {
        if this.count >= this.entries.length { return; }
        this.entries[this.count] = v;
        this.count = this.count + 1;
    }
    public fun reset(): void { this.count = 0; }
    public fun len(): int { return this.count; }
}

fun ca1_body(): void {
    let c = ca1_Cache();
    c.add("hello");
    c.add("world");
    c.reset();
    ca1_verify_observation((c.len().to_string()).to_string());
}

let ca1_cursor: int = 0;

fun ca1_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "0\n";
    let end = ca1_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(ca1_cursor, end));
    ca1_cursor = end;
}

@test
@timeout(180000)

fun container_rewind_legal(): void {
    ca1_cursor = 0;
    ca1_body();
    Assert.eq(ca1_cursor, ("0\n").length);
}
