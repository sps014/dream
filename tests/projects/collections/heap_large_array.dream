import system.testing;
// Native bump used to mmap 4MiB chunks and still return a pointer for larger
// payloads (HTTP bodies, `Buffer.alloc`), then memset walked off the mapping.
import system;
fun cf1_body(): void {
    let n = 5000000;
    let a = Buffer.alloc<byte>(n);
    a[0] = (byte)1;
    a[n - 1] = (byte)2;
    cf1_verify_observation(((int)a[0]).to_string());
    cf1_verify_observation(((int)a[n - 1]).to_string());
    cf1_verify_observation((a.length).to_string());
}

let cf1_cursor: int = 0;

fun cf1_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "1\n2\n5000000\n";
    let end = cf1_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(cf1_cursor, end));
    cf1_cursor = end;
}

@test
@timeout(180000)

fun heap_large_array(): void {
    cf1_cursor = 0;
    cf1_body();
    Assert.eq(cf1_cursor, ("1\n2\n5000000\n").length);
}
