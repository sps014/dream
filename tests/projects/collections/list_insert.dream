import system.testing;
import system;
import system.collections;

@test
@timeout(180000)
fun list_insert(): void {
    let xs = List<int>();
    xs.push(1);
    xs.push(3);
    xs.insert(1, 2);
    Assert.eq_str((xs.get(0)).to_string(), "1");
    Assert.eq_str((xs.get(1)).to_string(), "2");
    Assert.eq_str((xs.get(2)).to_string(), "3");
    xs.remove(2);
    Assert.eq_str((xs.length).to_string(), "2");
}
