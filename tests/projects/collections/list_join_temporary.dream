import system.testing;
import system;
import system.collections;

// `join` on a temporary List<string>: the string elements' `to_string` must hand out an owned
// reference, or freeing the temporary list double-frees its elements.
fun c137_make(): List<string> {
    let out = List<string>();
    out.push("a" + "1");
    out.push("b" + "2");
    return out;
}

class c137_Box {
    public static get items(): List<string> {
        return c137_make();
    }
}

fun c137_body(): void {
    let i = 0;
    while i < 3 {
        c137_verify_observation((c137_make().join(",")).to_string());
        c137_verify_observation((c137_Box.items.join(";")).to_string());
        i = i + 1;
    }
    let kept = c137_make();
    c137_verify_observation((kept.join("+")).to_string());
    c137_verify_observation((kept.join("+")).to_string());
}

let c137_cursor: int = 0;

fun c137_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "a1,b2\na1;b2\na1,b2\na1;b2\na1,b2\na1;b2\na1+b2\na1+b2\n";
    let end = c137_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c137_cursor, end));
    c137_cursor = end;
}

@test
@timeout(180000)

fun list_join_temporary(): void {
    c137_cursor = 0;
    c137_body();
    Assert.eq(c137_cursor, ("a1,b2\na1;b2\na1,b2\na1;b2\na1,b2\na1;b2\na1+b2\na1+b2\n").length);
}
