import system.testing;
// The standard `Map<K, V>` supports `m[k] = v` (via `set`), `m[k]` (via `at`, panicking on a
// missing key; `get(k)` returns `Option<V>`), and `for (let pair in m)` yielding
// `KeyValuePair<K, V>`. Map order is
// unspecified, so this case only checks order-independent aggregates.

import system;
import system.collections;
fun c14a_body() {
    let m = Map<string, int>();
    m["a"] = 1;
    m["b"] = 2;
    m["c"] = 3;

    let vtotal = 0;
    let count = 0;
    for (let pair in m) {
        vtotal = vtotal + pair.value;
        count = count + 1;
    }
    c14a_verify_observation((vtotal).to_string());            // 1 + 2 + 3 = 6
    c14a_verify_observation((count).to_string());             // 3

    c14a_verify_observation((m["b"]).to_string());            // 2 (panics if absent)
    c14a_verify_observation((m.get("z").unwrap_or(-1)).to_string()); // -1
}

let c14a_cursor: int = 0;

fun c14a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "6\n3\n2\n-1\n";
    let end = c14a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c14a_cursor, end));
    c14a_cursor = end;
}

@test
@timeout(180000)

fun map_foreach(): void {
    c14a_cursor = 0;
    c14a_body();
    Assert.eq(c14a_cursor, ("6\n3\n2\n-1\n").length);
}
