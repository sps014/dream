import system.testing;
// `m[k]` (via `at`) panics on a missing key, matching `List[i]`; `get(k)` stays the
// absence-tolerant read returning `Option<V>`.
import system;
import system.collections;

@test
@timeout(180000)
fun map_indexer_missing(): void {
    let m = Map<string, int>();
    m["a"] = 1;
    Assert.eq((m["a"]).to_string(), "1");
    Assert.eq((m.get("missing").unwrap_or(-7)).to_string(), "-7");
    Assert.eq((m.get("missing").unwrap_or(-9)).to_string(), "-9");
    let sm = SortedMap<int, string>();
    sm[1] = "one";
    Assert.eq((sm[1]).to_string(), "one");
    Assert.eq((sm.get(2).unwrap_or("none")).to_string(), "none");
}
