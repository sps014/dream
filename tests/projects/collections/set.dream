import system.testing;
import system;
import system.collections;
import system.text;

fun c1f1_body(): void {
    let s = Set<int>();

    // Test size and is_empty
    c1f1_verify_observation(("Empty? " + s.is_empty()).to_string());
    c1f1_verify_observation(("Size: " + s.length).to_string());

    // Test additions
    c1f1_verify_observation(("Add 1: " + s.add(1)).to_string());
    c1f1_verify_observation(("Add 2: " + s.add(2)).to_string());
    c1f1_verify_observation(("Add 3: " + s.add(3)).to_string());

    // Test duplicates
    c1f1_verify_observation(("Add 2 again: " + s.add(2)).to_string());

    // Test properties again
    c1f1_verify_observation(("Empty? " + s.is_empty()).to_string());
    c1f1_verify_observation(("Size: " + s.length).to_string());

    // Test contains
    c1f1_verify_observation(("Contains 1: " + s.contains(1)).to_string());
    c1f1_verify_observation(("Contains 4: " + s.contains(4)).to_string());

    // Test remove
    c1f1_verify_observation(("Remove 2: " + s.remove(2)).to_string());
    c1f1_verify_observation(("Remove 4: " + s.remove(4)).to_string());
    c1f1_verify_observation(("Contains 2: " + s.contains(2)).to_string());
    c1f1_verify_observation(("Size after remove: " + s.length).to_string());

    // Test iteration (use a list to sort since order isn't guaranteed)
    let l = List<int>();
    for (let x in s) {
        l.push(x);
    }
    l.sort();

    c1f1_verify_observation(("Iterated: " + l.length).to_string());
    for (let x in l) {
        c1f1_verify_observation(("Elem: " + x).to_string());
    }

    // Test clear
    s.clear();
    c1f1_verify_observation(("Size after clear: " + s.length).to_string());
}

let c1f1_cursor: int = 0;

fun c1f1_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "Empty? true\nSize: 0\nAdd 1: true\nAdd 2: true\nAdd 3: true\nAdd 2 again: false\nEmpty? false\nSize: 3\nContains 1: true\nContains 4: false\nRemove 2: true\nRemove 4: false\nContains 2: false\nSize after remove: 2\nIterated: 2\nElem: 1\nElem: 3\nSize after clear: 0\n";
    let end = c1f1_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1f1_cursor, end));
    c1f1_cursor = end;
}

@test
@timeout(180000)

fun set(): void {
    c1f1_cursor = 0;
    c1f1_body();
    Assert.eq(
        c1f1_cursor,
        (
            "Empty? true\nSize: 0\nAdd 1: true\nAdd 2: true\nAdd 3: true\nAdd 2 again: false\nEmpty? false\nSize: 3\nContains 1: true\nContains 4: false\nRemove 2: true\nRemove 4: false\nContains 2: false\nSize after remove: 2\nIterated: 2\nElem: 1\nElem: 3\nSize after clear: 0\n"
        ).length
    );
}
