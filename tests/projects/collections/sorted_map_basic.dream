import system.testing;
import system;
import system.collections;

fun c1fa_body(): void {
    let m = SortedMap<int, string>();
    m[5] = "five";
    m[1] = "one";
    m[3] = "three";
    m[2] = "two";
    c1fa_verify_observation((m.length).to_string());
    c1fa_verify_observation((m.contains(3)).to_string());
    c1fa_verify_observation((m.contains(9)).to_string());
    c1fa_verify_observation((m.get(3).unwrap_or("?")).to_string());
    c1fa_verify_observation((m.first_key().unwrap_or(0 - 1)).to_string());
    c1fa_verify_observation((m.last_key().unwrap_or(0 - 1)).to_string());
    c1fa_verify_observation((m.ceiling_key(4).unwrap_or(0 - 1)).to_string());
    c1fa_verify_observation((m.floor_key(4).unwrap_or(0 - 1)).to_string());
    c1fa_verify_observation((m.ceiling_key(10).unwrap_or(0 - 1)).to_string());
    c1fa_verify_observation((m.floor_key(0).unwrap_or(0 - 1)).to_string());

    for (let entry in m) {
        c1fa_verify_observation((entry.key + " -> " + entry.value).to_string());
    }

    m.remove(3);
    c1fa_verify_observation((m.length).to_string());
    c1fa_verify_observation((m.contains(3)).to_string());
}

let c1fa_cursor: int = 0;

fun c1fa_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "4\ntrue\nfalse\nthree\n1\n5\n5\n3\n-1\n-1\n1 -> one\n2 -> two\n3 -> three\n5 -> five\n3\nfalse\n";
    let end = c1fa_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c1fa_cursor, end));
    c1fa_cursor = end;
}

@test
@timeout(180000)

fun sorted_map_basic(): void {
    c1fa_cursor = 0;
    c1fa_body();
    Assert.eq(
        c1fa_cursor,
        (
            "4\ntrue\nfalse\nthree\n1\n5\n5\n3\n-1\n-1\n1 -> one\n2 -> two\n3 -> three\n5 -> five\n3\nfalse\n"
        ).length
    );
}
