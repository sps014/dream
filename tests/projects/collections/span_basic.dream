import system.testing;
// `Span<T>` is a bounds-checked, non-owning view over an existing array's elements: no copy, no
// heap allocation of its own (it's a `ref struct`), and its own logical range is enforced
// independently of the backing array's actual size.

import system;
fun c1fc_sum(s: Span<int>): int {
    let total = 0;
    let i = 0;
    while i < s.length {
        total = total + s.get(i);
        i = i + 1;
    }
    return total;
}

fun c1fc_body(): void {
    let xs = [1, 2, 3, 4, 5];

    let whole = Span<int>.of(xs);
    c1fc_verify_observation((whole.length).to_string());       // 5
    c1fc_verify_observation((c1fc_sum(whole)).to_string());        // 15

    let mid = whole.slice(1, 3);       // [2, 3, 4]
    c1fc_verify_observation((mid.length).to_string());         // 3
    c1fc_verify_observation((c1fc_sum(mid)).to_string());          // 9

    // Writing through a span mutates the backing array.
    mid.set(0, 20);
    c1fc_verify_observation((xs[1]).to_string());             // 20

    let copy = mid.to_array();
    c1fc_verify_observation((copy.length).to_string());       // 3
    c1fc_verify_observation((copy[0]).to_string());           // 20

    // A slice nested within a slice.
    let inner = mid.slice(1, 2);
    c1fc_verify_observation((c1fc_sum(inner)).to_string());        // 3 + 4 = 7
}

let c1fc_cursor: int = 0;

fun c1fc_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "5\n15\n3\n9\n20\n3\n20\n7\n";
    let end = c1fc_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1fc_cursor, end));
    c1fc_cursor = end;
}

@test
@timeout(180000)

fun span_basic(): void {
    c1fc_cursor = 0;
    c1fc_body();
    Assert.eq(c1fc_cursor, ("5\n15\n3\n9\n20\n3\n20\n7\n").length);
}
