import system.testing;
// `Span<T>` / `ReadOnlySpan<T>` shared ops and by-value for-each (an index loop, no iterator).
import system;

fun c203_sum(xs: ReadOnlySpan<int>): int {
    let t = 0;
    for (let x in xs) {
        t = t + x;
    }
    return t;
}

fun c203_body(): void {
    let arr = [1, 2, 3, 4, 5];
    let s = Span<int>.of(arr);
    c203_verify_observation((c203_sum(s.as_read_only())).to_string());
    c203_verify_observation((c203_sum(s.slice(1, 3).as_read_only())).to_string());
    c203_verify_observation((s.slice(2).length).to_string());
    c203_verify_observation((s.index_of(4).unwrap_or(-1)).to_string());
    c203_verify_observation((s.contains(9)).to_string());
    let dst = Span<int>.of([0, 0, 0, 0, 0, 0]);
    s.copy_to(dst);
    c203_verify_observation(
        (dst.to_array().length.to_string() + " " + dst[4].to_string()).to_string()
    );
    c203_verify_observation((s.sequence_equal(dst.slice(0, 5))).to_string());
    c203_verify_observation(
        (s.as_read_only().sequence_equal(dst.slice(1, 5).as_read_only())).to_string()
    );
    for (let x in s.slice(3)) {
        c203_verify_observation((x).to_string());
    }
    let words = ReadOnlySpan<string>.of(["a", "b" + "c", "d"]);
    c203_verify_observation((words.index_of("bc").unwrap_or(-1)).to_string());
    let buf = ["x", "y", "z", "w"];
    Span<string>.of(buf).slice(0, 3).copy_to(Span<string>.of(buf).slice(1, 3));
    c203_verify_observation((buf[0] + buf[1] + buf[2] + buf[3]).to_string());
}

let c203_cursor: int = 0;

fun c203_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "15\n9\n3\n3\nfalse\n6 5\ntrue\nfalse\n4\n5\n1\nxxyz\n";
    let end = c203_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c203_cursor, end));
    c203_cursor = end;
}

@test
@timeout(180000)

fun span_read_only_api(): void {
    c203_cursor = 0;
    c203_body();
    Assert.eq(c203_cursor, ("15\n9\n3\n3\nfalse\n6 5\ntrue\nfalse\n4\n5\n1\nxxyz\n").length);
}
