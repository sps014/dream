import system.testing;

@unsafe
@test
fun arena(): void {
    let arena = Arena(16);
    let first = arena.alloc<int>(2);
    first[0] = 11;
    first[1] = 22;
    let bytes = arena.alloc<byte>(3);
    bytes[0] = (byte)7;
    let wide = arena.alloc<long>(32);
    wide[0] = (long)99;
    Assert.is_true(wide.address() % (usize)alignof(long) == (usize)0);
    Assert.eq(first[1], 22);
    Assert.eq((int)bytes[0], 7);
    let first_address = first.address();
    arena.reset();
    let reused = arena.alloc<int>(2);
    Assert.is_true(reused.address() == first_address);
    reused[0] = 33;
    Assert.eq(reused[0], 33);
    let zeroed = arena.alloc_zeroed<long>(2);
    Assert.is_true(zeroed[1] == (long)0);
    Assert.is_true(arena.alloc<byte>(0).is_null());
    arena.free();
}
