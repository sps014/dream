import system.testing;
import system;
@test
@timeout(180000)
fun arithmetic(): void {
    let a = 10;
    let b = 3;

    Assert.eq(a + b, 13);
    Assert.eq(a - b, 7);
    Assert.eq(a * b, 30);
    Assert.eq(a / b, 3);
    Assert.eq(a % b, 1);

    let x = 1.5;
    let y = 2.0;
    Assert.eq(x + y, 3.5);
    Assert.eq(x * y, 3.0);

    // Precedence
    Assert.eq(1 + 2 * 3, 7);
    Assert.eq((1 + 2) * 3, 9);
}
