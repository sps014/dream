fun audio_content_detection_and_webm_opus(): void {
    let wav = AudioBuffer.decode(audio_fixture_wav()).unwrap();
    Assert.eq(wav.sample_rate, 48000);
    Assert.eq(wav.channels, 1);
    Assert.eq(wav.frame_count, 4);
    Assert.is_true(Math.abs((double)wav.read_pcm(1, 1).unwrap()[0] - 0.25d) < 0.00001d);
    let mp3 = AudioBuffer.decode(audio_fixture_mp3()).unwrap();
    Assert.eq(mp3.sample_rate, 44100);
    Assert.is_true(mp3.frame_count > 1000);
    let webm = AudioBuffer.decode(audio_fixture_webm()).unwrap();
    Assert.eq(webm.sample_rate, 48000);
    Assert.is_true(webm.duration > 0.2d && webm.duration < 0.5d);
    let spectrum = AudioAnalyzer()
        .analyze(webm.read_pcm(0, webm.frame_count).unwrap(), webm.sample_rate, webm.channels)
        .unwrap();
    let peak_bin = 0;
    for (let i = 1; i < spectrum.magnitudes.length; i = i + 1) {
        if spectrum.magnitudes[i] > spectrum.magnitudes[peak_bin] {
            peak_bin = i;
        }
    }
    Assert.eq(peak_bin, 19);
    Assert.is_true(AudioBuffer.decode(audio_fixture_webm(), 4).is_err());
    Assert.is_true(AudioBuffer.decode(audio_fixture_wav(), 4).is_err());
}

@test
async fun audio_analysis(): void {
    audio_fft_sine_and_levels();
    audio_fft_silence_dc_and_stereo();
    audio_pcm_snapshot_and_ranges();
    audio_controls_and_events_without_device().await;
    audio_event_queue_is_bounded();
    audio_content_detection_and_webm_opus();
}
