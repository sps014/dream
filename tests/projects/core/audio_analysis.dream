import system.encoding;
import system.audio;
import system.testing;

fun audio_fft_sine_and_levels(): void {
    let analyzer = AudioAnalyzer();
    Assert.is_true(analyzer.set_fft_size(32).is_ok());
    analyzer.set_window(AudioWindow.Rectangular);
    let samples = Array.alloc<float>(32);
    for (let i = 0; i < samples.length; i = i + 1) {
        samples[i] = (float)Math.sin(6.283185307179586d * 4.0d * (double)i / 32.0d);
    }
    let result = analyzer.analyze(samples, 48000, 1).unwrap();
    Assert.eq(result.magnitudes.length, 17);
    Assert.is_true(Math.abs((double)result.magnitudes[4] - 1.0d) < 0.00001d);
    Assert.is_true(Math.abs((double)result.rms - Math.sqrt(0.5d)) < 0.00001d);
    Assert.is_true(Math.abs(result.frequency_hz(4).unwrap() - 6000.0d) < 0.00001d);
    Assert.is_true(result.frequency_hz(17).is_err());
    Assert.is_true(analyzer.set_fft_size(31).is_err());
    Assert.eq(analyzer.analyze(samples, 48000, 1).unwrap().magnitudes.length, 17);
}

fun audio_fft_silence_dc_and_stereo(): void {
    let analyzer = AudioAnalyzer();
    analyzer.set_fft_size(32).unwrap();
    analyzer.set_window(AudioWindow.Rectangular);
    let silent = analyzer.analyze([], 48000, 1).unwrap();
    Assert.eq(silent.peak, 0.0f);
    Assert.eq(silent.rms, 0.0f);
    Assert.eq(silent.magnitudes_db[0], -120.0f);
    let stereo = Array.alloc<float>(64);
    for (let i = 0; i < 32; i = i + 1) {
        stereo[i * 2] = 1.0f;
        stereo[i * 2 + 1] = -1.0f;
    }
    Assert.eq(analyzer.analyze(stereo, 48000, 2).unwrap().peak, 0.0f);
    let dc = analyzer.analyze(Array.repeat<float>(32, 0.5f), 48000, 1).unwrap();
    Assert.is_true(Math.abs((double)dc.magnitudes[0] - 0.5d) < 0.00001d);
    Assert.is_true(analyzer.analyze([1.0f], 48000, 2).is_err());
    Assert.is_true(analyzer.analyze([], 0, 1).is_err());
}

fun audio_pcm_snapshot_and_ranges(): void {
    let samples = [0.25f, -0.5f, 0.75f, -1.0f];
    let buffer = AudioBuffer.from_pcm(samples, 48000, 2).unwrap();
    samples[0] = 1.0f;
    Assert.eq(buffer.frame_count, 2);
    Assert.eq(buffer.read_pcm(0, 1).unwrap()[0], 0.25f);
    Assert.eq(buffer.read_pcm(1, 1).unwrap()[0], 0.75f);
    Assert.is_true(buffer.read_pcm(-1, 1).is_err());
    Assert.is_true(buffer.read_pcm(1, 2).is_err());
    Assert.is_true(AudioBuffer.from_pcm([1.0f], 48000, 2).is_err());
    Assert.is_true(AudioBuffer.decode([(byte)1, (byte)2, (byte)3]).is_err());
}

async fun audio_controls_and_events_without_device(): void {
    let buffer = AudioBuffer.from_pcm([0.25f, -0.5f], 48000, 1).unwrap();
    let audio = Audio(buffer);
    Assert.is_true(audio.paused);
    Assert.is_true(audio.duration.is_none());
    Assert.is_true(audio.load().await.is_ok());
    Assert.is_true(audio.duration.is_some());
    audio.volume = 0.5f;
    audio.volume = -0.1f;
    Assert.eq(audio.volume, 0.5f);
    Assert.eq(audio.error.unwrap().code(), "EINVAL");
    audio.current_time = 1.0d / 48000.0d;
    Assert.is_true(Math.abs(audio.current_time - 1.0d / 48000.0d) < 0.0000001d);
    Assert.eq(audio.capture(1).unwrap().samples.length, 0);
    audio.muted = true;
    Assert.eq(audio.capture(1).unwrap().samples.length, 0);
    Assert.is_true(audio.poll_events().length > 0);
    Assert.eq(audio.poll_events().length, 0);
    audio.close();
    audio.close();
    Assert.is_true(audio.play().await.is_err());
    Assert.is_true(audio.load().await.is_err());
    Assert.is_true(audio.pause().is_err());
    Assert.is_true(audio.poll_events().length > 0);
}

fun audio_event_queue_is_bounded(): void {
    let audio = Audio();
    for (let i = 0; i < 1100; i = i + 1) {
        audio.volume = (float)(i % 2);
    }
    let events = audio.poll_events();
    Assert.eq(events.length, 1025);
    let timestamp = 0L;
    switch (events[0]) {
        AudioEvent.EventsLost(time, count) => {
            Assert.eq(count, 76);
            timestamp = time;
        }
        _ => Assert.is_true(false),
    }
    for (let i = 1; i < events.length; i = i + 1) {
        switch (events[i]) {
            AudioEvent.VolumeChange(time) => {
                Assert.is_true(time >= timestamp);
                timestamp = time;
            }
            _ => Assert.is_true(false),
        }
    }
    Assert.eq(audio.poll_events().length, 0);
    audio.close();
}

