import system.testing;
import system;

fun c47_body(): void {
    let n = 10;
    let a = Buffer.alloc<float>(n);
    let b = Buffer.alloc<float>(n);
    let c = Buffer.alloc<float>(n);
    let i = 0;
    while i < n {
        a[i] = (float)i;
        b[i] = (float)1;
        i = i + 1;
    }
    i = 0;
    while i < n {
        c[i] = a[i] + b[i];
        i = i + 1;
    }
    let s = 0;
    i = 0;
    while i < n {
        s = s + (int)c[i];
        i = i + 1;
    }
    c47_verify_observation((s).to_string());

    let ai = Buffer.alloc<int>(n);
    let bi = Buffer.alloc<int>(n);
    let ci = Buffer.alloc<int>(n);
    i = 0;
    while i < n {
        ai[i] = i;
        bi[i] = 2;
        i = i + 1;
    }
    i = 0;
    while i < n {
        ci[i] = ai[i] + bi[i];
        i = i + 1;
    }
    s = 0;
    i = 0;
    while i < n {
        s = s + ci[i];
        i = i + 1;
    }
    c47_verify_observation((s).to_string());
}

let c47_cursor: int = 0;

fun c47_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "55\n65\n";
    let end = c47_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c47_cursor, end));
    c47_cursor = end;
}

@test
@timeout(180000)

fun autovec_arr_add(): void {
    c47_cursor = 0;
    c47_body();
    Assert.eq(c47_cursor, ("55\n65\n").length);
}
