import system.testing;
import system;

@test
@timeout(180000)
fun bitwise_ops(): void {
    let a: int = 6;
    let b: int = 3;
    Assert.eq((a & b).to_string(), "2");
    Assert.eq((a | b).to_string(), "7");
    Assert.eq((a ^ b).to_string(), "5");
    Assert.eq((a << 1).to_string(), "12");
    Assert.eq((a >> 1).to_string(), "3");
}
