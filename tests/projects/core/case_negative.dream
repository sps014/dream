import system.testing;
import system;
fun c68_body() {
    let x = -1;
    switch (x) {
        case -1: c68_verify_observation(("neg").to_string());
        case 01: c68_verify_observation(("one").to_string());
        default: c68_verify_observation(("def").to_string());
    }
}

let c68_cursor: int = 0;

fun c68_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "neg\n";
    let end = c68_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c68_cursor, end));
    c68_cursor = end;
}

@test
@timeout(180000)

fun case_negative(): void {
    c68_cursor = 0;
    c68_body();
    Assert.eq(c68_cursor, ("neg\n").length);
}
