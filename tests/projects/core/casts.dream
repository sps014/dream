import system.testing;
import system;

interface c3a1_Shape {
    fun sides(): int;
}

class c3a1_Square: c3a1_Shape {
    public constructor() {}

    public fun sides(): int {
        return 4;
    }

    public fun label(): string {
        return "square";
    }
}

struct c3a1_Pair {
    public a: int;
    public b: int;

    public constructor(a: int, b: int) {
        this.a = a;
        this.b = b;
    }
}

enum c3a1_Level {
    Low,
    Mid,
    High
}

enum c3a1_OtherLevel {
    Low,
    Mid,
    High
}

@noinline
fun c3a1_box_level(level: c3a1_Level): object {
    return level;
}

@noinline
fun c3a1_check_boxed_enums(): void {
    let zero = c3a1_box_level(c3a1_Level.Low);
    Assert.is_true(zero is c3a1_Level);
    Assert.is_true((c3a1_Level)zero == c3a1_Level.Low);

    let boxed = c3a1_box_level(c3a1_Level.High);
    Assert.eq(typeof(boxed), "c3a1_Level");
    Assert.is_false(boxed is int);
    Assert.is_false(boxed is c3a1_OtherLevel);
    Assert.is_true((c3a1_Level)boxed == c3a1_Level.High);
    Assert.eq(boxed.to_string(), c3a1_Level.High.to_string());
    Assert.eq(boxed.hash_code(), 2);
    if boxed is c3a1_Level level {
        Assert.is_true(level == c3a1_Level.High);
    } else {
        Assert.is_true(false);
    }
}

@test
fun boxed_enums_keep_their_type_and_value(): void {
    let before = Debug.live_objects;
    c3a1_check_boxed_enums();
    Assert.eq(Debug.live_objects - before, 0);
}

@test
fun boxed_narrow_integers_keep_their_value(): void {
    let small: sbyte = -128;
    let signed: short = -32768;
    let unsigned: ushort = 65535;
    let boxed_small: object = small;
    let boxed_signed: object = signed;
    let boxed_unsigned: object = unsigned;
    Assert.eq((int)(sbyte)boxed_small, -128);
    Assert.eq((int)(short)boxed_signed, -32768);
    Assert.eq((int)(ushort)boxed_unsigned, 65535);
    Assert.eq(boxed_small.to_string(), "-128");
    Assert.eq(boxed_signed.to_string(), "-32768");
    Assert.eq(boxed_unsigned.to_string(), "65535");
    Assert.eq(boxed_small.hash_code(), -128);
    Assert.eq(boxed_signed.hash_code(), -32768);
    Assert.eq(boxed_unsigned.hash_code(), 65535);
}

@test
@timeout(180000)
fun downcasts_to_the_runtime_type(): void {
    let shape: c3a1_Shape = c3a1_Square();
    Assert.eq(((c3a1_Square)shape).label(), "square");

    let boxed: object = c3a1_Square();
    Assert.eq(((c3a1_Square)boxed).sides(), 4);

    let pair: object = c3a1_Pair(2, 5);
    let unboxed = (c3a1_Pair)pair;
    Assert.eq(unboxed.a + unboxed.b, 7);

    let text: object = "boxed";
    Assert.eq((string)text, "boxed");
}

@test
@timeout(180000)
fun enums_convert_to_int_explicitly(): void {
    Assert.eq((int)c3a1_Level.High, 2);
    Assert.is_true((c3a1_Level)1 == c3a1_Level.Mid);
    Assert.is_true(c3a1_Level.Low < c3a1_Level.High);
}

@test
fun cast_operands_bind_like_prefix_operators(): void {
    let n = 5;
    let arr = [10, 20];
    let x = 6;
    Assert.eq((n) - 1, 4);
    Assert.eq((arr)[1], 20);
    Assert.eq((int)-3.99, -3);
    Assert.eq((int)~x, -7);
    Assert.eq((int)char.parse("A").unwrap(), 65);
    Assert.eq((uint)(int)'B', 66u);
    Assert.eq((int)2.5 + 1, 3);
}

@noinline
fun c3a1_matches_type<T>(value: object): bool {
    if value is T narrowed {
        return narrowed is T;
    }
    return false;
}

@noinline
fun c3a1_type_name(value: object): string {
    return typeof(value);
}

@test
fun direct_calls_box_object_arguments(): void {
    Assert.eq(c3a1_type_name(42), "int");
    Assert.eq(c3a1_type_name(c3a1_Level.High), "c3a1_Level");
}

@test
fun generic_type_tests_use_the_specialized_type(): void {
    Assert.is_true(c3a1_matches_type<int>(42));
    Assert.is_false(c3a1_matches_type<string>(42));
    Assert.is_true(c3a1_matches_type<c3a1_Level>(c3a1_Level.High));
}

class c3a1_Unrelated {}

@test
fun boxed_types_match_exact_arrays_and_implemented_interfaces(): void {
    let unrelated: object = c3a1_Unrelated();
    let shape: object = c3a1_Square();
    Assert.is_true(shape is c3a1_Shape);
    Assert.is_false(unrelated is c3a1_Shape);
    Assert.eq(((c3a1_Shape)shape).sides(), 4);
    if shape is c3a1_Shape matched {
        Assert.eq(matched.sides(), 4);
    } else {
        Assert.is_true(false);
    }

    let ints: object = [1, 2];
    let strings: object = Array.alloc<string>(0);
    Assert.is_true(ints is int[]);
    Assert.is_false(ints is string[]);
    Assert.is_true(strings is string[]);
    Assert.is_false(strings is int[]);
    Assert.eq(((int[])ints)[1], 2);
    Assert.eq(typeof(ints), "array");

    let scalar: object = 42;
    Assert.is_true(scalar is object);
}
