import system.testing;
// A lambda that calls a captured `fun` value: the callee is read through its capture cell,
// including `void` callees used as statements and expression bodies.

import system;
import system.collections;

fun c7a_wrap_bool(handler: fun(bool): void): fun(string): void {
    return (body: string) => handler(body == "1");
}

fun c7a_wrap_pair(handler: fun(int, int): void): fun(string): void {
    return (body: string) => {
        let parts = body.split('\n');
        handler(int.parse(parts[0]).unwrap_or(0), int.parse(parts[1]).unwrap_or(0));
    };
}

fun c7a_wrap_value(get: fun(): int): fun(): int {
    return () => get() * 2;
}

fun c7a_body(): void {
    let fired = List<fun(string): void>();
    fired.push(c7a_wrap_bool((on: bool) => c7a_verify_observation(("flag " + on).to_string())));
    fired.push(c7a_wrap_pair((a: int, b: int) => c7a_verify_observation(("pair " + (a + b)).to_string())));
    fired.get(0)("1");
    fired.get(0)("0");
    fired.get(1)("20\n22");
    let doubled = c7a_wrap_value(() => 21);
    c7a_verify_observation((doubled()).to_string());
}

let c7a_cursor: int = 0;

fun c7a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "flag true\nflag false\npair 42\n42\n";
    let end = c7a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c7a_cursor, end));
    c7a_cursor = end;
}

@test
@timeout(180000)

fun closure_calls_captured_fun(): void {
    c7a_cursor = 0;
    c7a_body();
    Assert.eq(c7a_cursor, ("flag true\nflag false\npair 42\n42\n").length);
}
