import system.testing;
// Milestone B: capturing closures (v1 — a lambda captures at most one variable from its
// immediately enclosing function). A captured name (parameter or `let`) is boxed into a shared
// `CaptureCell<T>` so both the closure and the enclosing function see each other's writes.

import system;
fun c7b_make_adder(n: int): fun(int): int {
    return (x) => x + n; // captures parameter `n`
}

@test
@timeout(180000)
fun closure_capture(): void {
    let add5: fun(int): int = c7b_make_adder(5);
    Assert.eq_str((add5(10)).to_string(), "15");
    Assert.eq_str((add5(20)).to_string(), "25");

    let counter: int = 0;
    let inc: fun(): int = () => {
        counter = counter + 1; // mutates the enclosing `let` through the shared cell
        return counter;
    };
    Assert.eq_str((inc()).to_string(), "1");
    Assert.eq_str((inc()).to_string(), "2");
    Assert.eq_str((counter).to_string(), "2"); // visible to the enclosing scope too: 2
}
