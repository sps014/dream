import system.testing;
// String concatenation and interpolation stringify a non-string operand with its `to_string`. For a
// C-style enum that means the variant *name*, matching `Color.Green.to_string()`, not the raw
// discriminant. Other types keep their normal rendering.

import system;
enum c97_Color { Red, Green, Blue }

class c97_P { public x: int; public constructor(x: int) { this.x = x; } }

@test
@timeout(180000)
fun concat_enum_name(): void {
    let c = c97_Color.Green;
    Assert.eq_str((c.to_string()).to_string(), "Green");   // Green
    Assert.eq_str(("c=" + c).to_string(), "c=Green");        // c=Green
    Assert.eq_str(($"c={c}").to_string(), "c=Green");        // c=Green
    Assert.eq_str(("n=" + 42 + " b=" + true + " p=" + c97_P(3)).to_string(), "n=42 b=true p=c97_P { x: 3 }");   // other types unaffected
}
