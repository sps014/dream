import system.testing;
// A class may declare more than one `constructor` overload; the matching one is selected by
// argument count/types exactly like an overloaded free function or method call.
import system;
class c9d_Point {
    public x: int;
    public y: int;

    public constructor() {
        this.x = 0;
        this.y = 0;
    }

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }

    public constructor(both: int) {
        this.x = both;
        this.y = both;
    }

    public fun describe(): string {
        return "(" + this.x + ", " + this.y + ")";
    }
}

@test
@timeout(180000)
fun constructor_overload_basic(): void {
    let a = c9d_Point();
    let b = c9d_Point(3, 4);
    let c = c9d_Point(5);
    Assert.eq_str((a.describe()).to_string(), "(0, 0)");
    Assert.eq_str((b.describe()).to_string(), "(3, 4)");
    Assert.eq_str((c.describe()).to_string(), "(5, 5)");
}
