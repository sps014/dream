import system.testing;
import system;
import system.collections;

class cd8_Box {
    public items: List<string>;

    public constructor() {
        this.items = List<string>();
    }
}

fun cd8_make(n: int): List<int> {
    let xs = List<int>();
    for (let i = 0; i < n; i++) {
        xs.push(i);
    }
    return xs;
}

let c2a3_logged: int = 0;
let c2a3_last: int = 0;

fun c2a3_log_positive(n: int): void {
    if n < 0 {
        return;
    }
    c2a3_logged = c2a3_logged + 1;
    c2a3_last = n;
}

fun cc8_side(): int {
    return 9;
}

@test
@timeout(180000)
fun branching(): void {
    let x = 10;
    let trace = "";

    if x > 5 {
        if x < 15 {
            if x == 10 {
                trace = trace + "1;";
            } else {
                trace = trace + "0;";
            }
        } else {
            trace = trace + "0;";
        }
    } else {
        trace = trace + "0;";
    }

    if x < 5 {
        trace = trace + "0;";
    } else if (x == 10) {
        trace = trace + "2;";
    } else if (x > 10) {
        trace = trace + "0;";
    } else {
        trace = trace + "0;";
    }

    let i = 0;
    while i < 10 {
        if i == 3 {
            break;
        }
        trace = trace + i.to_string() + ";";
        i = i + 1;
    }

    for (let j = 0; j < 5; j = j + 1) {
        if j == 1 {
            continue;
        }
        if j == 3 {
            continue;
        }
        trace = trace + j.to_string() + ";";
    }

    for (let a = 0; a < 2; a = a + 1) {
        for (let b = 0; b < 2; b = b + 1) {
            trace = trace + (a * 10 + b).to_string() + ";";
        }
    }

    Assert.eq(trace, "1;2;0;1;2;0;2;4;0;1;10;11;");
}

@test
@timeout(180000)
fun do_while(): void {
    let trace = "";
    let i: int = 0;
    do {
        trace = trace + i.to_string() + ";";
        i = i + 1;
    } while (i < 3);

    let j: int = 10;
    do {
        trace = trace + j.to_string() + ";";
        j = j + 1;
    } while (j < 5);

    Assert.eq(trace, "0;1;2;10;");
}

@test
@timeout(180000)
fun labeled_loops(): void {
    let trace = "";
    outer: for (let i: int = 0; i < 3; i = i + 1) {
        for (let j: int = 0; j < 3; j = j + 1) {
            if j == 1 {
                continue outer;
            }
            if i == 2 {
                break outer;
            }
            trace = trace + (i * 10 + j).to_string() + ";";
        }
    }
    Assert.eq(trace, "0;10;");
}

@test
@timeout(180000)
fun ergonomics_basics(): void {
    let trace = "";
    let n = 3;
    if (n > 0)trace = trace + "1;";
    else trace = trace + "0;";
    let i = 0;
    while i < 2 {
        trace = trace + i.to_string() + ";";
        i++;
    }
    for (let j = 0; j < 2; j++)trace = trace + j.to_string() + ";";
    Assert.eq(trace, "1;0;1;0;1;");

    let k = 0;
    let a = k++;
    let b =++k;
    Assert.eq(a, 0);
    Assert.eq(b, 2);
    cc8_side() + 1;
}

// A bare `return;` exits a `void` function early.
@test
@timeout(180000)
fun void_early_return(): void {
    c2a3_logged = 0;
    c2a3_log_positive(0 - 5);
    Assert.eq(c2a3_logged, 0);
    c2a3_log_positive(7);
    Assert.eq(c2a3_last, 7);
    c2a3_log_positive(0 - 1);
    Assert.eq(c2a3_last, 7);
    c2a3_log_positive(42);
    Assert.eq(c2a3_last, 42);
    Assert.eq(c2a3_logged, 2);
}

@test
@timeout(180000)
fun foreach_list(): void {
    let total = 0;
    for (let x in cd8_make(10)) {
        if x == 2 {
            continue;
        }
        if x == 7 {
            break;
        }
        total = total + x;
    }
    Assert.eq(total, 19);

    let words = List<string>();
    words.push("alpha");
    words.push("beta");
    words.push("gamma");
    let joined = "";
    for (let w in words) {
        joined = joined + w + ";";
    }
    Assert.eq(joined, "alpha;beta;gamma;");

    let grid = List<List<string>>();
    grid.push(words);
    grid.push(List<string>());
    let inner = List<string>();
    inner.push("z");
    grid.push(inner);
    let count = 0;
    outer: for (let row in grid) {
        for (let cell in row) {
            count = count + 1;
            if cell == "z" {
                break outer;
            }
        }
    }
    Assert.eq(count, 4);

    let b = cd8_Box();
    b.items.push("x");
    b.items.push("y");
    let items = "";
    for (let s in b.items) {
        items = items + s + ";";
    }
    Assert.eq(items, "x;y;");

    let empty = List<int>();
    let visited = 0;
    for (let e in empty) {
        visited = visited + 1;
    }
    Assert.eq(visited, 0);
}

@test
@timeout(180000)
fun nested_declarations_shadow_only_their_scope(): void {
    let y = 1;
    if true {
        let y = "inner";
        Assert.eq(y, "inner");
    }
    Assert.eq(y + 1, 2);

    let z = 10;
    let seen = 0;
    for (let z in 0..3) {
        seen = seen + z;
    }
    Assert.eq(seen, 3);
    Assert.eq(z, 10);

    let w = 5;
    let o: Option<int> = Some(7);
    switch (o) {
        Some(w) => Assert.eq(w, 7),
        None => {}
    }
    Assert.eq(w, 5);

    let label = switch (o) {
        Some(w) => $"some {w}",
        None => "none",
    };
    Assert.eq(label, "some 7");
    Assert.eq(w, 5);
}

fun cf_first_over(limit: int): int {
    for (let k = 0; ; k++) {
        if (k > limit) {
            return k;
        }
    }
}

fun cf_labeled_exit(stop: bool): int {
    outer: while (true) {
        while (true) {
            if (stop) {
                break outer;
            }
            continue outer;
        }
    }
    return 7;
}

@test
fun for_headers_may_omit_parts(): void {
    let i = 0;
    let seen = 0;
    for (; i < 3; i++) {
        seen += i;
    }
    Assert.eq(seen, 3);
    let n = 0;
    for (;;) {
        n++;
        if (n > 2) {
            break;
        }
    }
    Assert.eq(n, 3);
    Assert.eq(cf_first_over(4), 5);
    Assert.eq(cf_labeled_exit(true), 7);
}

class cd8_TypeTestSource {
    public calls: int;

    public fun next_object(): object {
        this.calls++;
        if this.calls <= 2 {
            return this.calls;
        }
        return "done";
    }

    public fun next_int(): int {
        this.calls++;
        return this.calls;
    }

    public fun third_call(): bool {
        return this.next_object() is string;
    }
}

@test
fun is_binding_uses_the_value_that_was_tested(): void {
    let source = cd8_TypeTestSource();
    if source.next_object() is int value && value == 1 && value == 1 {
        Assert.eq(value, 1);
    } else {
        Assert.is_true(false);
    }
    Assert.eq(source.calls, 1);

    if source.next_object() is int value && source.third_call() {
        Assert.eq(value, 2);
    } else {
        Assert.is_true(false);
    }
    Assert.eq(source.calls, 3);
}

@test
fun while_is_binding_refreshes_once_per_test(): void {
    let source = cd8_TypeTestSource();
    let sum = 0;
    while source.next_object() is int value && value < 10 {
        sum += value;
    }
    Assert.eq(sum, 3);
    Assert.eq(source.calls, 3);
}

let cd8_global_type_test = 3 is int candidate && candidate == 3;

@test
fun static_is_binding_respects_short_circuit_order(): void {
    Assert.is_true(cd8_global_type_test);
    let source = cd8_TypeTestSource();
    if false && source.next_int() is int unreachable_value {
        Assert.eq(unreachable_value, 0);
    }
    Assert.eq(source.calls, 0);

    if source.next_int() is int value && source.next_int() == 2 && value == 1 {
        Assert.eq(value, 1);
    } else {
        Assert.is_true(false);
    }
    Assert.eq(source.calls, 2);

    if source.next_int() is int value {
        Assert.eq(value, 3);
    }
    Assert.eq(source.calls, 3);
}

fun cd8_increment(ref value: int): bool {
    value++;
    return value == 1;
}

@test
fun is_binding_ref_arguments_stay_inside_the_guard(): void {
    let source = cd8_TypeTestSource();
    let erased: object = source;
    if false && erased is cd8_TypeTestSource skipped && cd8_increment(ref skipped.calls) {
        Assert.is_true(false);
    }
    Assert.eq(source.calls, 0);

    if erased is cd8_TypeTestSource narrowed && cd8_increment(ref narrowed.calls) {
        Assert.eq(narrowed.calls, 1);
    } else {
        Assert.is_true(false);
    }
    Assert.eq(source.calls, 1);
}
