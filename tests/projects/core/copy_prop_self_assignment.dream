import system.testing;
import system;

class ca3_Box {
    public value: int;
    public constructor(value: int) {
        this.value = value;
    }
}

fun ca3_identity<T>(value: T): T {
    return value;
}

fun ca3_body(): void {
    let result = ca3_identity<int>(0);
    for (let i = 0; i < 0; i++) {
        if (i % 2 == 0) {
            result += i;
        } else {
            result -= i;
        }
    }
    let box = ca3_Box(result);
    result = box.value;
    result = result;
    ca3_verify_observation((result).to_string());
}

let ca3_cursor: int = 0;

fun ca3_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "0\n";
    let end = ca3_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(ca3_cursor, end));
    ca3_cursor = end;
}

@test
@timeout(180000)

fun copy_prop_self_assignment(): void {
    ca3_cursor = 0;
    ca3_body();
    Assert.eq(ca3_cursor, ("0\n").length);
}
