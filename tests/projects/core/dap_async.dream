import system.testing;
import system;
fun caa_compute(n: int): int {
    let total = 0;
    let i = 0;
    while i < n {
        total = total + i;
        i = i + 1;
    }
    return total;
}

async fun caa_body(): void {
    let base = 10;
    let sum = caa_compute(base);
    if sum > 5 {
        caa_verify_observation((sum).to_string());
    }
}

let caa_cursor: int = 0;

fun caa_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "45\n";
    let end = caa_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(caa_cursor, end));
    caa_cursor = end;
}

@test
@timeout(180000)

async fun dap_async(): void {
    caa_cursor = 0;
    caa_body().await;
    Assert.eq(caa_cursor, ("45\n").length);
}
