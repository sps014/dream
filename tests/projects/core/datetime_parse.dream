import system.testing;
// Exercises `DateTime.parse_iso8601` end-to-end: UTC ("Z"), an explicit positive offset, a
// fractional-second value with more than 3 digits (truncated to milliseconds), and malformed
// input (`Err`). Round-trips parsed values back through `to_iso8601()` to confirm both directions
// agree.
import system;
@test
@timeout(180000)
fun datetime_parse(): void {
    let a = DateTime.parse("2026-07-02T10:35:00.250Z");
    Assert.eq_str((a.is_ok()).to_string(), "true");
    Assert.eq_str((a.unwrap_or(DateTime.from_epoch_millis(0L)).to_iso8601()).to_string(), "2026-07-02T10:35:00.250Z");

    let b = DateTime.parse("2026-07-02T16:05:00+05:30");
    let b_dt = b.unwrap_or(DateTime.from_epoch_millis(0L));
    Assert.eq_str((b_dt.to_iso8601()).to_string(), "2026-07-02T16:05:00.000+05:30");
    Assert.eq_str((b_dt.to_utc().to_iso8601()).to_string(), "2026-07-02T10:35:00.000Z");

    let c = DateTime.parse("2026-07-02T10:35:00.1234567Z");
    Assert.eq_str((c.unwrap_or(DateTime.from_epoch_millis(0L)).millisecond).to_string(), "123");

    let d = DateTime.parse("not-a-date");
    Assert.eq_str((d.is_err()).to_string(), "true");

    let f = DateTime.parse("2026-13-02T10:35:00Z");
    Assert.eq_str((f.is_err()).to_string(), "true");

    let g = DateTime.parse("2026-07-02T10:35:00");
    Assert.eq_str((g.unwrap_or(DateTime.from_epoch_millis(0L)).to_iso8601()).to_string(), "2026-07-02T10:35:00.000Z");
}
