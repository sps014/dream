import system.testing;
import system;

fun cbe_side(): int {
    return 7;
}

async fun cbe_tick(): int {
    return 1;
}

@test
@timeout(180000)
async fun discard_binding(): void {
    let _ = 1;
    let _ = cbe_side();
    let (_, _) = (1, 2);
    let (_, y) = (3, 4);
    Assert.eq((y).to_string(), "4");
    let _ = cbe_tick().await;
    cbe_tick().await;
}
