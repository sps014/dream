import system.testing;
import system;

fun cc8_body(): void {
    let n = 3;
    if (n > 0) cc8_verify_observation((1).to_string()); else cc8_verify_observation((0).to_string());
    let i = 0;
    while i < 2 {
        cc8_verify_observation((i).to_string());
        i++;
    }
    for (let j = 0; j < 2; j++) cc8_verify_observation((j).to_string());
    let k = 0;
    let a = k++;
    let b = ++k;
    cc8_verify_observation((a).to_string());
    cc8_verify_observation((b).to_string());
    cc8_side() + 1;
}

fun cc8_side(): int {
    return 9;
}

let cc8_cursor: int = 0;

fun cc8_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "1\n0\n1\n0\n1\n0\n2\n";
    let end = cc8_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(cc8_cursor, end));
    cc8_cursor = end;
}

@test
@timeout(180000)

fun ergonomics_basics(): void {
    cc8_cursor = 0;
    cc8_body();
    Assert.eq(cc8_cursor, ("1\n0\n1\n0\n1\n0\n2\n").length);
}
