import system.testing;
import system;
import system.json;
import system.collections;

@json
class f16j_Sample {
    public weight: float16;
    public bias: float16;
    public history: List<float16>;
    public gain: Option<float16>;

    public constructor(
        weight: float16,
        bias: float16,
        history: List<float16>,
        gain: Option<float16>
    ) {
        this.weight = weight;
        this.bias = bias;
        this.history = history;
        this.gain = gain;
    }
}

@test
@timeout(180000)
fun float16_json(): void {
    let history = List<float16>();
    history.push(0.5h);
    history.push(0.1h);
    let sample = f16j_Sample(0.1h, -2.0h, history, Option.Some(1.5h));

    let text = Json.serialize(sample);
    Assert.is_true(text.contains("\"weight\":0.1"));
    Assert.is_true(text.contains("\"bias\":-2"));

    let back = Json.deserialize<f16j_Sample>(text)
        .unwrap_or(f16j_Sample(0.0h, 0.0h, List<float16>(), Option.None));
    Assert.eq(back.weight, 0.1h);
    Assert.eq(back.bias, -2.0h);
    Assert.eq(back.history.length, 2);
    Assert.eq(back.history[1], 0.1h);
    Assert.eq(back.gain.unwrap_or(0.0h), 1.5h);

    let tree = sample.to_json();
    let none = JsonValue.none();
    Assert.eq(tree["weight"].unwrap_or(none).as_double().unwrap_or(0.0d), 0.0999755859375d);

    let parsed = Json.deserialize<f16j_Sample>(
        "{\"weight\":0.33333,\"bias\":70000,\"history\":[2049],\"gain\":null}"
    ).unwrap_or(f16j_Sample(0.0h, 0.0h, List<float16>(), Option.None));
    Assert.eq(parsed.weight, 0.333251953125h);
    Assert.is_true(parsed.bias.is_infinite());
    Assert.eq(parsed.history[0], 2048.0h);
    Assert.is_true(parsed.gain.is_none());
}
