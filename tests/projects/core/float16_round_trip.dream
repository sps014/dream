import system.testing;
import system;

// Every finite binary16 magnitude as an exact double: subnormals are m * 2^-24, normals
// (1024 + m) * 2^(e - 25).
fun f16f_value(e: int, m: int): double {
    let scale = 5.9604644775390625e-08d;
    let significand = (double)m;
    if e > 0 {
        significand = (double)(1024 + m);
        let k = 1;
        while k < e {
            scale = scale * 2.0d;
            k = k + 1;
        }
    }
    return significand * scale;
}

@test
@timeout(180000)
fun float16_round_trip(): void {
    let checked = 0;
    let e = 0;
    while e < 31 {
        let m = 0;
        while m < 1024 {
            let x = (float16)f16f_value(e, m);
            Assert.eq((double)x, f16f_value(e, m));
            let text = x.to_string();
            let back = float16.parse(text).unwrap_or(-1.0h);
            if back != x {
                Assert.fail("round trip of " + text + " gave " + back);
            }
            let negative = -x;
            let negative_back = float16.parse(negative.to_string()).unwrap_or(1.0h);
            if negative_back != negative {
                Assert.fail("round trip of " + negative.to_string() + " gave " + negative_back);
            }
            checked = checked + 1;
            m = m + 1;
        }
        e = e + 1;
    }
    Assert.eq(checked, 31744);
}
