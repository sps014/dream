import system.testing;
import system;

@test
@timeout(180000)
fun float16_rounding(): void {
    // Narrowing rounds to nearest, ties to even.
    Assert.eq((float16)2049.0d, 2048.0h);
    Assert.eq((float16)2051.0d, 2052.0h);
    Assert.eq((float16)2049.0001d, 2050.0h);
    Assert.eq((float16)1.00048828125d, 1.0h);
    Assert.eq((float16)1.00146484375d, 1.001953125h);
    Assert.eq((float16)65519.0d, 65504.0h);
    Assert.is_true(((float16)65520.0d).is_infinite());

    // Arithmetic results round the same way.
    let one = 1.0h;
    let half_eps = float16.epsilon / 2.0h;
    Assert.eq(one + half_eps, 1.0h);
    Assert.eq(one + float16.epsilon, 1.0009765625h);
    let big = 2048.0h;
    Assert.eq(big + one, 2048.0h);
    Assert.eq(big + one + one + one, 2048.0h);
    Assert.eq(big + 3.0h, 2052.0h);
    Assert.eq(1.0h / 3.0h, 0.333251953125h);
    Assert.eq((double)(1.0h / 3.0h), 0.333251953125d);
}
