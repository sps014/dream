import system.testing;
// `for (let x in list)` over a `List<T>`: control flow, reference elements, nesting, and
// iterables that are expressions rather than locals.
import system;
import system.collections;

class cd8_Box {
    public items: List<string>;

    public constructor() {
        this.items = List<string>();
    }
}

fun cd8_make(n: int): List<int> {
    let xs = List<int>();
    for (let i = 0; i < n; i++) {
        xs.push(i);
    }
    return xs;
}

fun cd8_body(): void {
    let total = 0;
    for (let x in cd8_make(10)) {
        if x == 2 {
            continue;
        }
        if x == 7 {
            break;
        }
        total = total + x;
    }
    cd8_verify_observation((total).to_string());

    let words = List<string>();
    words.push("alpha");
    words.push("beta");
    words.push("gamma");
    let joined = "";
    for (let w in words) {
        joined = joined + w + ";";
    }
    cd8_verify_observation((joined).to_string());

    let grid = List<List<string>>();
    grid.push(words);
    grid.push(List<string>());
    let inner = List<string>();
    inner.push("z");
    grid.push(inner);
    let count = 0;
    outer: for (let row in grid) {
        for (let cell in row) {
            count = count + 1;
            if cell == "z" {
                break outer;
            }
        }
    }
    cd8_verify_observation((count).to_string());

    let b = cd8_Box();
    b.items.push("x");
    b.items.push("y");
    for (let s in b.items) {
        cd8_verify_observation((s).to_string());
    }

    let empty = List<int>();
    for (let e in empty) {
        cd8_verify_observation((e).to_string());
    }
    cd8_verify_observation(("done").to_string());
}

let cd8_cursor: int = 0;

fun cd8_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "19\nalpha;beta;gamma;\n4\nx\ny\ndone\n";
    let end = cd8_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(cd8_cursor, end));
    cd8_cursor = end;
}

@test
@timeout(180000)

fun foreach_list_index(): void {
    cd8_cursor = 0;
    cd8_body();
    Assert.eq(cd8_cursor, ("19\nalpha;beta;gamma;\n4\nx\ny\ndone\n").length);
}
