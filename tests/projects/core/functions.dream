import system.testing;
import system;
fun cdb_fib(n: int): int {
    if n <= 1 {
        return n;
    }
    return cdb_fib(n - 1) + cdb_fib(n - 2);
}

fun cdb_add3(a: int, b: int, c: int): int {
    return a + b + c;
}

fun cdb_body(): void {

    let a= cdb_fib;
    a(5);
    cdb_verify_observation((cdb_fib(5)).to_string());
    cdb_verify_observation((cdb_fib(7)).to_string());
    cdb_verify_observation((cdb_add3(10, 20, 30)).to_string());
}

let cdb_cursor: int = 0;

fun cdb_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "5\n13\n60\n";
    let end = cdb_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(cdb_cursor, end));
    cdb_cursor = end;
}

@test
@timeout(180000)

fun functions(): void {
    cdb_cursor = 0;
    cdb_body();
    Assert.eq(cdb_cursor, ("5\n13\n60\n").length);
}
