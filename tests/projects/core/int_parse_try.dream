import system.testing;
import system;

fun cfa_parse_or_propagate(s: string): Result<int, ParseError> {
    let n = int.parse(s)?;
    return Result.Ok(n);
}

fun cfa_body(): void {
    switch (cfa_parse_or_propagate("42")) {
        Ok(n) => cfa_verify_observation((n).to_string()),
        Err(e) => cfa_verify_observation(("err: " + e.message()).to_string()),
    }
    switch (cfa_parse_or_propagate("nope")) {
        Ok(n) => cfa_verify_observation((n).to_string()),
        Err(e) => cfa_verify_observation(("err: " + e.message()).to_string()),
    }
}

let cfa_cursor: int = 0;

fun cfa_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "42\nerr: cannot parse int: invalid digit\n";
    let end = cfa_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(cfa_cursor, end));
    cfa_cursor = end;
}

@test
@timeout(180000)

fun int_parse_try(): void {
    cfa_cursor = 0;
    cfa_body();
    Assert.eq(cfa_cursor, ("42\nerr: cannot parse int: invalid digit\n").length);
}
