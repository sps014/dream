import system.testing;
import system;

interface c108_Animal {
    fun speak(): int;
}

class c108_Cat: c108_Animal {
    public fun speak(): int {
        return 3;
    }
}

class c108_Dog: c108_Animal {
    public fun speak(): int {
        return 0;
    }
}

// Exercises `is`-binding used inside a *later* conjunct of the same `&&` chain, both directly
// (second conjunct) and past an intermediate plain-bool conjunct (third conjunct).
fun c108_describe(a: c108_Animal, flag: bool): string {
    if a is c108_Cat t && t.speak() >= 0 && flag {
        return "flagged cat";
    }
    return "other";
}

fun c108_body(): void {
    c108_verify_observation((c108_describe(c108_Cat(), true)).to_string());
    c108_verify_observation((c108_describe(c108_Cat(), false)).to_string());
    c108_verify_observation((c108_describe(c108_Dog(), true)).to_string());
}

let c108_cursor: int = 0;

fun c108_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "flagged cat\nother\nother\n";
    let end = c108_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c108_cursor, end));
    c108_cursor = end;
}

@test
@timeout(180000)

fun is_binding_and_chain(): void {
    c108_cursor = 0;
    c108_body();
    Assert.eq(c108_cursor, ("flagged cat\nother\nother\n").length);
}
