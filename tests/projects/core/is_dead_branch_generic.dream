import system.testing;
// Inside a generic instantiation a dead `is` branch is only valid for other type arguments,
// so it must stay unchecked: `x * 2` is fine for `T = int` and skipped for `T = string`.
import system;

fun c10a_describe<T>(x: T): void {
    if (x is int) {
        c10a_verify_observation((x * 2).to_string());
    } else {
        c10a_verify_observation(("not an int").to_string());
    }
}

fun c10a_body(): void {
    c10a_describe<int>(21);
    c10a_describe<string>("hi");
}

let c10a_cursor: int = 0;

fun c10a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "42\nnot an int\n";
    let end = c10a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c10a_cursor, end));
    c10a_cursor = end;
}

@test
@timeout(180000)

fun is_dead_branch_generic(): void {
    c10a_cursor = 0;
    c10a_body();
    Assert.eq(c10a_cursor, ("42\nnot an int\n").length);
}
