import system.testing;
// Milestone A: non-capturing arrow-lambdas, lowered to synthesized top-level functions reusing the
// existing `fun(...)` FuncRef ABI unchanged. Covers: expr-bodied and block-bodied lambdas, a lambda
// assigned to a `let`, a lambda passed to a free-function `fun(...)` parameter, a lambda passed
// directly as a method-call argument (`List.sort_by`), and parameter-type inference from context
// (an untyped `(a, b) => ...` infers its parameter types from the expected `fun(...)` signature).

import system;
import system.collections;
fun c128_apply(f: fun(int): int, v: int): int {
    return f(v);
}

fun c128_body(): void {
    let add: fun(int, int): int = (x: int, y: int) => x + y;
    c128_verify_observation((add(2, 3)).to_string());

    let square: fun(int): int = (x: int) => {
        let r = x * x;
        return r;
    };
    c128_verify_observation((square(5)).to_string());

    c128_verify_observation((c128_apply((x: int) => x + 100, 1)).to_string());

    let nums: List<int> = List<int>();
    nums.push(3);
    nums.push(1);
    nums.push(2);
    nums.sort_by((a, b) => a - b);
    for (let n in nums) {
        c128_verify_observation((n).to_string());
    }
}

let c128_cursor: int = 0;

fun c128_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "5\n25\n101\n1\n2\n3\n";
    let end = c128_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c128_cursor, end));
    c128_cursor = end;
}

@test
@timeout(180000)

fun lambda_basics(): void {
    c128_cursor = 0;
    c128_body();
    Assert.eq(c128_cursor, ("5\n25\n101\n1\n2\n3\n").length);
}
