import system.testing;
// Futures are lazy: calling an `async fun` constructs a `Future<T>` but does not run it.
// The body executes only when the future is awaited (or started via `Promise.start`).
import system;

async fun c12c_work(n: int): int {
    c12c_verify_observation(("work " + n.to_string()).to_string());
    return n * 2;
}

async fun c12c_body(): void {
    let f = c12c_work(21);
    c12c_verify_observation(("created").to_string());
    let v = f.await;
    c12c_verify_observation(("got " + v.to_string()).to_string());
}

let c12c_cursor: int = 0;

fun c12c_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "created\nwork 21\ngot 42\n";
    let end = c12c_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c12c_cursor, end));
    c12c_cursor = end;
}

@test
@timeout(180000)

async fun lazy_unstarted_never_runs(): void {
    c12c_cursor = 0;
    c12c_body().await;
    Assert.eq(c12c_cursor, ("created\nwork 21\ngot 42\n").length);
}
