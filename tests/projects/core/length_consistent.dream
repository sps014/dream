import system.testing;
// `length` is the single, uniform element-count property across every collection: raw arrays,
// strings, `List`, and `Map` all answer to the same `.length`.
import system;
import system.collections;

@test
@timeout(180000)
fun length_consistent(): void {
    let a = Array.alloc<int>(4);
    Assert.eq((a.length).to_string(), "4"); // 4  (array)

    let s = "hello";
    Assert.eq((s.length).to_string(), "5"); // 5  (string)

    let xs = List<int>();
    xs.push(10);
    xs.push(20);
    xs.push(30);
    Assert.eq((xs.length).to_string(), "3"); // 3  (list)

    let m = Map<string, int>();
    m["a"] = 1;
    m["b"] = 2;
    Assert.eq((m.length).to_string(), "2"); // 2  (map)
}
