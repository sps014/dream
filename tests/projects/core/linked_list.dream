import system.testing;
// `next` is a self-reference (`Node` holding a strong `Option<Node>`), so the compiler's
// structural cycle check flags it: it cannot prove this list is never wired into a loop. This
import system;

@allow_cycle
class c130_Node {
    public value: int;
    public next: Option<c130_Node>;

    public constructor(value: int, next: Option<c130_Node>) {
        this.value = value;
        this.next = next;
    }
}

fun c130_create_node(val: int): c130_Node {
    let no_next: Option<c130_Node> = Option.None;
    let n = c130_Node(val, no_next);
    return n;
}

fun c130_body(): void {
    let head = c130_create_node(10);
    let second = c130_create_node(20);
    let third = c130_create_node(30);
    second.next = Option.Some(third);
    head.next = Option.Some(second);

    let curr: Option<c130_Node> = Option.Some(head);
    let done = false;
    while !done {
        switch (curr) {
            Some(n) => {
                c130_verify_observation((n.value).to_string());
                curr = n.next;
            }
            None => {
                done = true;
            }
        }
    }
}

let c130_cursor: int = 0;

fun c130_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "10\n20\n30\n";
    let end = c130_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c130_cursor, end));
    c130_cursor = end;
}

@test
@timeout(180000)

fun linked_list(): void {
    c130_cursor = 0;
    c130_body();
    Assert.eq(c130_cursor, ("10\n20\n30\n").length);
}
