import system.testing;
import system;

@test
@timeout(180000)
fun math_advanced(): void {
    let p = Math.pow(2.0d, 3.0d);
    Assert.eq((p).to_string(), "8");

    let f = Math.floor(3.7d);
    Assert.eq((f).to_string(), "3");

    let c = Math.ceil(3.2d);
    Assert.eq((c).to_string(), "4");

    let r = Math.round(3.5d);
    Assert.eq((r).to_string(), "4");

    let a = (-42.5d).abs();
    Assert.eq((a).to_string(), "42.5");

    let s = Math.sqrt(16.0d);
    Assert.eq((s).to_string(), "4");

    let z = Math.sin(0.0d);
    Assert.eq((z).to_string(), "0");

    // asin(0) / acos(1) / atan(0) — native inverses
    Assert.eq((Math.asin(0.0d)).to_string(), "0");
    Assert.eq((Math.acos(1.0d)).to_string(), "0");
    Assert.eq((Math.atan(0.0d)).to_string(), "0");
}
