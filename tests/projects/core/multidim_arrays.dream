import system.testing;
import system;

@test
@timeout(180000)
fun multidim_arrays() {
    let grid: int[][] = [[1, 2, 3], [4, 5, 6]];
    Assert.eq((grid.length).to_string(), "2");
    Assert.eq((grid[0].length).to_string(), "3");
    Assert.eq((grid[1][2]).to_string(), "6");

    let words: string[][] = [["hello", "world"], ["foo"]];
    Assert.eq((words[0][1]).to_string(), "world");
    Assert.eq((words[1][0]).to_string(), "foo");
}
