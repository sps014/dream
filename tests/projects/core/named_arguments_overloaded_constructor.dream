import system.testing;
// Named arguments work on overloaded constructors.

import system;
class c163_Point {
    public x: int;
    public y: int;

    public constructor(x: int) {
        this.x = x;
        this.y = 0;
    }

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@test
@timeout(180000)
fun named_arguments_overloaded_constructor(): void {
    let p = c163_Point(x: 3, y: 4);
    Assert.eq_str((p.x).to_string(), "3");
    Assert.eq_str((p.y).to_string(), "4");
}
