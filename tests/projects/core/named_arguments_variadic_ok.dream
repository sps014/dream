import system.testing;
// Named args for fixed parameters may mix with trailing positional variadic args.
import system;

fun c167_sum_with_base(base: int, ...nums: int[]): int {
    let total = base;
    for (let n in nums) {
        total = total + n;
    }
    return total;
}

fun c167_body(): void {
    c167_verify_observation((c167_sum_with_base(base: 10, 1, 2, 3)).to_string());
    c167_verify_observation((c167_sum_with_base(base: 5)).to_string());
}

let c167_cursor: int = 0;

fun c167_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "16\n5\n";
    let end = c167_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c167_cursor, end));
    c167_cursor = end;
}

@test
@timeout(180000)

fun named_arguments_variadic_ok(): void {
    c167_cursor = 0;
    c167_body();
    Assert.eq(c167_cursor, ("16\n5\n").length);
}
