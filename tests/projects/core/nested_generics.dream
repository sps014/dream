import system.testing;
import system;
class c16a_Box<T> {
    public v: T;

    public constructor(v: T) {
        this.v = v;
    }
}

class c16a_Pair<A, B> {
    public first: A;
    public second: B;

    public constructor(first: A, second: B) {
        this.first = first;
        this.second = second;
    }
}

@test
@timeout(180000)
fun nested_generics() {
    let b = c16a_Box<c16a_Box<int>>(c16a_Box<int>(7));
    Assert.eq_str((b.v.v).to_string(), "7");

    let p = c16a_Pair<c16a_Box<int>, int>(c16a_Box<int>(99), 5);
    Assert.eq_str((p.first.v).to_string(), "99");
    Assert.eq_str((p.second).to_string(), "5");
}
