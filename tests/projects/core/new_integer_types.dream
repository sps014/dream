import system.testing;
// End-to-end coverage for the long/uint/ulong/byte primitives: literals, width-specific
// arithmetic (signed vs unsigned), implicit widening, explicit narrowing casts, boxing into
// object, string conversion, byte arrays, and the prelude extension methods.
import system;

@test
@timeout(180000)
fun new_integer_types() {
    let b: byte = 200b;
    let u: uint = 4000000000u;
    let l: long = 9000000000L;
    let ul: ulong = 18000000000uL;
    Assert.eq(b, 200b);
    Assert.eq(u, 4000000000u);
    Assert.eq(l, 9000000000L);
    Assert.eq(ul, 18000000000uL);
    Assert.eq(l * 2L, 18000000000L);
    Assert.eq(u / 3u, 1333333333u);
    Assert.eq((byte)(200b + 100b), 44b);

    let w: long = 5;
    let d: double = l;
    let ul2: ulong = u;
    Assert.eq(w, 5L);
    Assert.eq(d, 9000000000d);
    Assert.eq(ul2, 4000000000uL);
    Assert.eq((int)l, 410065408);

    let o: object = l;
    Assert.eq_str(o.to_string(), "9000000000");
    Assert.eq_str("v=" + ul, "v=18000000000");
    let arr: byte[] = [10b, 20b, 30b];
    Assert.eq(arr[2], 30b);
    Assert.eq_str(arr.to_string(), "[10, 20, 30]");
    Assert.eq((0L - 7L).abs(), 7L);
    Assert.eq(l.max(w), 9000000000L);
    Assert.eq(byte.parse("250").unwrap_or(0b), 250b);
    let big: uint = 3000000000u;
    Assert.is_true(big > 1000000000u);
}
