import system.testing;
import system;

@noinline
fun c16d_keep(x: int): int { return x + 1; }

fun c16d_kitchenSink(x: int): int { return x + 2; }

@noinline
fun c16d_run(n: int): int { return c16d_keep(n) + c16d_kitchenSink(n); }

@test
@timeout(180000)
fun noinline_attribute(): void {
    Assert.eq_str((c16d_run(3)).to_string(), "9");
}
