import system.testing;
// An optional value struct (`Option<Point>`) replaces the old nullable-value-struct feature:
// `Some`/`None` make the "no value" case explicit, and `unwrap_or` (the `??` sugar) hands back an
// inline `Point` either way.
import system;

struct c16f_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

fun c16f_show(p: Option<c16f_Point>): void {
    if p.is_none() {
        c16f_verify_observation(("none").to_string());
    } else {
        c16f_verify_observation(("some").to_string());
    }
}

fun c16f_body(): void {
    let a: Option<c16f_Point> = Option.Some(c16f_Point(3, 4));
    let b: Option<c16f_Point> = Option.None;
    c16f_show(a);
    c16f_show(b);

    // Coalesce back to an inline Point, then read its fields.
    let c: c16f_Point = a ?? c16f_Point(0, 0);
    c16f_verify_observation((c.x).to_string());
    c16f_verify_observation((c.y).to_string());
    let d: c16f_Point = b ?? c16f_Point(7, 8);
    c16f_verify_observation((d.x).to_string());
    c16f_verify_observation((d.y).to_string());
}

let c16f_cursor: int = 0;

fun c16f_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "some\nnone\n3\n4\n7\n8\n";
    let end = c16f_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c16f_cursor, end));
    c16f_cursor = end;
}

@test
@timeout(180000)

fun nullable_value_struct(): void {
    c16f_cursor = 0;
    c16f_body();
    Assert.eq(c16f_cursor, ("some\nnone\n3\n4\n7\n8\n").length);
}
