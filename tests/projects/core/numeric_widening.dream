import system.testing;
// Implicit numeric widening (int -> float -> double) at method-call arguments. Regression test
// for codegen failing to promote a narrower numeric on the WASM operand stack (e.g. passing a
// `float`/`int` literal to a `double` parameter), which previously produced an invalid module.

import system;
class c173_Calc {
    public static fun identity(x: double): double {
        return x;
    }

    public static fun add(a: double, b: double): double {
        return a + b;
    }
}

fun c173_body(): void {
    // float literal -> double parameter
    let a = c173_Calc.identity(1.5f);
    c173_verify_observation((a).to_string());

    // int literal -> double parameter
    let b = c173_Calc.identity(3);
    c173_verify_observation((b).to_string());

    // both arguments widened (int -> double)
    let c = c173_Calc.add(10, 20);
    c173_verify_observation((c).to_string());
}

let c173_cursor: int = 0;

fun c173_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "1.5\n3\n30\n";
    let end = c173_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c173_cursor, end));
    c173_cursor = end;
}

@test
@timeout(180000)

fun numeric_widening(): void {
    c173_cursor = 0;
    c173_body();
    Assert.eq(c173_cursor, ("1.5\n3\n30\n").length);
}
