import system.testing;
import system;

fun c194_add(a: int, b: int): int { return a + b; }
fun c194_add(a: double, b: double): double { return a + b + 0.5d; }
fun c194_add(a: string, b: string): string { return a + b; }

fun c194_apply(f: fun(int, int): int, x: int, y: int): int { return f(x, y); }

@test
@timeout(180000)
fun overload_function_value(): void {
    let fi: fun(int, int): int = c194_add;
    let fd: fun(double, double): double = c194_add;
    let fs: fun(string, string): string = c194_add;
    Assert.eq_str((fi(2, 3)).to_string(), "5");
    Assert.eq_str((fd(1.0d, 2.0d)).to_string(), "3.5");
    Assert.eq_str((fs("a", "b")).to_string(), "ab");
    Assert.eq_str((c194_apply(c194_add, 4, 5)).to_string(), "9");
}
