import system.testing;
// Overloaded extension methods on a primitive resolve by argument type. `this` is the int
// value (a stack value), supplied implicitly as the receiver.
import system;

extend int {
    public fun combine(other: int): int {
        return this + other;
    }

    public fun combine(other: string): int {
        return this + 100;
    }
}

@test
@timeout(180000)
fun overload_methods(): void {
    let n: int = 5;
    Assert.eq_str((n.combine(3)).to_string(), "8"); // 8    (int overload)
    Assert.eq_str((n.combine("x")).to_string(), "105"); // 105  (string overload)
}
