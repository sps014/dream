import system.testing;
// Overloading combined with default parameter values. `scale` has two overloads: one taking an
// int (with a defaulted multiplier) and one taking a string. Calls resolve by argument type, and
// omitted trailing arguments fall back to their defaults. An exact-arity call is preferred over a
// defaulted one.
import system;

fun c199_scale(n: int, by: int = 2): int {
    return n * by;
}

fun c199_scale(s: string): string {
    return s + s;
}

@test
@timeout(180000)
fun overload_with_defaults(): void {
    Assert.eq((c199_scale(5)).to_string(), "10"); // int overload, default by=2 -> 10
    Assert.eq((c199_scale(5, 3)).to_string(), "15"); // int overload, explicit by=3 -> 15
    Assert.eq((c199_scale("ab")).to_string(), "abab"); // string overload -> "abab"
}
