import system.testing;
import system;

class c1a7_Holder {
    public items: int[];
    public constructor(items: int[]) {
        this.items = items;
    }
}

fun c1a7_store(items: int[]): int {
    let holder = c1a7_Holder([]);
    let original = items[0];
    if original > 0 {
        let items = [7];
        holder.items = items;
        c1a7_verify_observation((items[0]).to_string());
    }
    return original + holder.items[0];
}

fun c1a7_body(): void {
    c1a7_verify_observation((c1a7_store([1])).to_string());
}

let c1a7_cursor: int = 0;

fun c1a7_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "7\n8\n";
    let end = c1a7_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1a7_cursor, end));
    c1a7_cursor = end;
}

@test
@timeout(180000)

fun parameter_shadow_store(): void {
    c1a7_cursor = 0;
    c1a7_body();
    Assert.eq(c1a7_cursor, ("7\n8\n").length);
}
