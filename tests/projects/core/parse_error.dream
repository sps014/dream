import system.testing;
import system;
fun c1a8_body(): void {
    switch (int.parse("42")) {
        Ok(n) => c1a8_verify_observation((n).to_string()),
        Err(e) => c1a8_verify_observation((e.message()).to_string()),
    }
    switch (int.parse("nope")) {
        Ok(n) => c1a8_verify_observation((n).to_string()),
        Err(e) => c1a8_verify_observation((e.code() + ":" + e.message()).to_string()),
    }
    switch (float.parse("1.5")) {
        Ok(n) => c1a8_verify_observation((n).to_string()),
        Err(e) => c1a8_verify_observation((e.message()).to_string()),
    }
}

let c1a8_cursor: int = 0;

fun c1a8_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "42\nEPARSE:cannot parse int: invalid digit\n1.5\n";
    let end = c1a8_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1a8_cursor, end));
    c1a8_cursor = end;
}

@test
@timeout(180000)

fun parse_error(): void {
    c1a8_cursor = 0;
    c1a8_body();
    Assert.eq(c1a8_cursor, ("42\nEPARSE:cannot parse int: invalid digit\n1.5\n").length);
}
