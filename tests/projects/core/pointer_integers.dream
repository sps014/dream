import system.testing;
import system;

struct c1ae_WordPair {
    public signed: isize;
    public unsigned: usize;
}

fun c1ae_signed_step(x: isize): isize {
    return x - (isize)1;
}

fun c1ae_unsigned_half(x: usize): usize {
    return x / (usize)2;
}

async fun c1ae_async_word(x: usize): usize {
    return x + (usize)1;
}

@test
@timeout(180000)
async fun pointer_integers(): void {
    let signed: isize = 42;
    let unsigned: usize = 42;
    Assert.eq((sizeof(isize) == sizeof(string)).to_string(), "true");
    Assert.eq((sizeof(usize) == sizeof(string)).to_string(), "true");
    Assert.eq((sizeof(c1ae_WordPair) == sizeof(string) * 2).to_string(), "true");
    Assert.eq((c1ae_signed_step(signed)).to_string(), "41");
    Assert.eq((c1ae_unsigned_half(unsigned)).to_string(), "21");
    let maximum: usize = ~(usize)0;
    Assert.eq((maximum > unsigned).to_string(), "true");
    Assert.eq(((maximum + (usize)1) == (usize)0).to_string(), "true");
    Assert.eq(((maximum >>(usize)(sizeof(usize) * 8 - 1)) == (usize)1).to_string(), "true");
    let negative: isize = (isize)0 - (isize)1;
    Assert.eq((negative < (isize)0).to_string(), "true");
    Assert.eq(((negative >>(isize)1) == negative).to_string(), "true");
    let words: usize[] = [unsigned, (usize)9];
    Assert.eq((words[1]).to_string(), "9");
    let box: object = unsigned;
    Assert.eq(((usize)box == unsigned).to_string(), "true");
    Assert.eq((typeof(box)).to_string(), "usize");
    Assert.eq((box).to_string(), "42");
    let call: fun(usize): usize = c1ae_unsigned_half;
    Assert.eq((call(unsigned)).to_string(), "21");
    let capture = () => c1ae_unsigned_half(unsigned);
    Assert.eq((capture()).to_string(), "21");
    let result = c1ae_async_word(unsigned).await;
    Assert.eq((result).to_string(), "43");
    Assert.eq((usize.parse("42").unwrap_or((usize)0)).to_string(), "42");
    Assert.eq((isize.parse("-42").unwrap_or((isize)0)).to_string(), "-42");
    Assert.eq((usize.parse("4294967296").is_err() == (sizeof(usize) == 4)).to_string(), "true");
    Assert.eq((isize.parse("2147483648").is_err() == (sizeof(isize) == 4)).to_string(), "true");
    Assert.eq((unsigned.compare((usize)9)).to_string(), "1");
    Assert.eq((maximum.to_string().length >= 10).to_string(), "true");
}
