import system.interop;
import system.testing;

struct RawPair {
    public small: byte;
    public count: long;
    public constructor(small: byte, count: long) { this.small = small; this.count = count; }
}

@packed
struct RawPackedPair {
    public small: byte;
    public count: long;
    public constructor(small: byte, count: long) { this.small = small; this.count = count; }
}

struct RawNode {
    public value: int;
    public next: RawPtr<RawNode>;
    public constructor(value: int, next: RawPtr<RawNode>) { this.value = value; this.next = next; }
}

struct T {
    public value: long;
    public constructor(value: long) { this.value = value; }
}

fun raw_element_size<T: unmanaged>(): int { return sizeof(T); }

@unsafe
@test
fun raw_ptr_basic(): void {
    let p = RawPtr<int>.alloc(4);
    p.write(10);
    p[1] = 20;
    p.offset(2).write(30);
    p[3] = 40;
    let alias = p;
    Assert.is_true(p == alias);
    alias.write(11);
    Assert.eq(p.read(), 11);
    Assert.eq(p.byte_offset(sizeof(int)).read(), 20);
    let q = RawPtr<int>.alloc(4);
    p.copy_to(q, 4);
    Assert.eq(q[2], 30);
    p.move_to(p.offset(1), 3);
    Assert.eq(p[1], 11);
    Assert.eq(p[2], 20);
    Assert.eq(p[3], 30);
    p = p.realloc(8);
    Assert.eq(p[3], 30);
    p[7] = 70;
    Assert.eq(p[7], 70);
    p.free();
    Assert.is_true(p.is_null());
    q.free();
    let zeroed = RawPtr<long>.alloc_zeroed(3);
    Assert.is_true(zeroed[2] == (long)0);
    zeroed.free();
    let bytes = RawPtr<byte>.alloc(8);
    bytes.fill_bytes((byte)7, 8);
    Assert.eq((int)bytes[7], 7);
    bytes.free();
    let aligned = RawPtr<int>.alloc_aligned(1, 256);
    Assert.is_true(aligned.address() % (usize)256 == (usize)0);
    aligned.write(42);
    aligned = aligned.realloc(2);
    Assert.eq(aligned.read(), 42);
    Assert.is_true(aligned.address() % (usize)256 == (usize)0);
    aligned.free();
    let pairs = RawPtr<RawPair>.alloc(2);
    pairs.write(RawPair((byte)3, (long)42));
    let snapshot = pairs.read();
    pairs.write(RawPair((byte)9, (long)99));
    Assert.eq((int)snapshot.small, 3);
    Assert.is_true(snapshot.count == (long)42);
    Assert.is_true(pairs.read().count == (long)99);
    pairs.free();
    let packed = RawPtr<RawPackedPair>.alloc(1);
    packed.write(RawPackedPair((byte)4, (long)123));
    Assert.is_true(packed.read().count == (long)123);
    Assert.eq(alignof(RawPackedPair), 1);
    packed.free();
    let nodes = RawPtr<RawNode>.alloc(2);
    nodes[1] = RawNode(77, RawPtr<RawNode>.null());
    nodes[0] = RawNode(11, nodes.offset(1));
    Assert.eq(nodes.read().next.read().value, 77);
    nodes.free();
    let named_type = RawPtr<T>.alloc(1);
    named_type.write(T((long)456));
    Assert.is_true(named_type.read().value == (long)456);
    Assert.eq(raw_element_size<T>(), sizeof(long));
    named_type.free();
    Assert.eq(alignof(RawPair), 8);
    Assert.is_true(sizeof(RawPtr<int>) == sizeof(usize));
    let empty = RawPtr<int>.alloc(0);
    Assert.is_true(empty.is_null());
    empty.free();
}
