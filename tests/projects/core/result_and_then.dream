import system.testing;
import system;

fun c1e7_parse_even(s: string): Result<int, ParseError> {
    let parsed = int.parse(s);
    if parsed.is_err() {
        return Result.Err(ParseError.invalid("parse"));
    }
    let n = parsed.unwrap_or(0);
    if (n % 2) != 0 {
        return Result.Err(ParseError.invalid("odd"));
    }
    return Result.Ok(n);
}

fun c1e7_double_ok(n: int): Result<int, ParseError> {
    return Result.Ok(n * 2);
}

fun c1e7_body(): void {
    switch (c1e7_parse_even("10").and_then(c1e7_double_ok)) {
        Ok(v) => c1e7_verify_observation((v).to_string()),
        Err(e) => c1e7_verify_observation((e.message()).to_string()),
    }
    switch (c1e7_parse_even("3").and_then(c1e7_double_ok)) {
        Ok(v) => c1e7_verify_observation((v).to_string()),
        Err(e) => c1e7_verify_observation((e.message()).to_string()),
    }
}

let c1e7_cursor: int = 0;

fun c1e7_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "20\nodd\n";
    let end = c1e7_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1e7_cursor, end));
    c1e7_cursor = end;
}

@test
@timeout(180000)

fun result_and_then(): void {
    c1e7_cursor = 0;
    c1e7_body();
    Assert.eq(c1e7_cursor, ("20\nodd\n").length);
}
