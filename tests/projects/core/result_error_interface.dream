import system.testing;
// `Result<T, MyError>` is assignable to `Result<T, Error>` when `MyError : Error`.
// `?` rebuilds `Err` at the function's Result type; interface dispatch on `E` still works.

import system;

class c1e8_MyError : Error {
    _m: string;

    public constructor(m: string) {
        this._m = m;
    }

    public fun message(): string {
        return this._m;
    }

    public fun code(): string {
        return "EMINE";
    }
}

fun c1e8_fail(): Result<bool, c1e8_MyError> {
    return Result.Err(c1e8_MyError("boom"));
}

fun c1e8_ok(): Result<bool, c1e8_MyError> {
    return Result.Ok(true);
}

fun c1e8_via_try(): Result<bool, Error> {
    let v = c1e8_fail()?;
    return Result.Ok(v);
}

fun c1e8_via_return(): Result<bool, Error> {
    return c1e8_fail();
}

fun c1e8_body() {
    let r: Result<bool, Error> = c1e8_via_return();
    switch (r) {
        Ok(_) => { c1e8_verify_observation(("unexpected ok").to_string()); }
        Err(e) => {
            c1e8_verify_observation((e.code()).to_string());
            c1e8_verify_observation((e.message()).to_string());
        }
    }

    let t = c1e8_via_try();
    switch (t) {
        Ok(_) => { c1e8_verify_observation(("unexpected try ok").to_string()); }
        Err(e) => { c1e8_verify_observation((e.code()).to_string()); }
    }

    let lifted: Result<bool, Error> = c1e8_ok();
    switch (lifted) {
        Ok(v) => { c1e8_verify_observation((v).to_string()); }
        Err(_) => { c1e8_verify_observation(("unexpected err").to_string()); }
    }
}

let c1e8_cursor: int = 0;

fun c1e8_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "EMINE\nboom\nEMINE\ntrue\n";
    let end = c1e8_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1e8_cursor, end));
    c1e8_cursor = end;
}

@test
@timeout(180000)

fun result_error_interface(): void {
    c1e8_cursor = 0;
    c1e8_body();
    Assert.eq(c1e8_cursor, ("EMINE\nboom\nEMINE\ntrue\n").length);
}
