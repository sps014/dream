import system.testing;
// A bare numeric literal returned from a wider-typed function must widen to the function's
// declared return type: `return 2.71828;` from a `fun f(): double` used to keep the literal's own
// (narrower) inferred type, silently desyncing the value from every call site that trusts the
// declared `double` signature.
import system;

fun c1e9_asDouble(): double {
    return 2.71828;
}

fun c1e9_asFloat(): float {
    return 1.5;
}

fun c1e9_asLong(): long {
    return 42;
}

@test
@timeout(180000)
fun return_numeric_widening(): void {
    let d = c1e9_asDouble();
    let f = c1e9_asFloat();
    let l = c1e9_asLong();
    Assert.eq_str(("" + d).to_string(), "2.71828");
    Assert.eq_str(("" + f).to_string(), "1.5");
    Assert.eq_str(("" + l).to_string(), "42");
}
