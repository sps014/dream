import system.testing;
import system;

fun c1ed_count_paths(n: int): int {
    if n < 2 {
        return n;
    }
    return c1ed_count_paths(n - 1) + c1ed_count_paths(n - 2);
}

fun c1ed_signed_sum(n: int): int {
    if n < 2 {
        return n * 3;
    }
    return c1ed_signed_sum(n - 1) - c1ed_signed_sum(n - 2);
}

fun c1ed_duplicate(n: int, x: double): double {
    if n < 1 {
        return x;
    }
    return c1ed_duplicate(n - 1, x) + c1ed_duplicate(n - 1, x);
}

fun c1ed_wrap_sum(n: int, x: int): int {
    if n < 1 {
        return x;
    }
    return c1ed_wrap_sum(n - 1, x) + c1ed_wrap_sum(n - 1, x);
}

fun c1ed_body() {
    c1ed_verify_observation((c1ed_count_paths(-7)).to_string());
    c1ed_verify_observation((c1ed_count_paths(0)).to_string());
    c1ed_verify_observation((c1ed_count_paths(1)).to_string());
    c1ed_verify_observation((c1ed_count_paths(10)).to_string());
    c1ed_verify_observation((c1ed_count_paths(20)).to_string());
    c1ed_verify_observation((c1ed_signed_sum(12)).to_string());
    c1ed_verify_observation((c1ed_wrap_sum(1, 2147483647)).to_string());
    let infinity: double = (double)1 / (double)0;
    c1ed_verify_observation(((double)1 / c1ed_duplicate(3, -(double)0) == -infinity).to_string());
    c1ed_verify_observation((c1ed_duplicate(3, infinity) == infinity).to_string());
    let nan = c1ed_duplicate(3, infinity - infinity);
    c1ed_verify_observation((nan != nan).to_string());
}

let c1ed_cursor: int = 0;

fun c1ed_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "-7\n0\n1\n55\n6765\n0\n-2\ntrue\ntrue\ntrue\n";
    let end = c1ed_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c1ed_cursor, end));
    c1ed_cursor = end;
}

@test
@timeout(180000)

fun scalar_recursive_expansion(): void {
    c1ed_cursor = 0;
    c1ed_body();
    Assert.eq(c1ed_cursor, ("-7\n0\n1\n55\n6765\n0\n-2\ntrue\ntrue\ntrue\n").length);
}
