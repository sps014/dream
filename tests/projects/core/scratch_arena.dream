import system.testing;
import system;

fun c1ef_body(): void {
    let arena = ScratchArena<int>(256);
    let round = 0;
    while round < 3 {
        let a = arena.alloc(4);
        let i = 0;
        while i < a.length {
            a[i] = round * 10 + i;
            i = i + 1;
        }
        c1ef_verify_observation((a[0]).to_string());
        c1ef_verify_observation((a[3]).to_string());
        c1ef_verify_observation((arena.remaining).to_string());
        arena.reset();
        c1ef_verify_observation((arena.remaining).to_string());
        round = round + 1;
    }

    let bytes = ScratchArena<byte>(8);
    let b = bytes.alloc(3);
    b[0] = (byte)1;
    b[1] = (byte)2;
    b[2] = (byte)3;
    c1ef_verify_observation(((int)b[0]).to_string());
    c1ef_verify_observation(((int)b[2]).to_string());
    c1ef_verify_observation((bytes.remaining).to_string());
}

let c1ef_cursor: int = 0;

fun c1ef_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "0\n3\n252\n256\n10\n13\n252\n256\n20\n23\n252\n256\n1\n3\n5\n";
    let end = c1ef_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1ef_cursor, end));
    c1ef_cursor = end;
}

@test
@timeout(180000)

fun scratch_arena(): void {
    c1ef_cursor = 0;
    c1ef_body();
    Assert.eq(c1ef_cursor, ("0\n3\n252\n256\n10\n13\n252\n256\n20\n23\n252\n256\n1\n3\n5\n").length);
}
