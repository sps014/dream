import system.testing;
// A `sealed` type rejects user `extend` blocks, but compiler-synthesized extends are exempt: a
// sealed class may still implement an interface and inherit its default methods (which are injected
// as a synthesized `extend`). This compiles and runs only if that exemption holds.
import system;

interface c1f0_Greeter {
    fun name(): string;
    public fun greet(): string {
        return this.name();
    }
}

sealed class c1f0_Robot: c1f0_Greeter {
    public fun name(): string {
        return "beep";
    }
}

fun c1f0_body(): void {
    let r = c1f0_Robot();
    c1f0_verify_observation((r.greet()).to_string());

    let g: c1f0_Greeter = (c1f0_Greeter)r;
    c1f0_verify_observation((g.greet()).to_string());
}

let c1f0_cursor: int = 0;

fun c1f0_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "beep\nbeep\n";
    let end = c1f0_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1f0_cursor, end));
    c1f0_cursor = end;
}

@test
@timeout(180000)

fun sealed_interface(): void {
    c1f0_cursor = 0;
    c1f0_body();
    Assert.eq(c1f0_cursor, ("beep\nbeep\n").length);
}
