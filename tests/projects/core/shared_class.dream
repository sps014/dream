import system.testing;
import system;
import system.task;

shared class c1f3_Counter {
    public value: int;

    public constructor() {
        this.value = 0;
    }

    public fun increment(): void {
        lock (this) {
            this.value = this.value + 1;
        }
    }

    public fun get(): int {
        lock (this) {
            return this.value;
        }
    }
}

fun c1f3_reentrant(counter: c1f3_Counter, depth: int): void {
    lock (counter) {
        if depth > 0 {
            c1f3_reentrant(counter, depth - 1);
        } else {
            counter.value = counter.value + 100;
        }
    }
}

class c1f4_Job {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }
}

// A shared object's whole reachable graph is shared, so every field uses the same `lock`
// discipline with no per-field move rules.
shared class c1f4_JobQueue {
    public head: Option<c1f4_Job>;
    public count: int;

    public constructor() {
        this.head = Option.None;
        this.count = 0;
    }
}

@test
@timeout(180000)
fun shared_class_lock_basic(): void {
    let c = c1f3_Counter();
    c.increment();
    c.increment();
    c.increment();
    Assert.eq(c.get(), 3);

    c1f3_reentrant(c, 3);
    Assert.eq(c.value, 103);

    let lock1 = Lock();
    lock1.acquire();
    lock1.acquire();
    lock1.release();
    lock1.release();

    let sem = Semaphore(2);
    sem.acquire();
    sem.acquire();
    sem.release();
    sem.release();
}

@test
@timeout(180000)
async fun shared_transfer_field(): void {
    let q = c1f4_JobQueue();

    let producer = Task.spawn(
        () => {
            lock (q) {
                q.head = Option.Some(c1f4_Job("build"));
                q.count = q.count + 1;
            }
            return 0;
        }
    );
    producer.await;
    Assert.eq(q.count, 1);

    let consumer = Task.spawn(
        () => {
            let seen = "empty";
            lock (q) {
                if q.head.is_some() {
                    seen = q.head.unwrap().name;
                    q.count = q.count - 1;
                }
            }
            return seen;
        }
    );
    Assert.eq(consumer.await, "build");
    Assert.eq(q.count, 0);
}
