import system.testing;
// `shared class` + `lock (obj) { ... }`: basic single-threaded sanity check (acquire, mutate,
// release; reentrancy; and that `Lock`/`Semaphore` work as standalone primitives).

import system;
shared class c1f3_Counter {
    public value: int;

    public constructor() {
        this.value = 0;
    }

    public fun increment(): void {
        lock (this) {
            this.value = this.value + 1;
        }
    }

    public fun get(): int {
        lock (this) {
            return this.value;
        }
    }
}

fun c1f3_reentrant(counter: c1f3_Counter, depth: int): void {
    lock (counter) {
        if depth > 0 {
            c1f3_reentrant(counter, depth - 1);
        } else {
            counter.value = counter.value + 100;
        }
    }
}

fun c1f3_body(): void {
    let c = c1f3_Counter();
    c.increment();
    c.increment();
    c.increment();
    c1f3_verify_observation((c.get()).to_string());

    c1f3_reentrant(c, 3);
    c1f3_verify_observation((c.value).to_string());

    let lock1 = Lock();
    lock1.acquire();
    lock1.acquire(); // reentrant
    lock1.release();
    lock1.release();
    c1f3_verify_observation(("lock ok").to_string());

    let sem = Semaphore(2);
    sem.acquire();
    sem.acquire();
    sem.release();
    sem.release();
    c1f3_verify_observation(("semaphore ok").to_string());
}

let c1f3_cursor: int = 0;

fun c1f3_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "3\n103\nlock ok\nsemaphore ok\n";
    let end = c1f3_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1f3_cursor, end));
    c1f3_cursor = end;
}

@test
@timeout(180000)

fun shared_class_lock_basic(): void {
    c1f3_cursor = 0;
    c1f3_body();
    Assert.eq(c1f3_cursor, ("3\n103\nlock ok\nsemaphore ok\n").length);
}
