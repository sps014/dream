import system.testing;
import system;
import system.simd;

@test
@timeout(180000)
fun simd_f32x4(): void {
    let a = [1, 2, 3, 4];
    let b = [10, 20, 30, 40];
    let c = [0, 0, 0, 0];
    (Vector<int>.load(a, 0) + Vector<int>.load(b, 0)).store(c, 0);
    Assert.eq_str((c[0]).to_string(), "11");
    Assert.eq_str((c[1]).to_string(), "22");
    Assert.eq_str((c[2]).to_string(), "33");
    Assert.eq_str((c[3]).to_string(), "44");

    let fa = [(float)1, (float)2, (float)3, (float)4];
    let fb = [(float)1, (float)1, (float)1, (float)1];
    let fc = [(float)0, (float)0, (float)0, (float)0];
    (Vector<float>.load(fa, 0) + Vector<float>.load(fb, 0)).store(fc, 0);
    Assert.eq_str(((int)fc[0]).to_string(), "2");
    Assert.eq_str((Vector<int>.lane_count()).to_string(), "4");
    Assert.eq_str((Vector<float>.lane_count()).to_string(), "4");
}
