import system.testing;
import system;

class c205_Acc {
    public n: int;

    public constructor(n: int) {
        this.n = n;
    }
}

@test
@timeout(180000)
fun sroa_user_ctor(): void {
    let a = c205_Acc(7);
    Assert.eq((a.n).to_string(), "7");
    let b = c205_Acc(3);
    let c = c205_Acc(4);
    Assert.eq((b.n + c.n).to_string(), "7");
}
