import system.testing;
import system;
class c207_Vec2 {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }

    public static fun origin(): c207_Vec2 {
        return c207_Vec2(0, 0);
    }

    public static fun of(x: int, y: int): c207_Vec2 {
        return c207_Vec2(x, y);
    }

    public fun sum(): int {
        return this.x + this.y;
    }
}

@test
@timeout(180000)
fun static_methods(): void {
    let o = c207_Vec2.origin();
    Assert.eq_str((o.sum()).to_string(), "0");
    let p = c207_Vec2.of(3, 4);
    Assert.eq_str((p.sum()).to_string(), "7");
    Assert.eq_str((int.parse("100").unwrap_or(0)).to_string(), "100");
}
