import system.testing;
import system;
@test
@timeout(180000)
async fun stopwatch_basic() {
    let sw = Stopwatch();

    // We can't deterministically test actual elapsed time since CI/environments vary,
    // but we can test the state transitions and that elapsed time is somewhat monotonic.

    Assert.eq_str((sw.is_running).to_string(), "true");

    sw.stop();
    Assert.eq_str((sw.is_running).to_string(), "false");

    let e1 = sw.elapsed_nanos;
    let e2 = sw.elapsed_ms;

    // Since it's stopped, these should be stable across multiple reads
    let e3 = sw.elapsed_nanos;
    Assert.eq_str((e1 == e3).to_string(), "true");

    sw.reset();
    Assert.eq_str((sw.is_running).to_string(), "false");
    Assert.eq_str((sw.elapsed_nanos).to_string(), "0");
    Assert.eq_str((sw.elapsed_ms).to_string(), "0");

    sw.restart();
    Assert.eq_str((sw.is_running).to_string(), "true");

    sw.stop();
    Assert.eq_str((sw.elapsed_nanos >= 0L).to_string(), "true"); // Should be >= 0

    // Counted empty loops are DCE'd by optimizing backends; sleep is observable work.
    sw.reset();
    sw.start();
    Time.sleep(1).await;
    sw.stop();

    let acc1 = sw.elapsed_nanos;
    Assert.eq_str((acc1 > 0L).to_string(), "true");

    sw.start();
    Time.sleep(1).await;
    sw.stop();

    let acc2 = sw.elapsed_nanos;
    Assert.eq_str((acc2 > acc1).to_string(), "true");
}
