import system.testing;
import system;
import system.text;

fun c20d_sum_bytes(s: string): int {
    let n = s.byte_size();
    let j = 0;
    let acc = 0;
    while j < n {
        acc = acc + (int)s.byte_at(j);
        j = j + 1;
    }
    return acc;
}

fun c20d_sum_chars(s: string): int {
    let n = s.length;
    let j = 0;
    let acc = 0;
    while j < n {
        acc = acc + (int)s.char_at(j);
        j = j + 1;
    }
    return acc;
}

fun c20d_body(): void {
    let lit = "ab";
    c20d_verify_observation((c20d_sum_bytes(lit)).to_string());
    c20d_verify_observation((c20d_sum_bytes(lit.substring(0, 2))).to_string());
    c20d_verify_observation((c20d_sum_chars(lit.substring(0, 2))).to_string());
    let s = "ab";
    let i = 0;
    let acc = 0;
    while i < 2 {
        acc = acc + (int)s.byte_at(0);
        s = "cd";
        i = i + 1;
    }
    c20d_verify_observation((acc).to_string());
}

let c20d_cursor: int = 0;

fun c20d_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "195\n195\n195\n196\n";
    let end = c20d_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c20d_cursor, end));
    c20d_cursor = end;
}

@test
@timeout(180000)

fun str_cursor_scan(): void {
    c20d_cursor = 0;
    c20d_body();
    Assert.eq(c20d_cursor, ("195\n195\n195\n196\n").length);
}
