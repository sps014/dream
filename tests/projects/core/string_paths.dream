import system.testing;
import system;
import system.json;
import system.text;

fun c20d_sum_bytes(s: string): int {
    let n = s.byte_size();
    let j = 0;
    let acc = 0;
    while j < n {
        acc = acc + (int)s.byte_at(j);
        j = j + 1;
    }
    return acc;
}

fun c20d_sum_chars(s: string): int {
    let n = s.length;
    let j = 0;
    let acc = 0;
    while j < n {
        acc = acc + (int)s[j];
        j = j + 1;
    }
    return acc;
}

@noinline
fun c260_format(n: double): void {
    let sb = StringBuilder(128);
    sb.append_double(n);
    let first = sb.build();
    Assert.eq(first, n.to_string());
    sb.append_double(2.5d);
    Assert.eq(first, n.to_string());
}

@test
@timeout(180000)
fun str_cursor_scan(): void {
    let lit = "ab";
    Assert.eq(c20d_sum_bytes(lit), 195);
    Assert.eq(c20d_sum_bytes(lit.substring(0, 2)), 195);
    Assert.eq(c20d_sum_chars(lit.substring(0, 2)), 195);
    let s = "ab";
    let i = 0;
    let acc = 0;
    while i < 2 {
        acc = acc + (int)s.byte_at(0);
        s = "cd";
        i = i + 1;
    }
    Assert.eq(acc, 196);
}

@test
@timeout(180000)
fun text_perf_paths(): void {
    let text = string.clone("\"hello😀\"");
    let parsed = Json.deserialize<JsonValue>(text).unwrap().as_string().unwrap();
    text[1] = 'X';
    Assert.eq(parsed, "hello😀");
    let empty = Json.deserialize<JsonValue>("\"\"").unwrap().as_string().unwrap();
    Assert.eq(empty.length, 0);
    Assert.eq(
        Json.deserialize<JsonValue>("\"line\\nnext\"").unwrap().as_string().unwrap(),
        "line\nnext"
    );
    c260_format(2.5d);
    c260_format(1.0e100d);
    let infinity = (double)1 / (double)0;
    c260_format(infinity);
    c260_format(-infinity);
    c260_format(infinity - infinity);
    c260_format(-(double)0);
    Assert.eq(infinity.to_string(), "inf");
    Assert.eq((-infinity).to_string(), "-inf");
    Assert.eq((infinity - infinity).to_string(), "nan");
}
