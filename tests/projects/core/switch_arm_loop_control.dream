import system.testing;
import system;

// `break` and `continue` inside a pattern-switch arm act on the enclosing loop.
async fun switch_arm_async_sum(values: int[]): int {
    let total = 0;
    for (let v in values) {
        switch (Option.Some(v)) {
            Some(x) => {
                if x % 2 == 0 {
                    continue;
                }
                if x > 7 {
                    break;
                }
                total = total + x;
            }
            None => {}
        }
    }
    return total;
}

@test
@timeout(180000)
async fun switch_arm_loop_control(): void {
    let seen = List<int>();
    for (let v in [1, 2, 3, 4, 5]) {
        switch (Option.Some(v)) {
            Some(x) => {
                if x == 2 {
                    continue;
                }
                if x == 4 {
                    break;
                }
                seen.push(x);
            }
            None => {}
        }
    }
    Assert.eq(seen.length, 2);
    Assert.eq(seen[0], 1);
    Assert.eq(seen[1], 3);

    let visited = 0;
    let i = 0;
    while i < 10 {
        i = i + 1;
        switch (i) {
            2 => {
                continue;
            }
            5 => {
                break;
            }
            _ => {
                visited = visited + 1;
            }
        }
    }
    Assert.eq(i, 5);
    Assert.eq(visited, 3);

    Assert.eq(switch_arm_async_sum([1, 2, 3, 4, 5, 9, 11]).await, 9);
}
