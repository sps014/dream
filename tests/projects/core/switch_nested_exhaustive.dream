import system.testing;
// Nested patterns over a discriminated union are recognized as exhaustive without a `_` arm:
// `Wrap(A(n))` + `Wrap(B)` together cover the `Wrap` variant (all of `Inner`), and `Bare` covers
// the rest of `Outer`. Coverage is computed recursively across arms in `check_exhaustiveness`.
import system;

enum c23b_Inner {
    A(int),
    B
}

enum c23b_Outer {
    Wrap(c23b_Inner),
    Bare
}

fun c23b_describe(o: c23b_Outer): int {
    return switch (o) {
        Wrap(A(n)) => n,
        Wrap(B) => -1,
        Bare => 0,
    };
}

fun c23b_body(): void {
    c23b_verify_observation((c23b_describe(c23b_Outer.Wrap(c23b_Inner.A(42)))).to_string());
    c23b_verify_observation((c23b_describe(c23b_Outer.Wrap(c23b_Inner.B))).to_string());
    c23b_verify_observation((c23b_describe(c23b_Outer.Bare)).to_string());
}

let c23b_cursor: int = 0;

fun c23b_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "42\n-1\n0\n";
    let end = c23b_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c23b_cursor, end));
    c23b_cursor = end;
}

@test
@timeout(180000)

fun switch_nested_exhaustive(): void {
    c23b_cursor = 0;
    c23b_body();
    Assert.eq(c23b_cursor, ("42\n-1\n0\n").length);
}
