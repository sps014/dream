import system.testing;
// A bare identifier arm that names no variant binds the *whole subject* to that name and acts as a
// catch-all: the subject value is copied into the local, so the arm body can use it (here, passed to
// another match). Previously this crashed codegen; now it lowers as the switch `default` with an
// injected binding.
import system;

enum c23d_E {
    A(int),
    B(int)
}

fun c23d_tag(e: c23d_E): int {
    return switch (e) {
        A(_) => 1,
        B(_) => 2,
    };
}

fun c23d_f(e: c23d_E): int {
    return switch (e) {
        A(n) => n,
        rest => c23d_tag(rest) + 100,
    };
}

fun c23d_body(): void {
    c23d_verify_observation((c23d_f(c23d_E.A(5))).to_string()); // matches A -> 5
    c23d_verify_observation((c23d_f(c23d_E.B(6))).to_string()); // whole-subject bind -> tag(B)=2, +100 -> 102
}

let c23d_cursor: int = 0;

fun c23d_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "5\n102\n";
    let end = c23d_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c23d_cursor, end));
    c23d_cursor = end;
}

@test
@timeout(180000)

fun switch_whole_bind(): void {
    c23d_cursor = 0;
    c23d_body();
    Assert.eq(c23d_cursor, ("5\n102\n").length);
}
