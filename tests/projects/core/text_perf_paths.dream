import system.testing;
import system;
import system.json;

@noinline
fun c260_format(n: double): void {
    let sb = StringBuilder(128);
    sb.append_double(n);
    let first = sb.build();
    c260_verify_observation((first == n.to_string()).to_string());
    sb.append_double(2.5d);
    c260_verify_observation((first == n.to_string()).to_string());
}

fun c260_body(): void {
    let text = string.clone("\"hello😀\"");
    let parsed = Json.deserialize<JsonValue>(text).unwrap().as_string().unwrap();
    text[1] = 'X';
    c260_verify_observation((parsed).to_string());
    let empty = Json.deserialize<JsonValue>("\"\"").unwrap().as_string().unwrap();
    c260_verify_observation((empty.length).to_string());
    c260_verify_observation(
        (Json.deserialize<JsonValue>("\"line\\nnext\"").unwrap().as_string().unwrap()).to_string()
    );
    c260_format(2.5d);
    c260_format(1.0e100d);
    let infinity = (double)1 / (double)0;
    c260_format(infinity);
    c260_format(-infinity);
    c260_format(infinity - infinity);
    c260_format(-(double)0);
    c260_verify_observation((infinity.to_string()).to_string());
    c260_verify_observation(((-infinity).to_string()).to_string());
    c260_verify_observation(((infinity - infinity).to_string()).to_string());
}

let c260_cursor: int = 0;

fun c260_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "hello😀\n0\nline\nnext\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ninf\n-inf\nnan\n";
    let end = c260_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c260_cursor, end));
    c260_cursor = end;
}

@test
@timeout(180000)

fun text_perf_paths(): void {
    c260_cursor = 0;
    c260_body();
    Assert.eq(
        c260_cursor,
        (
            "hello😀\n0\nline\nnext\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ninf\n-inf\nnan\n"
        ).length
    );
}
