import system.testing;
// `Time.delay` must suspend on the scheduler's timer queue: tasks finish in delay order, not
// start order, and racing `void` futures resolves with the first to finish.
import system;

class c261_Log {
    public text: string;

    public constructor() {
        this.text = "";
    }
}

async fun c261_after(log: c261_Log, ms: int, name: string): void {
    Time.delay(ms).await;
    log.text = log.text + name + " ";
}

@test
@timeout(180000)
async fun time_delay_suspends() {
    let log = c261_Log();
    Promise.all(
        [c261_after(log, 60, "slow"), c261_after(log, 5, "fast"), c261_after(log, 30, "mid")]
    ).await;
    Assert.eq_str((log.text).to_string(), "fast mid slow ");

    let t0 = Time.nano_time();
    Time.delay(40).await;
    // Node's timer clock is coarser than `nano_time`, so leave headroom: the bug was 0ms.
    let waited = (Time.nano_time() - t0) / 1000000;
    Assert.eq_str((waited >= 30).to_string(), "true");

    let race = c261_Log();
    Promise.race([c261_after(race, 50, "loser"), c261_after(race, 5, "winner")]).await;
    Assert.eq_str((race.text).to_string(), "winner ");
    Time.delay(80).await;
    Assert.eq_str((race.text).to_string(), "winner loser ");
}
