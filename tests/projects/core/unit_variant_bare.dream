import system.testing;
import system;

fun c284_take_opt(o: Option<int>): int {
    return switch (o) {
        Some(v) => v,
        None => 0,
    };
}

fun c284_body() {
    let a: Option<int> = None;
    let b: Option<int> = Some(7);
    c284_verify_observation((c284_take_opt(a)).to_string());
    c284_verify_observation((c284_take_opt(b)).to_string());
}

let c284_cursor: int = 0;

fun c284_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "0\n7\n";
    let end = c284_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c284_cursor, end));
    c284_cursor = end;
}

@test
@timeout(180000)

fun unit_variant_bare(): void {
    c284_cursor = 0;
    c284_body();
    Assert.eq(c284_cursor, ("0\n7\n").length);
}
