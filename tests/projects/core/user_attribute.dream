import system.testing;
import system;

@attribute(AttributeTarget.Function)
public struct c287_route {
    public path: string;
}

@c287_route("/users")
public fun c287_list_users(): void {
    c287_verify_observation(("users").to_string());
}

fun c287_body(): void {
    c287_list_users();
}

let c287_cursor: int = 0;

fun c287_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "users\n";
    let end = c287_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c287_cursor, end));
    c287_cursor = end;
}

@test
@timeout(180000)

fun user_attribute(): void {
    c287_cursor = 0;
    c287_body();
    Assert.eq(c287_cursor, ("users\n").length);
}
