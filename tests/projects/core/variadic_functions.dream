import system.testing;
// Variadic parameters (`...name: T[]`): zero, one, and several trailing arguments collected into
// an array, across a free function and an instance method.
import system;

fun c298_sum(...nums: int[]): int {
    let total = 0;
    for (let n in nums) {
        total = total + n;
    }
    return total;
}

fun c298_sum_with_base(base: int, ...nums: int[]): int {
    let total = base;
    for (let n in nums) {
        total = total + n;
    }
    return total;
}

class c298_Counter {
    public fun count_all(...items: string[]): int {
        let count = 0;
        for (let item in items) {
            c298_verify_observation((item).to_string());
            count = count + 1;
        }
        return count;
    }
}

fun c298_body(): void {
    c298_verify_observation((c298_sum()).to_string()); // 0
    c298_verify_observation((c298_sum(1)).to_string()); // 1
    c298_verify_observation((c298_sum(1, 2, 3)).to_string()); // 6

    c298_verify_observation((c298_sum_with_base(10)).to_string()); // 10
    c298_verify_observation((c298_sum_with_base(10, 1, 2, 3)).to_string()); // 16

    let c = c298_Counter();
    c298_verify_observation((c.count_all()).to_string()); // 0 (no lines printed)
    c298_verify_observation((c.count_all("a", "b")).to_string()); // prints "a","b", then 2
}

let c298_cursor: int = 0;

fun c298_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "0\n1\n6\n10\n16\n0\na\nb\n2\n";
    let end = c298_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c298_cursor, end));
    c298_cursor = end;
}

@test
@timeout(180000)

fun variadic_functions(): void {
    c298_cursor = 0;
    c298_body();
    Assert.eq(c298_cursor, ("0\n1\n6\n10\n16\n0\na\nb\n2\n").length);
}
