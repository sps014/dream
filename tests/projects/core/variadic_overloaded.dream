import system.testing;
// Variadic parameters work on overloaded functions.

import system;
fun c29b_h(x: int, ...rest: int[]): int {
    let total = x;
    for (let n in rest) {
        total = total + n;
    }
    return total;
}

fun c29b_h(x: string, ...rest: string[]): int {
    return 1;
}

fun c29b_body(): void {
    c29b_verify_observation((c29b_h(1, 2, 3)).to_string());
}

let c29b_cursor: int = 0;

fun c29b_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "6\n";
    let end = c29b_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c29b_cursor, end));
    c29b_cursor = end;
}

@test
@timeout(180000)

fun variadic_overloaded(): void {
    c29b_cursor = 0;
    c29b_body();
    Assert.eq(c29b_cursor, ("6\n").length);
}
