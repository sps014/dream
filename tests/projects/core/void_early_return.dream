import system.testing;
// A bare `return;` exits a `void` function early (an explicit `: void` return annotation is
// semantically the same as an unannotated function).

import system;
fun c2a3_log_positive(n: int): void {
    if n < 0 {
        return;
    }
    c2a3_verify_observation((n).to_string());
}

fun c2a3_body(): void {
    c2a3_log_positive(0 - 5);   // no output
    c2a3_log_positive(7);       // 7
    c2a3_log_positive(0 - 1);   // no output
    c2a3_log_positive(42);      // 42
}

let c2a3_cursor: int = 0;

fun c2a3_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "7\n42\n";
    let end = c2a3_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c2a3_cursor, end));
    c2a3_cursor = end;
}

@test
@timeout(180000)

fun void_early_return(): void {
    c2a3_cursor = 0;
    c2a3_body();
    Assert.eq(c2a3_cursor, ("7\n42\n").length);
}
