import system.encoding;
import system.testing;

@test
fun encoding_percent(): void {
    Assert.eq(Encoding.uri_decode_component("a+b%20é").unwrap(), "a+b é");
    Assert.eq(Encoding.form_decode_component("a+b%2b").unwrap(), "a b+");
    Assert.eq(Encoding.form_encode_component("a b+"), "a+b%2b");
    Assert.eq(Encoding.form_encode_component("~*"), "%7e*");
    Assert.eq(Encoding.uri_encode_component("~*"), "~%2a");
    Assert.eq(Encoding.uri_decode_component("日本語").unwrap(), "日本語");
    Assert.is_true(Encoding.uri_decode_component("%ff").is_err());
    Assert.is_true(Encoding.uri_decode_component("%a").is_err());
}

@test
@timeout(180000)
fun encoding_hex(): void {
    let bytes = ("hi").to_utf8();
    Assert.eq(Encoding.hex_encode(bytes), "6869");
    Assert.eq(string.from_utf8(Encoding.hex_decode("6869").unwrap()), "hi");
    Assert.eq(Encoding.hex_decode("xyz").unwrap_err().code(), "EPARSE");
}
