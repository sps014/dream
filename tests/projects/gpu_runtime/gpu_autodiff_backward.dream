module gpu_autodiff_backward;

import system.testing;
import system;
import system.gpu;

fun backward_label(backend: GpuBackend): string {
    let names = ["Auto", "Dx12", "Dx11", "Vulkan", "Metal", "Cuda", "WebGpu"];
    let index: int = backend;
    return names[index];
}

// Opens `backend`, or prints why this machine cannot run it and returns None.
async fun backward_device(backend: GpuBackend): Option<GpuDevice> {
    switch (GpuDevice.create(backend).await) {
        Ok(device) => {
            return Option.Some(device);
        }
        Err(GpuError.BackendUnavailable(reason)) => {
            System.println(
                "SKIP gpu_autodiff_backward on " + backward_label(backend) + ": " + reason
            );
        }
        Err(GpuError.NoDevice(reason)) => {
            System.println(
                "SKIP gpu_autodiff_backward on " + backward_label(backend) + ": " + reason
            );
        }
        Err(e) => {
            Assert.fail("gpu_autodiff_backward on " + backward_label(backend) + ": " + e.message());
        }
    }
    return Option.None;
}

fun backward_ok<T>(result: Result<T, GpuError>, what: string): T {
    switch (result) {
        Ok(value) => {
            return value;
        }
        Err(e) => {
            Assert.fail(what + ": " + e.message());
            return result.unwrap();
        }
    }
}

// GPU results are single precision; the references are double-precision central differences.
fun backward_close(actual: float, expected: double, what: string): void {
    let tolerance = 2e-3d * Math.max(1.0d, Math.abs(expected));
    if Math.abs((double)actual - expected) > tolerance {
        Assert.fail(what + ": got " + actual.to_string() + ", expected " + expected.to_string());
    }
}

fun backward_central(f: fun(double): double, x: double): double {
    let h = 1e-4d;
    return (f(x + h) - f(x - h)) / (2.0d * h);
}

@gpu
@differentiable
fun loss(weight: float, input: float, target: float): float {
    let prediction = weight * input;
    let error = prediction - target;
    return error * error;
}

// Each thread adds the gradient of its sample's squared error with respect to the shared
// weight into `gradients[0]`.
@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64, 1, 1)
fun train_step(
    @readonly inputs: GpuBuffer<float>,
    @readonly targets: GpuBuffer<float>,
    weights: GpuBuffer<float>,
    gradients: GpuBuffer<float>,
    n: int
): void {
    let i = global_id().x;
    if i >= n {
        return;
    }
    let w = GpuDiffPair.of(weights[0], 0.0f);
    let x = GpuDiffPair.constant(inputs[i]);
    let t = GpuDiffPair.constant(targets[i]);
    GpuDiff.backward3(loss, ref w, ref x, ref t, 1.0f);
    GpuAtomic.add_float(gradients, 0, w.derivative());
}

@gpu
@differentiable
fun radial(p: GpuVec2): float {
    return GpuMath.sin(p.x) * p.y * p.y;
}

// The gradient of `radial` with respect to its vector parameter, at each point.
@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64, 1, 1)
fun radial_gradient(@readonly points: GpuBuffer<GpuVec2>, out: GpuBuffer<GpuVec2>, n: int): void {
    let i = global_id().x;
    if i >= n {
        return;
    }
    let p = GpuDiffPair.of(points[i], GpuVec2.splat(0.0f));
    GpuDiff.backward(radial, ref p, 1.0f);
    out[i] = p.derivative();
}

public struct Line {
    public slope: float;
    public offset: float;
}

@gpu
@differentiable
fun line_loss(line: Line, input: float, target: float): float {
    let error = line.slope * input + line.offset - target;
    return error * error;
}

// The gradient of one sample's squared error with respect to both fields of a struct
// parameter; Slang derives the struct's differential type. `samples` holds (input, target).
@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64, 1, 1)
fun line_gradient(
    @readonly samples: GpuBuffer<GpuVec2>,
    out: GpuBuffer<GpuVec2>,
    slope: float,
    offset: float,
    n: int
): void {
    let i = global_id().x;
    if i >= n {
        return;
    }
    let line = Line();
    line.slope = slope;
    line.offset = offset;
    let l = GpuDiffPair.of(line, Line());
    let x = GpuDiffPair.constant(samples[i].x);
    let t = GpuDiffPair.constant(samples[i].y);
    GpuDiff.backward3(line_loss, ref l, ref x, ref t, 1.0f);
    out[i] = GpuVec2.of(l.derivative().slope, l.derivative().offset);
}

fun total_loss(w: double, inputs: float[], targets: float[]): double {
    let total = 0.0d;
    for (let i = 0; i < inputs.length; i = i + 1) {
        let error = w * (double)inputs[i] - (double)targets[i];
        total = total + error * error;
    }
    return total;
}

// Gradient descent on one weight: the GPU computes each step's gradient, which must match
// the finite difference of the total loss, and every step must lower the loss.
async fun backward_train(device: GpuDevice, label: string): void {
    let n = 200;
    let inputs = Array.alloc<float>(n);
    let targets = Array.alloc<float>(n);
    for (let i = 0; i < n; i = i + 1) {
        inputs[i] = (float)(i % 13) * 0.1f - 0.4f;
        targets[i] = 2.0f * inputs[i];
    }
    let input_buffer = backward_ok(device.buffer_from(inputs), "inputs");
    let target_buffer = backward_ok(device.buffer_from(targets), "targets");
    let weights = backward_ok(device.buffer_from([0.75f]), "weights");
    let gradients = backward_ok(device.buffer_from([0.0f]), "gradients");

    let w = 0.75f;
    let previous = total_loss((double)w, inputs, targets);
    for (let step = 0; step < 8; step = step + 1) {
        backward_ok(
            GpuShaders.train_step.dispatch(
                device,
                GpuDispatch.threads_1d(n),
                input_buffer,
                target_buffer,
                weights,
                gradients,
                n
            ).await,
            "train_step on " + label
        );
        let gradient = backward_ok(gradients.read().await, "read gradients")[0];
        let at = (double)w;
        backward_close(
            gradient,
            backward_central((v: double) => total_loss(v, inputs, targets), at),
            "train_step gradient on " + label
        );

        w = w - 2.0f * gradient / (float)n;
        backward_ok(weights.write([w]), "write weights");
        backward_ok(gradients.write([0.0f]), "reset gradients");
        let current = total_loss((double)w, inputs, targets);
        Assert.is_true(current < previous);
        previous = current;
    }
    Assert.is_true(Math.abs((double)w - 2.0d) < 0.5d);
}

async fun backward_vector(device: GpuDevice, label: string): void {
    let n = 96;
    let points = Array.alloc<GpuVec2>(n);
    for (let i = 0; i < n; i = i + 1) {
        points[i] = GpuVec2.of(-1.5f + 0.03f * (float)i, 1.0f - 0.02f * (float)i);
    }
    let out = backward_ok(device.buffer_alloc<GpuVec2>(n), "radial out");
    backward_ok(
        GpuShaders.radial_gradient.dispatch(
            device,
            GpuDispatch.threads_1d(n),
            backward_ok(device.buffer_from(points), "points"),
            out,
            n
        ).await,
        "radial_gradient on " + label
    );
    let gradients = backward_ok(out.read().await, "read radial gradients");
    for (let i = 0; i < n; i = i + 1) {
        let x = (double)points[i].x;
        let y = (double)points[i].y;
        backward_close(
            gradients[i].x,
            backward_central((v: double) => Math.sin(v) * y * y, x),
            "d radial / dx on " + label
        );
        backward_close(
            gradients[i].y,
            backward_central((v: double) => Math.sin(x) * v * v, y),
            "d radial / dy on " + label
        );
    }
}

async fun backward_struct(device: GpuDevice, label: string): void {
    let n = 64;
    let samples = Array.alloc<GpuVec2>(n);
    for (let i = 0; i < n; i = i + 1) {
        let input = 0.1f * (float)i - 3.0f;
        samples[i] = GpuVec2.of(input, 1.5f * input + 0.25f);
    }
    let slope = 0.5f;
    let offset = -0.75f;
    let out = backward_ok(device.buffer_alloc<GpuVec2>(n), "line out");
    backward_ok(
        GpuShaders.line_gradient.dispatch(
            device,
            GpuDispatch.threads_1d(n),
            backward_ok(device.buffer_from(samples), "samples"),
            out,
            slope,
            offset,
            n
        ).await,
        "line_gradient on " + label
    );
    let gradients = backward_ok(out.read().await, "read line gradients");
    let s = (double)slope;
    let o = (double)offset;
    for (let i = 0; i < n; i = i + 1) {
        let x = (double)samples[i].x;
        let t = (double)samples[i].y;
        backward_close(
            gradients[i].x,
            backward_central((v: double) => (v * x + o - t) * (v * x + o - t), s),
            "d loss / d slope on " + label
        );
        backward_close(
            gradients[i].y,
            backward_central((v: double) => (s * x + v - t) * (s * x + v - t), o),
            "d loss / d offset on " + label
        );
    }
}

@test
@timeout(240000)
async fun gpu_autodiff_backward(): void {
    for (let backend in GpuShaders.backends()) {
        switch (backward_device(backend).await) {
            Some(device) => {
                let label = backward_label(backend);
                backward_train(device, label).await;
                backward_vector(device, label).await;
                backward_struct(device, label).await;
                System.println(label + " reverse-mode gradients match finite differences");
            }
            None => {}
        }
    }
}
