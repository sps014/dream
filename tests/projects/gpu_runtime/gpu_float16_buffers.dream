module gpu_float16_buffers;

import system.testing;
import system;
import system.gpu;

fun half_label(backend: GpuBackend): string {
    let names = ["Auto", "Dx12", "Dx11", "Vulkan", "Metal", "Cuda", "WebGpu"];
    let index: int = backend;
    return names[index];
}

// Opens `backend`, or prints why this machine cannot run it and returns None.
async fun half_device(backend: GpuBackend): Option<GpuDevice> {
    switch (GpuDevice.create(backend).await) {
        Ok(device) => {
            return Option.Some(device);
        }
        Err(GpuError.BackendUnavailable(reason)) => {
            System.println("SKIP gpu_float16_buffers on " + half_label(backend) + ": " + reason);
        }
        Err(GpuError.NoDevice(reason)) => {
            System.println("SKIP gpu_float16_buffers on " + half_label(backend) + ": " + reason);
        }
        Err(e) => {
            Assert.fail("gpu_float16_buffers on " + half_label(backend) + ": " + e.message());
        }
    }
    return Option.None;
}

fun half_ok<T>(result: Result<T, GpuError>, what: string): T {
    switch (result) {
        Ok(value) => {
            return value;
        }
        Err(e) => {
            Assert.fail(what + ": " + e.message());
            return result.unwrap();
        }
    }
}

// Half-precision `a * x + y`, its square root, and the result widened to `float`.
@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64)
fun half_axpy(
    @readonly x: GpuBuffer<float16>,
    @readonly y: GpuBuffer<float16>,
    out: GpuBuffer<float16>,
    roots: GpuBuffer<float16>,
    wide: GpuBuffer<float>,
    a: float16,
    n: int
): void {
    let i = global_id().x;
    if i >= n {
        return;
    }
    let r = a * x[i] + y[i];
    out[i] = r;
    roots[i] = GpuMath.sqrt(x[i]);
    let widened: float = r;
    wide[i] = widened * 0.5f;
}

@test
@timeout(180000)
async fun gpu_float16_buffers(): void {
    // An odd count makes the buffers' byte sizes not a multiple of 4.
    let n = 257;
    let xs = Array.alloc<float16>(n);
    let ys = Array.alloc<float16>(n);
    for (let i = 0; i < n; i = i + 1) {
        xs[i] = (float16)((float)(i % 64) * 0.125f);
        ys[i] = (float16)((float)(i % 5) * 0.5f - 1.0f);
    }
    for (let backend in GpuShaders.backends()) {
        switch (half_device(backend).await) {
            Some(device) => {
                let label = half_label(backend);
                // Buffers of float16 need no device feature; only shaders that use it do.
                let x = half_ok(device.buffer_from(xs), "x");
                let uploaded = half_ok(x.read().await, "read x on " + label);
                Assert.eq(uploaded.length, n);
                for (let i = 0; i < n; i = i + 1) {
                    Assert.eq(uploaded[i], xs[i]);
                }

                if !device.supports(GpuFeature.Float16) {
                    System.println("SKIP gpu_float16_buffers shaders on " + label + ": no Float16");
                    continue;
                }
                let y = half_ok(device.buffer_from(ys), "y");
                let out = half_ok(device.buffer_alloc<float16>(n), "out");
                let roots = half_ok(device.buffer_alloc<float16>(n), "roots");
                let wide = half_ok(device.buffer_alloc<float>(n), "wide");
                half_ok(
                    GpuShaders.half_axpy.dispatch(
                        device,
                        GpuDispatch.threads_1d(n),
                        x,
                        y,
                        out,
                        roots,
                        wide,
                        2.0h,
                        n
                    ).await,
                    "half_axpy on " + label
                );

                let results = half_ok(out.read().await, "read out on " + label);
                let square_roots = half_ok(roots.read().await, "read roots on " + label);
                let halves = half_ok(wide.read().await, "read wide on " + label);
                for (let i = 0; i < n; i = i + 1) {
                    // Every input is a multiple of 1/8 below 8, so the half results are exact.
                    let expected = 2.0h * xs[i] + ys[i];
                    Assert.eq(results[i], expected);
                    Assert.eq(halves[i], (float)expected * 0.5f);
                    let root = Math.sqrt((double)xs[i]);
                    Assert.approx((double)square_roots[i], root, 1e-3d * (1.0d).max(root));
                }
                System.println(label + " float16 buffers and half arithmetic match the CPU");
            }
            None => {}
        }
    }
}
