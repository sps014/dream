module gpu_pipeline_layouts;

import system.testing;
import system;
import system.gpu;

// Three shaders with 12 storage buffers together, more than any WebGPU device binds per stage.
// Each pipeline binds only its own shader's 4, so every one of them runs.

fun layouts_label(backend: GpuBackend): string {
    let names = ["Auto", "Dx12", "Dx11", "Vulkan", "Metal", "Cuda", "WebGpu"];
    let index: int = backend;
    return names[index];
}

async fun layouts_device(backend: GpuBackend): Option<GpuDevice> {
    switch (GpuDevice.create(backend).await) {
        Ok(device) => {
            return Option.Some(device);
        }
        Err(GpuError.BackendUnavailable(reason)) => {
            System.println(
                "SKIP gpu_pipeline_layouts on " + layouts_label(backend) + ": " + reason
            );
        }
        Err(GpuError.NoDevice(reason)) => {
            System.println(
                "SKIP gpu_pipeline_layouts on " + layouts_label(backend) + ": " + reason
            );
        }
        Err(e) => {
            Assert.fail("gpu_pipeline_layouts on " + layouts_label(backend) + ": " + e.message());
        }
    }
    return Option.None;
}

fun layouts_ok<T>(result: Result<T, GpuError>, what: string): T {
    switch (result) {
        Ok(value) => {
            return value;
        }
        Err(e) => {
            Assert.fail(what + ": " + e.message());
            return result.unwrap();
        }
    }
}

@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64)
fun add_three(
    @readonly a: GpuBuffer<float>,
    @readonly b: GpuBuffer<float>,
    @readonly c: GpuBuffer<float>,
    out: GpuBuffer<float>
): void {
    let i = global_id().x;
    out[i] = a[i] + b[i] + c[i];
}

@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64)
fun multiply_three(
    @readonly a: GpuBuffer<float>,
    @readonly b: GpuBuffer<float>,
    @readonly c: GpuBuffer<float>,
    out: GpuBuffer<float>
): void {
    let i = global_id().x;
    out[i] = a[i] * b[i] * c[i];
}

@gpu_targets(GpuTarget.Metal, GpuTarget.Vulkan, GpuTarget.WebGpu)
@compute(64)
fun largest_of_three(
    @readonly a: GpuBuffer<float>,
    @readonly b: GpuBuffer<float>,
    @readonly c: GpuBuffer<float>,
    out: GpuBuffer<float>
): void {
    let i = global_id().x;
    out[i] = GpuMath.max(a[i], GpuMath.max(b[i], c[i]));
}

@test
@timeout(180000)
async fun gpu_pipeline_layouts(): void {
    let n = 64;
    let xs = Array.alloc<float>(n);
    let ys = Array.alloc<float>(n);
    let zs = Array.alloc<float>(n);
    for (let i = 0; i < n; i = i + 1) {
        xs[i] = (float)i;
        ys[i] = 2.0f;
        zs[i] = (float)(n - i);
    }
    for (let backend in GpuShaders.backends()) {
        switch (layouts_device(backend).await) {
            Some(device) => {
                let label = layouts_label(backend);
                let a = layouts_ok(device.buffer_from(xs), "a");
                let b = layouts_ok(device.buffer_from(ys), "b");
                let c = layouts_ok(device.buffer_from(zs), "c");
                let sums = layouts_ok(device.buffer_alloc<float>(n), "sums");
                let products = layouts_ok(device.buffer_alloc<float>(n), "products");
                let largest = layouts_ok(device.buffer_alloc<float>(n), "largest");
                let threads = GpuDispatch.threads_1d(n);

                layouts_ok(
                    GpuShaders.add_three.dispatch(device, threads, a, b, c, sums).await,
                    "add_three on " + label
                );
                layouts_ok(
                    GpuShaders.multiply_three.dispatch(device, threads, a, b, c, products).await,
                    "multiply_three on " + label
                );
                layouts_ok(
                    GpuShaders.largest_of_three.dispatch(device, threads, a, b, c, largest).await,
                    "largest_of_three on " + label
                );

                let sum_values = layouts_ok(sums.read().await, "read sums on " + label);
                let product_values = layouts_ok(products.read().await, "read products on " + label);
                let largest_values = layouts_ok(largest.read().await, "read largest on " + label);
                for (let i = 0; i < n; i = i + 1) {
                    Assert.eq(sum_values[i], (float)i + 2.0f + (float)(n - i));
                    Assert.eq(product_values[i], (float)i * 2.0f * (float)(n - i));
                    let expected = (float)i;
                    if (float)(n - i) > expected {
                        expected = (float)(n - i);
                    }
                    if expected < 2.0f {
                        expected = 2.0f;
                    }
                    Assert.eq(largest_values[i], expected);
                }
                System.println(label + " runs three shaders binding 12 storage buffers together");
            }
            None => {}
        }
    }
}
