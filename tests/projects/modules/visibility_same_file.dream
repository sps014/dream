import system.testing;
// A non-public function and class may be freely used from anywhere in their OWN file.
import system;

fun c2a2_helper(x: int): int {
    return x * 2;
}

class c2a2_Widget {
    public n: int;

    public constructor(n: int) {
        this.n = n;
    }

    public fun value(): int {
        return this.n;
    }
}

@test
@timeout(180000)
fun visibility_same_file(): void {
    Assert.eq_str((c2a2_helper(21)).to_string(), "42");
    let w = c2a2_Widget(5);
    Assert.eq_str((w.value()).to_string(), "5");
}
