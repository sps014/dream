import system;
import system.io;
import system.testing;

async fun copy_one(path: string): Result<bool, IoError> {
    let file = FileHandle.open_async(path, "w+").await?;
    let bytes = Encoding.utf8_encode("hello 日本語");
    let count = file.write_async(bytes).await?;
    Assert.eq(count, bytes.length);
    file.seek_async(0L).await?;
    let read = file.read_async(4096).await?;
    Assert.eq_str(Encoding.utf8_decode(read), "hello 日本語");
    Assert.eq(file.read_async(1).await?.length, 0);
    file.flush_async().await?;
    file.close()?;
    Assert.is_true(file.read_async(1).await.is_err());
    return Result.Ok(true);
}

@test
async fun async_file_lifecycle(): void {
    let results = Promise.all(
        [
            copy_one("async_lifecycle_a.tmp"),
            copy_one("async_lifecycle_b.tmp"),
            copy_one("async_lifecycle_c.tmp")
        ]
    ).await;
    for (let i = 0; i < results.length; i = i + 1) {
        Assert.is_true(results[i].is_ok());
    }
    let cancellation = CancellationSource();
    cancellation.cancel();
    Assert.is_true(
        FileHandle.open_async("async_lifecycle_a.tmp", "r", Option.Some(cancellation.token))
            .await
            .is_err()
    );
    let file = FileHandle.open("async_lifecycle_a.tmp", "r").unwrap();
    Assert.is_true(file.read_async(1, Option.Some(cancellation.token)).await.is_err());
    Assert.eq(file.tell().unwrap(), 0L);
    file.close().unwrap();
    File.delete("async_lifecycle_a.tmp");
    File.delete("async_lifecycle_b.tmp");
    File.delete("async_lifecycle_c.tmp");
    async_file_copy_and_read_ahead().await;
}

async fun async_file_copy_and_read_ahead(): void {
    let source = FileHandle.open("async_copy_source.tmp", "w+").unwrap();
    source.write_all(Encoding.utf8_encode("first\r\nsecond\nlast")).unwrap();
    source.seek(0L).unwrap();
    Assert.eq_str(source.read_line().unwrap().unwrap(), "first");
    Assert.eq_str(Encoding.utf8_decode(source.read_async(6).await.unwrap()), "second");
    source.seek_async(0L).await.unwrap();
    let destination = FileHandle.open_async("async_copy_destination.tmp", "w+").await.unwrap();
    Assert.eq(Streams.copy_async(source, destination, 3).await.unwrap(), 18L);
    destination.seek_async(0L).await.unwrap();
    Assert.eq_str(
        Encoding.utf8_decode(destination.read_async(100).await.unwrap()),
        "first\r\nsecond\nlast"
    );
    source.close().unwrap();
    destination.close().unwrap();
    File.delete("async_copy_source.tmp");
    File.delete("async_copy_destination.tmp");
}
