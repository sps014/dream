import system.testing;
// Binary File.read_bytes / write_bytes on native (NUL-safe, no string round-trip).
import system;
import system.io;

async fun cce_body(): void {
    let path = "dream_file_bytes_e2e.bin";
    let data = Buffer.alloc<byte>(4);
    data[0] = (byte)1;
    data[1] = (byte)0;
    data[2] = (byte)255;
    data[3] = (byte)2;

    switch (File.write_bytes(path, data).await) {
        Ok(n) => cce_verify_observation((n).to_string()),
        Err(e) => cce_verify_observation((e.message()).to_string()),
    }

    switch (File.read_bytes(path).await) {
        Ok(got) => {
            cce_verify_observation((got.length).to_string());
            cce_verify_observation(((int)got[0]).to_string());
            cce_verify_observation(((int)got[1]).to_string());
            cce_verify_observation(((int)got[2]).to_string());
            cce_verify_observation(((int)got[3]).to_string());
        },
        Err(e) => cce_verify_observation((e.message()).to_string()),
    }

    File.delete(path).await;
}

let cce_cursor: int = 0;

fun cce_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "4\n4\n1\n0\n255\n2\n";
    let end = cce_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(cce_cursor, end));
    cce_cursor = end;
}

@test
@timeout(180000)

async fun file_bytes(): void {
    cce_cursor = 0;
    cce_body().await;
    Assert.eq(cce_cursor, ("4\n4\n1\n0\n255\n2\n").length);
}
