import system.testing;
import system;
import system.io;

async fun ccf_body(): void {
    let root = "dream_file_copy_rename_e2e";
    File.create_dir(root).await;
    File.write(root + "/src.txt", "abc").await;
    switch (File.copy(root + "/src.txt", root + "/dst.txt").await) {
        Ok(_) => ccf_verify_observation(((File.read(root + "/dst.txt").await).unwrap_or("")).to_string()),
        Err(e) => ccf_verify_observation((e.message()).to_string()),
    }
    switch (File.rename(root + "/dst.txt", root + "/renamed.txt").await) {
        Ok(_) => {
            ccf_verify_observation((File.exists(root + "/dst.txt")).to_string());
            ccf_verify_observation(((File.read(root + "/renamed.txt").await).unwrap_or("")).to_string());
        },
        Err(e) => ccf_verify_observation((e.message()).to_string()),
    }
    File.delete(root + "/src.txt").await;
    File.delete(root + "/renamed.txt").await;
    File.remove_dir(root).await;
}

let ccf_cursor: int = 0;

fun ccf_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "abc\nfalse\nabc\n";
    let end = ccf_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(ccf_cursor, end));
    ccf_cursor = end;
}

@test
@timeout(180000)

async fun file_copy_rename(): void {
    ccf_cursor = 0;
    ccf_body().await;
    Assert.eq(ccf_cursor, ("abc\nfalse\nabc\n").length);
}
