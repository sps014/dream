import system.testing;
import system;
import system.io;

async fun cd3_body(): void {
    let root = "dream_file_remove_dir_e2e";
    File.create_dir_all(root + "/nested/leaf").await;
    File.write(root + "/nested/leaf/x.txt", "x").await;
    switch (File.remove_dir(root + "/nested/leaf").await) {
        Ok(_) => cd3_verify_observation(("removed nonempty").to_string()),
        Err(_) => cd3_verify_observation(("nonempty kept").to_string()),
    }
    switch (File.remove_dir_all(root).await) {
        Ok(_) => cd3_verify_observation((File.exists(root)).to_string()),
        Err(e) => cd3_verify_observation((e.message()).to_string()),
    }
}

let cd3_cursor: int = 0;

fun cd3_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "nonempty kept\nfalse\n";
    let end = cd3_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(cd3_cursor, end));
    cd3_cursor = end;
}

@test
@timeout(180000)

async fun file_remove_dir(): void {
    cd3_cursor = 0;
    cd3_body().await;
    Assert.eq(cd3_cursor, ("nonempty kept\nfalse\n").length);
}
