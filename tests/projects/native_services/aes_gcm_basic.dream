import system.testing;
import system;
import system.crypto;
import system.encoding;

fun c3_body(): void {
    let key = AesGcmKey.generate().unwrap();
    c3_verify_observation((key.to_bytes().length).to_string());

    let nonce = AesGcm.generate_nonce().unwrap();
    c3_verify_observation((nonce.length).to_string());

    let aad = Encoding.utf8_encode("header");
    let plaintext = Encoding.utf8_encode("attack at dawn");

    let ciphertext = AesGcm.encrypt(key, nonce, plaintext, aad).unwrap_or(Buffer.alloc<byte>(0));
    c3_verify_observation((ciphertext.length).to_string());

    switch (AesGcm.decrypt(key, nonce, ciphertext, aad)) {
        Ok(recovered) => c3_verify_observation((Encoding.utf8_decode(recovered)).to_string()),
        Err(e) => c3_verify_observation(("unexpected error: " + e.message()).to_string()),
    }

    // Wrong AAD must fail authentication.
    let wrong_aad = Encoding.utf8_encode("wrong");
    switch (AesGcm.decrypt(key, nonce, ciphertext, wrong_aad)) {
        Ok(recovered) => c3_verify_observation(("should not decrypt: " + Encoding.utf8_decode(recovered)).to_string()),
        Err(e) => c3_verify_observation(("auth failed as expected: " + e.code()).to_string()),
    }

    // Wrong key must fail authentication.
    let other_key = AesGcmKey.generate().unwrap();
    switch (AesGcm.decrypt(other_key, nonce, ciphertext, aad)) {
        Ok(recovered) => c3_verify_observation(("should not decrypt: " + Encoding.utf8_decode(recovered)).to_string()),
        Err(e) => c3_verify_observation(("auth failed as expected: " + e.code()).to_string()),
    }

    // Bad key length is rejected before touching the host.
    switch (AesGcmKey.from_bytes(Buffer.alloc<byte>(10))) {
        Ok(k) => c3_verify_observation(("should not construct").to_string()),
        Err(e) => c3_verify_observation(("invalid key rejected: " + e.code()).to_string()),
    }

    // Bad nonce length is rejected before touching the host.
    switch (AesGcm.encrypt(key, Buffer.alloc<byte>(4), plaintext, aad)) {
        Ok(c) => c3_verify_observation(("should not encrypt").to_string()),
        Err(e) => c3_verify_observation(("invalid nonce rejected: " + e.code()).to_string()),
    }
}

let c3_cursor: int = 0;

fun c3_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "32\n12\n30\nattack at dawn\nauth failed as expected: EDECRYPT\nauth failed as expected: EDECRYPT\ninvalid key rejected: EINVAL_KEY\ninvalid nonce rejected: EINVAL_NONCE\n";
    let end = c3_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c3_cursor, end));
    c3_cursor = end;
}

@test
@timeout(180000)

fun aes_gcm_basic(): void {
    c3_cursor = 0;
    c3_body();
    Assert.eq(c3_cursor, ("32\n12\n30\nattack at dawn\nauth failed as expected: EDECRYPT\nauth failed as expected: EDECRYPT\ninvalid key rejected: EINVAL_KEY\ninvalid nonce rejected: EINVAL_NONCE\n").length);
}
