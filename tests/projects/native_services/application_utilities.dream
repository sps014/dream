import system;
import system.io;
import system.crypto;
import system.testing;

class FixtureCounter {
    public count: int;

    public constructor() {
        this.count = 0;
    }
}

@test
async fun application_utilities(): void {
    Assert.is_true(SecureRandom.bytes(0 - 1).is_err());

    let temporary = TempFile.create_in(".").unwrap();
    let temporary_path = temporary.path;
    Assert.is_true(temporary.persist_replace("missing-phase7-parent/file").is_err());
    Assert.is_true(File.exists(temporary_path));
    temporary.close().unwrap();
    temporary.close().unwrap();
    Assert.is_false(File.exists(temporary_path));

    let directory = TempDirectory.create_in(".").unwrap();
    let destination = directory.path + "/settings.json";
    let replacement = TempFile.create_in(directory.path).unwrap();
    replacement.file.write_all(("new contents").to_utf8()).unwrap();
    replacement.persist_replace(destination).unwrap();
    let existing = FileHandle.open(destination, FileMode.Read).unwrap();
    Assert.eq(string.from_utf8(existing.read(100).unwrap()), "new contents");
    existing.close().unwrap();
    directory.close().unwrap();

    let counter = FixtureCounter();
    let fixture = TestFixture<FixtureCounter, string>(
        counter,
        (resource) => {
            resource.count = resource.count + 1;
            return Result.Ok(Unit());
        }
    );
    let failed = Fixtures.run<FixtureCounter, string>(
        fixture,
        async (resource) => Result.Err("failure")
    ).await;
    Assert.is_true(failed.is_err());
    fixture.close().unwrap();
    Assert.eq(counter.count, 1);
    await_value_for_assertion().await;
}

async fun utility_value(): int {
    return 42;
}

async fun await_value_for_assertion(): void {
    Assert.eq_async(utility_value(), 42).await;
}

@test
@timeout(180000)
async fun cancellation_stdlib(): void {
    let src = CancellationSource();
    src.cancel();
    let tok = src.token;
    let opt = Option.Some(tok);

    switch (File.read("missing.txt", opt).await) {
        Ok(t) => Assert.fail("cancelled read returned: " + t),
        Err(e) => Assert.eq(e.code(), "ECANCELLED"),
    }
}
