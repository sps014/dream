import system;
import system.io;
import system.compress;
import system.testing;

@test
fun compression_streams(): void {
    let input = Array.alloc<byte>(100000);
    for (let i = 0; i < input.length; i = i + 1) {
        input[i] = (byte)(i % 251);
    }
    for (let format in [CompressionFormat.Gzip, CompressionFormat.Zlib]) {
        let encoded = MemoryStream();
        let writer = Compression.writer(encoded, format).unwrap();
        writer.write_all(input).unwrap();
        writer.flush().unwrap();
        writer.finish().unwrap();
        Assert.is_true(writer.write(input).is_err());
        encoded.seek(0L).unwrap();
        let reader = Compression.reader(encoded, format).unwrap();
        Assert.eq(reader.read(0).unwrap().length, 0);
        let decoded = MemoryStream();
        Assert.eq(Streams.copy(reader, decoded).unwrap(), 100000L);
        decoded.seek(0L).unwrap();
        let actual = decoded.read_exact(input.length).unwrap();
        for (let i = 0; i < input.length; i = i + 1) {
            Assert.eq(actual[i], input[i]);
        }
        reader.close();
        Assert.is_true(reader.read(1).is_err());

        encoded.seek(0L).unwrap();
        let limited = Compression.reader(encoded, format, max_output_bytes: 100L).unwrap();
        Assert.is_true(Streams.copy(limited, MemoryStream()).is_err());
        limited.close();

        encoded.seek(0L).unwrap();
        let compressed = encoded.read(100000).unwrap();
        let truncated = Compression.reader(
            MemoryStream(Span<byte>(compressed, 0, compressed.length - 1).to_array()),
            format
        ).unwrap();
        Assert.is_true(Streams.copy(truncated, MemoryStream()).is_err());
        truncated.close();
        let trailing = MemoryStream(compressed);
        trailing.seek((long)compressed.length).unwrap();
        trailing.write_all([(byte)99]).unwrap();
        trailing.seek(0L).unwrap();
        let extra = Compression.reader(trailing, format).unwrap();
        Assert.is_true(Streams.copy(extra, MemoryStream()).is_err());
        extra.close();
    }
    // FHCRC is the CRC-16 of the gzip header. A stored block of one byte follows.
    let checked = [
        (byte)0x1F, (byte)0x8B, (byte)0x08, (byte)0x02, (byte)0x00, (byte)0x00, (byte)0x00,
        (byte)0x00, (byte)0x00, (byte)0xFF, (byte)0x90, (byte)0xC9, (byte)0x01, (byte)0x01,
        (byte)0x00, (byte)0xFE, (byte)0xFF, (byte)0x66, (byte)0xE0, (byte)0x2B, (byte)0xD3,
        (byte)0x76, (byte)0x01, (byte)0x00, (byte)0x00, (byte)0x00
    ];
    let reader = Compression.reader(MemoryStream(checked), CompressionFormat.Gzip).unwrap();
    let decoded = reader.read(8).unwrap();
    Assert.eq(decoded.length, 1);
    Assert.eq(decoded[0], (byte)0x66);
    reader.close();
    checked[10] = (byte)0x6F;
    checked[11] = (byte)0x36;
    let corrupt = Compression.reader(MemoryStream(checked), CompressionFormat.Gzip).unwrap();
    Assert.eq(corrupt.read(8).unwrap_err().message(), "invalid gzip header checksum");
    corrupt.close();
}
