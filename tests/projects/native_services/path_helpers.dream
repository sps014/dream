import system.testing;
import system;
import system.io;

@test
@timeout(180000)
fun path_helpers(): void {
    Assert.eq(Path.stem("a.tar.gz"), "a.tar");
    Assert.eq(Path.with_extension("a/b.txt", "md"), "a/b.md");
    Assert.eq(Path.with_file_name("a/b.txt", "c.txt"), "a/c.txt");
    Assert.is_false(Path.is_absolute("foo"));
    Assert.is_true(Path.has_extension("a.txt", "txt"));
    Assert.eq(Path.components("a/b\\c").join(","), "a,b,c");
    Assert.eq(Path.relative_to("a/b/c", "a/b").unwrap_or("none"), "c");
    Assert.is_true(Path.absolute("/x").starts_with("/"));
    Assert.eq(Path.file_name("/tmp/x.txt").unwrap_or(""), "x.txt");
    Assert.eq(Path.extension("/tmp/x.txt").unwrap_or(""), "txt");
}

// `Path.join` takes two or more segments (trailing arguments pack into the variadic slot);
// empty segments are skipped and existing separators are not doubled.
@test
@timeout(180000)
fun path_join(): void {
    Assert.eq(Path.join("a", "b"), "a/b");
    Assert.eq(Path.join("a/", "b"), "a/b");
    Assert.eq(Path.join("usr", "local", "bin"), "usr/local/bin");
    Assert.eq(Path.join("a", "b", "c", "d"), "a/b/c/d");
    Assert.eq(Path.join("root/", "sub", "file.txt"), "root/sub/file.txt");
    Assert.eq(Path.join("", "only"), "only");
    Assert.eq(Path.join("x", "", "y"), "x/y");
}
