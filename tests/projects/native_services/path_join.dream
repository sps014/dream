import system.testing;
import system;
import system.io;

@test
@timeout(180000)
fun path_join(): void {
    Assert.eq((Path.join("a", "b")).to_string(), "a/b");
    Assert.eq((Path.join("a/", "b")).to_string(), "a/b");
    Assert.eq((Path.join("usr", "local", "bin")).to_string(), "usr/local/bin");
    Assert.eq((Path.file_name("/tmp/x.txt").unwrap_or("")).to_string(), "x.txt");
    Assert.eq((Path.extension("/tmp/x.txt").unwrap_or("")).to_string(), "txt");
}
