import system.testing;
// `Path.join` takes two or more segments (trailing arguments pack into the variadic slot);
// empty segments are skipped and existing separators are not doubled.

import system;
import system.io;

@test
@timeout(180000)
fun path_join_variadic(): void {
    Assert.eq_str((Path.join("a", "b")).to_string(), "a/b");
    Assert.eq_str((Path.join("a", "b", "c", "d")).to_string(), "a/b/c/d");
    Assert.eq_str((Path.join("root/", "sub", "file.txt")).to_string(), "root/sub/file.txt");
    Assert.eq_str((Path.join("", "only")).to_string(), "only");
    Assert.eq_str((Path.of(["x", "", "y"])).to_string(), "x/y");
}
