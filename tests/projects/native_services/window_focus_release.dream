import system.testing;
import system;
import system.window;

@test
@timeout(180000)
fun window_focus_release(): void {
    let window = Window.headless(WindowDesc.of("focus", 320, 200));
    window.simulate(WindowEvent.KeyDown(KeyEvent(KeyCode.ShiftLeft, "", KeyModifiers.None, false)));
    window.simulate(WindowEvent.MouseDown(MouseButton.Right));
    window.poll();
    window.simulate(WindowEvent.Unfocused);
    let frame = window.poll();
    Assert.is_false(window.is_focused);
    Assert.is_false(frame.keyboard.is_down(KeyCode.ShiftLeft));
    Assert.is_true(frame.keyboard.released(KeyCode.ShiftLeft));
    Assert.is_true(frame.mouse.released(MouseButton.Right));
    window.simulate(WindowEvent.Focused);
    window.poll();
    Assert.is_true(window.is_focused);
}
