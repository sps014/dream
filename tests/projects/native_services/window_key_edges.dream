import system.testing;
import system;
import system.window;

@test
@timeout(180000)
fun window_key_edges(): void {
    let window = Window.headless(WindowDesc.of("keys", 320, 200));
    window.simulate(WindowEvent.KeyDown(KeyEvent(KeyCode.A, "", KeyModifiers.None, false)));
    let first = window.poll();
    Assert.is_true(first.keyboard.is_down(KeyCode.A));
    Assert.is_true(first.keyboard.pressed(KeyCode.A));
    Assert.is_false(first.keyboard.released(KeyCode.A));
    Assert.is_false(first.keyboard.is_down(KeyCode.D));

    window.simulate(WindowEvent.KeyDown(KeyEvent(KeyCode.A, "", KeyModifiers.None, true)));
    let held = window.poll();
    Assert.is_true(held.keyboard.is_down(KeyCode.A));
    Assert.is_false(held.keyboard.pressed(KeyCode.A));
    Assert.eq(held.events.length, 1);

    window.simulate(WindowEvent.KeyUp(KeyEvent(KeyCode.A, "", KeyModifiers.None, false)));
    let up = window.poll();
    Assert.is_false(up.keyboard.is_down(KeyCode.A));
    Assert.is_true(up.keyboard.released(KeyCode.A));

    let idle = window.poll();
    Assert.is_false(idle.keyboard.released(KeyCode.A));
    Assert.eq(idle.events.length, 0);
    Assert.is_true(first.keyboard.pressed(KeyCode.A));

    // A tap between two polls reports both edges; a repeat never counts as a press.
    let tapped = Window.headless(WindowDesc.of("tap", 320, 200));
    tapped.simulate(WindowEvent.KeyDown(KeyEvent(KeyCode.Space, "", KeyModifiers.None, false)));
    tapped.simulate(WindowEvent.KeyUp(KeyEvent(KeyCode.Space, "", KeyModifiers.None, false)));
    let tap = tapped.poll();
    Assert.is_true(tap.keyboard.pressed(KeyCode.Space));
    Assert.is_true(tap.keyboard.released(KeyCode.Space));
    Assert.is_false(tap.keyboard.is_down(KeyCode.Space));

    tapped.simulate(WindowEvent.KeyDown(KeyEvent(KeyCode.W, "", KeyModifiers.None, true)));
    Assert.is_false(tapped.poll().keyboard.is_down(KeyCode.W));
}
