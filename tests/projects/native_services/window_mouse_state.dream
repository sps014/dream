import system.testing;
import system;
import system.window;

@test
@timeout(180000)
fun window_mouse_state(): void {
    let window = Window.headless(WindowDesc("mouse", 320, 200));
    window.simulate(WindowEvent.MouseMove(WindowVector(100.0f, 50.0f)));
    window.simulate(WindowEvent.MouseDown(MouseButton.Left));
    window.simulate(WindowEvent.Scroll(WindowVector(0.0f, 1.0f)));
    window.simulate(WindowEvent.Scroll(WindowVector(0.5f, 2.0f)));
    let first = window.poll();
    Assert.eq(first.mouse.position.x, 100.0f);
    Assert.eq(first.mouse.delta.x, 0.0f);
    Assert.eq(first.mouse.scroll.y, 3.0f);
    Assert.eq(first.mouse.scroll.x, 0.5f);
    Assert.is_true(first.mouse.pressed(MouseButton.Left));
    Assert.is_false(first.mouse.is_down(MouseButton.Right));

    window.simulate(WindowEvent.MouseMove(WindowVector(110.0f, 45.0f)));
    window.simulate(WindowEvent.MouseMove(WindowVector(130.0f, 40.0f)));
    window.simulate(WindowEvent.MouseUp(MouseButton.Left));
    let second = window.poll();
    Assert.eq(second.mouse.delta.x, 30.0f);
    Assert.eq(second.mouse.delta.y, -10.0f);
    Assert.eq(second.mouse.position.y, 40.0f);
    Assert.eq(second.mouse.scroll.y, 0.0f);
    Assert.is_false(second.mouse.pressed(MouseButton.Left));
    Assert.is_true(second.mouse.released(MouseButton.Left));
    Assert.eq(window.poll().mouse.delta.x, 0.0f);
}
