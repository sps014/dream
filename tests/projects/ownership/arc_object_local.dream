import system.testing;
import system;

class c18_Value {
    public n: int;
    public constructor(n: int) {
        this.n = n;
    }
}

@test
@timeout(180000)
fun arc_object_local() {
    let erased: object = c18_Value(5);
    let value = (c18_Value)erased;
    Assert.eq_str((value.n).to_string(), "5");
}
