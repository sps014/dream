import system;
import system.testing;

let proof_drop_count = 0;

class ProofDropLeaf {
    public value: int;

    public constructor() {
        this.value = 7;
    }

    del() {
        proof_drop_count = proof_drop_count + 1;
    }
}

class ProofDropOwner {
    public leaf: ProofDropLeaf;

    public constructor(leaf: ProofDropLeaf) {
        this.leaf = leaf;
    }
}

@noinline
fun proof_read_drop(borrow leaf: ProofDropLeaf): int {
    return leaf.value;
}

@noinline
fun proof_drop_timing(borrow owner: ProofDropOwner): int {
    let snapshot = owner.leaf;
    let value = proof_read_drop(snapshot);
    owner.leaf = ProofDropLeaf();
    return proof_drop_count + value - 7;
}

@test
fun arc_proofs_preserve_snapshot_destruction_time(): void {
    let owner = ProofDropOwner(ProofDropLeaf());
    let before = proof_drop_count;
    let observed = proof_drop_timing(owner);
    Assert.eq(observed, before);
    Assert.eq(proof_drop_count, before + 1);
}

class ProofLeaf {
    public text: string;

    public constructor(text: string) {
        this.text = text;
    }
}

class ProofOwner {
    public leaf: ProofLeaf;

    public constructor(leaf: ProofLeaf) {
        this.leaf = leaf;
    }
}

@noinline
fun proof_replace(borrow leaf: ProofLeaf): void {
    leaf.text = "replacement";
}

@noinline
fun proof_relay(borrow leaf: ProofLeaf): void {
    proof_replace(leaf);
}

@noinline
fun proof_disjoint_owner(borrow leaf: ProofLeaf): int {
    let snapshot = leaf.text;
    let other = ProofLeaf("other");
    proof_relay(other);
    return snapshot.length + other.text.length;
}

@noinline
fun proof_shared_child(borrow left: ProofOwner, borrow right: ProofOwner): string {
    let snapshot = left.leaf.text;
    proof_relay(right.leaf);
    return snapshot;
}

@test
fun arc_proofs_keep_aliasing_children_alive(): void {
    let leaf = ProofLeaf("original" + 1);
    Assert.eq(proof_disjoint_owner(leaf), 20);
    let left = ProofOwner(leaf);
    let right = ProofOwner(leaf);
    Assert.eq(proof_shared_child(left, right), "original1");
    Assert.eq(leaf.text, "replacement");
}

@test
fun arc_proofs_distinguish_array_slots(): void {
    let values = ["first" + 1, "second" + 2];
    let first = values[0];
    values[1] = "different";
    Assert.eq(first, "first1");
    let second = values[1];
    values[1] = "overwritten";
    Assert.eq(second, "different");
    Assert.eq(values[1], "overwritten");
}

@noinline
fun proof_replace_slot_one(borrow values: string[]): void {
    values[1] = "replacement";
}

@noinline
fun proof_forward_slot_one(borrow values: string[]): void {
    proof_replace_slot_one(values);
}

@noinline
fun proof_read_across_slot_call(borrow values: string[]): int {
    let first = values[0];
    proof_forward_slot_one(values);
    return first.length;
}

@noinline
fun proof_replace_slot_zero(borrow values: string[]): void {
    values[0] = "replacement";
}

@noinline
fun proof_read_across_alias_call(borrow values: string[]): int {
    let first = values[0];
    proof_replace_slot_zero(values);
    return first.length;
}

@test
fun arc_proofs_substitute_array_writes_through_helpers(): void {
    let values = ["first" + 1, "second" + 2];
    Assert.eq(proof_read_across_slot_call(values), 6);
    Assert.eq(values[1], "replacement");
    Assert.eq(proof_read_across_alias_call(values), 6);
    Assert.eq(values[0], "replacement");
}

class ProofArrayOwner {
    public values: int[];

    public constructor(values: int[]) {
        this.values = values;
    }
}

struct ProofTextRecord {
    public text: string;

    public constructor(text: string) {
        this.text = text;
    }
}

struct ProofTextEnvelope {
    public record: ProofTextRecord;

    public constructor(record: ProofTextRecord) {
        this.record = record;
    }
}

@noinline
fun proof_read_envelope(borrow envelope: ProofTextEnvelope): int {
    return envelope.record.text.length;
}

@test
fun arc_proofs_keep_nested_views_alive_across_owner_link_replacement(): void {
    let owner = ProofArrayOwner([10, 20]);
    let view = ReadOnlySpan<int>.of(owner.values);
    let other = ProofLeaf("scratch" + 1);
    let envelope = ProofTextEnvelope(ProofTextRecord(other.text));
    proof_replace(other);
    Assert.eq(proof_read_envelope(envelope), 8);
    Assert.eq(view[0], 10);
    owner.values = [30, 40];
    Assert.eq(proof_read_envelope(envelope), 8);
    Assert.eq(view[0], 10);
    Assert.eq(owner.values[0], 30);
}

@noinline
fun proof_callback_recursive(borrow callback: fun(int): int, depth: int, value: int): int {
    if depth > 0 {
        return proof_callback_recursive(callback, depth - 1, value);
    }
    return callback(value);
}

@noinline
fun proof_callback_forward(borrow callback: fun(int): int, value: int): int {
    return proof_callback_recursive(callback, 3, value);
}

@noinline
fun proof_callback_read(value: string, borrow callback: fun(int): int): int {
    return proof_callback_forward(callback, value.length);
}

@test
fun arc_proofs_keep_forwarded_callback_environments_alive(): void {
    let captured = [7];
    let callback: fun(int): int = (value: int) => value + captured[0];
    captured[0] = 9;
    Assert.eq(proof_callback_read("value" + 1, callback), 15);
    captured[0] = 11;
    Assert.eq(proof_callback_read("ab", callback), 13);
    Assert.eq(captured[0], 11);
}

@noinline
fun proof_make_owned_text(value: int): string {
    return "value:" + value.to_string();
}

@test
fun arc_proofs_preserve_owner_after_an_inlined_consumer(): void {
    let i = 0;
    while i < 3 {
        let text = proof_make_owned_text(i);
        Assert.eq(text.to_string(), "value:" + i.to_string());
        Assert.eq(text.substring(0, text.length), "value:" + i.to_string());
        i = i + 1;
    }
}
