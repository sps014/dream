import system.testing;
import system;

class c1d_Node {
    public val: int;

    public constructor(val: int) {
        this.val = val;
    }
}

fun c1d_create_node(v: int): c1d_Node {
    let n = c1d_Node(v);
    return n;
}

@test
@timeout(180000)
fun arc_return(): void {
    let n1 = c1d_create_node(10);
    Assert.eq_str((n1.val).to_string(), "10");
}
