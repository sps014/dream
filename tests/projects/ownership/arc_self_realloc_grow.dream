import system.testing;
// Regression for ARC handling of `f = Buffer.realloc(f, ..)` self-grow: a field snapshot
// retained across the grow must be released before the backing block is consumed.
import system;

class c1f_Bucket {
    public names: List<string>;
    public constructor() {
        this.names = List<string>();
    }
}

fun c1f_body(): void {
    let b = c1f_Bucket();
    let i = 0;
    while i < 64 {
        b.names.push("item" + i.to_string());
        i = i + 1;
    }
    c1f_verify_observation((b.names.length).to_string());
    c1f_verify_observation((b.names.get(0)).to_string());
    c1f_verify_observation((b.names.get(63)).to_string());
}

let c1f_cursor: int = 0;

fun c1f_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "64\nitem0\nitem63\n";
    let end = c1f_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1f_cursor, end));
    c1f_cursor = end;
}

@test
@timeout(180000)

fun arc_self_realloc_grow(): void {
    c1f_cursor = 0;
    c1f_body();
    Assert.eq(c1f_cursor, ("64\nitem0\nitem63\n").length);
}
