import system.testing;
// Reading a container slot into a local, then overwriting the same slot must keep both
// references alive (regression: cursor aliasing freed the object at the slot store).
import system;

class c20_Job {
    public name: string;

    public constructor(name: string) {
        this.name = name;
    }
}

class c20_SlotBox {
    public head: Option<c20_Job>;

    public constructor() {
        this.head = Option.None;
    }
}

@test
@timeout(180000)
fun arc_slot_overwrite_snapshot(): void {
    let q = c20_SlotBox();
    q.head = Option.Some(c20_Job("j"));
    let taken = q.head;
    q.head = Option.None;
    Assert.eq_str((taken.unwrap().name).to_string(), "j");
}
