import system.testing;
import system;

@allow_cycle
class c25_ForestNode {
    public left: Option<c25_ForestNode>;
    public right: Option<c25_ForestNode>;
    public weak parent: Option<c25_ForestNode>;
    public constructor() {
        this.left = Option.None;
        this.right = Option.None;
        this.parent = Option.None;
    }
}

fun c25_forest(depth: int): c25_ForestNode {
    let node = c25_ForestNode();
    if depth > 1 {
        let left = c25_forest(depth - 1);
        left.parent = Option.Some(node);
        let right = c25_forest(depth - 1);
        right.parent = Option.Some(node);
        node.left = Option.Some(left);
        node.right = Option.Some(right);
    }
    return node;
}

fun c25_body(): void {
    let root: Option<c25_ForestNode> = Option.Some(c25_forest(5));
    let kept: Option<c25_ForestNode> = Option.None;
    switch (root) {
        Some(node) => {
            kept = node.left;
        }
        None => {}
    }
    switch (kept) {
        Some(child) => {
            c25_verify_observation((child.parent.is_some()).to_string());
        }
        None => {}
    }
    root = Option.None;
    switch (kept) {
        Some(child) => {
            c25_verify_observation((child.parent.is_none()).to_string());
        }
        None => {}
    }
    c25_verify_observation(("forest reclaimed").to_string());
}

let c25_cursor: int = 0;

fun c25_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "true\ntrue\nforest reclaimed\n";
    let end = c25_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c25_cursor, end));
    c25_cursor = end;
}

@test
@timeout(180000)

fun arc_weak_forest(): void {
    c25_cursor = 0;
    c25_body();
    Assert.eq(c25_cursor, ("true\ntrue\nforest reclaimed\n").length);
}
