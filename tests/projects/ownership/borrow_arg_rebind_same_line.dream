import system.testing;
// An owned local whose last use is a borrowed call argument is released once the call returns,
// unless the same source line rebinds it: the release point is the end of the line, which
// would then drop the new value.
import system;

fun c52_cut(borrow s: string, n: int): string {
    return s.substring(0, n);
}

fun c52_wrap(borrow s: string): string {
    return "[" + s + "]";
}

fun c52_body() {
    let s = "abcdef" + "ghij";
    let i = 0;
    while i < 3 {
        s = c52_wrap(c52_cut(s, s.length - 1));
        i = i + 1;
    }
    c52_verify_observation((s).to_string());
    let rest = "  key = \"value\"  ";
    let key = rest.substring(0, 6).trim();
    rest = rest.substring(7, rest.length).trim();
    c52_verify_observation((key).to_string());
    c52_verify_observation((rest).to_string());
    c52_verify_observation((rest.starts_with("\"")).to_string());
}

let c52_cursor: int = 0;

fun c52_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "[[[abcdefghi]\nkey\n\"value\"\ntrue\n";
    let end = c52_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c52_cursor, end));
    c52_cursor = end;
}

@test
@timeout(180000)

fun borrow_arg_rebind_same_line(): void {
    c52_cursor = 0;
    c52_body();
    Assert.eq(c52_cursor, ("[[[abcdefghi]\nkey\n\"value\"\ntrue\n").length);
}
