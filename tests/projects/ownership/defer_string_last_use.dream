import system.testing;
// Compiler-emitted string last-ref inside `defer` must not crash (native may delay the free).
import system;

@test
@timeout(180000)
fun defer_string_last_use() {
    defer {
        let s = "ab" + "cd";
        Assert.eq((s).to_string(), "abcd");
        Assert.eq(("ok").to_string(), "ok");
    }
}
