import system.cli;
import system.testing;

@test
fun cli_arguments(): void {
    let command = Command("download")
        .version("1.0.0")
        .description("Download a file")
        .positional("url", required: true)
        .string_option("output", short: "o", default_value: "download.bin")
        .int_option("timeout", default_value: 10000)
        .flag("verbose", short: "v");
    let parsed = command.parse(
        ["-vv", "--timeout", "-42", "-o", "first", "--output=日本語", "--", "-url"]
    ).unwrap();
    Assert.eq(parsed.get_string("url").unwrap(), "-url");
    Assert.eq(parsed.get_string("output").unwrap(), "日本語");
    Assert.eq(parsed.get_strings("output").unwrap().length, 2);
    Assert.eq(parsed.get_int("timeout").unwrap(), -42);
    Assert.is_true(parsed.get_bool("verbose").unwrap());
    Assert.is_true(parsed.is_present("output"));
    Assert.is_true(parsed.get_string("timeout").is_err());
    Assert.is_true(parsed.get_int("missing").is_err());
    Assert.is_true(command.parse([]).is_err());
    Assert.is_true(command.parse(["url", "--timeout", "overflow"]).is_err());
    Assert.is_true(command.parse(["url", "--timeout", "2147483648"]).is_err());
    let defaults = command.parse(["url"]).unwrap();
    Assert.eq(defaults.get_string("output").unwrap(), "download.bin");
    Assert.eq(defaults.get_int("timeout").unwrap(), 10000);
    Assert.is_true(!defaults.get_bool("verbose").unwrap());
    Assert.is_true(!defaults.is_present("output"));
    let repeated = command.parse(["url", "--timeout=1", "--timeout=2"])
        .unwrap()
        .get_ints("timeout")
        .unwrap();
    Assert.eq(repeated.length, 2);
    Assert.eq(repeated[0], 1);
    Assert.eq(repeated[1], 2);
    Assert.eq(
        command.parse(["url", "--timeout=-2147483648"]).unwrap().get_int("timeout").unwrap(),
        (-2147483647 - 1)
    );
    let help = command.parse(["--help"]).unwrap();
    Assert.is_true(help.is_help);
    Assert.is_true(help.help_text.contains("Download a file"));
    Assert.eq(command.parse(["--help"]).unwrap().help_text, help.help_text);
    let version = command.parse(["--version"]).unwrap();
    Assert.is_true(version.is_version);
    Assert.eq(version.version_text, "download 1.0.0\n");
    let child = Command("check")
        .string_option("mode", default_value: "fast")
        .choices("mode", ["fast", "slow"]);
    let root = Command("tool").subcommand(child).require_subcommand();
    let selected = root.parse(["check", "--mode", "slow"]).unwrap().subcommand.unwrap();
    Assert.eq(selected.command_name, "check");
    Assert.eq(selected.get_string("mode").unwrap(), "slow");
    Assert.is_true(root.parse(["check", "--mode", "bad"]).is_err());
    Assert.is_true(root.parse([]).is_err());
    Assert.is_true(Command("bad").flag("help").parse([]).is_err());
    Assert.is_true(
        Command("bad").flag("one", short: "x").flag("two", short: "x").parse([]).is_err()
    );
    Assert.is_true(Command("invalid name").parse([]).is_err());
    let raw = Command("raw")
        .positional("values", multiple: true)
        .parse(["--", "", "two words", "first\nsecond", "こんにちは"])
        .unwrap();
    let values = raw.get_strings("values").unwrap();
    Assert.eq(values.length, 4);
    Assert.eq(values[0], "");
    Assert.eq(values[2], "first\nsecond");
    Assert.eq(values[3], "こんにちは");
}


fun probe(): Command {
    return Command("probe")
        .description("Read a value")
        .version("1.2.3")
        .string_option("name", short: "n", default_value: "world")
        .int_option("count", default_value: 7)
        .flag("verbose", short: "v")
        .positional("files", multiple: true);
}

@test
fun cli_help_layout(): void {
    let expected = "Read a value\n\nUsage: probe [OPTIONS] [files]...\n\nArguments:\n  [files]...  \n\n"
        + "Options:\n  -n, --name <name>    [default: world]\n      --count <count>  [default: 7]\n"
        + "  -v, --verbose        \n  -h, --help           Print help\n  -V, --version        Print version\n";
    Assert.eq(probe().parse(["--help"]).unwrap().help_text, expected);
    Assert.eq(probe().parse(["-h"]).unwrap().help_text, expected);
    Assert.eq(probe().parse(["--version"]).unwrap().version_text, "probe 1.2.3\n");
    let tool = Command("tool")
        .version("2.0")
        .flag("verbose")
        .subcommand(
            Command("check")
                .description("Check the input")
                .string_option("mode", default_value: "fast")
                .choices("mode", ["fast", "slow"])
        )
        .require_subcommand();
    Assert.eq(tool.parse(["check", "--version"]).unwrap().version_text, "tool-check 2.0\n");
    Assert.eq(
        tool.parse(["--help"]).unwrap().help_text,
        "Usage: tool [OPTIONS] <COMMAND>\n\nCommands:\n  check  Check the input\n\n"
            + "Options:\n      --verbose  \n  -h, --help     Print help\n  -V, --version  Print version\n"
    );
    Assert.eq(
        tool.parse(["check", "-h"]).unwrap().help_text,
        "Check the input\n\nUsage: tool check [OPTIONS]\n\nOptions:\n"
            + "      --mode <mode>  [default: fast] [possible values: fast, slow]\n"
            + "  -h, --help         Print help\n  -V, --version      Print version\n"
    );
    let selected = tool.parse(["--verbose", "check", "--mode", "slow"]).unwrap();
    Assert.is_true(selected.get_bool("verbose").unwrap());
    Assert.eq(selected.subcommand.unwrap().get_string("mode").unwrap(), "slow");
    Assert.is_true(Command("required").positional("input", required: true).parse(["--help"]).unwrap().is_help);
}

@test
fun cli_errors(): void {
    let unknown = probe().parse(["--unknown"]).unwrap_err();
    Assert.eq(unknown.code(), "EARGS");
    Assert.eq(
        unknown.message(),
        "error: unexpected argument '--unknown' found\n\nUsage: probe [OPTIONS] [files]...\n\n"
            + "For more information, try '--help'.\n"
    );
    Assert.is_true(probe().parse(["--name"]).unwrap_err().message().contains("a value is required for '--name <name>'"));
    Assert.is_true(probe().parse(["--count", "oops"]).unwrap_err().message().contains("expected a decimal 32-bit integer"));
    Assert.is_true(probe().parse(["--verbose=yes"]).unwrap_err().message().contains("unexpected value 'yes'"));
    Assert.is_true(probe().parse(["-x"]).unwrap_err().message().contains("unexpected argument '-x' found"));
    Assert.is_true(
        Command("required").positional("input", required: true).parse([]).unwrap_err().message()
            .contains("the following required arguments were not provided:\n  <input>")
    );
    let separated = probe().parse(["-vn", "first", "--name=second", "--count", "-42", "--", "--not-an-option"]).unwrap();
    Assert.eq(separated.get_strings("name").unwrap().length, 2);
    Assert.eq(separated.get_int("count").unwrap(), -42);
    Assert.eq(separated.get_string("files").unwrap(), "--not-an-option");
    Assert.eq(Command("bad").int_option("value", default_value: 1).choices("value", ["x"]).parse([]).unwrap_err().code(), "EINVAL");
    Assert.eq(
        Command("bad").positional("first").positional("second", required: true).parse([]).unwrap_err().code(),
        "EINVAL"
    );
}
