import system.testing;
import system;
import system.json;
import system.collections;

@json
class c10d_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
class c10d_Bundle {
    public items: List<int>;
    public tags: Set<string>;
    public scores: Map<string, int>;
    public ordered: SortedMap<string, int>;
    public trail: int[];
    public nested: List<c10d_Point>;

    public constructor(
        items: List<int>,
        tags: Set<string>,
        scores: Map<string, int>,
        ordered: SortedMap<string, int>,
        trail: int[],
        nested: List<c10d_Point>
    ) {
        this.items = items;
        this.tags = tags;
        this.scores = scores;
        this.ordered = ordered;
        this.trail = trail;
        this.nested = nested;
    }
}

fun c10d_body(): void {
    let items = List<int>();
    items.push(1);
    items.push(2);

    let tags = Set<string>();
    tags.add("a");
    tags.add("b");
    tags.add("a");

    let scores = Map<string, int>();
    scores.set("ada", 10);

    let ordered = SortedMap<string, int>();
    ordered.set("z", 1);
    ordered.set("a", 2);

    let trail = Buffer.alloc<int>(2);
    trail[0] = 9;
    trail[1] = 8;

    let nested = List<c10d_Point>();
    nested.push(c10d_Point(3, 4));

    let bundle = c10d_Bundle(items, tags, scores, ordered, trail, nested);
    let text = Json.serialize(bundle);
    c10d_verify_observation((text).to_string());

    switch (Json.deserialize<c10d_Bundle>(text)) {
        Ok(back) => {
            c10d_verify_observation((back.items.length).to_string());
            c10d_verify_observation((back.tags.length).to_string());
            c10d_verify_observation((back.scores.get("ada").unwrap_or(-1)).to_string());
            c10d_verify_observation((back.ordered.get("a").unwrap_or(-1)).to_string());
            c10d_verify_observation((back.trail[0]).to_string());
            c10d_verify_observation((back.nested.get(0).x).to_string());
        },
        Err(e) => c10d_verify_observation(("err:" + e.message()).to_string()),
    }

    let top_list = List<int>();
    top_list.push(7);
    top_list.push(8);
    c10d_verify_observation((Json.serialize<List<int>>(top_list)).to_string());

    let top_set = Set<string>();
    top_set.add("x");
    top_set.add("y");
    c10d_verify_observation((Json.serialize<Set<string>>(top_set)).to_string());

    let top_map = Map<string, int>();
    top_map.set("k", 42);
    c10d_verify_observation((Json.serialize<Map<string, int>>(top_map)).to_string());

    switch (Json.deserialize<List<int>>("[9,10]")) {
        Ok(xs) => c10d_verify_observation((xs.get(0)).to_string()),
        Err(e) => c10d_verify_observation((e.message()).to_string()),
    }

    c10d_verify_observation((Json.serialize(top_list)).to_string());
    c10d_verify_observation((Json.serialize(top_set)).to_string());
    c10d_verify_observation((Json.serialize(top_map)).to_string());

    let data: Map<string, string> = {"key": "value"};
    c10d_verify_observation((Json.serialize(data)).to_string());
}

let c10d_cursor: int = 0;

fun c10d_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\"items\":[1,2],\"tags\":[\"a\",\"b\"],\"scores\":{\"ada\":10},\"ordered\":{\"a\":2,\"z\":1},\"trail\":[9,8],\"nested\":[{\"x\":3,\"y\":4}]}\n2\n2\n10\n2\n9\n3\n[7,8]\n[\"y\",\"x\"]\n{\"k\":42}\n9\n[7,8]\n[\"y\",\"x\"]\n{\"k\":42}\n{\"key\":\"value\"}\n";
    let end = c10d_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c10d_cursor, end));
    c10d_cursor = end;
}

@test
@timeout(180000)

fun json_collections(): void {
    c10d_cursor = 0;
    c10d_body();
    Assert.eq(c10d_cursor, ("{\"items\":[1,2],\"tags\":[\"a\",\"b\"],\"scores\":{\"ada\":10},\"ordered\":{\"a\":2,\"z\":1},\"trail\":[9,8],\"nested\":[{\"x\":3,\"y\":4}]}\n2\n2\n10\n2\n9\n3\n[7,8]\n[\"y\",\"x\"]\n{\"k\":42}\n9\n[7,8]\n[\"y\",\"x\"]\n{\"k\":42}\n{\"key\":\"value\"}\n").length);
}
