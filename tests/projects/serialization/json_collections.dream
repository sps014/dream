import system.testing;
import system;
import system.json;
import system.collections;

@json
class c10d_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
class c10d_Bundle {
    public items: List<int>;
    public tags: Set<string>;
    public scores: Map<string, int>;
    public ordered: SortedMap<string, int>;
    public trail: int[];
    public nested: List<c10d_Point>;

    public constructor(
        items: List<int>,
        tags: Set<string>,
        scores: Map<string, int>,
        ordered: SortedMap<string, int>,
        trail: int[],
        nested: List<c10d_Point>
    ) {
        this.items = items;
        this.tags = tags;
        this.scores = scores;
        this.ordered = ordered;
        this.trail = trail;
        this.nested = nested;
    }
}

@test
@timeout(180000)
fun json_collections(): void {
    let items = List<int>();
    items.push(1);
    items.push(2);

    let tags = Set<string>();
    tags.add("a");
    tags.add("b");
    tags.add("a");

    let scores = Map<string, int>();
    scores["ada"] = 10;

    let ordered = SortedMap<string, int>();
    ordered["z"] = 1;
    ordered["a"] = 2;

    let trail = Array.alloc<int>(2);
    trail[0] = 9;
    trail[1] = 8;

    let nested = List<c10d_Point>();
    nested.push(c10d_Point(3, 4));

    let bundle = c10d_Bundle(items, tags, scores, ordered, trail, nested);
    let text = Json.serialize(bundle);
    Assert.eq(
        text,
        "{\"items\":[1,2],\"tags\":[\"a\",\"b\"],\"scores\":{\"ada\":10},\"ordered\":{\"a\":2,\"z\":1},\"trail\":[9,8],\"nested\":[{\"x\":3,\"y\":4}]}"
    );

    let back = Json.deserialize<c10d_Bundle>(text).unwrap();
    Assert.eq(back.items.length, 2);
    Assert.eq(back.tags.length, 2);
    Assert.eq(back.scores.get("ada").unwrap_or(-1), 10);
    Assert.eq(back.ordered.get("a").unwrap_or(-1), 2);
    Assert.eq(back.trail[0], 9);
    Assert.eq(back.nested[0].x, 3);

    let top_list = List<int>();
    top_list.push(7);
    top_list.push(8);
    Assert.eq(Json.serialize<List<int>>(top_list), "[7,8]");

    let top_set = Set<string>();
    top_set.add("x");
    top_set.add("y");
    Assert.eq(Json.serialize<Set<string>>(top_set), "[\"y\",\"x\"]");

    let top_map = Map<string, int>();
    top_map["k"] = 42;
    Assert.eq(Json.serialize<Map<string, int>>(top_map), "{\"k\":42}");

    Assert.eq(Json.deserialize<List<int>>("[9,10]").unwrap()[0], 9);

    Assert.eq(Json.serialize(top_list), "[7,8]");
    Assert.eq(Json.serialize(top_set), "[\"y\",\"x\"]");
    Assert.eq(Json.serialize(top_map), "{\"k\":42}");

    let data: Map<string, string> = {
        "key": "value"
    };
    Assert.eq(Json.serialize(data), "{\"key\":\"value\"}");
}

@json
class c10f_Record {
    public values: int[];
    public items: List<int>;

    public constructor(values: int[], items: List<int>) {
        this.values = values;
        this.items = items;
    }
}

fun c10f_check(text: string): string {
    switch (Json.deserialize<c10f_Record>(text)) {
        Ok(record) => {
            return record.values.length.to_string() + "," + record.items.length.to_string();
        },
        Err(error) => {
            return error.message();
        },
    }
}

@test
@timeout(180000)
fun json_container_whitespace(): void {
    Assert.eq(c10f_check(" { \n\t\"values\" : [ 1 , 2 ] , \"items\" : [ 3 , 4 ] \r\n } "), "2,2");
    Assert.eq(c10f_check("{\"values\": [ ], \"items\": [ ] }"), "0,0");
    Assert.eq(c10f_check("{\"values\": [ 1 "), "invalid JSON input");
    Assert.eq(c10f_check("{\"values\": [ true ] }"), "invalid JSON input");
    Assert.eq(c10f_check("{\"values\": [1], \"items\": [2] "), "invalid JSON input");
}

// `JsonValue` is the escape hatch for heterogeneous / unknown JSON: it carries its own shape, so
// collections and `@json` fields holding one pass it straight through instead of decoding per type.
@json
class c124_Envelope {
    public id: int;
    public payload: JsonValue;

    public constructor(id: int, payload: JsonValue) {
        this.id = id;
        this.payload = payload;
    }
}

@test
@timeout(180000)
fun json_value_collections(): void {
    let items: List<JsonValue> = [JsonValue.from_int(1), JsonValue.from_string("x")];
    Assert.eq(Json.serialize(items), "[1,\"x\"]");

    let map: Map<string, JsonValue> = {
        "n": JsonValue.from_int(42)
    };
    Assert.eq(Json.serialize(map), "{\"n\":42}");

    let back = Json.deserialize<Map<string, JsonValue>>("{\"a\":7}").unwrap();
    Assert.eq(Json.serialize(back), "{\"a\":7}");

    // A nested tree survives a round trip through a typed `@json` field untouched.
    let raw = Json.deserialize<JsonValue>("{\"deep\":{\"n\":[1,2]}}").unwrap();
    let text = Json.serialize(c124_Envelope(9, raw));
    Assert.eq(text, "{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}");
    Assert.eq(
        Json.serialize(Json.deserialize<c124_Envelope>(text).unwrap()),
        "{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}"
    );
}
