import system.testing;
import system;
import system.json;
@json
class c110_Geo {
    public lat: double;
    public lng: double;

    public constructor(lat: double, lng: double) {
        this.lat = lat;
        this.lng = lng;
    }
}

@json
class c110_Address {
    public city: string;
    public zip: string;
    public geo: c110_Geo;

    public constructor(city: string, zip: string, geo: c110_Geo) {
        this.city = city;
        this.zip = zip;
        this.geo = geo;
    }
}

@json
class c110_Company {
    public name: string;
    public address: c110_Address;

    public constructor(name: string, address: c110_Address) {
        this.name = name;
        this.address = address;
    }
}

@json
class c110_User {
    public name: string;
    public age: int;
    public company: c110_Company;
    public tags: string[];

    public constructor(name: string, age: int, company: c110_Company, tags: string[]) {
        this.name = name;
        this.age = age;
        this.company = company;
        this.tags = tags;
    }
}

@json
class c110_Team {
    public title: string;
    public lead: c110_User;
    public members: c110_User[];

    public constructor(title: string, lead: c110_User, members: c110_User[]) {
        this.title = title;
        this.lead = lead;
        this.members = members;
    }
}

fun c110_mk_user(name: string, age: int, city: string): c110_User {
    return c110_User(name, age, c110_Company(city + " Corp", c110_Address(city, "00000", c110_Geo(1.5d, 2.5d))), [name, city]);
}

@test
@timeout(180000)
fun json_deep_nesting(): void {
    let team = c110_Team("Core", c110_mk_user("Ada", 36, "London"), [c110_mk_user("Bob", 30, "Paris"), c110_mk_user("Cee", 41, "Berlin")]);

    let text = Json.serialize(team);
    Assert.eq_str((text).to_string(), "{\"title\":\"Core\",\"lead\":{\"name\":\"Ada\",\"age\":36,\"company\":{\"name\":\"London Corp\",\"address\":{\"city\":\"London\",\"zip\":\"00000\",\"geo\":{\"lat\":1.5,\"lng\":2.5}}},\"tags\":[\"Ada\",\"London\"]},\"members\":[{\"name\":\"Bob\",\"age\":30,\"company\":{\"name\":\"Paris Corp\",\"address\":{\"city\":\"Paris\",\"zip\":\"00000\",\"geo\":{\"lat\":1.5,\"lng\":2.5}}},\"tags\":[\"Bob\",\"Paris\"]},{\"name\":\"Cee\",\"age\":41,\"company\":{\"name\":\"Berlin Corp\",\"address\":{\"city\":\"Berlin\",\"zip\":\"00000\",\"geo\":{\"lat\":1.5,\"lng\":2.5}}},\"tags\":[\"Cee\",\"Berlin\"]}]}");

    let back = Json.deserialize<c110_Team>(text).unwrap_or(team);
    Assert.eq_str((back.title).to_string(), "Core");
    Assert.eq_str((back.lead.name).to_string(), "Ada");
    Assert.eq_str((back.lead.company.name).to_string(), "London Corp");
    Assert.eq_str((back.lead.company.address.city).to_string(), "London");
    Assert.eq_str((back.lead.company.address.geo.lat).to_string(), "1.5");
    Assert.eq_str((back.lead.tags[1]).to_string(), "London");
    Assert.eq_str((back.members.length).to_string(), "2");
    Assert.eq_str((back.members[0].name).to_string(), "Bob");
    Assert.eq_str((back.members[1].company.address.geo.lng).to_string(), "2.5");
    Assert.eq_str((back.members[1].age).to_string(), "41");

    // Round-trips identically.
    Assert.eq_str((Json.serialize(back) == text).to_string(), "true");
}
