import system.testing;
// @json on a generic class: the derive attaches to the template `Box<T>` and each concrete
// instantiation gets its own `to_json`/`from_json`. Type-parameter fields round-trip through
// `Json.serialize`/`Json.deserialize`, which the analyzer resolves per instance, so `Box<Point>`
// delegates to `Point`'s (also `@json`) converters.
import system;
import system.json;

@json
struct c114_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
struct c114_Box<T> {
    public value: T;

    public constructor(value: T) {
        this.value = value;
    }
}

@test
@timeout(180000)
fun json_generic_class(): void {
    let b = c114_Box<c114_Point>(c114_Point(3, 4));
    let s = Json.serialize<c114_Box<c114_Point>>(b);
    Assert.eq((s).to_string(), "{\"value\":{\"x\":3,\"y\":4}}");
    let back = Json.deserialize<c114_Box<c114_Point>>(s).unwrap_or(b);
    Assert.eq((back.value.x).to_string(), "3");
    Assert.eq((back.value.y).to_string(), "4");
}
