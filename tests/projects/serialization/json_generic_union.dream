import system.testing;
// @json on a generic discriminated union: the derive attaches to the template `Opt<T>` and each
// concrete instantiation gets its own converters. Type-parameter payloads round-trip through
// `Json.serialize`/`Json.deserialize`, resolved per instance by the monomorphizer.
import system;
import system.json;

@json
struct c115_Point {
    public x: int;
    public y: int;
    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
enum c115_Opt<T> {
    Some(T),
    None,
}

fun c115_body(): void {
    let a: c115_Opt<c115_Point> = c115_Opt.Some(c115_Point(3, 4));
    let sa = Json.serialize<c115_Opt<c115_Point>>(a);
    c115_verify_observation((sa).to_string());
    let backA = Json.deserialize<c115_Opt<c115_Point>>(sa).unwrap_or(a);
    switch (backA) {
        Some(value) => {
            c115_verify_observation((value.x).to_string());
            c115_verify_observation((value.y).to_string());
        }
        None => {
            c115_verify_observation(("none").to_string());
        }
    }

    let b: c115_Opt<c115_Point> = c115_Opt.None;
    let sb = Json.serialize<c115_Opt<c115_Point>>(b);
    c115_verify_observation((sb).to_string());
    let backB = Json.deserialize<c115_Opt<c115_Point>>(sb).unwrap_or(b);
    switch (backB) {
        Some(value) => {
            c115_verify_observation(("some").to_string());
        }
        None => {
            c115_verify_observation(("none").to_string());
        }
    }
}

let c115_cursor: int = 0;

fun c115_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\"type\":\"Some\",\"_0\":{\"x\":3,\"y\":4}}\n3\n4\n{\"type\":\"None\"}\nnone\n";
    let end = c115_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c115_cursor, end));
    c115_cursor = end;
}

@test
@timeout(180000)

fun json_generic_union(): void {
    c115_cursor = 0;
    c115_body();
    Assert.eq(
        c115_cursor,
        ("{\"type\":\"Some\",\"_0\":{\"x\":3,\"y\":4}}\n3\n4\n{\"type\":\"None\"}\nnone\n").length
    );
}
