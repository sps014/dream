import system.testing;
import system;
import system.json;

@json
class c116_User {
    public name: string;
    public age: int;

    @json_ignore
    public password: string;

    @json_ignore
    public login_count: int;

    @json_ignore
    public nickname: Option<string>;

    public constructor(
        name: string,
        age: int,
        password: string,
        login_count: int,
        nickname: Option<string>
    ) {
        this.name = name;
        this.age = age;
        this.password = password;
        this.login_count = login_count;
        this.nickname = nickname;
    }
}

@test
@timeout(180000)
fun json_ignore(): void {
    let u = c116_User("Ada", 36, "secret", 7, Option.Some("Countess"));
    let text = Json.serialize(u);
    Assert.eq_str((text).to_string(), "{\"name\":\"Ada\",\"age\":36}");

    let back = Json.deserialize<c116_User>(text).unwrap_or(u);
    Assert.eq_str((back.name).to_string(), "Ada");
    Assert.eq_str((back.age).to_string(), "36");
    Assert.eq_str((back.password).to_string(), "");
    Assert.eq_str((back.login_count).to_string(), "0");
    Assert.eq_str((back.nickname.is_none()).to_string(), "true");
}
