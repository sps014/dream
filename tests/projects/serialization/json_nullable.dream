import system.testing;
import system;
import system.json;
import system.collections;

@json
class c118_Address {
    public city: string;
    public zip: string;

    public constructor(city: string, zip: string) {
        this.city = city;
        this.zip = zip;
    }
}

@json
class c118_Profile {
    public name: string;
    public nickname: Option<string>;
    public address: Option<c118_Address>;
    public age: int;

    public constructor(
        name: string,
        nickname: Option<string>,
        address: Option<c118_Address>,
        age: int
    ) {
        this.name = name;
        this.nickname = nickname;
        this.address = address;
        this.age = age;
    }
}

@test
@timeout(180000)
fun json_nullable(): void {
    // Present values round-trip.
    let p1 = c118_Profile(
        "Ada",
        Option.Some("Countess"),
        Option.Some(c118_Address("London", "NW1")),
        36
    );
    let t1 = Json.serialize(p1);
    Assert.eq(
        (t1).to_string(),
        "{\"name\":\"Ada\",\"nickname\":\"Countess\",\"address\":{\"city\":\"London\",\"zip\":\"NW1\"},\"age\":36}"
    );
    let b1 = Json.deserialize<c118_Profile>(t1).unwrap_or(p1);
    Assert.eq((b1.nickname ?? "<none>").to_string(), "Countess");
    let addr = b1.address;
    Assert.eq((addr.is_none()).to_string(), "false");

    // None values serialize to JSON null and round-trip back to None.
    let no_name: Option<string> = Option.None;
    let no_addr: Option<c118_Address> = Option.None;
    let p2 = c118_Profile("Bob", no_name, no_addr, 20);
    let t2 = Json.serialize(p2);
    Assert.eq(
        (t2).to_string(),
        "{\"name\":\"Bob\",\"nickname\":null,\"address\":null,\"age\":20}"
    );
    let b2 = Json.deserialize<c118_Profile>(t2).unwrap_or(p2);
    Assert.eq((b2.nickname ?? "<none>").to_string(), "<none>");
    Assert.eq((b2.address.is_none()).to_string(), "true");

    // A missing key and an explicit null both deserialize to None.
    let b3 = Json.deserialize<c118_Profile>("{\"name\":\"Cee\",\"nickname\":null,\"age\":7}")
        .unwrap_or(p1);
    Assert.eq((b3.nickname ?? "<none>").to_string(), "<none>");
    Assert.eq((b3.address.is_none()).to_string(), "true");
}

@json
class c11a_Address {
    public city: string;

    public constructor(city: string) {
        this.city = city;
    }
}

@json
class c11a_Bag {
    public tags: Option<int[]>;
    public names: Option<string[]>;
    public places: Option<c11a_Address[]>;

    public constructor(
        tags: Option<int[]>,
        names: Option<string[]>,
        places: Option<c11a_Address[]>
    ) {
        this.tags = tags;
        this.names = names;
        this.places = places;
    }
}

@test
@timeout(180000)
fun json_optional_arrays(): void {
    let tags = Array.alloc<int>(2);
    tags[0] = 1;
    tags[1] = 2;
    let names = Array.alloc<string>(1);
    names[0] = "a";
    let places = Array.alloc<c11a_Address>(1);
    places[0] = c11a_Address("NYC");

    let b1 = c11a_Bag(Option.Some(tags), Option.Some(names), Option.Some(places));
    let t1 = Json.serialize(b1);
    Assert.eq(t1, "{\"tags\":[1,2],\"names\":[\"a\"],\"places\":[{\"city\":\"NYC\"}]}");
    let r1 = Json.deserialize<c11a_Bag>(t1).unwrap_or(b1);
    Assert.eq((r1.tags ?? Array.alloc<int>(0)).length, 2);
    Assert.eq((r1.names ?? Array.alloc<string>(0))[0], "a");
    Assert.eq((r1.places ?? Array.alloc<c11a_Address>(0))[0].city, "NYC");

    let none_tags: Option<int[]> = Option.None;
    let none_names: Option<string[]> = Option.None;
    let none_places: Option<c11a_Address[]> = Option.None;
    let b2 = c11a_Bag(none_tags, none_names, none_places);
    let t2 = Json.serialize(b2);
    Assert.eq(t2, "{\"tags\":null,\"names\":null,\"places\":null}");
    let r2 = Json.deserialize<c11a_Bag>(t2).unwrap_or(b2);
    Assert.is_true(r2.tags.is_none());
    Assert.is_true(r2.names.is_none());
    Assert.is_true(r2.places.is_none());
}

// `@json` field widening: `Option<T>` round-trips numeric/bool payloads, and `Map<string, V>`
// fields are encoded as a JSON object keyed by the map's string keys.
@json
class c119_Widened {
    public a: Option<int>;
    public b: Option<double>;
    public c: Option<bool>;
    public scores: Map<string, int>;

    public constructor(
        a: Option<int>,
        b: Option<double>,
        c: Option<bool>,
        scores: Map<string, int>
    ) {
        this.a = a;
        this.b = b;
        this.c = c;
        this.scores = scores;
    }
}

@test
@timeout(180000)
fun json_option_map_widen(): void {
    let scores = Map<string, int>();
    scores["alice"] = 10;
    scores["bob"] = 20;

    let w = c119_Widened(Option.Some(5), Option.None, Option.Some(true), scores);
    let s = Json.serialize(w);
    Assert.eq(s, "{\"a\":5,\"b\":null,\"c\":true,\"scores\":{\"bob\":20,\"alice\":10}}");

    let back = Json.deserialize<c119_Widened>(s).unwrap();
    Assert.eq(back.a.unwrap_or(-1), 5);
    Assert.is_true(back.b.is_none());
    Assert.is_true(back.c.unwrap_or(false));
    Assert.eq(back.scores.length, 2);
    Assert.eq(back.scores.get("alice").unwrap_or(-1), 10);
    Assert.eq(back.scores.get("bob").unwrap_or(-1), 20);
}
