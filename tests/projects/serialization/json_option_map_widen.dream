import system.testing;
// `@json` field widening: `Option<T>` now round-trips numeric/bool payloads (previously only
// `Option<string>`, `Option<@json class>`, and `Option<T[]>` were supported), and `Map<string, V>`
// fields are supported directly (encoded as a JSON object keyed by the map's string keys).
import system;
import system.json;
import system.collections;

@json
class c119_Widened {
    public a: Option<int>;
    public b: Option<double>;
    public c: Option<bool>;
    public scores: Map<string, int>;

    public constructor(
        a: Option<int>,
        b: Option<double>,
        c: Option<bool>,
        scores: Map<string, int>
    ) {
        this.a = a;
        this.b = b;
        this.c = c;
        this.scores = scores;
    }
}

fun c119_body(): void {
    let scores = Map<string, int>();
    scores["alice"] = 10;
    scores["bob"] = 20;

    let w = c119_Widened(Option.Some(5), Option.None, Option.Some(true), scores);
    let s = Json.serialize(w);
    c119_verify_observation((s).to_string());

    switch (Json.deserialize<c119_Widened>(s)) {
        Ok(back) => {
            c119_verify_observation((back.a.unwrap_or(-1)).to_string());
            c119_verify_observation((back.b.is_none()).to_string());
            c119_verify_observation((back.c.unwrap_or(false)).to_string());
            c119_verify_observation((back.scores.length).to_string());
            c119_verify_observation((back.scores.get("alice").unwrap_or(-1)).to_string());
            c119_verify_observation((back.scores.get("bob").unwrap_or(-1)).to_string());
        },
        Err(e) => c119_verify_observation(("err:" + e.message()).to_string()),
    }
}

let c119_cursor: int = 0;

fun c119_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\"a\":5,\"b\":null,\"c\":true,\"scores\":{\"bob\":20,\"alice\":10}}\n5\ntrue\ntrue\n2\n10\n20\n";
    let end = c119_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c119_cursor, end));
    c119_cursor = end;
}

@test
@timeout(180000)

fun json_option_map_widen(): void {
    c119_cursor = 0;
    c119_body();
    Assert.eq(
        c119_cursor,
        (
            "{\"a\":5,\"b\":null,\"c\":true,\"scores\":{\"bob\":20,\"alice\":10}}\n5\ntrue\ntrue\n2\n10\n20\n"
        ).length
    );
}
