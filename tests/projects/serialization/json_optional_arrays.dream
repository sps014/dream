import system.testing;
import system;
import system.json;

@json
class c11a_Address {
    public city: string;

    public constructor(city: string) {
        this.city = city;
    }
}

@json
class c11a_Bag {
    public tags: Option<int[]>;
    public names: Option<string[]>;
    public places: Option<c11a_Address[]>;

    public constructor(
        tags: Option<int[]>,
        names: Option<string[]>,
        places: Option<c11a_Address[]>
    ) {
        this.tags = tags;
        this.names = names;
        this.places = places;
    }
}

@test
@timeout(180000)
fun json_optional_arrays(): void {
    let tags = Buffer.alloc<int>(2);
    tags[0] = 1;
    tags[1] = 2;
    let names = Buffer.alloc<string>(1);
    names[0] = "a";
    let places = Buffer.alloc<c11a_Address>(1);
    places[0] = c11a_Address("NYC");

    let b1 = c11a_Bag(Option.Some(tags), Option.Some(names), Option.Some(places));
    let t1 = Json.serialize(b1);
    Assert.eq_str(
        (t1).to_string(),
        "{\"tags\":[1,2],\"names\":[\"a\"],\"places\":[{\"city\":\"NYC\"}]}"
    );
    let r1 = Json.deserialize<c11a_Bag>(t1).unwrap_or(b1);
    Assert.eq_str(((r1.tags ?? Buffer.alloc<int>(0)).length).to_string(), "2");
    Assert.eq_str(((r1.names ?? Buffer.alloc<string>(0))[0]).to_string(), "a");
    Assert.eq_str(((r1.places ?? Buffer.alloc<c11a_Address>(0))[0].city).to_string(), "NYC");

    let none_tags: Option<int[]> = Option.None;
    let none_names: Option<string[]> = Option.None;
    let none_places: Option<c11a_Address[]> = Option.None;
    let b2 = c11a_Bag(none_tags, none_names, none_places);
    let t2 = Json.serialize(b2);
    Assert.eq_str((t2).to_string(), "{\"tags\":null,\"names\":null,\"places\":null}");
    let r2 = Json.deserialize<c11a_Bag>(t2).unwrap_or(b2);
    Assert.eq_str((r2.tags.is_none()).to_string(), "true");
    Assert.eq_str((r2.names.is_none()).to_string(), "true");
    Assert.eq_str((r2.places.is_none()).to_string(), "true");
}
