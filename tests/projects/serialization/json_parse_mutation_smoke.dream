import system.testing;
// Deterministic mutation fuzz: thousands of corrupted documents (replaced, dropped and duplicated
// characters, truncation) must each yield a value or a ParseError, never a crash or hang.
import system;
import system.json;

fun c11c_mutate(doc: string, seed: int): string {
    let alphabet = "{}[]\":,-.0123456789eEtrufalsn \\ux";
    let s = seed;
    let out = doc;
    let edits = 1 + (s & 3);
    let k = 0;
    while k < edits {
        s = s * 1103515245 + 12345;
        let r = (s >> 8) & 1048575;
        let n = out.length;
        if n == 0 {
            return out;
        }
        let at = r % n;
        let kind = (r >> 12) & 3;
        if kind == 0 {
            let c = alphabet.substring((r >> 4) % alphabet.length, (r >> 4) % alphabet.length + 1);
            out = out.substring(0, at) + c + out.substring(at + 1, n);
        } else if kind == 1 {
            out = out.substring(0, at) + out.substring(at + 1, n);
        } else if kind == 2 {
            out = out.substring(0, at + 1) + out.substring(at, n);
        } else {
            out = out.substring(0, at);
        }
        k = k + 1;
    }
    return out;
}

fun c11c_body(): void {
    let docs: string[] = [
        "{\"a\": [1, 2.5e3, -0.25, true, false, null], \"b\": {\"c\": \"x\\u00e9\\n\"}}",
        "[[[[{\"deep\": [1, {\"k\": \"v\"}]}]]]]",
        "{\"name\": \"dream\", \"tags\": [\"a\", \"b\"], \"n\": 12345678901234}",
    ];
    let ok = 0;
    let bad = 0;
    let d = 0;
    while d < docs.length {
        let i = 0;
        while i < 1500 {
            let text = c11c_mutate(docs[d], i * 7919 + d);
            if Json.deserialize<JsonValue>(text).is_ok() {
                ok = ok + 1;
            } else {
                bad = bad + 1;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    c11c_verify_observation((ok + bad).to_string());
    c11c_verify_observation(((ok > 0) && (bad > 0)).to_string());
}

let c11c_cursor: int = 0;

fun c11c_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "4500\ntrue\n";
    let end = c11c_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c11c_cursor, end));
    c11c_cursor = end;
}

@test
@timeout(180000)

fun json_parse_mutation_smoke(): void {
    c11c_cursor = 0;
    c11c_body();
    Assert.eq(c11c_cursor, ("4500\ntrue\n").length);
}
