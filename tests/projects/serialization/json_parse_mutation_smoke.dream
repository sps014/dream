import system.testing;
// Deterministic mutation fuzz: thousands of corrupted documents (replaced, dropped and duplicated
// characters, truncation) must each yield a value or a ParseError, never a crash or hang.
import system;
import system.json;

fun c11c_mutate(doc: string, seed: int): string {
    let alphabet = "{}[]\":,-.0123456789eEtrufalsn \\ux";
    let s = seed;
    let out = doc;
    let edits = 1 + (s & 3);
    let k = 0;
    while k < edits {
        s = s * 1103515245 + 12345;
        let r = (s >> 8) & 1048575;
        let n = out.length;
        if n == 0 {
            return out;
        }
        let at = r % n;
        let kind = (r >> 12) & 3;
        if kind == 0 {
            let c = alphabet.substring((r >> 4) % alphabet.length, (r >> 4) % alphabet.length + 1);
            out = out.substring(0, at) + c + out.substring(at + 1, n);
        } else if kind == 1 {
            out = out.substring(0, at) + out.substring(at + 1, n);
        } else if kind == 2 {
            out = out.substring(0, at + 1) + out.substring(at, n);
        } else {
            out = out.substring(0, at);
        }
        k = k + 1;
    }
    return out;
}

@test
@timeout(180000)
fun json_parse_mutation_smoke(): void {
    let docs: string[] = [
        "{\"a\": [1, 2.5e3, -0.25, true, false, null], \"b\": {\"c\": \"x\\u00e9\\n\"}}",
        "[[[[{\"deep\": [1, {\"k\": \"v\"}]}]]]]",
        "{\"name\": \"dream\", \"tags\": [\"a\", \"b\"], \"n\": 12345678901234}",
    ];
    let ok = 0;
    let bad = 0;
    let d = 0;
    while d < docs.length {
        let i = 0;
        while i < 1500 {
            let text = c11c_mutate(docs[d], i * 7919 + d);
            if Json.deserialize<JsonValue>(text).is_ok() {
                ok = ok + 1;
            } else {
                bad = bad + 1;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    Assert.eq(ok + bad, 4500);
    Assert.is_true(ok > 0);
    Assert.is_true(bad > 0);
}

@test
@timeout(180000)
fun json_string_boundaries(): void {
    for (let n = 0; n < 130; n = n + 1) {
        let content = StringBuilder(n * 2 + 8);
        for (let i = 0; i < n; i = i + 1) {
            content.append(i % 7 == 0 ? "😀" : "x");
        }
        let expected = content.build();
        let wrapped = "prefix\"" + expected + "\"tail";
        let input = wrapped.substring(6, wrapped.length - 4);
        let decoded = Json.deserialize<JsonValue>(input).unwrap().as_string().unwrap();
        Assert.eq(decoded, expected);
        let escaped = "\"" + expected + "\\n" + expected + "\"";
        let with_escape = Json.deserialize<JsonValue>(escaped).unwrap().as_string().unwrap();
        Assert.eq(with_escape, expected + "\n" + expected);
        Assert.is_true(Json.deserialize<JsonValue>("\"" + expected).is_err());
    }
}

@json
class StrictJsonRecord {
    public value: string;

    public constructor(value: string) {
        this.value = value;
    }
}

@json
class JsonIntegerRecord {
    public value: int;

    public constructor(value: int) {
        this.value = value;
    }
}

@test
fun json_typed_integer_bounds_and_syntax(): void {
    Assert.eq(
        Json.deserialize<JsonIntegerRecord>("{\"value\":2147483647}").unwrap().value,
        2147483647
    );
    Assert.eq(
        Json.deserialize<JsonIntegerRecord>("{\"value\":-2147483648}").unwrap().value,
        -2147483647 - 1
    );
    Assert.eq(Json.deserialize<JsonIntegerRecord>("{\"value\":-12.5e+2}").unwrap().value, -12);
    for (let number in ["2147483648", "-2147483649", "-01", "01", "-.2", "3.", "3e+"]) {
        Assert.is_true(Json.deserialize<JsonIntegerRecord>("{\"value\":" + number + "}").is_err());
    }
}

@test
fun json_rejects_malformed_documents(): void {
    let malformed = [
        " ",
        "1e",
        "1.",
        "01",
        "-",
        "+1",
        "nul",
        "trux",
        "fals",
        "[1",
        "[1}",
        "[1 2]",
        "[1,]",
        "{\"x\":1]",
        "{\"x\" 1}",
        "{\"x\":1,}",
        "\"unterminated",
        "\"\\q\"",
        "\"\\u00xy\"",
        "\"raw\ncontrol\"",
        "\"long unescaped run\twith control\"",
    ];
    for (let text in malformed) {
        Assert.is_true(Json.deserialize<JsonValue>(text).is_err());
    }
    Assert.eq(Json.deserialize<JsonValue>("-1.25e+2").unwrap().as_double().unwrap(), -125.0d);
    Assert.eq(Json.deserialize<JsonValue>("\"\\uD83D\\uDE00\"").unwrap().as_string().unwrap(), "😀");

    Assert.is_true(Json.deserialize<StrictJsonRecord>("{\"value\":}").is_err());
    Assert.is_true(Json.deserialize<StrictJsonRecord>("{\"value\":\"abc\",}").is_err());
    Assert.is_true(Json.deserialize<StrictJsonRecord>("{\"value\":\"abc\" \"other\":0}").is_err());
    Assert.is_true(Json.deserialize<StrictJsonRecord>("{\"unknown\":[1,]}").is_err());
    Assert.eq(Json.deserialize<StrictJsonRecord>("{}").unwrap().value, "");
}
