import system.testing;
// Deterministic mutation fuzz: thousands of corrupted documents (replaced, dropped and duplicated
// characters, truncation) must each yield a value or a ParseError, never a crash or hang.
import system;
import system.json;

fun c11c_mutate(doc: string, seed: int): string {
    let alphabet = "{}[]\":,-.0123456789eEtrufalsn \\ux";
    let s = seed;
    let out = doc;
    let edits = 1 + (s & 3);
    let k = 0;
    while k < edits {
        s = s * 1103515245 + 12345;
        let r = (s >> 8) & 1048575;
        let n = out.length;
        if n == 0 {
            return out;
        }
        let at = r % n;
        let kind = (r >> 12) & 3;
        if kind == 0 {
            let c = alphabet.substring((r >> 4) % alphabet.length, (r >> 4) % alphabet.length + 1);
            out = out.substring(0, at) + c + out.substring(at + 1, n);
        } else if kind == 1 {
            out = out.substring(0, at) + out.substring(at + 1, n);
        } else if kind == 2 {
            out = out.substring(0, at + 1) + out.substring(at, n);
        } else {
            out = out.substring(0, at);
        }
        k = k + 1;
    }
    return out;
}

@test
@timeout(180000)
fun json_parse_mutation_smoke(): void {
    let docs: string[] = [
        "{\"a\": [1, 2.5e3, -0.25, true, false, null], \"b\": {\"c\": \"x\\u00e9\\n\"}}",
        "[[[[{\"deep\": [1, {\"k\": \"v\"}]}]]]]",
        "{\"name\": \"dream\", \"tags\": [\"a\", \"b\"], \"n\": 12345678901234}",
    ];
    let ok = 0;
    let bad = 0;
    let d = 0;
    while d < docs.length {
        let i = 0;
        while i < 1500 {
            let text = c11c_mutate(docs[d], i * 7919 + d);
            if Json.deserialize<JsonValue>(text).is_ok() {
                ok = ok + 1;
            } else {
                bad = bad + 1;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    Assert.eq(ok + bad, 4500);
    Assert.is_true(ok > 0);
    Assert.is_true(bad > 0);
}

@test
@timeout(180000)
fun json_string_boundaries(): void {
    for (let n = 0; n < 130; n = n + 1) {
        let content = StringBuilder(n * 2 + 8);
        for (let i = 0; i < n; i = i + 1) {
            content.append(i % 7 == 0 ? "😀" : "x");
        }
        let expected = content.build();
        let wrapped = "prefix\"" + expected + "\"tail";
        let input = wrapped.substring(6, wrapped.length - 4);
        let decoded = Json.deserialize<JsonValue>(input).unwrap().as_string().unwrap();
        Assert.eq(decoded, expected);
        // The decoded string must own its storage, not alias the input buffer.
        if n > 0 {
            input[1] = 'Z';
            Assert.eq(decoded, expected);
        }
        let escaped = "\"" + expected + "\\n" + expected + "\"";
        let with_escape = Json.deserialize<JsonValue>(escaped).unwrap().as_string().unwrap();
        Assert.eq(with_escape, expected + "\n" + expected);
        let truncated = Json.deserialize<JsonValue>("\"" + expected).unwrap().as_string().unwrap();
        Assert.eq(truncated, expected);
    }
}
