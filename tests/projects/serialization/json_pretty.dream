import system.testing;
import system;
import system.json;
@json
class c11d_Address {
    city: string;
    zip: string;

    public constructor(city: string, zip: string) {
        this.city = city;
        this.zip = zip;
    }
}

@json
class c11d_User {
    name: string;
    age: int;
    address: c11d_Address;
    tags: string[];

    public constructor(name: string, age: int, address: c11d_Address, tags: string[]) {
        this.name = name;
        this.age = age;
        this.address = address;
        this.tags = tags;
    }
}

fun c11d_body(): void {
    let u = c11d_User("Ada", 36, c11d_Address("London", "NW1"), ["dev", "math"]);

    c11d_verify_observation((Json.serialize_pretty(u.to_json(), 2)).to_string());

    let v = Json.deserialize<JsonValue>("{\"a\":[1,2],\"b\":{\"c\":true},\"d\":[]}").unwrap_or(JsonValue.none());
    c11d_verify_observation((Json.serialize_pretty(v, 4)).to_string());

    // indent 0 falls back to compact output.
    c11d_verify_observation((Json.serialize_pretty(v, 0)).to_string());
}

let c11d_cursor: int = 0;

fun c11d_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\n  \"name\": \"Ada\",\n  \"age\": 36,\n  \"address\": {\n    \"city\": \"London\",\n    \"zip\": \"NW1\"\n  },\n  \"tags\": [\n    \"dev\",\n    \"math\"\n  ]\n}\n{\n    \"a\": [\n        1,\n        2\n    ],\n    \"b\": {\n        \"c\": true\n    },\n    \"d\": []\n}\n{\"a\":[1,2],\"b\":{\"c\":true},\"d\":[]}\n";
    let end = c11d_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c11d_cursor, end));
    c11d_cursor = end;
}

@test
@timeout(180000)

fun json_pretty(): void {
    c11d_cursor = 0;
    c11d_body();
    Assert.eq(c11d_cursor, ("{\n  \"name\": \"Ada\",\n  \"age\": 36,\n  \"address\": {\n    \"city\": \"London\",\n    \"zip\": \"NW1\"\n  },\n  \"tags\": [\n    \"dev\",\n    \"math\"\n  ]\n}\n{\n    \"a\": [\n        1,\n        2\n    ],\n    \"b\": {\n        \"c\": true\n    },\n    \"d\": []\n}\n{\"a\":[1,2],\"b\":{\"c\":true},\"d\":[]}\n").length);
}
