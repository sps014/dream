import system.testing;
import system;
import system.json;
@json
class c11e_Product {
    @property_name("id")
    public product_id: int;

    @property_name("title")
    public name: string;

    @property_name("priceUsd")
    public price: float;

    public tags: string[]; // standard field

    public constructor(product_id: int, name: string, price: float, tags: string[]) {
        this.product_id = product_id;
        this.name = name;
        this.price = price;
        this.tags = tags;
    }
}

@test
@timeout(180000)
fun json_property_name(): void {
    let p = c11e_Product(42, "Widget", 9.5, ["sale", "new"]);

    let serialized = Json.serialize(p);
    Assert.eq_str((serialized).to_string(), "{\"id\":42,\"title\":\"Widget\",\"priceUsd\":9.5,\"tags\":[\"sale\",\"new\"]}");

    let deserialized = Json.deserialize<c11e_Product>(serialized).unwrap_or(p);
    Assert.eq_str((deserialized.name).to_string(), "Widget");
    Assert.eq_str((deserialized.product_id).to_string(), "42");
}