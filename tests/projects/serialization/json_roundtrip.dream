import system.testing;
import system;
import system.json;

@test
@timeout(180000)
fun json_roundtrip(): void {
    let user = JsonValue.dict();
    user["name"] = JsonValue.from_string("Ada");
    user["age"] = JsonValue.from_int(36);
    let tags = JsonValue.array();
    tags.push(JsonValue.from_string("dev"));
    tags.push(JsonValue.from_string("math"));
    user["tags"] = tags;
    user["active"] = JsonValue.from_bool(true);

    Assert.eq(
        (Json.serialize(user)).to_string(),
        "{\"name\":\"Ada\",\"age\":36,\"tags\":[\"dev\",\"math\"],\"active\":true}"
    );

    let parsed = Json.deserialize<JsonValue>(Json.serialize(user)).unwrap_or(JsonValue.null());
    let none = JsonValue.null();
    Assert.eq(
        (parsed.get("name").unwrap_or(none).as_string().unwrap_or("")).to_string(),
        "Ada"
    );
    Assert.eq((parsed.get("age").unwrap_or(none).as_int().unwrap_or(0)).to_string(), "36");
    Assert.eq(
        (parsed.get("tags").unwrap_or(none).at(1).unwrap_or(none).as_string().unwrap_or(""))
            .to_string(),
        "math"
    );
    Assert.eq(
        (parsed.get("active").unwrap_or(none).as_bool().unwrap_or(false)).to_string(),
        "true"
    );
    Assert.eq((parsed.get("tags").unwrap_or(none).length).to_string(), "2");
}
