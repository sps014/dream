import system.testing;
// `Json.deserialize<T>` reports an unknown discriminated-union `"type"` tag as `Err(ParseError)`
// instead of silently falling back to the first variant.
import system;
import system.json;

@json
enum c122_Shape {
    Circle(int),
    Rect(width: int, height: int),
}

fun c122_body(): void {
    let c = c122_Shape.Circle(7);
    let s = Json.serialize(c);
    c122_verify_observation((s).to_string());
    switch (Json.deserialize<c122_Shape>(s)) {
        Ok(v) => c122_verify_observation(("ok:" + v.to_string()).to_string()),
        Err(e) => c122_verify_observation(("err:" + e.message()).to_string()),
    }

    let bad = "{\"type\":\"Triangle\"}";
    switch (Json.deserialize<c122_Shape>(bad)) {
        Ok(v) => c122_verify_observation(("ok:" + v.to_string()).to_string()),
        Err(e) => c122_verify_observation(("err:" + e.message()).to_string()),
    }

    let missing = "{}";
    switch (Json.deserialize<c122_Shape>(missing)) {
        Ok(v) => c122_verify_observation(("ok:" + v.to_string()).to_string()),
        Err(e) => c122_verify_observation(("err:" + e.code() + ":" + e.message()).to_string()),
    }
}

let c122_cursor: int = 0;

fun c122_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\"type\":\"Circle\",\"_0\":7}\nok:Circle(7)\nerr:unknown variant 'Triangle' for union 'c122_Shape'\nerr:EPARSE:unknown variant '' for union 'c122_Shape'\n";
    let end = c122_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c122_cursor, end));
    c122_cursor = end;
}

@test
@timeout(180000)

fun json_union_strict_variant(): void {
    c122_cursor = 0;
    c122_body();
    Assert.eq(
        c122_cursor,
        (
            "{\"type\":\"Circle\",\"_0\":7}\nok:Circle(7)\nerr:unknown variant 'Triangle' for union 'c122_Shape'\nerr:EPARSE:unknown variant '' for union 'c122_Shape'\n"
        ).length
    );
}
