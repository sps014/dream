import system.testing;
// `JsonValue` is the escape hatch for heterogeneous / unknown JSON: it carries its own shape, so
// collections and `@json` fields holding one pass it straight through instead of decoding per type.
import system;
import system.json;

@json
class c124_Envelope {
    public id: int;
    public payload: JsonValue;

    public constructor(id: int, payload: JsonValue) {
        this.id = id;
        this.payload = payload;
    }
}

fun c124_body() {
    let items: List<JsonValue> = [JsonValue.from_int(1), JsonValue.from_string("x")];
    c124_verify_observation((Json.serialize(items)).to_string());

    let map: Map<string, JsonValue> = { "n": JsonValue.from_int(42) };
    c124_verify_observation((Json.serialize(map)).to_string());

    let back = Json.deserialize<Map<string, JsonValue>>("{\"a\":7}").unwrap();
    c124_verify_observation((Json.serialize(back)).to_string());

    // A nested tree survives a round trip through a typed `@json` field untouched.
    let raw = Json.deserialize<JsonValue>("{\"deep\":{\"n\":[1,2]}}").unwrap();
    let text = Json.serialize(c124_Envelope(9, raw));
    c124_verify_observation((text).to_string());
    c124_verify_observation((Json.serialize(Json.deserialize<c124_Envelope>(text).unwrap())).to_string());
}

let c124_cursor: int = 0;

fun c124_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "[1,\"x\"]\n{\"n\":42}\n{\"a\":7}\n{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}\n{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}\n";
    let end = c124_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c124_cursor, end));
    c124_cursor = end;
}

@test
@timeout(180000)

fun json_value_collections(): void {
    c124_cursor = 0;
    c124_body();
    Assert.eq(c124_cursor, ("[1,\"x\"]\n{\"n\":42}\n{\"a\":7}\n{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}\n{\"id\":9,\"payload\":{\"deep\":{\"n\":[1,2]}}}\n").length);
}
