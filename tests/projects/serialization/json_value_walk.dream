import system.testing;
// Parse unseen JSON into a JsonValue tree and walk it with `kind()` / `get_*`.
// Values stay JsonValue — this is the string-keyed mixed dict, not Map<string, object>.
import system;
import system.json;

fun c125_describe(borrow v: JsonValue): string {
    switch (v.kind()) {
        case JsonKind.Null: return "null";
        case JsonKind.Object: return "object";
        case JsonKind.Array: return "array";
        case JsonKind.Bool: return "bool:" + v.bool_or(false).to_string();
        case JsonKind.String: return "string:" + v.str_or("");
        case JsonKind.Number: return "number:" + v.int_or(0).to_string();
        default: return "unknown";
    }
}

fun c125_walk(path: string, borrow v: JsonValue): void {
    if path.length == 0 {
        c125_verify_observation((c125_describe(v)).to_string());
    } else {
        c125_verify_observation((path + "=" + c125_describe(v)).to_string());
    }
    switch (v.kind()) {
        case JsonKind.Object:
            let i = 0;
            while i < v.length {
                let key = v.key_at(i).unwrap_or("");
                let child = v.value_at(i).unwrap_or(JsonValue.none());
                let next = key;
                if path.length > 0 {
                    next = path + "." + key;
                }
                c125_walk(next, child);
                i = i + 1;
            }
        case JsonKind.Array:
            switch (v.as_array()) {
                Some(items) => {
                    let i = 0;
                    for (let item in items) {
                        let idx = "[" + i.to_string() + "]";
                        let next = idx;
                        if path.length > 0 {
                            next = path + idx;
                        }
                        c125_walk(next, item);
                        i = i + 1;
                    }
                },
                None => {}
            }
        default:
    }
}

fun c125_body() {
    let text = "{\"name\":\"ada\",\"tags\":[1,2],\"on\":true,\"meta\":{\"id\":9}}";
    switch (Json.deserialize<JsonValue>(text)) {
        Ok(v) => {
            c125_walk("", v);

            c125_verify_observation((v.get("missing").is_none()).to_string());
            c125_verify_observation((v.get_int("name").is_none()).to_string());
            c125_verify_observation((v.get_str_or("name", "") == "ada").to_string());

            switch (v.get("meta")) {
                Some(meta) => {
                    c125_verify_observation((meta.get_int_or("id", 0)).to_string());
                },
                None => {
                    c125_verify_observation((-1).to_string());
                },
            }

            let dict: Map<string, JsonValue> = v.as_map().unwrap_or(Map<string, JsonValue>());
            c125_verify_observation((Json.serialize(dict)).to_string());
        },
        Err(e) => {
            c125_verify_observation((e.message()).to_string());
        },
    }
}

let c125_cursor: int = 0;

fun c125_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "object\nname=string:ada\ntags=array\ntags[0]=number:1\ntags[1]=number:2\non=bool:true\nmeta=object\nmeta.id=number:9\ntrue\ntrue\ntrue\n9\n{\"tags\":[1,2],\"on\":true,\"meta\":{\"id\":9},\"name\":\"ada\"}\n";
    let end = c125_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c125_cursor, end));
    c125_cursor = end;
}

@test
@timeout(180000)

fun json_value_walk(): void {
    c125_cursor = 0;
    c125_body();
    Assert.eq(c125_cursor, ("object\nname=string:ada\ntags=array\ntags[0]=number:1\ntags[1]=number:2\non=bool:true\nmeta=object\nmeta.id=number:9\ntrue\ntrue\ntrue\n9\n{\"tags\":[1,2],\"on\":true,\"meta\":{\"id\":9},\"name\":\"ada\"}\n").length);
}
