import system.testing;
// A value `struct` supports `@json` exactly like a `class`: the derive emits `to_json`/`from_json`
// via an `extend` block, so value types round-trip through `Json.serialize` / `Json.deserialize`.

import system;
import system.json;
@json
struct c234_Point {
    public x: int;
    public y: int;
    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@test
@timeout(180000)
fun struct_json(): void {
    let p = c234_Point(3, 4);
    let text = Json.serialize(p);
    Assert.eq_str((text).to_string(), "{\"x\":3,\"y\":4}");                       // {"x":3,"y":4}

    let back = Json.deserialize<c234_Point>(text).unwrap_or(p);
    Assert.eq_str((back.x).to_string(), "3");                     // 3
    Assert.eq_str((back.y).to_string(), "4");                     // 4
}
