import system.testing;
import system;
import system.json;

@json
class c277_Point {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }
}

@json
enum c277_Tags {
    Many(string[]),
    Counts(int[]),
    Points(c277_Point[]),
    Empty,
}

fun c277_body(): void {
    let items = Array.alloc<string>(2);
    items[0] = "a";
    items[1] = "b";
    let m = c277_Tags.Many(items);
    c277_verify_observation((Json.serialize(m)).to_string());
    let m2 = Json.deserialize<c277_Tags>(Json.serialize(m)).unwrap_or(m);
    switch (m2) {
        Many(items) => {
            c277_verify_observation((items.length).to_string());
            c277_verify_observation((items[0]).to_string());
            c277_verify_observation((items[1]).to_string());
        }
        _ => {
            c277_verify_observation(("bad").to_string());
        }
    }

    let nums = Array.alloc<int>(3);
    nums[0] = 1;
    nums[1] = 2;
    nums[2] = 3;
    let c = c277_Tags.Counts(nums);
    c277_verify_observation((Json.serialize(c)).to_string());
    let c2 = Json.deserialize<c277_Tags>(Json.serialize(c)).unwrap_or(c);
    switch (c2) {
        Counts(nums) => {
            c277_verify_observation((nums[0] + nums[1] + nums[2]).to_string());
        }
        _ => {
            c277_verify_observation(("bad").to_string());
        }
    }

    let pts = Array.alloc<c277_Point>(1);
    pts[0] = c277_Point(4, 5);
    let p = c277_Tags.Points(pts);
    c277_verify_observation((Json.serialize(p)).to_string());
    let p2 = Json.deserialize<c277_Tags>(Json.serialize(p)).unwrap_or(p);
    switch (p2) {
        Points(pts) => {
            c277_verify_observation((pts[0].x).to_string());
            c277_verify_observation((pts[0].y).to_string());
        }
        _ => {
            c277_verify_observation(("bad").to_string());
        }
    }
}

let c277_cursor: int = 0;

fun c277_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "{\"type\":\"Many\",\"_0\":[\"a\",\"b\"]}\n2\na\nb\n{\"type\":\"Counts\",\"_0\":[1,2,3]}\n6\n{\"type\":\"Points\",\"_0\":[{\"x\":4,\"y\":5}]}\n4\n5\n";
    let end = c277_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c277_cursor, end));
    c277_cursor = end;
}

@test
@timeout(180000)

fun union_json_arrays(): void {
    c277_cursor = 0;
    c277_body();
    Assert.eq(
        c277_cursor,
        (
            "{\"type\":\"Many\",\"_0\":[\"a\",\"b\"]}\n2\na\nb\n{\"type\":\"Counts\",\"_0\":[1,2,3]}\n6\n{\"type\":\"Points\",\"_0\":[{\"x\":4,\"y\":5}]}\n4\n5\n"
        ).length
    );
}
