import system.testing;
import system;
import system.text;

fun c6e_body(): void {
    switch (char.parse("A")) {
        Ok(v) => c6e_verify_observation((v).to_string()),
        Err(e) => c6e_verify_observation((e.message()).to_string()),
    }
    switch (char.parse("é")) {
        Ok(v) => c6e_verify_observation((v.to_int()).to_string()),
        Err(e) => c6e_verify_observation((e.code()).to_string()),
    }
    switch (char.parse("ab")) {
        Ok(v) => c6e_verify_observation((v).to_string()),
        Err(e) => c6e_verify_observation((e.code()).to_string()),
    }
    switch (char.parse("")) {
        Ok(v) => c6e_verify_observation((v).to_string()),
        Err(e) => c6e_verify_observation((e.code()).to_string()),
    }
}

let c6e_cursor: int = 0;

fun c6e_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "A\n233\nEPARSE\nEPARSE\n";
    let end = c6e_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c6e_cursor, end));
    c6e_cursor = end;
}

@test
@timeout(180000)

fun char_parse(): void {
    c6e_cursor = 0;
    c6e_body();
    Assert.eq(c6e_cursor, ("A\n233\nEPARSE\nEPARSE\n").length);
}
