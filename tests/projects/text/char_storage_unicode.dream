import system.testing;
import system;

public class c6f_CharacterCell {
    public before: byte;
    public value: char;
    public after: int;

    public constructor(value: char) {
        this.before = 123;
        this.value = value;
        this.after = 456;
    }
}

public struct c6f_CharacterValue {
    public before: byte;
    public value: char;
    public after: int;
}

@noinline
fun c6f_read_cell(borrow cell: c6f_CharacterCell): int {
    return (int)cell.value + cell.before + cell.after;
}

@noinline
fun c6f_read_value(value: c6f_CharacterValue): int {
    return (int)value.value + value.before + value.after;
}

@noinline
fun c6f_read_chars(borrow chars: char[]): void {
    let span = Span<char>.of(chars);
    let read_only = span.as_read_only();
    let i = 0;
    while i < span.length {
        c6f_verify_observation(((int)read_only[i]).to_string());
        i = i + 1;
    }
    span.set(1, '界');
    c6f_verify_observation(((int)span[1]).to_string());
}

fun c6f_body(): void {
    let chars = ['Ω', '界', '😀'];
    c6f_read_chars(chars);
    let allocated = Buffer.alloc<char>(2);
    allocated[0] = '😀';
    allocated[1] = 'Ω';
    c6f_read_chars(allocated);
    c6f_verify_observation((c6f_read_cell(c6f_CharacterCell('界'))).to_string());
    let value = c6f_CharacterValue();
    value.before = 123;
    value.value = '😀';
    value.after = 456;
    c6f_verify_observation((c6f_read_value(value)).to_string());
    let list = List<char>();
    list.push('Ω');
    list.push('😀');
    c6f_verify_observation(((int)list[0]).to_string());
    c6f_verify_observation(((int)list[1]).to_string());
}

let c6f_cursor: int = 0;

fun c6f_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "937\n30028\n128512\n30028\n128512\n937\n30028\n30607\n129091\n937\n128512\n";
    let end = c6f_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c6f_cursor, end));
    c6f_cursor = end;
}

@test
@timeout(180000)

fun char_storage_unicode(): void {
    c6f_cursor = 0;
    c6f_body();
    Assert.eq(
        c6f_cursor,
        ("937\n30028\n128512\n30028\n128512\n937\n30028\n30607\n129091\n937\n128512\n").length
    );
}
