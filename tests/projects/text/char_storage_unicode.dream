import system.testing;
import system;
import system.text;

public class c6f_CharacterCell {
    public before: byte;
    public value: char;
    public after: int;

    public constructor(value: char) {
        this.before = 123;
        this.value = value;
        this.after = 456;
    }
}

public struct c6f_CharacterValue {
    public before: byte;
    public value: char;
    public after: int;
}

@noinline
fun c6f_read_cell(borrow cell: c6f_CharacterCell): int {
    return (int)cell.value + cell.before + cell.after;
}

@noinline
fun c6f_read_value(value: c6f_CharacterValue): int {
    return (int)value.value + value.before + value.after;
}

@noinline
fun c6f_read_chars(borrow chars: char[]): string {
    let span = Span<char>.of(chars);
    let read_only = span.as_read_only();
    let out = "";
    let i = 0;
    while i < span.length {
        out = out + ((int)read_only[i]).to_string() + ",";
        i = i + 1;
    }
    span[1] = '界';
    return out + ((int)span[1]).to_string();
}

@test
@timeout(180000)
fun char_storage_unicode(): void {
    Assert.eq('A'.as_string(), "A");
    Assert.eq('界'.as_string(), "界");
    Assert.eq('😀'.as_string(), "😀");
    let chars = ['Ω', '界', '😀'];
    Assert.eq(c6f_read_chars(chars), "937,30028,128512,30028");
    let allocated = Array.alloc<char>(2);
    allocated[0] = '😀';
    allocated[1] = 'Ω';
    Assert.eq(c6f_read_chars(allocated), "128512,937,30028");
    Assert.eq(c6f_read_cell(c6f_CharacterCell('界')), 30607);
    let value = c6f_CharacterValue();
    value.before = 123;
    value.value = '😀';
    value.after = 456;
    Assert.eq(c6f_read_value(value), 129091);
    let list = List<char>();
    list.push('Ω');
    list.push('😀');
    Assert.eq((int)list[0], 937);
    Assert.eq((int)list[1], 128512);
}

@test
@timeout(180000)
fun char_parse(): void {
    Assert.eq(char.parse("A").unwrap().to_string(), "A");
    let accented = char.parse("é").unwrap();
    Assert.eq((int)accented, 233);
    Assert.eq(char.parse("ab").unwrap_err().code(), "EPARSE");
    Assert.eq(char.parse("").unwrap_err().code(), "EPARSE");
    let emoji = char.parse("😀").unwrap();
    Assert.eq((int)emoji, 128512);
    Assert.eq(emoji.to_string(), "😀");
    Assert.eq(char.parse("😀a").unwrap_err().code(), "EPARSE");
}

@test
fun supplementary_char_to_string(): void {
    let emoji = (char)0x1F600;
    Assert.eq(emoji.to_string(), "😀");
    Assert.eq(emoji.to_string().length, 2);
    Assert.eq($"{emoji}!", "😀!");
}

@test
fun out_of_range_char_renders_as_replacement(): void {
    Assert.eq(((char)(-1)).to_string(), "\u{FFFD}");
    Assert.eq(((char)0x110000).to_string(), "\u{FFFD}");
    Assert.eq(((char)0x10FFFF).to_string(), "\u{10FFFF}");
}

@test
fun unicode_escapes_decode_scalars(): void {
    let smile = '\u{1F600}';
    Assert.eq((int)smile, 128512);
    Assert.eq("x\u{1F600}y\u{41}", "x😀yA");
    Assert.eq($"{1}\u{263A}", "1☺");
}

@test
fun supplementary_character_search_and_split(): void {
    let text = "a😀b😀c";
    Assert.eq(text.index_of('😀').unwrap(), 1);
    Assert.eq(text.last_index_of('😀').unwrap(), 4);
    Assert.is_true("ab".index_of('😀').is_none());

    let once = text.split_once('😀');
    Assert.eq(once.length, 2);
    Assert.eq(once[0], "a");
    Assert.eq(once[1], "b😀c");

    let all = text.split('😀');
    Assert.eq(all.length, 3);
    Assert.eq(all[1], "b");
    Assert.eq(all[2], "c");

    let limited = "a😀😀b".split('😀', 2);
    Assert.eq(limited[1], "😀b");

    let pieces = text.span().split_iter('😀');
    Assert.is_true(pieces.move_next());
    Assert.eq(pieces.current.to_string(), "a");
    Assert.is_true(pieces.move_next());
    Assert.eq(pieces.current.to_string(), "b");
    Assert.is_true(pieces.move_next());
    Assert.eq(pieces.current.to_string(), "c");
    Assert.is_false(pieces.move_next());
}

@test
fun supplementary_character_split_in_array_backed_span(): void {
    let chars = ['a', '😀', 'b'];
    let pieces = ReadOnlySpan<char>.of(chars).split_iter('😀');
    Assert.is_true(pieces.move_next());
    Assert.eq(pieces.current.to_string(), "a");
    Assert.is_true(pieces.move_next());
    Assert.eq(pieces.current.to_string(), "b");
    Assert.is_false(pieces.move_next());
}
