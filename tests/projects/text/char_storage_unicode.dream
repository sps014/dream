import system.testing;
import system;
import system.text;

public class c6f_CharacterCell {
    public before: byte;
    public value: char;
    public after: int;

    public constructor(value: char) {
        this.before = 123;
        this.value = value;
        this.after = 456;
    }
}

public struct c6f_CharacterValue {
    public before: byte;
    public value: char;
    public after: int;
}

@noinline
fun c6f_read_cell(borrow cell: c6f_CharacterCell): int {
    return (int)cell.value + cell.before + cell.after;
}

@noinline
fun c6f_read_value(value: c6f_CharacterValue): int {
    return (int)value.value + value.before + value.after;
}

@noinline
fun c6f_read_chars(borrow chars: char[]): string {
    let span = Span<char>.of(chars);
    let read_only = span.as_read_only();
    let out = "";
    let i = 0;
    while i < span.length {
        out = out + ((int)read_only[i]).to_string() + ",";
        i = i + 1;
    }
    span[1] = '界';
    return out + ((int)span[1]).to_string();
}

@test
@timeout(180000)
fun char_storage_unicode(): void {
    let chars = ['Ω', '界', '😀'];
    Assert.eq(c6f_read_chars(chars), "937,30028,128512,30028");
    let allocated = Array.alloc<char>(2);
    allocated[0] = '😀';
    allocated[1] = 'Ω';
    Assert.eq(c6f_read_chars(allocated), "128512,937,30028");
    Assert.eq(c6f_read_cell(c6f_CharacterCell('界')), 30607);
    let value = c6f_CharacterValue();
    value.before = 123;
    value.value = '😀';
    value.after = 456;
    Assert.eq(c6f_read_value(value), 129091);
    let list = List<char>();
    list.push('Ω');
    list.push('😀');
    Assert.eq((int)list[0], 937);
    Assert.eq((int)list[1], 128512);
}

@test
@timeout(180000)
fun char_parse(): void {
    Assert.eq(char.parse("A").unwrap().to_string(), "A");
    let accented = char.parse("é").unwrap();
    Assert.eq((int)accented, 233);
    Assert.eq(char.parse("ab").unwrap_err().code(), "EPARSE");
    Assert.eq(char.parse("").unwrap_err().code(), "EPARSE");
}
