import system.testing;
import system;
import system.encoding;

fun cc4_body(): void {
    let bytes = Encoding.utf8_encode("hi");
    cc4_verify_observation((Encoding.hex_encode(bytes)).to_string());
    switch (Encoding.hex_decode("6869")) {
        Ok(b) => cc4_verify_observation((Encoding.utf8_decode(b)).to_string()),
        Err(e) => cc4_verify_observation((e.message()).to_string()),
    }
    switch (Encoding.hex_decode("xyz")) {
        Ok(b) => cc4_verify_observation(("unexpected").to_string()),
        Err(e) => cc4_verify_observation((e.code()).to_string()),
    }
}

let cc4_cursor: int = 0;

fun cc4_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "6869\nhi\nEPARSE\n";
    let end = cc4_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(cc4_cursor, end));
    cc4_cursor = end;
}

@test
@timeout(180000)

fun encoding_hex(): void {
    cc4_cursor = 0;
    cc4_body();
    Assert.eq(cc4_cursor, ("6869\nhi\nEPARSE\n").length);
}
