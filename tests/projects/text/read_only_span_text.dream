import system.testing;
import system;
import system.collections;

@noinline
fun c1c2_inspect(borrow view: ReadOnlySpan<char>): void {
    c1c2_verify_observation((view.slice(1, 2).to_string()).to_string());
    c1c2_verify_observation((view.index_of('界').unwrap_or(-1)).to_string());
    c1c2_verify_observation((view.hash_code() == "aΩ界b".hash_code()).to_string());
}

fun c1c2_body(): void {
    let chars = ['a', 'Ω', '界', 'b'];
    let array = Span<char>.of(chars).as_read_only();
    let text = ReadOnlySpan<char>.of("aΩ界b");
    c1c2_inspect(array);
    c1c2_inspect(text);
    c1c2_verify_observation((array.sequence_equal(text)).to_string());
    c1c2_verify_observation((array == text).to_string());
    c1c2_verify_observation((array.equals("aΩ界b")).to_string());
    c1c2_verify_observation((array.compare(text)).to_string());
    c1c2_verify_observation((text.slice(1).length).to_string());
    c1c2_verify_observation((array.byte_size()).to_string());
    c1c2_verify_observation((text.byte_size()).to_string());
    let copy = Array.alloc<char>(4);
    text.copy_to(Span<char>.of(copy));
    c1c2_verify_observation((ReadOnlySpan<char>.of(copy).sequence_equal(text)).to_string());
    c1c2_verify_observation(((int)text.to_array()[2]).to_string());
    let joined = StringBuilder();
    joined.append(array.slice(1, 2));
    joined.append(text.slice(1, 2));
    c1c2_verify_observation((joined.to_string()).to_string());
    let keys = Map<string, int>();
    keys["aΩ界b"] = 42;
    c1c2_verify_observation((keys.get(array).unwrap_or(-1)).to_string());
    c1c2_verify_observation((keys.get(text).unwrap_or(-1)).to_string());
    let empty = string.empty.span();
    c1c2_verify_observation((empty.to_array().length).to_string());
    c1c2_verify_observation((empty.slice(0, 0).equals("")).to_string());
    let split = ReadOnlySpan<char>.of(['a', ',', 'b']).split_iter(',');
    while split.move_next() {
        c1c2_verify_observation((split.current.to_string()).to_string());
    }
    let retained = ReadOnlySpan<char>.of(['a', ',', 'b']).split_iter(',');
    retained.move_next();
    let first = retained.current;
    retained.move_next();
    c1c2_verify_observation((first.to_string()).to_string());
    c1c2_verify_observation((retained.current.to_string()).to_string());
    let lines = ReadOnlySpan<char>.of(['x', '\n', 'y']).lines();
    while lines.move_next() {
        c1c2_verify_observation((lines.current.to_string()).to_string());
    }
    c1c2_verify_observation(
        (ReadOnlySpan<char>.of([' ', '-', '4', '2', ' ']).trim().parse_int().unwrap_or(0))
            .to_string()
    );
    let temporary = ("Ω" + System.env_or("DREAM_SPAN_TEXT_SUFFIX", "界")).span();
    c1c2_verify_observation((temporary.to_string()).to_string());
    let offsets = "012345".span(1, 5).slice(1, 2);
    c1c2_verify_observation((offsets.to_string()).to_string());
    let astral = "😀".span();
    c1c2_verify_observation((astral.length).to_string());
    c1c2_verify_observation(((int)astral[0]).to_string());
    c1c2_verify_observation(((int)astral[1]).to_string());
    c1c2_verify_observation(((int)ReadOnlySpan<char>.of(['😀'])[0]).to_string());
}

let c1c2_cursor: int = 0;

fun c1c2_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "Ω界\n2\ntrue\nΩ界\n2\ntrue\ntrue\ntrue\ntrue\n0\n3\n16\n8\ntrue\n30028\nΩ界Ω界\n42\n42\n0\ntrue\na\nb\na\nb\nx\ny\n-42\nΩ界\n23\n2\n55357\n56832\n128512\n";
    let end = c1c2_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c1c2_cursor, end));
    c1c2_cursor = end;
}

@test
@timeout(180000)

fun read_only_span_text(): void {
    c1c2_cursor = 0;
    c1c2_body();
    Assert.eq(
        c1c2_cursor,
        (
            "Ω界\n2\ntrue\nΩ界\n2\ntrue\ntrue\ntrue\ntrue\n0\n3\n16\n8\ntrue\n30028\nΩ界Ω界\n42\n42\n0\ntrue\na\nb\na\nb\nx\ny\n-42\nΩ界\n23\n2\n55357\n56832\n128512\n"
        ).length
    );
}
