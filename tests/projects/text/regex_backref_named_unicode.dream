import system.testing;
import system;
import system.text;

fun c1dd_body(): void {
    let dup = Regex.compile("(\\w+) \\1").unwrap();
    c1dd_verify_observation((dup.test("hello hello")).to_string());
    c1dd_verify_observation((dup.test("hello world")).to_string());
    c1dd_verify_observation((dup.match("the the fox")[0]).to_string());

    let quoted = Regex.compile("(['\"]).*?\\1").unwrap();
    c1dd_verify_observation((quoted.match("say 'hi' now")[0]).to_string());
    c1dd_verify_observation((quoted.match("say \"hi\" now")[0]).to_string());

    let named = Regex.compile("(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})").unwrap();
    let info_opt = named.match_info("2026-08-09");
    switch (info_opt) {
        Some(info) => {
            c1dd_verify_observation((info.full).to_string());
            c1dd_verify_observation((info.named("year").unwrap_or("?")).to_string());
            c1dd_verify_observation((info.named("month").unwrap_or("?")).to_string());
            c1dd_verify_observation((info.named("day").unwrap_or("?")).to_string());
            c1dd_verify_observation((info.named("nope").unwrap_or("none")).to_string());
        },
        None => {
            c1dd_verify_observation(("no match").to_string());
        },
    }

    let repl = Regex.compile("(?<a>\\w+)@(?<b>\\w+)").unwrap();
    c1dd_verify_observation((repl.replace("user@host", "${b}:${a}")).to_string());

    let letters = Regex.compile("\\p{L}+", RegexFlags.Global).unwrap();
    c1dd_verify_observation((letters.match("héllo Wörld123")[0]).to_string());
    c1dd_verify_observation((letters.match("héllo Wörld123")[1]).to_string());

    let numbers = Regex.compile("\\p{N}+").unwrap();
    c1dd_verify_observation((numbers.test("abc123")).to_string());
    c1dd_verify_observation((numbers.match("abc123")[0]).to_string());

    let not_letters = Regex.compile("\\P{L}+").unwrap();
    c1dd_verify_observation((not_letters.match("abc123")[0]).to_string());

    let combo = Regex.compile("(\\w+)-\\1(?=!)").unwrap();
    c1dd_verify_observation((combo.test("go-go!")).to_string());
    c1dd_verify_observation((combo.test("go-go?")).to_string());
}

let c1dd_cursor: int = 0;

fun c1dd_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "true\nfalse\nthe the\n'hi'\n\"hi\"\n2026-08-09\n2026\n08\n09\nnone\nhost:user\nhéllo\nWörld\ntrue\n123\n123\ntrue\nfalse\n";
    let end = c1dd_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c1dd_cursor, end));
    c1dd_cursor = end;
}

@test
@timeout(180000)

fun regex_backref_named_unicode(): void {
    c1dd_cursor = 0;
    c1dd_body();
    Assert.eq(
        c1dd_cursor,
        (
            "true\nfalse\nthe the\n'hi'\n\"hi\"\n2026-08-09\n2026\n08\n09\nnone\nhost:user\nhéllo\nWörld\ntrue\n123\n123\ntrue\nfalse\n"
        ).length
    );
}
