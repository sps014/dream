import system.testing;
import system;
import system.text;

@test
@timeout(180000)
fun regex_groups_alternation(): void {
    let date = Regex("(\\d{4})-(\\d{2})-(\\d{2})");
    let caps = date.match("2026-08-04");
    Assert.eq_str((caps.length).to_string(), "4");
    Assert.eq_str((caps[0]).to_string(), "2026-08-04");
    Assert.eq_str((caps[1]).to_string(), "2026");
    Assert.eq_str((caps[2]).to_string(), "08");
    Assert.eq_str((caps[3]).to_string(), "04");

    let alt = Regex("(?:cat|dog)s?");
    Assert.eq_str((alt.test("I have dogs")).to_string(), "true");
    Assert.eq_str((alt.test("I have a cat")).to_string(), "true");
    Assert.eq_str((alt.test("I have a fish")).to_string(), "false");

    let nested = Regex("((a)(b))c");
    let ncaps = nested.match("abc");
    Assert.eq_str((ncaps.length).to_string(), "4");
    Assert.eq_str((ncaps[0]).to_string(), "abc");
    Assert.eq_str((ncaps[1]).to_string(), "ab");
    Assert.eq_str((ncaps[2]).to_string(), "a");
    Assert.eq_str((ncaps[3]).to_string(), "b");

    // An alternative that isn't taken leaves its group unset ("").
    let optional_branch = Regex("(a)|(b)");
    let ob = optional_branch.match("b");
    Assert.eq_str((ob.length).to_string(), "3");
    Assert.eq_str((ob[0]).to_string(), "b");
    Assert.eq_str((ob[1]).to_string(), "");
    Assert.eq_str((ob[2]).to_string(), "b");

    // Malformed patterns (unterminated group/class) never crash.
    let unterminated_group = Regex("(abc");
    Assert.eq_str((unterminated_group.test("abc")).to_string(), "false");
    let unterminated_class = Regex("[abc");
    Assert.eq_str((unterminated_class.test("b")).to_string(), "false");
}
