import system.testing;
import system;

@test
@timeout(180000)
fun string_empty(): void {
    let a = string.empty;
    let blank = "";
    let b = blank.substring(0, 0);
    let c = string.from_utf8(Buffer.alloc<byte>(0));
    let d = "hello" + string.empty;
    let e = string.empty + "world";
    let x = "x";
    Assert.eq_str((a.length).to_string(), "0");
    Assert.eq_str((a.is_empty()).to_string(), "true");
    Assert.eq_str((b == a).to_string(), "true");
    Assert.eq_str((c == a).to_string(), "true");
    Assert.eq_str((d).to_string(), "hello");
    Assert.eq_str((e).to_string(), "world");
    Assert.eq_str((x.repeat(0) == string.empty).to_string(), "true");
}
