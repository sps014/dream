import system.testing;
// `s[i] = c` via `@set_indexer` on `extend string` (in-place UTF-8 write).

import system;
import system.text;

fun c21a_body() {
    // Concat allocates a fresh heap buffer — do not mutate interned literals.
    let s = "hel" + "lo";
    s[0] = 'H';
    s[4] = 'O';
    c21a_verify_observation((s).to_string());
    c21a_verify_observation((s[0]).to_string());
    c21a_verify_observation((s[4]).to_string());
}

let c21a_cursor: int = 0;

fun c21a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "HellO\nH\nO\n";
    let end = c21a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c21a_cursor, end));
    c21a_cursor = end;
}

@test
@timeout(180000)

fun string_index_set(): void {
    c21a_cursor = 0;
    c21a_body();
    Assert.eq(c21a_cursor, ("HellO\nH\nO\n").length);
}
