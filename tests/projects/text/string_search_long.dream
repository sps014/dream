import system.testing;
import system;

fun c220_body(): void {
    let h = " ".repeat(2048);
    let n = " ".repeat(256);
    for (let i = 0; i < h.length; i = i + 1) {
        h[i] = 'a';
    }
    for (let i = 0; i < n.length; i = i + 1) {
        n[i] = 'a';
    }
    n[255] = 'b';
    c220_verify_observation((h.span().index_of(n).unwrap_or(-1)).to_string());
    h[2047] = 'b';
    c220_verify_observation((h.span().index_of(n).unwrap_or(-1)).to_string());
    c220_verify_observation((h.span(23, 2048).index_of(n, -10).unwrap_or(-1)).to_string());
    c220_verify_observation((h.span().index_of(n, 1793).unwrap_or(-1)).to_string());
    c220_verify_observation((h.span().index_of(n, 2147483647).unwrap_or(-1)).to_string());
    c220_verify_observation((h.span().index_of("", 2048).unwrap_or(-1)).to_string());
    c220_verify_observation((h.span().index_of("", 2049).unwrap_or(-1)).to_string());
    let observed = h.span();
    h[2047] = 'a';
    c220_verify_observation((observed.index_of(n).unwrap_or(-1)).to_string());
    let binary = " ".repeat(96);
    for (let i = 0; i < binary.length; i = i + 1) {
        binary[i] = (char)(i & 1);
    }
    let binary_needle = binary.substring(32, 96);
    c220_verify_observation((binary.span().index_of(binary_needle, 1).unwrap_or(-1)).to_string());
    let unicode = " ".repeat(256);
    for (let i = 0; i < unicode.length; i = i + 1) {
        unicode[i] = (char)(55296 + (i & 1) * 1024);
    }
    let unicode_needle = unicode.substring(128, 192);
    c220_verify_observation(
        (unicode.span(1, 255).index_of(unicode_needle).unwrap_or(-1)).to_string()
    );
    unicode[1] = (char)0;
    c220_verify_observation((unicode.span().index_of(unicode_needle).unwrap_or(-1)).to_string());
}

let c220_cursor: int = 0;

fun c220_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "-1\n1792\n1769\n-1\n-1\n2048\n-1\n-1\n2\n1\n2\n";
    let end = c220_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c220_cursor, end));
    c220_cursor = end;
}

@test
@timeout(180000)

fun string_search_long(): void {
    c220_cursor = 0;
    c220_body();
    Assert.eq(c220_cursor, ("-1\n1792\n1769\n-1\n-1\n2048\n-1\n-1\n2\n1\n2\n").length);
}
