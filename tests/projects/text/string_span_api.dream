import system.testing;
import system;
import system.collections;

@test
@timeout(180000)
fun string_span_api(): void {
    let s = "  hello, world ,a,,b  ";
    let v = s.span();
    Assert.eq(v.length, 22);
    let t = v.trim();
    Assert.eq(t.to_string() + "|", "hello, world ,a,,b|");
    Assert.is_true(t.starts_with("hello"));
    Assert.is_true(t.ends_with("b"));
    Assert.eq(t.index_of(',').unwrap_or(-1), 5);
    Assert.eq(t.index_of("world").unwrap_or(-1), 7);
    Assert.eq(t.last_index_of(',').unwrap_or(-1), 16);
    Assert.is_true(t.slice(0, 5).equals("hello"));
    Assert.is_true(t.slice(0, 5) == "xhello".span(1, 6));
    Assert.eq(s.span(-3, 100).length, 22);

    let parts = List<string>();
    let it = t.split_iter(',');
    while it.move_next() {
        parts.push("[" + it.current.trim().to_string() + "]");
    }
    Assert.eq(parts.join(""), "[hello][world][a][][b]");

    let dashed = List<string>();
    let it2 = "a--b--c".span().split_iter("--");
    while it2.move_next() {
        dashed.push(it2.current.to_string());
    }
    Assert.eq(dashed.join(","), "a,b,c");

    let lines = List<string>();
    let ls = "one\r\ntwo\nthree\n".span().lines();
    while ls.move_next() {
        lines.push("<" + ls.current.to_string() + ">");
    }
    Assert.eq(lines.join(""), "<one><two><three>");

    Assert.eq("-42".span().parse_int().unwrap_or(0), -42);
    Assert.eq("x12".span(1, 3).parse_int().unwrap_or(0), 12);
    Assert.is_true("hello".span().hash_code() == "hello".hash_code());
    Assert.is_true("xhellox".span(1, 6).hash_code() == "hello".hash_code());
    Assert.is_true("abc".span().compare("abd") < 0);
}

// `span(start, end)` clamps out-of-range bounds like `substring`; `slice` and `char_at` trap.
@test
@timeout(180000)
fun string_span_clamp(): void {
    let s = "hello world";
    let min: int = -2147483647 - 1;
    Assert.eq(s.span(-5, 3).to_string() + "|", "hel|");
    Assert.eq(s.span(6, 100).to_string() + "|", "world|");
    Assert.eq(s.span(8, 2).length, 0);
    Assert.eq(s.span(min, 2147483647).length, 11);
    Assert.eq(s.span(min, -1).length, 0);
    Assert.eq(s.span(2147483647, min).length, 0);
    let w = s.span(6, 11);
    Assert.eq(w.slice(1, 4).to_string(), "orl");
    Assert.eq(w.slice(3).to_string(), "ld");
    Assert.is_true(w.slice(0, 5).equals("world"));
    Assert.is_false(w.is_empty());
    Assert.is_true(s.span(3, 3).is_empty());
    Assert.is_true("".span().split_iter(',').move_next());
    Assert.eq("   ".span().trim().length, 0);
    Assert.is_true("12x".span().parse_int().is_err());
}

let c227_order: int = 0;

fun c227_text(): string {
    c227_order = c227_order * 10 + 1;
    return "hello";
}

fun c227_other_text(): string {
    c227_order = c227_order * 10 + 2;
    return "hello";
}

@test
@timeout(180000)
fun string_span_equality(): void {
    let span = "xhelloy".span(1, 6);
    Assert.is_true(span == "hello");
    Assert.is_true("hello" == span);
    Assert.is_false(span != "hello");
    Assert.is_false("hello" != span);
    Assert.is_false(span == "world");
    Assert.is_false("world" == span);
    Assert.is_true(span != "world");
    Assert.is_true("world" != span);
    Assert.is_true(span == "hello".span());
    Assert.is_true(span != "world".span());
    Assert.is_true("".span() == "");
    Assert.is_true("" == "x".span(0, 0));
    Assert.is_true("🙂é".span() == "🙂é");
    Assert.is_true("🙂é" == "x🙂éy".span(1, 4));
    Assert.is_true("🙂é".span() != "🙂e");
    Assert.is_true("same" == "same");
    Assert.is_true("same" != "different");
    Assert.is_true(span.equals("hello"));

    c227_order = 0;
    Assert.is_true(c227_text() == c227_other_text().span());
    Assert.eq(c227_order, 12);
    c227_order = 0;
    Assert.is_false(c227_text().span() != c227_other_text());
    Assert.eq(c227_order, 12);
}

@test
@timeout(180000)
fun string_span_map_lookup(): void {
    let m = Map<string, int>();
    m["apple"] = 1;
    m["pear"] = 2;
    let text = "apple,pear,plum";
    let seen = List<string>();
    let it = text.span().split_iter(',');
    while it.move_next() {
        let k = it.current;
        seen.push(
            k.to_string()
                + "="
                + m.get(k).unwrap_or(-1).to_string()
                + " "
                + m.contains(k).to_string()
                + " "
                + m.get(k).unwrap_or(0).to_string()
        );
    }
    Assert.eq(seen.join(";"), "apple=1 true 1;pear=2 true 2;plum=-1 false 0");
    Assert.eq(m.get("pear").unwrap_or(0), 2);
    let s = Set<string>();
    s.add("x");
    Assert.is_true(s.contains("axb".span(1, 2)));
    Assert.is_false(s.contains("ab".span(1, 2)));
}

@test
@timeout(180000)
fun string_search_long(): void {
    let h = " ".repeat(2048);
    let n = " ".repeat(256);
    for (let i = 0; i < h.length; i = i + 1) {
        h[i] = 'a';
    }
    for (let i = 0; i < n.length; i = i + 1) {
        n[i] = 'a';
    }
    n[255] = 'b';
    Assert.eq(h.span().index_of(n).unwrap_or(-1), -1);
    h[2047] = 'b';
    Assert.eq(h.span().index_of(n).unwrap_or(-1), 1792);
    Assert.eq(h.span(23, 2048).index_of(n, -10).unwrap_or(-1), 1769);
    Assert.eq(h.span().index_of(n, 1793).unwrap_or(-1), -1);
    Assert.eq(h.span().index_of(n, 2147483647).unwrap_or(-1), -1);
    Assert.eq(h.span().index_of("", 2048).unwrap_or(-1), 2048);
    Assert.eq(h.span().index_of("", 2049).unwrap_or(-1), -1);
    let observed = h.span();
    h[2047] = 'a';
    Assert.eq(observed.index_of(n).unwrap_or(-1), -1);
    let binary = " ".repeat(96);
    for (let i = 0; i < binary.length; i = i + 1) {
        binary[i] = (char)(i & 1);
    }
    let binary_needle = binary.substring(32, 96);
    Assert.eq(binary.span().index_of(binary_needle, 1).unwrap_or(-1), 2);
    let unicode = " ".repeat(256);
    for (let i = 0; i < unicode.length; i = i + 1) {
        unicode[i] = (char)(55296 + (i & 1) * 1024);
    }
    let unicode_needle = unicode.substring(128, 192);
    Assert.eq(unicode.span(1, 255).index_of(unicode_needle).unwrap_or(-1), 1);
    unicode[1] = (char)0;
    Assert.eq(unicode.span().index_of(unicode_needle).unwrap_or(-1), 2);
}
