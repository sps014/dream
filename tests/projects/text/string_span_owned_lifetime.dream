import system.testing;
import system;

@noinline
fun c22d_owned_views(borrow suffix: string): int {
    let source = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" + suffix;
    let sum = 0;
    let i = 0;
    while i < 8 {
        let start = i & 7;
        let view = source.span(start, start + 25 + (i & 3));
        sum = sum + view.length + (int)view[0];
        i = i + 1;
    }
    return sum;
}

@noinline
fun c22d_replaced_owner(borrow suffix: string): void {
    let source = "hello " + suffix;
    let view = source.span(0, 5);
    source = "changed " + suffix;
    c22d_verify_observation((view.to_string()).to_string());
    c22d_verify_observation((source.span(0, 7).to_string()).to_string());
}

fun c22d_loop_owner(): void {
    let saved = "".span();
    let i = 0;
    while i < 3 {
        let source = "first " + i.to_string();
        if i == 0 {
            saved = source.span(0, 5);
        } else {
            c22d_verify_observation((saved[0]).to_string());
        }
        i = i + 1;
    }
}

fun c22d_body(): void {
    c22d_verify_observation((c22d_owned_views("!")).to_string());
    c22d_replaced_owner("world");
    c22d_loop_owner();
}

let c22d_cursor: int = 0;

fun c22d_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "1016\nhello\nchanged\nf\nf\n";
    let end = c22d_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c22d_cursor, end));
    c22d_cursor = end;
}

@test
@timeout(180000)

fun string_span_owned_lifetime(): void {
    c22d_cursor = 0;
    c22d_body();
    Assert.eq(c22d_cursor, ("1016\nhello\nchanged\nf\nf\n").length);
}
