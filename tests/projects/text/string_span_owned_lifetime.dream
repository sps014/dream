import system.testing;
import system;

@noinline
fun c22d_owned_views(borrow suffix: string): int {
    let source = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789" + suffix;
    let sum = 0;
    let i = 0;
    while i < 8 {
        let start = i & 7;
        let view = source.span(start, start + 25 + (i & 3));
        sum = sum + view.length + (int)view[0];
        i = i + 1;
    }
    return sum;
}

@noinline
fun c22d_replaced_owner(borrow suffix: string): void {
    let source = "hello " + suffix;
    let view = source.span(0, 5);
    source = "changed " + suffix;
    Assert.eq(view.to_string(), "hello");
    Assert.eq(source.span(0, 7).to_string(), "changed");
}

fun c22d_loop_owner(): void {
    let saved = "".span();
    let i = 0;
    while i < 3 {
        let source = "first " + i.to_string();
        if i == 0 {
            saved = source.span(0, 5);
        } else {
            Assert.eq(saved[0], 'f');
        }
        i = i + 1;
    }
}

@test
@timeout(180000)
fun string_span_owned_lifetime(): void {
    Assert.eq(c22d_owned_views("!"), 1016);
    c22d_replaced_owner("world");
    c22d_loop_owner();
}

// Release builds inline the span producers below, turning `dest = call` into copies out of
// inliner temporaries; each must still hand its references to the destination exactly once.
@noinline
fun sio_saved_view(): int {
    let saved = "".span();
    let i = 0;
    let n = 0;
    while i < 3 {
        let source = "first " + i.to_string();
        if i == 0 {
            saved = source.span(0, 5);
        } else {
            n = n + (int)saved[0];
        }
        i = i + 1;
    }
    return n;
}

@noinline
fun sio_split_array(): int {
    let split = ReadOnlySpan<char>.of(['a', ',', 'b']).split_iter(',');
    let n = 0;
    while split.move_next() {
        n = n + split.current.length;
    }
    return n;
}

@noinline
fun sio_lines_array(): int {
    let lines = ReadOnlySpan<char>.of(['x', '\n', 'y']).lines();
    let n = 0;
    while lines.move_next() {
        n = n + lines.current.length;
    }
    return n;
}

@test
@timeout(180000)
fun span_inlined_ownership(): void {
    let before = Debug.live_objects;
    Assert.eq(sio_saved_view(), 204);
    Assert.eq(sio_split_array(), 2);
    Assert.eq(sio_lines_array(), 2);
    Assert.eq(Debug.live_objects - before, 0);
}

@noinline
fun c225_scan(borrow suffix: string): int {
    let source = "abcdefghijklmnopqrstuvwxyz" + suffix;
    let other = "ABCDEFGHIJKLMNOPQRSTUVWXYZ" + suffix;
    let sum = 0;
    let i = 0;
    while i < 100 {
        let view = source.span(i & 7, 20);
        sum = sum + (int)view[0];
        let second = other.span(i & 7, 20);
        sum = sum + (int)second[0];
        i = i + 1;
    }
    let sliced = source.substring(2, 20);
    i = 0;
    while i < 100 {
        let view = sliced.span(i & 3, 8);
        sum = sum + (int)view[0];
        i = i + 1;
    }
    return sum;
}

@test
@timeout(180000)
fun string_span_borrowed_loop(): void {
    Assert.eq(c225_scan(System.env("DREAM_SPAN_SUFFIX").unwrap_or("!")), 26934);
}

// The span's uses live in a synchronous helper, so no span is in scope at the `await`.
fun c224_head_length(s: string): int {
    let v = s.span(0, 2).trim();
    return v.length;
}

async fun c224_run(s: string): int {
    let n = c224_head_length(s);
    Time.sleep(1).await;
    return n + 1;
}

@test
@timeout(180000)
async fun string_span_await_ok(): void {
    Assert.eq(c224_run(" bc").await, 2);
}
