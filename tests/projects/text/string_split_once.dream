import system.testing;
// `split_once` splits at the first occurrence into exactly two parts; a miss yields `[this]`
// (never empty), matching `split`'s whole-string fallback.

import system;
import system.text;

fun c22e_print_parts(parts: string[]): void {
    c22e_verify_observation((parts.length.to_string() + ":" + parts.join("|")).to_string());
}

fun c22e_body(): void {
    let hit = "k=v=w".split_once("=");
    c22e_verify_observation((hit[0] + "," + hit[1]).to_string());
    c22e_print_parts("no-separator".split_once("-"));
    c22e_print_parts("a-b-c".split_once('-'));
    c22e_print_parts("miss".split_once('?'));
    c22e_print_parts("leading-x".split_once("leading-"));
}

let c22e_cursor: int = 0;

fun c22e_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "k,v=w\n2:no|separator\n2:a|b-c\n1:miss\n2:|x\n";
    let end = c22e_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c22e_cursor, end));
    c22e_cursor = end;
}

@test
@timeout(180000)

fun string_split_once(): void {
    c22e_cursor = 0;
    c22e_body();
    Assert.eq(c22e_cursor, ("k,v=w\n2:no|separator\n2:a|b-c\n1:miss\n2:|x\n").length);
}
