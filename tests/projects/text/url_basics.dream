import system.net;
import system.testing;

@test
fun url_basics(): void {
    Assert.eq(
        Url.parse("data:text/plain,hello ?#").unwrap().to_string(),
        "data:text/plain,hello%20?#"
    );
    Assert.eq(
        Url.parse("data:text/plain,hello  ?x").unwrap().to_string(),
        "data:text/plain,hello %20?x"
    );

    let base = Url.parse("HTTPS://ExAmPle.COM:443/a/../v1/?role=reader&role=editor#fragment")
        .unwrap();
    Assert.eq(base.scheme, "https");
    Assert.eq(base.host, "example.com");
    Assert.eq(base.path, "/v1/");
    Assert.eq(base.to_string(), "https://example.com/v1/?role=reader&role=editor#fragment");
    Assert.eq(base.query.length, 2);
    Assert.eq(base.query.get("role").unwrap(), "reader");
    let roles = base.query.get_all("role");
    Assert.eq(roles.length, 2);
    Assert.eq(roles[1], "editor");
    let users = base.resolve("users?name=Jane+Doe&plus=%2B#").unwrap();
    Assert.eq(users.query.get("name").unwrap(), "Jane Doe");
    Assert.eq(users.query.get("plus").unwrap(), "+");
    users.query.append("role", "admin");
    users.query.append("role", "editor");
    Assert.eq(
        users.to_string(),
        "https://example.com/v1/users?name=Jane+Doe&plus=%2b&role=admin&role=editor#"
    );
    users.query.set("role", "two words");
    Assert.eq(users.query.get_all("role").length, 1);
    Assert.eq(users.query.get("role").unwrap(), "two words");
    users.query.remove("name");
    Assert.is_true(users.query.get("name").is_none());
    users.query.clear();
    Assert.eq(users.to_string(), "https://example.com/v1/users#");
    Assert.eq(
        Url.parse("https://example.com/?#").unwrap().to_string(),
        "https://example.com/?#"
    );
    Assert.eq(Url.parse("https://bücher.example/こんにちは").unwrap().host, "xn--bcher-kva.example");
    Assert.eq(Url.parse("https://[::1]:443/").unwrap().host, "[::1]");
    Assert.eq(
        Url.parse("data:text/plain,hello%20?#").unwrap().to_string(),
        "data:text/plain,hello%20?#"
    );
    Assert.is_true(Url.parse("relative").is_err());
    Assert.is_true(Url.parse("https://[bad").is_err());
    Assert.is_true(Url.parse("mailto:a@example.com").unwrap().resolve("relative").is_err());
}
