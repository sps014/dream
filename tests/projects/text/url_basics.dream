import system.net;
import system.testing;

@test
fun url_basics(): void {
    Assert.eq(
        Url.parse("data:text/plain,hello ?#").unwrap().to_string(),
        "data:text/plain,hello%20?#"
    );
    Assert.eq(
        Url.parse("data:text/plain,hello  ?x").unwrap().to_string(),
        "data:text/plain,hello %20?x"
    );

    let base = Url.parse("HTTPS://ExAmPle.COM:443/a/../v1/?role=reader&role=editor#fragment")
        .unwrap();
    Assert.eq(base.scheme, "https");
    Assert.eq(base.host, "example.com");
    Assert.eq(base.path, "/v1/");
    Assert.eq(base.to_string(), "https://example.com/v1/?role=reader&role=editor#fragment");
    Assert.eq(base.query.length, 2);
    Assert.eq(base.query.get("role").unwrap(), "reader");
    let roles = base.query.get_all("role");
    Assert.eq(roles.length, 2);
    Assert.eq(roles[1], "editor");
    let users = base.resolve("users?name=Jane+Doe&plus=%2B#").unwrap();
    Assert.eq(users.query.get("name").unwrap(), "Jane Doe");
    Assert.eq(users.query.get("plus").unwrap(), "+");
    users.query.append("role", "admin");
    users.query.append("role", "editor");
    Assert.eq(
        users.to_string(),
        "https://example.com/v1/users?name=Jane+Doe&plus=%2b&role=admin&role=editor#"
    );
    users.query.set("role", "two words");
    Assert.eq(users.query.get_all("role").length, 1);
    Assert.eq(users.query.get("role").unwrap(), "two words");
    users.query.remove("name");
    Assert.is_true(users.query.get("name").is_none());
    users.query.clear();
    Assert.eq(users.to_string(), "https://example.com/v1/users#");
    Assert.eq(
        Url.parse("https://example.com/?#").unwrap().to_string(),
        "https://example.com/?#"
    );
    Assert.eq(Url.parse("https://bücher.example/こんにちは").unwrap().host, "xn--bcher-kva.example");
    Assert.eq(Url.parse("https://[::1]:443/").unwrap().host, "[::1]");
    Assert.eq(
        Url.parse("data:text/plain,hello%20?#").unwrap().to_string(),
        "data:text/plain,hello%20?#"
    );
    Assert.is_true(Url.parse("relative").is_err());
    Assert.is_true(Url.parse("https://[bad").is_err());
    Assert.is_true(Url.parse("mailto:a@example.com").unwrap().resolve("relative").is_err());
}

@test
fun url_standard_parsing(): void {
    let parsed = [
        "http://0x7f.1/", "http://127.0.0.1/",
        "http://[0:0:0:0:0:0:0:1]/", "http://[::1]/",
        "http://[::ffff:192.168.0.1]/", "http://[::ffff:c0a8:1]/",
        "http://[1:0:0:2:0:0:0:3]/", "http://[1:0:0:2::3]/",
        "http://user:pa ss@host/", "http://user:pa%20ss@host/",
        "http://a@b@host/", "http://a%40b@host/",
        "http://h:80/", "http://h/",
        "http://h:0080/x", "http://h/x",
        "http:\\\\h\\a\\b", "http://h/a/b",
        "https://h/a b/{x}/^", "https://h/a%20b/%7Bx%7D/%5E",
        "file:///C|/x", "file:///C:/x",
        "file://localhost/etc", "file:///etc",
        "file:c:\\x\\..\\..\\y", "file:///c:/y",
        "foo://h/a/../b", "foo://h/b",
        "web+demo:/.//p", "web+demo:/.//p",
        "https://h/?a'b", "https://h/?a%27b",
        "foo:/?a'b", "foo:/?a'b",
        "https://h/# x", "https://h/#%20x",
        "https://h/é", "https://h/%C3%A9",
        " \tht\ttp://H/\n ", "http://h/",
        "HTTP://EXAMPLE.com./", "http://example.com./",
        "http://h/%2e%2E/a/./b/..", "http://h/a/",
        "sc://ñ/x", "sc://%C3%B1/x",
        "http://ex%41mple.com/", "http://example.com/",
    ];
    for (let i = 0; i < parsed.length; i = i + 2) {
        Assert.eq(Url.parse(parsed[i]).unwrap().to_string(), parsed[i + 1]);
    }
    let resolved = [
        "?q", "https://h/a/b?x#y", "https://h/a/b?q",
        "#f", "https://h/a/b?x#y", "https://h/a/b?x#f",
        "//other/x", "https://h/a/b", "https://other/x",
        "../../../x", "https://h/a/b", "https://h/x",
        "", "https://h/a/b?x#y", "https://h/a/b?x",
        "/abs", "https://u:p@h:8080/a", "https://u:p@h:8080/abs",
        "x", "file:///C:/a/b", "file:///C:/a/x",
        "/x", "file:///C:/a/b", "file:///C:/x",
        "#z", "mailto:a@b.c", "mailto:a@b.c#z",
    ];
    for (let i = 0; i < resolved.length; i = i + 3) {
        let base = Url.parse(resolved[i + 1]).unwrap();
        Assert.eq(base.resolve(resolved[i]).unwrap().to_string(), resolved[i + 2]);
    }
    let invalid = [
        "http://1.2.3.4.5/",
        "http://256.0.0.1/",
        "http://h:65536/",
        "http://a b/",
        "http://[::1",
        "http://@/",
        "http://h:x/",
        "http://%41%/",
        "https://",
    ];
    for let input in invalid {
        Assert.is_true(Url.parse(input).is_err());
    }
}

@test
async fun http_types(): void {
    let headers = HttpHeaders();
    headers.append("X-Role", "reader");
    headers.append("x-role", "editor");
    Assert.eq(headers.length, 2);
    Assert.eq(headers.get("X-ROLE").unwrap(), "reader");
    Assert.eq(headers.get_all("x-role").length, 2);
    headers.set("X-ROLE", "admin");
    Assert.eq(headers.length, 1);
    headers.remove("x-role");
    Assert.is_true(headers.get("x-role").is_none());
    let request = HttpRequest(HttpMethod.Get, Url.parse("https://example.com/").unwrap());
    let client = HttpClient();
    let cancelled = CancellationSource();
    cancelled.cancel();
    Assert.eq(
        client.send(request, token: Option.Some(cancelled.token)).await.unwrap_err().code(),
        "ECANCELLED"
    );
    Assert.eq(
        client.send(request, options: HttpOptions(timeout_ms: 0 - 1)).await.unwrap_err().code(),
        "EINVAL"
    );
    let invalid = HttpRequest(HttpMethod.Get, Url.parse("file:///tmp/input").unwrap());
    Assert.eq(client.send(invalid).await.unwrap_err().code(), "EINVAL");
    request.set_text("not valid for GET");
    Assert.eq(client.send(request).await.unwrap_err().code(), "EINVAL");
    client.close().unwrap();
    client.close().unwrap();
    Assert.eq(client.send(request).await.unwrap_err().code(), "ECLOSED");
    Assert.is_true(HttpCapabilities.redirect_limits);
    Assert.is_true(HttpCapabilities.unrestricted_headers);
}
