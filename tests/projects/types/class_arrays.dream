import system.testing;
import system;

class c70_Point<T> {
    public x: T;
    public y: T;

    public constructor(x: T, y: T) {
        this.x = x;
        this.y = y;
    }
}

class c70_Pixel {
    public r: int;
    public g: int;

    public constructor(r: int, g: int) {
        this.r = r;
        this.g = g;
    }
}

@test
@timeout(180000)
fun class_arrays() {
    let pts: c70_Point<int>[] = [c70_Point<int>(1, 2), c70_Point<int>(3, 4)];
    Assert.eq_str((pts.length).to_string(), "2");
    Assert.eq_str((pts[0].x).to_string(), "1");
    Assert.eq_str((pts[1].y).to_string(), "4");

    let px: c70_Pixel[] = [c70_Pixel(10, 20)];
    Assert.eq_str((px[0].r).to_string(), "10");
    Assert.eq_str((px[0].g).to_string(), "20");
}
