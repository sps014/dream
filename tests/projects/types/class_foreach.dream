import system.testing;
// A user class opting into `for let x in obj` via the enumerator protocol: `iterator()`
// returns an object whose `next(): Option<T>` yields elements until `None`. Exercises `break`
// and `continue` inside the loop body.

import system;
class c75_RangeIter {
    current: int;
    end: int;

    public constructor(start: int, end: int) {
        this.current = start;
        this.end = end;
    }

    public fun next(): Option<int> {
        if this.current >= this.end {
            return Option.None;
        }
        let v = this.current;
        this.current = this.current + 1;
        return Option.Some(v);
    }
}

class c75_Range {
    start: int;
    end: int;

    public constructor(start: int, end: int) {
        this.start = start;
        this.end = end;
    }

    public fun iterator(): c75_RangeIter {
        return c75_RangeIter(this.start, this.end);
    }
}

fun c75_body() {
    let total = 0;
    for (let x in c75_Range(0, 6)) {
        if x == 2 { continue; }   // skip 2
        if x == 5 { break; }      // stop before 5
        total = total + x;
    }
    c75_verify_observation((total).to_string());          // 0 + 1 + 3 + 4 = 8

    for (let y in c75_Range(10, 13)) {
        c75_verify_observation((y).to_string());          // 10, 11, 12
    }
}

let c75_cursor: int = 0;

fun c75_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "8\n10\n11\n12\n";
    let end = c75_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c75_cursor, end));
    c75_cursor = end;
}

@test
@timeout(180000)

fun class_foreach(): void {
    c75_cursor = 0;
    c75_body();
    Assert.eq(c75_cursor, ("8\n10\n11\n12\n").length);
}
