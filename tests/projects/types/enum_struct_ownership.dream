import system.testing;
// Ownership of reference payloads inside inline (`enum struct`) unions: pattern bindings keep the
// union alive, a switch over an inlined call result, a moved-on-one-path `take` parameter, and a
// discarded call result must neither free early nor leak.
import system;

class cc7_Note {
    public text: string;

    public constructor(text: string) {
        this.text = text;
    }

    public fun shout(): string {
        return this.text + "!";
    }
}

enum struct cc7_Res {
    Ok(int),
    Err(cc7_Note),
}

enum struct cc7_Tag {
    Named(string),
    Boxed(cc7_Note),
    Blank,
}

fun cc7_fail(): cc7_Res {
    return cc7_Res.Err(cc7_Note("boom" + 1.to_string()));
}

fun cc7_pass(): cc7_Res {
    return cc7_Res.Ok(7);
}

fun cc7_describe_fail(): string {
    return switch (cc7_fail()) {
        Ok(v) => v.to_string(),
        Err(n) => n.text,
    };
}

fun cc7_describe_pass(): string {
    return switch (cc7_pass()) {
        Ok(v) => v.to_string(),
        Err(n) => n.text,
    };
}

fun cc7_wrap(ok: bool, t: cc7_Tag): Result<cc7_Tag, string> {
    if ok {
        return Result.Ok(t);
    }
    return Result.Err("no");
}

fun cc7_countdown(n: int): cc7_Res {
    if n <= 0 {
        return cc7_Res.Err(cc7_Note("done" + n.to_string()));
    }
    return cc7_countdown(n - 1);
}

fun cc7_body(): void {
    let r = cc7_fail();
    switch (r) {
        Ok(_) => {
            cc7_verify_observation(("unexpected").to_string());
        }
        Err(n) => {
            let filler = cc7_Note("filler" + 2.to_string());
            cc7_verify_observation((n.shout()).to_string());
            cc7_verify_observation((filler.text).to_string());
            cc7_verify_observation((n.shout()).to_string());
        }
    }

    cc7_verify_observation((cc7_describe_fail()).to_string());
    cc7_verify_observation((cc7_describe_pass()).to_string());

    let a = cc7_Tag.Named("a" + 3.to_string());
    let a2 = cc7_wrap(true, a).unwrap_or(cc7_Tag.Blank);
    cc7_verify_observation((a2).to_string());
    let b = cc7_Tag.Boxed(cc7_Note("b" + 4.to_string()));
    let b2 = cc7_wrap(false, b).unwrap_or(cc7_Tag.Blank);
    cc7_verify_observation((b2).to_string());

    cc7_countdown(3);
    cc7_verify_observation(("end").to_string());
}

let cc7_cursor: int = 0;

fun cc7_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "boom1!\nfiller2\nboom1!\nboom1\n7\nNamed(a3)\nBlank\nend\n";
    let end = cc7_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(cc7_cursor, end));
    cc7_cursor = end;
}

@test
@timeout(180000)

fun enum_struct_ownership(): void {
    cc7_cursor = 0;
    cc7_body();
    Assert.eq(cc7_cursor, ("boom1!\nfiller2\nboom1!\nboom1\n7\nNamed(a3)\nBlank\nend\n").length);
}
