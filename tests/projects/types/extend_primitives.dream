import system.testing;
import system;

extend int {
    public fun doubled(): int {
        return this * 2;
    }
}

@test
@timeout(180000)
fun extend_primitives(): void {
    let n: int = -7;
    Assert.eq((n.abs()).to_string(), "7"); // 7  (prelude extend)
    Assert.eq((n.doubled()).to_string(), "-14"); // -14 (user extend)

    let s: string = "hello";
    Assert.eq((s.length).to_string(), "5"); // 5  (prelude extend)
}
