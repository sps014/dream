import system.testing;
// A generic function constrained with `T : Comparable<T>` may call the interface's `compare` on its
// type parameter. Because Dream monomorphizes generics, the constrained call binds to the concrete
// type's method (static dispatch, no boxing).
import system;

class ce1_Money: Comparable<ce1_Money> {
    public cents: int;

    public constructor(cents: int) {
        this.cents = cents;
    }

    public fun compare(other: ce1_Money): int {
        return this.cents - other.cents;
    }
}

fun ce1_max_of<T: Comparable<T>>(a: T, b: T): T {
    if a.compare(b) > 0 {
        return a;
    }
    return b;
}

fun ce1_body(): void {
    let bigger = ce1_max_of(ce1_Money(100), ce1_Money(250));
    ce1_verify_observation((bigger.cents).to_string()); // 250

    let smaller = ce1_max_of(ce1_Money(40), ce1_Money(15));
    ce1_verify_observation((smaller.cents).to_string()); // 40
}

let ce1_cursor: int = 0;

fun ce1_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "250\n40\n";
    let end = ce1_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(ce1_cursor, end));
    ce1_cursor = end;
}

@test
@timeout(180000)

fun generic_constraints(): void {
    ce1_cursor = 0;
    ce1_body();
    Assert.eq(ce1_cursor, ("250\n40\n").length);
}
