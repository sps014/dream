import system.testing;
// A generic function can be used as a first-class value: its type arguments are inferred from the
// expected function type at the use site, and the instance is monomorphized like any other generic
// call. Constraints (`T : Comparable<T>`) are enforced against the inferred type.
import system;

fun ce3_natural_order<T: Comparable<T>>(a: T, b: T): int {
    return a.compare(b);
}

fun ce3_apply_cmp(cmp: fun(int, int): int, a: int, b: int): int {
    return cmp(a, b);
}

@test
@timeout(180000)
fun generic_fn_value(): void {
    let f: fun(int, int): int = ce3_natural_order;
    Assert.eq_str((ce3_apply_cmp(f, 3, 9)).to_string(), "-1"); // -1
    Assert.eq_str((ce3_apply_cmp(f, 9, 3)).to_string(), "1"); // 1
    Assert.eq_str((ce3_apply_cmp(f, 4, 4)).to_string(), "0"); // 0
}
