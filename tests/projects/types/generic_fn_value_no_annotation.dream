import system.testing;
// A generic function used as a first-class value can be bound without a fun(...) annotation;
// each later use instantiates from context or call-argument types.
import system;

fun ce4_natural_order<T: Comparable<T>>(a: T, b: T): int {
    return a.compare(b);
}

@test
@timeout(180000)
fun generic_fn_value_no_annotation(): void {
    let f = ce4_natural_order;
    Assert.eq((f(3, 1)).to_string(), "1");
    let g: fun(int, int): int = f;
    Assert.eq((g(1, 2)).to_string(), "-1");
}
