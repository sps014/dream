import system.testing;
import system;

class ce5_B {
    public value: string;
    public constructor(value: string) {
        this.value = value;
    }
}

class ce5_A<T> {
    public value: T;
    public constructor(value: T) {
        this.value = value;
    }
}

class ce5_A_B {
    public value: int;
    public constructor(value: int) {
        this.value = value;
    }
}

class ce5_Box<T> {
    public value: T;
    public constructor(value: T) {
        this.value = value;
    }
}

@test
@timeout(180000)
fun generic_identity_collision(): void {
    let flat = ce5_Box<ce5_A_B>(ce5_A_B(17));
    let nested = ce5_Box<ce5_A<ce5_B>>(ce5_A<ce5_B>(ce5_B("second")));
    Assert.eq_str((flat.value.value).to_string(), "17");
    Assert.eq_str((nested.value.value.value).to_string(), "second");
}
