import system.testing;
// Generic interface default methods: a default body is inherited by implementers of a *generic*
// interface, with the interface's type parameter substituted from the `implements` clause. `Box<T>`
// keeps it generic (T is the class's own parameter, monomorphized per instantiation); `IntBox` binds
// it to `int`. `firstOr`'s signature uses the type parameter (`fallback: T`), so it exercises the
// signature substitution; `count` does not.
import system;

interface ce6_Container<T> {
    fun get(): T;
    public fun firstOr(fallback: T): T {
        return this.get();
    }

    public fun count(): int {
        return 1;
    }
}

class ce6_Box<T>: ce6_Container<T> {
    public value: T;
    public constructor(value: T) {
        this.value = value;
    }

    public fun get(): T {
        return this.value;
    }
}

class ce6_IntBox: ce6_Container<int> {
    public value: int;
    public constructor(value: int) {
        this.value = value;
    }

    public fun get(): int {
        return this.value;
    }
}

@test
@timeout(180000)
fun generic_interface_default(): void {
    let b = ce6_Box<int>(7);
    Assert.eq_str((b.firstOr(9)).to_string(), "7");
    Assert.eq_str((b.count()).to_string(), "1");

    let a = ce6_IntBox(42);
    Assert.eq_str((a.firstOr(9)).to_string(), "42");
    Assert.eq_str((a.count()).to_string(), "1");
}
