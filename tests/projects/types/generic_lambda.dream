import system.testing;
// Generic lambdas declare their own type parameters and instantiate from context or use.
import system;

@test
@timeout(180000)
fun generic_lambda(): void {
    let id: fun(int): int = < T >(x: T) => x;
    Assert.eq((id(42)).to_string(), "42");

    let poly = < T >(x: T) => x;
    let as_string: fun(string): string = poly;
    Assert.eq((as_string("hi")).to_string(), "hi");
}
