import system.testing;
// Static methods on a generic class are dispatchable by supplying the class type arguments on the
// receiver: `Pair<int>.of(...)`. The class is monomorphized and the concrete static method called.
import system;

class ce9_Pair<T> {
    public a: int;
    public b: int;

    public constructor(a: int, b: int) {
        this.a = a;
        this.b = b;
    }

    public static fun of(a: int, b: int): ce9_Pair<T> {
        return ce9_Pair<T>(a, b);
    }

    public fun sum(): int {
        return this.a + this.b;
    }
}

@test
@timeout(180000)
fun generic_static_method(): void {
    let p = ce9_Pair<int>.of(3, 4);
    Assert.eq((p.sum()).to_string(), "7");

    let q = ce9_Pair<int>.of(10, 20);
    Assert.eq((q.sum()).to_string(), "30");
}
