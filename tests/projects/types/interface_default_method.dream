import system.testing;
// Interface default methods: `greet` has a default body that classes inherit when they omit it.
// The default calls another interface method (`name`) on `this`, which dispatches to the concrete
// implementation. `Robot` overrides the default; `Person` inherits it.
import system;

interface c100_Greeter {
    fun name(): string;
    fun greet(): string {
        return "Hello, I am " + this.name();
    }
}

class c100_Person: c100_Greeter {
    public fun name(): string {
        return "Ada";
    }
}

class c100_Robot: c100_Greeter {
    public fun name(): string {
        return "R2";
    }

    // Overrides the default.
    public fun greet(): string {
        return "BEEP " + this.name();
    }
}

// Interface-typed parameter dispatches `greet` dynamically: the default for Person, the override
// for Robot.
fun c100_announce(g: c100_Greeter): void {
    c100_verify_observation((g.greet()).to_string());
}

fun c100_body(): void {
    c100_announce(c100_Person());
    c100_announce(c100_Robot());
}

let c100_cursor: int = 0;

fun c100_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "Hello, I am Ada\nBEEP R2\n";
    let end = c100_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c100_cursor, end));
    c100_cursor = end;
}

@test
@timeout(180000)

fun interface_default_method(): void {
    c100_cursor = 0;
    c100_body();
    Assert.eq(c100_cursor, ("Hello, I am Ada\nBEEP R2\n").length);
}
