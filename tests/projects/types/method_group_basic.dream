import system.testing;
import system;

class c150_Counter {
    public value: int;

    public constructor(start: int) {
        this.value = start;
    }

    public fun increment(): void {
        this.value = this.value + 1;
    }

    public fun addTo(n: int): int {
        return this.value + n;
    }
}

fun c150_apply(f: fun(int): int, v: int): int {
    return f(v);
}

fun c150_run(f: fun(): void): void {
    f();
}

@test
@timeout(180000)
fun method_group_basic(): void {
    let counter = c150_Counter(10);

    // Instance method group used directly where a `fun(int): int` value is expected.
    Assert.eq_str((c150_apply(counter.addTo, 5)).to_string(), "15");

    // Instance method group with no args/return, called through a `fun(): void` parameter.
    let inc: fun(): void = counter.increment;
    c150_run(inc);
    c150_run(inc);
    Assert.eq_str((counter.value.to_string()).to_string(), "12");

    // Static method group.
    let sq: fun(int): int = c150_Counter.square;
    Assert.eq_str((sq(6)).to_string(), "36");
}

extend c150_Counter {
    public static fun square(x: int): int {
        return x * x;
    }
}
