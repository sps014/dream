import system.testing;
// An array literal in an array-typed context takes that element type rather than its first
// element's, so heterogeneous `object` collections build from a literal and box their scalars.
import system;

@test
@timeout(180000)
fun object_array_literal() {
    let mixed: object[] = [1, "s", true];
    Assert.eq_str(
        (mixed[0].to_string() + "," + mixed[1].to_string() + "," + mixed[2].to_string()).to_string(),
        "1,s,true"
    );

    let strings: object[] = ["a", "b"];
    Assert.eq_str((strings.length.to_string()).to_string(), "2");

    let list: List<object> = [1, "two"];
    Assert.eq_str((list.length.to_string()).to_string(), "2");

    let map: Map<string, object> = {
        "a": 1, "b": "s"
    };
    Assert.eq_str((map.length.to_string()).to_string(), "2");

    // Numeric widening through the same path still applies.
    let widened: double[] = [1.0, 2.0];
    Assert.eq_str((widened[1].to_string()).to_string(), "2");
}
