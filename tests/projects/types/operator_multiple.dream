import system.testing;
import system;

class c17c_Number {
    public value: int;

    public constructor(value: int) {
        this.value = value;
    }

    fun operator +(other: long): long {
        return (long)100 + other;
    }

    fun operator +(other: int): int {
        return this.value + other;
    }

    fun operator +(other: c17c_Number): int {
        return this.value + other.value;
    }

    fun operator ==(other: c17c_Number): bool {
        return this.value == other.value;
    }

    fun operator ==(other: int): bool {
        return this.value == other;
    }

    fun operator -(): int {
        return -this.value;
    }

    fun operator -(other: int): int {
        return this.value - other;
    }

    fun operator -(other: long): long {
        return (long)100 - other;
    }
}

class c17c_Generic<T> {
    public value: T;

    public constructor(value: T) {
        this.value = value;
    }

    fun operator ==(other: c17c_Generic<T>): bool {
        return this.value == other.value;
    }

    fun operator ==(other: T): bool {
        return this.value == other;
    }
}

extend c17c_Number {
    fun operator *(other: int): int {
        return this.value * other;
    }

    fun operator *(other: c17c_Number): int {
        return this.value * other.value;
    }

    fun operator /(other: double): double {
        return (double)this.value / other;
    }
}

extend int {
    fun operator +(other: c17c_Number): int {
        return this + other.value;
    }
}

@test
@timeout(180000)
fun operator_multiple(): void {
    let n = c17c_Number(6);
    let l: long = 2;
    let f: float = 2.0;
    Assert.eq_str((n + 2).to_string(), "8");
    Assert.eq_str((n + l).to_string(), "102");
    Assert.eq_str((n + c17c_Number(4)).to_string(), "10");
    Assert.eq_str((5 + n).to_string(), "11");
    Assert.eq_str((n == 6).to_string(), "true");
    Assert.eq_str((n != 6).to_string(), "false");
    Assert.eq_str((n == c17c_Number(6)).to_string(), "true");
    Assert.eq_str((n != c17c_Number(4)).to_string(), "true");
    Assert.eq_str((-n).to_string(), "-6");
    Assert.eq_str((n - 2).to_string(), "4");
    Assert.eq_str((n - l).to_string(), "98");
    Assert.eq_str((n * 2).to_string(), "12");
    Assert.eq_str((n * c17c_Number(3)).to_string(), "18");
    Assert.eq_str((n / f).to_string(), "3");
    Assert.eq_str((c17c_Generic<int>(6) == 6).to_string(), "true");
    Assert.eq_str((c17c_Generic<int>(6) != c17c_Generic<int>(7)).to_string(), "true");
    Assert.eq_str((c17c_Generic<string>("same") == "same").to_string(), "true");
    Assert.eq_str(
        (c17c_Generic<string>("same") == c17c_Generic<string>("same")).to_string(),
        "true"
    );
    Assert.eq_str(("value=" + n.value).to_string(), "value=6");
}
