import system.testing;
import system;

class c177_Bits {
    public value: int;

    public constructor(value: int) {
        this.value = value;
    }

    fun operator %(other: int): int {
        return this.value % other;
    }

    fun operator %(other: c177_Bits): int {
        return this.value % other.value;
    }

    fun operator &(other: int): int {
        return this.value & other;
    }

    fun operator &(other: c177_Bits): int {
        return this.value & other.value;
    }

    fun operator |(other: int): int {
        return this.value | other;
    }

    fun operator |(other: c177_Bits): int {
        return this.value | other.value;
    }

    fun operator ^(other: int): int {
        return this.value ^ other;
    }

    fun operator ^(other: c177_Bits): int {
        return this.value ^ other.value;
    }

    fun operator <<(other: int): int {
        return this.value << other;
    }

    fun operator <<(other: c177_Bits): int {
        return this.value << other.value;
    }

    fun operator >>(other: int): int {
        return this.value >> other;
    }

    fun operator >>(other: c177_Bits): int {
        return this.value >> other.value;
    }
}

class c17c_Number {
    public value: int;

    public constructor(value: int) {
        this.value = value;
    }

    fun operator +(other: long): long {
        return (long)100 + other;
    }

    fun operator +(other: int): int {
        return this.value + other;
    }

    fun operator +(other: c17c_Number): int {
        return this.value + other.value;
    }

    fun operator ==(other: c17c_Number): bool {
        return this.value == other.value;
    }

    fun operator ==(other: int): bool {
        return this.value == other;
    }

    fun operator -(): int {
        return -this.value;
    }

    fun operator -(other: int): int {
        return this.value - other;
    }

    fun operator -(other: long): long {
        return (long)100 - other;
    }
}

class c17c_Generic<T> {
    public value: T;

    public constructor(value: T) {
        this.value = value;
    }

    fun operator ==(other: c17c_Generic<T>): bool {
        return this.value == other.value;
    }

    fun operator ==(other: T): bool {
        return this.value == other;
    }
}

extend c17c_Number {
    fun operator *(other: int): int {
        return this.value * other;
    }

    fun operator *(other: c17c_Number): int {
        return this.value * other.value;
    }

    fun operator /(other: double): double {
        return (double)this.value / other;
    }
}

extend int {
    fun operator +(other: c17c_Number): int {
        return this + other.value;
    }
}

class c17e_Vector2 {
    public x: int;
    public y: int;

    public constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }

    fun operator +(other: c17e_Vector2): c17e_Vector2 {
        return c17e_Vector2(this.x + other.x, this.y + other.y);
    }

    fun operator -(other: c17e_Vector2): c17e_Vector2 {
        return c17e_Vector2(this.x - other.x, this.y - other.y);
    }

    fun explicit(): string {
        return "(" + this.x + ", " + this.y + ")";
    }
}

class c17e_Money: Comparable<c17e_Money> {
    public cents: int;

    public constructor(cents: int) {
        this.cents = cents;
    }

    fun compare(other: c17e_Money): int {
        return this.cents - other.cents;
    }

    fun implicit(): int {
        return this.cents;
    }
}

@test
@timeout(180000)
fun operator_all_symbols(): void {
    let b = c177_Bits(10);
    Assert.eq((b % 3).to_string(), "1");
    Assert.eq((b % c177_Bits(3)).to_string(), "1");
    Assert.eq((b & 3).to_string(), "2");
    Assert.eq((b & c177_Bits(3)).to_string(), "2");
    Assert.eq((b | 3).to_string(), "11");
    Assert.eq((b | c177_Bits(3)).to_string(), "11");
    Assert.eq((b ^ 3).to_string(), "9");
    Assert.eq((b ^ c177_Bits(3)).to_string(), "9");
    Assert.eq((b << 3).to_string(), "80");
    Assert.eq((b << c177_Bits(3)).to_string(), "80");
    Assert.eq((b >> 3).to_string(), "1");
    Assert.eq((b >> c177_Bits(3)).to_string(), "1");
}

@test
@timeout(180000)
fun operator_multiple(): void {
    let n = c17c_Number(6);
    let l: long = 2;
    let f: float = 2.0;
    Assert.eq((n + 2).to_string(), "8");
    Assert.eq((n + l).to_string(), "102");
    Assert.eq((n + c17c_Number(4)).to_string(), "10");
    Assert.eq((5 + n).to_string(), "11");
    Assert.eq((n == 6).to_string(), "true");
    Assert.eq((n != 6).to_string(), "false");
    Assert.eq((n == c17c_Number(6)).to_string(), "true");
    Assert.eq((n != c17c_Number(4)).to_string(), "true");
    Assert.eq((-n).to_string(), "-6");
    Assert.eq((n - 2).to_string(), "4");
    Assert.eq((n - l).to_string(), "98");
    Assert.eq((n * 2).to_string(), "12");
    Assert.eq((n * c17c_Number(3)).to_string(), "18");
    Assert.eq((n / f).to_string(), "3");
    Assert.eq((c17c_Generic<int>(6) == 6).to_string(), "true");
    Assert.eq((c17c_Generic<int>(6) != c17c_Generic<int>(7)).to_string(), "true");
    Assert.eq((c17c_Generic<string>("same") == "same").to_string(), "true");
    Assert.eq(
        (c17c_Generic<string>("same") == c17c_Generic<string>("same")).to_string(),
        "true"
    );
    Assert.eq(("value=" + n.value).to_string(), "value=6");
}

@test
@timeout(180000)
fun operator_overloading(): void {
    let a = c17e_Vector2(1, 2);
    let b = c17e_Vector2(3, 4);

    let sum = a + b;
    Assert.eq((sum.x).to_string(), "4");
    Assert.eq((sum.y).to_string(), "6");

    let diff = a - b;
    Assert.eq((diff.x).to_string(), "-2");
    Assert.eq((diff.y).to_string(), "-2");

    Assert.eq(((string)a).to_string(), "(1, 2)");

    let cheap = c17e_Money(10);
    let pricey = c17e_Money(20);
    Assert.eq((cheap < pricey).to_string(), "true");
    Assert.eq((cheap > pricey).to_string(), "false");
    Assert.eq((cheap <= c17e_Money(10)).to_string(), "true");

    let cents: int = cheap;
    Assert.eq((cents).to_string(), "10");
}
