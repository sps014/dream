import system.testing;
// Receiver modes are inferred from bodies: reads-only = borrow, writes/mutating-calls = unique.
// This golden proves that mixed methods compile and behave correctly without any annotations.

import system;

public class c1c9_IntStack {
    items: int[];
    count: int;
    public constructor() {
        this.items = Buffer.alloc<int>(16);
        this.count = 0;
    }
    public fun push(v: int): void {
        if this.count == this.items.length { return; }
        this.items[this.count] = v;
        this.count = this.count + 1;
    }
    public fun peek(): int { return this.items[this.count - 1]; }
    public fun depth(): int { return this.count; }
}

fun c1c9_body(): void {
    let s = c1c9_IntStack();
    s.push(10);
    s.push(20);
    c1c9_verify_observation((s.peek().to_string()).to_string());
    c1c9_verify_observation((s.depth().to_string()).to_string());
}

let c1c9_cursor: int = 0;

fun c1c9_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "20\n2\n";
    let end = c1c9_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1c9_cursor, end));
    c1c9_cursor = end;
}

@test
@timeout(180000)

fun receiver_mode_inference(): void {
    c1c9_cursor = 0;
    c1c9_body();
    Assert.eq(c1c9_cursor, ("20\n2\n").length);
}
