import system.testing;
import system;

fun c1ca_increment(ref x: int): void {
    x = x + 1;
}

@test
@timeout(180000)
fun ref_array_element(): void {
    let arr: int[] = [1, 2, 3];
    c1ca_increment(ref arr[0]);
    Assert.eq_str((arr[0]).to_string(), "2");
    Assert.eq_str((arr[1]).to_string(), "2");
}
