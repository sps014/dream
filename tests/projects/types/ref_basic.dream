import system.testing;
// `ref` parameters: the callee shares the caller's storage instead of receiving a copy. A local or
// parameter passed by `ref` (but never closure-captured, see `ref_closure_capture.dream`) is given
// its own private stack slot via the shadow-stack frame value-struct locals already use — no heap
// allocation, no reference counting.
import system;

fun c1cb_swap(ref a: int, ref b: int): void {
    let tmp: int = a;
    a = b;
    b = tmp;
}

fun c1cb_increment(ref x: int): void {
    x = x + 1;
}

fun c1cb_add_to_both(ref a: int, b: int): int {
    a = a + b;
    return a;
}

@test
@timeout(180000)
fun ref_basic(): void {
    let p: int = 1;
    let q: int = 2;
    c1cb_swap(ref p, ref q);
    Assert.eq_str((p).to_string(), "2"); // 2
    Assert.eq_str((q).to_string(), "1"); // 1

    c1cb_increment(ref p);
    Assert.eq_str((p).to_string(), "3"); // 3

    let sum: int = c1cb_add_to_both(ref p, 10);
    Assert.eq_str((sum).to_string(), "13"); // 13
    Assert.eq_str((p).to_string(), "13"); // 13
}
