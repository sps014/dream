import system.testing;
// `ref` on instance/static method parameters: the implicit `this` is unaffected, `ref` applies to
// the explicit parameter list exactly like a free function.

import system;
struct c1d1_Doubler {
    public constructor() {}

    public fun apply(ref x: int): void {
        x = x * 2;
    }

    public static fun apply_static(ref x: int): void {
        x = x * 2;
    }
}

@test
@timeout(180000)
fun ref_method(): void {
    let d: c1d1_Doubler = c1d1_Doubler();
    let n: int = 5;
    d.apply(ref n);
    Assert.eq_str((n).to_string(), "10"); // 10

    c1d1_Doubler.apply_static(ref n);
    Assert.eq_str((n).to_string(), "20"); // 20
}
