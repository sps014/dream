import system.testing;
// `ref struct` is a stack-only value type: it behaves exactly like an ordinary value `struct` for
// locals, parameters, and returns (inline storage, copy semantics, no heap allocation) - the only
// difference is the compiler additionally rejects any use that would let it escape the current
// stack frame (see `ref_struct_*_escape.dream`).
import system;

ref struct c1d5_Pair {
    public a: int;
    public b: int;

    public constructor(a: int, b: int) {
        this.a = a;
        this.b = b;
    }
}

fun c1d5_sum(p: c1d5_Pair): int {
    return p.a + p.b;
}

fun c1d5_swapped(p: c1d5_Pair): c1d5_Pair {
    return c1d5_Pair(p.b, p.a);
}

fun c1d5_body(): void {
    let p = c1d5_Pair(3, 4);
    c1d5_verify_observation((c1d5_sum(p)).to_string()); // 7

    let s = c1d5_swapped(p);
    c1d5_verify_observation((s.a).to_string()); // 4
    c1d5_verify_observation((s.b).to_string()); // 3

    // Copying a `ref struct` copies its bytes inline, same as any other value struct.
    let copy = p;
    c1d5_verify_observation((c1d5_sum(copy)).to_string()); // 7
}

let c1d5_cursor: int = 0;

fun c1d5_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "7\n4\n3\n7\n";
    let end = c1d5_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1d5_cursor, end));
    c1d5_cursor = end;
}

@test
@timeout(180000)

fun ref_struct_basic(): void {
    c1d5_cursor = 0;
    c1d5_body();
    Assert.eq(c1d5_cursor, ("7\n4\n3\n7\n").length);
}
