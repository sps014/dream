import system.testing;
import system;
public struct c1da_P {
    public x: double;
    public y: double;
}
fun c1da_set(ref p: c1da_P): void {
    p.x = 1.5;
    p.y = 2.5;
    c1da_verify_observation(("set").to_string());
    c1da_verify_observation(("set").to_string());
    c1da_verify_observation(("set").to_string());
    c1da_verify_observation(("set").to_string());
}
fun c1da_wrap(ref p: c1da_P): void {
    c1da_set(ref p);
}
fun c1da_body(): void {
    let p = c1da_P();
    c1da_wrap(ref p);
    c1da_verify_observation((p.x).to_string());
}

let c1da_cursor: int = 0;

fun c1da_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "set\nset\nset\nset\n1.5\n";
    let end = c1da_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c1da_cursor, end));
    c1da_cursor = end;
}

@test
@timeout(180000)

fun ref_value_inline_passthrough(): void {
    c1da_cursor = 0;
    c1da_body();
    Assert.eq(c1da_cursor, ("set\nset\nset\nset\n1.5\n").length);
}
