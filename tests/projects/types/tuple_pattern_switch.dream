import system.testing;
import system;

fun c26b_body() {
    let p: (int, int) = (0, 9);
    let n = switch (p) {
        (0, x) => x,
        (_, _) => -1,
    };
    c26b_verify_observation((n).to_string());
    let q: (int, int) = (3, 4);
    c26b_verify_observation(
        (
            switch (q) {
                (0, x) => x,
                (_, y) => y
            }
        ).to_string()
    );
}

let c26b_cursor: int = 0;

fun c26b_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "9\n4\n";
    let end = c26b_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c26b_cursor, end));
    c26b_cursor = end;
}

@test
@timeout(180000)

fun tuple_pattern_switch(): void {
    c26b_cursor = 0;
    c26b_body();
    Assert.eq(c26b_cursor, ("9\n4\n").length);
}
