import system.testing;
// `typeof(x)` on an `object` or interface operand reads the value's runtime heap tag, so a boxed
// dynamic reports what it actually holds and an interface slot reports the implementing class.
import system;

interface c270_Shape {
    fun area(): int;
}

class c270_Circle: c270_Shape {
    public fun area(): int {
        return 3;
    }
}

class c270_Square: c270_Shape {
    public fun area(): int {
        return 4;
    }
}

@test
@timeout(180000)
fun typeof_dynamic() {
    // A boxed primitive reports its payload type, not "object".
    let n: object = 5;
    let g: long = 9;
    let big: object = g;
    let f: object = 2.5;
    let dbl: double = 2.5;
    let wide: object = dbl;
    let flag: object = true;
    let text: object = "hello";
    Assert.eq((typeof(n)).to_string(), "int");
    Assert.eq((typeof(big)).to_string(), "long");
    Assert.eq((typeof(f)).to_string(), "float");
    Assert.eq((typeof(wide)).to_string(), "double");
    Assert.eq((typeof(flag)).to_string(), "bool");
    Assert.eq((typeof(text)).to_string(), "string");

    // Arrays share one runtime tag, so the element type is not recoverable.
    let arr: object = [1, 2, 3];
    Assert.eq((typeof(arr)).to_string(), "array");

    // A class instance held as `object` reports its own name.
    let boxed: object = c270_Circle();
    Assert.eq((typeof(boxed)).to_string(), "c270_Circle");

    // An interface-typed slot reports the implementing class.
    let s: c270_Shape = c270_Square();
    Assert.eq((typeof(s)).to_string(), "c270_Square");

    // A generic instantiation held as `object` reports its source spelling.
    let m: Map<string, int> = {
        "a": 1
    };
    let anymap: object = m;
    Assert.eq((typeof(anymap)).to_string(), "Map<string, int>");
}
