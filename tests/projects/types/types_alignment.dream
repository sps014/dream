import system.testing;
import system;

class c272_Mixed {
    public b1: bool;
    public i1: int;
    public d1: double;
    public b2: bool;

    public constructor(b1: bool, i1: int, d1: double, b2: bool) {
        this.b1 = b1;
        this.i1 = i1;
        this.d1 = d1;
        this.b2 = b2;
    }
}

fun c272_body(): void {
    let m = c272_Mixed(true, 42, 3.14159d, false);

    if m.b1 {
        c272_verify_observation((m.i1).to_string());
    }

    c272_verify_observation((m.d1).to_string());

    m.d1 = 2.718d;
    c272_verify_observation((m.d1).to_string());
}

let c272_cursor: int = 0;

fun c272_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "42\n3.14159\n2.718\n";
    let end = c272_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c272_cursor, end));
    c272_cursor = end;
}

@test
@timeout(180000)

fun types_alignment(): void {
    c272_cursor = 0;
    c272_body();
    Assert.eq(c272_cursor, ("42\n3.14159\n2.718\n").length);
}
