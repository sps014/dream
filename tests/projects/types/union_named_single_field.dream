import system.testing;
import system;
import system.json;

@json
enum c279_Box {
    Full(value: int),
    Empty,
}

@json
enum c279_Pair {
    Pos(int),
    Named(x: int),
}

fun c279_take_box(b: c279_Box): int {
    return switch (b) {
        Full(v) => v,
        Empty => 0,
    };
}

fun c279_take_pair(p: c279_Pair): int {
    return switch (p) {
        Pos(n) => n,
        Named(n) => n,
    };
}

fun c279_body(): void {
    let a = c279_Box.Full(7);
    let b = c279_Box.Full(value: 9);
    c279_verify_observation((c279_take_box(a)).to_string());
    c279_verify_observation((c279_take_box(b)).to_string());
    c279_verify_observation((Json.serialize(a)).to_string());
    c279_verify_observation((c279_take_pair(c279_Pair.Pos(1))).to_string());
    c279_verify_observation((c279_take_pair(c279_Pair.Named(x: 2))).to_string());
    c279_verify_observation((Json.serialize(c279_Pair.Pos(3))).to_string());
    c279_verify_observation((Json.serialize(c279_Pair.Named(4))).to_string());
}

let c279_cursor: int = 0;

fun c279_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "7\n9\n{\"type\":\"Full\",\"value\":7}\n1\n2\n{\"type\":\"Pos\",\"_0\":3}\n{\"type\":\"Named\",\"x\":4}\n";
    let end = c279_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c279_cursor, end));
    c279_cursor = end;
}

@test
@timeout(180000)

fun union_named_single_field(): void {
    c279_cursor = 0;
    c279_body();
    Assert.eq(
        c279_cursor,
        (
            "7\n9\n{\"type\":\"Full\",\"value\":7}\n1\n2\n{\"type\":\"Pos\",\"_0\":3}\n{\"type\":\"Named\",\"x\":4}\n"
        ).length
    );
}
