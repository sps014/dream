import system.testing;
// Nested patterns: a variant whose payload is itself a union, matched with sub-patterns and a
// literal guard inside the nesting.

// `Option<T>` comes from the standard library prelude.
import system;

enum c27a_Pair {
    Both(left: Option<int>, right: Option<int>),
    Neither,
}

// `Both(...)` is covered by refutable nested patterns, so a `_` arm is required for
// exhaustiveness (v1 does not enumerate inner variants); `Neither` is covered explicitly.
fun c27a_classify(p: c27a_Pair): string {
    return switch (p) {
        Both(Some(0), None) => "zero-left, empty-right",
        Both(Some(x), Some(y)) => "two values",
        Both(None, None) => "both empty",
        Neither => "neither",
        _ => "other",
    };
}

fun c27a_body() {
    let a: Option<int> = Option.Some(0);
    let b: Option<int> = Option.Some(5);
    let n: Option<int> = Option.None;

    c27a_verify_observation((c27a_classify(c27a_Pair.Both(a, n))).to_string());
    c27a_verify_observation((c27a_classify(c27a_Pair.Both(b, b))).to_string());
    c27a_verify_observation((c27a_classify(c27a_Pair.Both(n, n))).to_string());
    c27a_verify_observation((c27a_classify(c27a_Pair.Neither)).to_string());
    c27a_verify_observation((c27a_classify(c27a_Pair.Both(b, n))).to_string());
}

let c27a_cursor: int = 0;

fun c27a_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "zero-left, empty-right\ntwo values\nboth empty\nneither\nother\n";
    let end = c27a_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq_str(actual, wanted.substring(c27a_cursor, end));
    c27a_cursor = end;
}

@test
@timeout(180000)

fun union_nested(): void {
    c27a_cursor = 0;
    c27a_body();
    Assert.eq(
        c27a_cursor,
        ("zero-left, empty-right\ntwo values\nboth empty\nneither\nother\n").length
    );
}
