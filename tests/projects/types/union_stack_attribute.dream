import system.testing;
// `enum struct` is a checked contract: registration errors out unless the union qualifies as a
// value union (every payload value/primitive, or any number of non-self-referential
// reference-typed payloads). When every payload is already value/primitive, `enum struct` has no
// representational effect beyond the contract. With a reference payload (as below), `enum struct`
// is what opts the union into the inline representation.
import system;

enum struct c27e_Outcome {
    Success(int),
    Failure(code: int, reason: string),
}

fun c27e_describe(o: c27e_Outcome): string {
    return switch (o) {
        Success(c) => "ok:" + c.to_string(),
        Failure(c, r) => "fail:" + c.to_string() + ":" + r,
    };
}

fun c27e_body(): void {
    let s: c27e_Outcome = c27e_Outcome.Success(0);
    let f: c27e_Outcome = c27e_Outcome.Failure(1, "disk full");
    c27e_verify_observation((c27e_describe(s)).to_string()); // ok:0
    c27e_verify_observation((c27e_describe(f)).to_string()); // fail:1:disk full
}

let c27e_cursor: int = 0;

fun c27e_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "ok:0\nfail:1:disk full\n";
    let end = c27e_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c27e_cursor, end));
    c27e_cursor = end;
}

@test
@timeout(180000)

fun union_stack_attribute(): void {
    c27e_cursor = 0;
    c27e_body();
    Assert.eq(c27e_cursor, ("ok:0\nfail:1:disk full\n").length);
}
