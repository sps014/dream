import system.testing;
import system;

struct c28f_View {
    public source: string;
    public count: int;

    public constructor(borrow source: string, count: int) {
        if count < 0 || count > source.length {
            System.panic("invalid view");
        }
        this.source = source;
        this.count = count;
    }
}

@noinline
fun c28f_read(borrow view: c28f_View): string {
    let copy = view;
    return copy.source.substring(0, copy.count);
}

@noinline
fun c28f_span_sum(borrow span: Span<int>): int {
    let sum = 0;
    for (let x in span) {
        sum = sum + x;
    }
    return sum;
}

@noinline
fun c28f_span_text(borrow span: ReadOnlySpan<char>): bool {
    let copy = span;
    return copy == "number=42";
}

fun c28f_body(): void {
    let source = "number=" + 42;
    let view = c28f_View(source, 6);
    c28f_verify_observation((c28f_read(view)).to_string());
    c28f_verify_observation((c28f_read(view)).to_string());
    c28f_verify_observation((view.source).to_string());
    let xs = [1, 2, 3, 4, 5];
    let span = Span<int>(xs, 1, 3);
    c28f_verify_observation((c28f_span_sum(span)).to_string());
    c28f_verify_observation((c28f_span_sum(span)).to_string());
    c28f_verify_observation((span.length).to_string());
    c28f_verify_observation((c28f_span_text(source.span())).to_string());
    c28f_verify_observation((source).to_string());
}

let c28f_cursor: int = 0;

fun c28f_verify_observation(borrow value: string): void {
    let actual = value + "\n";
    let wanted = "number\nnumber\nnumber=42\n9\n9\n3\ntrue\nnumber=42\n";
    let end = c28f_cursor + actual.length;
    Assert.is_true(end <= wanted.length);
    Assert.eq(actual, wanted.substring(c28f_cursor, end));
    c28f_cursor = end;
}

@test
@timeout(180000)

fun value_struct_borrow(): void {
    c28f_cursor = 0;
    c28f_body();
    Assert.eq(c28f_cursor, ("number\nnumber\nnumber=42\n9\n9\n3\ntrue\nnumber=42\n").length);
}
