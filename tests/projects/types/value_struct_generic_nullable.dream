import system.testing;
// A generic field substituted to an optional value struct (`Wrapper<Point>.inner : Option<Point>`)
// is supported per instantiation: `Option<T>` makes "no value" explicit regardless of whether `T`
// is a value or reference type.

import system;
struct c291_Point {
    public x: int;

    public constructor(x: int) {
        this.x = x;
    }
}

struct c291_Wrapper<T> {
    public inner: Option<T>;

    public constructor(inner: Option<T>) {
        this.inner = inner;
    }
}

@test
@timeout(180000)
fun value_struct_generic_nullable(): void {
    let w = c291_Wrapper<c291_Point>(Option.Some(c291_Point(1)));
    let p: c291_Point = w.inner ?? c291_Point(-1);
    Assert.eq_str((p.x).to_string(), "1");

    let no_point: Option<c291_Point> = Option.None;
    let empty = c291_Wrapper<c291_Point>(no_point);
    let q: c291_Point = empty.inner ?? c291_Point(-1);
    Assert.eq_str((q.x).to_string(), "-1");
}
