import system;
import system.webapi;
import system.net;
import system.json;
import system.testing;

@json
class WebapiPayload {
    public name: string;
    public constructor(name: string) {
        this.name = name;
    }
}
let webapi_dep_calls: int = 0;

fun webapi_dependency(@header("X-Key")key: string): string {
    webapi_dep_calls++;
    return key;
}

fun webapi_path_dependency(@path id: int): int {
    return id;
}

@use(webapi_outer)
@router("/group")
class WebapiGroup {
    @get("/ok")
    public static fun ok(): string {
        return "group";
    }
}

async fun webapi_guard(ctx: RequestContext, next: Next): HttpOutgoing {
    if ctx.incoming.path == "/short" {
        return HttpOutgoing.text("blocked", 403);
    }
    return next.call().await;
}

async fun webapi_outer(ctx: RequestContext, next: Next): HttpOutgoing {
    let response = next.call().await;
    response.body = response.body + "a";
    return response;
}

async fun webapi_inner(ctx: RequestContext, next: Next): HttpOutgoing {
    let response = next.call().await;
    response.body = response.body + "b";
    return response;
}

async fun webapi_later(ctx: RequestContext, next: Next): HttpOutgoing {
    ctx.set("order", ctx.get("order").unwrap_or("") + ",10");
    return next.call().await;
}

public async fun webapi_global(ctx: RequestContext, next: Next): HttpOutgoing {
    ctx.set("order", "5");
    let response = next.call().await;
    response.set_header("X-Global", "yes");
    return response;
}

let webapi_stream_dropped: int = 0;

class WebapiStreamGuard {
    public value: string;
    public constructor() {
        this.value = "later";
    }
    del() {
        webapi_stream_dropped++;
    }
}

public async fun webapi_get(client: HttpClient, base: string, path: string, expected: int): string {
    let result = client.send(HttpRequest.get(Url.parse(base + path).unwrap())).await;
    if result.is_err() {
        Assert.fail(
            path + ": " + result.unwrap_err().code() + ": " + result.unwrap_err().message()
        );
    }
    let response = result.unwrap();
    if response.status != expected {
        Assert.fail(
            path + ": status " + response.status.to_string() + " expected " + expected.to_string()
        );
    }
    let text = response.read_text().await.unwrap();
    response.close();
    return text;
}

@test
@timeout(15000)
async fun webapi_basic(): void {
    webapi_dep_calls = 0;
    let app = WebApp();
    app.include_router(WebapiRoutes.router()).unwrap();
    app.include_router(WebapiGroup.router()).unwrap();
    app.use(Middleware(webapi_global)).unwrap();
    app.use(Middleware(webapi_later)).unwrap();
    app.use(CORS(CorsOptions())).unwrap();
    let port = app.listen("127.0.0.1", 0).await.unwrap();
    let base = "http://127.0.0.1:" + port.to_string();
    let client = HttpClient();
    let request = HttpRequest.get(Url.parse(base + "/hello/12?q=4").unwrap());
    request.headers.set("X-Key", "k");
    request.headers.set("Cookie", "session=abc");
    let response = client.send(request).await.unwrap();
    Assert.eq_str(response.read_text().await.unwrap(), "12:4:abc:kk");
    Assert.eq_str(response.headers.get("X-Global").unwrap(), "yes");
    response.close();
    Assert.eq(webapi_dep_calls, 1);
    Assert.eq_str(webapi_get(client, base, "/dependency/42", 200).await, "42");
    Assert.eq_str(webapi_get(client, base, "/group/ok", 200).await, "groupa");
    Assert.eq_str(webapi_get(client, base, "/onion", 200).await, "5,10ba");
    webapi_get(client, base, "/auth", 401).await;
    Assert.eq_str(webapi_get(client, base, "/short", 403).await, "blocked");
    Assert.is_true(webapi_get(client, base, "/failure", 500).await.contains("failed"));
    Assert.is_true(webapi_get(client, base, "/missing", 404).await.contains("Not Found"));
    Assert.eq_str(webapi_get(client, base, "/chunks", 200).await, "onetwo");
    let binary = client.send(HttpRequest.get(Url.parse(base + "/binary").unwrap())).await.unwrap();
    let binary_bytes = binary.body.read_async(16).await.unwrap();
    Assert.eq(binary_bytes.length, 2);
    Assert.eq((int)binary_bytes[1], 255);
    binary.close();
    let disconnect = client.send(HttpRequest.get(Url.parse(base + "/disconnect").unwrap()))
        .await
        .unwrap();
    disconnect.body.read_async(16).await.unwrap();
    disconnect.close();
    Time.sleep(20).await;
    Assert.eq(webapi_stream_dropped, 1);
    let events = webapi_get(client, base, "/events", 200).await;
    Assert.is_true(events.contains("data: first\ndata: second\n\n"));
    Assert.is_true(events.contains("event: update\nid: 2\nretry: 100\ndata: last"));
    let json_request = HttpRequest("POST", Url.parse(base + "/json").unwrap());
    json_request.headers.set("Content-Type", "application/json");
    json_request.body = Encoding.utf8_encode("{\"name\":\"Dream\"}");
    let json_response = client.send(json_request).await.unwrap();
    Assert.eq_str(json_response.read_text().await.unwrap(), "{\"name\":\"Dream\"}");
    json_response.close();
    let multipart = HttpRequest("POST", Url.parse(base + "/multipart").unwrap());
    multipart.headers.set("Content-Type", "multipart/form-data; boundary=dream");
    multipart.body = Encoding.utf8_encode(
        "--dream\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\ntitle\r\n--dream\r\nContent-Disposition: form-data; name=\"upload\"; filename=\"a.txt\"\r\nContent-Type: text/plain\r\n\r\nbody\r\n--dream--\r\n"
    );
    let upload = client.send(multipart).await.unwrap();
    Assert.eq_str(upload.read_text().await.unwrap(), "title:a.txt:body");
    upload.close();
    let preflight = HttpRequest("OPTIONS", Url.parse(base + "/hello/1").unwrap());
    preflight.headers.set("Origin", "https://example.com");
    preflight.headers.set("Access-Control-Request-Method", "GET");
    let cors = client.send(preflight).await.unwrap();
    Assert.eq(cors.status, 200);
    Assert.eq_str(cors.headers.get("Access-Control-Allow-Origin").unwrap(), "*");
    cors.close();
    let openapi = webapi_get(client, base, "/openapi.json", 200).await;
    Assert.is_true(openapi.contains("text/event-stream"));
    Assert.is_true(openapi.contains("multipart/form-data"));
    Assert.is_true(openapi.contains("/hello/{id}"));
    Assert.is_true(webapi_get(client, base, "/docs", 200).await.contains("SwaggerUIBundle"));
    Assert.is_true(webapi_get(client, base, "/redoc", 200).await.contains("redoc"));
    let socket = WebSocket.connect("ws://127.0.0.1:" + port.to_string() + "/ws", 5000)
        .await
        .unwrap();
    socket.send_text("echo").await.unwrap();
    switch (socket.receive().await.unwrap()) {
        Text(text) => {
            Assert.eq_str(text, "echo");
        },
        _ => {
            Assert.is_true(false);
        }
    }
    socket.close().await.unwrap();
    let idle_socket = WebSocket.connect("ws://127.0.0.1:" + port.to_string() + "/ws", 5000)
        .await
        .unwrap();
    app.shutdown();
    app.wait().await;
    let closed = idle_socket.receive().await;
    if closed.is_ok() {
        switch (closed.unwrap()) {
            Close(_, _) => {},
            _ => {
                Assert.fail("shutdown must close active WebSockets");
            }
        }
    }
    let options = WebAppOptions(docs_url: "", openapi_url: "", redoc_url: "");
    let second_app = WebApp(options);
    port = second_app.listen("127.0.0.1", 0).await.unwrap();
    base = "http://127.0.0.1:" + port.to_string();
    webapi_get(client, base, "/docs", 404).await;
    webapi_get(client, base, "/openapi.json", 404).await;
    webapi_get(client, base, "/redoc", 404).await;
    second_app.shutdown();
    second_app.wait().await;
    client.close().unwrap();
}

@router("")
class WebapiRoutes {
    @get("/hello/{id}")
    public static fun webapi_hello(
        @path id: int,
        @query q: Option<int>,
        @cookie session: Option<string>,
        @dep(webapi_dependency)first: string,
        @dep(webapi_dependency)second: string
    ): string {
        return id.to_string()
            + ":" + q.unwrap_or(0)
            .to_string() + ":" + session.unwrap_or("") + ":" + first + second;
    }

    @get("/dependency/{id}")
    public static fun webapi_dependency_path(@dep(webapi_path_dependency)value: int): string {
        return value.to_string();
    }

    @post("/json")
    public static fun webapi_json(@body payload: WebapiPayload): WebapiPayload {
        return payload;
    }

    @get("/failure")
    public static fun webapi_failure(): Result<string, string> {
        return Result.Err("failed");
    }

    @use(webapi_guard)
    @get("/short")
    public static fun webapi_short(): string {
        return "unreachable";
    }

    @use(webapi_outer)
    @use(webapi_inner)
    @get("/onion")
    public static fun webapi_onion(ctx: RequestContext): string {
        return ctx.get("order").unwrap_or("");
    }

    @get("/auth")
    public static fun webapi_auth(@dep(BearerToken)token: string): string {
        return token;
    }

    @get("/events")
    public static async fun webapi_events(): AsyncIterable<SseEvent> {
        yield SseEvent.data("first\nsecond");
        Time.sleep(1).await;
        yield SseEvent("last", Option.Some("update"), Option.Some("2"), Option.Some(100));
    }

    @get("/disconnect")
    public static async fun webapi_disconnecting(): AsyncIterable<string> {
        let guard = WebapiStreamGuard();
        yield "first";
        Time.sleep(60000).await;
        yield guard.value;
    }

    @get("/binary")
    public static fun webapi_binary(): Iterable<byte[]> {
        yield [(byte)1, (byte)255];
    }

    @get("/chunks")
    @produces("text/custom")
    public static fun webapi_chunks(): Iterable<string> {
        yield "one";
        yield "two";
    }

    @post("/multipart")
    public static fun webapi_multipart(@form title: string, @file upload: UploadedFile): string {
        return title + ":" + upload.filename + ":" + Encoding.utf8_decode(upload.bytes);
    }

    @websocket("/ws")
    public static async fun webapi_ws(ws: ServerWebSocket): void {
        await for (let message in ws.messages()) {
            switch (message) {
                Text(text) => {
                    ws.send_text(text).await.unwrap();
                },
                Binary(bytes) => {
                    ws.send_binary(bytes).await.unwrap();
                },
                Close(_, _) => {},
            }
        }
    }
}
