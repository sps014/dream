import system;
import system.webapi;
import system.app;
import system.http;
import system.testing;
import webapi_basic;

@router("")
class IsolatedRoutes {
    @get("/state")
    public static fun state(ctx: RequestContext): string {
        return ctx.app_state.get("name").unwrap_or("");
    }
}

@router("")
class HiddenRoutes {
    @get("/hidden")
    public static fun hidden(): string {
        return "hidden";
    }
}

@router("")
class PrecedenceRoutes {
    @get("/items/{id}")
    public static fun item(@path id: string): string {
        return "item " + id;
    }

    @get("/items/me")
    public static fun item_me(): string {
        return "items me";
    }

    @get("/users/me")
    public static fun user_me(): string {
        return "users me";
    }

    @get("/users/{id}")
    public static fun user(@path id: string): string {
        return "user " + id;
    }

    @post("/things/{id}")
    public static fun create_thing(@path id: string): string {
        return "posted " + id;
    }

    @get("/things/new")
    public static fun new_thing(): string {
        return "new thing";
    }

    @get("/{a}/{b}/end")
    public static fun pair(@path a: string, @path b: string): string {
        return "pair " + a + " " + b;
    }

    @get("/")
    public static fun root(): string {
        return "root";
    }
}

async fun webapi_allow(client: HttpClient, method: HttpMethod, url: string): string {
    let response = client.send(HttpRequest(method, Url.parse(url).unwrap())).await.unwrap();
    Assert.eq(response.status, 405);
    let allow = response.headers.get("Allow").unwrap();
    response.close();
    return allow;
}

@test
@timeout(10000)
async fun webapi_route_precedence(): void {
    let app = WebApp();
    app.include_router(PrecedenceRoutes.router()).unwrap();
    let port = app.listen("127.0.0.1", 0).await.unwrap();
    let base = "http://127.0.0.1:" + port.to_string();
    let client = HttpClient();

    Assert.eq(webapi_get(client, base, "/items/me", 200).await, "item me");
    Assert.eq(webapi_get(client, base, "/items/42", 200).await, "item 42");
    Assert.eq(webapi_get(client, base, "/users/me", 200).await, "users me");
    Assert.eq(webapi_get(client, base, "/users/7", 200).await, "user 7");
    Assert.eq(webapi_get(client, base, "//users//me/", 200).await, "users me");
    Assert.eq(webapi_get(client, base, "/users/a%20b", 200).await, "user a b");
    Assert.eq(webapi_get(client, base, "/things/new", 200).await, "new thing");
    Assert.eq(webapi_get(client, base, "/x/users/end", 200).await, "pair x users");
    Assert.eq(webapi_get(client, base, "/", 200).await, "root");

    webapi_get(client, base, "/users", 404).await;
    webapi_get(client, base, "/users/7/extra", 404).await;
    Assert.eq(webapi_allow(client, HttpMethod.Get, base + "/things/old").await, "POST");
    Assert.eq(
        webapi_allow(client, HttpMethod.Delete, base + "/things/new").await,
        "POST, GET, HEAD"
    );

    app.shutdown();
    app.wait().await;
    client.close().unwrap();
}

@test
@timeout(10000)
async fun webapi_isolation(): void {
    let options = WebAppOptions(title: "First API");
    options.swagger = SwaggerOptions(
        js_url: "/assets/swagger.js",
        css_url: "/assets/swagger.css",
        persist_authorization: true
    );
    let first = WebApp(options);
    let second = WebApp(WebAppOptions(title: "Second API", docs_url: "/documentation"));
    first.state["name"] = "first";
    second.state["name"] = "second";
    first.include_router(IsolatedRoutes.router()).unwrap();
    second.include_router(IsolatedRoutes.router(), "/v2").unwrap();
    let port1 = first.listen("127.0.0.1", 0).await.unwrap();
    let port2 = second.listen("127.0.0.1", 0).await.unwrap();
    let base1 = "http://127.0.0.1:" + port1.to_string();
    let base2 = "http://127.0.0.1:" + port2.to_string();
    let client = HttpClient();
    Assert.eq(webapi_get(client, base1, "/state", 200).await, "first");
    Assert.eq(webapi_get(client, base2, "/v2/state", 200).await, "second");
    webapi_get(client, base1, "/hidden", 404).await;
    webapi_get(client, base2, "/state", 404).await;
    let wrong_method = client.send(
        HttpRequest(HttpMethod.Delete, Url.parse(base1 + "/state").unwrap())
    ).await.unwrap();
    Assert.eq(wrong_method.status, 405);
    Assert.eq(wrong_method.headers.get("Allow").unwrap(), "GET, HEAD");
    wrong_method.close();
    let head = client.send(HttpRequest(HttpMethod.Head, Url.parse(base1 + "/state").unwrap()))
        .await
        .unwrap();
    Assert.eq(head.status, 200);
    Assert.eq(head.headers.get("Content-Length").unwrap(), "5");
    Assert.eq(head.read_text().await.unwrap(), "");
    head.close();
    Assert.is_true(!first.openapi().contains("/hidden"));
    Assert.is_true(second.openapi().contains("/v2/state"));
    Assert.is_true(webapi_get(client, base1, "/docs", 200).await.contains("/assets/swagger.js"));
    webapi_get(client, base2, "/docs", 404).await;
    webapi_get(client, base2, "/documentation", 200).await;
    Assert.is_true(first.include_router(HiddenRoutes.router()).is_err());
    Assert.is_true(first.use(Middleware(webapi_global)).is_err());
    first.shutdown();
    first.wait().await;
    Assert.eq(webapi_get(client, base2, "/v2/state", 200).await, "second");
    second.shutdown();
    second.wait().await;
    let duplicate = WebApp();
    duplicate.include_router(IsolatedRoutes.router()).unwrap();
    duplicate.include_router(IsolatedRoutes.router()).unwrap();
    Assert.is_true(duplicate.listen("127.0.0.1", 0).await.is_err());
    let reserved = WebApp(WebAppOptions(docs_url: "/state"));
    reserved.include_router(IsolatedRoutes.router()).unwrap();
    Assert.is_true(reserved.listen("127.0.0.1", 0).await.is_err());
    client.close().unwrap();
}

async fun quit_after_requests(base: string, order: List<string>): void {
    let client = HttpClient();
    Assert.eq(webapi_get(client, base, "/state", 200).await, "lifetime");
    client.close().unwrap();
    order.push("request");
    App.quit(0);
}

@test
async fun webapi_application_lifetime(): void {
    let order = List<string>();
    let code = App.run(async () => {
        let app = WebApp();
        app.state["name"] = "lifetime";
        app.include_router(IsolatedRoutes.router()).unwrap();
        let port = app.listen("127.0.0.1", 0).await?;
        App.on_stop(async () => {
            app.shutdown();
            app.wait().await;
            order.push("stopped");
        });
        Promise.start(quit_after_requests("http://127.0.0.1:" + port.to_string(), order));
        return Result.Ok(Unit());
    }).await;
    Assert.eq(code, 0);
    Assert.eq(order.join(","), "request,stopped");
}

async fun quit_soon(): void {
    Time.delay(50).await;
    App.quit(3);
}

@test
async fun webapi_run_stops_with_application(): void {
    let order = List<string>();
    let code = App.run(async () => {
        let app = WebApp();
        app.include_router(IsolatedRoutes.router()).unwrap();
        App.on_stop(async () => {
            order.push("cleanup");
        });
        Promise.start(quit_soon());
        app.run("127.0.0.1", 0).await?;
        order.push("served");
        return Result.Ok(Unit());
    }).await;
    Assert.eq(code, 3);
    Assert.eq(order.join(","), "served,cleanup");
}
