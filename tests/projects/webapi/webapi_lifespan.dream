import system;
import system.webapi;
import system.net;
import system.testing;
import webapi_basic;

@test
async fun webapi_lifespan(): void {
    let app = WebApp();
    let order = List<string>();
    app.lifespan(
        async (app: WebApp) => {
            order.push("first");
            return Result.Ok(true);
        },
        async (app: WebApp) => {
            order.push("stop-first");
        }
    ).unwrap();
    app.lifespan(
        async (app: WebApp) => {
            order.push("second");
            return Result.Err(IoError.other("", "startup failed"));
        },
        async (app: WebApp) => {
            order.push("stop-second");
        }
    ).unwrap();
    Assert.is_true(app.listen("127.0.0.1", 0).await.is_err());
    Assert.eq(order.length, 3);
    Assert.eq(order[2], "stop-first");
}
