import system;
import system.webapi;
import system.webapi.auth;
import system.testing;
import system.net;
import system.json;

public class TestAccounts: AuthAccounts {
    hash: string;

    public constructor(hash: string) {
        this.hash = hash;
    }

    public async unique fun find_login(login: string): Result<AuthAccount, AuthError> {
        if login != "dream" {
            return Result.Err(AuthError("ENOUSER", "unknown account"));
        }
        return Result.Ok(AuthAccount("1", this.hash, "read"));
    }

    public async unique fun link_identity(
        issuer: string,
        subject: string,
        email: string,
        email_verified: bool
    ): Result<AuthAccount, AuthError> {
        return Result.Ok(AuthAccount(issuer + ":" + subject, "", "read"));
    }
}

@router("/private")
class PrivateRoutes {
    @get("/")
    @requires_scopes("read")
    public static fun read(@dep(AuthService.current_user) user: AuthPrincipal): string {
        return user.subject;
    }

    @post("/")
    @requires_scopes("read")
    public static fun write(@dep(AuthService.current_user) user: AuthPrincipal): string {
        return user.subject;
    }
}

@test
@timeout(10000)
async fun webapi_auth_http(): void {
    let key = "0123456789abcdef0123456789abcdef";
    let auth = AuthService(
        JwtOptions("issuer", "api", key, key, JwtAlgorithm.HS256),
        TestAccounts(Password.hash("password").unwrap()),
        MemoryAuthStore(),
        browser_sessions: true,
        browser_origin: "https://example.com"
    );
    auth.add_provider(
        OidcOptions(
            "company",
            "https://issuer.invalid",
            "client",
            "https://example.com/auth/oidc/company/callback"
        )
    ).unwrap();
    let app = WebApp();
    app.include_router(auth.router().unwrap()).unwrap();
    app.include_router(PrivateRoutes.router()).unwrap();
    app.use(auth.middleware()).unwrap();
    let port = app.listen("127.0.0.1", 0).await.unwrap();
    let base = "http://127.0.0.1:" + port.to_string();
    let client = HttpClient();
    let login = HttpRequest(HttpMethod.Post, Url.parse(base + "/auth/login").unwrap());
    login.headers.set("Content-Type", "application/json");
    login.body = Encoding.utf8_encode("{\"username\":\"dream\",\"password\":\"password\"}");
    login.headers.set("Origin", "https://wrong.example");
    let denied = client.send(login).await.unwrap();
    Assert.eq(denied.status, 403);
    denied.close();
    login.headers.set("Origin", "https://example.com");
    let response = client.send(login).await.unwrap();
    Assert.eq(response.status, 200);
    let cookies = response.headers.get("Set-Cookie").unwrap();
    Assert.is_true(cookies.contains("Secure; HttpOnly; SameSite=Lax"));
    let tokens = Json.deserialize<JsonValue>(response.read_text().await.unwrap()).unwrap();
    response.close();
    let secret = tokens["refresh_token"].as_string().unwrap();
    let csrf = tokens["csrf_token"].as_string().unwrap();
    let request = HttpRequest(HttpMethod.Post, Url.parse(base + "/private").unwrap());
    request.headers.set("Cookie", "__Host-dream_session=" + secret);
    let blocked = client.send(request).await.unwrap();
    Assert.eq(blocked.status, 403);
    blocked.close();
    request.headers.set("X-CSRF-Token", csrf);
    let allowed = client.send(request).await.unwrap();
    Assert.eq(allowed.status, 200);
    Assert.eq(allowed.read_text().await.unwrap(), "1");
    allowed.close();
    let bearer = HttpRequest(HttpMethod.Get, Url.parse(base + "/private").unwrap());
    bearer.headers.set("Authorization", "Bearer " + tokens["access_token"].as_string().unwrap());
    let authorized = client.send(bearer).await.unwrap();
    Assert.eq(authorized.status, 200);
    authorized.close();
    bearer.headers.set("Authorization", "Bearer invalid");
    let invalid = client.send(bearer).await.unwrap();
    Assert.eq(invalid.status, 401);
    invalid.close();
    let callback = HttpRequest(
        HttpMethod.Get,
        Url.parse(base + "/auth/oidc/company/callback?state=unknown&code=code").unwrap()
    );
    callback.headers.set("Cookie", "__Host-dream_oidc=unknown");
    let transaction = client.send(callback).await.unwrap();
    Assert.eq(transaction.status, 401);
    transaction.close();
    Assert.is_true(app.openapi().contains("requestBody"));
    Assert.is_true(app.openapi().contains("BearerAuth"));
    app.shutdown();
    app.wait().await;
    client.close().unwrap();
}

@test
async fun webapi_auth_tokens(): void {
    let hash = Password.hash("correct password").unwrap();
    Assert.is_true(Password.verify("correct password", hash).unwrap());
    Assert.is_true(!Password.verify("wrong", hash).unwrap());
    let key = "0123456789abcdef0123456789abcdef";
    let service = AuthService(
        JwtOptions("dream-test", "api", key, key, JwtAlgorithm.HS256),
        TestAccounts(hash),
        MemoryAuthStore()
    );
    Assert.is_true(service.login("dream", "wrong").await.is_err());
    let tokens = service.login("dream", "correct password").await.unwrap();
    Assert.eq(tokens.expires_in, 900);
    let principal = service.verify(tokens.access_token).await.unwrap();
    Assert.eq(principal.subject, "1");
    Assert.is_true(principal.has_scope("read"));
    let next = service.refresh(tokens.refresh_token).await.unwrap();
    Assert.is_true(service.verify(next.access_token).await.is_ok());
    Assert.is_true(service.refresh(tokens.refresh_token).await.is_err());
    Assert.is_true(service.verify(next.access_token).await.is_err());
    let other = service.login("dream", "correct password").await.unwrap();
    service.logout(other.refresh_token).await.unwrap();
    Assert.is_true(service.verify(other.access_token).await.is_err());
    Assert.is_true(service.verify("not-a-jwt").await.is_err());
    let store = MemoryAuthStore();
    let original = AuthSession("old", "family", "1", "read", 100L, "csrf");
    store.create(original).await.unwrap();
    store.rotate("old", AuthSession("next", "family", "1", "read", 100L, "csrf"), 1L).await.unwrap();
    Assert.is_true(
        store.rotate("old", AuthSession("other", "family", "1", "read", 100L, "csrf"), 1L)
            .await
            .is_err()
    );
    Assert.is_true(!store.active("family", 1L).await);
    store.put_transaction("state", OidcTransaction("provider", "nonce", "verifier", 100L))
        .await
        .unwrap();
    store.take_transaction("state", 1L).await.unwrap();
    Assert.is_true(store.take_transaction("state", 1L).await.is_err());
}
